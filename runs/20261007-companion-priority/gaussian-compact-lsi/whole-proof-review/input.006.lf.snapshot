      "signature_text": "theorem compact_gaussian_logSobolev\n    (f : ℝ → ℝ) (hf : ContDiff ℝ 2 f) (hs : HasCompactSupport f) :\n    let γ : Measure ℝ := gaussianReal 0 1\n    (∫ x, (f x)^2 * Real.log ((f x)^2) ∂γ) -\n      (∫ x, (f x)^2 ∂γ) * Real.log (∫ x, (f x)^2 ∂γ) ≤\n    2 * ∫ x, (deriv f x)^2 ∂γ\n",
