      "credit": "Exact source formula only; not a proved Lean clause",
      "id": "A1.Ex5.m1",
      "literal_source_alttext": "\\|p\\|\\leq\\sqrt{2\\mathcal{E}}\\,,\\hskip 20.00003pt\\|x-c_{y,\\widetilde{x}}\\|\\leq\\sqrt{2\\eta\\mathcal{E}}\\,.",
      "source_URL": "https://arxiv.org/html/2609.06905v1#A1.Ex5.m1"
    },
    {
