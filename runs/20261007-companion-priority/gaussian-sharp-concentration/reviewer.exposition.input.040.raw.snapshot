    <pre class="code-block"><code class="language-lean">private theorem norm_rotY_le (θ : ℝ) (p : E × E) : ‖rotY θ p‖ ≤ 2 * ‖p‖ :=
  norm_linear_pair_le_two (by simpa only [abs_neg] using Real.abs_sin_le_one θ)
    (Real.abs_cos_le_one θ) p</code></pre>
