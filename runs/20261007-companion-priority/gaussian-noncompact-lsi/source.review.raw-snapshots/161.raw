1: theorem gaussian_logSobolev_of_contDiff
2:     {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
3:     [CompleteSpace E] [FiniteDimensional ℝ E]
4:     [MeasurableSpace E] [BorelSpace E]
5:     (f : E → ℝ) (hf : ContDiff ℝ 2 f)
6:     (hf2 : MemLp f 2 (ProbabilityTheory.stdGaussian E))
7:     (hgrad2 : MemLp (gradient f) 2 (ProbabilityTheory.stdGaussian E))
8:     (hentropy : Integrable (fun x => (f x)^2 * Real.log ((f x)^2))
9:       (ProbabilityTheory.stdGaussian E)) :
10:     let γ : Measure E := ProbabilityTheory.stdGaussian E
11:     (∫ x, (f x)^2 * Real.log ((f x)^2) ∂γ) -
12:       (∫ x, (f x)^2 ∂γ) * Real.log (∫ x, (f x)^2 ∂γ) ≤
13:       2 * ∫ x, ‖gradient f x‖^2 ∂γ
