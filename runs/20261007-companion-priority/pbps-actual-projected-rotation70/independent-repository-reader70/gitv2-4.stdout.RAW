+{"key": "pbps.actualProjectedRotation", "local_decl": "AutoSamplingTheory.ExampleCases.ProximalBPS.ActualProjectedRotation.actual_projected_rotation", "local_file": "AutoSamplingTheory/ExampleCases/ProximalBPS/ActualProjectedRotation.lean", "status": "formalized-local", "sald_use": "PBPS consumer; no SALD change", "tags": ["PBPS", "L2", "reflection", "conditional-expectation", "projected-rotation"], "upstream_decl": "Actual PBPS projected reflection rotation and two-component energy", "upstream_file": "arXiv2609.06905v1 Appendix B1/B3; B21 and Lemma B4 prerequisites", "verified_commit": "c46af8a55e89419109f654c4553cf527993cbeed", "evidence": "runs/20261007-companion-priority/pbps-actual-projected-rotation70/verified.json", "next_action": "Independently exact-science70 VERIFIED c46af8a55e89419109f654c4553cf527993cbeed. Same six original analytic callers and twelve witnesses yield actual g=U(P-Pperp)f, internally mean(g)=0, actual conditional gP and polar gV, gP=A0fP-Gamma0fV and gV=Gamma0fP+A0fV, with exact pair-energy conservation. No right-hand-side-defined output, mean premise, extra regularity or sharp-energy68 premise. Rank0/alphaeta1 remain legal. B21 corrector change, B4 dynamics, main, invariance/nonexplosion, errors/caps, expected-query costs/composition and full Exposition/PURIFIED remain open."}
