∀ {E : Type u_1} {S : Type u_2} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E]
  [inst_2 : CompleteSpace E] [inst_3 : FiniteDimensional ℝ E] [inst_4 : MeasurableSpace E] [inst_5 : BorelSpace E]
  [inst_6 : MeasurableSpace S] {V : E → ℝ} {κ : ℝ},
  1 ≤ κ →
    ContDiff ℝ 2 V →
      (∀ (x v : E), κ⁻¹ * ‖v‖ ^ 2 ≤ ((fderiv ℝ (fderiv ℝ V) x) v) v ∧ ((fderiv ℝ (fderiv ℝ V) x) v) v ≤ ‖v‖ ^ 2) →
        ∀ {eta : S → ℝ} {y : S → E},
          Measurable eta →
            Measurable y →
              (∀ (s : S), 0 < eta s) →
                ∃ p,
                  Measurable p ∧
                    (∀ (s : S), p s + eta s • gradient V (p s) = y s) ∧
                      (∀ (s : S) (z : E), z + eta s • gradient V z = y s → z = p s) ∧
                        let rho := fun s u => V (p s + √(eta s) • u) - V (p s) - √(eta s) * ⟪gradient V (p s), u⟫;
                        let mu := ℙ.tilted fun x => -V x;
                        let R := fun s => mu.tilted fun x => -‖x - y s‖ ^ 2 / (2 * eta s);
                        let r := fun s => Measure.map (fun x => (√(eta s))⁻¹ • (x - p s)) (R s);
                        let gamma := stdGaussian E;
                        let Z := fun s => ∫ (u : E), Real.exp (-rho s u) ∂gamma;
                        let q := fun s u => Real.exp (-rho s u) / Z s;
                        ∀ (s : S),
                          r s ≪ gamma ∧
                            InformationTheory.klDiv (r s) gamma ≠ ∞ ∧
                              Integrable (llr (r s) gamma) (r s) ∧
                                (llr (r s) gamma =ᵐ[r s] fun u => Real.log (q s u)) ∧
                                  Integrable (rho s) (r s) ∧
                                    (InformationTheory.klDiv (r s) gamma).toReal =
                                        ∫ (u : E), q s u * Real.log (q s u) ∂gamma ∧
                                      (InformationTheory.klDiv (r s) gamma).toReal =
                                        -∫ (u : E), rho s u ∂r s - Real.log (Z s) : Prop
