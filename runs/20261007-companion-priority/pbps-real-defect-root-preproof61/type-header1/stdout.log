fun {E} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] {V}
    {α β} {η} hα hαβ hV hH hη hβη =>
  let μ := ℙ.tilted fun x => -V x;
  let J := Measure.map (fun p => (p.1, p.1 + √η • p.2)) (μ.prod (stdGaussian E));
  let ν := J.snd;
  let Λ := Measure.map (fun p => (p.2, 2 • p.1 - p.2)) J;
  IsProbabilityMeasure μ ∧
    IsProbabilityMeasure J ∧
      IsProbabilityMeasure ν ∧
        ∃ S,
          IsMarkovKernel S ∧
            (∀ (y : E), S y = ℙ.tilted fun x => -V ((1 / 2) • (y + x)) - ‖y - x‖ ^ 2 / (8 * η)) ∧
              Λ.IsCondKernel S ∧
                Λ.fst = ν ∧
                  Λ.snd = ν ∧
                    ∃ T,
                      IsSelfAdjoint T ∧
                        (∀ (u : ↥(Lp ℝ 2 ν)),
                            ‖T u‖ ≤ ‖u‖ ∧
                              (↑↑(T u) =ᵐ[ν] fun y => ∫ (x : E), ↑↑u x ∂S y) ∧
                                ∫ (y : E), ↑↑(T u) y ∂ν = ∫ (y : E), ↑↑u y ∂ν) ∧
                          (1 - T * T).IsPositive ∧
                            ∃ Γ,
                              Γ.IsPositive ∧
                                Γ * Γ = 1 - T * T ∧
                                  ∀ (u : ↥(Lp ℝ 2 ν)),
                                    ‖Γ u‖ ^ 2 =
                                      ‖u‖ ^ 2 -
                                        ‖T u‖ ^
                                          2 : {E : Type u_1} →
  [inst : NormedAddCommGroup E] →
    [inst_1 : InnerProductSpace ℝ E] →
      [FiniteDimensional ℝ E] →
        [inst_3 : MeasurableSpace E] →
          [BorelSpace E] →
            {V : E → ℝ} →
              {α β : ℝ≥0} →
                {η : ℝ} →
                  0 < ↑α →
                    α ≤ β →
                      ContDiff ℝ 2 V →
                        (∀ (x v : E),
                            ↑α * ‖v‖ ^ 2 ≤ ((fderiv ℝ (fderiv ℝ V) x) v) v ∧
                              ((fderiv ℝ (fderiv ℝ V) x) v) v ≤ ↑β * ‖v‖ ^ 2) →
                          0 < η → ↑β * η ≤ 1 → Prop
