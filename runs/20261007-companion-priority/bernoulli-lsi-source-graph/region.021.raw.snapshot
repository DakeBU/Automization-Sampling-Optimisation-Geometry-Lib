theorem two_point_entropy_lower_bound {a b : ℝ} (ha : 0 < a) (hb : 0 < b) :
    -(sqrt a - sqrt b)^2 / 2 ≤
    (a * log a + b * log b) / 2 - (a + b) / 2 * log ((a + b) / 2) := by
  have h := two_point_inequality ha hb
  linarith

/-!
## Part 10: The Rothaus Lemma
-/

/-- The RHS term in Rothaus: 2 - 2√(1-t²) = (√(1+t) - √(1-t))² -/
