      "credit": "Exact source formula only; not a proved Lean clause",
      "id": "A1.Ex2.m1",
      "literal_source_alttext": "\\displaystyle\\Phi_{t}^{y,\\widetilde{x}}(x,p)",
      "source_URL": "https://arxiv.org/html/2609.06905v1#A1.Ex2.m1"
    },
    {
      "LF_sha256": "03edd2be0d77804eaa7eb1b0ef49242882029eeb4de48e9771f529a4be04b8f2",
      "RAW_bytes": 1518,
      "RAW_range": [
        538184,
        539702
      ],
      "RAW_sha256": "03edd2be0d77804eaa7eb1b0ef49242882029eeb4de48e9771f529a4be04b8f2",
      "credit": "Exact source formula only; not a proved Lean clause",
      "id": "A1.Ex2.m2",
      "literal_source_alttext": "\\displaystyle\\coloneqq\\bigl(c_{y,\\widetilde{x}}+(x-c_{y,\\widetilde{x}})\\cos t+\\sqrt{\\eta}\\,p\\sin t,\\;-\\eta^{-1/2}(x-c_{y,\\widetilde{x}})\\sin t+p\\cos t\\bigr)\\,,",
      "source_URL": "https://arxiv.org/html/2609.06905v1#A1.Ex2.m2"
    },
