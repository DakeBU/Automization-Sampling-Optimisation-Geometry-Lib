148: def _fsync_directory(path: Path) -> None:
149:     """Sync a POSIX directory; Windows publication uses write-through rename."""
150: 
151:     fd = os.open(path, os.O_RDONLY)
152:     try:
153:         os.fsync(fd)
154:     finally:
155:         os.close(fd)
156: 
157: 
158: def _replace_and_sync(source: str, destination: Path) -> None:
159:     if os.name == "nt":
160:         move_file_ex = ctypes.WinDLL("kernel32", use_last_error=True).MoveFileExW
161:         move_file_ex.argtypes = (wintypes.LPCWSTR, wintypes.LPCWSTR, wintypes.DWORD)
162:         move_file_ex.restype = wintypes.BOOL
163:         # Same-volume replacement, never a copy/delete fallback. The payload
164:         # was fsynced before closing; request write-through for the rename too.
165:         flags = 0x1 | 0x8  # MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH
166:         if not move_file_ex(source, str(destination), flags):
167:             raise ctypes.WinError(ctypes.get_last_error())
168:     else:
169:         os.replace(source, destination)
170:         _fsync_directory(destination.parent)
171: 
