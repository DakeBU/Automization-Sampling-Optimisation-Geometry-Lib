{
  "schema_version": 1,
  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.GibbsC1Poincare.gibbs_c1_variance_poincare",
      "title": "Actual normalized Gibbs C1 variance Poincare",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06905v1#A3.SS1",
          "label": "PBPS reflected score variance and explicitly bounded canonical background",
          "scope": "Finite-dimensional real Hilbert/Borel full E including0, genuine C2 W with actual exponential integrability/positive partition, normalized tilted probability, BOTH global mI<=HessW<=MI and0<m<=M. SAME original exact compact-smooth closable weighted gradient D BEFORE all truly mean-zero domain z. Actual positiveepsilon variational solutions from residual/globalcoercivity producers are identified by SAME D/epsilon/forcing uniqueness, then tested against z; strong scaled residual limit and genuine scalar Cauchy-Schwarz/zero-norm branch give m*normz^2<=normDclosurez^2. No uniform unscaled solution bound, centered resolvent, epsilon0 solution, core/range/adjoint certificate or input Poincare. Actual C1 scalar/gradientL2 pairs and centered function are admitted to a genuine original graph, actual probability/AE quotient identities and real integrability produce Admissible and m*Var<=DirichletEnergy. Actual common Gaussian J/R/S, sourceC2 alpha-beta eta cap, reflected W_y, positive partitions and one original D_y precede allcentered z/score directions; actual unnormalized parameter-y score variance <=(eta^-1-alpha)^2*norma^2/(4*(alpha+eta^-1)), with exact reflected m=(alpha+eta^-1)/4 and source-derived upper M=(beta+eta^-1)/4. Auxiliary normalized density equality only; no R2=R/alternateD identification/jointselector or normalized conditional density derivative. BOTH-curvature generic statement is narrower than lower-only source D6 and is disclosed; source companion models supply the upper bound. Anisotropic BL, unreflected linear moments/covariance-upper and SPHMC Hessian lower, outer-y/marginal Poincare, PBPS sampler/reflection/invariance/nonexplosion/hypocoercivity/implementation/cost, SPHMC complete algorithm/Wp/proxywarmness, main results/composition/expectedcost remainopen. TV does not transfer unbounded cost."
        }
      ],
      "tests": [
        "lake build Tests.CenteredPoincare"
      ],
      "assumptions": [
        "Same actual C2 normalized Gibbs law, positive integrable partition and BOTH global positive m/M curvature bounds; finite-dimensional real Hilbert/Borel E including0.",
        "ALL actual C1 scalar functions f with true scalar and gradient MemLp2. No supplied centering, Poincare, Admissible, variance or extra spatial moments. Original compact-smooth D is constructed before all f."
      ],
      "statement": "For every genuine C1 scalar/gradient weightedL2 observable, derive real Admissible integrability and m*Var_mu(f)<=DirichletEnergy_mu(f) on the actual normalized Gibbs law, using actual centered graph membership and AE quotient identities.",
      "formula": "m\\,\\operatorname{Var}_\\mu(f)\\le\\int\\|\\nabla f\\|^2\\,d\\mu,\\qquad f,\\nabla f\\in L^2(\\mu),\\ f\\in C^1.",
      "boundary": "Finite-dimensional real Hilbert/Borel full E including0, genuine C2 W with actual exponential integrability/positive partition, normalized tilted probability, BOTH global mI<=HessW<=MI and0<m<=M. SAME original exact compact-smooth closable weighted gradient D BEFORE all truly mean-zero domain z. Actual positiveepsilon variational solutions from residual/globalcoercivity producers are identified by SAME D/epsilon/forcing uniqueness, then tested against z; strong scaled residual limit and genuine scalar Cauchy-Schwarz/zero-norm branch give m*normz^2<=normDclosurez^2. No uniform unscaled solution bound, centered resolvent, epsilon0 solution, core/range/adjoint certificate or input Poincare. Actual C1 scalar/gradientL2 pairs and centered function are admitted to a genuine original graph, actual probability/AE quotient identities and real integrability produce Admissible and m*Var<=DirichletEnergy. Actual common Gaussian J/R/S, sourceC2 alpha-beta eta cap, reflected W_y, positive partitions and one original D_y precede allcentered z/score directions; actual unnormalized parameter-y score variance <=(eta^-1-alpha)^2*norma^2/(4*(alpha+eta^-1)), with exact reflected m=(alpha+eta^-1)/4 and source-derived upper M=(beta+eta^-1)/4. Auxiliary normalized density equality only; no R2=R/alternateD identification/jointselector or normalized conditional density derivative. BOTH-curvature generic statement is narrower than lower-only source D6 and is disclosed; source companion models supply the upper bound. Anisotropic BL, unreflected linear moments/covariance-upper and SPHMC Hessian lower, outer-y/marginal Poincare, PBPS sampler/reflection/invariance/nonexplosion/hypocoercivity/implementation/cost, SPHMC complete algorithm/Wp/proxywarmness, main results/composition/expectedcost remainopen. TV does not transfer unbounded cost.",
      "steps": [
        {
          "title": "Construct the original graph before observables",
          "text": "Actual integrable Gibbs exponential normalizes to a probability. Accepted compact-gradient closability constructs genuine original D before ALL C1 scalar f. Both curvature bounds remain explicit.",
          "formula": "\\mu(E)=1,\\qquad D\\phi=\\nabla\\phi\\quad(\\phi\\in C_c^\\infty).",
          "lean": "WeightedGradient.compact_gradient_closable; isProbabilityMeasure_tilted"
        },
        {
          "title": "Center with the actual normalized mean",
          "text": "Put c=integral f and g=f-c. True probability/L2 gives fL1; g is C1/L2 and its true gradient equals gradientf.",
          "formula": "c=\\int f\\,d\\mu,\\quad g=f-c,\\quad\\nabla g=\\nabla f.",
          "lean": "MemLp.integrable; fderiv_sub_const"
        },
        {
          "title": "Derive real integrability and meanzero",
          "text": "L2 facts give centered-square and gradient-square integrability. Actual probability mass1 and integral_sub give integralg=0. Admissible records these facts only, never an assumed estimate.",
          "formula": "\\int g\\,d\\mu=0,\\quad g^2,\\|\\nabla g\\|^2\\in L^1(\\mu).",
          "lean": "MemLp.integrable_sq; memLp_two_iff_integrable_sq_norm; integral_sub"
        },
        {
          "title": "Enter the SAME original closed graph",
          "text": "The accepted C1 graph producer admits actual g/gradientg L2 quotient pair. mem_graph_iff gives z in SAME D.closure.domain with genuine representative equalities, and actual meanzero follows by AE substitution.",
          "formula": "(g,\\nabla g)\\in\\operatorname{graph}\\overline D.",
          "lean": "WeightedC1GradientDomain.c1_in_closed_gradient; LinearPMap.mem_graph_iff"
        },
        {
          "title": "Apply actual centered-domain Poincare",
          "text": "Use the first new canonical theorem on this exact z and actual law. It proves the estimate from curvature instead of consuming Poincare.Satisfies.",
          "formula": "m\\|g\\|_{L^2}^2\\le\\|\\nabla g\\|_{L^2}^2.",
          "lean": "CenteredDomainPoincare.gibbs_centered_domain_poincare"
        },
        {
          "title": "Convert quotient norms to true integrals",
          "text": "L2.inner_def and actual toLp AE identities identify both squared norms with actual scalar/vector integrals. Real abs-square equals square and gradientg=gradientf yield the claimed variance/Dirichlet formula.",
          "formula": "m\\operatorname{Var}_\\mu(f)\\le\\int\\|\\nabla f\\|^2\\,d\\mu.",
          "lean": "norm_sq_toLp_integral; L2.inner_def; integral_congr_ae; gibbs_c1_variance_poincare"
        }
      ],
      "lean_statement": "For every genuine C1 scalar/gradient weightedL2 observable, derive real Admissible integrability and m*Var_mu(f)<=DirichletEnergy_mu(f) on the actual normalized Gibbs law, using actual centered graph membership and AE quotient identities.",
      "lean_proof": "Construct the original graph before observables; Center with the actual normalized mean; Derive real integrability and meanzero; Enter the SAME original closed graph; Apply actual centered-domain Poincare; Convert quotient norms to true integrals",
      "astis_dependencies": [
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.CenteredDomainPoincare.gibbs_centered_domain_poincare",
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.WeightedGradient.compact_gradient_closable",
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.WeightedC1GradientDomain.c1_in_closed_gradient"
      ],
      "mathlib_dependencies": [
        "MemLp.integrable",
        "MemLp.integrable_sq",
        "memLp_two_iff_integrable_sq_norm",
        "LinearPMap.mem_graph_iff",
        "L2.inner_def",
        "fderiv_sub_const"
      ]
    }
  ]
