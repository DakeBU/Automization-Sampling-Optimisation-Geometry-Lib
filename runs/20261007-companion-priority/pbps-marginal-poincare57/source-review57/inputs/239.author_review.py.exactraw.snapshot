def sha(b):return hashlib.sha256(b).hexdigest()
def canon(j):return json.dumps(j,ensure_ascii=False,sort_keys=True,separators=(',',':')).encode('utf8')
def pin(p):
 p=Path(p);b=p.read_bytes();lf=b.replace(b'\r\n',b'\n');return {'path':str(p).replace('\\','/'),'bytes':len(b),'raw_sha256':sha(b),'lf_bytes':len(lf),'lf_sha256':sha(lf)}
def write(n,j):
 j['content_self_sha256']=sha(canon(j));p=O/n;p.write_bytes((json.dumps(j,ensure_ascii=False,indent=2)+'\n').encode('utf8'));q=json.loads(p.read_bytes());v=q.pop('content_self_sha256');assert sha(canon(q))==v;return pin(p)
manifest=json.loads((O/'input.manifest.json').read_bytes());manifest.pop('content_self_sha256')
for n in ['statement.review.json','reviewer.statement.run.json','lease.json']:
 p=S/n;receipt=pin(p);manifest['inputs'].append(receipt);b=p.read_bytes();stem=f'{len(manifest["inputs"]):03d}.{n}';(O/'inputs'/(stem+'.raw.snapshot')).write_bytes(b);(O/'inputs'/(stem+'.lf.snapshot')).write_bytes(b.replace(b'\r\n',b'\n'))
manifest['input_count']=len(manifest['inputs']);write('input.manifest.json',manifest)
