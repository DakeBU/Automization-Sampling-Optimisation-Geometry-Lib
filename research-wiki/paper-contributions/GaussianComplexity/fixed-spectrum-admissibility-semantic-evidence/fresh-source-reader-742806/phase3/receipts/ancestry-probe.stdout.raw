@actual_precision_admissible : ∀ {d : ℕ},
  2 ≤ d →
    ∀ {κ : ℝ},
      2 ≤ κ →
        ∀ (O : ↥(Matrix.orthogonalGroup (Fin d) ℝ)),
          have θ := fun i => (↑↑i + 1 / 2) * Real.pi / ↑d;
          have A := (↑O * Matrix.diagonal fun i => (κ + 1) / 2 + (κ - 1) / 2 * Real.cos (θ i)) * (↑O).transpose;
          A.PosDef ∧ (A - 1).PosSemidef ∧ (κ • 1 - A).PosSemidef
@multivariateGaussian_eq_withDensity_of_posDef : ∀ {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ),
  A.PosDef →
    ProbabilityTheory.multivariateGaussian 0 A⁻¹ =
      MeasureTheory.volume.withDensity fun x =>
        ENNReal.ofReal (√A.det / (2 * Real.pi) ^ (↑n / 2) * Real.exp (-(x.ofLp ⬝ᵥ A.mulVec x.ofLp) / 2))
'AutoSamplingTheory.ExampleCases.GaussianComplexity.FixedSpectrumAdmissibility.actual_precision_admissible' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
