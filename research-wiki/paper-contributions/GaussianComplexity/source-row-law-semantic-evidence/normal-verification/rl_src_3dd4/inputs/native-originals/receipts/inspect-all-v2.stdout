NATIVE_MODULE_OWNED_FULL_TYPES_BODIES_AXIOMS_EXPORTED 18
@MeasureTheory.integral_map.{u_1, u_2,
    u_3} : ∀ {α : Type u_1} {G : Type u_2} [inst : NormedAddCommGroup.{u_2} G]
  [inst_1 : @NormedSpace.{0, u_2} Real G Real.normedField (@NormedAddCommGroup.toSeminormedAddCommGroup.{u_2} G inst)]
  {m : MeasurableSpace.{u_1} α} {μ : @MeasureTheory.Measure.{u_1} α m} {β : Type u_3} [inst_2 : MeasurableSpace.{u_3} β]
  {φ : α → β},
  @AEMeasurable.{u_1, u_3} α β inst_2 m φ μ →
    ∀ {f : β → G},
      @MeasureTheory.AEStronglyMeasurable.{u_3, u_2} β G
          (@UniformSpace.toTopologicalSpace.{u_2} G
            (@PseudoMetricSpace.toUniformSpace.{u_2} G
              (@SeminormedAddCommGroup.toPseudoMetricSpace.{u_2} G
                (@NormedAddCommGroup.toSeminormedAddCommGroup.{u_2} G inst))))
          inst_2 inst_2 f (@MeasureTheory.Measure.map.{u_1, u_3} α β m inst_2 φ μ) →
        @Eq.{u_2 + 1} G
          (@MeasureTheory.integral.{u_3, u_2} β G inst inst_1 inst_2
            (@MeasureTheory.Measure.map.{u_1, u_3} α β m inst_2 φ μ) fun y => f y)
          (@MeasureTheory.integral.{u_1, u_2} α G inst inst_1 m μ fun x => f (φ x))
