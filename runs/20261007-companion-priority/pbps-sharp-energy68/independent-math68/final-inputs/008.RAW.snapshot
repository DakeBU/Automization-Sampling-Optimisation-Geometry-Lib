      ],
      "compiled_substrate_bindings": [],
      "reading_order": [
        "common regularized energy",
        "deterministic minimizer branch",
        "Gibbs/RGO branch",
        "separate existence, normalization, and invariance obligations"
      ],
      "do_not_conflate": "Sharing an energy does not make the proximal map and restricted Gaussian oracle equivalent outputs."
    },
    {
      "id": "family:conditional-dependence",
      "label": "Conditional influence and local-to-global mixing",
      "plain_language": "Control dependence under all feasible pinnings, then lift local spectral or factorization bounds to a global sampler. Reuse matrix/probability algebra without identifying this condition with strong convexity.",
