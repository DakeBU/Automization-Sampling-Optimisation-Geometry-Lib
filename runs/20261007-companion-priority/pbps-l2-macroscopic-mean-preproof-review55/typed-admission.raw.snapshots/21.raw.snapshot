fun {E} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] {V}
    {α β} {η} hα hαβ hV hH hη hβη =>
  let μ := ℙ.tilted fun x => -V x;
  let J := Measure.map (fun p => (p.1, p.1 + √η • p.2)) (μ.prod (stdGaussian E));
  let ν := J.snd;
  let Λ := Measure.map (fun p => (p.2, 2 • p.1 - p.2)) J;
  let F := fun p => (p.1, 2 • p.1 - p.2);
  let P := (lpMeas ℝ ℝ (MeasurableSpace.comap Prod.snd inferInstance) 2 J).subtypeL ∘SL condExpL2 ℝ ℝ ⋯;
  IsProbabilityMeasure μ ∧
    IsProbabilityMeasure J ∧
      IsProbabilityMeasure ν ∧
        ∃ S,
          IsMarkovKernel S ∧
            (∀ (y : E), S y = ℙ.tilted fun x => -V ((1 / 2) • (y + x)) - ‖y - x‖ ^ 2 / (8 * η)) ∧
              Λ.IsCondKernel S ∧
                Λ.fst = ν ∧
                  Λ.snd = ν ∧
                    ∃ U,
                      (∀ (g : ↥(Lp ℝ 2 J)), ↑↑(U g) =ᵐ[J] ↑↑g ∘ F) ∧
                        Function.Involutive ⇑U ∧
                          IsSelfAdjoint U.toContinuousLinearMap ∧
                            ∃ M,
                              (∀ (u : ↥(Lp ℝ 2 ν)), ↑↑(M u) =ᵐ[J] ↑↑u ∘ Prod.snd) ∧
                                ∃ T,
                                  let A := P * U.toContinuousLinearMap * P;
                                  let B := (1 - P) * U.toContinuousLinearMap * P;
                                  ∀ (u : ↥(Lp ℝ 2 ν)),
                                    P (M u) = M u ∧
                                      M (T u) = A (M u) ∧
                                        ‖T u‖ ≤ ‖u‖ ∧
                                          (↑↑(T u) =ᵐ[ν] fun y => ∫ (x : E), ↑↑u x ∂S y) ∧
                                            (∀ᵐ (y : E) ∂ν,
                                                Integrable (↑↑u) (S y) ∧ Integrable (fun x => ↑↑u x ^ 2) (S y)) ∧
                                              Integrable
                                                  (fun y =>
                                                    AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.Poincare.variance
                                                      (S y) ↑↑u)
                                                  ν ∧
                                                ∫ (y : E),
                                                      AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.Poincare.variance
                                                        (S y) ↑↑u ∂ν =
                                                    ‖B (M u)‖ ^ 2 ∧
                                                  ‖B (M u)‖ ^ 2 =
                                                    ‖u‖ ^ 2 -
                                                      ‖T u‖ ^
                                                        2 : {E : Type u_1} →
  [inst : NormedAddCommGroup E] →
    [inst_1 : InnerProductSpace ℝ E] →
      [FiniteDimensional ℝ E] →
        [inst_3 : MeasurableSpace E] →
          [BorelSpace E] →
            {V : E → ℝ} →
              {α β : ℝ≥0} →
                {η : ℝ} →
                  0 < ↑α →
                    α ≤ β →
                      ContDiff ℝ 2 V →
                        (∀ (x v : E),
                            ↑α * ‖v‖ ^ 2 ≤ ((fderiv ℝ (fderiv ℝ V) x) v) v ∧
                              ((fderiv ℝ (fderiv ℝ V) x) v) v ≤ ↑β * ‖v‖ ^ 2) →
                          0 < η → ↑β * η ≤ 1 → Prop
