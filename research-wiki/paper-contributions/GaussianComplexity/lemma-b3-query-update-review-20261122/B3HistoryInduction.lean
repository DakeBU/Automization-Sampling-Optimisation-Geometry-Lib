import B3HistoryUpdate

/-!
# Iterating the one-step posterior law

The induction used in Zhou–Suzuki, Lemmas B.3–B.4 (arXiv:2610.20492v1):
a deterministic update on the original draw adds its actual response to the
history. Given the initial factorization and the conditional single-step laws,
the history marginal is generated by the sequence of response kernels.
-/

open MeasureTheory ProbabilityTheory
open scoped ProbabilityTheory

namespace AutoSamplingTheory.ExampleCases.GaussianComplexity.HaarPosterior

universe u v w

/-- At each step the old history is retained together with the recorded response. -/
def QueryHistory (H : Type u) (Y : ℕ → Type u) : ℕ → Type u
  | 0 => H
  | t + 1 => QueryHistory H Y t × Y t

instance queryHistorySpace (H : Type u) (Y : ℕ → Type u)
    [MeasurableSpace H] [∀ t, MeasurableSpace (Y t)] : (t : ℕ) → MeasurableSpace (QueryHistory H Y t)
  | 0 => ‹MeasurableSpace H›
  | t + 1 => @MeasurableSpace.prod _ _ (queryHistorySpace H Y t) inferInstance

variable {H : Type u} {Y : ℕ → Type u} [MeasurableSpace H] [∀ t, MeasurableSpace (Y t)]

/-- History law obtained by sampling the successive answers. -/
noncomputable def iteratedHistoryLaw (ρ : Measure H)
    (answer : ∀ t, Kernel (QueryHistory H Y t) (Y t)) : (t : ℕ) → Measure (QueryHistory H Y t)
  | 0 => ρ
  | t + 1 => iteratedHistoryLaw ρ answer t ⊗ₘ answer t

private theorem sfinite_historyLaw (ρ : Measure H) [SFinite ρ]
    (answer : ∀ t, Kernel (QueryHistory H Y t) (Y t)) (t : ℕ) :
    SFinite (iteratedHistoryLaw ρ answer t) := by
  cases t with
  | zero => exact inferInstanceAs (SFinite ρ)
  | succ t => exact inferInstanceAs (SFinite (iteratedHistoryLaw ρ answer t ⊗ₘ answer t))

variable {Ω : Type v} {X : ℕ → Type w} [MeasurableSpace Ω] [∀ t, MeasurableSpace (X t)]

/-- A deterministic evolution of the history and all residuals, starting from
one draw from the original sample space. A padding step can record a fixed
symbol and return the old residual. -/
structure QueryEvolution (Ω : Type v) (H : Type u) (Y : ℕ → Type u) (X : ℕ → Type w)
    [MeasurableSpace Ω] [MeasurableSpace H] [∀ t, MeasurableSpace (Y t)]
    [∀ t, MeasurableSpace (X t)] where
  initial : Ω → H × X 0
  initial_measurable : Measurable initial
  step : ∀ t, QueryHistory H Y t → X t → Y t × X (t+1)
  step_measurable : ∀ t, Measurable (Function.uncurry (step t))

/-- Actual history and residuals after executing the first `t` updates on the
same original draw. -/
def QueryEvolution.run (q : QueryEvolution Ω H Y X) :
    (t : ℕ) → Ω → QueryHistory H Y t × X t
  | 0 => q.initial
  | t + 1 => fun ω =>
    let p := q.run t ω
    let s := q.step t p.1 p.2
    ((p.1, s.1), s.2)

private theorem QueryEvolution.measurable_run (q : QueryEvolution Ω H Y X) (t : ℕ) :
    Measurable (q.run t) := by
  induction t with
  | zero => exact q.initial_measurable
  | succ t ih =>
    have hs := (q.step_measurable t).comp ih
    exact (ih.fst.prodMk hs.fst).prodMk hs.snd

/-- The updated residual law depends on the previous history, which is part
of the new history. -/
noncomputable def iteratedResidualKernel (initial : Kernel H (X 0))
    (remaining : ∀ t, Kernel (QueryHistory H Y t) (X (t+1))) :
    (t : ℕ) → Kernel (QueryHistory H Y t) (X t)
  | 0 => initial
  | t+1 => Kernel.prodMkRight (Y t) (remaining t)

/-- Data about an experiment checked locally at initialization and at one
transition. The product law is only required almost everywhere for the
iterated history law, so fibers off the legal histories may be filled freely. -/
structure QueryPosterior (q : QueryEvolution Ω H Y X) (μ : Measure Ω) (ρ : Measure H)
    (answer : ∀ t, Kernel (QueryHistory H Y t) (Y t)) where
  initial : Kernel H (X 0)
  initial_markov : IsMarkovKernel initial
  remaining : ∀ t, Kernel (QueryHistory H Y t) (X (t+1))
  remaining_markov : ∀ t, IsMarkovKernel (remaining t)
  initial_law : μ.map q.initial = ρ ⊗ₘ initial
  fiber_law : ∀ t, ∀ᵐ h ∂iteratedHistoryLaw ρ answer t,
    (iteratedResidualKernel initial remaining t h).map (q.step t h) =
      (answer t h).prod (remaining t h)

variable {ρ : Measure H} [SFinite ρ]
    {answer : ∀ t, Kernel (QueryHistory H Y t) (Y t)} [∀ t, IsMarkovKernel (answer t)]
    {q : QueryEvolution Ω H Y X} {μ : Measure Ω}

omit [SFinite ρ] [∀ t, IsMarkovKernel (answer t)] in
private theorem QueryPosterior.markov (P : QueryPosterior q μ ρ answer) (t : ℕ) :
    IsMarkovKernel (iteratedResidualKernel P.initial P.remaining t) := by
  cases t with
  | zero => exact P.initial_markov
  | succ t =>
    let := P.remaining_markov t
    exact inferInstanceAs (IsMarkovKernel (Kernel.prodMkRight (Y t) (P.remaining t)))

/-- The joint pushforward of the actual deterministic experiment at every
finite time has the recursively constructed posterior. -/
theorem QueryPosterior.joint_law (P : QueryPosterior q μ ρ answer) (t : ℕ) :
    μ.map (q.run t) =
      iteratedHistoryLaw ρ answer t ⊗ₘ iteratedResidualKernel P.initial P.remaining t := by
  induction t with
  | zero => exact P.initial_law
  | succ t ih =>
    let advance := fun p : QueryHistory H Y t × X t =>
      ((p.1, (q.step t p.1 p.2).1), (q.step t p.1 p.2).2)
    have hs := q.step_measurable t
    have ha : Measurable advance := (measurable_fst.prodMk hs.fst).prodMk hs.snd
    let := sfinite_historyLaw ρ answer t
    let := P.markov t
    let := P.remaining_markov t
    calc
      _ = (μ.map (q.run t)).map advance := (Measure.map_map ha (q.measurable_run t)).symm
      _ = _ := by
        rw [ih]
        exact extend_history_posterior _ _ _ _ _ hs (P.fiber_law t)

/-- Marginalizing the residuals gives the law of the actual history. -/
theorem QueryPosterior.history_law (P : QueryPosterior q μ ρ answer) (t : ℕ) :
    μ.map (fun ω => (q.run t ω).1) = iteratedHistoryLaw ρ answer t := by
  let := sfinite_historyLaw ρ answer t
  let := P.markov t
  calc
    _ = (μ.map (q.run t)).map Prod.fst :=
      (Measure.map_map measurable_fst (q.measurable_run t)).symm
    _ = _ := by
      rw [P.joint_law]
      exact Measure.fst_compProd _ _

/-- Two experiments with a common initial history law and common response
kernels have equal actual finite transcript laws, including deterministic
padding when it is part of the updates. Their latent laws may differ. -/
theorem same_history_of_shared_answers
    {Ω' : Type*} [MeasurableSpace Ω'] {X' : ℕ → Type*} [∀ t, MeasurableSpace (X' t)]
    {q' : QueryEvolution Ω' H Y X'} {μ' : Measure Ω'}
    (P : QueryPosterior q μ ρ answer) (P' : QueryPosterior q' μ' ρ answer) (t : ℕ) :
    μ.map (fun ω => (q.run t ω).1) = μ'.map (fun ω => (q'.run t ω).1) :=
  (P.history_law t).trans (P'.history_law t).symm

#print axioms QueryPosterior.joint_law
#print axioms same_history_of_shared_answers

end AutoSamplingTheory.ExampleCases.GaussianComplexity.HaarPosterior
