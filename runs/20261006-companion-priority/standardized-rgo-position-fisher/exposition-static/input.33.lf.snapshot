    {
      "id": "transport:statistical-loss",
      "kind": "concept-bridge",
      "label": "OT estimation and sampling: distinct budgets",
      "status": "proposal",
      "subtitle": "comparison contract",
      "summary": "OT statistical estimation controls uncertainty from observed samples; computational sampling controls the cost of generating approximate draws.",
      "formula": "n_{\\mathrm{data}}\\neq Q_{\\mathrm{oracle}}",
      "details": [
        {
          "label": "Evidence boundary",
          "value": "Literature/structural correspondence; no Lean-certified functor or theorem transfer."
        },
        {
          "label": "Mechanism",
          "value": "OT statistical estimation controls uncertainty from observed samples; computational sampling controls the cost of generating approximate draws."
        },
        {
          "label": "Hypothesis Map",
          "value": "Record data access versus potential/gradient access, population class, dimension, metric and any reduction between experiments."
        },
        {
          "label": "Conclusion Map",
          "value": "Common discrepancy/testing lemmas may be reused while the two notions of sample complexity stay distinct."
        },
        {
          "label": "Failure Boundary",
          "value": "No minimax statistical rate becomes a sampling query lower bound without a source-backed, cost-preserving reduction."
        },
        {
          "label": "Category objects",
          "value": "Typed problem presentations, not field names."
        },
        {
          "label": "Category morphisms",
          "value": "A specified solution/certificate transport; no total morphism map is claimed."
