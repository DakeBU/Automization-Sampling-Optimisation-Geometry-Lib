fun {Omega} {m} {filtration} {n} eta t omega =>
  ∑ i, if eta.times i.castSucc < t ∧ t ≤ eta.times i.succ then eta.coeff i omega else 0
def AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.ElementaryItoIntegral.elementaryItoIntegral.{u_1} : {Omega :
    Type u_1} →
  {m : MeasurableSpace Omega} →
    {filtration : MeasureTheory.Filtration NNReal m} →
      {n : ℕ} →
        AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.ElementaryItoIntegral.ElementaryAdaptedProcess filtration
            n →
          (NNReal → Omega → ℝ) → NNReal → Omega → ℝ :=
fun {Omega} {m} {filtration} {n} eta B T omega =>
  ∑ i, eta.coeff i omega * (B (min (eta.times i.succ) T) omega - B (min (eta.times i.castSucc) T) omega)
