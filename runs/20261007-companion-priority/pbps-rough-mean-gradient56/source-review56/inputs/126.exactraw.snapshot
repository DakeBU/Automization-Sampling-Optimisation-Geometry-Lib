<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex17.m1" class="ltx_math_unparsed" alttext="\displaystyle\nabla\mathsf{U}_{\mathsf{P}\mathsf{P}}f(y)" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><msub><mi>𝖴</mi><mi>𝖯𝖯</mi></msub><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\nabla\mathsf{U}_{\mathsf{P}\mathsf{P}}f(y)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex17.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathrm{Cov}\Bigl(f(Y_{-}),\frac{1}{2}\nabla V(X)-\frac{y-Y_{-}}{4\eta}\,\Bigm|\,Y_{+}=y\Bigr)-\mathrm{Cov}(f(Y_{-}),\nabla V(X)\mid Y_{+}=y)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>Cov</mi><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>y</mi><mo>−</mo><msub><mi>Y</mi><mo>−</mo></msub></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mfrac></mstyle><mo fence="false" lspace="0.150em" maxsize="1.600em" minsize="1.600em" rspace="0.317em" stretchy="true">|</mo><msub><mi>Y</mi><mo>+</mo></msub><mo>=</mo><mi>y</mi><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>−</mo><mi>Cov</mi><mrow><mo stretchy="false">(</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mo rspace="0.167em">∇</mo><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>Y</mi><mo>+</mo></msub><mo>=</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathrm{Cov}\Bigl(f(Y_{-}),\frac{1}{2}\nabla V(X)-\frac{y-Y_{-}}{4\eta}\,\Bigm|\,Y_{+}=y\Bigr)-\mathrm{Cov}(f(Y_{-}),\nabla V(X)\mid Y_{+}=y)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
