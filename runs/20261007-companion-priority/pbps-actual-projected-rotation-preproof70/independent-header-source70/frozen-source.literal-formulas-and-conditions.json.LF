    {
      "RAW_bytes": 3288,
      "RAW_sha256": "8b0fcf274f61f957b82aaebd7f8c08167997363814521dab4578fad6b9b9099d",
      "alttext": "\\mathsf{T}=\\begin{pmatrix}\\mathsf{T}_{\\mathsf{P}\\mathsf{P}}&\\mathsf{T}_{\\mathsf{P}\\perp}\\\\\n\\mathsf{T}_{\\perp\\mathsf{P}}&\\mathsf{T}_{\\perp\\perp}\\end{pmatrix}\\,,\\hskip 20.00003pt\\begin{aligned} \\mathsf{T}_{\\mathsf{P}\\mathsf{P}}&\\coloneqq\\mathsf{P}\\mathsf{T}\\mathsf{P}\\,,&\\mathsf{T}_{\\mathsf{P}\\perp}&\\coloneqq\\mathsf{P}\\mathsf{T}\\mathsf{P}^{\\perp}\\,,\\\\\n\\mathsf{T}_{\\perp\\mathsf{P}}&\\coloneqq\\mathsf{P}^{\\perp}\\mathsf{T}\\mathsf{P}\\,,&\\mathsf{T}_{\\perp\\perp}&\\coloneqq\\mathsf{P}^{\\perp}\\mathsf{T}\\mathsf{P}^{\\perp}\\,.\\end{aligned}",
      "id": "A2.E3.m1",
