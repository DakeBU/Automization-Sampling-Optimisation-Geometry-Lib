+{"math_id": "A2.E12.m1", "alttext": "\\rho_{\\rm mac}\\coloneqq\\frac{1-\\alpha\\eta}{1+\\alpha\\eta}\\,,\\hskip 20.00003pt\\gamma_{\\rm gap}\\coloneqq\\sqrt{1-\\rho_{\\rm mac}^{2}}=\\frac{2\\sqrt{\\alpha\\eta}}{1+\\alpha\\eta}\\,.", "RAW_start": 775269, "RAW_end_exclusive": 776608, "RAW_bytes": 1339, "RAW_sha256": "9905e9f217f502cb25f0d34745f831a303d95a84d654d90d2e42a9dc47d34413"}
