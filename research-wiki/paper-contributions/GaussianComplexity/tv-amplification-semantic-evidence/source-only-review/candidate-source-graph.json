  "source_nodes": [
    {
      "id": "N-Haar",
      "kind": "source-definition",
      "source_anchors": [
        "S2.p2.1"
      ],
      "meaning": "O(n)={O real nxn : O^T O=I}; Haar probability has determinant components of mass 1/2 each; mu_{n,b} is Haar conditional probability on det O=b, b in {-1,+1}.",
      "status": "SOURCE_ONLY_CANDIDATE_NOT_FORMALIZED_OR_REVIEW_ACCEPTED"
    },
    {
      "id": "N-PrecisionClass",
      "kind": "source-definition",
      "source_anchors": [
        "S2.p1.1",
        "S2.SS0.SSS0.Px1.p1.1",
        "S2.Ex1"
      ],
      "meaning": "d>=1 integer, kappa>=1; A_{d,kappa}={symmetric A : I_d<=A<=kappa I_d}. Matrix order and Euclidean conventions are fixed here.",
      "status": "SOURCE_ONLY_CANDIDATE_NOT_FORMALIZED_OR_REVIEW_ACCEPTED"
    },
    {
      "id": "N-GaussianTarget",
      "kind": "source-definition",
      "source_anchors": [
        "S2.SS0.SSS0.Px1.p1.2"
      ],
      "meaning": "For an actual admissible precision A, pi_A=N(0,A^{-1}) and f_A(x)=x^T A x/2. Ex72 consumes pi_A; f_A is not an input.",
      "status": "SOURCE_ONLY_CANDIDATE_NOT_FORMALIZED_OR_REVIEW_ACCEPTED"
    },
    {
      "id": "N-TV",
      "kind": "source-definition",
      "source_anchors": [
        "S2.SS0.SSS0.Px3.p1.1",
        "S2.Ex2",
        "S2.SS0.SSS0.Px3.p1.2"
      ],
      "meaning": "TV(P,Q)=sup_{B measurable}|P(B)-Q(B)|=(1/2) integral |p-q| d lambda for probability laws with common dominating measure. Measurable [0,1] test inequality is the convention used upstream in B7.",
      "status": "SOURCE_ONLY_CANDIDATE_NOT_FORMALIZED_OR_REVIEW_ACCEPTED"
    },
    {
      "id": "N-Parameters",
      "kind": "source-standing-assumption",
      "source_anchors": [
        "S3.SS1.p1.1"
      ],
      "meaning": "kappa>=4 and integers 3<=n<=d, k:=floor(d/n). The later choice n=2T+1 is contextual main-theorem specialization and is not assumed for Ex72.",
      "status": "SOURCE_ONLY_CANDIDATE_NOT_FORMALIZED_OR_REVIEW_ACCEPTED"
    },
    {
      "id": "N-SinglePrecision",
      "kind": "source-definition",
      "source_anchors": [
        "S3.E4"
      ],
      "meaning": "A_O=((kappa+1)/2) I_n - ((kappa-1)/4)(O+O^T).",
      "status": "SOURCE_ONLY_CANDIDATE_NOT_FORMALIZED_OR_REVIEW_ACCEPTED"
    },
    {
      "id": "N-BlockPrecision",
      "kind": "source-definition",
      "source_anchors": [
        "S3.SS1.p1.2",
        "S3.E5"
      ],
      "meaning": "A_boldO=diag(A_O1,...,A_Ok,I_{d-kn}).",
      "status": "SOURCE_ONLY_CANDIDATE_NOT_FORMALIZED_OR_REVIEW_ACCEPTED"
    },
    {
      "id": "N-Prior",
      "kind": "source-definition",
      "source_anchors": [
        "S3.SS1.p2.1"
      ],
      "meaning": "For each fixed b, draw O_1,...,O_k independently from mu_{n,b}; D_b is the law of A_boldO. All blocks share b; the O_j need not coincide.",
      "status": "SOURCE_ONLY_CANDIDATE_NOT_FORMALIZED_OR_REVIEW_ACCEPTED"
    },
    {
      "id": "N-SingleMixture",
      "kind": "source-definition",
      "source_anchors": [
        "S3.SS1.p3.1"
      ],
      "meaning": "P_b=E_{O~mu_{n,b}}[N(0,A_O^{-1})] as a probability-law mixture.",
      "status": "SOURCE_ONLY_CANDIDATE_NOT_FORMALIZED_OR_REVIEW_ACCEPTED"
    },
    {
      "id": "N-AveragedTarget",
      "kind": "source-definition-and-law-identity",
      "source_anchors": [
        "S3.SS1.p3.1",
        "S3.E6"
      ],
      "meaning": "bar_pi_b=E_{A~D_b}[pi_A]=P_b^{tensor k} tensor N(0,I_{d-kn}); these are the actual laws compared by Ex72. Any future M_plus/M_minus must have this meaning.",
      "status": "SOURCE_ONLY_CANDIDATE_NOT_FORMALIZED_OR_REVIEW_ACCEPTED"
    },
    {
      "id": "N-ZeroResidual",
      "kind": "source-definition-convention",
      "source_anchors": [
        "S3.SS1.p3.2"
      ],
      "meaning": "When kn=d omit both the identity block and the final Gaussian law factor; no positive-residual assumption is allowed.",
      "status": "SOURCE_ONLY_CANDIDATE_NOT_FORMALIZED_OR_REVIEW_ACCEPTED"
    },
    {
      "id": "N-ActualDensities",
      "kind": "source-density-notation",
      "source_anchors": [
        "A2.SS2.p2.1"
      ],
      "meaning": "n>=3,kappa>=4; full Haar O and U=O_11 are upstream notation. p_O is the density of N(0,A_O^{-1}); p_b is the density of the actual P_b. These are not free density parameters.",
      "status": "SOURCE_ONLY_CANDIDATE_NOT_FORMALIZED_OR_REVIEW_ACCEPTED"
    },
    {
      "id": "N-SingleRegularity",
      "kind": "substantive-source-proof-step",
      "source_anchors": [
        "A2.SS3.p2.1",
        "A2.Ex73",
        "A2.SS3.p2.2",
        "A2.E26"
      ],
      "meaning": "Orthogonality and Cauchy-Schwarz give ||Ov||=||v|| and |<v,Ov>|<=||v||^2. The displayed quadratic form therefore gives symmetry and I_n<=A_O<=kappa I_n.",
      "status": "SOURCE_ONLY_CANDIDATE_NOT_FORMALIZED_OR_REVIEW_ACCEPTED"
    },
    {
      "id": "N-FamilyRegularity",
      "kind": "substantive-source-proof-step",
      "source_anchors": [
        "A2.SS3.p1.1",
        "A2.Thmtheorem8",
        "A2.Thmtheorem8.p1.1",
        "A2.SS3.p3.1",
        "A2.Ex74",
        "A2.SS3.p3.2"
      ],
      "meaning": "Apply the single-block spectral bound and kappa>=1 to the block sum, omitting z when kn=d, to conclude A_boldO in A_{d,kappa}. Only this regularity projection of B8 is consumed; the unique-minimizer conclusion is outside Ex72.",
      "status": "SOURCE_ONLY_CANDIDATE_NOT_FORMALIZED_OR_REVIEW_ACCEPTED"
    },
    {
      "id": "N-B7",
      "kind": "imported-source-proposition",
      "source_anchors": [
        "A2.Thmtheorem7",
        "A2.Thmtheorem7.p1.1",
        "A2.E19"
      ],
      "meaning": "For n>=3,kappa>=4, TV(P_+,P_-) >= ((sqrt(kappa)-1)/(sqrt(kappa)+1))^n / (2+4n sqrt(kappa)/(sqrt(kappa)+1)^2) >= (1/2) exp(-5n/sqrt(kappa)). P_+,P_- are the actual Haar-conditioned Gaussian mixtures. This packet treats B7 as a real upstream input; it does not re-prove or admit it.",
      "status": "SOURCE_ONLY_CANDIDATE_NOT_FORMALIZED_OR_REVIEW_ACCEPTED"
    },
    {
      "id": "N-Affinity",
      "kind": "source-definition",
      "source_anchors": [
        "A2.SS2.SSS3.p2.1",
        "A2.Ex68"
      ],
      "meaning": "a=integral_{R^n} sqrt(p_+(x)p_-(x)) dx for actual single-block densities.",
      "status": "SOURCE_ONLY_CANDIDATE_NOT_FORMALIZED_OR_REVIEW_ACCEPTED"
