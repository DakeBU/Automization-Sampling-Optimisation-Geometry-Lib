  "verdict": "equivalent-after-elaboration",
  "blocking": false,
  "semantic_slots": {
    "objects": {
      "original": "Actual centered variance-one Gaussian on finite real Hilbert E; signed f and literal Riesz gradient; homogeneous square entropy. Scoped sufficient Gaussian-LSI background, not the printed RGO W2 conclusion.",
      "reconstructed": "An arbitrary real inner-product space E with compatible norm, finite dimension and completeness; its Borel measurable structure; a signed function f : E -> real; gamma = the literal canonical standard Gaussian measure on E; the literal Hilbert gradient grad f; the scalar m = integral_E f^2 dgamma.",
      "relation": "explicit-elaboration",
      "evidence": "Literal stdGaussian unfolding and inverse canonical basis-sum hγ; global inner_gradient_left in hD."
    },
    "domains": {
      "original": "Finite complete real Hilbert/Borel E including dimension0; globally C2 compact f. Real whole-space Bochner integrals under literal stdGaussian; total log(0)=0.",
      "reconstructed": "f and its global derivatives have domain all of E. Values of f are arbitrary real numbers. gamma is a probability measure on the Borel sets of E, obtained from independent centered variance-one real Gaussian coordinates under the canonical orthonormal basis sum, including the empty sum and Dirac law in rank zero. grad f(x) lies in E. Norms are the compatible Hilbert norms; no coordinate sup-norm energy is substituted. Every displayed integral is a real Bochner integral over the whole E with respect to gamma. The entropy uses nonnegative f^2, and the total real logarithm, including log(0) = 0.",
      "relation": "explicit-elaboration",
      "evidence": "C2/homeomorphism pullback supplies actual40 domains; cm/cp/ce and integrable_map_measure establish L1 before integral_map."
    },
    "quantifiers": {
      "original": "For every E with listed typing structures and every f with C2 and compact support, all three domains and bound are conclusions for this same f and this internally defined law.",
      "reconstructed": "Universally quantified over E, the specified compatible algebraic/topological/measurable structures, and every f : E -> real. For each such f, globally C2 Frechet smoothness and compact support imply all three integrability conclusions and the entropy bound. gamma is fixed by E inside the conclusion; it is not an independently supplied measure. There are no extra existential witnesses, covariance parameters, supplied transport maps, normalization conditions, or premise certificates for the desired inequality.",
      "relation": "equivalent",
      "evidence": "Exact640 unchanged signature; sole private provider has internally chosen basis; public conclusion uses same f/law."
    },
    "assumptions": {
      "original": "Only the specified space structures, f, C2 and compact support. No probability/law/basis/energy/domain/inequality certificate, positivity, normalized mass or positive dimension.",
      "reconstructed": "E is a normed additive commutative group and real inner-product space, complete and finite-dimensional over the reals, with a measurable space satisfying BorelSpace. f is ContDiff real 2 on all E and HasCompactSupport. These are the analytic premises. No sign restriction, strict positivity, nonzero mass, unit mass, prior L1/Sobolev-domain certificate, measure-law identification certificate, Parseval certificate, or inequality certificate is assumed.",
      "relation": "equivalent",
      "evidence": "Binder recursion SOURCE compact class and TYPING structures; law/gradient/Parseval/L1 are internally derived RULED facts. Source EXCESS empty."
    },
    "conclusion": {
      "original": "f², f²log(f²), ||gradient f||² are integrable and homogeneous Ent(f²)<=2 integral ||gradient f||².",
      "reconstructed": "Conjunction: (1) f^2 is gamma-integrable; (2) f^2 log(f^2) is gamma-integrable; (3) ||grad f||^2 is gamma-integrable; (4) Ent_gamma(f^2) = integral_E f^2 log(f^2) dgamma - (integral_E f^2 dgamma) log(integral_E f^2 dgamma) <= 2 integral_E ||grad f||^2 dgamma. Entropy is the homogeneous square entropy, without a denominator or unit-mass restriction.",
      "relation": "equivalent",
      "evidence": "Full public proof applies actual40 to f∘T then maps both entropy terms and energy using exact pullback_energy."
    },
    "scopes": {
      "original": "Authored compact finite-Hilbert Gaussian background, explicitly narrower than full W12/noncompact LSI. Genuine posterior-cutoff Test only; no cutoff exhaustion, coherent KL/Fisher, T2, FIRST4.6 or main/cost credit.",
      "reconstructed": "C2 regularity and compact support are global conditions on f. The gradient is the global Frechet derivative represented through the real inner product, not an independently supplied field or a weak derivative choice. The law is exactly the canonical standard Gaussian of E. Integrability and the bound are simultaneous consequences for this same function and actual law. Rank zero, signed f, and zero squared mass are admitted. The conclusion is bounded to this function class and finite-dimensional geometry; no general Sobolev closure, arbitrary Gaussian covariance, other distribution, or infinite-dimensional assertion is made.",
      "relation": "explicit-elaboration",
      "evidence": "Primary FIRST4.6 invokes LSI plus Talagrand on noncompact standardized RGO. Source/publication explicitly identify this leaf as sufficient compact background. All seven lesson steps and three complete Test declarations agree."
    },
    "constant_dependencies": {
      "original": "Literal variance1 gives universal coefficient2, without dimension factor or sup-Pi operator-norm substitution; signs, zero mass and rank0 retained.",
      "reconstructed": "The numeric inequality coefficient is exactly 2. It does not depend on E, its dimension, f, support radius, derivative bounds, or m. Centered variance-one coordinates fix the Gaussian normalization. No auxiliary constants or hidden law/gradient certificate parameters occur.",
      "relation": "equivalent",
      "evidence": "b.sum_sq_inner_left equates coordinate-square sum and true Hilbert gradient norm; coefficient2 unchanged, including empty basis."
    }
  },
