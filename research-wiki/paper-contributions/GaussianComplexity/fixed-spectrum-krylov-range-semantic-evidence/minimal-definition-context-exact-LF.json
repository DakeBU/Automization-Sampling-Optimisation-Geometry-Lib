      "source_LF_included_exactly": true
    },
    {
      "file": ".lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/PiL2.lean",
      "kind": "characterization-statement-only",
      "context": [
        "variable {ι ι' 𝕜 : Type*} [RCLike 𝕜]",
        "variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace 𝕜 E]",
        "local notation \"⟪\" x \", \" y \"⟫\" => inner 𝕜 x y",
        "variable [Fintype ι]",
        "namespace EuclideanSpace"
      ],
      "start_line_1based": 215,
      "literal": "theorem inner_eq_star_dotProduct (x y : EuclideanSpace 𝕜 ι) :\n    ⟪x, y⟫ = ofLp y ⬝ᵥ star (ofLp x)",
      "literal_sha256": "e4a3d0b0e6053e9acfa55d400d8c551feecdccd41f6fc9ba4b3f6c7ae062108b",
