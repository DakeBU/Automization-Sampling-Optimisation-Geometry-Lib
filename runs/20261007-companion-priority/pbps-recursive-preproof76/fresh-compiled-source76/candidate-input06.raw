  "data_quantifiers": {
    "arc_variable": "t:NNReal or finite real t with t≥0; outgoing arc interpretation restricted to 0≤t<τ",
    "fixed_analytic_data": "E,V,α,β,η with original six callers and five typing classes",
    "joint_variables": "y,xRef:E; z0:E×E; e:Nat→NNReal; n:Nat",
    "legal_degenerate_cases": [
      "rank(E)=0",
      "α*η=1",
      "H(z0)=0",
      "C0=0",
      "e_n=0",
      "τ=∞"
