429: def main(argv=None) -> int:
430:     parser = argparse.ArgumentParser(description=__doc__)
431:     sub = parser.add_subparsers(dest='command', required=True)
432:     check = sub.add_parser('check')
433:     check.add_argument('--base')
434:     check.add_argument('--ci', action='store_true')
435:     sub.add_parser('summary')
436:     p = sub.add_parser('packet')
437:     p.add_argument('--cell', required=True)
438:     graph = sub.add_parser('graph-check')
439:     graph.add_argument('--cell', required=True)
440:     graph.add_argument('--output', type=Path, default=ROOT / '_site')
441:     context = sub.add_parser('review-context')
442:     context.add_argument('--declaration', required=True)
443:     context.add_argument('--item', required=True)
444:     args = parser.parse_args(argv)
445:     try:
446:         if args.command == 'graph-check':
447:             print(json.dumps(graph_report(args.cell, args.output), ensure_ascii=False, indent=2))
448:         elif args.command == 'review-context':
449:             item = next(i for i in load() if i['id'] == args.item)
450:             b = next(b for b in item['bindings'] if b['declaration'] == args.declaration)
451:             print(json.dumps({'publication_binding_sha256': binding_digest(item, b),
452:                               'publication_context': review_context(item, b)}, ensure_ascii=False, indent=2))
453:         elif args.command == 'packet':
454:             print(json.dumps(packet(args.cell), ensure_ascii=False, indent=2))
455:         elif args.command == 'summary':
456:             print(json.dumps({l: chapter_progress(l) for l in sorted({i['library'] for i in load()})}, indent=2))
457:         else:
458:             base = args.base
459:             if args.ci:
460:                 base = os.environ.get('PUBLICATION_BASE') or None
461:                 if not base or set(base) == {'0'}:
462:                     base = 'HEAD^'
463:             errors = roundtrip.validate_registry(roundtrip.load_registry())
464:             errors += validate(strict_names=release_targets(base) if base or args.ci else None)
465:             if errors:
466:                 print('\n'.join(errors), file=sys.stderr)
467:                 return 1
468:             for row in PRIVATE_IMPLEMENTATION_COVERAGE:
469:                 print('Private implementation coverage: ' + json.dumps(row, ensure_ascii=False))
470:             print(f'Publication PASS: {len(load())} source items; code, prose, assumptions and semantic-audit links checked. Legacy audit debt remains explicit.')
471:     except (ValueError, KeyError, StopIteration, subprocess.CalledProcessError) as exc:
472:         print(str(exc), file=sys.stderr)
473:         return 1
474:     return 0
475: 
476: 
477: if __name__ == '__main__':
478:     raise SystemExit(main())
