  {s t : NNReal} (hst : s ≤ t) (htT : t ≤ T) (w : Omega → ℝ) (hw : MeasureTheory.StronglyMeasurable w) {C : ℝ}
  (hC : ∀ (omega : Omega), |w omega| ≤ C) :
