{
  "schema_version": 1,
  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.Measure.AffineGibbs.map_affine_gibbs",
      "title": "Actual affine normalized Gibbs transport",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06906v1#S4.Ex8",
          "label": "SPHMC Ex8/p4.2/p4.3 and scoped4.6; affine prerequisite",
          "scope": "Canonical signed affine identity for arbitrary F and nonzero scale, no eta/curvature/probability/integrability premise. The current actual SPHMC consumer separately produces allpositiveeta true posterior normalization and lastTWO4.6 moments. FIRSTW2/bias/MGF/fullLemma/main/work/composition remainOPEN; generic map identity itself is no probability assertion."
        }
      ],
      "tests": [
        "lake build Tests.StandardizedRGOPositionFisher"
      ],
      "assumptions": [
        "Finite real Hilbert/Borel full space E, including dimension zero; any function F:E->R, any translation p:E and a real scale s!=0.",
        "No continuity, measurability of F, exponential integrability, probability or moment premise. Equality is of Mathlib totalized normalized tilted measures; probability is a separate obligation for every consumer."
      ],
      "statement": "The actual pushforward of the normalized Lebesgue Gibbs tilt under x->p+s*x is the normalized Lebesgue tilt with inverse-affine potential x->F(s^-1*(x-p)). The nonzero actual Lebesgue Jacobian cancels between partition and set numerator. This canonical identity alone makes no probability assertion.",
      "formula": "T(x)=p+sx,\\quad H(x)=s^{-1}(x-p),\\quad T_\\#(Z_F^{-1}e^{-F}dx)=Z_{F\\circ H}^{-1}e^{-F\\circ H}dx.",
      "boundary": "Canonical signed affine identity for arbitrary F and nonzero scale, no eta/curvature/probability/integrability premise. The current actual SPHMC consumer separately produces allpositiveeta true posterior normalization and lastTWO4.6 moments. FIRSTW2/bias/MGF/fullLemma/main/work/composition remainOPEN; generic map identity itself is no probability assertion.",
      "steps": [
        {
          "title": "Fix the true affine inverse",
          "text": "Use T(x)=p+s*x and H(x)=s^-1*(x-p). Nonzero s gives H(T(x))=x and a measurable forward map, even for negative scales or zero dimension.",
          "formula": "H(T(x))=x,\\quad J=|s^{-d}|\\ne0.",
          "lean": "map_affine_gibbs; Measurable.smul; smul_smul"
        },
        {
          "title": "Transform the actual Lebesgue integrals",
          "text": "The canonical Haar scalar and translation change of variables applies to actual Bochner integrals. Apply it to exp(-F o H) and to its measurable-set indicator. Both the original partition and set numerator acquire the same real factor J; no moment or integrability estimate is assumed.",
          "formula": "Z_F=JZ_{F\\circ H},\\quad\\int_{T^{-1}B}e^{-F}dx=J\\int_Be^{-F\\circ H}dx.",
          "lean": "Measure.integral_comp_smul; integral_add_left_eq_self; integral_indicator"
        },
        {
          "title": "Cancel the Jacobian in the normalized law",
          "text": "Use map_apply on the measurable affine map and tilted_apply_eq_ofReal_integral on each measurable set. J!=0 cancels in the numerator/partition ratio. Mathlib totalizes improper integrals; this identity does not certify probability. The source consumer below derives positive integrability internally.",
          "formula": "\\frac{J\\int_Be^{-F\\circ H}}{JZ_{F\\circ H}}=\\frac{\\int_Be^{-F\\circ H}}{Z_{F\\circ H}}.",
          "lean": "Measure.map_apply; tilted_apply_eq_ofReal_integral'; integral_div; mul_div_mul_left"
        }
      ],
      "lean_statement": "The actual pushforward of the normalized Lebesgue Gibbs tilt under x->p+s*x is the normalized Lebesgue tilt with inverse-affine potential x->F(s^-1*(x-p)). The nonzero actual Lebesgue Jacobian cancels between partition and set numerator. This canonical identity alone makes no probability assertion.",
      "lean_proof": "Fix the true affine inverse; Transform the actual Lebesgue integrals; Cancel the Jacobian in the normalized law",
      "astis_dependencies": [],
      "mathlib_dependencies": [
        "Measure.integral_comp_smul",
        "integral_add_left_eq_self",
        "integral_indicator",
        "Measure.map_apply",
        "tilted_apply_eq_ofReal_integral'",
        "mul_div_mul_left"
      ]
    }
  ]
}
