  (hCont : ∀ᵐ (omega : Omega) ∂mu, ContinuousOn (fun t => w t omega) (Set.Icc 0 T)) {C : ℝ}
  (hBound : ∀ t ≤ T, ∀ (omega : Omega), |w t omega| ≤ C) :
