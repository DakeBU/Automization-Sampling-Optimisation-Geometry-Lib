        {
          "title": "Use entropy dissipation as an averaged stationarity bound",
          "formula": "\\frac{d}{dt}\\mathrm{KL}(\\mu_t\\|\\pi)=-\\mathrm{FI}(\\mu_t\\|\\pi)\\quad\\Longrightarrow\\quad \\frac1T\\int_0^T\\mathrm{FI}(\\mu_t\\|\\pi)dt\\le\\frac{\\mathrm{KL}(\\mu_0\\|\\pi)}T.",
          "explanation": "Even without log-concavity, integrated Fisher information can decay because relative entropy is nonnegative."
        },
        {
          "title": "Randomize an output time",
          "formula": "\\tau\\sim\\mathrm{Unif}[0,T]\\quad\\Longrightarrow\\quad \\mathbb E\\,\\mathrm{FI}(\\mu_\\tau\\|\\pi)=\\frac1T\\int_0^T\\mathrm{FI}(\\mu_t\\|\\pi)dt.",
          "explanation": "A randomized iterate turns the time average into a stationarity guarantee."
        },
        {
          "title": "Add algorithmic error",
          "formula": "\\text{FI bound}=\\text{continuous dissipation}+\\text{score/oracle error}+\\text{discretization error}.",
          "explanation": "Each additional term needs its own moment, regularity, and law-comparison estimate."
        }
      ],
      "rigorous_details": [
        "Relative Fisher information needs an absolutely continuous law and a chosen score representative.",
        "Entropy dissipation must be justified for the actual process and function domain, not only calculated formally.",
        "Randomized-time output requires measurability of the time-indexed law and Fisher-information integrand.",
        "Finite-time discretization and score-error bounds must specify the law under which every squared error is integrated.",
        "Small Fisher information is a stationarity certificate, not automatically small total variation or rapid multimodal mixing."
      ],
      "lean_modules": [
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities",
        "AutoSamplingTheory.TechnicalLemmas.Geometry.StrongConvexity"
      ],
      "blockers": [
        "Relative-score representative and Fisher-information API",
        "Rigorous entropy-dissipation/domain packet",
        "Langevin discretization-to-Fisher-information chain",
        "Book-specific applications and lower bounds"
      ],
      "consumers": [
        "Nonconvex Langevin analyses",
        "Generative-model potentials"
      ],
      "recommended_order": [
        "Define relative Fisher information and its representatives",
        "Prove the continuous-time averaged bound",
        "Add algorithmic approximation terms",
        "Keep stationarity guarantees separate from global mixing claims"
      ],
      "status": "partial"
    },
    {
      "id": "chapter-12",
      "number": 12,
      "title": "Diffusion Generative Models",
      "source_pages": "283–296",
      "source_sections": [
        "12.1 Introduction (p. 283)",
        "12.2 Score Matching and Variants (p. 284)",
        "12.3 Discretization Analysis (p. 288)"
      ],
      "goal": "Connect sampling analysis to score-based reverse diffusions and generative modeling.",
      "prerequisites": [
        "Time-inhomogeneous SDEs",
        "Change of measure",
        "Fisher information and score functions"
      ],
      "concepts": [
        "forward diffusion",
        "score",
        "time reversal",
        "denoising",
        "score error",
        "reverse SDE"
      ],
      "core_definitions": [
        "The forward diffusion progressively smooths the data law into a tractable reference law.",
        "The score is the spatial gradient of a chosen log-density representative.",
        "The reverse-time SDE uses the marginal score to transport noise back toward data.",
        "Score matching rewrites inaccessible score regression as an estimable objective."
      ],
      "major_results": [
        "Time reversal identifies the exact reverse drift under regular marginal densities.",
        "Implicit and denoising score-matching objectives recover the score in population form.",
        "Generation error decomposes into initialization, score approximation, and time-discretization terms.",
        "Discretization analysis converts integrated score error into terminal distribution error under explicit law and regularity assumptions."
      ],
      "calculation_route": [
        {
          "title": "Noise forward, transport backward",
          "formula": "dX_t=b_t(X_t)dt+\\sigma_t dB_t\\quad\\leadsto\\quad d\\bar X_t=\\bar b_t(\\bar X_t)dt+\\sigma_{T-t}d\\bar B_t.",
          "explanation": "The reverse drift contains the score of the time marginal; approximation quality becomes a drift-error problem."
        },
        {
          "title": "Decompose generation error",
          "formula": "\\text{terminal error}\\le\\text{initialization}+\\text{score error}+\\text{discretization}.",
          "explanation": "Each term has different regularity and data requirements."
        }
      ],
      "rigorous_details": [
        "A score is defined only with respect to a chosen density and representative.",
        "Reverse-time formulas require time-marginal regularity and a precise filtration statement.",
        "An L2 score approximation under one law cannot silently be used under another law."
      ],
      "lean_modules": [
        "AutoSamplingTheory.SDE",
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.LogSobolev",
        "AutoSamplingTheory.TechnicalLemmas.InformationTheory.KLDensity"
      ],
      "blockers": [
        "Time-reversal theorem",
        "Score-field representative and integrability",
        "End-to-end reverse-discretization bound"
      ],
      "consumers": [
        "Score-based generative modeling",
        "Future diffusion-model formalizations"
      ],
      "recommended_order": [
        "Fix the forward process and its marginals",
        "Define the score carefully",
        "Then separate reversal, score, and numerical errors"
      ],
      "status": "partial"
    }
  ],
