      },
      {
        "id": "fixed-data",
        "anchor": "S3.Thmtheorem1;A1.SS1.p1.1",
        "disposition": "NODE",
        "statement": "For each fixed y,xref in Rd and each initial phase point (x0,p0), with deterministic initialization."
      },
      {
        "id": "center-residual",
        "anchor": "S3.E4 [3.4]",
        "disposition": "NODE",
        "statement": "c=y-eta grad V(xref), h(x)=grad V(x)-grad V(xref)."
      },
      {
        "id": "harmonic-rate-bounce",
        "anchor": "S3.E8-E9;A1.Ex1-Ex3;A1.SS1.p1.1-p1.3",
        "disposition": "NODE",
        "statement": "Explicit harmonic flow Phi_t, rate sqrt(eta)[p^T h(x)]_+ and bounce S(x,p)=(x,R_h(x)p). h=0 implies rate0, so discontinuity is harmless to event generation."
      },
      {
        "id": "iid-input",
        "anchor": "A1.SS1.p2.1",
        "disposition": "NODE",
        "statement": "Independent Exp(1) E_n for n>=1."
      },
      {
        "id": "initialization",
        "anchor": "A1.SS1.p2.1",
        "disposition": "NODE",
        "statement": "zeta0=(x0,p0), T0=0."
      },
      {
        "id": "actual-hazard-wait",
        "anchor": "A1.E1 [A.1]",
        "disposition": "NODE",
        "statement": "S_(n+1)=inf{u>=0 : integral_0^u lambda(Phi_s(zeta_Tn)) ds >= E_(n+1)}."
      },
      {
        "id": "actual-clock-state-recursion",
        "anchor": "A1.E2 [A.2]",
        "disposition": "NODE",
        "statement": "If S_(n+1)<infinity, T_(n+1)=T_n+S_(n+1), zeta_T(n+1)=S(Phi_S(n+1)(zeta_Tn))."
      },
      {
        "id": "stop-empty",
        "anchor": "A1.SS1.p2.2",
        "disposition": "NODE",
        "statement": "Empty hitting set means S_(n+1)=T_(n+1)=infinity; stop the recursion. Between jumps follow Phi_t for 0<=t<S_(n+1)."
      },
      {
        "id": "energy",
        "anchor": "A1.Ex4;A1.SS1.p3.1",
        "disposition": "NODE",
        "statement": "H(x,p)=1/2{eta^-1 ||x-c||2+||p||2}; Ecal=H(x0,p0)."
      },
      {
        "id": "energy-invariance",
        "anchor": "A1.SS1.p3.2",
        "disposition": "NODE",
        "statement": "Both deterministic flow and bounce preserve H; every generated state has initial energy."
      },
      {
        "id": "energy-norm-bounds",
        "anchor": "A1.Ex5",
        "disposition": "NODE",
        "statement": "||p||<=sqrt(2 Ecal), ||x-c||<=sqrt(2 eta Ecal)."
      },
      {
        "id": "global-rate-cap",
        "anchor": "A1.SS1.p3.3;A1.Ex6",
        "disposition": "NODE",
        "statement": "Throughout every actual segment lambda<=L=sqrt(eta) beta sqrt(2 Ecal){sqrt(2 eta Ecal)+||c-xref||}; L finite and >=0 from source data."
      },
      {
        "id": "integrated-cap",
        "anchor": "A1.SS1.p3.4;A1.Ex7",
        "disposition": "NODE",
        "statement": "Integral_0^u lambda(Phi_s(zeta_Tn)) ds <= L u, for u>=0 along each finite prefix."
      },
      {
        "id": "zero-cap",
        "anchor": "A1.SS1.p3.5",
        "disposition": "NODE",
        "statement": "If L=0, rate vanishes, thresholds are positive AE, all hitting sets empty and no jumps."
      },
      {
        "id": "finite-wait-bound",
        "anchor": "A1.Ex8;A1.SS1.p3.5",
        "disposition": "NODE",
        "statement": "If L>0, every finite actual waiting time S_(n+1)>=E_(n+1)/L."
      },
