  <summary><span class="kind">theorem</span> <code>AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.WeightedC1GradientDomain.actual_cutoff_function_convergence</code> <span class="status status-yellow">Partial</span> <span class="status status-gray">Not mapped</span></summary>
