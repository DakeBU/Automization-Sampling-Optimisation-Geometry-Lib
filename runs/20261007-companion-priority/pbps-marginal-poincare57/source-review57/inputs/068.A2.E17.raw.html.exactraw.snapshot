<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E17.m1" class="ltx_Math" alttext="\bigl\|(I+\mathsf{H}_{\perp\perp})\mathsf{V}_{\perp\mathsf{P}}v\bigr\|^{2}\leq C\log(1/\gamma_{\rm gap})\,\|\mathsf{\Gamma}_{\mathsf{P}}v\|^{2}\,,\hskip 20.00003ptv\in\mathfrak{H}_{\mathsf{P},0}\,." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>I</mi><mo>+</mo><msub><mi>𝖧</mi><mrow><mo>⟂</mo><mo lspace="0em">⁣</mo><mo>⟂</mo></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝖵</mi><mrow><mphantom></mphantom><mo>⟂</mo><mi>𝖯</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mi>C</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>/</mo><msub><mi>γ</mi><mi>gap</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.150em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi class="ltx_mathvariant_sans-serif" mathvariant="sans-serif">Γ</mi><mi>𝖯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>v</mi><mo>∈</mo><msub><mi>ℌ</mi><mrow><mi>𝖯</mi><mo>,</mo><mn>0</mn></mrow></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bigl\|(I+\mathsf{H}_{\perp\perp})\mathsf{V}_{\perp\mathsf{P}}v\bigr\|^{2}\leq C\log(1/\gamma_{\rm gap})\,\|\mathsf{\Gamma}_{\mathsf{P}}v\|^{2}\,,\hskip 20.00003ptv\in\mathfrak{H}_{\mathsf{P},0}\,.</annotation></semantics></math></td>
