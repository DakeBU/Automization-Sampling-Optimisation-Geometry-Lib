        "signatures": [
          {
            "full_declaration": "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.TwoPointEntropy.two_point_squared_entropy_le_half_sq_sub",
            "file": "AutoSamplingTheory/TechnicalLemmas/FunctionalInequalities/TwoPointEntropy.lean",
            "signature_text": "theorem two_point_squared_entropy_le_half_sq_sub (a b : ℝ) :\n    (a ^ 2 * Real.log (a ^ 2) + b ^ 2 * Real.log (b ^ 2)) / 2 -\n      ((a ^ 2 + b ^ 2) / 2) * Real.log ((a ^ 2 + b ^ 2) / 2) ≤\n    (a - b) ^ 2 / 2\n",
            "signature_raw_sha256": "f5aaccdf8098ba9f8036913c5844238a211f9d421606ab1337b3e802d3bb0c34",
            "signature_lf_sha256": "c8c2aed496047dd170f5b06e5d70987acdf8510b8b7a41f1f894c19fecc1d597",
            "statement_version": 1,
            "declaration_level": "canonical-library-node",
            "portable_signature": {
              "path": "runs/20261007-companion-priority/bernoulli-function-lsi/preproof/two-point.signature.txt",
              "raw_sha256": "f5aaccdf8098ba9f8036913c5844238a211f9d421606ab1337b3e802d3bb0c34",
              "lf_sha256": "c8c2aed496047dd170f5b06e5d70987acdf8510b8b7a41f1f894c19fecc1d597"
