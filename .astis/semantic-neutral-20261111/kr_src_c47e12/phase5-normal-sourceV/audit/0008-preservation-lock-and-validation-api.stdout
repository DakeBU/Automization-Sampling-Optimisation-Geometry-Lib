260: @dataclasses.dataclass(frozen=True)
261: class MemoryRecord:
262:     record_id: str
263:     kind: str
264:     task_id: str
265:     target: str
266:     exact_assumptions: tuple[str, ...]
267:     measure: str
268:     codomain: str
269:     declaration_hash: str
270:     source: str
271:     verifier_status: str = "not_reviewed"
272:     local_status: str = "planned"
273:     supersedes: tuple[str, ...] = ()
274:     details: dict[str, Any] = dataclasses.field(default_factory=dict)
275:     created_at: str = dataclasses.field(default_factory=utc_stamp)
276: 
277:     def validate(self) -> None:
278:         if self.kind not in MEMORY_KINDS:
279:             raise ValueError(f"unsupported memory kind: {self.kind}")
280:         if self.verifier_status not in VERIFIER_STATUSES:
281:             raise ValueError(f"unsupported verifier status: {self.verifier_status}")
282:         if self.local_status not in LOCAL_STATUSES:
283:             raise ValueError(f"unsupported local status: {self.local_status}")
284:         required = {
285:             "record_id": self.record_id,
286:             "task_id": self.task_id,
287:             "target": self.target,
288:             "measure": self.measure,
289:             "codomain": self.codomain,
290:             "declaration_hash": self.declaration_hash,
291:             "source": self.source,
292:         }
293:         missing = [name for name, value in required.items() if not value.strip()]
294:         if missing:
295:             raise ValueError("empty required memory fields: " + ", ".join(missing))
296: 
297:     def as_dict(self) -> dict[str, Any]:
298:         self.validate()
299:         value = dataclasses.asdict(self)
300:         value["schema_version"] = HARNESS_SCHEMA_VERSION
301:         return value
