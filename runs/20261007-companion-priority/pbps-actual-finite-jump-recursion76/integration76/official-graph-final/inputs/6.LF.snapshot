        "end_line": 1419,
        "raw_sha256": "015216f896a018db63a000c6a469d7b868e3513412e797bc9f7e9fdde907b9ea",
        "mathtext": "$\\nu_{\\eta,y}(\\mathrm{d}x\\,\\mathrm{d}p)\\coloneqq\\pi_{\\eta}^{X\\mid Y=y}(\\mathrm{d}x)\\,\\mathcal{N}(0,I)(\\mathrm{d}p)\\propto\\exp\\Bigl\\{-V_{y}(x)-\\frac{\\|p\\|^{2}}{2}\\Bigr\\}\\,\\mathrm{d}x\\,\\mathrm{d}p\\,.$\n\n(3.1)\n",
        "disposition": "NODE",
        "classification": "selected-source-node",
        "reason": "Definition of source stationary target only; no stationarity admitted.",
        "overlap_policy": "Nested paragraph/theorem/display records overlap intentionally; coverage is by source region, not a theorem-count metric.",
        "compiled76_projection": {
          "status": "explicit-context-OPEN",
          "current_BODY_or_definition_lines": [],
