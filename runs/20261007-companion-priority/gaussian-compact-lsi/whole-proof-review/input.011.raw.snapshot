          "literal_LF_sha256": "04f08526ff5a4dc715fdb1e2e108df893d4cdc5d7434f99cced79110b75afc26",
          "literal": "  -- Step 2: Establish convergence of the RHS (gradient sum → 4 * ∫ (deriv f)²)\n  have h_sum : Tendsto (fun n => ∑ i : Fin (n + 1), ∫ x,\n      (f (rademacherSumProd (n + 1) x) - f (rademacherSumShifted (n + 1) i x))^2\n        ∂rademacherProductMeasure (n + 1)) atTop\n      (𝓝 (4 * ∫ x, (deriv f x)^2 ∂stdGaussianMeasure)) :=\n    tendsto_sum_sq_shifted_four_deriv_sq hf\n  -- Step 3: The RHS of the discrete inequality converges to (1/2) * 4 * ∫ (deriv f)² = 2 * ∫ (deriv f)²\n"
        }
      ]
    },
    {
      "id": "S-HRHS",
      "kind": "SOURCE_PROOF_NODE",
      "formula": "h_rhs: half-energy limit by h_sum.const_mul(1/2)",
      "classification": "EXTERNAL_SOURCE",
      "anchors": [
