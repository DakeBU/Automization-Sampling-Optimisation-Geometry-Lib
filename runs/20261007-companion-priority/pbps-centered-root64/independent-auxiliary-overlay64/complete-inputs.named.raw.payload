  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.Measure.L2RealSquareOrder.positive_square_order",
      "title": "Positive square order on arbitrary real L²",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06905v1#A2",
          "label": "Appendix D1 positive-square-root monotonicity; ASTIS real-L2 corollary for printed B15",
          "scope": "Reusable real-L2 positive-square-order consequence only; no general Hilbert CFC public premise or independent algorithm result."
        }
      ],
      "tests": [
        "lake build Tests.ProximalBPSCenteredRootOrderInverse"
      ],
      "assumptions": [
        "Arbitrary measurable space and measure; bounded real operators A,B on real L²; A,B and B²−A² positive. No commutation, finiteness, probability, finite-dimensional L² or nontriviality premise."
      ],
      "statement": "For any measurable space Ω and any measure μ, let A and B be bounded real linear operators on real L²(μ). If A and B are positive (selfadjoint with nonnegative quadratic form) and B²−A² is positive, then B−A is positive. No finiteness or probability of μ, nontriviality, finite-dimensional L², commutation, or caller CFC instance is assumed. This is an ASTIS auxiliary consequence of positive square-root monotonicity, realized by the canonical complexification of real L²; it is consumed by the actual centered-root result.",
      "formula": "A\\ge0,\\ B\\ge0,\\ B^2-A^2\\ge0\\Rightarrow B-A\\ge0.",
      "boundary": "Reusable real-L2 positive-square-order consequence only; no general Hilbert CFC public premise or independent algorithm result.",
      "steps": [
        {
          "title": "Complexify the three real positive operators",
          "text": "Use canonical real and imaginary decompositions for A, B and D=B²−A². Positivity is preserved. Applying the decompositions twice identifies the third lift with B_C²−A_C²; the two square lifts therefore inherit the correct order.",
          "formula": "D=B^2-A^2\\ge0,\\quad D_C=B_C^2-A_C^2\\ge0.",
          "lean": "  letI : NormedSpace ℝ (Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) :=\n    NormedSpace.restrictScalars ℝ ℂ (Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ)\n  letI := IsStarNormal.instNonUnitalContinuousFunctionalCalculus\n    (A := Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ)\n  letI : NonUnitalContinuousFunctionalCalculus ℂ\n      (Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) IsStarNormal :=\n    NonUnitalClosedEmbeddingContinuousFunctionalCalculus.toNonUnitalContinuousFunctionalCalculus\n  letI : NonUnitalContinuousFunctionalCalculus ℝ\n      (Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) IsSelfAdjoint :=\n    IsSelfAdjoint.instNonUnitalContinuousFunctionalCalculus\n      (A := Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ)\n  let ι : Lp ℝ 2 μ →L[ℝ] Lp ℂ 2 μ := Complex.ofRealCLM.compLpL 2 μ\n  let R : Lp ℂ 2 μ →L[ℝ] Lp ℝ 2 μ := Complex.reCLM.compLpL 2 μ\n  let Q : Lp ℂ 2 μ →L[ℝ] Lp ℝ 2 μ := Complex.imCLM.compLpL 2 μ\n  obtain ⟨hNorm,_,Ac,hAc,hAf,hAi,_⟩ :=\n    L2RealComplexOperator.exists_positive_complex_lift μ A hA\n  obtain ⟨_,_,Bc,hBc,hBf,hBi,_⟩ :=\n    L2RealComplexOperator.exists_positive_complex_lift μ B hB\n  obtain ⟨_,_,Dc,hDc,hDf,hDi,_⟩ :=\n    L2RealComplexOperator.exists_positive_complex_lift μ (B*B-A*A) hSquareOrder\n  have hAi' (u : Lp ℝ 2 μ) : Ac (ι u)=ι (A u) := hAi u\n  have hBi' (u : Lp ℝ 2 μ) : Bc (ι u)=ι (B u) := hBi u\n  have hComplexDiff : Bc*Bc-Ac*Ac=Dc := by\n    apply ContinuousLinearMap.ext\n    intro g\n    change Bc (Bc g) - Ac (Ac g)=Dc g\n    rw [hBf g,hAf g,map_add,map_smul,map_add,map_smul,hBi,hBi,hAi,hAi,hDf g]\n    simp only [ContinuousLinearMap.sub_apply,ContinuousLinearMap.mul_apply,map_sub,smul_sub]\n    abel\n",
          "detail": "Literal excerpt of the compiled declaration; preceding local definitions and proved facts remain in scope.",
          "lean_source_region": {
            "path": "AutoSamplingTheory/TechnicalLemmas/Measure/L2RealSquareOrder.lean",
            "source_raw_sha256": "1da15dd2c03f047dfde1023ffcc862f53a10f41569aa4892a7f3fa4b0b482649",
            "start_line": 20,
            "end_line": 48,
            "exact_code_raw_sha256": "d3c2117c036b0f714bf6c46287c8d287411842f6779590cf6178535770e36140"
          }
        },
        {
          "title": "Apply monotonicity to positive square roots",
          "text": "The complex operator algebra supplies its internal CFC instances, also in the trivial-space case. Monotonicity gives √(A_C²)≤√(B_C²); uniqueness of the positive roots identifies them with A_C and B_C. No commutation between A and B is used.",
          "formula": "A_C^2\\le B_C^2\\Rightarrow A_C=\\sqrt{A_C^2}\\le\\sqrt{B_C^2}=B_C.",
          "lean": "  have hAcNonneg : 0 ≤ Ac := (ContinuousLinearMap.nonneg_iff_isPositive Ac).mpr hAc\n  have hBcNonneg : 0 ≤ Bc := (ContinuousLinearMap.nonneg_iff_isPositive Bc).mpr hBc\n  have hSqLe : Ac*Ac ≤ Bc*Bc := by\n    apply (ContinuousLinearMap.le_def _ _).mpr\n    rw [hComplexDiff]\n    exact hDc\n  have hLe : Ac ≤ Bc := by\n    have h := CFC.sqrt_le_sqrt (Ac*Ac) (Bc*Bc) hSqLe\n    have ha : CFC.sqrt (Ac*Ac)=Ac := CFC.sqrt_unique rfl hAcNonneg\n    have hb : CFC.sqrt (Bc*Bc)=Bc := CFC.sqrt_unique rfl hBcNonneg\n    exact ha.symm.le.trans (h.trans hb.le)\n  have hDiff : (Bc-Ac).IsPositive := (ContinuousLinearMap.le_def _ _).mp hLe\n",
          "detail": "Literal excerpt of the compiled declaration; preceding local definitions and proved facts remain in scope.",
          "lean_source_region": {
            "path": "AutoSamplingTheory/TechnicalLemmas/Measure/L2RealSquareOrder.lean",
            "source_raw_sha256": "1da15dd2c03f047dfde1023ffcc862f53a10f41569aa4892a7f3fa4b0b482649",
            "start_line": 49,
            "end_line": 60,
            "exact_code_raw_sha256": "c80dca51119ea07bf7f7c4467537ff10cb199c48906cb12965dedec016ba7451"
          }
        },
        {
          "title": "Descend through the canonical real embedding",
          "text": "The real embedding preserves the real part of the complex inner product and intertwines both operators. Positivity of B_C−A_C restricted to embedded real vectors gives the required nonnegative quadratic form; symmetry descends from the original positives.",
          "formula": "\\langle(B-A)u,u\\rangle_{\\mathbb R}=\\Re\\langle(B_C-A_C)\\iota u,\\iota u\\rangle_{\\mathbb C}\\ge0.",
          "lean": "  letI : InnerProductSpace ℝ (Lp ℂ 2 μ) := InnerProductSpace.rclikeToReal ℂ (Lp ℂ 2 μ)\n  let e : Lp ℝ 2 μ →ₗᵢ[ℝ] Lp ℂ 2 μ :=\n    { toLinearMap := ι.toLinearMap, norm_map' := hNorm }\n  have hInner (v w : Lp ℝ 2 μ) : RCLike.re (inner ℂ (ι v) (ι w))=inner ℝ v w := by\n    rw [← real_inner_eq_re_inner]\n    exact e.inner_map_map v w\n  refine ⟨hB.isSymmetric.sub hA.isSymmetric,?_⟩\n  intro u\n  have h := hDiff.re_inner_nonneg_left (ι u)\n  have hAction : (Bc-Ac) (ι u)=ι ((B-A) u) := by\n    simp only [ContinuousLinearMap.sub_apply,hBi',hAi',map_sub]\n  rw [hAction,hInner] at h\n  exact h\n",
          "detail": "Literal excerpt of the compiled declaration; preceding local definitions and proved facts remain in scope.",
          "lean_source_region": {
            "path": "AutoSamplingTheory/TechnicalLemmas/Measure/L2RealSquareOrder.lean",
            "source_raw_sha256": "1da15dd2c03f047dfde1023ffcc862f53a10f41569aa4892a7f3fa4b0b482649",
            "start_line": 61,
            "end_line": 73,
            "exact_code_raw_sha256": "7023fab67dff9cd7b20ae521fb61feee505021d1279d29482f3be770e273d231"
          }
        }
      ],
      "lean_statement": "For any measurable space Ω and any measure μ, let A and B be bounded real linear operators on real L²(μ). If A and B are positive (selfadjoint with nonnegative quadratic form) and B²−A² is positive, then B−A is positive. No finiteness or probability of μ, nontriviality, finite-dimensional L², commutation, or caller CFC instance is assumed. This is an ASTIS auxiliary consequence of positive square-root monotonicity, realized by the canonical complexification of real L²; it is consumed by the actual centered-root result.",
      "lean_proof": "Complexify the three real positive operators; Apply monotonicity to positive square roots; Descend through the canonical real embedding",
      "astis_dependencies": [
        "AutoSamplingTheory.TechnicalLemmas.Measure.L2RealComplexOperator.exists_positive_complex_lift"
      ],
      "mathlib_dependencies": [
