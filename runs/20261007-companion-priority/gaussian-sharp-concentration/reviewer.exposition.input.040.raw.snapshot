  <summary><span class="kind">theorem</span> <code>AutoSamplingTheory.TechnicalLemmas.Probability.GaussianLipschitzExponential.norm_linear_pair_le_two</code> <span class="status status-yellow">Partial</span> <span class="status status-gray">Not mapped</span></summary>
  <div class="declaration-content">
    <p class="muted">No declaration docstring.</p>
    <pre class="code-block"><code class="language-lean">private theorem norm_linear_pair_le_two {c s : ℝ}
    (hc : |c| ≤ 1) (hs : |s| ≤ 1) (p : E × E) :
    ‖c • p.1 + s • p.2‖ ≤ 2 * ‖p‖ := by
  calc
    _ ≤ ‖c • p.1‖ + ‖s • p.2‖ := norm_add_le _ _
    _ = |c| * ‖p.1‖ + |s| * ‖p.2‖ := by simp only [norm_smul, Real.norm_eq_abs]
    _ ≤ ‖p.1‖ + ‖p.2‖ := add_le_add
      (by simpa only [one_mul] using mul_le_mul_of_nonneg_right hc (norm_nonneg p.1))
      (by simpa only [one_mul] using mul_le_mul_of_nonneg_right hs (norm_nonneg p.2))
    _ ≤ 2 * ‖p‖ := by linarith [norm_fst_le p, norm_snd_le p]</code></pre>
    <p class="source-links"><a href="../modules/autosamplingtheory-technicallemmas-probability-gaussianlipschitzexponential.html#complete-module-source">AutoSamplingTheory/TechnicalLemmas/Probability/GaussianLipschitzExponential.lean:307</a><span>local preview source</span></p>
    
  </div>
</details><details class="declaration" id="decl-autosamplingtheory-technicallemmas-probability-gaussianlipschitzexponent-0d155c7e57">
  <summary><span class="kind">theorem</span> <code>AutoSamplingTheory.TechnicalLemmas.Probability.GaussianLipschitzExponential.norm_rotX_le</code> <span class="status status-yellow">Partial</span> <span class="status status-gray">Not mapped</span></summary>
  <div class="declaration-content">
    <p class="muted">No declaration docstring.</p>
    <pre class="code-block"><code class="language-lean">private theorem norm_rotX_le (θ : ℝ) (p : E × E) : ‖rotX θ p‖ ≤ 2 * ‖p‖ :=
  norm_linear_pair_le_two (Real.abs_cos_le_one θ) (Real.abs_sin_le_one θ) p</code></pre>
