      "consumers": [
        "statistical-optimal-transport",
        "log-concave-sampling",
        "discrete-sampling",
        "mcmc"
      ],
      "source_anchors": [
        "OT §§1.1-1.3",
        "Sampling §1.3 and input to §1.4"
      ],
      "target": "Coupling membership, marginal transfer, finite p-moment cost, Wasserstein symmetry/triangle and deterministic pushforward couplings before either textbook builds local copies.",
      "search": [
        "TechnicalLemmas/Measure/ProbabilityCouplingCompactness.lean",
        "TechnicalLemmas/Measure/TransportGluing.lean",
        "TechnicalLemmas/Measure/DisplacementInterpolationCoupling.lean",
