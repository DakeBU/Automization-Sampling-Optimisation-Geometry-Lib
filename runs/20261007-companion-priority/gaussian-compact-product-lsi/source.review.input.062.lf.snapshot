  "seven_slots": {
    "assumptions": "C2 and compact support only; any needed measurability/bounds/sections/support/L1/binaryentropy predicates internal.",
    "conclusion": "Actual homogeneous entropy integral f²logf²−Phi(integral f²)<=2 integral sum Di² together with domain outputs.",
    "constants": "Variance1 and factor2; coordinate sum squares is Euclidean energy, not squared Frechet operator norm under default Pi sup norm. n0 empty sum0 and singleton Dirac homogeneous entropy0; n1 actual scalarLSI.",
    "domains": "Actual finite probability product and real Bochner integrals; C2compact gives finite L1 of square/tlogsquare/each coordinate derivative-square and finite sum, with totalized log0.",
    "objects": "n:Nat, real f on Fin n→Real, actual pi variance1Gaussian; literal coordinate derivative Di=fderiv f x(Pi.single i1).",
    "quantifiers": "All n including0, all signed C2compact f; no npositive or nontrivial carrier condition.",
    "scope": "Authored compact sufficient background within external larger W12 class; finite coordinates only, not Hilbert/noncompact/T2/FIRST printed source completion."
  },
