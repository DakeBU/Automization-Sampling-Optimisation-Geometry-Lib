  "conditions": {
    "Lyapunov": "B19 initially omega>0; B22/B24 require0<omega<=gamma_gap. No rho/small-step floor needed for B23 or B22.",
    "corrector": "B20 applies u=fP and v=fV in the SAME HP0. GammaP^{-1} only on HP0. Definition has no omega or rho parameter.",
    "gap": "B12 rho_mac=(1-alpha eta)/(1+alpha eta),gamma_gap=sqrt(1-rho_mac^2)=2sqrt(alpha eta)/(1+alpha eta). Printed gamma_gap>=1/2 sqrt(alpha eta) is not used by the sharp B23 proof once positive gap and inverse norm are available.",
    "later": "B4 introduces c_hyp,c0,c>0, beta eta<=c0, Lambda_rho=log(1/gamma_gap)+(rho/gamma_gap)^2 and omega=c_hyp rho/Lambda_rho. These belong to later decay, not B23.",
    "original": "V in C2(R^d),0<alpha<=beta,alpha I<=Hessian V(x)<=beta I for every x; eta in(0,1/beta], equivalently eta>0,beta eta<=1.",
    "rho_context": "B3 initially fixes0<rho<=1/2 for one-step contraction context; B21 leading-term illustration uses0<omega<rho. These do not become premises of the energy bound.",
    "sharp_bound": "B23 every globally centered f, with same actual u=fP,v=fV; constant exactly1/(2gamma_gap). General-pair inequality is its printed block proof elaboration, not a separately numbered source theorem.",
    "source_spaces": "Real scalar-valued L2(pi_eta) AE classes; HP=ranP,Hperp=kerP,HP0=HP intersect L2_0."
  },
