{
  "schema_version": 1,
  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.InformationTheory.ProductEntropy.bounded_product_entropy_subadditivity",
      "title": "Bounded binary probability-product entropy, including zero fibers",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06906v1#S4.E6",
          "label": "FIRST S4.E6 omitted GaussianLSI background; pinned SLT GaussianLSI/SubAddEnt entropy decomposition/duality/subadditivity; authored bounded heterogeneous binary regularization OR route",
          "scope": "Genuine bounded nonnegative measurable functions on arbitrary probability product; true joint/all-slice/marginal L1 and marginal entropy inequality including zero fibers/mass. Bounded class sufficient for actual compact C2 squared-function consumer; not an unrestricted unbounded SLT theorem, finite tensorization, Gaussian Hilbert/cutoffLSI, T2/FIRST/main/cost. Actual focused3123PASS; zero density and nonseparable square of signed C2 compact product observer, real sign/zero-fiber witnesses; standard3 only. Independent wholeproof/blind/source/exactcommit and shared publication remain separate."
        },
        {
          "url": "https://github.com/YuanheZ/lean-stat-learning-theory/tree/d0f506f0a695018265dccb33bcb05e2f5ca1c876/SLT/GaussianLSI/SubAddEnt",
          "label": "Pinned external product entropy decomposition and subadditivity background",
          "scope": "External source reference; no upstream compile/evaluation or local Lean dependency. Actual regularization route is explicitly authored."
        }
      ],
      "tests": [
        "lake build Tests.ProductEntropy"
      ],
      "assumptions": [
        "X and Y are arbitrary measurable carriers, with the actual product sigma algebra and real Borel structure; mu and nu are actual probability measures, hence finite and SFinite. No Gaussian or metric assumption is used.",
        "F is jointly measurable, pointwise nonnegative and globally upper bounded by an existential real constant. The pointwise restriction supplies every fixed slice domain; it is stronger than an external AE source class and is disclosed.",
        "Phi is literal real tlogt with totalized Real.log at zero. A,B and m are literal real Bochner slice/product integrals, not invented RN/conditional representatives.",
        "All joint, every-slice and both marginal function/Phi integrability claims are conclusions produced internally. No positivity, normalization, L1, desired-inequality or limit certificate is a public premise.",
        "The coefficient is exactly1 for each entropy term; no additive loss, GaussianLSI constant or transport parameter occurs. Strict lower positivity is used only on internally regularized functions.",
        "This authored bounded heterogeneous binary background is narrower than external unbounded Fin-product entropy. Finite iteration, Gaussian tensorization/Hilbert law/Parseval, noncompact cutoffLSI,T2/FIRST4.6, full papers and expected query-cost composition remain open."
      ],
      "statement": "For arbitrary measurable spaces X,Y and actual probability laws mu,nu, let F be jointly measurable, nonnegative at every point, and bounded above by some real constant. Define Phi(t)=t log t, A(x)=integral F(x,y) dnu, B(y)=integral F(x,y) dmu, and m=integral F d(mu product nu). The actual joint function and its Phi transform are integrable, every fixed-coordinate slice and its Phi transform are integrable, and both actual marginals and their Phi transforms are integrable. The sum of the two marginal Phi integrals is at most the joint Phi integral plus Phi(m). Zero mass and zero fibers are included.",
      "formula": "\\Phi(t)=t\\log t,\\quad \\Phi(0)=0,\\qquad A(x)=\\int F(x,y)\\,d\\nu(y),\\quad B(y)=\\int F(x,y)\\,d\\mu(x),\\quad m=\\int F\\,d(\\mu\\otimes\\nu);\\qquad \\int\\Phi(A)\\,d\\mu+\\int\\Phi(B)\\,d\\nu\\le\\int\\Phi(F)\\,d(\\mu\\otimes\\nu)+\\Phi(m).",
      "boundary": "Genuine bounded nonnegative measurable functions on arbitrary probability product; true joint/all-slice/marginal L1 and marginal entropy inequality including zero fibers/mass. Bounded class sufficient for actual compact C2 squared-function consumer; not an unrestricted unbounded SLT theorem, finite tensorization, Gaussian Hilbert/cutoffLSI, T2/FIRST/main/cost. Actual focused3123PASS; zero density and nonseparable square of signed C2 compact product observer, real sign/zero-fiber witnesses; standard3 only. Independent wholeproof/blind/source/exactcommit and shared publication remain separate.",
      "steps": [
        {
          "title": "Produce the actual integration domains",
          "text": "Bounded nonnegative measurable F is integrable on the finite product law and on each fixed-coordinate probability slice. Continuity of tlogt bounds Phi uniformly on the compact interval [0,C], producing the same domains for Phi(F). Strong measurability of the actual slice integral gives measurable A,B; probability normalization places them and m in [0,C], producing actual marginal Phi domains.",
          "formula": "0\\le F\\le C\\Longrightarrow F,\\Phi(F)\\in L^1(\\mu\\otimes\\nu),\\quad F(x,\\cdot),\\Phi(F(x,\\cdot))\\in L^1(\\nu)\\ (\\forall x),\\quad F(\\cdot,y),\\Phi(F(\\cdot,y))\\in L^1(\\mu)\\ (\\forall y);\\qquad 0\\le A,B,m\\le C.",
          "lean": "bounded_integrable; bounded_phi_domains; integral_bounds; product_domains; HasFiniteIntegral.of_bounded; Real.continuous_mul_log; StronglyMeasurable.integral_prod_right'/left'"
        },
        {
          "title": "Construct a genuine positive comparison function",
          "text": "Temporarily suppose delta<=F<=C with delta>0. Actual probability integrals give delta<=A,B,m. The function R(x,y)=A(x)B(y)/m is strictly positive and genuinely integrable. Fubini gives integral A=integral B=m, and the actual product-multiplication theorem yields integral R=m. No comparison-function mass certificate is supplied.",
          "formula": "R(x,y)=\\frac{A(x)B(y)}m>0,\\qquad \\int R\\,d(\\mu\\otimes\\nu)=\\frac{(\\int A\\,d\\mu)(\\int B\\,d\\nu)}m=m.",
          "lean": "positive_product_entropy; integral_mono; integral_prod; integral_prod_symm; Integrable.mul_prod; integral_prod_mul; integral_div"
        },
        {
          "title": "Use scalar logsum with the actual logarithm domains",
          "text": "For a,b,c,m>0, apply u-1<=u log u to u=a/(bc/m), then multiply by the positive comparison value. Expand log products and division using actual nonzero arguments. This yields the pointwise inequality below. Because A,B lie in [delta,C], their logarithms are uniformly bounded; the F-weighted logs are genuinely integrable.",
          "formula": "a-\\frac{bc}m\\le\\Phi(a)-a\\log b-a\\log c+a\\log m;\\qquad F-R\\le\\Phi(F)-F\\log A-F\\log B+F\\log m.",
          "lean": "scalar_logsum; log_bound; Real.self_sub_one_le_mul_log; Real.log_div; Real.log_mul; IsCompact.exists_bound_of_continuousOn; wA/wB"
        },
        {
          "title": "Integrate and use true weighted-log Fubini",
          "text": "Integrate the pointwise inequality with all domains in hand. Genuine Fubini replaces integral F log A by integral A log A and integral F log B by integral B log B. Integral(F-R)=0 and integral F log m=m log m give the strict-positive product comparison. This is the sum-of-marginals inequality; two separate marginal KL bounds would not supply it.",
          "formula": "\\int F\\log A\\,d(\\mu\\otimes\\nu)=\\int\\Phi(A)\\,d\\mu,\\quad\\int F\\log B\\,d(\\mu\\otimes\\nu)=\\int\\Phi(B)\\,d\\nu;\\qquad 0\\le J_F-J_A-J_B+\\Phi(m).",
          "lean": "positive_product_entropy; integral_mono; integral_prod/integral_prod_symm; integral_mul_const; integral_sub'; integral_add'; aw/bw/ma/mb/mr"
        },
        {
          "title": "Regularize without changing the public assumptions",
          "text": "Set epsilon_n=1/(n+1) and F_n=F+epsilon_n. These are positive, bounded measurable functions. Actual slice and product integrability plus probability normalization give exactly A_n=A+epsilon_n, B_n=B+epsilon_n and m_n=m+epsilon_n. Apply the compiled positive comparison internally to each n.",
          "formula": "\\varepsilon_n=\\frac1{n+1}\\in(0,1],\\quad\\varepsilon_n\\to0,\\quad F_n=F+\\varepsilon_n,\\quad A_n=A+\\varepsilon_n,\\quad B_n=B+\\varepsilon_n,\\quad m_n=m+\\varepsilon_n;\\qquad J_{A_n}+J_{B_n}\\le J_{F_n}+\\Phi(m_n).",
          "lean": "epsilon; epsilon_bounds; epsilon_limit; bounded_product_inequality; positive_product_entropy; integral_add; probReal_univ"
        },
        {
          "title": "Take only continuous entropy terms to the zero limit",
          "text": "On [0,C+1], continuous Phi has a common finite bound. Dominated convergence for the actual finite laws sends the three Phi integrals to J_A,J_B,J_F; scalar continuity sends Phi(m+epsilon_n) to Phi(m), including m=0. Closed real order passes the inequality to the limit. Cross-log terms are never sent through a zero-fiber limit. Return the original actual domains together with this inequality.",
          "formula": "J_{A_n}\\to J_A,\\quad J_{B_n}\\to J_B,\\quad J_{F_n}\\to J_F,\\quad\\Phi(m_n)\\to\\Phi(m);\\qquad J_A+J_B\\le J_F+\\Phi(m).",
          "lean": "phi_regularization_limit; Real.continuous_mul_log; tendsto_integral_of_dominated_convergence; le_of_tendsto_of_tendsto; Filter.Eventually.of_forall; bounded_product_entropy_subadditivity"
        }
      ],
      "lean_statement": "For arbitrary measurable spaces X,Y and actual probability laws mu,nu, let F be jointly measurable, nonnegative at every point, and bounded above by some real constant. Define Phi(t)=t log t, A(x)=integral F(x,y) dnu, B(y)=integral F(x,y) dmu, and m=integral F d(mu product nu). The actual joint function and its Phi transform are integrable, every fixed-coordinate slice and its Phi transform are integrable, and both actual marginals and their Phi transforms are integrable. The sum of the two marginal Phi integrals is at most the joint Phi integral plus Phi(m). Zero mass and zero fibers are included.",
      "lean_proof": "Produce the actual integration domains; Construct a genuine positive comparison function; Use scalar logsum with the actual logarithm domains; Integrate and use true weighted-log Fubini; Regularize without changing the public assumptions; Take only continuous entropy terms to the zero limit",
      "astis_dependencies": [],
      "mathlib_dependencies": [
        "MeasureTheory.HasFiniteIntegral.of_bounded",
        "IsCompact.exists_bound_of_continuousOn",
        "Real.continuous_mul_log",
        "Measurable.prodMk",
        "MeasureTheory.StronglyMeasurable.integral_prod_right'",
        "MeasureTheory.StronglyMeasurable.integral_prod_left'",
        "MeasureTheory.integral_mono",
        "MeasureTheory.integral_prod",
        "MeasureTheory.integral_prod_symm",
        "MeasureTheory.Integrable.mul_prod",
        "MeasureTheory.integral_prod_mul",
        "Real.self_sub_one_le_mul_log",
        "Real.log_mul",
        "Real.log_div",
        "MeasureTheory.integral_add'",
        "MeasureTheory.integral_sub'",
        "MeasureTheory.integral_mul_const",
        "MeasureTheory.integral_div",
        "MeasureTheory.probReal_univ",
        "tendsto_one_div_add_atTop_nhds_zero_nat",
        "MeasureTheory.tendsto_integral_of_dominated_convergence",
        "le_of_tendsto_of_tendsto",
        "Filter.Eventually.of_forall"
      ]
    }
  ]
