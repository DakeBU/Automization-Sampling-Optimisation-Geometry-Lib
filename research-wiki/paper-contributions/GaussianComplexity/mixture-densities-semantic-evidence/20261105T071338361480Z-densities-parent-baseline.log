info: Tests/GaussianComplexityMixtureLaws.lean:48:0: AutoSamplingTheory.ExampleCases.GaussianComplexity.GaussianMixtureLaws.actual_mixture_laws {n : ℕ} (hn : 3 ≤ n) {κ : ℝ}
  (hκ : 4 ≤ κ) :
  have μ := orthogonalHaar n;
  have νpos := 2 • μ.restrict {O | (↑O).det = 1};
  have νneg := 2 • μ.restrict {O | (↑O).det = -1};
  have γ := fun O => multivariateGaussian 0 (singleBlockPrecision κ O)⁻¹;
  Measurable γ ∧
    IsProbabilityMeasure (γ ∘ₘ νpos) ∧
      IsProbabilityMeasure (γ ∘ₘ νneg) ∧
        (∀ (B : Set (EuclideanSpace ℝ (Fin n))),
            MeasurableSet B → (γ ∘ₘ νpos) B = ∫⁻ (O : ↥(orthogonalGroup (Fin n) ℝ)), (γ O) B ∂νpos) ∧
          ∀ (B : Set (EuclideanSpace ℝ (Fin n))),
            MeasurableSet B → (γ ∘ₘ νneg) B = ∫⁻ (O : ↥(orthogonalGroup (Fin n) ℝ)), (γ O) B ∂νneg
