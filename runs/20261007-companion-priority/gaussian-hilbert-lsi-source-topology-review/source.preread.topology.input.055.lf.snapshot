    {
      "id": "P40",
      "kind": "BORROWED_VERIFIED_THEOREM_INTERFACE",
      "statement": "theorem compact_gaussian_pi_logSobolev\n    (n : ℕ) (f : (Fin n → ℝ) → ℝ)\n    (hf : ContDiff ℝ 2 f) (hs : HasCompactSupport f) :\n    let γ : Measure (Fin n → ℝ) := Measure.pi (fun _ : Fin n => gaussianReal 0 1)\n    let D : Fin n → (Fin n → ℝ) → ℝ := fun i x => fderiv ℝ f x (Pi.single i 1)\n    Integrable (fun x => (f x)^2) γ ∧\n    Integrable (fun x => (f x)^2 * Real.log ((f x)^2)) γ ∧\n    (∀ i, Integrable (fun x => (D i x)^2) γ) ∧\n    Integrable (fun x => ∑ i, (D i x)^2) γ ∧\n    (∫ x, (f x)^2 * Real.log ((f x)^2) ∂γ) -\n      (∫ x, (f x)^2 ∂γ) * Real.log (∫ x, (f x)^2 ∂γ) ≤\n    2 * ∫ x, ∑ i, (D i x)^2 ∂γ\n",
      "source_anchors": [
        {
          "pin": "TARGET40-SEALED-INTERFACE",
          "start_line": 1,
          "end_line": 12
        }
      ],
      "declaration": "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.GaussianCompactProductLogSobolev.compact_gaussian_pi_logSobolev",
      "verified_commit": "eaf29841eab8b3d4df5b9419f658fbcc1dda39f3",
      "body_exposed": false
    },
    {
      "id": "R-PI-L1",
