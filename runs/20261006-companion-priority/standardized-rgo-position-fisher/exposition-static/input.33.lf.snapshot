    {
      "id": "transport:proxy-warm-handoff",
      "kind": "concept-bridge",
      "label": "A proxy certificate connects two samplers",
      "status": "proposal",
      "subtitle": "source-backed composition candidate",
      "summary": "Recursive smoothed sampling produces an actual law near a Renyi-warm proxy; the same implemented kernel transports both laws and TV data processing controls their separation.",
      "formula": "\\operatorname{TV}(\\mu K,\\pi)\\le\\operatorname{TV}(\\mu,\\mu^\\dagger)+\\operatorname{TV}(\\mu^\\dagger K,\\pi)",
      "details": [
        {
          "label": "Evidence boundary",
          "value": "Literature/structural correspondence; no Lean-certified functor or theorem transfer."
        },
        {
          "label": "Review status",
          "value": "candidate"
        },
        {
          "label": "Review boundary",
          "value": "A candidate awaits independent source review. Source review does not certify a Lean transport."
        },
        {
          "label": "Conceptual families",
          "value": "family:proxy-warm-composition"
        },
        {
          "label": "Mechanism",
          "value": "Recursive smoothed sampling produces an actual law near a Renyi-warm proxy; the same implemented kernel transports both laws and TV data processing controls their separation."
        },
        {
          "label": "Hypothesis Map",
          "value": "Match target normalization, probability kernels, order-2 divergence, small-gradient reference input, and accuracy budgets; separately bound actual-input expected cost."
        },
        {
          "label": "Conclusion Map",
          "value": "A two-stage cold-to-high-accuracy contract; expected gradient costs add only after the conditional oracle-cost hypotheses match."
        },
        {
          "label": "Failure Boundary",
          "value": "Not a general W2-to-Renyi inequality; no cost bound follows from TV proximity alone; composition order is engine after generator."
        },
        {
          "label": "Category objects",
          "value": "Probability laws with separate transport, proxy-TV and divergence certificates."
        },
        {
          "label": "Category morphisms",
          "value": "Algorithm-specific certificate transformations with explicit access and error budgets."
        },
        {
