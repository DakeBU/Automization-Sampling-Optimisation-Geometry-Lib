    {
      "id": "source-assumptions",
      "source_ids": [
        "S1.E1"
      ],
      "role": "global-source-hypotheses",
      "statement": "V is C2 on R^d, 0<alpha<=beta, alpha I <= Hess V(x) <= beta I for every x; mu is normalized exp(-V) dx.",
      "literal_formula_alttexts": {
        "S1.E1": [
          "\\alpha I\\preceq\\nabla^{2}V(x)\\preceq\\beta I\\,,\\hskip 20.00003ptx\\in\\mathbb{R}^{d}\\,,\\hskip 20.00003pt\\kappa\\coloneqq\\tfrac{\\beta}{\\alpha}\\,."
        ]
      },
      "literal_byte_anchors": {
        "S1.E1": [
          {
            "math_id": "S1.E1.m1",
            "byte_start": 49267,
            "byte_end_exclusive": 50402,
            "raw_sha256": "4a201d14e435f57ab9c9aeb0af9e92471f06a808b87069f37186e98c956c5bae"
          }
        ]
      },
      "eta_condition": "eta in (0,1/beta], equivalently eta>0 and beta eta<=1 for this selected lemma",
      "no_extra_regularities": [
        "no third/higher derivatives",
        "no spectral basis/rank or nonzero-dimensional assumption",
        "no warm-start condition is used by B15/B16"
      ]
    },
    {
      "id": "real-L2-order",
      "source_ids": [
        "A4.E1",
        "A4.E2",
        "A4.E3"
      ],
      "role": "background-definition",
      "statement": "Real scalar-valued L2 of a probability measure consists of measurable functions modulo a.e. equality; bounded operators, adjoints and Loewner order use that Hilbert structure.",
      "literal_formula_alttexts": {
        "A4.E1": [
          "\\langle f,g\\rangle_{L^{2}(\\zeta)}\\coloneqq\\int fg\\,\\mathrm{d}\\zeta\\,,\\hskip 20.00003pt\\|f\\|_{L^{2}(\\zeta)}\\coloneqq\\langle f,f\\rangle_{L^{2}(\\zeta)}^{1/2}\\,."
        ],
        "A4.E2": [
          "L_{0}^{2}(\\zeta)\\coloneqq\\Bigl\\{f\\in L^{2}(\\zeta):\\int f\\,\\mathrm{d}\\zeta=0\\Bigr\\}\\,."
        ],
        "A4.E3": [
          "\\mathsf{L}_{1}\\preceq\\mathsf{L}_{2}\\hskip 10.00002pt\\Longleftrightarrow\\hskip 10.00002pt\\langle f,(\\mathsf{L}_{2}-\\mathsf{L}_{1})f\\rangle\\geq 0\\hskip 10.00002pt\\text{for every }f"
        ]
      },
      "literal_byte_anchors": {
        "A4.E1": [
          {
            "math_id": "A4.E1.m1",
            "byte_start": 1351181,
            "byte_end_exclusive": 1353032,
            "raw_sha256": "1472c1ee79b9bf25b4846f802b32bbad223176f7b8ec43733d736b4956806b8a"
          }
        ],
        "A4.E2": [
          {
            "math_id": "A4.E2.m1",
            "byte_start": 1353541,
            "byte_end_exclusive": 1354639,
            "raw_sha256": "647637bc0a6aba857f3cbba1cad56b1ae4f26a972af29e9d0039a62d3228e6da"
          }
        ],
        "A4.E3": [
          {
            "math_id": "A4.E3.m1",
            "byte_start": 1362225,
            "byte_end_exclusive": 1363262,
            "raw_sha256": "fef1fa5ae4a398dcad8c1397d59eb4ba62f35c47ca1376861a75019ef2f7faa6"
          }
        ]
      },
      "spectral_background": "D.1 states bounded Borel functional calculus for self-adjoint operators and existence/uniqueness of the non-negative square root of a non-negative operator. The scalar lower bound on the root is a spectral consequence; D.1 does not separately state arbitrary-pair operator monotonicity."
    },
    {
      "id": "joint-law",
      "source_ids": [
        "S2.E6",
        "S2.E7",
        "S2.E8",
        "S2.E13"
      ],
      "role": "source-definition-and-geometry",
      "statement": "X~mu and independent Z~N(0,I), Y+=X+sqrt(eta) Z. pi_eta^Y has curvature at least alpha/(1+alpha eta); conditional laws have the stated potentials.",
      "literal_formula_alttexts": {
        "S2.E6": [
          "\\pi_{\\eta}(\\mathrm{d}x\\,\\mathrm{d}y)\\propto\\exp\\Bigl\\{-V(x)-\\frac{\\|x-y\\|^{2}}{2\\eta}\\Bigr\\}\\,\\mathrm{d}x\\,\\mathrm{d}y\\,."
        ],
        "S2.E7": [
          "X\\sim\\mu\\,,\\hskip 20.00003ptZ\\sim\\mathcal{N}(0,I)\\ \\text{independently}\\,,\\hskip 20.00003ptY=X+\\sqrt{\\eta}\\,Z\\,."
        ],
        "S2.E8": [
          "\\pi_{\\eta}^{Y\\mid X=x}=\\mathcal{N}(x,\\eta I)\\,,\\hskip 20.00003pt\\pi_{\\eta}^{X\\mid Y=y}(\\mathrm{d}x)\\propto\\exp\\Bigl\\{-V(x)-\\frac{\\|x-y\\|^{2}}{2\\eta}\\Bigr\\}\\,\\mathrm{d}x\\,."
        ],
        "S2.E13": [
          "\\frac{\\alpha}{1+\\alpha\\eta}I\\preceq\\nabla^{2}U_{\\eta}(y)\\preceq\\frac{\\beta}{1+\\beta\\eta}I\\,."
        ]
      },
      "literal_byte_anchors": {
        "S2.E6": [
          {
