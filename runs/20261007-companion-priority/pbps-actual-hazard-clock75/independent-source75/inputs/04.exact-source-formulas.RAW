      "credit": "Exact source formula only; not a proved Lean clause",
      "id": "S2.SS2.p1.m1",
      "literal_source_alttext": "\\eta\\in(0,1/\\beta]",
      "source_URL": "https://arxiv.org/html/2609.06905v1#S2.SS2.p1.m1"
    },
    {
      "LF_sha256": "30ac2694e6c8c1fe66ffc0cf7f4fc6c4458503b0f75c5a821fb82fd4c023f91a",
