<math id="S3.SS1.p3.m2" class="ltx_math_unparsed" alttext="\nabla V_{\eta}(y)=\int\nabla V\,\mathrm{d}R_{\eta,y}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><msub><mi>V</mi><mi>η</mi></msub><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo rspace="0.111em">=</mo><mo>∫</mo><mo rspace="0.167em">∇</mo><mi>V</mi><mi>d</mi><msub><mi>R</mi><mrow><mi>η</mi><mo>,</mo><mi>y</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\nabla V_{\eta}(y)=\int\nabla V\,\mathrm{d}R_{\eta,y}</annotation></semantics></math>