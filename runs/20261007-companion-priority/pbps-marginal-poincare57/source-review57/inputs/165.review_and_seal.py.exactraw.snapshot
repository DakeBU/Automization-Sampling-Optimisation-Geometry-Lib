 b=p.read_bytes();a=S/f'{i:02}.exactraw.snapshot';l=S/f'{i:02}.crlf-to-lf.snapshot';a.write_bytes(b);l.write_bytes(b.replace(b'\r\n',b'\n'));assert a.read_bytes()==b and l.read_bytes()==b.replace(b'\r\n',b'\n');inputs.append({'input':pin(p),'exactraw':pin(a),'lf':pin(l)})
