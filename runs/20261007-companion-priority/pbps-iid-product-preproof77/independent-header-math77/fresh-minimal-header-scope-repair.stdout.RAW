AutoSamplingTheory.TechnicalLemmas.Probability.UnitExponentialProduct.unit_exponential_product_statement : Prop
MeasureTheory.Measure.infinitePi.{u_1, u_2} {ι : Type u_1} {X : ι → Type u_2} {mX : (i : ι) → MeasurableSpace (X i)}
  (μ : (i : ι) → Measure (X i)) : Measure ((i : ι) → X i)
MeasureTheory.Measure.infinitePi_map_eval.{u_1, u_2} {ι : Type u_1} {X : ι → Type u_2}
  {mX : (i : ι) → MeasurableSpace (X i)} (μ : (i : ι) → Measure (X i)) [hμ : ∀ (i : ι), IsProbabilityMeasure (μ i)]
  (i : ι) : Measure.map (fun x => x i) (Measure.infinitePi μ) = μ i
ProbabilityTheory.iIndepFun_infinitePi.{u_1, u_3, u_4} {ι : Type u_1} {𝓧 : ι → Type u_3}
  {m𝓧 : (i : ι) → MeasurableSpace (𝓧 i)} {Ω : ι → Type u_4} {mΩ : (i : ι) → MeasurableSpace (Ω i)}
  {P : (i : ι) → Measure (Ω i)} [∀ (i : ι), IsProbabilityMeasure (P i)] {X : (i : ι) → Ω i → 𝓧 i}
  (mX : ∀ (i : ι), Measurable (X i)) : iIndepFun (fun i ω => X i (ω i)) (Measure.infinitePi P)
ProbabilityTheory.iIndepFun.indepFun.{u_1, u_2, u_6} {Ω : Type u_1} {ι : Type u_2} {_mΩ : MeasurableSpace Ω}
  {μ : Measure Ω} {β : ι → Type u_6} {m : (x : ι) → MeasurableSpace (β x)} {f : (i : ι) → Ω → β i}
  (hf_Indep : iIndepFun f μ) {i j : ι} (hij : i ≠ j) : f i ⟂ᵢ[μ] f j
ProbabilityTheory.iIndepFun.comp.{u_1, u_2, u_10, u_11} {Ω : Type u_1} {ι : Type u_2} {_mΩ : MeasurableSpace Ω}
  {μ : Measure Ω} {β : ι → Type u_10} {γ : ι → Type u_11} {mβ : (i : ι) → MeasurableSpace (β i)}
  {mγ : (i : ι) → MeasurableSpace (γ i)} {f : (i : ι) → Ω → β i} (h : iIndepFun f μ) (g : (i : ι) → β i → γ i)
  (hg : ∀ (i : ι), Measurable (g i)) : iIndepFun (fun i => g i ∘ f i) μ
ProbabilityTheory.isProbabilityMeasure_expMeasure {r : ℝ} (hr : 0 < r) : IsProbabilityMeasure (expMeasure r)
ProbabilityTheory.cdf_expMeasure_eq {r : ℝ} (hr : 0 < r) (x : ℝ) :
  ↑(cdf (expMeasure r)) x = if 0 ≤ x then 1 - Real.exp (-(r * x)) else 0
ProbabilityTheory.cdf_eq_real (μ : Measure ℝ) [IsProbabilityMeasure μ] (x : ℝ) : ↑(cdf μ) x = μ.real (Set.Iic x)
ProbabilityTheory.HasLaw.identDistrib.{u_1, u_2, u_3} {α : Type u_1} {β : Type u_2} {γ : Type u_3} [MeasurableSpace α]
  [MeasurableSpace β] [MeasurableSpace γ] {μ : Measure α} {ν : Measure β} {f : α → γ} {g : β → γ} {κ : Measure γ}
  (h₀ : HasLaw f κ μ) (h₁ : HasLaw g κ ν) : IdentDistrib f g μ ν
ProbabilityTheory.IdentDistrib.comp.{u_1, u_2, u_3, u_4} {α : Type u_1} {β : Type u_2} {γ : Type u_3} {δ : Type u_4}
  [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace γ] [MeasurableSpace δ] {μ : Measure α} {ν : Measure β}
  {f : α → γ} {g : β → γ} {u : γ → δ} (h : IdentDistrib f g μ ν) (hu : Measurable u) : IdentDistrib (u ∘ f) (u ∘ g) μ ν
ProbabilityTheory.IdentDistrib.integrable_iff.{u_1, u_2, u_3} {α : Type u_1} {β : Type u_2} {γ : Type u_3}
  [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace γ] {μ : Measure α} {ν : Measure β} {f : α → γ} {g : β → γ}
  [NormedAddCommGroup γ] [BorelSpace γ] (h : IdentDistrib f g μ ν) : Integrable f μ ↔ Integrable g ν
ProbabilityTheory.strong_law_ae_real.{u_2} {Ω : Type u_2} {m : MeasurableSpace Ω} {μ : Measure Ω} (X : ℕ → Ω → ℝ)
  (hint : Integrable (X 0) μ) (hindep : Pairwise (Function.onFun (fun x1 x2 => x1 ⟂ᵢ[μ] x2) X))
  (hident : ∀ (i : ℕ), IdentDistrib (X i) (X 0) μ μ) :
  ∀ᵐ (ω : Ω) ∂μ, Tendsto (fun n => (∑ i ∈ Finset.range n, X i ω) / ↑n) atTop (𝓝 (∫ (x : Ω), X 0 x ∂μ))
MeasureTheory.ae_all_iff.{u_1, u_3, u_4} {α : Type u_1} {F : Type u_3} [FunLike F (Set α) ENNReal]
  [OuterMeasureClass F α] {μ : F} {ι : Sort u_4} [Countable ι] {p : α → ι → Prop} :
  (∀ᵐ (a : α) ∂μ, ∀ (i : ι), p a i) ↔ ∀ (i : ι), ∀ᵐ (a : α) ∂μ, p a i
MeasureTheory.integrable_const.{u_1, u_2} {α : Type u_1} {β : Type u_2} {m : MeasurableSpace α} {μ : Measure α}
  [NormedAddCommGroup β] [IsFiniteMeasure μ] (c : β) : Integrable (fun x => c) μ
MeasureTheory.Integrable.indicator.{u_1, u_4} {α : Type u_1} {ε' : Type u_4} {mα : MeasurableSpace α} {s : Set α}
  {μ : Measure α} [TopologicalSpace ε'] [ESeminormedAddMonoid ε'] {f : α → ε'} (h : Integrable f μ)
  (hs : MeasurableSet s) : Integrable (s.indicator f) μ
MeasureTheory.integral_indicator_one.{u_1} {X : Type u_1} {mX : MeasurableSpace X} {μ : Measure X} ⦃s : Set X⦄
  (hs : MeasurableSet s) : ∫ (x : X), s.indicator 1 x ∂μ = μ.real s
measurable_real_toNNReal : Measurable Real.toNNReal
Real.coe_toNNReal (r : ℝ) (hr : 0 ≤ r) : ↑r.toNNReal = r
Real.GammaIntegral_convergent {s : ℝ} (h : 0 < s) : IntegrableOn (fun x => Real.exp (-x) * x ^ (s - 1)) (Set.Ioi 0) ℙ
Real.integral_rpow_mul_exp_neg_mul_Ioi {a r : ℝ} (ha : 0 < a) (hr : 0 < r) :
  ∫ (t : ℝ) in Set.Ioi 0, t ^ (a - 1) * Real.exp (-(r * t)) = (1 / r) ^ a * Real.Gamma a
MeasureTheory.integrable_withDensity_iff_integrable_smul'.{u_1, u_8} {α : Type u_1} {m : MeasurableSpace α}
  {μ : Measure α} {E : Type u_8} [NormedAddCommGroup E] [NormedSpace ℝ E] {f : α → ENNReal} (hf : Measurable f)
  (hflt : ∀ᵐ (x : α) ∂μ, f x < ⊤) {g : α → E} :
  Integrable g (μ.withDensity f) ↔ Integrable (fun x => (f x).toReal • g x) μ
Filter.tendsto_atTop_mono.{u_3, u_4} {α : Type u_3} {β : Type u_4} [Preorder β] {l : Filter α} {f g : α → β}
  (h : ∀ (n : α), f n ≤ g n) : Tendsto f l atTop → Tendsto g l atTop
