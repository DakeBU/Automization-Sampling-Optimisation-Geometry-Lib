run['run_sha256']=sha(canon(run)); write('run.json',run); runpin=pin(OUT/'run.json')
test=json.loads((OUT/'run.json').read_bytes()); expected=test.pop('run_sha256'); assert sha(canon(test))==expected
print(json.dumps(dict(actual_foreground_pid=os.getpid(),readback_pid=rpid,readback_exit_code=0,run_sha256=run['run_sha256'],named_source_payload_sha256=run['named_source_payload_sha256']),ensure_ascii=True),flush=True)
# CLOSED-LAST, after actual foreground reader EXIT0. No subsequent filesystem operation.
write('lease.json',dict(status='CLOSED',closed_last=True,owner='/root/next_primary59',closed_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),run=runpin,native_run_sha256=run['run_sha256'],named_source_payload_sha256=run['named_source_payload_sha256'],readback=pin(OUT/'readback.receipt.json'),actual_foreground_readback_pid=rpid,actual_foreground_readback_exit_code=0,scope='Exact source-only next real-root proposal; root must separately seal/implement/compile/review/adopt. No math completion.'))
