          (Pairwise fun i j => Disjoint (Set.Ioc (s i) (t i)) (Set.Ioc (s j) (t j))) →
            ProbabilityTheory.iIndepFun (fun i omega => B (t i) omega - B (s i) omega) mu) ∧
      (∀ (s t : NNReal),
          s < t →
            ∀ (ell : StrongDual ℝ E),
              ProbabilityTheory.HasLaw (fun omega => ell (B t omega - B s omega))
                (ProbabilityTheory.gaussianReal 0
                  (AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.BrownianMotion.projectedIncrementVariance s t
                    ell))
                mu) ∧
        ∀ᵐ (omega : Omega) ∂mu, Continuous fun t => B t omega
