theorem twoPointEnt_comm (a b : ℝ) : twoPointEnt a b = twoPointEnt b a := by
  unfold twoPointEnt
  have h1 : a + b = b + a := by ring
  have h2 : a * log a + b * log b = b * log b + a * log a := by ring
  simp only [h1, h2]

/-- The Jensen gap δ_φ(x,y) = (φ(x)+φ(y))/2 - φ((x+y)/2) for φ(x) = x log x -/
