      "title": "Produce genuine compact Gaussian domains",
      "formula": "f^2,\\ \\Phi(f^2),\\ (D_i f)^2,\\ \\sum_i(D_i f)^2\\in L^1(\\gamma_n),\\qquad\\Phi(t)=t\\log t.",
      "actual_HTML_present": true
    },
    {
      "step": 2,
      "title": "Handle the actual empty-coordinate probability law",
      "formula": "n=0:\\quad\\operatorname{Ent}_{\\gamma_0}(f^2)=0,\\qquad\\int\\sum_{i\\in\\mathrm{Fin}(0)}(D_i f)^2\\,d\\gamma_0=0.",
      "actual_HTML_present": true
    },
    {
      "step": 3,
      "title": "Split the true law and preserve original slice regularity",
      "formula": "(a,y)\\mapsto\\mathrm{Fin.cons}(a,y),\\qquad(\\mathrm{Fin.cons})_\\#(\\gamma_1\\otimes\\gamma_n)=\\gamma_{n+1};\\qquad f(\\cdot,y),\\ f(a,\\cdot)\\in C_c^2.",
      "actual_HTML_present": true
    },
    {
      "step": 4,
      "title": "Identify the actual coordinate derivatives",
      "formula": "\\frac{d}{da}f(a,y)=D_0f(a,y),\\qquad D_i[f(a,\\cdot)](y)=D_{i+1}f(a,y).",
      "actual_HTML_present": true
    },
    {
      "step": 5,
      "title": "Apply actual binary entropy to original conditional entropies",
      "formula": "\\operatorname{Ent}_{\\gamma_{n+1}}(f^2)\\le\\int\\operatorname{Ent}_{\\gamma_n}(f(a,\\cdot)^2)\\,d\\gamma_1(a)+\\int\\operatorname{Ent}_{\\gamma_1}(f(\\cdot,y)^2)\\,d\\gamma_n(y).",
      "actual_HTML_present": true
    },
    {
      "step": 6,
      "title": "Use the scalar theorem and strict dimension induction",
      "formula": "\\operatorname{Ent}_{\\gamma_n}(f(a,\\cdot)^2)\\le2\\int\\sum_{i=1}^{n}(D_if(a,y))^2\\,d\\gamma_n(y),\\qquad\\operatorname{Ent}_{\\gamma_1}(f(\\cdot,y)^2)\\le2\\int(D_0f(a,y))^2\\,d\\gamma_1(a).",
      "actual_HTML_present": true
    },
    {
      "step": 7,
      "title": "Integrate and assemble the full finite energy",
      "formula": "2\\iint\\sum_{i=1}^{n}(D_if)^2\\,d\\gamma_n\\,d\\gamma_1+2\\iint(D_0f)^2\\,d\\gamma_1\\,d\\gamma_n=2\\int\\sum_{i=0}^{n}(D_if)^2\\,d\\gamma_{n+1}.",
