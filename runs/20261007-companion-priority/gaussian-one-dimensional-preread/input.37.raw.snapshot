    {
      "class": "EXTERNAL_CITED_RESULT / SLT_PORT_CANDIDATE",
      "id": "GAUSSIAN-LSI-PRODUCER-ABSENT",
      "residual": "No unconditional Gaussian function-LSI producer was found in targeted pinned Mathlib/ASTIS retrieval. Registry lsi.product-gaussian localDecl empty,status portCandidate. Compiled bookkeeping and conditional hLSI consumer do not shrink this analytic obligation."
    },
    {
      "class": "UNPORTED_ANALYTIC_PARENT",
      "id": "COMPACT1D-FIRST-UNMET",
      "residual": "Minimal pinned compact1D leaf GaussianLSI.gaussian_logSobolev_CompSmo directly needs BernoulliLSI.bernoulli_logSobolev_app, GaussianPoincare.tendsto_entropy_f_sq and GaussianPoincare.tendsto_sum_sq_shifted_four_deriv_sq. All three are external-only, not local ASTIS endpoints. Its non-Mathlib import closure has10 modules; no whole project import allowed.",
      "first_required_unmet_dependency": "BernoulliLSI.bernoulli_logSobolev_app (and its genuine Bernoulli/Han/two-point parents), alongside the two actual Gaussian CLT limit parents; never replace them by supplied inequality/limit binders."
    },
    {
      "class": "NONCOMPACT_DOMAIN_EXTENSION",
      "id": "LITERAL32-F-NOT-COMPACT",
      "residual": "For nonzero-dimensional E, literal f=exp(-rho/2)/sqrtZ is positive everywhere and not compactly supported. C2 compact-only LSI cannot be applied to it. Genuine C1/W12 Gaussian approximation plus entropy/energy limit is needed (18-module realW12 closure), and product tensorization adds actual entropy subadditivity/slice adapters (24-module closure)."
    },
    {
      "class": "PINNED_EXTERNAL_API_TOOLCHAIN",
      "id": "SLT-NOT-CALLABLE",
      "residual": "SLT Lean4.32.0/Mathlib81a5d257c8e410db227a6665ed08f64fea08e997 differs from ASTIS4.33.0/db584cd6d46c92f209a44c0f1c829460d327499d. Apache2, exact headers and fresh static placeholder hits0 do not certify compilation, reachable axioms or upstream evaluation. Port minimal actual needed parents and compile locally later."
    },
    {
      "class": "CLASSICAL_COORDINATE_DOMAIN_ADAPTER",
      "id": "EUCLIDEAN-W12-TRANSPORT",
      "residual": "Product raw Pi carries its default norm, not the Euclidean norm. Prove actual orthonormal-basis Gaussian pushforward, pullback C1 and L2 partials, and exact sum partial^2=norm grad f^2 by Parseval. Dimension0 handled internally. This is classical actual derivative-domain transport; do not silently add a dimension factor."
    },
    {
      "class": "AE_REPRESENTATIVE_CALCULUS_GAP",
      "id": "CANONICAL-GENERATOR-ALTERNATIVE",
      "residual": "AE canonical llr=logq does not imply differentiability of the selected RN representative, canonical smooth Fisher, or generator IBP/Gamma domain. Keep this alternative separate; preferred function-LSI route uses actual C2 sqrtq and does not require this gap."
    },
    {
      "class": "EXTERNAL_CITED_RESULT / SOURCE_CONTRACT_GAP",
      "id": "GAUSSIAN-T2-PRODUCER-ABSENT",
      "residual": "No targeted local unconditional Gaussian T2 producer found. Genuine T2 inequality cost(r,gamma)<=2 KL still needed. Optimal coupling/gradient pushforward or dual value alone does not yield entropy coercivity. Brenier route needs honest Jacobian/change-of-variables/entropy regularity; LSI-to-T2 route needs actual Hamilton-Jacobi/infimum convolution and Kantorovich strong duality or another independently justified transport construction."
    },
    {
      "class": "EXTENDED_REAL_METRIC_ADAPTER",
      "id": "FINITE-COST-AND-NORMALIZATION",
      "residual": "Actual canonical KL!=top and actual W2/cost finiteness must precede toReal/sqrt arithmetic. Generic P2 source domains can be produced internally; no public moment/T2 certificate added. Canonical cost norm^2 has no 1/2, hence T2 constant2 and LSI Fisher half give exact coefficient1."
    },
    {
      "class": "PENDING_PARENT_PROOF_ADMISSION",
      "id": "FINITEKL33-NOT-PROVED-BY-SEAL",
      "residual": "At this audit pinned33 evidence is exact StatementSeal/type-only PASS, not a mathematical proof. Do not schedule a theorem as consuming callable finiteKL33 until its genuine proof/independent admission exists, although existing TiltedKL is already a real local backend."
    }
  ],
