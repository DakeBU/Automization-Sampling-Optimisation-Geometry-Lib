stdout=(O/'focused.stdout.log').read_text(encoding='utf-8');axioms={}
names=['AutoSamplingTheory.ExampleCases.ProximalBPS.MacroscopicDefectRoot.actual_unique_positive_macroscopic_defect_root','Tests.ProximalBPSMacroscopicDefectRoot.genuine_actual_macroscopic_root_consumer']
for name in names:
 match=re.search(re.escape("'"+name+"'")+r' depends on axioms:\s*\[([^\]]*)\]',stdout,re.S)
 assert match,name
 ax=[x.strip() for x in match.group(1).split(',')];assert set(ax)=={'propext','Classical.choice','Quot.sound'}
 axioms[name]=ax
assert 'Build completed successfully (3920 jobs).' in stdout and 'sorryAx' not in stdout
scan=[]
for i in [0,1,2,3,4,5,6,31]:
 s=text(i);code=re.sub(r'/\-.*?\-/','',s,flags=re.S);code=re.sub(r'--[^\n]*','',code)
 bad=re.findall(r'\b(?:axiom|sorry|admit)\b|Prop\s*:=\s*True|:=\s*trivial\b',code)
 assert not bad,(i,bad)
 if i==0:assert not re.search(r'^import\s+Tests\.',s,re.M)
