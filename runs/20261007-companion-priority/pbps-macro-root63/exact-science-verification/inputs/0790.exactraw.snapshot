    (hfirstGreenZeroBoundary :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        firstGreenBoundaryFlux φ = 0)
    (hsecondGreenResidual :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        negativeGradientPairAction φ - testLaplacianAction φ =
          secondGreenTotal φ)
    (hsecondGreenDivergence :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        secondGreenTotal φ = secondGreenBoundaryFlux φ)
    (hle : a ≤ b)
    (hsecondGreenWeightedFieldContinuous :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
