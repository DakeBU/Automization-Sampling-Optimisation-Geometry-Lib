          "relation": "same",
          "evidence": "The lesson and binding explicitly leave those source obligations red."
        },
        {
          "slot": "constant dependencies",
          "original": "The paper's M_kappa has position coefficient 1/(2*kappa)+1/2; for kappa at least one this is at most one under zero momentum displacement.",
          "reconstructed": "The exact cost is bounded with coefficient one; kappa only enters through its lower bound and metric.",
          "relation": "equivalent",
          "evidence": "The official arXiv v1 matrix is [[1/(2*kappa)+1/2,1/2],[1/2,1]] tensor I_d; the coefficient inequality is exact."
        }
