    {
      "atom_id": "A2.SS3.p1.1",
      "section": "A2.SS3",
      "kind": "paragraph",
      "raw_locator": "#A2.SS3.p1.1",
      "source_text": "In this section, we verify that the precision matrices in our construction belong to $\\mathcal{A}_{d,\\kappa}$ . The spectral bounds follow from orthogonality within each block and are preserved by the block-diagonal construction.",
      "raw_span": {
        "byte_start_inclusive": 595518,
