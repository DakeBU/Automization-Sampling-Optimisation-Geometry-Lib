  <summary><span class="kind">theorem</span> <code>AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.GaussianFlipEnergy.squared_increment_error</code> <span class="status status-yellow">Partial</span> <span class="status status-gray">Not mapped</span></summary>
  <div class="declaration-content">
    <p class="muted">No declaration docstring.</p>
    <pre class="code-block"><code class="language-lean">private theorem squared_increment_error (f : ℝ → ℝ) (hf : Differentiable ℝ f)
    (B K : ℝ) (_hB0 : 0 ≤ B) (hK0 : 0 ≤ K)
    (hB : ∀ x, |deriv f x| ≤ B)
    (hK : ∀ x y, |deriv f y - deriv f x| ≤ K * |y-x|) (x y : ℝ) :
    |(f y - f x)^2 - (deriv f x)^2 * (y-x)^2| ≤
      2 * B * K * |y-x|^3 := by
  obtain ⟨a, ha, hab, had⟩ := bounded_secant f hf B K hB hK hK0 x y
  have hs : |a + deriv f x| ≤ 2 * B :=
    (abs_add_le _ _).trans (by linarith [hB x])
  calc
    |(f y - f x)^2 - (deriv f x)^2 * (y-x)^2| =
        |a - deriv f x| * |a + deriv f x| * |y-x|^2 := by
      rw [ha, ← abs_mul, ← abs_pow, ← abs_mul]
      congr 1
      ring
    _ ≤ (K * |y-x|) * (2 * B) * |y-x|^2 := by
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul had hs (abs_nonneg _) (mul_nonneg hK0 (abs_nonneg _))) (sq_nonneg _)
    _ = 2 * B * K * |y-x|^3 := by ring</code></pre>
