        ],
        "raw_source_snapshot": {
          "path": "E:/Samplinglib/runs/20261007-companion-priority/pbps-real-root-unique62/next-macro-source63/primary-15-S2-E6.exactraw.snapshot.html",
          "raw_bytes": 1993,
          "lf_bytes": 1993,
          "raw_sha256": "1f01e27c8eb38fd05a57d820c65ee6b36832171cce845e8cd1b52f4588526375",
          "lf_sha256": "1f01e27c8eb38fd05a57d820c65ee6b36832171cce845e8cd1b52f4588526375"
        },
        "literal_text": "\\pi_{\\eta}(\\mathrm{d}x\\,\\mathrm{d}y)\\propto\\exp\\Bigl\\{-V(x)-\\frac{\\|x-y\\|^{2}}{2\\eta}\\Bigr\\}\\,\\mathrm{d}x\\,\\mathrm{d}y\\,. (2.6)",
        "coverage": "NODE_OR_CONTEXT",
        "boundary": "Bounded source prerequisite or B10/B11 statement; no wholepaper claim"
      },
      {
        "id": "S2.E7",
        "primary": {
          "path": "E:/Samplinglib/runs/20261007-companion-priority/phase-pbps-gamma-preread57/primary-pbps.exactraw.snapshot.html",
          "raw_bytes": 1482128,
          "lf_bytes": 1482128,
          "raw_sha256": "d81e929496ff33f8895ebdb45b5b7f3eba89a069806d97d5bbbd7a6c0c032760",
          "lf_sha256": "d81e929496ff33f8895ebdb45b5b7f3eba89a069806d97d5bbbd7a6c0c032760"
        },
        "byte_range": [
          98826,
          100299
        ],
        "raw_source_snapshot": {
          "path": "E:/Samplinglib/runs/20261007-companion-priority/pbps-real-root-unique62/next-macro-source63/primary-16-S2-E7.exactraw.snapshot.html",
          "raw_bytes": 1473,
          "lf_bytes": 1473,
          "raw_sha256": "2be554d84baf1f2b796ade05fba49271b5d05e4e8d2d46427d47a6756f85c8f9",
          "lf_sha256": "2be554d84baf1f2b796ade05fba49271b5d05e4e8d2d46427d47a6756f85c8f9"
        },
        "literal_text": "X\\sim\\mu\\,,\\hskip 20.00003ptZ\\sim\\mathcal{N}(0,I)\\ \\text{independently}\\,,\\hskip 20.00003ptY=X+\\sqrt{\\eta}\\,Z\\,. (2.7)",
        "coverage": "NODE_OR_CONTEXT",
