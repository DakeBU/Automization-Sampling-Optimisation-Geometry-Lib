            "end_line": 196,
            "exact_code_raw_sha256": "bd69529c8a254c9c3ce99826b814a4bc60b257f06ea73dda517902f6e3873f31"
          }
        },
        {
          "title": "Use the same polar map for the first corrector",
          "text": "Taking adjoints of B_0=V_0Γ_0 and positivity of Γ_0 give B_0*=Γ_0V_0*. Isometry gives operator norm at most one, hence the adjoint contraction, including the zero-dimensional case.",
          "formula": "B_0^*=\\Gamma_0V_0^*,\\quad\\|V_0^*g\\|\\le\\|g\\|.",
          "lean": "  have hPosLocal : ΓP0.IsPositive := hPos0\n  have hBAdj : B0.adjoint=ΓP0 ∘L V0.adjoint := by\n    calc\n      B0.adjoint = (V0 ∘L ΓP0).adjoint :=\n        congrArg (fun D : HP0 →L[ℝ] Hperp => D.adjoint) hFactor\n      _ = ΓP0.adjoint ∘L V0.adjoint := ContinuousLinearMap.adjoint_comp V0 ΓP0\n      _ = ΓP0 ∘L V0.adjoint :=\n        congrArg (fun D : HP0 →L[ℝ] HP0 => D ∘L V0.adjoint)\n          hPosLocal.isSelfAdjoint.adjoint_eq\n  have hNormV : ‖V0‖ ≤ (1 : ℝ) :=\n    ContinuousLinearMap.opNorm_le_bound _ zero_le_one (by intro u; rw [hVnorm u,one_mul])\n  have hNormAdj : ‖V0.adjoint‖ ≤ (1 : ℝ) :=\n    (ContinuousLinearMap.adjoint.norm_map V0).trans_le hNormV\n  have hVcontract (g : Hperp) : ‖V0.adjoint g‖≤‖g‖ := by\n    calc\n      ‖V0.adjoint g‖ ≤ ‖V0.adjoint‖*‖g‖ := V0.adjoint.le_opNorm g\n      _ ≤ 1*‖g‖ := mul_le_mul_of_nonneg_right hNormAdj (norm_nonneg _)\n      _ = ‖g‖ := one_mul _\n",
          "detail": "Literal compiled BODY excerpt; exact preceding local definitions/derived facts remain in scope. Private statement definition is fully included in reviewed module text and source download.",
          "lean_source_region": {
            "path": "AutoSamplingTheory/ExampleCases/ProximalBPS/AmbientAdjointCorrector.lean",
            "source_raw_sha256": "377663f86e8e139907b6ffeda890d6933efd101a6f43f79064a264f9e0f384d4",
