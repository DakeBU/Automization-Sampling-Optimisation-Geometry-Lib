{
  "schema_version": 1,
  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.CompactPoissonSmoothGraph.compact_weak_poisson_smooth_graph_approximation",
      "title": "Actual compact weak Poisson: one smooth function/gradient/Laplacian sequence",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06905v1#A3.SS1",
          "label": "PBPS AppendixC.1 authored analytic prerequisite",
          "scope": "Derive one real smooth sequence with common outer compact support and simultaneous actual ordinary-volume L2 function/gradient/Laplacian limits for v=chi*u, g=chi*G+u*gradientchi, F=chi*r+2inner(gradientchi,G)+u*laplacianchi. Same original D before epsilon/f, same u before ALL cutoffs. No supplied graph-density/approximation/mixedHessian/core certificate, no classical rough derivatives, no weighted-domain/operator-core/globalcutoff/Bochner/BL/Poincare/jointmeasurablechoice/main/composition claim. Reflected/RGO quarter Hessian and fourfold energy kept distinct; TV never transfers unbounded cost."
        }
      ],
      "tests": [
        "lake build Tests.CompactPoissonSmoothGraph"
      ],
      "assumptions": [
        "Finite-dimensional real Hilbert/Borel space E with canonical ordinary full-space volume, including dimension zero. Real pointwise v,F and vector G are genuinely global volumeL2; their topological supports lie in the same compact K.",
        "Every real C1 compact test psi and every a satisfies both L1 products and integral psi*inner(G,a)=-integral v*D_a psi. Every real C2 compact psi has both L1 products and integral v*Delta psi=integral F*psi. These actual weak equations, measurability/L2 and supports are inputs; graph density, Sobolev membership, smooth sequence, real mixed Hessian and weighted core are not supplied.",
        "The rough v/G/F representatives are differentiated only in the actual weak/distributional sense. Classical gradients and Laplacians in the conclusion belong to actual smooth approximants. SchwartzMap E real is genuinely C-infinity/rapidly decaying; common compact support is additionally derived. No positive dimension, jointly measurable selector, source C-infinity potential or normalized plateau is assumed."
      ],
      "statement": "From the exact compact-supported volumeL2 and original weak-gradient/PDE inputs, Derive one real Schwartz sequence phi_n with one common outer compact Kprime containing every tsupport(phi_n), chosen before all n and all three limits. Actual volumeL2 classes of phi_n converge to v; actual classical gradient(phi_n) is MemLp2 and its class converges to the original G; actual Laplacian(phi_n) classes converge to F. Every phi_n is C-infinity and compactly supported. The same sequence realizes all limits. Kprime need not equal K. No classical derivatives of rough v, real Hessian family, quantitative source complexity constant or weighted operator core is claimed.",
      "formula": "\\int\\psi\\langle G,a\\rangle=-\\int vD_a\\psi,\\quad\\int v\\Delta\\psi=\\int F\\psi\\ \\Longrightarrow\\ \\exists K\\prime,\\varphi_n\\in C_c^\\infty(K\\prime):\\quad\\varphi_n\\to v,\\ \\nabla\\varphi_n\\to G,\\ \\Delta\\varphi_n\\to F\\ \\text{in }L^2(dx).",
      "boundary": "Derive one real smooth sequence with common outer compact support and simultaneous actual ordinary-volume L2 function/gradient/Laplacian limits for v=chi*u, g=chi*G+u*gradientchi, F=chi*r+2inner(gradientchi,G)+u*laplacianchi. Same original D before epsilon/f, same u before ALL cutoffs. No supplied graph-density/approximation/mixedHessian/core certificate, no classical rough derivatives, no weighted-domain/operator-core/globalcutoff/Bochner/BL/Poincare/jointmeasurablechoice/main/composition claim. Reflected/RGO quarter Hessian and fourfold energy kept distinct; TV never transfers unbounded cost.",
      "steps": [
        {
          "title": "Derive the actual Bessel-L2 witness from the original compact PDE",
          "text": "Call the accepted real compact-test producer with actual supports and L2 data. It constructs AE-linked complex classes vc/Fc, the true TD Laplacian and Sobolev2. Choose the genuine order2 L2 witness w and invert Bessel; plain L2 approximation of v would not control derivatives.",
          "formula": "B_2T_v=T_w,\\quad B_2=I-(2\\pi)^{-2}\\Delta,\\quad B_{-2}T_w=T_v.",
          "lean": "CompactWeakPoissonSobolev.compact_weak_poisson_sobolev; spectral_graph"
        },
        {
          "title": "Construct chosen norm-controlled continuous L2 spectral maps",
          "text": "For each actual bounded temperate complex symbol g, use its genuine Linfinity class, Holder infinity/2/2 bilinear CLM and forward/inverse L2 Fourier isometries to construct A_g. Prove norm(A_g f)<=C norm(f), true Lp/TD compatibility and equality with Schwartz multipliers by LpTD injectivity. The symbols m0, inner(x,a)*m0 and norm(x)^2*m0 have bounds1,norm(a),1; attach exact2pi i and -(2pi)^2 scalars to derivatives.",
          "formula": "A_g=\\mathcal F^{-1}(g\\,\\mathcal F\\cdot),\\quad\\|A_gf\\|_2\\le C\\|f\\|_2;\\quad m_0=(1+\\|\\xi\\|^2)^{-1}.",
          "lean": "actualMul; actual_bounded_multiplier_norm; mzero_bound; mdir_bound; mlap_bound; inverse_dir; inverse_lap"
        },
        {
          "title": "Use one Schwartz approximation of w for every graph component",
          "text": "Actual L2 density and sequential closure choose q_n.toLp -> w. Define s_n=FM(m0)q_n. Continuity of the chosen fixed maps gives same-sequence function, Laplacian and every direction derivative limits. Identify function with vc through true Bessel inversion, and Laplacian with Fc through the actual TD PDE/injectivity. Preserve exact complex casts/Fourier normalization.",
          "formula": "s_n=A_{m_0}q_n,\\quad s_n\\to v_C,\\quad\\Delta s_n\\to F_C,\\quad D_as_n\\to g_a.",
          "lean": "schwartz_approx; spectral_graph; besselPotential_neg_apply_eq_iff; lp_td_injective"
        },
        {
          "title": "Identify the original real gradient, not a newly chosen derivative",
          "text": "The actual spectral limit satisfies T_ga=D_a T_vc. Test it with ofReal of each genuine real compact smooth test, use actual HolderL1 before integral_re, and compare with the original all-C1 weak gradient. Locally integrable compact-test uniqueness identifies Re ga=inner(G,a) AE. Continuous real projection and finite orthonormal-basis reconstruction give the actual full vector-gradient limit; dimension0 has an empty basis.",
          "formula": "\\operatorname{Re}g_a=_{dx\\text{-ae}}\\langle G,a\\rangle,\\quad\\operatorname{Re}s_n\\to v,\\quad\\nabla\\operatorname{Re}s_n\\to G,\\quad\\Delta\\operatorname{Re}s_n\\to F.",
          "lean": "identify_real_gradient; real_projection_class; finite_gradient_reconstruction; real_schwartz_graph"
        },
        {
          "title": "Construct one fixed outer plateau and all bounded coefficient maps",
          "text": "Choose an actual unnormalized smooth compact theta equal1 near K. Its genuine Schwartz function, gradient and Laplacian supply actual Linfinity coefficients; Holder gives continuous maps on real/vectorL2. Neighborhood locality makes gradtheta/Deltatheta zero on K, while actual v/G/F vanish outsideK. Derive exact limiting identities and zero cross terms without weighted tails or extra position moments.",
          "formula": "\\theta=1\\text{ near }K,\\quad\\nabla\\theta=\\Delta\\theta=0\\text{ on }K,\\quad K\\prime=\\operatorname{tsupp}\\theta.",
          "lean": "outer_plateau; coeff_holder_ae; coeff_holder_class; plateau_point_identities"
        },
        {
          "title": "Apply actual product rules to the same sequence",
          "text": "Set phi_n=theta*Re s_n, a genuine smooth compact function with common supportKprime. Reuse the existing ASTIS public gradient product rule; the existing localization Laplacian product API is private, so repeat only its bounded private C2 trace proof, with no new public background node. Actual quotient/AE products and continuous bounded coefficient maps pass all three product identities to the limit.",
          "formula": "\\nabla(\\theta r_n)=\\theta\\nabla r_n+r_n\\nabla\\theta;\\quad\\Delta(\\theta r_n)=\\theta\\Delta r_n+2\\langle\\nabla\\theta,\\nabla r_n\\rangle+r_n\\Delta\\theta.",
          "lean": "GradientAlgebra.gradient_mul_eq_of_differentiableAt; laplacian_product; cutoff_schwartz_graph"
        },
        {
          "title": "Return actual compact graph convergence and stop before weighted core",
          "text": "Expose real Schwartz approximants/common compact support, actual gradient MemLp witnesses and true function/gradient/Laplacian quotient convergence from input L2 proofs. Weighted transfer, original localized D-domain membership, adjoint/generator identification, global cutoff removal/Bochner/Poincare/BL and source main guarantees remain distinct producers.",
          "formula": "\\varphi_n\\to v,\\quad\\nabla\\varphi_n\\to G,\\quad\\Delta\\varphi_n\\to F\\text{ in }L^2(dx);\\quad\\text{weighted core remains open}.",
          "lean": "compact_weak_poisson_smooth_graph_approximation"
        }
      ],
      "lean_statement": "From the exact compact-supported volumeL2 and original weak-gradient/PDE inputs, Derive one real Schwartz sequence phi_n with one common outer compact Kprime containing every tsupport(phi_n), chosen before all n and all three limits. Actual volumeL2 classes of phi_n converge to v; actual classical gradient(phi_n) is MemLp2 and its class converges to the original G; actual Laplacian(phi_n) classes converge to F. Every phi_n is C-infinity and compactly supported. The same sequence realizes all limits. Kprime need not equal K. No classical derivatives of rough v, real Hessian family, quantitative source complexity constant or weighted operator core is claimed.",
      "lean_proof": "Derive the actual Bessel-L2 witness from the original compact PDE; Construct chosen norm-controlled continuous L2 spectral maps; Use one Schwartz approximation of w for every graph component; Identify the original real gradient, not a newly chosen derivative; Construct one fixed outer plateau and all bounded coefficient maps; Apply actual product rules to the same sequence; Return actual compact graph convergence and stop before weighted core",
      "astis_dependencies": [
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.CompactWeakPoissonSobolev.compact_weak_poisson_sobolev",
        "AutoSamplingTheory.TechnicalLemmas.Analysis.Calculus.GradientAlgebra.gradient_mul_eq_of_differentiableAt"
      ],
      "mathlib_dependencies": [
        "SchwartzMap.denseRange_toLpCLM",
        "Lp.fourierTransformₗᵢ",
        "Lp.toTemperedDistribution_smul_eq",
        "Lp.ker_toTemperedDistributionCLM_eq_bot",
        "ContinuousLinearMap.holderL",
        "SchwartzMap.fourierMultiplierCLM",
        "besselPotential_neg_apply_eq_iff",
        "ae_eq_of_integral_contDiff_smul_eq",
        "ContinuousLinearMap.compLpL",
        "ContDiffBump.eventuallyEq_one_of_mem_ball"
      ]
    }
  ]
}
