        (2 ^ level);
    ∑ i,
      weight level i omega *
        (((B (times i.succ) omega).ofLp j - (B (times i.castSucc) omega).ofLp j) *
          ((B (times i.succ) omega).ofLp k - (B (times i.castSucc) omega).ofLp k));
