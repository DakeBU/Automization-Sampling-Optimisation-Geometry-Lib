      "source": "Boumal Chapters 1-3",
      "requires": [
        "sf-euclidean-linear-algebra",
        "sf-calculus-gradient",
        "sf-manifold-first-order"
      ],
      "rule": "Examples reuse Euclidean/matrix foundations; Chapter 3 exports the minimal manifold adapter used by Sampling §2.5."
    },
    {
