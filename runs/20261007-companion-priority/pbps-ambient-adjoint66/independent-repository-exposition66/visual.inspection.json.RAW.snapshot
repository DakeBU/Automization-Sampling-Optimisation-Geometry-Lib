        "targetText": "2. Eliminate the constant direction and recover the ambient adjointThe SAME Gram/root identities and Γ_Pq_P=0 imply Bq_P=0. Adjoint pairing therefore puts B* g in H_P^0. Pair against each centered vector, use PB=0 and selfadjointness of P to remove Pg, and obtain the canonical extension of the intrinsic block adjoint.‖BqP‖2=⟨qP,ΓP2qP⟩=0,B∗g=i0B0∗Rg.Corresponding Lean step  have hGramLocal : B.adjoint ∘L B=ΓP*ΓP := hGram\n  have hRootq : ΓP qP=0 := hΓPq\n  have hBq : B qP=0 := by\n    have hn := B.apply_norm_sq_eq_inner_adjoint_right qP\n    rw [hGramLocal] at hn\n    have hz : (ΓP*ΓP) qP=0 := by\n      change ΓP (ΓP qP)=0\n      rw [hRootq,map_zero]\n    rw [hz,inner_zero_right] at hn\n    exact norm_eq_zero.mp (sq_eq_zero_iff.mp hn)\n  have hBCenter (g : Lp ℝ 2 J) : B.adjoint g ∈ HP0 := by\n    chan",
