      "title": "Actual finite-count Rademacher sums converge weakly to the unit Gaussian",
      "source": {
        "url": "https://github.com/leanprover-community/mathlib4/blob/db584cd6d46c92f209a44c0f1c829460d327499d/Mathlib/Probability/CentralLimitTheorem.lean#L59",
        "edition": "Pinned Mathlib db584cd6; Lean4.33.0. SPHMC arXiv2609.06906v1 background, not its printed theorem.",
        "anchor": "tendsto_charFun_inv_sqrt_mul_pow L59-L76; LevyConvergence L215; authored actual Bool-count specialization; SPHMC FIRST S4.E6 GaussianLSI omitted background",
        "wording_status": "faithful paraphrase",
        "attribution": "Mathlib Thomas Zhu and Etienne Marion scalar CLT; ASTIS-authored actual count-law/zero-index adapter. Independent source-first exact StatementSeal; Gaussian function entropy and full flip-energy limits remain separate."
      },
      "statement": "There exists a family of real probability laws lambda_N, for every natural N, equal to the actual pushforward of normalized counting measure on all Fin N -> Bool configurations by the signed sum divided by sqrt(N). The true sign is +1 and the false sign is -1. Its zero law is dirac0, and the successor sequence lambda_(N+1) converges weakly to gaussianReal0,1 (mean0, variance1). No law, normalization, moment, independence or CLT certificate is supplied.",
      "assumptions": [
        "Closed authored background specialization; no caller mathematical premises.",
        "Actual finite carrier and normalized count law, literal sign true1/false-1, totalized inverse square root and empty zero sum. All probability, measurability and finite moment domains are produced internally.",
        "ProbabilityMeasure Real has the canonical weak law topology. gaussianReal0,1 uses varianceNNReal1. No entropy, energy, W2, LSI, T2 or cost upgrade is implied."
      ],
      "formulae": [
        {
          "label": "Actual finite-count Rademacher sums converge weakly to the unit Gaussian",
          "tex": "\\mu_N=2^{-N}\\sum_{\\varepsilon\\in\\{0,1\\}^N}\\delta_\\varepsilon,\\quad S_N(\\varepsilon)=N^{-1/2}\\sum_{j=1}^N\\sigma(\\varepsilon_j),\\quad\\lambda_N=(S_N)_\\#\\mu_N,\\quad\\lambda_0=\\delta_0,\\quad\\lambda_{N+1}\\Rightarrow\\mathcal N(0,1)."
        }
      ],
      "obligations": [
        {
          "id": "actual-law-limit",
          "label": "Actual finite count normalized-sum law and Gaussian weak limit"
        },
        {
          "id": "remaining-paper",
