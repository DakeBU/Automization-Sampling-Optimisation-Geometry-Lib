    {
      "complete_source_signature": "theorem quadratic_feature_potential_tangent_gradient\n    {E H : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]\n    [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]\n    (F : E → H) (D : E → E →L[ℝ] H)\n    (hF : ∀ w, HasFDerivAt F (D w) w)\n    (M₁ M₂ : ℝ) (hM₁ : 0 ≤ M₁) (hM₂ : 0 ≤ M₂)\n    (hBound : ∀ w : E, ‖w‖ ≤ 1 → ‖D w‖ ≤ M₁)\n    (hLip : ∀ w u : E, ‖w‖ ≤ 1 → ‖u‖ ≤ 1 → ‖D w-D u‖ ≤ M₂*‖w-u‖) :\n    let V : H → E → ℝ := fun r w => 2 * ⟪r,F w⟫_ℝ\n    let G : H → E → E := fun r w =>\n      (2 : ℝ) • ((D w).adjoint r - ⟪(D w).adjoint r,w⟫_ℝ • w)\n    (∀ r w, HasFDerivAt (V r) ((2 : ℝ) • innerSL ℝ ((D w).adjoint r)) w) ∧\n    (∀ r w, ‖w‖ = 1 →\n      ⟪w,G r w⟫_ℝ = 0 ∧\n      (∀ v, ⟪w,v⟫_ℝ = 0 → ⟪G r w,v⟫_ℝ = 2 * ⟪r,D w v⟫_ℝ) ∧\n      ‖G r w‖ ≤ 2 * M₁ * ‖r‖) ∧\n    ∀ r q w u, ‖w‖ = 1 → ‖u‖ = 1 →\n      ‖G r w-G q u‖ ≤ 2 * M₁ * ‖r-q‖ +\n        2 * (M₂+2*M₁) * ‖q‖ * ‖w-u‖",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.Geometry.QuadraticFeatureTangentGradient.quadratic_feature_potential_tangent_gradient",
      "file": "AutoSamplingTheory/TechnicalLemmas/Geometry/QuadraticFeatureTangentGradient.lean",
