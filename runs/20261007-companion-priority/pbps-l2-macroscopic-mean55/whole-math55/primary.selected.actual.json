      "source_raw_fragment": "<table id=\"A2.E8\" class=\"ltx_equation ltx_eqn_table\">\n\n<tbody><tr class=\"ltx_equation ltx_eqn_row ltx_align_baseline\">\n<td class=\"ltx_eqn_cell ltx_eqn_center_padleft\"></td>\n<td class=\"ltx_eqn_cell ltx_align_center\"><math id=\"A2.E8.m1\" class=\"ltx_Math\" alttext=\"Y_{+}\\coloneqq X+\\sqrt{\\eta}\\,Z\\,,\\hskip 20.00003ptY_{-}\\coloneqq X-\\sqrt{\\eta}\\,Z\\,,\\hskip 20.00003ptZ\\sim\\mathcal{N}(0,I)\\,,\\hskip 20.00003ptX\\sim\\mu\\,.\" display=\"block\" intent=\":literal\"><semantics><mrow><mrow><mrow><msub><mi>Y</mi><mo>+</mo></msub><mo>≔</mo><mrow><mi>X</mi><mo>+</mo><mrow><msqrt><mi>η</mi></msqrt><mo lspace=\"0.150em\" rspace=\"0em\">​</mo><mi>Z</mi></mrow></mrow></mrow><mo lspace=\"0.150em\" rspace=\"2.167em\">,</mo><mrow><msub><mi>Y</mi><mo>−</mo></msub><mo>≔</mo><mrow><mi>X</mi><mo>−</mo><mrow><msqrt><mi>η</mi></msqrt><mo lspace=\"0.150em\" rspace=\"0em\">​</mo><mi>Z</mi></mrow></mrow></mrow><mo lspace=\"0.150em\" rspace=\"2.167em\">,</mo><mrow><mi>Z</mi><mo>∼</mo><mrow><mi class=\"ltx_font_mathcaligraphic\">𝒩</mi><mo>⁡</mo><mrow><mo stretchy=\"false\">(</mo><mn>0</mn><mo>,</mo><mi>I</mi><mo rspace=\"0.150em\" stretchy=\"false\">)</mo></mrow></mrow></mrow><mo rspace=\"2.167em\">,</mo><mrow><mi>X</mi><mo>∼</mo><mi>μ</mi></mrow></mrow><mo lspace=\"0.150em\">.</mo></mrow><annotation encoding=\"application/x-tex\">Y_{+}\\coloneqq X+\\sqrt{\\eta}\\,Z\\,,\\hskip 20.00003ptY_{-}\\coloneqq X-\\sqrt{\\eta}\\,Z\\,,\\hskip 20.00003ptZ\\sim\\mathcal{N}(0,I)\\,,\\hskip 20.00003ptX\\sim\\mu\\,.</annotation></semantics></math></td>\n<td class=\"ltx_eqn_cell ltx_eqn_center_padright\"></td>\n<td rowspan=\"1\" class=\"ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right\"><span class=\"ltx_tag ltx_tag_equation ltx_align_right\">(B.8)</span></td></tr></tbody>\n</table>"
