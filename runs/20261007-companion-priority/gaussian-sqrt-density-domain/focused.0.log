                                        u) ∂stdGaussian E)
                              s))
                      s) ∧
                  MemLp
                      ((fun s u =>
                          Real.exp
                              (-(fun s u => V (p s + √(eta s) • u) - V (p s) - √(eta s) * ⟪gradient V (p s), u⟫) s u /
                                2) /
                            √((fun s =>
                                  ∫ (u : E),
                                    Real.exp
