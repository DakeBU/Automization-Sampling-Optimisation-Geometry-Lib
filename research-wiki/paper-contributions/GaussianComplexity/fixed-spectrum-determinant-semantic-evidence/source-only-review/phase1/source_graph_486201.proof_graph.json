  "nodes": [
    {
      "id": "src:arxiv:2610.20492v1:S2:euclidean",
      "kind": "standing-definition",
      "source_anchors": [
        "S2.p1"
      ],
      "statement": "The ambient space is real Euclidean space; ||·|| is its Euclidean norm, I_d the identity, and A≼B means B−A is positive semidefinite for symmetric matrices.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:S2:orthogonal",
      "kind": "standing-definition",
      "source_anchors": [
        "S2.p2"
      ],
      "statement": "O(d)={O∈R^{d×d}:OᵀO=I_d} is the full real orthogonal group. It has determinant +1 and −1 components; neither is excluded.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:S2:haar",
      "kind": "standing-definition",
      "source_anchors": [
        "S2.p2"
      ],
      "statement": "Haar probability measure is on the full O(d); the two determinant components each have Haar probability 1/2.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:S2:precision-class",
      "kind": "standing-definition",
      "source_anchors": [
        "S2.Ex1"
      ],
      "statement": "𝒜_{d,κ} consists of real symmetric d×d A with I_d≼A≼κI_d.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:S4:domain",
      "kind": "source-standing-assumption",
      "source_anchors": [
        "S4.SS1.p1.1"
      ],
      "statement": "In the hard-family construction d is an integer with d≥2 and κ is a real parameter with κ≥2. Grid indices are i=1,…,d, as in diag(λ₁,…,λ_d).",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:S4.E11:theta",
      "kind": "literal-definition",
      "source_anchors": [
        "S4.E11"
      ],
      "statement": "θ_i=((i−1/2)π)/d for i=1,…,d.",
      "source_status": "SOURCE_EXPLICIT",
      "latex": "\\theta_i=\\frac{(i-\\tfrac12)\\pi}{d}"
    },
    {
      "id": "src:arxiv:2610.20492v1:S4.E11:lambda",
      "kind": "literal-definition",
      "source_anchors": [
        "S4.E11"
      ],
      "statement": "λ_i=(κ+1)/2+((κ−1)/2)cos θ_i.",
      "source_status": "SOURCE_EXPLICIT",
      "latex": "\\lambda_i=\\frac{\\kappa+1}{2}+\\frac{\\kappa-1}{2}\\cos\\theta_i"
    },
    {
      "id": "src:arxiv:2610.20492v1:S4.E11:diagonal",
      "kind": "literal-definition",
      "source_anchors": [
        "S4.E11"
      ],
      "statement": "Λ=diag(λ₁,…,λ_d). This is the particular deterministic cosine grid in the paper.",
      "source_status": "SOURCE_EXPLICIT",
      "latex": "\\Lambda=\\operatorname{diag}(\\lambda_1,\\ldots,\\lambda_d)"
    },
    {
      "id": "src:arxiv:2610.20492v1:S4:draw",
      "kind": "source-experiment-definition",
      "source_anchors": [
        "S4.SS1.p1.2"
      ],
      "statement": "Draw O∼Haar(O(d)), independently of the algorithm’s private randomness.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:S4:rotation",
      "kind": "literal-definition",
      "source_anchors": [
        "S4.SS1.p1.2"
      ],
      "statement": "A=OΛOᵀ.",
      "source_status": "SOURCE_EXPLICIT",
      "latex": "A=O\\Lambda O^{\\top}"
    },
    {
      "id": "src:arxiv:2610.20492v1:S4:potential",
      "kind": "literal-definition",
      "source_anchors": [
        "S4.SS1.p1.2",
        "A3.SS4.p2.1"
      ],
      "statement": "f_A(x)=xᵀAx/2; C.4 writes the same literal quadratic formula as V_A(x)=½xᵀAx on all x∈R^d.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:S4:target",
      "kind": "source-definition",
      "source_anchors": [
        "S4.SS1.p1.2",
        "A3.SS4.p3.1"
      ],
      "statement": "The associated target is π_A=N(0,A^{-1}), with precision A and covariance A^{-1}.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:S4:fixed-spectrum",
      "kind": "substantive-unnumbered-statement",
      "source_anchors": [
        "S4.SS1.p2.1",
        "A3.SS4.p3.2"
      ],
      "statement": "For fixed d,κ, Λ and the spectrum are deterministic and do not vary with O.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:S4:public-spectrum",
      "kind": "conditional-informational-premise",
      "source_anchors": [
        "S4.SS1.p2.1",
        "A3.SS4.p3.2"
      ],
      "statement": "The spectrum may be supplied to the algorithm; the final known-Z claim is conditional on the spectrum being public. No public eigenbasis is assumed.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:S4:hidden-eigenbasis",
      "kind": "substantive-context-statement",
      "source_anchors": [
        "S4.SS1.p2.1"
      ],
      "statement": "The unknown component is the random eigenbasis represented by O.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:S4:known-Z-assertion",
      "kind": "substantive-unnumbered-claim",
      "source_anchors": [
        "S4.SS1.p2.1"
      ],
      "statement": "In the public-spectrum experiment the Gaussian normalizing constant is known. C.4 supplies the displayed reason.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:S4.Thmtheorem6:admissibility",
      "kind": "numbered-source-lemma",
      "source_anchors": [
        "S4.Thmtheorem6"
      ],
      "statement": "For every O∈O(d), A=OΛOᵀ satisfies I_d≼A≼κI_d, under the hard-family setup d≥2, κ≥2.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.SS4:angle",
      "kind": "substantive-unnamed-estimate",
      "source_anchors": [
        "A3.SS4.p1.1"
      ],
      "statement": "For every grid index i, 0<θ_i<π.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.SS4:cosine",
      "kind": "substantive-unnamed-estimate",
      "source_anchors": [
        "A3.SS4.p1.1"
      ],
      "statement": "For every grid index i, −1<cos θ_i<1.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.SS4:eigenvalue",
      "kind": "substantive-unnamed-estimate",
      "source_anchors": [
        "A3.SS4.p1.1"
      ],
      "statement": "For every grid index i, 1<λ_i<κ.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.SS4:spectral-order",
      "kind": "substantive-proof-step",
      "source_anchors": [
        "A3.SS4.p1.1"
      ],
      "statement": "Orthogonal conjugation of the diagonal grid gives I_d≼A≼κI_d.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.SS4:symmetry",
      "kind": "omitted-bridge",
      "source_anchors": [
        "S4.E11",
        "S4.SS1.p1.2",
        "A3.SS4.p2.1"
      ],
      "statement": "Λ is real diagonal and A=OΛOᵀ is symmetric. This supplies the symmetry used by the Hessian identity without importing positivity into that derivative step.",
      "source_status": "SOURCE_GAP",
      "classification": "internal-paper-step",
      "gap": "The source leaves the elementary transpose calculation implicit. It follows from the literal matrix definitions, not an additional source hypothesis."
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.SS4:symmetric-positive",
      "kind": "omitted-bridge",
      "source_anchors": [
        "S4.SS1.p1.2",
        "A3.SS4.p1.1",
        "A3.Ex160"
      ],
      "statement": "A and Λ are real symmetric positive definite; their determinants are positive. This is a prerequisite of the Gaussian integral and inverse/real-power meanings.",
      "source_status": "SOURCE_GAP",
      "classification": "internal-paper-step",
      "gap": "The source supplies the diagonal eigenvalue bounds and spectral order, but does not separately spell out symmetry, positive definiteness, determinant positivity, or inverse existence. These are standard finite-dimensional consequences, not new source binders."
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.SS4:smooth",
      "kind": "substantive-unnamed-statement",
      "source_anchors": [
        "A3.SS4.p2.1"
      ],
      "statement": "V_A is C∞ on R^d.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.SS4:hessian",
      "kind": "substantive-unnamed-identity",
      "source_anchors": [
        "A3.SS4.p2.1"
      ],
      "statement": "For all x∈R^d, ∇²V_A(x)=A.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.SS4:strong-convexity",
      "kind": "substantive-unnamed-statement",
      "source_anchors": [
        "A3.SS4.p2.1"
      ],
      "statement": "V_A is 1-strongly convex.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.SS4:smoothness-bound",
      "kind": "substantive-unnamed-statement",
      "source_anchors": [
        "A3.SS4.p2.1"
      ],
      "statement": "V_A is κ-smooth.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.SS4:zero-value",
      "kind": "substantive-unnamed-identity",
      "source_anchors": [
        "A3.SS4.p2.1"
      ],
      "statement": "V_A(0)=0.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.SS4:quadratic-lower",
      "kind": "substantive-unnamed-estimate",
      "source_anchors": [
        "A3.SS4.p2.1"
      ],
      "statement": "For x≠0, V_A(x)≥½||x||²>0.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.SS4:unique-minimizer",
      "kind": "substantive-unnamed-statement",
      "source_anchors": [
        "A3.SS4.p2.1"
      ],
      "statement": "The unique minimizer of V_A is 0.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.SS4:Z-meaning",
      "kind": "implicit-definition-convention",
      "source_anchors": [
        "S1.p1.1",
        "S4.SS1.p2.1",
        "A3.SS4.p3.1",
        "A3.Ex160"
      ],
      "statement": "Z_A is the Gaussian normalizing constant for exp(−V_A). The conventional integral interpretation is ∫_{R^d}exp(−½xᵀAx) dx with respect to Euclidean Lebesgue measure.",
      "source_status": "SOURCE_IMPLICIT",
      "audit_boundary": "The selected raw source does not separately define the base measure or this integral. The displayed formula fixes the intended Lebesgue normalization; candidate phase must expose its actual Z definition and measure. Do not treat this interpretation as an additional explicit source premise."
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.SS4:gaussian-integral",
      "kind": "unnamed-invoked-result",
      "source_anchors": [
        "A3.SS4.p3.1",
        "A3.Ex160"
      ],
      "statement": "Gaussian integration for positive-definite real symmetric A gives Z_A=(2π)^{d/2}(det A)^{-1/2}.",
      "source_status": "SOURCE_EXPLICIT",
      "classification": "internal-paper-step",
      "citation": null,
      "detail": "Explicitly invoked as Gaussian integration; no citation or proof is given here. It includes the analytic integrability/normalization prerequisite. It must remain an actual dependency of a combined normalizer claim."
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.SS4:det-conjugation",
      "kind": "omitted-bridge",
      "source_anchors": [
        "A3.Ex160"
      ],
      "statement": "For every O in the full O(d), det(OΛOᵀ)=det Λ.",
      "source_status": "SOURCE_GAP",
      "classification": "internal-paper-step",
      "gap": "The equality is used in the second equality of Ex160 but not displayed separately or proved. Standard algebra: determinant multiplicativity, transpose invariance, and det(OᵀO)=1 give (det O)^2=1. Both det O=+1 and det O=−1 are allowed. No Gaussian integration is needed for this component by itself."
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.Ex160:normalizer-fixed-spectrum",
      "kind": "reused-display-combined-claim",
      "source_anchors": [
        "A3.Ex160"
      ],
      "statement": "Z_A=(2π)^{d/2}(det A)^{-1/2}=(2π)^{d/2}(det Λ)^{-1/2}.",
      "source_status": "SOURCE_EXPLICIT",
      "latex": "Z_A=(2\\pi)^{d/2}(\\det A)^{-1/2}=(2\\pi)^{d/2}(\\det\\Lambda)^{-1/2}"
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.SS4:Z-independent-of-O",
      "kind": "substantive-unnamed-conclusion",
      "source_anchors": [
        "A3.SS4.p3.2"
      ],
      "statement": "For fixed d,κ, Z_{OΛOᵀ} has the same value for every O∈O(d). This is pointwise invariance/constancy with respect to the eigenbasis; under the Haar experiment it is consequently a deterministic quantity.",
      "source_status": "SOURCE_EXPLICIT"
    },
    {
      "id": "src:arxiv:2610.20492v1:A3.SS4:Z-known-if-public",
      "kind": "conditional-substantive-unnamed-conclusion",
      "source_anchors": [
        "A3.SS4.p3.2"
      ],
      "statement": "Whenever the fixed spectrum is public, Z_A is known from (2π)^{d/2}(det Λ)^{-1/2}. This is an informational conditional, not a statistical independence assumption or an extra source binder.",
      "source_status": "SOURCE_EXPLICIT"
    }
