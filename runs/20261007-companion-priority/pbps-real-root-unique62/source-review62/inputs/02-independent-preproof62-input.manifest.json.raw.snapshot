        "lf_sha256": "6d19997456600e603e6f081f055bf929069a5e636c8c8fa7d2cb37a8615428f7"
      },
      "byte_range": [
        771531,
        773654
      ],
      "literal_source_text": "\\mathsf{U}_{\\perp\\mathsf{P}}^{*}\\mathsf{U}_{\\perp\\mathsf{P}}=\\mathsf{\\Gamma}_{\\mathsf{P}}^{2}\\,,\\hskip 20.00003pt\\|\\mathsf{U}_{\\perp\\mathsf{P}}f\\|=\\|\\mathsf{\\Gamma}_{\\mathsf{P}}f\\|\\,,\\hskip 10.00002ptf\\in\\mathfrak{H}_{\\mathsf{P}}\\,. (B.11)"
    },
    {
      "id": "A2.E15",
      "coverage": "EXCLUDED",
      "reason": "Loewner lower root order not a uniqueness consequence supplied62.",
