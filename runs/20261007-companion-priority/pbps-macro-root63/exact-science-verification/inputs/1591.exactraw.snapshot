          "formula": "\\|\\nabla W(x)\\|\\le b+M\\|x\\|,\\quad\\|\\nabla\\chi_R\\|\\le C_1/R,\\quad|\\Delta\\chi_R|\\le C_2/R^2.",
          "lean": "actual_linear_drift; actual_cutoff_gradient_estimates; actual_cutoff_laplacian_bound"
