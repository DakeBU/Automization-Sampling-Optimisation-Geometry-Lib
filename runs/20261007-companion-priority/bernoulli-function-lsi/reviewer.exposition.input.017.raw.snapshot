  let a := Real.exp (-h / 2)
  let sigma := Real.sqrt (1 - Real.exp (-h))
  let Γ := (stdGaussian E).prod (stdGaussian E)
  let P0 := fun (z ζ : E × E) =&gt; a • z.2 + sigma • ζ.1
  let Y0 := fun (z ζ : E × E) j =&gt; z.1 + t j • P0 z ζ
