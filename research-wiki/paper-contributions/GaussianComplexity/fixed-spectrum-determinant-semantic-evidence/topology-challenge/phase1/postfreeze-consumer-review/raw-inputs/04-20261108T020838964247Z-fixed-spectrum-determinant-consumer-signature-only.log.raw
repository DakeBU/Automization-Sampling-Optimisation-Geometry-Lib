∀ {d : ℕ},
  2 ≤ d →
    ∀ {κ : ℝ},
      2 ≤ κ →
        ∀ (O : ↥(orthogonalGroup (Fin d) ℝ)),
          let θ := fun i => (↑↑i + 1 / 2) * Real.pi / ↑d;
          let diagonalValue := fun i => (κ + 1) / 2 + (κ - 1) / 2 * Real.cos (θ i);
          let A := ↑O * diagonal diagonalValue * (↑O)ᵀ;
          multivariateGaussian 0 A⁻¹ =
            ℙ.withDensity fun x =>
              ENNReal.ofReal
                (√(∏ i, diagonalValue i) / (2 * Real.pi) ^ (↑d / 2) * Real.exp (-(x.ofLp ⬝ᵥ A *ᵥ x.ofLp) / 2)) : Prop
