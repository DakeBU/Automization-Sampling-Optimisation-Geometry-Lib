  "count": 59,
  "literal_definition_semantics": [
    {
      "formula": "c(y,xRef) = y − η • gradient V xRef",
      "id": "center",
      "semantics": "One actual center; fixed y and xRef throughout every finite history.",
      "source_items": [
        "S3.E4.m1"
      ]
    },
    {
      "formula": "h(xRef,x) = gradient V x − gradient V xRef",
      "id": "residual",
      "semantics": "Actual gradient difference, never a supplied arbitrary residual or Lipschitz field.",
      "source_items": [
        "S3.E4.m1"
      ]
    },
    {
      "formula": "R_a p = p − (2 * inner a p / ‖a‖²) • a for a ≠ 0; R_0 p = p",
      "id": "reflection",
      "semantics": "Piecewise zero-safe specular reflection; no continuity premise at a=0.",
      "source_items": [
        "S2.SS1.p1.4",
        "S2.E4.m1",
        "A1.Ex3.m2"
      ]
    },
    {
      "formula": "Φ_t(x,p) = (c+(cos t)•(x−c)+(sqrt η*sin t)•p, −(sin t/sqrt η)•(x−c)+(cos t)•p)",
      "id": "flow",
      "semantics": "Finite real t only; η>0 fixes positive square root. No Φ_∞.",
      "source_items": [
        "A1.Ex2.m1",
        "A1.Ex2.m2"
      ]
    },
    {
