          "literal": "   Measure.isProbabilityMeasure_map (Measurable.aemeasurable (measurable_rademacherSumProd n))⟩\n"
        }
      ],
      "local_callable_credit": false
    },
    {
      "id": "S-PROB-MAP",
      "kind": "API_PRIMITIVE",
      "formula": "Measure.isProbabilityMeasure_map on actual probability product and measurable sum",
      "classification": "EXTERNAL_IMPORTED_PRIMITIVE",
      "anchors": [
        {
          "input_role": "external_gaussian_definition",
          "start_line": 94,
          "end_line": 94,
          "literal_LF_sha256": "d22fbd5c89336c942ea146fc1b399a4eb240e584ce70ad867fa0f06c85971921",
          "literal": "   Measure.isProbabilityMeasure_map (Measurable.aemeasurable (measurable_rademacherSumProd n))⟩\n"
        }
      ],
      "local_callable_credit": false
    },
    {
      "id": "S-CARRIER",
      "kind": "DEFINITION",
      "formula": "RademacherSpace n=Fin n -> Real",
      "classification": "EXTERNAL_SOURCE",
      "anchors": [
        {
          "input_role": "external_C2_definition",
          "start_line": 350,
          "end_line": 351,
          "literal_LF_sha256": "7ede3c6777f75a285a8345c69ea41a95d3debfc1da2e1ec0c3091b99835b4528",
          "literal": "/-- The product space for n independent Rademacher variables. -/\nabbrev RademacherSpace (n : ℕ) := Fin n → ℝ\n"
        }
      ]
    },
    {
      "id": "S-PRODUCT",
      "kind": "DEFINITION",
      "formula": "rademacherProductMeasure n=Measure.pi constant Rademacher measure",
      "classification": "EXTERNAL_SOURCE",
      "anchors": [
        {
          "input_role": "external_C2_definition",
          "start_line": 353,
          "end_line": 359,
          "literal_LF_sha256": "9bf7b419501407dcc9fc32943b071996209b4cec6b049ef1b8ce5f0f35350417",
          "literal": "/-- Product measure for n copies of rademacherMeasure. -/\ndef rademacherProductMeasure (n : ℕ) : Measure (RademacherSpace n) :=\n  Measure.pi (fun _ : Fin n => rademacherMeasure)\n\ninstance isProbabilityMeasure_rademacherProduct (n : ℕ) :\n    IsProbabilityMeasure (rademacherProductMeasure n) :=\n  Measure.pi.instIsProbabilityMeasure _\n"
        }
      ]
    },
    {
      "id": "S-SUM",
      "kind": "DEFINITION",
      "formula": "rademacherSumProd n x=(sqrt n)^-1 * sum_i x_i",
      "classification": "EXTERNAL_SOURCE",
      "anchors": [
        {
          "input_role": "external_C2_definition",
          "start_line": 386,
          "end_line": 388,
          "literal_LF_sha256": "0f23b069807d90cb3c243cc9dde8fca3bdafc95eaa1c942c58912fe403da6d11",
          "literal": "/-- The Rademacher sum on the product space. -/\ndef rademacherSumProd (x : RademacherSpace n) : ℝ :=\n  (√n)⁻¹ * ∑ i : Fin n, x i\n"
        }
      ]
    },
    {
      "id": "S-SUM-MEAS",
      "kind": "BACKGROUND_PRIMITIVE",
      "formula": "Measurable rademacherSumProd n",
      "classification": "EXTERNAL_HEADER_CUT",
      "anchors": [
        {
          "input_role": "external_C2_definition",
          "start_line": 390,
          "end_line": 391,
          "literal_LF_sha256": "224d57a35e267663f31d5e30a7030108f211a911a8dabb492698e0c71c259e7a",
          "literal": "/-- The Rademacher sum is measurable. -/\nlemma measurable_rademacherSumProd : Measurable (rademacherSumProd n) := by\n"
        }
      ],
      "proof_boundary": "Measurability proof392-396 is imported provider substrate, excluded from integration delta."
    },
    {
      "id": "S-LAW",
      "kind": "DEFINITION",
      "formula": "For NeZero n, actual probability law is product measure.map rademacherSumProd",
      "classification": "EXTERNAL_SOURCE",
      "anchors": [
        {
          "input_role": "external_gaussian_definition",
          "start_line": 90,
          "end_line": 94,
          "literal_LF_sha256": "facc271039e449afd36ed3177c0b9c6206198e8bf0074258314350681048d9af",
          "literal": "/-- The law of the Rademacher sum Sₙ under the n-fold product measure.\nThis is the pushforward of `rademacherProductMeasure n` under `rademacherSumProd n`. -/\ndef rademacherLaw (n : ℕ) [NeZero n] : ProbabilityMeasure ℝ :=\n  ⟨(rademacherProductMeasure n).map (rademacherSumProd n),\n   Measure.isProbabilityMeasure_map (Measurable.aemeasurable (measurable_rademacherSumProd n))⟩\n"
        }
      ]
    },
    {
      "id": "S-GAUSS",
      "kind": "DEFINITION",
      "formula": "stdGaussian is ProbabilityMeasure gaussianReal0 variance1",
      "classification": "EXTERNAL_SOURCE",
      "anchors": [
        {
          "input_role": "external_gaussian_definition",
          "start_line": 38,
          "end_line": 40,
          "literal_LF_sha256": "700ecccbd4b89950b22121c0a6b1bd18788205c665d835b9641c1542fb296279",
          "literal": "/-- The standard real Gaussian `𝓝 (0, 1)`. -/\nabbrev stdGaussian : ProbabilityMeasure ℝ :=\n  ⟨gaussianReal 0 1, inferInstance⟩\n"
        }
      ]
    },
    {
      "id": "S-GAUSS-MEASURE",
      "kind": "DEFINITION",
      "formula": "stdGaussianMeasure=stdGaussian.toMeasure with actual probability instance",
      "classification": "EXTERNAL_SOURCE",
      "anchors": [
        {
          "input_role": "external_gaussian_definition",
          "start_line": 149,
          "end_line": 151,
          "literal_LF_sha256": "9f21d20badad03b58019cfefa80299764a8fbf335f2653f5def72c6cc12de11e",
          "literal": "abbrev stdGaussianMeasure : Measure ℝ := stdGaussian.toMeasure\n\ninstance : IsProbabilityMeasure stdGaussianMeasure := stdGaussian.prop\n"
        }
      ]
    },
    {
      "id": "S-SHIFT",
      "kind": "DEFINITION",
      "formula": "NeZero n: shifted sum=S_n-2*x_i/sqrt n",
      "classification": "EXTERNAL_SOURCE",
      "anchors": [
        {
          "input_role": "external_gaussian_definition",
          "start_line": 945,
          "end_line": 948,
          "literal_LF_sha256": "cce93da36d0573c39f5ffa21a2c96dcd75686f6b05538290409700fb5b633a74",
          "literal": "/-- The shifted Rademacher sum: `Sₙ - 2εᵢ/√n`.\nThis represents Sₙ with coordinate i's contribution subtracted twice. -/\ndef rademacherSumShifted (n : ℕ) [NeZero n] (i : Fin n) (x : RademacherSpace n) : ℝ :=\n  rademacherSumProd n x - 2 * x i / Real.sqrt n\n"
        }
      ]
    },
    {
      "id": "S-ENTROPY-LIMIT",
      "kind": "BACKGROUND_PREREQUISITE",
      "formula": "For C2compact, successor product-law homogeneous entropy converges to Gaussian entropy",
      "classification": "EXTERNAL_HEADER_CUT",
      "anchors": [
        {
          "input_role": "external_gaussian_definition",
          "start_line": 1213,
          "end_line": 1215,
          "literal_LF_sha256": "49c41b2b23b0bef7b1d6c0b7be9176fa65450f567d5e2b38d8878a05f12bd828",
          "literal": "theorem tendsto_entropy_f_sq {f : ℝ → ℝ} (hf : CompactlySupportedSmooth f) :\n    Tendsto (fun n => LogSobolev.entropy (rademacherLaw (n + 1)).toMeasure (fun x => (f x)^2))\n      atTop (𝓝 (LogSobolev.entropy stdGaussianMeasure (fun x => (f x)^2))) := by\n"
        }
      ],
      "proof_boundary": "Provider proof1216-1234 is outside integration delta; existing actual36 count-law interface is the authored alternative. No upstream local callable claim."
    },
    {
      "id": "S-ENERGY-LIMIT",
      "kind": "BACKGROUND_PREREQUISITE",
      "formula": "Successor sum of real-product squared shifted-coordinate integrals tends to4*Gaussian derivative energy",
      "classification": "EXTERNAL_HEADER_CUT",
      "anchors": [
        {
          "input_role": "external_gaussian_definition",
          "start_line": 1030,
          "end_line": 1034,
          "literal_LF_sha256": "c5a57e282abf331ad4b4f99aab98cf1527830ba552c78b758586f3402d4ce175",
          "literal": "theorem tendsto_sum_sq_shifted_four_deriv_sq {f : ℝ → ℝ} (hf : CompactlySupportedSmooth f) :\n    Tendsto (fun n => ∑ i : Fin (n + 1), ∫ x,\n        (f (rademacherSumProd (n + 1) x) - f (rademacherSumShifted (n + 1) i x))^2\n          ∂rademacherProductMeasure (n + 1))\n    atTop (𝓝 (4 * ∫ x, (deriv f x)^2 ∂stdGaussianMeasure)) := by\n"
        }
