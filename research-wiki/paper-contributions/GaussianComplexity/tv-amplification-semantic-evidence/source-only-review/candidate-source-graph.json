      "source_anchors": [
        "A2.Ex69"
      ],
      "meaning": "TV(P_+,P_-)=(1/2)integral |sqrt(p_+)-sqrt(p_-)|(sqrt(p_+)+sqrt(p_-)) <= (1/2)sqrt((2-2a)(2+2a)) = sqrt(1-a^2).",
      "status": "SOURCE_ONLY_CANDIDATE_NOT_FORMALIZED_OR_REVIEW_ACCEPTED"
