G : ↥HP →L[ℝ] ↥HP
hG : G.IsPositive
hGSq : G * G = 1 - A * A
G0 : ↥(Lp ℝ 2 ν) →L[ℝ] ↥(Lp ℝ 2 ν) := e.symm.conjStarAlgEquiv G
hG0 : G0.IsPositive
hPullA : e.symm.conjStarAlgEquiv A = T
hG0Sq : G0 * G0 = 1 - T * T
hEq : G0 = Γ
f : ↥HP
⊢ G f = G (e.symm.symm (e.symm f))
