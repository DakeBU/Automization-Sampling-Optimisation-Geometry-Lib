+{"math_id": "A2.E14.m1", "alttext": "\\|\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}\\|\\leq\\rho_{\\rm mac}\\hskip 10.00002pt\\text{and}\\hskip 10.00002pt\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}\\succeq-\\frac{1}{2}\\,I\\hskip 20.00003pt\\text{on }\\mathfrak{H}_{\\mathsf{P},0}\\,.", "RAW_start": 782215, "RAW_end_exclusive": 783586, "RAW_bytes": 1371, "RAW_sha256": "e9ed8d1a118281455eafe4b38f4468e972be4eaddf50b947b625126235b94c5f"}
