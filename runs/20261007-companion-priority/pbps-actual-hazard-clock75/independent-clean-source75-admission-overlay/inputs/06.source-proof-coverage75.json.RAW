      "classification": "NODE",
      "clipped_at_region_boundary": false,
      "formula": "\\nabla V(x)=\\nabla V(\\widetilde{X})+\\{\\nabla V(x)-\\nabla V(\\widetilde{X})\\}\\,.",
      "item_id": "S006",
