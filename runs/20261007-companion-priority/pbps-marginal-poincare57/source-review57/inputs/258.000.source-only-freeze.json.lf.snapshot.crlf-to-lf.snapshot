  "coverage": [
    {
      "region_id": "S1.p1.1",
      "anchor_container": "S1.p1",
      "kind": "substantive-paragraph",
      "disposition": "NODE",
      "reason": "Source region within marginal-Poincare prerequisite/consumer slice.",
      "primary_start_utf8_byte": 47160,
      "primary_end_utf8_byte_exclusive": 49051,
      "raw_sha256": "809b20b78db3d6622ed791cdea3adb7bbe1868080f6ab6628969c42783985386",
      "lf_sha256": "809b20b78db3d6622ed791cdea3adb7bbe1868080f6ab6628969c42783985386",
      "source_text": "We study the problem of sampling from the probability measure \\mu(\\mathrm{d}x)=Z^{-1}e^{-V(x)}\\,\\mathrm{d}x on \\mathbb{R}^{d} , where V\\in C^{2}(\\mathbb{R}^{d}) satisfies, for 0<\\alpha\\leq\\beta ,",
      "node_id": "pbps57:region:S1.p1.1"
    },
    {
      "region_id": "S1.E1",
      "anchor_container": "S1.p1",
      "kind": "display-equation",
      "disposition": "NODE",
      "reason": "Source region within marginal-Poincare prerequisite/consumer slice.",
      "primary_start_utf8_byte": 49052,
      "primary_end_utf8_byte_exclusive": 50640,
      "raw_sha256": "b5c735fec9494c1dfb15f345b7ccf9c4352e80842308f3e62cc360e36ea2872f",
      "lf_sha256": "b5c735fec9494c1dfb15f345b7ccf9c4352e80842308f3e62cc360e36ea2872f",
      "source_text": "\\alpha I\\preceq\\nabla^{2}V(x)\\preceq\\beta I\\,,\\hskip 20.00003ptx\\in\\mathbb{R}^{d}\\,,\\hskip 20.00003pt\\kappa\\coloneqq\\tfrac{\\beta}{\\alpha}\\,. (1.1)",
      "node_id": "pbps57:region:S1.E1"
    },
    {
      "region_id": "byte-49114-50623",
      "anchor_container": "S1.p1",
      "kind": "display-equation",
      "disposition": "NODE",
      "reason": "Source region within marginal-Poincare prerequisite/consumer slice.",
      "primary_start_utf8_byte": 49114,
      "primary_end_utf8_byte_exclusive": 50623,
      "raw_sha256": "184348dedfa456f2488af9c9c6f80fc3d6bbf2034211cd28f9f33a2ee342238b",
      "lf_sha256": "184348dedfa456f2488af9c9c6f80fc3d6bbf2034211cd28f9f33a2ee342238b",
      "source_text": "\\alpha I\\preceq\\nabla^{2}V(x)\\preceq\\beta I\\,,\\hskip 20.00003ptx\\in\\mathbb{R}^{d}\\,,\\hskip 20.00003pt\\kappa\\coloneqq\\tfrac{\\beta}{\\alpha}\\,. (1.1)",
      "node_id": "pbps57:region:byte-49114-50623"
    },
    {
      "region_id": "S1.p1.2",
      "anchor_container": "S1.p1",
      "kind": "substantive-paragraph",
      "disposition": "NODE",
      "reason": "Source region within marginal-Poincare prerequisite/consumer slice.",
      "primary_start_utf8_byte": 50641,
      "primary_end_utf8_byte_exclusive": 50722,
      "raw_sha256": "fd5719cfe11a00a5b6f8b4bc20b77ede0ee70f26e81e9b6adf4dc80d6047dc6e",
      "lf_sha256": "fd5719cfe11a00a5b6f8b4bc20b77ede0ee70f26e81e9b6adf4dc80d6047dc6e",
      "source_text": "The main result of this paper is the following.",
      "node_id": "pbps57:region:S1.p1.2"
    },
    {
