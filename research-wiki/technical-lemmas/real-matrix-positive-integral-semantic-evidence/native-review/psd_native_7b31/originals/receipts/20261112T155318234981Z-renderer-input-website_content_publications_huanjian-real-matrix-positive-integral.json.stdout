        "edition": "ASTIS-authored matrix specialization; external source Mathlibdb584cd6d46c92f209a44c0f1c829460d327499d, source SHA1b3115887fabf0dccc2fed689d1f1ddc7a114b5de4594e752c02908a445aafb4",
