    {
      "id": "transport:pl-lsi",
      "kind": "concept-bridge",
      "label": "PL ↔ LSI mirror: gap vs metric gradient",
      "status": "proposal",
      "subtitle": "functional-inequality mirror",
      "summary": "PL bounds an optimization gap by squared gradient norm. LSI has the same gap-versus-dissipation shape for KL; in the smooth Wasserstein/Langevin picture, relative Fisher information is the squared metric-gradient norm of KL. Both close an energy-dissipation identity to exponential gap decay.",
      "formula": "\\begin{gathered}f(x)-f_*\\le\\frac{C_{\\mathrm{PL}}}{2}\\|\\nabla f(x)\\|^2\\\\\\mathrm{KL}(\\mu\\Vert\\pi)\\le\\frac{C_{\\mathrm{LSI}}}{2}\\,\\mathrm{FI}(\\mu\\Vert\\pi)\\end{gathered}",
      "details": [
        {
          "label": "Evidence boundary",
          "value": "Literature/structural correspondence; no Lean-certified functor or theorem transfer."
        },
        {
          "label": "Conceptual families",
          "value": "family:gap-gradient"
        },
        {
          "label": "Mechanism",
          "value": "PL bounds an optimization gap by squared gradient norm. LSI has the same gap-versus-dissipation shape for KL; in the smooth Wasserstein/Langevin picture, relative Fisher information is the squared metric-gradient norm of KL. Both close an energy-dissipation identity to exponential gap decay."
        },
        {
          "label": "Hypothesis Map",
          "value": "For the sampling side require the source density/absolute-continuity, finite entropy/Fisher information, reversible Langevin/semigroup calculus and normalization conventions. For the optimization side retain the exact PL constant and chosen metric."
        },
        {
          "label": "Conclusion Map",
          "value": "The conceptual mirror is the coercivity slot in the metric-gradient template: Euclidean/Riemannian objective gap ↔ KL gap; squared gradient norm ↔ Fisher dissipation. The scalar Gronwall conclusion is shared after each premise is separately proved."
        },
        {
          "label": "Failure Boundary",
          "value": "LSI is not literally the Euclidean PL theorem and need not follow from smoothness alone. Constants and factors of two depend on conventions; formal Fisher = Wasserstein-gradient-norm statements require their own analytic hypotheses."
        },
        {
          "label": "Category objects",
          "value": "Optimization or probability-law energies with a named gap and a named dissipation functional."
        },
        {
          "label": "Category morphisms",
          "value": "A source-backed identification of the gap/dissipation slots; no theorem equivalence map is claimed."
        },
        {
          "label": "Category identity",
          "value": "Not established; mirror language is deliberately weaker than functorial equivalence."
        },
        {
          "label": "Category composition",
          "value": "A PL/LSI mirror cannot be composed with another bridge unless all metric, density and constant contracts match."
        },
        {
          "label": "Shared planned checkpoints",
          "value": "entropy, flow"
        },
        {
          "label": "Library scope (curated)",
          "value": "Log-concave Sampling · Optimisation · Optimal Transport"
        },
        {
          "label": "Scope evidence boundary",
          "value": "conceptual incidence scope, not compiled cross-domain use"
        }
      ],
