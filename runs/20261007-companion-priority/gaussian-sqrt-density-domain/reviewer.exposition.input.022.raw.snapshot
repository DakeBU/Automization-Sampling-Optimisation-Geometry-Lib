      "chapter_path": "example-cases/samplewiki/companions/smoothed-picard-hmc.html",
      "title": "True standardized RGO square-root density domains",
      "source": {
        "url": "https://arxiv.org/html/2609.06906v1#S4.Ex8",
        "edition": "arXiv:2609.06906v1 with pinned Mathlib db584cd6",
        "anchor": "S4.Ex8 actual residual/standardized posterior; S4.SS1.p4.2-p4.3 omitted classical domains before FIRST S4.E6 GaussianLSI/T2.",
        "wording_status": "faithful paraphrase",
        "attribution": "Fan Chen, Sinho Chewi, Jianfeng Lu, Matthew S. Zhang; actual S4.Ex8 posterior residual with authored measurable-family extension; no printed inequality completion."
      },
      "statement": "For the true source RGO posterior standardized using the same internally produced measurable stationary proximal point, produce the actual relative Gaussian density, positive partition, C2 square root and all L2/entropy/gradient domains with the exact1/4 energy, for every eta(s)>0.",
      "assumptions": [
        "Complete finite-dimensional real Hilbert E with canonical volume and Borel structure, including dimension zero.",
        "Unchanged source normalization kappa>=1, global C2 V with Hessian kappa^-1 I..I; measurable eta/y family S and every eta(s)>0 with no cap.",
        "S/measurable-family scope is an authored extension. Constant Unit families recover printed fixed parameters. No stationary point, actual probability law, partition, density or domain certificates are public inputs."
      ],
      "formulae": [
        {
          "label": "True standardized RGO square-root density domains",
          "tex": "r_s=(x\\mapsto\\eta_s^{-1/2}(x-p_s))_\\#R_s=q_s\\gamma,\\quad q_s=e^{-\\rho_s}/Z_s,\\quad\\nabla\\log q_s=-\\nabla\\rho_s,\\quad\\int\\|\\nabla\\sqrt{q_s}\\|^2d\\gamma=\\tfrac14\\int\\|\\nabla\\rho_s\\|^2dr_s."
        }
      ],
      "obligations": [
        {
          "id": "density-domains",
          "label": "Actual relative density, square-root/entropy and finite gradient energy domains"
        },
        {
          "id": "remaining-paper",
          "label": "ActualLSI/T2/KL/weakSobolev/W2/bias/algorithm/work/main/composition remain open"
        }
      ],
      "bindings": [
