      "id": "semantic-audit:ASTIS-RT-20260930-SPHMCInitialPhaseTransportQ2",
      "kind": "semantic-audit",
      "label": "ASTIS-RT-20260930-SPHMCInitialPhaseTransportQ2",
      "status": "fidelity-exact",
      "subtitle": "arxiv:2609.06906v1:lemma-4.16-identical-momentum-q2-edge · equivalent-after-elaboration",
