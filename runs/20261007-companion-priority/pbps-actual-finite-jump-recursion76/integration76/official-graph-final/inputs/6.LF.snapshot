        "mathtext": "$(\\mathsf{\\Pi}_{p}\\mathsf{T}_{t}^{y,\\widetilde{x}}\\mathsf{\\Pi}_{p}^{*})^{*}=\\mathsf{\\Pi}_{p}(\\mathsf{T}_{t}^{y,\\widetilde{x}})^{*}\\mathsf{\\Pi}_{p}^{*}=\\mathsf{\\Pi}_{p}\\mathsf{R}\\mathsf{T}_{t}^{y,\\widetilde{x}}\\mathsf{R}\\mathsf{\\Pi}_{p}^{*}=\\mathsf{\\Pi}_{p}\\mathsf{T}_{t}^{y,\\widetilde{x}}\\mathsf{\\Pi}_{p}^{*}\\,.$\n",
