      "alttext": "\\displaystyle=\\mathsf{P}\\mathsf{U}(f_{\\mathsf{P}}-f_{\\perp})=\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}f_{\\mathsf{P}}-\\mathsf{U}_{\\perp\\mathsf{P}}^{*}f_{\\perp}=\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}f_{\\mathsf{P}}-\\mathsf{\\Gamma}_{\\mathsf{P}}\\mathsf{V}_{\\perp\\mathsf{P}}^{*}f_{\\perp}=\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}f_{\\mathsf{P}}-\\mathsf{\\Gamma}_{\\mathsf{P}}f_{\\mathsf{V}}\\,.",
