AutoSamplingTheory.Tests.GaussianComplexityFixedSpectrumSourceMatrixVariance.actual_source_centered_variance_bounds
  (of_decide_eq_true (id (Eq.refl true))) : let D := EuclideanSpace ℝ (Fin 2);
let E := EuclideanSpace ℝ (Fin (0 + 1));
let Ω := Fin (0 + 1) → D;
have μ := Measure.pi fun x => stdGaussian D;
have r := ↑(0 + 1);
have L := 2 * r + 3 * Real.log (1000 * ↑2);
have θ := fun i => (↑↑i + 1 - 1 / 2) * Real.pi / ↑2;
have t := fun i k => if ↑k = 0 then 1 else √2 * Real.cos (↑↑k * θ i);
have row := fun i ω => WithLp.toLp 2 fun b => (ω b).ofLp i;
have Y := fun i ω =>
  if ‖row i ω‖ ^ 2 ≤ L then
    (↑2)⁻¹ • (Matrix.vecMulVec (row i ω).ofLp (row i ω).ofLp).kronecker (Matrix.vecMulVec (t i) (t i))
  else 0;
have mean := fun i => ∫ (ω : Ω), Y i ω ∂μ;
have Z := fun i ω => Y i ω - mean i;
have w := fun i => Real.cos (↑(2 * 0 + 1) * θ i);
have C := 2 * r * (r + 2) / ↑2;
(∀ (i : Fin 2), Integrable (fun ω => Z i ω * Z i ω) μ) ∧
  (∀ (i : Fin 2), Integrable (fun ω => w i • Z i ω * w i • Z i ω) μ) ∧
    ‖∑ i, ∫ (ω : Ω), Z i ω * Z i ω ∂μ‖ ≤ C ∧ ‖∑ i, ∫ (ω : Ω), w i • Z i ω * w i • Z i ω ∂μ‖ ≤ C
