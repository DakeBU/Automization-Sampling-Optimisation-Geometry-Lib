    {
      "binder_policy": "exact printed declaration header retained; prerequisites derived at internal callers, never licensed as added final public premises",
      "formula": "theorem rothaus_lemma {a b : ℝ} (ha : 0 < a) (hb : 0 < b) :\n    (a * log a + b * log b) / 2 - (a + b) / 2 * log ((a + b) / 2) ≤\n    (sqrt a - sqrt b)^2 / 2",
      "id": "TwoPoint.rothaus_lemma",
      "kind": "SOURCE_LEMMA",
      "route_role": "UPSTREAM_HAN_ROUTE",
