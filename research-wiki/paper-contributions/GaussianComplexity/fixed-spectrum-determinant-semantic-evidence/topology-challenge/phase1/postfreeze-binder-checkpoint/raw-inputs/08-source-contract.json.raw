  "literal_definitions": {
    "source_index": "i=1,...,d",
    "theta_i": "((i-1/2)*pi)/d",
    "lambda_i": "(kappa+1)/2+((kappa-1)/2)*cos(theta_i)",
    "Lambda": "diag(lambda_1,...,lambda_d)",
    "A": "O*Lambda*transpose(O)",
    "f_A": "x -> (transpose(x)*A*x)/2",
    "pi_A": "N(0,inverse(A))",
    "zero_based_translation": "For j in Fin d the source i is j+1, so theta_j=((j+1/2)*pi)/d, with casts to real before division."
  },
