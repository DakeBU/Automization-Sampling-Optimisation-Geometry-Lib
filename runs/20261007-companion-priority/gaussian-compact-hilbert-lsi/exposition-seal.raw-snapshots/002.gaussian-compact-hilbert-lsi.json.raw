{
  "schema_version": 1,
  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.GaussianCompactHilbertLogSobolev.compact_stdGaussian_logSobolev",
      "title": "Compact finite-Hilbert standard Gaussian log-Sobolev inequality",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06906v1#S4.E6",
          "label": "FIRST S4.E6 / S4.SS1.p4.3 omitted GaussianLSI background; authored compact finiteHilbert canonical law/gradient adapter from actual40",
          "scope": "Actual stdGaussian E on any finite-dimensional real Hilbert space, including rank0, for signed real C2compact f. Internally produced square/Phi-square/gradient-square L1 and homogeneous entropy<=2 actual gradient-square integral. Actual canonical orthonormal law map and gradient Parseval are internal; no supplied law/LSI/domain/energy/limit/basis certificates. Compact sufficient background only; actual32 noncompact cutoff/coherent33 KL/Fisher, T2/FIRST4.6, both paper algorithms/main/error/work/cost/composition and full reader/PURIFIED remain open. Actual focused3812 passes; generic zero, signed nonzero rank0 and real32 standardized RGO sqrt-density with canonical proximal witness and positive-scale radial cutoff compile. No raw noncompact application or limit claim. Independent proof/fidelity/commit/shared admission pending."
        }
      ],
      "tests": [
        "lake build Tests.GaussianCompactHilbertLogSobolev"
      ],
      "assumptions": [
        "E is any finite-dimensional complete real inner product space, with compatible norm and Borel measurable structure, including rank0. The basis is chosen internally; no positive-dimension assumption.",
        "Only f, globally real C2 regularity and compact support are analytic premises. Signed functions/zero mass are included; no law, covariance, positivity, normalized mass, domain, gradient-Parseval or desired-inequality certificate is supplied.",
        "gamma is literally Mathlib ProbabilityTheory.stdGaussian E. The actual canonical orthonormal basis sum of independent centered variance-one coordinates is identified with the continuous linear homeomorphism internally.",
        "gradient is the literal global Mathlib Riesz Frechet representative. True coordinate chain rule and Parseval give its Hilbert norm squared; no default-Pi supremum operator norm or dimensional multiplier.",
        "All3 L1 domains are conclusions. Measurable law transport and real map integrals carry true product-domain square, continuous tlogt and full energy from actual40.",
        "Exact function-LSI coefficient2. Actual32 standardized RGO square-root-density cutoff test is a genuine consumer; cutoff exhaustion/coherent33 KL/Fisher, full noncompact/W12 LSI, separate GaussianT2/FIRST4.6 and both paper main/error/work/cost remain open."
      ],
      "statement": "For every finite-dimensional real Hilbert/Borel space E, including rank zero, and signed real C2 compactly supported f, let gamma be the actual canonical stdGaussian E. The theorem internally produces true L1 of f squared, f squared times log(f squared), and the Hilbert norm of the true gradient squared, then proves homogeneous Ent_gamma(f squared)<=2 integral norm(gradient f)^2. Canonical basis law transport and orthonormal Parseval are internal; zero mass is included.",
      "formula": "\\gamma=\\mathrm{stdGaussian}(E),\\qquad f\\in C_c^2(E;\\mathbb R),\\qquad \\operatorname{Ent}_{\\gamma}(f^2)=\\int f^2\\log(f^2)\\,d\\gamma-\\left(\\int f^2\\,d\\gamma\\right)\\log\\left(\\int f^2\\,d\\gamma\\right)\\le2\\int\\|\\nabla f\\|^2\\,d\\gamma.",
      "boundary": "Actual stdGaussian E on any finite-dimensional real Hilbert space, including rank0, for signed real C2compact f. Internally produced square/Phi-square/gradient-square L1 and homogeneous entropy<=2 actual gradient-square integral. Actual canonical orthonormal law map and gradient Parseval are internal; no supplied law/LSI/domain/energy/limit/basis certificates. Compact sufficient background only; actual32 noncompact cutoff/coherent33 KL/Fisher, T2/FIRST4.6, both paper algorithms/main/error/work/cost/composition and full reader/PURIFIED remain open. Actual focused3812 passes; generic zero, signed nonzero rank0 and real32 standardized RGO sqrt-density with canonical proximal witness and positive-scale radial cutoff compile. No raw noncompact application or limit claim. Independent proof/fidelity/commit/shared admission pending.",
      "steps": [
        {
          "title": "Choose the actual canonical coordinate homeomorphism",
          "text": "Let n be the real dimension and b the canonical orthonormal basis. The inverse continuous basis equivalence T maps coordinate vectors to their actual finite linear combination. This is an internal linear homeomorphism even at dimension0.",
          "formula": "n=\\dim_{\\mathbb R}E,\\quad b=\\mathrm{stdOrthonormalBasis},\\quad T=(b.\\mathrm{equivFunL})^{-1},\\quad Tz=\\sum_i z_i b_i.",
          "lean": "stdOrthonormalBasis; Basis.equivFunL; Basis.equivFun_symm_apply"
        },
        {
          "title": "Identify the literal Gaussian law",
          "text": "The definition of stdGaussian uses precisely this canonical basis sum. Rewriting the inverse basis formula identifies gamma as the pushforward of the actual independent variance-one coordinate Gaussian product. Covariance similarity alone is never used as a law certificate.",
          "formula": "\\gamma_n=\\bigotimes_{i\\in\\mathrm{Fin}(n)}\\mathcal N(0,1),\\qquad \\mathrm{stdGaussian}(E)=T_\\#\\gamma_n.",
          "lean": "hγ; literal stdGaussian definition; Basis.equivFun_symm_apply"
        },
        {
          "title": "Pull back the true compact smooth function",
          "text": "The actual pullback g=f o T is C2 because T is continuous linear; the homeomorphism pulls compact support back. The compiled finite-product producer40 returns every genuine product L1 domain and the constant2 entropy bound for this same g.",
          "formula": "g=f\\circ T\\in C_c^2,\\qquad \\operatorname{Ent}_{\\gamma_n}(g^2)\\le2\\int\\sum_i(D_i g)^2\\,d\\gamma_n.",
          "lean": "ContDiff.comp_continuousLinearMap; HasCompactSupport.comp_homeomorph; compact_gaussian_pi_logSobolev"
        },
        {
          "title": "Compute actual directional derivatives",
          "text": "The inverse basis equivalence sends the literal single-coordinate unit vector to b_i. Chain rule therefore gives D_i g(z)=fderiv f(Tz)[b_i]. The actual Riesz gradient identity rewrites this as the Hilbert inner product, with C2 supplying true differentiability.",
          "formula": "Te_i=b_i,\\qquad D_i g(z)=\\mathrm{fderiv}_{\\mathbb R}f(Tz)[b_i]=\\langle\\nabla f(Tz),b_i\\rangle.",
          "lean": "pullback_energy.hsingle/hD; fderiv_comp; ContinuousLinearMap.fderiv; inner_gradient_left"
        },
        {
          "title": "Use orthonormal Parseval without dimension loss",
          "text": "The actual orthonormal sum of squared gradient coordinates equals the Hilbert gradient norm squared. This equality also handles rank0 by the empty basis sum. It does not assert equality with the default Pi derivative operator norm.",
          "formula": "\\sum_i(D_i g(z))^2=\\sum_i\\langle\\nabla f(Tz),b_i\\rangle^2=\\|\\nabla f(Tz)\\|^2.",
          "lean": "pullback_energy; OrthonormalBasis.sum_sq_inner_left"
        },
        {
          "title": "Transport genuine domains and real integrals",
          "text": "Square and continuous tlogt-square are continuous; the reusable C1 gradient helper gives continuity of the true gradient energy. Integrable_map_measure transports the actual product L1 outputs to gamma. Integral_map then identifies the two entropy integrals and the energy integral, with measurable T and actual integrand measurability.",
          "formula": "f^2,\\ \\Phi(f^2),\\ \\|\\nabla f\\|^2\\in L^1(\\gamma),\\quad \\int H\\,d\\gamma=\\int H(Tz)\\,d\\gamma_n,\\qquad\\Phi(t)=t\\log t.",
          "lean": "continuous_gradient_of_contDiff_one; Real.Continuous.mul_log; integrable_map_measure; integral_map"
        },
        {
          "title": "Return the exact compact Hilbert inequality",
          "text": "Rewrite the finite-product inequality using the true law and Parseval identities. The public result joins the three derived domains with homogeneous entropy<=2 actual gradient energy. The test cuts off the actual32 posterior square-root density at a positive radius using the same proximal witness; passing the radius to infinity is a later theorem.",
          "formula": "\\operatorname{Ent}_{\\mathrm{stdGaussian}(E)}(f^2)\\le2\\int\\|\\nabla f\\|^2\\,d\\mathrm{stdGaussian}(E).",
          "lean": "compact_stdGaussian_logSobolev; actual_posterior_compact_lsi Test"
        }
      ],
      "lean_statement": "For every finite-dimensional real Hilbert/Borel space E, including rank zero, and signed real C2 compactly supported f, let gamma be the actual canonical stdGaussian E. The theorem internally produces true L1 of f squared, f squared times log(f squared), and the Hilbert norm of the true gradient squared, then proves homogeneous Ent_gamma(f squared)<=2 integral norm(gradient f)^2. Canonical basis law transport and orthonormal Parseval are internal; zero mass is included.",
      "lean_proof": "Choose the actual canonical coordinate homeomorphism; Identify the literal Gaussian law; Pull back the true compact smooth function; Compute actual directional derivatives; Use orthonormal Parseval without dimension loss; Transport genuine domains and real integrals; Return the exact compact Hilbert inequality",
      "astis_dependencies": [
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.GaussianCompactProductLogSobolev.compact_gaussian_pi_logSobolev",
        "AutoSamplingTheory.TechnicalLemmas.Analysis.Calculus.Gradient.continuous_gradient_of_contDiff_one"
      ],
      "mathlib_dependencies": [
        "stdOrthonormalBasis",
        "Module.Basis.equivFunL",
        "Module.Basis.equivFun_symm_apply",
        "ProbabilityTheory.stdGaussian",
