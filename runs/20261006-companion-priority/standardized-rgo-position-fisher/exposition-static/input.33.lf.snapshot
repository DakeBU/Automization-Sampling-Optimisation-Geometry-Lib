    {
      "id": "transport:discrete-mlsi",
      "kind": "concept-bridge",
      "label": "Modified LSI: KL controlled by finite-jump dissipation",
      "status": "proposal",
      "subtitle": "conceptual mirror candidate; independent review pending",
      "summary": "A PL-shaped energy-dissipation inequality gives entropy decay. Finite jumps use the logarithmic difference rather than the diffusion spatial-gradient chain rule.",
      "formula": "\\begin{gathered}\\partial_t\\operatorname{KL}(\\nu_t\\Vert\\pi)=-\\mathcal E_P(r_t,\\log r_t)\\\\ \\operatorname{Ent}_\\pi(r)\\leq C_M\\mathcal E_P(r,\\log r)\\\\ \\Longrightarrow\\ \\operatorname{KL}_t\\leq e^{-t/C_M}\\operatorname{KL}_0\\end{gathered}",
      "details": [
        {
          "label": "Evidence boundary",
          "value": "Literature/structural correspondence; no Lean-certified functor or theorem transfer."
        },
        {
          "label": "Review status",
          "value": "candidate"
        },
        {
          "label": "Review boundary",
          "value": "A candidate awaits independent source review. Source review does not certify a Lean transport."
        },
        {
          "label": "Conceptual families",
          "value": "family:gap-gradient"
        },
        {
          "label": "Mechanism",
          "value": "A PL-shaped energy-dissipation inequality gives entropy decay. Finite jumps use the logarithmic difference rather than the diffusion spatial-gradient chain rule."
        },
        {
          "label": "Hypothesis Map",
          "value": "Finite pi-reversible chain, positive density r of mean one, L=P-I; specify extension to densities with zeros. The displayed C_M convention has no hidden factor two. Entropy factorization requires its own pinning/marginal hypotheses."
        },
        {
          "label": "Conclusion Map",
          "value": "Transport the scalar decay proof, not the diffusion Fisher-information formula. Establish the finite entropy derivative and modified LSI separately."
        },
        {
          "label": "Failure Boundary",
          "value": "Ordinary LSI with E(sqrt(r),sqrt(r)), modified LSI with E(r,log r), and Poincare are different inequalities. Continuous-time entropy decay does not automatically certify discrete-time KL contraction."
        },
        {
