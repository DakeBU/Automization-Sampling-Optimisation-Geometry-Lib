<tr id="S2.T1.4.6" class="ltx_tr">
<td id="S2.T1.4.6.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;" colspan="4"><em id="S2.T1.4.6.1.1" class="ltx_emph ltx_font_italic" style="font-size:80%;">Proximal augmentation</em></td></tr>
<tr id="S2.T1.4.7" class="ltx_tr">
