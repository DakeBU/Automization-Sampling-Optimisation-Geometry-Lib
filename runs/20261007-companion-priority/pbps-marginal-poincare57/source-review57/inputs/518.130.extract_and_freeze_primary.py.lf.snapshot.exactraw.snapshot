from pathlib import Path
from html.parser import HTMLParser
import hashlib,json,sys,datetime
sys.stdout.reconfigure(encoding='utf-8')
ROOT=Path('E:/Samplinglib');O=Path(__file__).parent;OLD=ROOT/'runs/20261007-companion-priority/phase-pbps-primary-preread56'
def sha(b):return hashlib.sha256(b).hexdigest()
def canon(v):return json.dumps(v,ensure_ascii=False,sort_keys=True,separators=(',',':')).encode()
def pin(p):
 b=p.read_bytes();return {'path':p.relative_to(ROOT).as_posix(),'bytes':len(b),'raw_sha256':sha(b),'lf_sha256':sha(b.replace(b'\r\n',b'\n'))}
def put(name,v):
 v['content_self_sha256']=sha(canon(v));p=O/name;p.write_bytes((json.dumps(v,ensure_ascii=False,indent=2)+'\n').encode());assert json.loads(p.read_bytes())==v;return pin(p)
class Parser(HTMLParser):
 def __init__(self):super().__init__();self.stack=[];self.nodes=[];self.offsets=[]
 def handle_starttag(self,t,a):
  n={'tag':t,'attrs':dict(a),'children':[],'start':self.offsets[self.getpos()[0]-1]+self.getpos()[1]}
  if self.stack:self.stack[-1]['children'].append(n)
  self.nodes.append(n)
  if t not in ['area','base','br','col','embed','hr','img','input','link','meta','param','source','track','wbr']:self.stack.append(n)
 def handle_endtag(self,t):
  for i in range(len(self.stack)-1,-1,-1):
   if self.stack[i]['tag']==t:
    self.stack[i]['end']=self.offsets[self.getpos()[0]-1]+self.getpos()[1]+len('</'+t+'>');self.stack=self.stack[:i];break
 def handle_data(self,s):
  if self.stack:self.stack[-1]['children'].append(s)
def txt(n):
 if isinstance(n,str):return n
 if n['tag']=='math':return n['attrs'].get('alttext','[math-no-alt]')
 return ' '.join(txt(c) for c in n['children'])
b=(OLD/'primary-pbps.raw.snapshot.html').read_bytes();assert len(b)==1482128 and sha(b)=='d81e929496ff33f8895ebdb45b5b7f3eba89a069806d97d5bbbd7a6c0c032760'
(O/'primary-pbps.exactraw.snapshot.html').write_bytes(b);(O/'primary-pbps.crlf-to-lf.snapshot.html').write_bytes(b.replace(b'\r\n',b'\n'));s=b.decode();p=Parser();pos=0
for line in s.splitlines(keepends=True):p.offsets.append(pos);pos+=len(line)
p.feed(s)
anchors=[]
ids=['S1.p1','S1.p2','S2.SS2','A2.SS1','A2.E5','A2.E8','A2.E9','A2.E10','A2.E11','A2.E12','A2.E13','A2.E14','A2.E15','A2.E16','A2.E17','A2.SS3','A3.SS1','A3.SS2','A3.SS3','A4.SS1','A4.SS2']
for ident in ids:
 nodes=[n for n in p.nodes if n['attrs'].get('id')==ident];assert len(nodes)==1,(ident,len(nodes));n=nodes[0];assert 'end' in n
 raw=s[n['start']:n['end']].encode();assert raw.startswith(('<'+n['tag']).encode()) and raw.endswith(('</'+n['tag']+'>').encode())
 rawfile=O/(ident+'.raw.html');rawfile.write_bytes(raw);lffile=O/(ident+'.lf.html');lffile.write_bytes(raw.replace(b'\r\n',b'\n'))
 text=' '.join(txt(n).split());tf=O/(ident+'.text.txt');tf.write_text(text,encoding='utf-8',newline='\n')
 if (OLD/(ident+'.raw.html')).exists():assert (OLD/(ident+'.raw.html')).read_bytes()==raw
 anchors.append({'id':ident,'html_tag':n['tag'],'source_start_utf8_byte':len(s[:n['start']].encode()),'source_end_utf8_byte_exclusive':len(s[:n['end']].encode()),'balanced_source_slice':True,'exactraw':pin(rawfile),'crlf_to_lf':pin(lffile),'math_alttext_text':pin(tf),'reused56_anchor_byte_identity':(OLD/(ident+'.raw.html')).exists()})
mathnodes=[n for n in p.nodes if n['tag']=='math'];mathtexts=[txt(n) for n in mathnodes]
adjoint_math=[t for t in mathtexts if 'nabla' in t and any(x in t for x in ['*','ast','dagger'])]
gamma_nonP=[t for t in mathtexts if 'Gamma' in t and 'mathsf{P}' not in t]
omission={'math_node_count':len(mathnodes),'gradient_adjoint_math_alttext_matches':adjoint_math,'Gamma_without_macro_P_math_matches':gamma_nonP,'raw_literal_keyword_counts':{k:s.lower().count(k.lower()) for k in ['laplacian','resolvent','gradient-adjoint','nabla^{*}','nabla^*','nabla^{\\ast}']},'precision':'Full pinned HTML/MathML scan and balanced B/C/D source reading find no weighted-Laplacian, gradient-adjoint domain, eta-resolvent, or alternative Gamma definition. This is a source-omission finding, not a proof no mathematical equivalent can be derived.'}
put('source-anchor-manifest.json',{'schema_version':1,'actor':'/root/next_primary56','status':'SOURCE_ONLY_FROZEN_BEFORE_REUSE_CONTRACT_READ','pinned_primary':pin(OLD/'primary-pbps.raw.snapshot.html'),'raw_copy':pin(O/'primary-pbps.exactraw.snapshot.html'),'lf_copy':pin(O/'primary-pbps.crlf-to-lf.snapshot.html'),'anchors':anchors,'omission_search':omission,'candidate57_read':False,'candidate57_exists_as_supplied':False,'reuse_Lean_contract_read_started':False})
contract={'schema_version':1,'actor':'/root/next_primary56','status':'PRIMARY_ONLY_SOURCE_CONTRACT_SEALED','source':{'id':'arXiv:2609.06905v1','title':'Accelerated High-Accuracy Sampling from a Warm Start via the Proximal Bouncy Particle Sampler','authors':['Fan Chen','Sinho Chewi','Jianfeng Lu','Matthew S. Zhang'],'url':'https://arxiv.org/html/2609.06905v1','version':'v1','license_url_from_existing_execution_registry':'http://arxiv.org/licenses/nonexclusive-distrib/1.0/','license_boundary':'Reuse supplied fixed snapshot; no new fetch/license grant or external ML use. Version/license metadata retained from existing execution record, not newly inferred from snapshot.'},'source_anchor_manifest':pin(O/'source-anchor-manifest.json'),'standing_assumptions':'Printed R^d, V C2, 0<alpha<=beta, global alpha I<=Hess V<=beta I, eta>0 and beta eta<=1 for B.1. No added higher derivatives. Finite real Hilbert/rank0 is a later explicitly authored extension, not printed source setting.','objects':{'mu':'Normalized exp(-V) target on X.','J':'pi_eta=law(X,X+sqrt(eta)Z), independent X~mu,Z~N(0,I).','nu':'pi_eta^Y=J.snd, not mu.','Hilbert':'H=L2(J), generally infinite dimensional despite finite d. H_P=ranP identified isometrically with L2(nu), H_perp=kerP. P is conditional expectation onto Y.','U':'Self-adjoint unitary reflection pullback f(x,y)->f(x,2x-y).','A':'U_PP=PUP restricted H_P, self-adjoint contraction. Full-joint PUP is not the same operator space as I on H_P.','B':'U_perpP=(I-P)UP:H_P->H_perp; B*B=I_H_P-A², sourceB.5.','Gamma_P':'(I_H_P-A²)^(1/2), sourceB.10; positive self-adjoint square root by standard spectral convention, bounded on full H_P. Not a gradient/Laplacian resolvent.','macro_mean_zero':'H_P,0=H_P intersect L2_0(J), corresponding centered L2(nu).','inverse':'Gamma_P inverse only asserted bounded on H_P,0 after B.15 gap; constants preclude an inverse on full H_P. V_perpP=B Gamma_P^-1 is isometry from H_P,0 into H_perp, not onto H_perp.'},'exact_formulae':[{'anchor':'B.10/B.11','formula':'Gamma_P²=I-A²=B*B; ||Gamma_P f||²=||Bf||²=||f||²-||Af||² for every f in H_P.','eta_coefficient':'Gamma_P definition/norm identity has NO eta prefactor.'},{'anchor':'B.13','formula':'For every f in L2(nu), Af belongs to H1(nu), and 4eta||grad Af||²<=||f||²-||Af||²=||Gamma_P f||²=||Bf||².','quantifiers':'All rough L2; not only meanzero. Gradient-domain conclusion is source weighted H1.'},{'anchor':'C.2 equation','formula':'eta||grad Af||²<=[(1-alpha eta)²/(4(1+alpha eta))]||Bf||².','scope':'Smooth compact calculation followed by density/closedness; not C.2 subsection halfturn.'},{'anchor':'B.12/B.14/B.15','formula':'rho_mac=(1-alpha eta)/(1+alpha eta), gamma_gap=2sqrt(alpha eta)/(1+alpha eta); ||A||<=rho_mac and A>=-I/2 on H_P,0; Gamma_P>=gamma_gap I there.','scope':'Bounded inverse with norm<=1/gamma_gap is source spectral consequence; never all H_P.'},{'anchor':'B.16','formula':'V_perpP=B Gamma_P^-1; V_perpP*V_perpP=I_H_P,0.'},{'anchor':'C.28','formula':'On ran1_[1/2,1](A), apply B.13 to A^-1w and A^-1(I-A)w: sqrt(eta)||grad w||<=C||Gamma_P w||, sqrt(eta)||grad(I-A)w||<=C||Gamma_P³w||.','scope':'Inverse A is only on this spectral band; no inverse at zero eigenvalue. A spectral restriction commutes with Gamma_P.'}],'gradient_laplacian_convention':{'printed':'Source uses weighted H1(nu), gradient density/closedness; it does not define weighted divergence, gradient adjoint, weighted Laplacian or resolvent.','possible_authored_analytic_adapter':'If density nu is rho(y)dy with potential W=-log rho up to constant, on smooth compact fields the weighted gradient adjoint convention would be grad_nu* F=-divF+gradW dot F. Then grad_nu*grad=-Delta+gradW dot grad is nonnegative, while diffusion generator Delta-gradW dot grad is nonpositive. These are explicitly inferred background conventions requiring separate definition/domain proof, not source formulas.','eta_resolvent':'Any I+lambda G*G uses authored lambda>0; primary gives NO eta coefficient for such a resolvent. Do not silently identify it or its square root with Gamma_P.'},'omission_audit':omission,'source_dependency_graph':{'nodes':[{'id':'S:model','kind':'source-assumptions','anchor':'S1.p1/p2,S2.SS2'},{'id':'S:macro','kind':'definition','anchor':'B.1-B.4'},{'id':'S:block','kind':'source-identity','anchor':'B.5'},{'id':'S:positive-defect','kind':'internal-paper-step','anchor':'B.5 plus self-adjoint contraction'},{'id':'S:Gamma-sqrt','kind':'source-definition-analytic-omission','anchor':'B.10'},{'id':'S:norm-identity','kind':'source-conclusion','anchor':'B.11'},{'id':'S:compact-energy','kind':'source-proof','anchor':'C.1/C.2'},{'id':'S:rough-gradient-domain','kind':'source-omitted-analytic-adapter','anchor':'C.1 density/closedness'},{'id':'S:B13','kind':'true-next-consumer','anchor':'B.13'},{'id':'S:macro-gap','kind':'separate-source-proof','anchor':'C.3-C.7/B.14-B.15'},{'id':'S:inverse-polar','kind':'later-consumer','anchor':'B.16'},{'id':'S:halfturn','kind':'later-source-proof','anchor':'C.11-C.28/B.17'}],'edges':[{'from':'S:model','to':'S:macro'},{'from':'S:macro','to':'S:block'},{'from':'S:block','to':'S:positive-defect'},{'from':'S:positive-defect','to':'S:Gamma-sqrt'},{'from':'S:Gamma-sqrt','to':'S:norm-identity'},{'from':'S:block','to':'S:norm-identity'},{'from':'S:model','to':'S:compact-energy'},{'from':'S:compact-energy','to':'S:rough-gradient-domain'},{'from':'S:rough-gradient-domain','to':'S:B13'},{'from':'S:norm-identity','to':'S:B13'},{'from':'S:B13','to':'S:macro-gap'},{'from':'S:macro-gap','to':'S:inverse-polar'},{'from':'S:norm-identity','to':'S:inverse-polar'},{'from':'S:B13','to':'S:halfturn'},{'from':'S:inverse-polar','to':'S:halfturn'}],'truth_boundary':'Source topology blueprint only, no Lean dependency admission. Poincare marginal and exchangeability/H1 difference estimate are separate inputs to macro-gap, not silently completed edges.'},'narrow_next_delta_before_reuse':'Actual bounded positive self-adjoint defect square root on genuine macro L2 with B.11 norm identity, transported across real isometry M; joins existing56 sharp closed-gradient estimate to Gamma norm. This does not yet identify source H1 or obtain meanzero gap/inverse/halfturn. A generic uniform resolvent operator is not a paper-Gamma prerequisite unless a real weak-H1 adapter consumer is separately recorded.','remaining_boundaries':['Source weak-H1 versus authored compact-gradient closure equivalence.','Positive-root construction and same actual A/M/B compatibility not yet Lean admitted.','Centered marginal Poincare/spectral gap Gamma lower bound and bounded inverse.','A inverse on positive spectral band, coordinatewise derivative formula, conditional affine approximation and halfturn.','Hypocoercive modified L2 dynamics, original algorithm/main/errors/cost/actual-input composition.'],'chronology':{'primary57_contract_before_any_public_Lean_reuse_contract':True,'candidate57_statement_or_body_read':False,'candidate57_proof_started':False,'candidate57_existence_as_supplied':False,'earlier56_final_packet_body_exposure':'Disclosed historical final-stage exposure; original primary56 and this primary57 source-only extraction are not fabricated blinded reruns.','no_full56_review_rerun':True},'compiler_started':False,'compiler_lease':'NOT_STARTED_CLOSED','formal_admission':False}
