      "credit": "Exact source formula only; not a proved Lean clause",
      "id": "A1.Ex1.m1",
      "literal_source_alttext": "\\lambda_{\\widetilde{x}}(x,p)=\\sqrt{\\eta}\\,[p^{\\top}h_{\\widetilde{x}}(x)]_{+}\\,.",
      "source_URL": "https://arxiv.org/html/2609.06905v1#A1.Ex1.m1"
    },
    {
