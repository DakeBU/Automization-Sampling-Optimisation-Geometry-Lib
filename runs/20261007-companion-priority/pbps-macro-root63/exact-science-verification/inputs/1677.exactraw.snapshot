        "file": "a3415620a02d672a137e48b1e1e17dc1fec6f34202bdf3bb1507e1df40d3e9b1",
        "current_lean_module": "import AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.RandomStoppingGeneralIto\n\n/-!\n# Mean of a completed Itô process at a bounded stopping time\n\nFor a progressive square-integrable integrand on a finite horizon, the\ncompleted Itô process evaluated at a stopping time bounded by that horizon is\nintegrable and has mean zero.\n\nThe proof applies the martingale mean identity to the completed Itô process of\nthe stopped integrand.  The completed random-stopping theorem then identifies\nits terminal value with evaluation of the original continuous process at the\nstopping time.  No optional-sampling theorem beyond the deterministic-time\nmartingale identity is required.\n-/\n\nnamespace AutoSamplingTheory\nnamespace TechnicalLemmas\nnamespace StochasticProcesses\nnamespace BoundedStoppedItoMean\n\nopen MeasureTheory Set\nopen scoped NNReal\n\nopen BrownianMotion ItoIntegralProcess ProgressiveL2 ProgressiveL2Stopping\n  RandomStoppingGeneralIto StoppingTime\n\nvariable {Omega : Type*} {m : MeasurableSpace Omega}\n  {filtration : Filtration ℝ≥0 m} {mu : Measure Omega} {T : ℝ≥0}\n  {B : ℝ≥0 → Omega → ℝ}\n\n/-- The completed Itô process is integrable when evaluated at a stopping time\nthat is pointwise bounded by its construction horizon. -/\ntheorem itoIntegralProcess_at_boundedStopping_integrable\n    [IsFiniteMeasure mu]\n    (eta : ProgressiveL2Integrand filtration mu T) (hT : 0 < T)\n    (tau : Omega → ℝ≥0)\n    (htau : IsChewiStoppingTime filtration\n      (fun omega => (tau omega : WithTop ℝ≥0)))\n    (htauT : ∀ omega, tau omega ≤ T)\n    (hB : IsBrownianMotionWithFiltration B filtration mu)\n    (hUsual : SatisfiesUsualConditions filtration mu) :\n    Integrable\n      (fun omega => itoIntegralProcess eta hT hB hUsual (tau omega) omega) mu := by\n  let _ : IsProbabilityMeasure mu := hB.isProbabilityMeasure\n  let stoppedEta := stop eta (fun omega => (tau omega : WithTop ℝ≥0)) htau\n  have hterminal :\n      terminalRepresentative stoppedEta hT hB =ᵐ[mu]\n        (fun omega => itoIntegralProcess eta hT hB hUsual (tau omega) omega) := by\n    exact (itoIntegralTerminal_stop_ae eta hT tau htau htauT hB hUsual)\n  exact (terminalRepresentative_integrable stoppedEta hT hB).congr hterminal\n\n/-- The completed Itô process has mean zero when evaluated at a stopping time\nthat is pointwise bounded by its construction horizon. -/\ntheorem integral_itoIntegralProcess_at_boundedStopping_eq_zero\n    [IsFiniteMeasure mu]\n    (eta : ProgressiveL2Integrand filtration mu T) (hT : 0 < T)\n    (tau : Omega → ℝ≥0)\n    (htau : IsChewiStoppingTime filtration\n      (fun omega => (tau omega : WithTop ℝ≥0)))\n    (htauT : ∀ omega, tau omega ≤ T)\n    (hB : IsBrownianMotionWithFiltration B filtration mu)\n    (hUsual : SatisfiesUsualConditions filtration mu) :\n    ∫ omega, itoIntegralProcess eta hT hB hUsual (tau omega) omega ∂mu = 0 := by\n  let _ : IsProbabilityMeasure mu := hB.isProbabilityMeasure\n  let stoppedEta := stop eta (fun omega => (tau omega : WithTop ℝ≥0)) htau\n  have hmartingale :\n      Martingale (itoIntegralProcess stoppedEta hT hB hUsual) filtration mu :=\n    itoIntegralProcess_martingale stoppedEta hT hB hUsual\n  have hterminalMean :\n      ∫ omega, terminalRepresentative stoppedEta hT hB omega ∂mu = 0 := by\n    have hmean := hmartingale.setIntegral_eq (show (0 : ℝ≥0) ≤ T from bot_le)\n      (MeasurableSet.univ : MeasurableSet[filtration 0] Set.univ)\n    have hprocessMean :\n        ∫ omega, itoIntegralProcess stoppedEta hT hB hUsual T omega ∂mu = 0 := by\n      simpa only [Measure.restrict_univ, itoIntegralProcess_at_zero,\n        Pi.zero_apply, integral_zero] using hmean.symm\n    exact integral_congr_ae\n      (terminalRepresentative_ae_eq_actual stoppedEta hT hB hUsual) |>.trans hprocessMean\n  calc\n    ∫ omega, itoIntegralProcess eta hT hB hUsual (tau omega) omega ∂mu =\n        ∫ omega, terminalRepresentative stoppedEta hT hB omega ∂mu := by\n          apply integral_congr_ae\n          exact (itoIntegralTerminal_stop_ae eta hT tau htau htauT hB hUsual).symm\n    _ = 0 := hterminalMean\n\nend BoundedStoppedItoMean\nend StochasticProcesses\nend TechnicalLemmas\nend AutoSamplingTheory\n",
        "toolchain": "302cd63c54178885b89e669f33b38f12f4dd7ae7e5cac537b3203e3768d8fb2b",
        "dependencies": "b83ca83b9cf7caa85fa8b023c2ff9a3fb7a7cce7e1c332e810c348535ec49c37",
        "source": {
          "url": "https://github.com/DakeBU/Automization-Sampling-Optimisation-Geometry-Lib/blob/2fdbd600d7fe4731458dc7cde2184fd4fdaf7e02/AutoSamplingTheory/TechnicalLemmas/StochasticProcesses/RandomStoppingGeneralIto.lean",
          "edition": "Samplinglib main, commit 2fdbd600d7fe4731458dc7cde2184fd4fdaf7e02, with pinned Mathlib 4.33.0",
          "anchor": "RandomStoppingGeneralIto.itoIntegralTerminal_stop_ae and ItoIntegralProcess martingale interface",
          "wording_status": "faithful paraphrase",
          "attribution": "Samplinglib packages the standard bounded stopped-Ito integrability and zero-mean consequences of its constructed completed process."
        },
        "statement": "For a progressive square-integrable real integrand on a positive finite horizon, evaluating its completed continuous Ito process at a nonnegative stopping time bounded pointwise by the horizon gives an integrable random variable of expectation zero.",
        "formulae": [
          {
            "label": "stopped-integrand identity",
            "tex": "\\int_0^T\\eta_s\\mathbf 1_{s\\le\\tau}\\,dB_s=\\int_0^\\tau\\eta_s\\,dB_s\\quad\\text{a.s.}"
          },
          {
            "label": "integrability and centering",
            "tex": "I_\\tau\\in L^1,\\qquad \\mathbb E[I_\\tau]=0"
          }
        ],
        "assumptions": [
          "A progressive L2 integrand on a positive NNReal horizon T.",
          "A Brownian motion relative to the filtration and ambient measure, and the usual filtration conditions.",
          "An NNReal-valued stopping time tau with tau(omega)≤T for every omega.",
          "An ambient finite-measure instance, already entailed by the Brownian probability contract and used by the completed-process API."
        ],
        "obligations": [
          {
            "id": "bounded-stopped-ito-integrability",
            "label": "Transfer terminal L2 integrability to bounded random-time evaluation"
          },
          {
            "id": "bounded-stopped-ito-mean-zero",
            "label": "Derive zero expectation from the stopped-integrand martingale and random-stopping identity"
          }
        ],
        "lesson": {
          "declaration": "AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.BoundedStoppedItoMean.integral_itoIntegralProcess_at_boundedStopping_eq_zero",
          "kind": "theorem",
          "title": "A completed Ito process has mean zero at a bounded stopping time",
          "statement": "Under the same global L2, Brownian, usual-filtration, stopping-time, and pointwise horizon-bound assumptions, the integral of the completed Ito process evaluated at tau is zero.",
          "formula": "\\mathbb E\\left[\\int_0^\\tau\\eta_s\\,dB_s\\right]=0.",
          "assumptions": [
            "eta is a Samplinglib ProgressiveL2Integrand on a positive NNReal horizon T.",
            "B is Brownian with respect to the filtration and measure, and the filtration satisfies the usual conditions.",
            "tau is an NNReal-valued stopping time with tau(omega)≤T for every omega.",
            "The theorem concerns the library's actual completed continuous Ito process, not an arbitrary process supplied together with a martingale premise."
          ],
          "steps": [
            {
              "title": "Use the stopped-integrand martingale",
              "text": "The completed Ito process of the stopped integrand is a martingale and starts exactly at zero, including on the patched exceptional set.",
              "formula": "J_t=\\int_0^t\\eta_s\\mathbf 1_{s\\le\\tau}\\,dB_s,\\qquad J_0=0.",
              "lean": "Use itoIntegralProcess_martingale and itoIntegralProcess_at_zero."
            },
            {
              "title": "Compare deterministic times zero and T",
              "text": "The martingale set-integral identity on the whole sample space makes the expectation at T equal the expectation at zero, hence zero.",
              "formula": "\\mathbb E[J_T]=\\mathbb E[J_0]=0.",
              "lean": "Use Martingale.setIntegral_eq with the universal measurable set."
            },
            {
              "title": "Transfer to the bounded stopping time",
              "text": "The terminal representative agrees almost everywhere both with J_T and with the original completed process I evaluated at tau. Integral congruence transfers the zero expectation.",
              "formula": "J_T=\\int_0^T\\eta_s\\mathbf 1_{s\\le\\tau}\\,dB_s=I_\\tau\\quad\\text{a.s.}",
              "lean": "Use terminalRepresentative_ae_eq_actual, itoIntegralTerminal_stop_ae, and integral_congr_ae."
            }
          ],
          "astis_dependencies": [
            "AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.ItoIntegralProcess.itoIntegralProcess_martingale",
            "AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.ItoIntegralProcess.itoIntegralProcess_at_zero",
            "AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.ItoIntegralProcess.terminalRepresentative_ae_eq_actual",
            "AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.RandomStoppingGeneralIto.itoIntegralTerminal_stop_ae"
          ],
          "mathlib_dependencies": [
            "MeasureTheory.Martingale.setIntegral_eq",
            "MeasureTheory.integral_congr_ae"
          ],
          "lean_statement": "The conclusion is the literal Bochner integral equality for random-time evaluation of the constructed completed Ito process.",
          "lean_proof": "The proof applies deterministic-time preservation of martingale expectation to the stopped integrand and then rewrites the terminal value using the two existing almost-everywhere consistency theorems.",
          "sources": [
            {
              "url": "https://github.com/DakeBU/Automization-Sampling-Optimisation-Geometry-Lib/blob/2fdbd600d7fe4731458dc7cde2184fd4fdaf7e02/AutoSamplingTheory/TechnicalLemmas/StochasticProcesses/RandomStoppingGeneralIto.lean",
              "label": "Samplinglib completed bounded random-stopping identity",
              "scope": "The completed stochastic-integral consistency result used after the martingale mean calculation."
            },
            {
              "url": "https://github.com/leanprover-community/mathlib4/blob/cb7b1080879fe662f5b103a59f612c4930290ea1/Mathlib/Probability/Martingale/Basic.lean",
              "label": "Mathlib martingale set-integral identity",
              "scope": "Equality of martingale integrals at ordered deterministic times."
            }
          ],
          "tests": [
            "Lean 4.33.0: lake build AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.BoundedStoppedItoMean",
            "Lean 4.33.0: lake env lean Tests/BoundedStoppedItoMean.lean"
          ]
        },
        "binding": {
