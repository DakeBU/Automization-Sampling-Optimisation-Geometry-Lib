{
  "schema_version": 1,
  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.ExampleCases.ProximalBPS.MacroscopicRange.actual_macroscopic_centered_range",
      "title": "Actual PBPS macroscopic range and centering",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06905v1#A2",
          "label": "PBPS2609.06905v1 AppendixB B1-B5 exact macro identification/centering feeding C3-C4 and B15. Public actual canonical pullback range=P range and centered image equality; real new Test transports exact57 scalar contraction to all actual centered macro f and squared defect gap.",
          "scope": "PBPS2609.06905v1 AppendixB B1-B5 exact macro identification/centering feeding C3-C4 and B15. Public actual canonical pullback range=P range and centered image equality; real new Test transports exact57 scalar contraction to all actual centered macro f and squared defect gap. Finite real Hilbert/Borel/rank0 explicit extension; trueL2 generally infinite dimensional. Public generic pullback range and actual PBPS range/mean/centered image; realTest-only allmacro contraction/squaredBgap. NoGamma/fullweakH1/B13/B14/dynamics/main/cost/composition/fullpaper/Goal claim."
        }
      ],
      "tests": [
        "lake build Tests.ProximalBPSMacroscopicRange"
      ],
      "assumptions": [
        "Let E be a finite-dimensional real Hilbert Borel space with canonical volume, including rank zero as an explicit extension of the source Euclidean setting. Let V:E→ℝ be C2, 0<α≤β, and α‖v‖²≤D²V(x)[v,v]≤β‖v‖² for all x,v. Let η>0 and βη≤1. Set μ=volume.tilted(−V), J=Law(X,X+√ηZ) for independent X∼μ,Z∼N(0,I), ν=J.snd. Let P be the actual conditional-expectation orthogonal projection onto the second-coordinate sigma algebra in L²(J). ",
        "Centering and macro range restrict the conclusion input; no supplied operator/law/onto/root certificate.",
        "Base finite dimension does not imply finite-dimensional L2; rank zero is explicitly extended."
      ],
      "statement": "Let E be a finite-dimensional real Hilbert Borel space with canonical volume, including rank zero as an explicit extension of the source Euclidean setting. Let V:E→ℝ be C2, 0<α≤β, and α‖v‖²≤D²V(x)[v,v]≤β‖v‖² for all x,v. Let η>0 and βη≤1. Set μ=volume.tilted(−V), J=Law(X,X+√ηZ) for independent X∼μ,Z∼N(0,I), ν=J.snd. Let P be the actual conditional-expectation orthogonal projection onto the second-coordinate sigma algebra in L²(J). For the canonical isometric pullback M u(x,y)=u(y), both J and ν are probabilities, ran M=ran P, and ∫Mu dJ=∫u dν for every u∈L²(ν). Consequently M maps the full zero-mean subspace of L²(ν) onto exactly {f∈ran P:∫f dJ=0}. No caller onto, centering, probability or law certificate is assumed.",
      "formula": "\\operatorname{ran}M=\\operatorname{ran}P,\\quad\\int Mu\\,dJ=\\int u\\,d\\nu,\\quad M(L^2_0(\\nu))=\\operatorname{ran}P\\cap L^2_0(J).",
      "boundary": "PBPS2609.06905v1 AppendixB B1-B5 exact macro identification/centering feeding C3-C4 and B15. Public actual canonical pullback range=P range and centered image equality; real new Test transports exact57 scalar contraction to all actual centered macro f and squared defect gap. Finite real Hilbert/Borel/rank0 explicit extension; trueL2 generally infinite dimensional. Public generic pullback range and actual PBPS range/mean/centered image; realTest-only allmacro contraction/squaredBgap. NoGamma/fullweakH1/B13/B14/dynamics/main/cost/composition/fullpaper/Goal claim.",
      "steps": [
        {
          "title": "Produce the actual probabilities",
          "text": "The existing normalized Gibbs augmentation theorem under the original lower curvature and positive η produces probability μ and J internally. The true second marginal ν is therefore probability; no normalization certificate is a premise.",
          "formula": "J=\\operatorname{Law}(X,X+\\sqrt\\eta Z),\\quad J(E\\times E)=\\nu(E)=1.",
          "lean": "GibbsAugmentation.normalized_augmentation_density; hJ; hν"
        },
        {
          "title": "Identify both ranges with the same closed subspace",
          "text": "Apply the shared exact pullback-range theorem to the actual measure-preserving second projection. The actual conditional expectation is definitionally the Hilbert orthogonal projection onto that same lpMeas submodule, whose range equals the submodule.",
          "formula": "\\operatorname{ran}M=L^2(\\sigma(Y),J)=\\operatorname{ran}P.",
          "lean": "L2PullbackRange.l2_pullback_range_eq_lpMeas; hPdef; S.range_starProjection; hRange"
        },
        {
          "title": "Transport the actual mean",
          "text": "The canonical pullback agrees AE with u∘snd. Integration against the true pushforward ν=J.snd gives ∫Mu dJ=∫u dν. L2 functions are L1 here because J and ν are probabilities; no injectivity or embedding of snd is assumed.",
          "formula": "\\int Mu\\,dJ=\\int u(Y)\\,dJ=\\int u\\,d\\nu.",
          "lean": "Lp.coeFn_compMeasurePreserving; integral_congr_ae; integral_map; hMean"
        },
        {
          "title": "Obtain the full centered image",
          "text": "Forward range membership and mean transport send every centered u to a centered macro class. Conversely, every centered f in ranP lies in ranM; choosing its actual preimage and applying mean transport proves that preimage centered. Thus the equality is onto the entire centered macro subspace.",
          "formula": "M(L^2_0(\\nu))=\\{f\\in\\operatorname{ran}P:\\int f\\,dJ=0\\}.",
          "lean": "hRange; hMean; ext f; centered-image forward/reverse proof"
        }
      ],
      "lean_statement": "Let E be a finite-dimensional real Hilbert Borel space with canonical volume, including rank zero as an explicit extension of the source Euclidean setting. Let V:E→ℝ be C2, 0<α≤β, and α‖v‖²≤D²V(x)[v,v]≤β‖v‖² for all x,v. Let η>0 and βη≤1. Set μ=volume.tilted(−V), J=Law(X,X+√ηZ) for independent X∼μ,Z∼N(0,I), ν=J.snd. Let P be the actual conditional-expectation orthogonal projection onto the second-coordinate sigma algebra in L²(J). For the canonical isometric pullback M u(x,y)=u(y), both J and ν are probabilities, ran M=ran P, and ∫Mu dJ=∫u dν for every u∈L²(ν). Consequently M maps the full zero-mean subspace of L²(ν) onto exactly {f∈ran P:∫f dJ=0}. No caller onto, centering, probability or law certificate is assumed.",
      "lean_proof": "Produce the actual probabilities; Identify both ranges with the same closed subspace; Transport the actual mean; Obtain the full centered image",
      "astis_dependencies": [
        "AutoSamplingTheory.TechnicalLemmas.Measure.L2PullbackRange.l2_pullback_range_eq_lpMeas",
        "AutoSamplingTheory.ExampleCases.ProximalBPS.GibbsAugmentation.normalized_augmentation_density"
      ],
      "mathlib_dependencies": [
        "Submodule.range_starProjection",
        "integral_map",
        "integral_congr_ae",
        "Lp.coeFn_compMeasurePreserving"
      ]
    }
  ]
}
