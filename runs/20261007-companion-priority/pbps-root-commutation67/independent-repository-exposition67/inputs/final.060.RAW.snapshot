      "targetText": "2. Lift square commutationApply the real identity separately to real and imaginary parts and use complex linearity;this proves equality of full complex operators.G2D=DG2⇒GC2DC=DCGC2.Corresponding Lean step  have hReal (u : Lp ℝ 2 μ) : G (G (D u)) = D (G (G u)) :=\n    congrArg (fun A : Lp ℝ 2 μ →L[ℝ] Lp ℝ 2 μ => A u) hCommute.eq\n  have hComplex : Commute (Gc*Gc) Dc := by\n    apply ContinuousLinearMap.ext\n    intro g\n    change Gc (Gc (Dc g)) = Dc (Gc (Gc g))\n    calc\n      Gc (Gc (Dc g)) = ι (G (G (D (R g)))) + Complex.I • ι (G (G (D (Q g)))) := by\n        rw [hDf g, map_add, map_smul, hGi, hGi, map_add, map_smul, hGi, hGi]\n      _ = ι (D (G (G (R g)))) + Complex.I • ι (D (G (G (Q g)))) := by\n        rw [hReal (R g),hReal (Q g)]\n      _ = Dc (Gc (Gc g)) := by\n        rw [hGf g,map_add,map_s",
      "bodyVisibility": "visible",
      "bodyDisplay": "block",
      "closedLeanDetails": 1,
      "mathContainers": 1,
