{
  "schema_version": 1,
  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.ExampleCases.ProximalBPS.L2MacroscopicMean.actual_macroscopic_l2_mean",
      "title": "The actual PBPS conditional mean on all of L2",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06905v1#A2.SS1",
          "label": "PBPS2609.06905v1 Appendix B.1 real conditional projection/reflection blocks and B.9 variance identity; actual all-L2 mean bridge needed before full rough B.13. Source C2 potential, both Hessian bounds and capped positive step retained.",
          "scope": "One actual canonical snd pullback M and bounded conditional mean T are chosen before every rough L2 input under the SAME Gibbs/Gaussian laws. PM=M, MT=AM, true AE source-S mean, contraction, AE fiber L1/squareL1 and integrated variance=||BMu||²=||u||²-||Tu||² are proved internally. Original C2/two-sided Hessian/capped step retained; finite Hilbert/Borel/rank0 explicitly extends the source Euclidean setting. No every-y rough integrability/C1, gradient/H1/B13, Gamma/dynamics/main/errors/unbounded-cost or actual-input composition claim."
        }
      ],
      "tests": [
        "lake build Tests.ProximalBPSL2MacroscopicMean"
      ],
      "assumptions": [
        "Finite real Hilbert/Borel E and canonical volume; rank zero is an explicit extension of the source Euclidean presentation.",
        "V is C2; α,β≥0, α>0, α≤β, both global Hessian bounds; η>0 and βη≤1.",
        "Every u is an arbitrary real square-integrable AE class under the actual ν. No centering, compact support, extra moment, pointwise smoothness or caller normalization/operator/domain certificate.",
        "One genuine S,U,M,T is produced uniformly before u. Every-y normalized source law differs from AE ν fiber integrability and mean equality."
      ],
      "statement": "Let E be a finite-dimensional real Hilbert Borel space with canonical volume, including rank zero. Let V:E→ℝ be C2 and 0<α≤β, with α‖v‖²≤D²V(x)[v,v]≤β‖v‖² for all x,v. Let η>0 and βη≤1. Define μ=volume.tilted(−V), J=law(X,X+√ηZ) for independent X∼μ and Z∼N(0,I), ν=J.snd, Λ=J.map((x,y)↦(y,2x−y)), F(x,y)=(x,2x−y), and P the actual L2 conditional orthogonal projection onto the snd-comap measurable subspace. Then μ,J,ν are probabilities; one measurable Markov kernel S has EVERY-y identity S_y=volume.tilted(x↦−V((y+x)/2)−‖y−x‖²/(8η)), disintegrates Λ, and Λ.fst=Λ.snd=ν. There are an actual J-reflection isometric involution/self-adjoint U, one linear isometry M:L²(ν)→L²(J) representing the snd pullback AE J, and one bounded linear T:L²(ν)→L²(ν), all chosen before every rough u∈L²(ν). With A=PUP and B=(1−P)UP, PMu=Mu, MTu=AMu, ‖Tu‖≤‖u‖, and Tu(y)=∫u(x)S_y(dx) AE ν. For AE y both u and u² are integrable under S_y; the centered source variance is integrable under ν and ∫Var(S_y,u)ν(dy)=‖BMu‖²=‖u‖²−‖Tu‖². No centering, compactness, caller law/kernel/operator/coherence/normalizer certificate, or pointwise rough regularity is assumed. This is attributed background integration for B.1/B.9, not the full rough gradient B.13 or a main sampling theorem.",
      "formula": "\\forall u\\in L^2(\\nu):\\quad PMu=Mu,\\quad MTu=AMu,\\quad Tu(y)=\\int u(x)S_y(dx)\\ (\\nu\\text{-a.e.}),\\quad\\|Tu\\|\\le\\|u\\|,\\qquad\\int\\operatorname{Var}_{S_y}(u)\\,\\nu(dy)=\\|BMu\\|^2=\\|u\\|^2-\\|Tu\\|^2.",
      "boundary": "One actual canonical snd pullback M and bounded conditional mean T are chosen before every rough L2 input under the SAME Gibbs/Gaussian laws. PM=M, MT=AM, true AE source-S mean, contraction, AE fiber L1/squareL1 and integrated variance=||BMu||²=||u||²-||Tu||² are proved internally. Original C2/two-sided Hessian/capped step retained; finite Hilbert/Borel/rank0 explicitly extends the source Euclidean setting. No every-y rough integrability/C1, gradient/H1/B13, Gamma/dynamics/main/errors/unbounded-cost or actual-input composition claim.",
      "steps": [
        {
          "title": "Use the same laws and the actual second-coordinate pullback",
          "text": "The existing macroscopic-energy theorem supplies μ,J,ν probability and genuine S,U,P on the exact source laws, including literal every-y S identity and compact-observer coherence. Since ν=J.snd, snd is measure preserving from J to ν. Mathlib constructs its canonical linear isometry M and the AE pullback representative. This is an actual map between full L2 spaces, not a finite-dimensional Lp assumption.",
          "formula": "\\nu=J_2,\\qquad M:L^2(\\nu)\\hookrightarrow L^2(J),\\qquad Mu=u\\circ\\mathrm{snd}\\ (J\\text{-a.e.}),\\quad\\|Mu\\|=\\|u\\|.",
          "lean": "MacroscopicEnergy.actual_macroscopic_gradient_energy_blocks; Lp.compMeasurePreservingₗᵢ; hM"
        },
        {
          "title": "Pass the true compact coherence to all L2 inputs",
          "text": "The existing actual Gaussian-marginal gradient core has dense smoothcompact domain. For its compact representative f, the real macroscopic parent supplies g=f∘snd, Pg=g and Ag=(Tf)∘snd, with Tf genuinely L2. Canonical AE uniqueness gives Mu=g and AMu=M[Tf]. The isometry has closed range because L2 is complete. PM=M is a closed equality and AMu∈rangeM a closed preimage; density extends both properties to every u.",
          "formula": "\\overline{\\operatorname{dom}G}=L^2(\\nu),\\quad\\operatorname{range}M\\text{ closed};\\qquad PM=M,\\quad AMu\\in\\operatorname{range}M\\ (\\forall u).",
          "lean": "GaussianMarginalGradient.gaussian_marginal_gradient_closable; hCore; Dense.induction; M.isometry.isClosedEmbedding; hPM; hAM"
        },
        {
          "title": "Construct one bounded operator by the closed-range inverse",
          "text": "Restrict A∘M to the true range of M, then apply the inverse of M.equivRange. This constructs T before u and proves MT=AM. The actual conditional projection is contractive and reflection is an isometry, so ‖Tu‖=‖AMu‖=‖PU Mu‖≤‖u‖. No inverse or coherence certificate is supplied by a caller.",
          "formula": "T=M_{\\operatorname{range}}^{-1}\\circ(A\\circ M),\\qquad MT=AM,\\qquad\\|Tu\\|=\\|PUMu\\|\\le\\|UMu\\|=\\|u\\|.",
          "lean": "ContinuousLinearMap.codRestrict; M.equivRange.symm; T; hMT; norm_condExpL2_coe_le; hTn"
        },
        {
          "title": "Identify the literal source conditional integral and its AE fibers",
          "text": "Gaussian reflection preserves J, hence the true Λ has both marginals ν and S leaves ν invariant. The genuine posterior producer supplies an actual disintegration R0, whose every-y tilt agrees with the R1 in the real ReflectionL2 projection formula. Conditional-kernel uniqueness identifies it with the R from the same S producer AE ν. Actual UMu=u(2x−y) AE J transfers to conditional R fibers after the swap, and S_y=R_y.map(x↦2x−y) turns the P kernel formula into Tu=∫u dS_y AE ν. Stationarity and global u,u² integrability give only AE fiber integrability, as required for rough inputs.",
          "formula": "\\Lambda_1=\\Lambda_2=\\nu,\\quad S\\circ\\nu=\\nu,\\quad Tu(y)=\\int u(x)S_y(dx)\\ (\\nu\\text{-a.e.}),\\quad u,u^2\\in L^1(S_y)\\ (\\nu\\text{-a.e.}).",
          "lean": "GaussianReflection.reflection_preserves_augmentation; GaussianConditionalKernel.exists_tilted_isCondKernel; ReflectionL2.actual_reflection_block_identities; hR₀R; hSource; hfs"
        },
        {
          "title": "Use Fubini and the actual orthogonal block defect",
          "text": "AE square integrability supplies the real fiber variance identity Var(S_y,u)=∫u²dS_y−(Tu(y))². Stationarity and Fubini yield the first integrated second moment ∫u²dν; bounded T yields integrability of its square. Therefore the integrated variance is ‖u‖²−‖Tu‖². The genuine joint-L2 parent block identity applied to PMu=Mu identifies exactly the same quantity with ‖BMu‖². No expectation of an unbounded algorithmic cost is inferred.",
          "formula": "\\int\\operatorname{Var}_{S_y}(u)\\,\\nu(dy)=\\int u^2\\,d\\nu-\\int(Tu)^2\\,d\\nu=\\|u\\|^2-\\|Tu\\|^2=\\|BMu\\|^2.",
          "lean": "variance_eq_integral; variance_eq_sub; Measure.integral_compProd; hvarEq; hsecond; L2.inner_def; hDef; hvarDef"
        },
        {
          "title": "Exercise rough differences and a noncentered constant",
          "text": "The genuine Test applies the same bounded T to arbitrary u−v in L2, obtaining ‖Tu−Tv‖≤‖u−v‖, the exact variance defect, and its nonnegative bound by ‖u−v‖². The difference is explicitly an Lp class before selecting a representative, to avoid silently replacing it by a pointwise subtraction. The actual source-rank0 constant1 is fixed by T and has integrated variance0. The first coercion failure and actual correction are retained.",
          "formula": "\\|Tu-Tv\\|\\le\\|u-v\\|,\\quad0\\le\\int\\operatorname{Var}_{S_y}(u-v)\\,\\nu(dy)=\\|u-v\\|^2-\\|Tu-Tv\\|^2\\le\\|u-v\\|^2;\\qquad d=0:\\ T[1]=[1],\\quad\\int\\operatorname{Var}_{S_y}([1])\\,d\\nu=0.",
          "lean": "Tests.ProximalBPSL2MacroscopicMean.actual_rough_difference_variance; rank_zero_actual_source_constant"
        }
      ],
      "lean_statement": "Let E be a finite-dimensional real Hilbert Borel space with canonical volume, including rank zero. Let V:E→ℝ be C2 and 0<α≤β, with α‖v‖²≤D²V(x)[v,v]≤β‖v‖² for all x,v. Let η>0 and βη≤1. Define μ=volume.tilted(−V), J=law(X,X+√ηZ) for independent X∼μ and Z∼N(0,I), ν=J.snd, Λ=J.map((x,y)↦(y,2x−y)), F(x,y)=(x,2x−y), and P the actual L2 conditional orthogonal projection onto the snd-comap measurable subspace. Then μ,J,ν are probabilities; one measurable Markov kernel S has EVERY-y identity S_y=volume.tilted(x↦−V((y+x)/2)−‖y−x‖²/(8η)), disintegrates Λ, and Λ.fst=Λ.snd=ν. There are an actual J-reflection isometric involution/self-adjoint U, one linear isometry M:L²(ν)→L²(J) representing the snd pullback AE J, and one bounded linear T:L²(ν)→L²(ν), all chosen before every rough u∈L²(ν). With A=PUP and B=(1−P)UP, PMu=Mu, MTu=AMu, ‖Tu‖≤‖u‖, and Tu(y)=∫u(x)S_y(dx) AE ν. For AE y both u and u² are integrable under S_y; the centered source variance is integrable under ν and ∫Var(S_y,u)ν(dy)=‖BMu‖²=‖u‖²−‖Tu‖². No centering, compactness, caller law/kernel/operator/coherence/normalizer certificate, or pointwise rough regularity is assumed. This is attributed background integration for B.1/B.9, not the full rough gradient B.13 or a main sampling theorem.",
      "lean_proof": "Use the same laws and the actual second-coordinate pullback; Pass the true compact coherence to all L2 inputs; Construct one bounded operator by the closed-range inverse; Identify the literal source conditional integral and its AE fibers; Use Fubini and the actual orthogonal block defect; Exercise rough differences and a noncentered constant",
      "astis_dependencies": [
        "AutoSamplingTheory.ExampleCases.ProximalBPS.MacroscopicEnergy.actual_macroscopic_gradient_energy_blocks",
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.GaussianMarginalGradient.gaussian_marginal_gradient_closable",
        "AutoSamplingTheory.ExampleCases.ProximalBPS.ReflectionL2.actual_reflection_block_identities",
        "AutoSamplingTheory.ExampleCases.ProximalBPS.GaussianReflection.reflection_preserves_augmentation",
        "AutoSamplingTheory.TechnicalLemmas.Probability.GaussianConditionalKernel.exists_tilted_isCondKernel"
      ],
      "mathlib_dependencies": [
        "Lp.compMeasurePreservingₗᵢ",
        "Lp.coeFn_compMeasurePreserving",
        "Dense.induction",
        "LinearIsometry.equivRange",
        "ContinuousLinearMap.codRestrict",
        "norm_condExpL2_coe_le",
        "Measure.integral_compProd",
        "variance_eq_sub"
      ]
    }
  ]
}
