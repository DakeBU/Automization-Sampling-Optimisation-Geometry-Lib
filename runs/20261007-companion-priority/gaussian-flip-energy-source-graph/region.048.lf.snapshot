/-- The `a⁺` function on the product space. -/
def aPlusProd (i : Fin n) (x : RademacherSpace n) : ℝ :=
  rademacherSumProd n x + (1 - x i) / Real.sqrt n

/-- The `a⁻` function on the product space. -/
def aMinusProd (i : Fin n) (x : RademacherSpace n) : ℝ :=
  rademacherSumProd n x - (1 + x i) / Real.sqrt n
