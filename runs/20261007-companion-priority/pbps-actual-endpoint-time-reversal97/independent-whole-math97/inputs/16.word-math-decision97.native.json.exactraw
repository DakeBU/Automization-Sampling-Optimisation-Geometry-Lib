    "producer": "AutoSamplingTheory.ExampleCases.ProximalBPS.ActualPhaseReversalVolume.actual_phase_reversal_volume_laws",
    "inverse_projection": "Use the Phi(u)(Phi(-u)z)=z component of the existing two-sided inverse pair.",
    "endpoint_bridge": "ActualEndpoint97 final-arc equality plus literal post=zAt identifies this defined endpoint with actual Gamma(T).",
