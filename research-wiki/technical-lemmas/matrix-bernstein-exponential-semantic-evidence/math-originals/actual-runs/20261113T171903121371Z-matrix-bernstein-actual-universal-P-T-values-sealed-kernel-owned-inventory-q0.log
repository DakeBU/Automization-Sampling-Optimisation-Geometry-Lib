'ActualBernsteinProducerSealedKernelCheck' depends on axioms: [propext, Classical.choice, Quot.sound]
'ActualBernsteinConsumerSealedKernelCheck' depends on axioms: [propext, Classical.choice, Quot.sound]
fun d hd => ActualBernsteinConsumerSealedKernelCheck hd : ∀ (d : ℕ),
  1 < d →
    let D := EuclideanSpace ℝ (Fin d);
    let E := EuclideanSpace ℝ (Fin (0 + 1));
    let Ω := Fin (0 + 1) → D;
    have μ := Measure.pi fun x => stdGaussian D;
    have r := ↑(0 + 1);
    have L := 2 * r + 3 * Real.log (1000 * ↑d);
    have θ := fun i => (↑↑i + 1 - 1 / 2) * Real.pi / ↑d;
    have t := fun i k => if ↑k = 0 then 1 else √2 * Real.cos (↑↑k * θ i);
    have row := fun i ω => WithLp.toLp 2 fun b => (ω b).ofLp i;
    have Y := fun i ω =>
      if ‖row i ω‖ ^ 2 ≤ L then
        (↑d)⁻¹ • (Matrix.vecMulVec (row i ω).ofLp (row i ω).ofLp).kronecker (Matrix.vecMulVec (t i) (t i))
      else 0;
    have mean := fun i => ∫ (ω : Ω), Y i ω ∂μ;
    have Z := fun i ω => Y i ω - mean i;
    have ρ := 2 * r * (L + 1) / ↑d;
    have X := fun i ω => ρ⁻¹ • Z i ω;
    ∀ (s : ℝ),
      0 < s →
        ∀ (i : Fin d),
          (NormedSpace.exp ((Real.exp s - s - 1) • ∫ (ω : Ω), X i ω * X i ω ∂μ) -
              ∫ (ω : Ω), NormedSpace.exp (s • X i ω) ∂μ).PosSemidef
ActualBernsteinConsumerSealedKernelCheck (of_decide_eq_true (id (Eq.refl true))) : let D := EuclideanSpace ℝ (Fin 2);
let E := EuclideanSpace ℝ (Fin (0 + 1));
let Ω := Fin (0 + 1) → D;
have μ := Measure.pi fun x => stdGaussian D;
have r := ↑(0 + 1);
have L := 2 * r + 3 * Real.log (1000 * ↑2);
have θ := fun i => (↑↑i + 1 - 1 / 2) * Real.pi / ↑2;
have t := fun i k => if ↑k = 0 then 1 else √2 * Real.cos (↑↑k * θ i);
have row := fun i ω => WithLp.toLp 2 fun b => (ω b).ofLp i;
have Y := fun i ω =>
  if ‖row i ω‖ ^ 2 ≤ L then
    (↑2)⁻¹ • (Matrix.vecMulVec (row i ω).ofLp (row i ω).ofLp).kronecker (Matrix.vecMulVec (t i) (t i))
  else 0;
have mean := fun i => ∫ (ω : Ω), Y i ω ∂μ;
have Z := fun i ω => Y i ω - mean i;
have ρ := 2 * r * (L + 1) / ↑2;
have X := fun i ω => ρ⁻¹ • Z i ω;
∀ (s : ℝ),
  0 < s →
    ∀ (i : Fin 2),
      (NormedSpace.exp ((Real.exp s - s - 1) • ∫ (ω : Ω), X i ω * X i ω ∂μ) -
          ∫ (ω : Ω), NormedSpace.exp (s • X i ω) ∂μ).PosSemidef
