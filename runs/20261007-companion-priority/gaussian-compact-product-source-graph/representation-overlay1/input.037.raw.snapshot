  "schema_version": 1,
  "seven_semantic_slots": {
    "assumptions": "Only n,f,hf:C2,hs:compact; standard real finite-dimensional classes instantiated by carrier rather than extra premises. No EXCESS.",
    "conclusion": "Four L1 conjunctions and integralPhi(f²)-Phi(integral f²)<=2 integral sum_i(D_i)².",
    "constant_dependencies": "Exactly variance1/coefficient2, dimension free; no normalizationf/positivity or dimension restriction; fullsum vs norm distinction literal.",
    "domains": "All four genuine real Bochner L1 assertions output; f²/Phi square and derivative squares on gamma.",
    "objects": "Literal finite coordinate product gamma and actual signed f/D.",
    "quantifiers": "Every n including0 and every C2compact f; all i partial domains, one fullsum domain.",
    "scopes": "Authored compact finite-coordinate GaussianLSI sufficient prerequisite; external unbounded W12, Hilbert/noncompact/T2/paper FIRST excluded."
  },
  "signature_bytes": 678,
  "signature_lf_sha256": "fc859f057a9242675d2a769fa3b2dbbd7b66764fdbe429f608decf0018511d50",
  "signature_raw_sha256": "fc859f057a9242675d2a769fa3b2dbbd7b66764fdbe429f608decf0018511d50",
  "signature_text": "theorem compact_gaussian_pi_logSobolev\n    (n : ℕ) (f : (Fin n → ℝ) → ℝ)\n    (hf : ContDiff ℝ 2 f) (hs : HasCompactSupport f) :\n    let γ : Measure (Fin n → ℝ) := Measure.pi (fun _ : Fin n => gaussianReal 0 1)\n    let D : Fin n → (Fin n → ℝ) → ℝ := fun i x => fderiv ℝ f x (Pi.single i 1)\n    Integrable (fun x => (f x)^2) γ ∧\n    Integrable (fun x => (f x)^2 * Real.log ((f x)^2)) γ ∧\n    (∀ i, Integrable (fun x => (D i x)^2) γ) ∧\n    Integrable (fun x => ∑ i, (D i x)^2) γ ∧\n    (∫ x, (f x)^2 * Real.log ((f x)^2) ∂γ) -\n      (∫ x, (f x)^2 ∂γ) * Real.log (∫ x, (f x)^2 ∂γ) ≤\n    2 * ∫ x, ∑ i, (D i x)^2 ∂γ\n",
  "source_excess": [],
  "source_excess_count": 0,
  "source_hypothesis_binder_truth": "C2+compact is explicitly authored sufficient class; no claim to source full W12 or printed theorem. Source ingredients stay required internal producer edges, not added public certificate premises.",
