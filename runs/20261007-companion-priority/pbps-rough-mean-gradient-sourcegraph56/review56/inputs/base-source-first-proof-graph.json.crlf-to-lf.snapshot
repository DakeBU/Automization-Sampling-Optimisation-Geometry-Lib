  "nodes": [
    {
      "id": "pbps:standing-curvature",
      "kind": "STANDING",
      "mathematics": "V in C2(R^d), 0<alpha<=beta, alpha I<=Hess V<=beta I everywhere; eta in (0,1/beta]",
      "source_anchors": [
        "S1.p1",
        "S1.E1",
        "S2.SS2.p1.1"
      ],
      "compiled_truth": false
    },
    {
      "id": "pbps:joint-and-marginal",
      "kind": "SOURCE_DEFINITION",
      "mathematics": "pi_eta(dx dy) proportional exp(-V(x)-|x-y|²/(2eta)); X~mu, independent Z~N(0,I), Y+=X+sqrt(eta)Z; nu=pi_eta^Y",
      "source_anchors": [
        "S2.E6",
        "S2.E7",
        "S2.SS2.p1.3"
      ],
      "compiled_truth": false
    },
    {
      "id": "pbps:conditional-kernel",
      "kind": "SOURCE_DEFINITION",
      "mathematics": "p_y is actual law of Y- given Y+=y; p_y(u) proportional exp(-V((y+u)/2)-|y-u|²/(8eta))",
      "source_anchors": [
        "A2.E8",
        "A3.Ex1"
      ],
      "compiled_truth": false
    },
    {
      "id": "pbps:actual-conditional-mean",
      "kind": "SOURCE_DEFINITION",
      "mathematics": "T=U_PP=PUP identified with L2(nu); Tf(y)=E[f(Y-)|Y+=y], P is actual conditional expectation, not arbitrary linear function",
      "source_anchors": [
        "A2.E1",
        "A2.E3",
        "A2.E4",
        "A2.E9"
      ],
      "compiled_truth": false
    },
    {
      "id": "pbps:actual-conditional-variance",
      "kind": "SUBSTANTIVE_STEP",
      "mathematics": "Vf(y)=Var(f(Y-)|Y+=y), integral Vf dnu=|U_perpP f|²; exchangeable Y± share marginal nu",
      "source_anchors": [
        "A2.SS2.p2.2",
        "A2.E9"
      ],
      "compiled_truth": false
    },
    {
      "id": "pbps:normalized-density-derivative",
      "kind": "SUBSTANTIVE_STEP",
      "mathematics": "For compact smooth f, gradient Tf=Cov_p_y(f,s_y), s_y=-1/2 grad V((y+u)/2)-(y-u)/(4eta)",
      "source_anchors": [
        "A3.Ex2",
        "A3.E1"
      ],
      "compiled_truth": false
    },
    {
      "id": "pbps:conditional-curvature",
      "kind": "SUBSTANTIVE_STEP",
      "mathematics": "Hess_u(-log p_y)=1/4(Hess V((y+u)/2)+eta^-1 I)>= (alpha+eta^-1)I/4",
      "source_anchors": [
        "A3.Ex3"
      ],
      "compiled_truth": false
    },
    {
      "id": "external:strong-logconcave-poincare",
      "kind": "DEEP_EXTERNAL_BOUNDARY",
      "mathematics": "For normalized C2 density exp(-W), Hess W>=mI,m>0, Var_nu(h)<=m^-1 integral |grad h|²; domain/closure extension must be established, no compilation claim",
      "source_anchors": [
        "A4.E6",
        "S2.SS2.p3.1"
      ],
      "compiled_truth": false
    },
    {
      "id": "pbps:score-jacobian",
      "kind": "SUBSTANTIVE_STEP",
      "mathematics": "D_u s_y=(eta^-1 I-Hess V((y+u)/2))/4, op norm<= (eta^-1-alpha)/4 because beta eta<=1",
      "source_anchors": [
        "A3.Ex5"
      ],
      "compiled_truth": false
    },
    {
      "id": "pbps:score-variance",
      "kind": "SUBSTANTIVE_STEP",
      "mathematics": "For unit a, Var_p_y(a·s_y)<= (eta^-1-alpha)²/[4(alpha+eta^-1)]",
      "source_anchors": [
        "A3.EGx24",
        "A3.Ex6"
      ],
      "compiled_truth": false
    },
    {
      "id": "external:covariance-cauchy-schwarz",
      "kind": "DEEP_EXTERNAL_BOUNDARY",
      "mathematics": "Scalar-vector covariance bound via scalar Cauchy-Schwarz and unit-vector duality; finite square moments required and derived on this law",
      "source_anchors": [
        "A3.SS1.p3.5"
      ],
      "compiled_truth": false
    },
    {
      "id": "pbps:pointwise-gradient",
      "kind": "SUBSTANTIVE_STEP",
      "mathematics": "|grad Tf(y)|²<= [(eta^-1-alpha)²/(4(alpha+eta^-1))] Vf(y)",
      "source_anchors": [
        "A3.Ex7"
      ],
      "compiled_truth": false
    },
    {
      "id": "pbps:C2-smooth",
      "kind": "REUSED_DISPLAY",
      "mathematics": "eta |grad Tf|²<= [(1-alpha eta)²/(4(1+alpha eta))] integral Vf dnu for compact smooth f",
      "source_anchors": [
        "A3.SS1.p3.6",
        "A3.EGx25",
        "A2.E9"
      ],
      "compiled_truth": false
    },
    {
      "id": "external:weighted-smooth-density",
      "kind": "SOURCE_GAP_DEEP_EXTERNAL_BOUNDARY",
      "mathematics": "Choose compact smooth f_n -> f in L2(nu) for every f in L2(nu); exact weighted density theorem and nu regularity not expanded by author",
      "source_anchors": [
        "A3.SS1.p1.1"
      ],
      "compiled_truth": false
    },
    {
      "id": "external:conditional-expectation-contraction",
      "kind": "DEEP_EXTERNAL_BOUNDARY",
      "mathematics": "Actual mean T is L2 contraction by Jensen/disintegration and same Y± marginal; difference inputs remain on same law",
      "source_anchors": [
        "A2.E1",
        "A2.E9",
        "A2.SS2.p2.2"
      ],
      "compiled_truth": false
    },
    {
      "id": "pbps:gradient-cauchy",
      "kind": "UNNAMED_SOURCE_BRIDGE",
      "mathematics": "Apply smooth C.2 to f_n-f_m, variance integral<=|f_n-f_m|² to make grad Tf_n Cauchy in L2(nu;R^d); eta>0",
      "source_anchors": [
        "A3.SS1.p1.1",
        "A3.EGx25",
        "A2.E9"
      ],
      "compiled_truth": false
    },
    {
      "id": "external:weighted-closed-gradient",
      "kind": "SOURCE_GAP_DEEP_EXTERNAL_BOUNDARY",
      "mathematics": "Weak weighted gradient is closed: Tf_n -> Tf and gradients ->G in respective L2 spaces imply Tf in H1(nu), grad Tf=G. Author cites closedness without construction",
      "source_anchors": [
        "A3.SS1.p1.1"
      ],
      "compiled_truth": false
    },
    {
      "id": "pbps:C2-rough",
      "kind": "UNNAMED_SOURCE_BRIDGE",
      "mathematics": "Pass to limit in L2 gradient norms and variance energy; eta |grad Tf|²<=c integral Vf for every f in L2(nu); H1 regularity is output",
      "source_anchors": [
        "A3.SS1.p1.1",
        "A3.EGx25"
      ],
      "compiled_truth": false
    },
    {
      "id": "pbps:quarter-coefficient",
      "kind": "UNNAMED_SOURCE_BRIDGE",
      "mathematics": "0<alpha eta<=1 implies (1-alpha eta)²/(4(1+alpha eta))<=1/4; obtain 4eta |grad Tf|²<=integral Vf",
      "source_anchors": [
        "A2.Thmtheorem1.p1.1",
        "A3.SS1.p3.7",
        "A2.E13"
      ],
      "compiled_truth": false
    },
    {
      "id": "pbps:norm-defect",
      "kind": "SUBSTANTIVE_STEP",
      "mathematics": "integral Vf=|f|²-|Tf|² via actual conditional mean, total variance and same-law marginal; also |U_perpP f|² from B.9",
      "source_anchors": [
        "A2.E9",
        "A3.SS1.p3.7"
      ],
      "compiled_truth": false
    },
    {
      "id": "pbps:gamma-identification",
      "kind": "SEPARATE_OPERATOR_BOUNDARY",
      "mathematics": "Gamma_P=(I-T²)^(1/2); |Gamma_P f|²=|U_perpP f|²=|f|²-|Tf|² requires actual selfadjoint unitary U and P orthogonal projection plus square-root functional calculus",
      "source_anchors": [
        "A2.E5",
        "A2.E10",
        "A2.E11"
      ],
      "compiled_truth": false
    },
    {
      "id": "pbps:B13",
      "kind": "SOURCE_ANCHOR",
      "mathematics": "Every f in L2(nu): Tf in H1(nu); 4eta |grad Tf|²<=|f|²-|Tf|²=|Gamma_P f|²=|U_perpP f|²",
      "source_anchors": [
        "A2.Thmtheorem1.p2.1",
        "A2.E13"
      ],
      "compiled_truth": false
    }
  ],
