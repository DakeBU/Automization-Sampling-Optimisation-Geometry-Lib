1: #!/usr/bin/env python3
2: """Substantive-advance coordination for the ASTIS Harness.
3: 
4: The legacy ASTIS harness remains available as durable typed memory. This module
5: makes a mathematically substantive theorem-DAG delta the active unit of work. A
6: generalist Worker owns that delta end to end; specialties are temporary modes
7: rather than role boundaries.
8: 
9: The current Harness keeps the global coordinator thin:
10: 
11: * advances are partitioned into explicit frontier cells;
12: * any generalist Worker may publish a cell-level synthesis discovery;
13: * cross-domain proof mechanisms are retained as typed conceptual-mirror discoveries;
14: * the coordinator capsule is synthesis-first and never embeds raw transcripts;
15: * unchanged route/progress checkpoints trigger a deterministic no-progress
16:   diagnosis instead of indefinite retries;
17: * exploration stays parallel while shared repository stabilization is single
18:   owner.
19: 
20: All durable I/O reuses ``tools.astis_harness``: canonical-path locks, fsync,
21: atomic JSONL appends, and interrupted-tail recovery therefore stay compatible
22: with the existing ASTIS runtime.
23: """
24: 
25: from __future__ import annotations
26: 
27: import argparse
28: import dataclasses
29: import json
30: from pathlib import Path
31: from typing import Any, Iterable, Sequence
32: 
33: try:  # package import under unit tests
34:     from tools import astis_harness as durable
35: except ImportError:  # direct ``python3 tools/astis_advance.py ...``
36:     import astis_harness as durable  # type: ignore
37: 
38: 
39: ROOT = Path(__file__).resolve().parents[1]
40: DEFAULT_ADVANCE_LEDGER = ROOT / "runs" / "substantive_advances.jsonl"
41: DEFAULT_DISCOVERY_LEDGER = ROOT / "runs" / "substantive_discoveries.jsonl"
42: ADVANCE_SCHEMA_VERSION = 4
43: 
44: 
