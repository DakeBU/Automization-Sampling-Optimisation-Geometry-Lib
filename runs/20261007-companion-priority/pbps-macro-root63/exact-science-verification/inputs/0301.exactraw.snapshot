          let Z := ∫ (u : E), Real.exp (-rho u) ∂gamma;
          let q := fun u => Real.exp (-rho u) / Z;
          let f := fun u => Real.exp (-rho u / 2) / √Z;
          let r := gamma.tilted fun u => -rho u;
          0 < Z ∧
            Z ≤ 1 ∧
              (r = ℙ.tilted fun u => -(‖u‖ ^ 2 / 2 + rho u)) ∧
                (r = gamma.withDensity fun u => ENNReal.ofReal (q u)) ∧
                  IsProbabilityMeasure r ∧
                    (∀ (u : E), 0 < q u ∧ f u ^ 2 = q u) ∧
                      ∫ (u : E), q u ∂gamma = 1 ∧
                        ContDiff ℝ 2 f ∧
                          MemLp f 2 gamma ∧
                            MemLp (gradient f) 2 gamma ∧
                              MemLp (gradient rho) 2 r ∧
                                Integrable (fun u => q u * Real.log (q u)) gamma ∧
                                  (∀ (u : E), gradient f u = -(f u / 2) • gradient rho u) ∧
                                    (∀ (u : E), gradient (fun z => Real.log (q z)) u = -gradient rho u) ∧
                                      ∫ (u : E), ‖gradient f u‖ ^ 2 ∂gamma =
                                        1 / 4 * ∫ (u : E), ‖gradient rho u‖ ^ 2 ∂r : Prop
