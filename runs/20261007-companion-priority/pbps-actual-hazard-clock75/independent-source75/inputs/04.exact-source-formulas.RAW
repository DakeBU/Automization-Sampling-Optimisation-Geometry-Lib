      ],
      "RAW_sha256": "30ac2694e6c8c1fe66ffc0cf7f4fc6c4458503b0f75c5a821fb82fd4c023f91a",
      "credit": "Exact source formula only; not a proved Lean clause",
      "id": "S3.E4.m1",
      "literal_source_alttext": "c_{y,\\widetilde{x}}\\coloneqq y-\\eta\\nabla V(\\widetilde{x})\\,,\\hskip 20.00003pth_{\\widetilde{x}}(x)\\coloneqq\\nabla V(x)-\\nabla V(\\widetilde{x})\\,.",
      "source_URL": "https://arxiv.org/html/2609.06905v1#S3.E4.m1"
    },
    {
      "LF_sha256": "6cffa97e8ac1d0231eaef53779b8c41bb095b358f1790af9151182ccaddc37e5",
      "RAW_bytes": 1480,
      "RAW_range": [
