        ],
        "literal_source_text": "\\|\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}f\\|\\leq\\frac{1-\\alpha\\eta}{1+\\alpha\\eta}\\,\\|f\\|=\\rho_{\\rm mac}\\,\\|f\\|\\,. (C.4)"
      },
