    {
      "id": "A-GRAD-CONT",
      "kind": "PINNED_API_DECLARATION",
      "statement": "theorem continuous_gradient_of_contDiff_one\n    {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]\n    {f : F → ℝ} (hf : ContDiff ℝ 1 f) :\n    Continuous (fun x : F => gradient f x) := by\n  exact ((InnerProductSpace.toDual ℝ F).symm.continuous.comp\n    (hf.continuous_fderiv one_ne_zero))\n",
      "source_anchors": [
        {
          "pin": "ASTIS-GRADIENT",
          "start_line": 114,
          "end_line": 119
        }
      ],
      "canonical_api": "AutoSamplingTheory.TechnicalLemmas.Analysis.Calculus.Gradient.continuous_gradient_of_contDiff_one",
      "proof_status": "existing pinned local API source; no fresh compilation or new ASTIS producer credit"
    },
    {
      "id": "A-RIESZ",
      "kind": "PINNED_API_DECLARATION",
      "statement": "theorem fderiv_apply_eq_inner_of_hasGradientAt\n    {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]\n    {f : F → ℝ} {x grad v : F}\n    (hf : HasGradientAt f grad x) :\n    fderiv ℝ f x v = inner ℝ grad v := by\n  have hfd : fderiv ℝ f x = InnerProductSpace.toDual ℝ F grad :=\n    hf.differentiableAt.hasFDerivAt.unique hf.hasFDerivAt\n  calc\n    fderiv ℝ f x v = InnerProductSpace.toDual ℝ F grad v := by rw [hfd]\n    _ = inner ℝ grad v := by rw [InnerProductSpace.toDual_apply_apply]\n",
      "source_anchors": [
        {
          "pin": "ASTIS-GRADIENT",
          "start_line": 128,
          "end_line": 137
        }
      ],
      "canonical_api": "AutoSamplingTheory.TechnicalLemmas.Analysis.Calculus.Gradient.fderiv_apply_eq_inner_of_hasGradientAt",
      "proof_status": "existing pinned local API source; no fresh compilation or new ASTIS producer credit"
    },
    {
      "id": "A-RIESZ-DIFF",
      "kind": "PINNED_API_DECLARATION",
      "statement": "theorem fderiv_apply_eq_inner_gradient_of_differentiableAt\n    {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]\n    {f : F → ℝ} {x v : F}\n    (hf : DifferentiableAt ℝ f x) :\n    fderiv ℝ f x v = inner ℝ (gradient f x) v :=\n  fderiv_apply_eq_inner_of_hasGradientAt hf.hasGradientAt\n",
      "source_anchors": [
        {
          "pin": "ASTIS-GRADIENT",
          "start_line": 144,
