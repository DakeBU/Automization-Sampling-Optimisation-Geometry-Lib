{
  "schema_version": 1,
  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.GibbsLinearCovarianceUpper.gibbs_linear_covariance_upper",
      "title": "Actual Gibbs linear covariance upper",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06906v1#S4.Thmtheorem1",
          "label": "SPHMC actual Lemma4.1 and explicit covariance prerequisite",
          "scope": "Canonical BOTH-curvature Gibbs linear covariance upper with genuine vectorL2, actual positive partition and probability normalization; not full anisotropic Brascamp-Lieb. Actual source beta=1 alpha=kappa^-1, 1<=kappa, 0<eta<=1; genuine posterior law R_y, internally produced probability/vectorL2/positive partitions/C2 and normalized-U versus unnormalized-V_eta constant shift. Derive true covariance upper and both Hessian bounds (kappa+eta)^-1 and (1+eta)^-1, then true 1-Lipschitz gradient. Finite real Hilbert/Borel including zero dimension is disclosed representation extension. No input covariance/PI/oracle/moment/normalizer certificate on source Anchor. No joint measurable posterior kernel selector, higher smoothing derivatives, algorithm/Wp/proxy-warmness/main/querycost/composition. PBPS reflected quarter law and source-score remain separate. TV never transfers unbounded expected cost."
        }
      ],
      "tests": [
        "lake build Tests.SmoothedHessianBounds"
      ],
      "assumptions": [
        "Finite real Hilbert/Borel full E including0, actual C2 W, true exp(-W) volume integrability and positive partition, BOTH global mI<=HessW<=MI with0<m<=M.",
        "Genuine vector id in L2 of normalized tilted Gibbs law. This canonical node keeps the moment premise explicit to rule out totalized covariance outside its integrable domain; the actual paper consumer produces it internally. No covariance/Poincare certificate input."
      ],
      "statement": "For each direction a, the genuine covariance bilinear form of the normalized BOTH-curvature Gibbs law satisfies Cov_mu(a,a)<=norma^2/m, using the actual linear observable, constant gradient and proven C1 Poincare.",
      "formula": "\\mu=Z^{-1}e^{-W}dx,\\quad mI\\preceq D^2W\\preceq MI,\\quad X\\in L^2(\\mu)\\Longrightarrow \\operatorname{Cov}_\\mu(a,a)\\le \\|a\\|^2/m.",
      "boundary": "Canonical BOTH-curvature Gibbs linear covariance upper with genuine vectorL2, actual positive partition and probability normalization; not full anisotropic Brascamp-Lieb. Actual source beta=1 alpha=kappa^-1, 1<=kappa, 0<eta<=1; genuine posterior law R_y, internally produced probability/vectorL2/positive partitions/C2 and normalized-U versus unnormalized-V_eta constant shift. Derive true covariance upper and both Hessian bounds (kappa+eta)^-1 and (1+eta)^-1, then true 1-Lipschitz gradient. Finite real Hilbert/Borel including zero dimension is disclosed representation extension. No input covariance/PI/oracle/moment/normalizer certificate on source Anchor. No joint measurable posterior kernel selector, higher smoothing derivatives, algorithm/Wp/proxy-warmness/main/querycost/composition. PBPS reflected quarter law and source-score remain separate. TV never transfers unbounded expected cost.",
      "steps": [
        {
          "title": "Normalize the actual Gibbs measure",
          "text": "True exponential integrability gives probability. The canonical moment premise is real vectorL2, rather than a certificate of a covariance estimate.",
          "formula": "\\mu=Z^{-1}e^{-W}dx,\\quad \\mu(E)=1,\\quad X\\in L^2(\\mu).",
          "lean": "isProbabilityMeasure_tilted"
        },
        {
          "title": "Take the genuine linear observable",
          "text": "The continuous linear functional f(x)=inner(a,x) is C1. Actual vectorL2 yields scalarL2 by MemLp.const_inner.",
          "formula": "f_a(x)=\\langle a,x\\rangle,\\quad f_a\\in C^1\\cap L^2(\\mu).",
          "lean": "ContinuousLinearMap.contDiff; MemLp.const_inner"
        },
        {
          "title": "Identify its actual gradient",
          "text": "The real Riesz isometry and true continuous-linear derivative show gradientf is constanta. It therefore has genuine weighted vectorL2.",
          "formula": "\\nabla f_a(x)=a,\\quad\\nabla f_a\\in L^2(\\mu).",
          "lean": "toDual_gradient; ContinuousLinearMap.fderiv; memLp_const"
        },
        {
          "title": "Use the proved curvature Poincare producer",
          "text": "The accepted original-gradient/C1 theorem derives actual integrability and m*variance<=energy, using BOTH curvature bounds. Poincare.Satisfies is not assumed.",
          "formula": "m\\operatorname{Var}_\\mu(f_a)\\le\\int\\|\\nabla f_a\\|^2d\\mu.",
          "lean": "GibbsC1Poincare.gibbs_c1_variance_poincare"
        },
        {
          "title": "Preserve exact normalization",
          "text": "The genuine constant gradient and probability mass1 make the Dirichlet integral exactly norma^2, with no missing energy prefactor.",
          "formula": "\\int\\|\\nabla f_a\\|^2d\\mu=\\|a\\|^2.",
          "lean": "integral_const; probReal_univ; Poincare.dirichletEnergy"
        },
        {
          "title": "Bridge actual covariance and variance",
          "text": "covarianceBilin_self requires the real vectorL2 premise; variance_eq_integral matches the genuine centered-square definition. Divide by positivem.",
          "formula": "\\operatorname{Cov}_\\mu(a,a)=\\operatorname{Var}_\\mu(f_a)\\le\\|a\\|^2/m.",
          "lean": "covarianceBilin_self; variance_eq_integral; le_div_iff₀"
        }
      ],
      "lean_statement": "For each direction a, the genuine covariance bilinear form of the normalized BOTH-curvature Gibbs law satisfies Cov_mu(a,a)<=norma^2/m, using the actual linear observable, constant gradient and proven C1 Poincare.",
      "lean_proof": "Normalize the actual Gibbs measure; Take the genuine linear observable; Identify its actual gradient; Use the proved curvature Poincare producer; Preserve exact normalization; Bridge actual covariance and variance",
      "astis_dependencies": [
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.GibbsC1Poincare.gibbs_c1_variance_poincare"
      ],
      "mathlib_dependencies": [
        "covarianceBilin_self",
        "variance_eq_integral",
        "MemLp.const_inner",
        "toDual_gradient",
        "ContinuousLinearMap.fderiv",
        "integral_const",
        "le_div_iff₀"
      ]
    }
  ]
}
