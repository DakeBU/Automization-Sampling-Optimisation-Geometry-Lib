    {
      "id": "transport:dirac",
      "kind": "concept-bridge",
      "label": "Deterministic maps inside kernels",
      "status": "proposal",
      "subtitle": "functor candidate",
      "summary": "Embed a measurable update map as a deterministic probability kernel. The product denotes first T, then S.",
      "formula": "\\begin{gathered}K_T(x,\\cdot)=\\delta_{T(x)}\\\\K_{S\\circ T}=K_T K_S\\end{gathered}",
      "details": [
        {
          "label": "Evidence boundary",
