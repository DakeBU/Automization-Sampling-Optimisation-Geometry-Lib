+def unit_source_candidates(unit: dict) -> list[dict]:
+    """Existing explicit citations plus this unit's actual canonical module."""
+    sources = list(unit.get('sources', []))
+    declaration = inline_lean.declarations().get(unit.get('declaration', ''))
+    if declaration and not any(s.get('path') == declaration.source_file for s in sources):
+        sources.insert(0, {'path': declaration.source_file, 'line': declaration.source_line})
+    return sources
+
+
+def exact_lean_step_actions(unit: dict, step: dict, page: str) -> str:
+    """Copy literal code and link only one unambiguous exact source occurrence.
+
+    This matches bytes, never theorem names or approximate snippets. Ambiguous or
+    absent matches receive copy controls only, with no invented source routing.
+    """
+    literal = str(step.get('lean', '')).encode('utf-8')
+    if b'\n' not in literal:
+        return ''
+    copy = ('<button type="button" data-lean-copy>Copy Lean step</button>'
+            '<span role="status" aria-live="polite" data-lean-copy-status></span>')
+    matches = []
+    seen = set()
+    for source in unit_source_candidates(unit):
+        raw = source.get('path', '')
+        if source.get('url') or not raw or raw.startswith('.lake/packages/') or Path(raw).suffix != '.lean':
+            continue
+        source_link(source, page)  # validate the existing repository path first
+        if raw in seen:
+            continue
+        seen.add(raw)
+        path = ROOT / raw
+        if not path.resolve().is_relative_to(ROOT.resolve()):
+            raise ValueError(f'Exposition source leaves the repository: {raw}')
+        if not path.is_file():
+            continue
+        whole = path.read_bytes()
+        offset = whole.find(literal)
+        if offset < 0:
+            continue
+        if whole.find(literal, offset + 1) >= 0:
+            matches.extend([None, None])  # repeated source occurrences are ambiguous
+            continue
+        line = (source.get('line', 1) if whole == literal
+                else whole[:offset].count(b'\n') + 1)
+        matches.append((raw, line))
+    links = ''
+    if len(matches) == 1 and matches[0] is not None:
+        raw, line = matches[0]
+        context = source_link({'path': raw, 'line': line}, page)
+        download = base.relative_prefix(page) + 'data/lesson-sources/' + Path(raw).as_posix()
+        links = (f'<a href="{base.esc(context)}">Exact source context</a>'
+                 f'<a href="{base.esc(download)}" download>Download exact Lean source</a>')
+    return '<div class="lean-source-actions">' + copy + links + '</div>'
 
 
