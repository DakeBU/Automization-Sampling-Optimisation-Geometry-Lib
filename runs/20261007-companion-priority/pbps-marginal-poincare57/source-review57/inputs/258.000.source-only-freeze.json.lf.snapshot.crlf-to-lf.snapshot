      "consumer_use_site": "A3.E4 and paragraph combining C.3/C.2",
      "semantics": "AND within this single printed route",
      "conditional_discharge": "0<alpha<=beta and beta eta<=1 imply 0<alpha eta<=1; centered f, common actual A and gradient representative; scalar rearrangement supplies rho_mac.",
      "formal_dependency_admitted": false
