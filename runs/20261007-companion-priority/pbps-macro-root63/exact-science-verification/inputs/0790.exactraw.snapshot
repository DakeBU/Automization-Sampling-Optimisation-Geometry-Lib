      MeasureTheory.AEStronglyMeasurable
        (fun x => inner Real (testGrad φ x) (canonicalBarB x)) (hatRhoS s0)) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      ∀ᵐ x ∂(hatRhoS s0), ‖testGrad φ x‖ ≤ pairBound φ) →
    (∀ φ, Admissible φ →
