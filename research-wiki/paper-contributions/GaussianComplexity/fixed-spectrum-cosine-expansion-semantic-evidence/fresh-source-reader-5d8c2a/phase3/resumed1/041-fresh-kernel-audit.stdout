'AutoSamplingTheory.ExampleCases.GaussianComplexity.FixedSpectrumCosineExpansion.actual_inverse_spectrum_cosine_expansion' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
AutoSamplingTheory.ExampleCases.GaussianComplexity.FixedSpectrumCosineExpansion.actual_inverse_spectrum_cosine_expansion
  {κ : ℝ} (hκ : 2 ≤ κ) :
  have r := (√κ - 1) / (√κ + 1);
  (∀ (θ : ℝ),
      2 / (κ + 1 + (κ - 1) * Real.cos θ) = 1 / √κ * (1 + 2 * ∑' (j : ℕ), (-r) ^ (j + 1) * Real.cos (↑(j + 1) * θ))) ∧
    (∀ (θ : ℝ), Summable fun j => ‖(-r) ^ (j + 1) * Real.cos (↑(j + 1) * θ)‖) ∧
      TendstoUniformly (fun N θ => ∑ j ∈ Finset.range N, (-r) ^ (j + 1) * Real.cos (↑(j + 1) * θ))
        (fun θ => ∑' (j : ℕ), (-r) ^ (j + 1) * Real.cos (↑(j + 1) * θ)) atTop
