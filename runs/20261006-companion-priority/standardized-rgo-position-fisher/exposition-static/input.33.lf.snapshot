      "id": "case:ASTIS-SW-SETTING-LOG-CONCAVE-SMOOTH-UPPER-IDEAL-PROXIMAL-CHAIN",
      "kind": "frontier-case",
      "label": "Ideal proximal chain",
      "status": "audited",
      "subtitle": "Log-concave + log-smooth · upper",
      "summary": "KL convergence per ideal step",
      "formula": "\\operatorname{KL}(\\mu_n^X\\Vert\\pi^X)\\le \\frac{W_2^2(\\mu_0^X,\\pi^X)}{nh}",
      "theorem": "Theorem 8.4.1 (Proximal sampler under log-concavity)",
      "source_proof": "proof given in source",
      "proof_equations": [
        {
          "formula": "\\partial_t K_t=-\\tfrac12 I_t",
          "meaning": "Theorem 8.3.1 specialized to the simultaneous heat flow."
        },
        {
          "formula": "K_t^2\\le I_t W_t^2",
          "meaning": "Theorem 1.4.5 plus the Wasserstein first variation and Cauchy-Schwarz."
        },
        {
          "formula": "W_t^2\\le W_0^2\\quad\\Longrightarrow\\quad K_t'\\le-\\frac{K_t^2}{2W_0^2}",
          "meaning": "Simultaneous heat-flow contraction."
        },
        {
          "formula": "\\frac1{K_h}\\ge\\frac1{K_0}+\\frac{h}{2W_0^2}",
          "meaning": "Solve the forward half-step differential inequality; the backward half-step gives the same increment."
        },
        {
          "formula": "\\frac1{K_{j+1}}\\ge\\frac1{K_j}+\\frac{h}{W_0^2}\\quad\\Longrightarrow\\quad K_n\\le\\frac{W_0^2}{nh}",
          "meaning": "Full-step reciprocal growth followed by the already compiled telescoping tail."
        }
      ],
      "url": "example-cases/samplewiki/cases/setting-log-concave-smooth-upper-ideal-proximal-chain.html",
      "source_url": "https://chewisinho.github.io/main.pdf#page=234",
