{
  "schema_version": 1,
  "units": [
    {
      "kind": "proof",
      "declaration": "AutoSamplingTheory.ExampleCases.SmoothedPicardHMC.SmoothedScorePosterior.smoothed_score_posterior",
      "title": "True smoothed score and standardized posterior expectation",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06906v1#S4.Ex9",
          "label": "Exact source mean identity and its internal analytic background",
          "scope": "Only actual Gibbs gradient mean zero and source3.1/S4.Ex9 genuine smoothed-score/posterior/standardized-chain identity. No supplied means/moments/normalizers/IBP/gradient equality/selector; exact eta>0. No bias4.2, FIRST4.6W2/LSI/T2, fullLemma4.2, algorithm/work/main/composition credit. Actual RGO law is not Gaussian gradient-output or HMC. Focused3751 passed, standard3 only; independent math/blind/source/exactcommit/publication/integration admission pending. RenderedQA, Copy/Download implementation and postmerge purification remain open."
        }
      ],
      "tests": [
        "lake build Tests.SmoothedScorePosterior"
      ],
      "assumptions": [
        "Complete finite real Hilbert E with its Borel structure and canonical volume, including dimension zero.",
        "The unchanged source normalization: kappa>=1, actual global C2 V and Hessian kappa^-1 I<=HessV<=I.",
        "Every eta>0, with no numerical upper cap. Actual measures, normalization, p, stationarity, moments and gradient/mean identities are derived outputs, not supplied premises."
      ],
      "statement": "The literal source convolution potential is C2 and its gradient at every y is the actual true quadratic posterior expectation of gradientV, with probability and position/gradient domains proved internally. Produce a measurable stationary proximal p and the same literal affine standardized posterior r, its exact normalized Gibbs law, gradient-rho L2, the exact source Ex9 mean identity, and the pointwise deterministic Gaussian evaluator chain identity.",
      "formula": "\\nabla V_\\eta(y)=\\int\\nabla V\\,dR_y=\\nabla V(p_y)+\\eta^{-1/2}\\int\\nabla\\rho_y\\,dr_y,\\quad\\nabla V(p_y+\\sqrt\\eta z)=\\nabla V(p_y)+\\eta^{-1/2}\\nabla\\rho_y(z).",
      "boundary": "Only actual Gibbs gradient mean zero and source3.1/S4.Ex9 genuine smoothed-score/posterior/standardized-chain identity. No supplied means/moments/normalizers/IBP/gradient equality/selector; exact eta>0. No bias4.2, FIRST4.6W2/LSI/T2, fullLemma4.2, algorithm/work/main/composition credit. Actual RGO law is not Gaussian gradient-output or HMC. Focused3751 passed, standard3 only; independent math/blind/source/exactcommit/publication/integration admission pending. RenderedQA, Copy/Download implementation and postmerge purification remain open.",
      "steps": [
        {
          "title": "Keep the exact unnormalized convolution",
          "text": "Reuse the actual smoothing producer. With ZV the original partition and A the literal source convolution including the printed Gaussian prefactor, the normalized potential is Ueta=Veta+logZV. Both partitions are positive and the source Veta is C2. Differentiate the constant shift, rather than asserting equal potentials.",
          "formula": "A(y)=(\\sqrt{2\\pi\\eta})^{-d}\\int e^{-V(x)-\\|y-x\\|^2/(2\\eta)}dx,\\quad V_\\eta=-\\log A,\\quad U_\\eta=V_\\eta+\\log Z_V.",
          "lean": "SmoothedGibbsPotential.smoothed_gibbs_potential; fderiv_add_const"
        },
        {
          "title": "Reuse the true everywhere Gaussian-convolution derivative",
          "text": "The canonical Gaussian-convolution theorem internally produces probability and position L2 for the actual unreflected posterior R_y, and the directional derivative of Ueta. This is an everywhere literal tilted law, so no arbitrary conditional version is used at a null y.",
          "formula": "R_y\\propto e^{-V(x)-\\|x-y\\|^2/(2\\eta)}dx,\\quad DU_\\eta(y)[v]=\\eta^{-1}\\langle y-\\mathbb E_{R_y}X,v\\rangle.",
          "lean": "GaussianConvolutionRegularity.gaussian_convolution_derivatives"
        },
        {
          "title": "Construct the actual posterior Gibbs potential",
          "text": "For each y define Wy=V+norm(x-y)^2/(2eta). Its C2 chain rule gives Hessian bounds kappa^-1+eta^-1 and1+eta^-1, both derived from the unchanged source binders. Canonical consecutive tilts show R_y=volume.tilted(-Wy). Positive eta is the complete analytic range.",
          "formula": "W_y(x)=V(x)+\\frac{\\|x-y\\|^2}{2\\eta},\\quad(\\kappa^{-1}+\\eta^{-1})I\\preceq\\nabla^2W_y\\preceq(1+\\eta^{-1})I.",
          "lean": "tilted_tilted; HasFDerivAt.norm_sq; actual hWfd/hWdd/hRW"
        },
        {
          "title": "Cancel the actual posterior gradient mean",
          "text": "The new shared mean-zero producer gives E_R gradWy=0 and genuine vector L1. Position L2 gives L1 of the quadratic gradient, hence L1 of gradV. Integrate the actual chain identity and rearrange. No expected-gradient identity or IBP domain is a source input.",
          "formula": "\\nabla W_y=\\nabla V+\\eta^{-1}(x-y),\\quad\\mathbb E_{R_y}\\nabla V=\\eta^{-1}(y-\\mathbb E_{R_y}X).",
          "lean": "GibbsGradientMean.integrable_gradient_and_integral_eq_zero; MemLp.integrable; integral_add; integral_sub; integral_smul"
        },
        {
          "title": "Identify the true smoothed score",
          "text": "Compare the Gaussian-convolution derivative with the posterior cancellation, and use the Riesz inner-product characterization of gradient. The exact constant shift has already been differentiated. The resulting mean is under the true RGO posterior; it is not the own mean of the separate Gaussian-gradient output law.",
          "formula": "\\nabla V_\\eta(y)=\\mathbb E_{R_y}\\nabla V(X).",
          "lean": "inner_gradient_left; ext_inner_right; actual hDU/hD/hscore"
        },
        {
          "title": "Reuse the same produced proximal selector and standardized law",
          "text": "The existing allpositive standardized RGO theorem produces a measurable p, its stationarity, the affine pushforward r_y and its actual normalized Gibbs identification, with gradient-rho L2. The same p occurs in rho, the affine map, and the evaluator. No Jacobian or probability identity is assumed.",
          "formula": "p_y+\\eta\\nabla V(p_y)=y,\\quad r_y=(x\\mapsto\\eta^{-1/2}(x-p_y))_\\#R_y\\propto e^{-\\|u\\|^2/2-\\rho_y(u)}du.",
          "lean": "StandardizedRGOPositionFisher.standardized_rgo_position_and_fisher"
        },
        {
          "title": "Integrate the exact standardized chain rule",
          "text": "The internally derived Frechet/Riesz chain identity gives grad_rho(u)=sqrteta times (gradV(p+sqrteta*u)-gradVp). Actual gradient-rho L2 supplies all needed first moments. Push the affine observable through the same r=T#R, use the exact inverse map, and integrate constants/scalars. This proves both printed Ex9 identities while leaving all bias/transport/cost bounds separate.",
          "formula": "\\nabla\\rho_y(u)=\\sqrt\\eta(\\nabla V(p_y+\\sqrt\\eta u)-\\nabla V(p_y)),\\quad\\nabla V_\\eta(y)=\\nabla V(p_y)+\\eta^{-1/2}\\mathbb E_{r_y}\\nabla\\rho_y(U).",
          "lean": "rho_gradient; integral_map; integral_add; integral_smul; integral_const; actual heval/hmap"
        }
      ],
      "lean_statement": "The literal source convolution potential is C2 and its gradient at every y is the actual true quadratic posterior expectation of gradientV, with probability and position/gradient domains proved internally. Produce a measurable stationary proximal p and the same literal affine standardized posterior r, its exact normalized Gibbs law, gradient-rho L2, the exact source Ex9 mean identity, and the pointwise deterministic Gaussian evaluator chain identity.",
      "lean_proof": "Keep the exact unnormalized convolution; Reuse the true everywhere Gaussian-convolution derivative; Construct the actual posterior Gibbs potential; Cancel the actual posterior gradient mean; Identify the true smoothed score; Reuse the same produced proximal selector and standardized law; Integrate the exact standardized chain rule",
      "astis_dependencies": [
        "AutoSamplingTheory.TechnicalLemmas.Analysis.GibbsGradientMoment.gibbs_gradient_moment",
        "AutoSamplingTheory.TechnicalLemmas.Measure.GaussianConvolutionRegularity.gaussian_convolution_derivatives",
        "AutoSamplingTheory.ExampleCases.SmoothedPicardHMC.SmoothedGibbsPotential.smoothed_gibbs_potential",
        "AutoSamplingTheory.ExampleCases.SmoothedPicardHMC.StandardizedRGOPositionFisher.standardized_rgo_position_and_fisher",
        "AutoSamplingTheory.TechnicalLemmas.Analysis.QuadraticRegularization.strongConvexOn_and_lipschitzWith_gradient_add_quadratic",
        "AutoSamplingTheory.TechnicalLemmas.Analysis.GibbsGradientMean.integrable_gradient_and_integral_eq_zero"
      ],
      "mathlib_dependencies": [
        "MeasureTheory.tilted_tilted",
        "MeasureTheory.integral_map",
        "MeasureTheory.integral_add",
        "MeasureTheory.integral_smul",
        "fderiv_add_const",
        "InnerProductSpace.inner_gradient_left"
      ]
    }
  ]
