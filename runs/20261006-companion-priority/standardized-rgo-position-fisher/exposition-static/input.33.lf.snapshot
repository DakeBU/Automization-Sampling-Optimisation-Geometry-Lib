          "relation": "explicit-elaboration",
          "evidence": "The generic position law can be instantiated at the paper's smoothed Gibbs position law; no property of Gibbs is used in the coupling construction."
        },
        {
          "slot": "domains",
          "original": "Euclidean position and momentum spaces R^d.",
          "reconstructed": "A finite-dimensional complete real inner-product Borel space E and its phase product E times E.",
          "relation": "explicit-elaboration",
          "evidence": "The paper's R^d is a direct instance of the coordinate-free Lean domain."
        },
        {
          "slot": "quantifiers",
          "original": "The paper states Lemma 4.16 for every q at least two; the pinned source paraphrase isolates its q=2 coupling step.",
          "reconstructed": "Every position probability measure, reference point and kappa at least one, at fixed q=2 squared cost.",
          "relation": "explicit-elaboration",
          "evidence": "Only the source proof's q=2 coupling component is bound here; generic position law and arbitrary xref expose the exact hypotheses of that component, not the full all-q lemma."
        },
        {
          "slot": "assumptions",
          "original": "Strongly log-concave Gibbs context yields a finite position moment and kappa at least one.",
          "reconstructed": "Probability and position-square integrability are premises; kappa at least one is explicit.",
