  frozenDeltaCoefficientAudit := "The frozen-delta terms 2*Gamma(t(s))*eta^2*alpha'^(-1)*K_s and 2*Delta(t(s))*eta become 2*dot{s}(t)*eta^2*alpha'^(-1)*Gamma(t) in a(t) and 2*dot{s}(t)*eta*Delta(t) in b(t)."
