    {
      "id": "M-OSUM-SYMM",
      "kind": "PINNED_API_DECLARATION",
      "statement": "protected theorem sum_repr_symm (b : OrthonormalBasis ι 𝕜 E) (v : EuclideanSpace 𝕜 ι) :\n    ∑ i, v i • b i = b.repr.symm v := by simpa using (b.toBasis.equivFun_symm_apply v).symm\n",
      "source_anchors": [
