    "contract": "SPHMC S4.E6 first inequality uses full standard-Gaussian LSI AND separate Gaussian Talagrand. It does not print this finite Bernoulli/CLT proof, impose compact support on literal RGO square-root density, or give either dependency for free. This packet is authored compact analytic core only."
  },
  "fixed_definitions": {
    "cube": "B_N = Fin N -> Bool, actual canonical measurable finite cube.",
    "mu_N": "(Fintype.card B_N : ENNReal)^(-1) smul Measure.count; cardinal=2^N>0. Fin0 cube has cardinal1.",
    "S_N": "(sqrt(N:Real))^(-1) * sum_i (if eps_i then1 else-1). Exactly same35 output map, no change to +/- convention or scaling. At N0 sum0 and totalized inverse0 give S0=0.",
    "gamma": "gaussianReal0 (1:NNReal), exact covariance/variance1.",
    "observables": {
      "A_f": "x -> (f x)^2",
      "B_f": "x -> (f x)^2 * Real.log((f x)^2)",
      "C_f": "x -> (deriv f x)^2"
    },
    "entropy": "Ent_m(f^2) = integral B_f dm - (integral A_f dm)*Real.log(integral A_f dm). No integrability is implicit in totalized integral notation; derive and output the real L1 domains."
  },
  "public35_signature_only": {
    "file": "runs/20261007-companion-priority/balanced-rademacher-clt/preproof/signature.prospective.txt",
    "raw_sha256": "271595fa838cf28466cf90591d2c6aaa1024b42a1af73d85eee25cfc32e04777",
    "signature_text": "theorem balanced_count_sum_tendsto_gaussian :\n    ∃ laws : ℕ → ProbabilityMeasure ℝ,\n      (∀ n : ℕ, (laws n : Measure ℝ) =\n        (((Fintype.card (Fin n → Bool) : ℝ≥0∞)⁻¹ •\n          (Measure.count : Measure (Fin n → Bool))).map\n          (fun ε : Fin n → Bool => (Real.sqrt (n : ℝ))⁻¹ *\n            ∑ j : Fin n, if ε j then (1 : ℝ) else -1))) ∧\n      (laws 0 : Measure ℝ) = Measure.dirac 0 ∧\n      Tendsto (fun n : ℕ => laws (n + 1)) atTop\n        (𝓝 (⟨gaussianReal 0 1, inferInstance⟩ : ProbabilityMeasure ℝ))\n",
    "read_scope": "Only preproof statement/signature, not production body, blind output, wholemath or source verdict."
  },
