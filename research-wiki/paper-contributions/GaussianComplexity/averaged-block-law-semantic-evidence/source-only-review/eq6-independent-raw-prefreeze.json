    {
      "atom_id": "A2.Thmtheorem8",
      "section": "A2.SS3",
      "kind": "theorem-container",
      "raw_locator": "#A2.Thmtheorem8",
      "source_text": "Lemma B.8 ( Regularity). For every $\\bm{O}\\in O(n)^{k}$ , $A_{\\bm{O}}\\in\\mathcal{A}_{d,\\kappa}$ . The potential $f_{A_{\\bm{O}}}$ has unique minimizer $0$ and minimum value $0$ .",
      "raw_span": {
        "byte_start_inclusive": 596086,
        "byte_end_exclusive": 598196,
        "start_line": 2865,
        "end_line": 2873,
        "raw_fragment_sha256": "308ad2e8763ff7a4a022c2c7d1f2c7ab891311969f89e2cd4a3ae89caf583ca8"
      },
      "references": [],
