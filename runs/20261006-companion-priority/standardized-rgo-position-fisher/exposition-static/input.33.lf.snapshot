        },
        {
          "slot": "assumptions",
          "original": "The density is an admissible LSI test, entropy and score are finite, and generator integration by parts plus the carre-du-champ identity identify Dirichlet energy with Fisher information.",
          "reconstructed": "LogSobolevAdmissible, SmoothFiniteScoreDomain, DirichletPairDomain, and HasCanonicalFisherGamma expose normalization, entropy and generator-term integrability, absolute continuity, a.e. differentiability, finite score energy, stationarity/symmetry, and the gamma-score equality.",
          "relation": "explicit-elaboration",
          "evidence": "The Lean assumptions spell out the source packet's proviso that the density, entropy, score, generator domain, and integration-by-parts hypotheses be genuine; they are not inferred from a representative equality."
        },
        {
          "slot": "conclusion",
          "original": "KL(mu||pi) is finite and KL(mu||pi) <= (C/2) FI(mu||pi).",
          "reconstructed": "klDiv mu pi is not infinity and klDiv.toReal is at most (C/2) times guarded canonical relative Fisher information.",
          "relation": "equivalent",
          "evidence": "The explicit not-top conjunct makes the real-valued inequality faithful to finite ENNReal KL, and the proof obtains it from llr integrability before applying the C/2 estimate."
        },
        {
          "slot": "scopes",
