        "raw_bytes": 2410,
        "lf_bytes": 2410,
        "raw_sha256": "d24fec695423a3d6af884a8a3fe3c46804b6e817f935fb89b1853a6ab5f65241",
        "lf_sha256": "d24fec695423a3d6af884a8a3fe3c46804b6e817f935fb89b1853a6ab5f65241"
      },
      "byte_range": [
        765724,
        768134
      ],
      "literal_source_text": "(\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}f)(y)=\\mathbb{E}[f(Y_{-})\\mid Y_{+}=y]\\,,\\hskip 20.00003pt\\|\\mathsf{U}_{\\perp\\mathsf{P}}f\\|^{2}=\\mathbb{E}\\Var(f(Y_{-})\\mid Y_{+})\\,. (B.9)"
    },
    {
      "id": "A2.E12",
      "coverage": "EXCLUDED",
      "reason": "rho/gamma quantitative centered rate/order constants not selected.",
