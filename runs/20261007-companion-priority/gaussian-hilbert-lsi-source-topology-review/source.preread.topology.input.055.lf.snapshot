    {
      "id": "S-W12-LSI",
      "kind": "PINNED_API_DECLARATION",
      "statement": "/-- Dimension-free Gaussian log-Sobolev inequality: `Ent_μ(g²) ≤ 2∫‖∇g‖² dμ`. -/\ntheorem gaussian_logSobolev_W12_pi {n : ℕ} {g : (Fin n → ℝ) → ℝ}\n    (hg : MemW12GaussianPi n g (GaussianMeasure.stdGaussianPi n))\n    (hg_diff : Differentiable ℝ g)\n    (hg_grad_cont : ∀ i, Continuous (fun x => partialDeriv i g x))\n    (hg_log_int :\n      Integrable (fun x => (g x)^2 * log ((g x)^2)) (GaussianMeasure.stdGaussianPi n)) :\n    LogSobolev.entropy (GaussianMeasure.stdGaussianPi n) (fun x => (g x)^2) ≤\n      2 * ∫ x, gradNormSq n g x ∂(GaussianMeasure.stdGaussianPi n) := by\n  have hf_meas : Measurable (fun x => (g x)^2) :=\n    hg_diff.continuous.measurable.pow_const 2\n  have hf_nn : 0 ≤ᵐ[GaussianMeasure.stdGaussianPi n] (fun x => (g x)^2) :=\n    Eventually.of_forall (fun x => sq_nonneg (g x))\n  have hf_int : Integrable (fun x => (g x)^2) (GaussianMeasure.stdGaussianPi n) :=\n    (hg.1).integrable_sq\n  have h_subadd :=\n    SubAddEnt.entropy_subadditive (μs := fun _ : Fin n => gaussianReal 0 1)\n      (f := fun x => (g x)^2) hf_meas hf_nn hf_int (by\n        simpa [GaussianMeasure.stdGaussianPi] using hg_log_int)\n  have h_bound :=\n    sum_expected_condEnt_le_grad_norm n g hg hg_diff hg_grad_cont hg_log_int\n",
      "source_anchors": [
        {
          "pin": "SLT-TENSOR",
          "start_line": 459,
          "end_line": 479
        }
      ],
      "canonical_api": "GaussianLSI.gaussian_logSobolev_W12_pi (bounded459–479 prefix only)",
      "proof_status": "existing pinned local API source; no fresh compilation or new ASTIS producer credit"
    },
    {
      "id": "S-ENTROPY",
      "kind": "PINNED_API_DECLARATION",
      "statement": "/-- The entropy of a nonnegative function f with respect to measure μ.\n    Ent_μ(f) = ∫ f * log(f) dμ - (∫ f dμ) * log(∫ f dμ)\n\n    This measures the \"spread\" of f relative to a constant function with the same integral.\n    When ∫ f dμ = 1 (f is a probability density), this reduces to the negative\n    of Shannon entropy: Ent_μ(f) = ∫ f log f dμ. -/\ndef entropy (μ : Measure Ω) (f : Ω → ℝ) : ℝ :=\n  ∫ ω, f ω * log (f ω) ∂μ - (∫ ω, f ω ∂μ) * log (∫ ω, f ω ∂μ)\n",
      "source_anchors": [
        {
          "pin": "SLT-ENTROPY",
          "start_line": 42,
          "end_line": 49
        }
      ],
