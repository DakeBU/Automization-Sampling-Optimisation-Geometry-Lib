M='.lake/packages/mathlib/Mathlib/'
apifiles=['MeasureTheory/Measure/ProbabilityMeasure.lean','Topology/ContinuousMap/BoundedCompactlySupported.lean','Topology/Algebra/Support.lean','Analysis/Calculus/Deriv/Support.lean','Analysis/Calculus/ContDiff/Deriv.lean','Analysis/SpecialFunctions/Log/NegMulLog.lean','MeasureTheory/Function/LocallyIntegrable.lean','MeasureTheory/Function/L1Space/Integrable.lean','MeasureTheory/Integral/Bochner/Basic.lean','MeasureTheory/MeasurableSpace/Basic.lean','MeasureTheory/Measure/Typeclasses/Finite.lean','Probability/Distributions/Gaussian/Real.lean']
files=[P/'source-detail-packet.json',P/'run.closed.json',Path(prior['primary_source']['raw']['path']),*(Path(x['snapshot']['path']) for x in fragments),sealpath,sigpath,*sltpaths,*(Path(M+x) for x in apifiles),Path('lean-toolchain'),Path('lake-manifest.json'),Path('.agents/skills/astis-source-dependency-audit/SKILL.md')]
inputs=[]
for i,p in enumerate(files):
 b=p.read_bytes();a=R/f'input.{i:03}.raw.snapshot';l=R/f'input.{i:03}.lf.snapshot';a.write_bytes(b);l.write_bytes(b.replace(b'\r\n',b'\n'));inputs.append({**desc(p),'raw_snapshot':a.as_posix(),'lf_snapshot':l.as_posix()})
api=[
 {'name':'MeasureTheory.ProbabilityMeasure.tendsto_iff_forall_integral_tendsto','file':M+apifiles[0],'line':346,'actual_contract':'Tendsto probability laws iff all actual real BCF Bochner integrals tend; no test-integral-limit premise in final proposed producer.'},
 {'name':'ofCompactSupport (root namespace)','file':M+apifiles[1],'line':83,'actual_contract':'g : alpha -> gamma, Continuous g, HasCompactSupport g -> alpha ->ᵇ gamma, under NonUnitalNormedRing gamma. Here gamma=R. Its toFun is literally g; empty support included. Root namespace, not BoundedContinuousFunction.ofCompactSupport.'},
 {'name':'HasCompactSupport.comp_left','file':M+apifiles[2],'line':282,'actual_contract':'Generated additive theorem of HasCompactMulSupport.comp_left: compact support of f and g(0)=0 -> compact support of g composed with f. No continuity of g needed for this support fact. Use g(t)=t^2 or g(t)=t*log t; both vanish0.'},
 {'name':'HasCompactSupport.deriv / tsupport_deriv_subset','file':M+apifiles[3],'line':60,'actual_contract':'Compact derivative support derived from genuine local-zero property, no derivative continuity or C-infinity hypothesis. Continuity separately from C2.'},
 {'name':'ContDiff.continuous_deriv','file':M+apifiles[4],'line':108,'actual_contract':'ContDiff R n f and 1<=n -> Continuous(deriv f). For n=2 actual classical derivative, not arbitrary totalized fderiv representative.'},
 {'name':'Real.continuous_mul_log / Continuous.mul_log','file':M+apifiles[5],'line':45,'actual_contract':'Entire real t -> t log t is continuous, including t=0 (and negative t); follows actual zero-limit proof. Composition with f^2 works at zeros, no f>0 or mass>0 premise.'},
 {'name':'MeasureTheory.Continuous.integrable_of_hasCompactSupport','file':M+apifiles[6],'line':622,'actual_contract':'Continuous real observable and genuine compact support imply Integrable for a measure finite on compact sets with Borel/open-measurable topology. A probability measure supplies finite/local-finite/finite-on-compact instances; no final L1 binder needed.'},
 {'name':'MeasureTheory.integrable_map_measure / Integrable.comp_measurable','file':M+apifiles[7],'line':356,'actual_contract':'For real observer AEStronglyMeasurable on map and actual measurable S_N, L1(map law) iff L1(observable composed S_N); transfer genuine domains to actual count measure.'},
 {'name':'MeasureTheory.integral_map_of_stronglyMeasurable / integral_map','file':M+apifiles[8],'line':1032,'actual_contract':'Actual map identity gives equal Bochner integrals. The API totalizes nonintegrable integrals; proposed producer must independently output L1 rather than treating equality as evidence of integrability.'},
 {'name':'MeasureTheory.measurable_of_finite','file':M+apifiles[9],'line':291,'actual_contract':'Finite domain plus MeasurableSingletonClass -> actual map measurable. True Fin N -> Bool canonical pi sigma algebra satisfies required singleton condition, including N0.'},
 {'name':'IsFiniteMeasure.toIsLocallyFiniteMeasure and local-finite/finite-on-compacts instance','file':M+apifiles[10],'line':291,'actual_contract':'Probability laws have finite mass1; on R this derives locally finite/finite on compacts. Alternate proof can use continuous BCF norm bound plus finite mass.'},
 {'name':'ProbabilityTheory.gaussianReal','file':M+apifiles[11],'line':24,'actual_contract':'Second parameter is variance, not standard deviation. Use exact gaussianReal0,1 from35 signature and ⟨gaussianReal0,1,inferInstance⟩ as ProbabilityMeasure.'}
]
for row in api:assert Path(row['file']).exists()
placeholder=[]
