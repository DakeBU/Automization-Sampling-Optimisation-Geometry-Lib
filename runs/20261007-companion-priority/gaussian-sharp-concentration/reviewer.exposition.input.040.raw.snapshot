</details><details class="declaration" id="decl-autosamplingtheory-technicallemmas-probability-gaussianlipschitzexponent-835f56adfb">
  <summary><span class="kind">theorem</span> <code>AutoSamplingTheory.TechnicalLemmas.Probability.GaussianLipschitzExponential.rotated_laplace_bound</code> <span class="status status-yellow">Partial</span> <span class="status status-gray">Not mapped</span></summary>
  <div class="declaration-content">
    <p class="muted">No declaration docstring.</p>
    <pre class="code-block"><code class="language-lean">private theorem rotated_laplace_bound {f : E → ℝ} {L : ℝ≥0}
    (hf : LipschitzWith L f) (t m θ : ℝ) (p : E × E) :
    Real.exp (t * (f (rotX θ p) - m)) ≤
      Real.exp (|t| * (|f 0| + |m|)) * Real.exp ((2 * |t| * (L : ℝ)) * ‖p‖) := by
  rw [← Real.exp_add]
  apply Real.exp_le_exp.mpr
  have hfrot : |f (rotX θ p)| ≤ (L : ℝ) * (2 * ‖p‖) + |f 0| :=
    (lipschitz_growth_bound hf _).trans
      (add_le_add (mul_le_mul_of_nonneg_left (norm_rotX_le θ p) L.coe_nonneg) le_rfl)
  calc
    _ ≤ |t * (f (rotX θ p) - m)| := le_abs_self _
    _ = |t| * |f (rotX θ p) - m| := abs_mul _ _
    _ ≤ |t| * (|f (rotX θ p)| + |m|) :=
      mul_le_mul_of_nonneg_left (abs_sub _ _) (abs_nonneg _)
    _ ≤ |t| * ((L : ℝ) * (2 * ‖p‖) + |f 0| + |m|) :=
      mul_le_mul_of_nonneg_left (add_le_add hfrot le_rfl) (abs_nonneg _)
    _ = _ := by ring</code></pre>
    <p class="source-links"><a href="../modules/autosamplingtheory-technicallemmas-probability-gaussianlipschitzexponential.html#complete-module-source">AutoSamplingTheory/TechnicalLemmas/Probability/GaussianLipschitzExponential.lean:339</a><span>local preview source</span></p>
    
  </div>
</details><details class="declaration" id="decl-autosamplingtheory-technicallemmas-probability-gaussianlipschitzexponent-aad4665461">
  <summary><span class="kind">theorem</span> <code>AutoSamplingTheory.TechnicalLemmas.Probability.GaussianLipschitzExponential.rotated_laplace_value_integrable</code> <span class="status status-yellow">Partial</span> <span class="status status-gray">Not mapped</span></summary>
  <div class="declaration-content">
    <p class="muted">No declaration docstring.</p>
    <pre class="code-block"><code class="language-lean">private theorem rotated_laplace_value_integrable {f : E → ℝ} {L : ℝ≥0}
    (hf : LipschitzWith L f) (t m θ : ℝ) :
    Integrable (fun p : E × E =&gt; f p.1 * Real.exp (t * (f (rotX θ p) - m)))
      ((stdGaussian E).prod (stdGaussian E)) := by
  let C : ℝ := (L : ℝ) + |f 0|
  let B : ℝ := Real.exp (|t| * (|f 0| + |m|))
  let A : ℝ := 2 * |t| * (L : ℝ)
  have hcont := hf.continuous
  apply ((gaussian_polynomial_radial_integrable
    (μ := (stdGaussian E).prod (stdGaussian E)) A).const_mul (C * B)).mono&#x27;
    (by unfold rotX; fun_prop)
  filter_upwards with p
  change ‖f p.1 * Real.exp (t * (f (rotX θ p) - m))‖ ≤
    (C * B) * ((1 + ‖p‖)^2 * Real.exp (A * ‖p‖))
  have hc : 0 ≤ C := by dsimp [C]; positivity
  have hg : |f p.1| ≤ C * (1 + ‖p‖) := by
    have h := (lipschitz_growth_bound hf p.1).trans
      (add_le_add (mul_le_mul_of_nonneg_left (norm_fst_le p) L.coe_nonneg) le_rfl)
    dsimp [C]
    nlinarith [norm_nonneg p, abs_nonneg (f 0)]
  have hp : 1 + ‖p‖ ≤ (1 + ‖p‖)^2 := by nlinarith [norm_nonneg p]
  rw [norm_mul, Real.norm_eq_abs (f p.1), Real.norm_eq_abs,
    abs_of_pos (Real.exp_pos _)]
  calc
    _ ≤ (C * (1 + ‖p‖)) * (B * Real.exp (A * ‖p‖)) :=
      mul_le_mul hg (rotated_laplace_bound hf t m θ p) (Real.exp_pos _).le
        (mul_nonneg hc (by positivity))
    _ = (C * B * Real.exp (A * ‖p‖)) * (1 + ‖p‖) := by ring
    _ ≤ (C * B * Real.exp (A * ‖p‖)) * (1 + ‖p‖)^2 :=
