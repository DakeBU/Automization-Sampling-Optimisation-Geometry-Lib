        "mathtext": "$\\alpha I\\preceq\\nabla^{2}V(x)\\preceq\\beta I\\,,\\hskip 20.00003ptx\\in\\mathbb{R}^{d}\\,,\\hskip 20.00003pt\\kappa\\coloneqq\\tfrac{\\beta}{\\alpha}\\,.$\n\n(1.1)\n",
        "disposition": "NODE",
        "classification": "selected-source-node",
        "reason": "Standing C²/Hessian convention; upper Hessian control yields the Lipschitz background used here.",
        "overlap_policy": "Nested paragraph/theorem/display records overlap intentionally; coverage is by source region, not a theorem-count metric.",
        "compiled76_projection": {
          "status": "source-standing-input",
          "current_BODY_or_definition_lines": [
