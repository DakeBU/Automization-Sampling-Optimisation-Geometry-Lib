{
  "schema_version": 1,
  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.Analysis.WeakGradientZero.ordinary_weak_zero_gradient_ae_constant",
      "title": "Actual ordinary weak zero-gradient is AE constant",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06905v1#A3.SS1",
          "label": "PBPS AppendixC.1 authored analytic prerequisite",
          "scope": "Full finite real Hilbert/Borel E including0 and actual full-space volume. Genuine locally-volume-L1 u, all C1 compact directional tests with legal integrable products and zero weak derivative imply ONE real constant volume-AE. Actual normalized Gibbs W C1/exp(-W) integrable, SAME original exact compact-smooth graph D and closability give closed-gradient-zero implies weighted-AE constant. Actual PBPS common Gaussian J/R/S and original dense D_y precede ALL closure-domain u; source C2 curvature/eta cap/positive partitions retained but no additional curvature is needed by the generic kernel leaf. Only one direction; constants-domain converse, full kernel equality, centered residual/epsilon0/range/Poincare/BL/core and both main/composition remain open. No global-volume integrability of constants, classical differentiability of rough u, Nontrivial E, final kernel certificate, spectral gap or joint fiber selector. TV never transfers unbounded cost."
        }
      ],
      "tests": [
        "lake build Tests.WeakGradientZeroKernel"
      ],
      "assumptions": [
        "E is a full finite real Hilbert/Borel space with its canonical full-space volume, including dimension0; its vector-space connectedness and nonzero Haar volume are used. Real u is genuinely LocallyIntegrable against volume; it need not be globally volume integrable.",
        "For EVERY real C1 compactly supported test psi and EVERY direction a, u(x)*D_a psi(x) is genuinely integrable against volume and its integral is0. No classical derivative of the rough u is assumed."
      ],
      "statement": "A genuine locally-volume-integrable rough real function whose every legal C1 compact directional weak derivative is zero is volume-AE ONE real constant, including0.",
      "formula": "\\left[\\forall\\psi\\in C_c^1(E),a\\in E:\\ \\int_EuD_a\\psi\\,dx=0\\right]\\Longrightarrow\\exists c\\in\\mathbb R:\\ u=c\\quad dx\\text{-a.e.}",
      "boundary": "Full finite real Hilbert/Borel E including0 and actual full-space volume. Genuine locally-volume-L1 u, all C1 compact directional tests with legal integrable products and zero weak derivative imply ONE real constant volume-AE. Actual normalized Gibbs W C1/exp(-W) integrable, SAME original exact compact-smooth graph D and closability give closed-gradient-zero implies weighted-AE constant. Actual PBPS common Gaussian J/R/S and original dense D_y precede ALL closure-domain u; source C2 curvature/eta cap/positive partitions retained but no additional curvature is needed by the generic kernel leaf. Only one direction; constants-domain converse, full kernel equality, centered residual/epsilon0/range/Poincare/BL/core and both main/composition remain open. No global-volume integrability of constants, classical differentiability of rough u, Nontrivial E, final kernel certificate, spectral gap or joint fiber selector. TV never transfers unbounded cost.",
      "steps": [
        {
          "title": "Differentiate the true compact convolution",
          "text": "For a genuine compact C1 kernel phi and rough locally-integrable u, the actual convolution has a genuine Frechet derivative, given by convolution with Dphi through the real scalar bilinear map. This is actual HasFDerivAt, not totalized fderiv zero alone.",
          "formula": "D(\\phi*u)(x)[a]=\\int u(y)D\\phi(x-y)[a]\\,dy.",
          "lean": "HasCompactSupport.hasFDerivAt_convolution_left; convolution_derivative_zero"
        },
        {
          "title": "Use the translated legal weak test with the minus sign",
          "text": "For fixed x/a take psi(y)=phi(x-y). A true subtraction homeomorphism preserves compact support, and the genuine chain rule gives D_a psi(y)=-Dphi(x-y)[a]. The legal zero weak integral therefore kills the convolution derivative; convolution_flip/precompR identify the actual bilinear integral, with scalar multiplication order checked.",
          "formula": "\\psi_{x}(y)=\\phi(x-y),\\quad D_a\\psi_x(y)=-D\\phi(x-y)[a],\\quad D(\\phi*u)(x)=0.",
          "lean": "convolution_derivative_zero; convolution_flip; convolution_precompR_apply"
        },
        {
          "title": "Choose actual normalized shrinking compact bumps",
          "text": "Set inner radius1/(n+1), outer radius2/(n+1). Both radii are positive, the outer radius tends to0, and their ratio is exactly2. Genuine normalized ContDiffBump kernels give actual almost-everywhere convolution convergence for locally integrable u; no global volume integrability is used.",
          "formula": "\\rho_n: r_{in}=1/(n+1),\\ r_{out}=2/(n+1),\\quad\\rho_n*u\\to u\\quad dx\\text{-a.e.}",
          "lean": "ContDiffBump.ae_convolution_tendsto_right_of_locallyIntegrable; ordinary_weak_zero_gradient_ae_constant"
        },
        {
          "title": "Apply mean-value constancy to genuine differentiable mollifications",
          "text": "Each actual mollification is differentiable with zero derivative at EVERY point, hence constant on the full real vector space. The connected full-space domain matters: a disconnected/open-domain replacement would only give component-wise constants.",
          "formula": "(\\rho_n*u)(x)=(\\rho_n*u)(x_0)\\quad\\forall n,x,x_0.",
          "lean": "is_const_of_fderiv_eq_zero; convolution_derivative_zero"
        },
        {
          "title": "Extract ONE constant by true AE convergence",
          "text": "Nonzero canonical Haar volume makes the AE convergence set nonempty. Fix x0 in that set. The SAME constant sequence at every other AE convergence point has limits u(x) and u(x0); uniqueness of limits yields ONE real c=u(x0). Dimension0 is included with no division by dimension or Nontrivial assumption. The focused nonzero7 test is locally integrable yet not globally volume integrable.",
          "formula": "c=u(x_0),\\qquad u(x)=c\\quad dx\\text{-a.e.}",
          "lean": "Filter.Eventually.exists; tendsto_nhds_unique; Tests.WeakGradientZeroKernel.actual_noncompact_seven_weak_zero"
        }
      ],
      "lean_statement": "A genuine locally-volume-integrable rough real function whose every legal C1 compact directional weak derivative is zero is volume-AE ONE real constant, including0.",
      "lean_proof": "Differentiate the true compact convolution; Use the translated legal weak test with the minus sign; Choose actual normalized shrinking compact bumps; Apply mean-value constancy to genuine differentiable mollifications; Extract ONE constant by true AE convergence",
      "astis_dependencies": [],
      "mathlib_dependencies": [
        "HasCompactSupport.hasFDerivAt_convolution_left",
        "convolution_flip",
        "convolution_precompR_apply",
        "ContDiffBump.ae_convolution_tendsto_right_of_locallyIntegrable",
        "is_const_of_fderiv_eq_zero",
        "Filter.Eventually.exists",
        "tendsto_nhds_unique"
      ]
    }
  ]
}
