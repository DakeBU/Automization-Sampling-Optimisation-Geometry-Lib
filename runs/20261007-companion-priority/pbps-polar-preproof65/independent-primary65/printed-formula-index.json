    {
      "literal_alttexts": [
        "\\mathsf{U}=\\begin{pmatrix}\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}&\\mathsf{U}_{\\perp\\mathsf{P}}^{*}\\\\\n\\mathsf{U}_{\\perp\\mathsf{P}}&\\mathsf{U}_{\\perp\\perp}\\end{pmatrix}\\,."
