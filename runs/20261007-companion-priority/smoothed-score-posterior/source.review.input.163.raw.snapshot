<math id="S4.SS1.p4.m1" class="ltx_Math" alttext="\nabla V(x_{y}^{+})=(y-x_{y}^{+})/\eta" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>y</mi><mo>+</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>y</mi><mo>−</mo><msubsup><mi>x</mi><mi>y</mi><mo>+</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>η</mi></mrow></mrow><annotation encoding="application/x-tex">\nabla V(x_{y}^{+})=(y-x_{y}^{+})/\eta</annotation></semantics></math>