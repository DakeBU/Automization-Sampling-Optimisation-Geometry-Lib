      "targetText": "4. Descend by injectivityEvaluate on the embedded real vector;exact intertwining and norm-injectivity recover real commutation.ιGDu=GCDCιu=DCGCιu=ιDGu⇒GD=DG.Corresponding Lean step  let e : Lp ℝ 2 μ →ₗᵢ[ℝ] Lp ℂ 2 μ :=\n    { toLinearMap := ι.toLinearMap, norm_map' := hNorm }\n  apply ContinuousLinearMap.ext\n  intro u\n  apply e.injective\n  change ι (G (D u))=ι (D (G u))\n  rw [← hGi (D u), ← hDi u, ← hDi (G u), ← hGi u]\n  exact congrArg (fun A : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ => A (ι u)) hLift.eq\nLiteral compiled BODY span;exact preceding locals remain in scope.",
