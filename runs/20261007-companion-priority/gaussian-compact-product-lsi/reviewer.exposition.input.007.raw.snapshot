    <pre class="code-block"><code class="language-lean">private theorem empty_entropy (f : (Fin 0 → ℝ) → ℝ) :
    (∫ x, (f x)^2 * Real.log ((f x)^2)
      ∂Measure.pi (fun _ : Fin 0 =&gt; gaussianReal 0 1)) -
