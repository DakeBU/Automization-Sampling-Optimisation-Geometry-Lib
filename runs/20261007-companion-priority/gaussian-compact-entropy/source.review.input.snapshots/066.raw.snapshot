from pathlib import Path
import json,hashlib,subprocess,sys,datetime,re
sys.path.insert(0,'tools')
import astis
R=Path('runs/20261007-companion-priority/gaussian-compact-entropy-preread')
V='picard_commit_verifier_20261005'
def sha(b):return hashlib.sha256(b).hexdigest()
def desc(p):
 b=Path(p).read_bytes();return {'path':Path(p).as_posix(),'raw_sha256':sha(b),'lf_sha256':sha(b.replace(b'\r\n',b'\n')),'bytes':len(b)}
def j(p):return json.loads(Path(p).read_text(encoding='utf-8'))
def w(p,x):Path(p).write_bytes((json.dumps(x,ensure_ascii=False,indent=2)+'\n').encode())
assert not (R/'source-detail-packet.json').exists()
w(R/'lease.open.json',{'status':'OPEN','reviewer_id':V,'read':'primary/pinnedSLT/pinnedMathlib/earlier own CLOSED preread and public35 seal only','write':'own36 preread evidence only','compiler':'NOT_STARTED','canonical_mutations':False})
P=Path('runs/20261007-companion-priority/gaussian-clt-entropy-preread')
prior=j(P/'source-detail-packet.json')
assert desc(P/'source-detail-packet.json')['raw_sha256']=='158fe4583cc964e6132c19043a11a79197ffc9e14f4a4af8a16762095670835d'
raw=Path(prior['primary_source']['raw']['path']).read_bytes()
assert sha(raw)==prior['primary_source']['raw']['raw_sha256']
fragments=prior['primary_source']['canonical_outer_fragments']
for f in fragments:
 assert raw[f['UTF8_start']:f['UTF8_end']]==Path(f['snapshot']['path']).read_bytes()
