  "source_expansion_nodes": [
    {
      "id": "gaussian-sqrt-density-domain:reader-step-1",
      "title": "Derive the nonnegative residual and gradient growth",
      "formula": "\\rho(0)=0,\\quad\\nabla\\rho(0)=0,\\quad0\\preceq\\nabla^2\\rho\\preceq LI\\ \\Longrightarrow\\ \\rho\\ge0,\\ \\|\\nabla\\rho(u)\\|\\le L\\|u\\|.",
      "proof_ingredient": "QuadraticRegularization.strongConvexOn_and_lipschitzWith_gradient_add_quadratic; StrongConvexFirstOrder.firstOrder_lower_bound_of_strongConvexOn",
      "source_status": "authored sufficient prerequisite, not numbered theorem"
    },
    {
      "id": "gaussian-sqrt-density-domain:reader-step-2",
      "title": "Normalize against the actual standard Gaussian",
      "formula": "\\gamma=\\mathcal N(0,I),\\quad Z=\\int e^{-\\rho}d\\gamma\\in(0,1],\\quad q=e^{-\\rho}/Z,\\quad r=q\\gamma,\\quad\\int q\\,d\\gamma=1.",
      "proof_ingredient": "weight_normalization; isProbabilityMeasure_tilted; integral_div",
      "source_status": "authored sufficient prerequisite, not numbered theorem"
    },
    {
      "id": "gaussian-sqrt-density-domain:reader-step-3",
      "title": "Identify the canonical volume Gibbs law",
      "formula": "\\gamma=Z_0^{-1}e^{-\\|u\\|^2/2}du,\\quad r=Z_Q^{-1}e^{-\\|u\\|^2/2-\\rho(u)}du.",
      "proof_ingredient": "IsotropicGaussianDensity.map_sqrt_smul_stdGaussian_eq_withDensity; integral_withDensity_eq_integral_toReal_smul; tilted_tilted",
      "source_status": "authored sufficient prerequisite, not numbered theorem"
    },
    {
      "id": "gaussian-sqrt-density-domain:reader-step-4",
      "title": "Differentiate the explicit positive square root",
      "formula": "f=\\frac{e^{-\\rho/2}}{\\sqrt Z},\\quad f^2=q,\\quad\\nabla f=-\\tfrac12f\\nabla\\rho,\\quad\\nabla\\log q=-\\nabla\\rho.",
      "proof_ingredient": "density_calculus; HasFDerivAt.exp; hasGradientAt_iff_hasFDerivAt; Real.log_div",
      "source_status": "authored sufficient prerequisite, not numbered theorem"
    },
    {
      "id": "gaussian-sqrt-density-domain:reader-step-5",
      "title": "Produce the finite gradient and entropy domains",
      "formula": "e^{-\\rho}\\|\\nabla\\rho\\|^2\\le L^2\\|u\\|^2,\\quad\\int\\|u\\|^2d\\gamma=d,\\quad0\\le\\rho e^{-\\rho}\\le1,\\quad q\\log q=-Z^{-1}\\rho e^{-\\rho}-q\\log Z.",
      "proof_ingredient": "StdGaussianMoment.integrable_norm_sq_and_integral_stdGaussian; integrable_tilted_iff; memLp_two_iff_integrable_sq_norm; entropy_integrable",
      "source_status": "authored sufficient prerequisite, not numbered theorem"
    },
    {
      "id": "gaussian-sqrt-density-domain:reader-step-6",
      "title": "Integrate the exact Dirichlet-Fisher identity",
      "formula": "\\int\\|\\nabla f\\|^2d\\gamma=\\frac14\\int q\\|\\nabla\\rho\\|^2d\\gamma=\\frac14\\int\\|\\nabla\\rho\\|^2dr.",
      "proof_ingredient": "integral_tilted; integral_const_mul; integral_congr_ae",
      "source_status": "authored sufficient prerequisite, not numbered theorem"
    },
    {
      "id": "sphmc-standardized-rgo-sqrt-density:reader-step-1",
      "title": "Reuse the true posterior and the same stationary point",
      "formula": "p_s+\\eta_s\\nabla V(p_s)=y_s,\\quad r_s=(x\\mapsto\\eta_s^{-1/2}(x-p_s))_\\#R_s,\\quad\\rho_s(u)=V(p_s+\\sqrt{\\eta_s}u)-V(p_s)-\\sqrt{\\eta_s}\\langle\\nabla V(p_s),u\\rangle.",
      "proof_ingredient": "StandardizedRGOPositionFisher.standardized_rgo_position_and_fisher",
      "source_status": "actual Ex8 true standardized RGO residual consumer, domain conclusions only"
    },
