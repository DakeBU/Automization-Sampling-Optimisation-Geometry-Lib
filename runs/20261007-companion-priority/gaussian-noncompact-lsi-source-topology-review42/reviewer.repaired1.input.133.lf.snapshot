          ]
        ],
        "literal": "@[to_additive] lemma mabs_of_le_one (h : a ≤ 1) : |a|ₘ = a⁻¹ :=\n  sup_eq_right.2 <| h.trans (one_le_inv'.2 h)",
        "kind": "to_additive generated alias of mabs_of_le_one; no compiler claim"
      },
      {
        "path": ".lake/packages/mathlib/Mathlib/Algebra/Order/Group/Unbundled/Abs.lean",
        "raw_sha256": "4c81abf30adc1e6c0f54a2ab05df81ba2e5aa930a7ad9b1caa465ab1c4fd16dc",
        "lf_sha256": "7991bf23c32cc89e3a8f5cf0f054ddf49e84aa8326cbf5609e4addd70d8091da",
        "bytes": 13104,
        "selected_ranges": [
          [
            90,
            91
          ]
        ],
        "literal": "@[to_additive] lemma mabs_of_one_le (h : 1 ≤ a) : |a|ₘ = a :=\n  sup_eq_left.2 <| (inv_le_one'.2 h).trans h",
        "kind": "to_additive generated alias of mabs_of_one_le; no compiler claim"
      },
      {
        "path": ".lake/packages/mathlib/Mathlib/Analysis/Normed/Group/Basic.lean",
        "raw_sha256": "59170354e6f426acb5e881cf588dc8288defc1b9c06b825b61c822de883b1f95",
        "lf_sha256": "85d307e042cb03073a2e9160c52adbfcef85c921d2f9b17584b13597d8a5c7bc",
        "bytes": 46499,
        "selected_ranges": [
          [
            96,
            99
          ]
        ],
        "literal": "/-- **Triangle inequality** for the norm. -/\n@[to_additive norm_add_le /-- **Triangle inequality** for the norm. -/]\ntheorem norm_mul_le' (a b : E) : ‖a * b‖ ≤ ‖a‖ + ‖b‖ := by\n  simpa [dist_eq_norm_inv_mul] using dist_triangle a⁻¹ 1 b",
        "kind": "explicit to_additive generated alias of norm_mul_le'; no compiler claim"
      },
      {
        "path": ".lake/packages/mathlib/Mathlib/Analysis/Normed/Group/Basic.lean",
        "raw_sha256": "59170354e6f426acb5e881cf588dc8288defc1b9c06b825b61c822de883b1f95",
        "lf_sha256": "85d307e042cb03073a2e9160c52adbfcef85c921d2f9b17584b13597d8a5c7bc",
        "bytes": 46499,
        "selected_ranges": [
          [
            50,
            52
          ]
        ],
        "literal": "\n@[to_additive (attr := simp)]\ntheorem dist_one_right (a : E) : dist a 1 = ‖a‖ := by rw [dist_eq_norm_inv_mul', inv_one, one_mul]",
        "kind": "to_additive generated alias of dist_one_right; no compiler claim"
      },
      {
        "path": ".lake/packages/mathlib/Mathlib/Algebra/Order/Group/Unbundled/Basic.lean",
        "raw_sha256": "353381905d033211f78aade9471953d39d34ead37885c63d364a01015ef2f329",
        "lf_sha256": "9dc6db27461e003deadd29aa1f22ed6dae2611dd5ea00d9d53a048047c1bf5a8",
        "bytes": 24585,
        "selected_ranges": [
          [
            453,
            455
          ]
        ],
        "literal": "alias one_le_inv' := Left.one_le_inv_iff\n\nattribute [to_additive neg_nonneg] one_le_inv'",
        "kind": "explicit to_additive alias of one_le_inv'; no compiler claim"
      }
