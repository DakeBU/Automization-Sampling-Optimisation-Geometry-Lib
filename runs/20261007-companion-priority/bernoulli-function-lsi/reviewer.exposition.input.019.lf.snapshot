</details><details class="declaration" id="decl-autosamplingtheory-technicallemmas-functionalinequalities-bernoullilogso-e62f181ed2">
  <summary><span class="kind">theorem</span> <code>AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.BernoulliLogSobolev.flipCoord_last_snoc</code> <span class="status status-yellow">Partial</span> <span class="status status-gray">Not mapped</span></summary>
  <div class="declaration-content">
    <p class="muted">No declaration docstring.</p>
    <pre class="code-block"><code class="language-lean">private theorem flipCoord_last_snoc {n : ℕ} (ε&#x27; : Fin n → Bool) (b : Bool) :
    flipCoord (Fin.last n) (Fin.snoc ε&#x27; b) = Fin.snoc ε&#x27; (!b) := by
  ext i
  by_cases h : i = Fin.last n
  · simp only [h, flipCoord_same, Fin.snoc_last]
  · have hi : i.val &lt; n := by
      have hlt := i.isLt
      have hne : i.val ≠ n := by
        intro heq
        apply h; ext; simp [Fin.last, heq]
      omega
    have hne&#x27; : i ≠ Fin.last n := fun heq =&gt; h heq
    rw [flipCoord_noteq (Fin.last n) i _ hne&#x27;]
    simp only [Fin.snoc, hi, ↓reduceDIte]</code></pre>
