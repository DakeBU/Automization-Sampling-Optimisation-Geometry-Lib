    },
    {
      "claim": "For every y,xRef:E, z:E x E and e,t:NNReal: tau(e)<=extended(t) iff real(e)<=Lambda(t).",
      "group": 5
    },
    {
      "claim": "For every y,xRef:E, z:E x E and e:NNReal: tau(e)=infinity iff for every t:NNReal Lambda(t)<real(e); tau(e)!=infinity implies Lambda(untopA(tau(e)))=real(e); e>0 implies extended(0)<tau(e); tau(0)=extended(0).",
      "group": 6
    },
    {
      "claim": "Joint measurability of (y,xRef,z,e) |-> tau(y,xRef,z,e) into WithTop NNReal.",
      "group": 7
    },
    {
      "claim": "For every y,xRef:E and z:E x E: IsProbabilityMeasure(W(y,xRef,z)); for every t:NNReal W.real(Ioi(extended(t)))=exp(-Lambda(t)).",
      "group": 8
    },
    {
      "claim": "For every y,xRef:E and z:E x E: C>=0 and for every t:NNReal Lambda(t)<=C*real(t).",
      "group": 9
    },
    {
      "claim": "For every y,xRef:E, z:E x E and e:NNReal: C>0 implies extended(toNNReal(real(e)/C))<=tau(e); C=0 and e>0 imply tau(e)=infinity.",
      "group": 10
    }
  ],
