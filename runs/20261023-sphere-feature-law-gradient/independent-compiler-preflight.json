      "complete_source_signature": "theorem unit_sphere_angular_cost_properties\n    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]\n    [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] :\n    let S := {w : E // ‖w‖ = 1}\n    let c : S × S → ℝ := fun z => Real.arccos ⟪z.1.1,z.2.1⟫_ℝ\n    Continuous c ∧ Measurable c ∧\n      (∀ u v : S, 0 ≤ c (u,v) ∧ c (u,v) ≤ Real.pi ∧\n        c (u,v) = InnerProductGeometry.angle u.1 v.1 ∧\n        ‖u.1-v.1‖ ≤ c (u,v) ∧\n        (c (u,v) = 0 ↔ u = v) ∧ c (u,v) = c (v,u)) ∧\n      ∀ u v w : S, c (u,w) ≤ c (u,v)+c (v,w)",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.Geometry.UnitSphereAngularCost.unit_sphere_angular_cost_properties",
      "imports": [
        "Mathlib.Geometry.Euclidean.Angle.Unoriented.TriangleInequality",
        "Mathlib.Analysis.SpecialFunctions.Trigonometric.Bounds",
        "Mathlib.MeasureTheory.Constructions.BorelSpace.Basic",
        "Mathlib.Tactic"
      ],
      "namespace": "AutoSamplingTheory.TechnicalLemmas.Geometry.UnitSphereAngularCost",
      "path": "AutoSamplingTheory/TechnicalLemmas/Geometry/UnitSphereAngularCost.lean",
      "signature_sha256": "855829c277c2e437e714d5894d4c4489ac4c1e6b7b2484ddd6c074daad207ae0"
    },
    {
      "complete_source_signature": "theorem quadratic_feature_law_gradient_angular_transport_control\n    {E H : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]\n    [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]\n    [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]\n    (F : E → H) (D : E → E →L[ℝ] H)\n    (hF : ∀ w, HasFDerivAt F (D w) w)\n    (M₁ M₂ : ℝ) (hM₁ : 0 ≤ M₁) (hM₂ : 0 ≤ M₂)\n    (hBound : ∀ w : E, ‖w‖ ≤ 1 → ‖D w‖ ≤ M₁)\n    (hLip : ∀ w u : E, ‖w‖ ≤ 1 → ‖u‖ ≤ 1 → ‖D w-D u‖ ≤ M₂*‖w-u‖)\n    (y : H) :\n    let S := {w : E // ‖w‖ = 1}\n    let K : S → H := fun w => F w.1\n    let c : S × S → ℝ := fun z => Real.arccos ⟪z.1.1,z.2.1⟫_ℝ\n    let m : Measure S → H := fun μ => ∫ w, K w ∂μ\n    let V : Measure S → E → ℝ := fun μ w => 2 * ⟪m μ-y,F w⟫_ℝ\n    let G : Measure S → E → E := fun μ w =>\n      (2 : ℝ) • ((D w).adjoint (m μ-y) - ⟪(D w).adjoint (m μ-y),w⟫_ℝ • w)\n    let Q : Measure S → Measure S → ℝ≥0∞ := fun μ ν =>\n      AutoSamplingTheory.TechnicalLemmas.Measure.Transport.transportCost\n        (fun z => ENNReal.ofReal ((c z)^2)) μ ν\n    ∃ C₁ C₂ : ℝ, 0 < C₁ ∧ 0 < C₂ ∧\n      (∀ μ : Measure S, IsProbabilityMeasure μ →\n        Integrable K μ ∧\n        (∀ w : E, HasGradientAt (V μ) ((2 : ℝ) • (D w).adjoint (m μ-y)) w) ∧\n        ∀ w : S, ⟪w.1,G μ w.1⟫_ℝ = 0 ∧ ‖G μ w.1‖ ≤ C₁) ∧\n      ∀ μ ν : Measure S, IsProbabilityMeasure μ → IsProbabilityMeasure ν →\n        Q μ ν ≠ ∞ ∧ ∀ w u : S,\n          ‖G μ w.1-G ν u.1‖ ≤\n            C₂ * ((Q μ ν ^ (1 / 2 : ℝ)).toReal + c (w,u))",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.Geometry.QuadraticFeatureLawGradient.quadratic_feature_law_gradient_angular_transport_control",
