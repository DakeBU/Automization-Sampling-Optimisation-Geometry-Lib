          "raw_bytes": 1616,
          "lf_bytes": 1616,
          "raw_sha256": "832e5eba8dbe8fd2b0361f4514814d7e6462b20418b04693badb9aa6122ce341",
          "lf_sha256": "832e5eba8dbe8fd2b0361f4514814d7e6462b20418b04693badb9aa6122ce341"
        },
        "byte_range": [
          1029755,
          1031371
        ],
        "literal_source_text": "\\|\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}f\\|\\leq\\frac{1-\\alpha\\eta}{1+\\alpha\\eta}\\,\\|f\\|=\\rho_{\\rm mac}\\,\\|f\\|\\,. (C.4)"
      },
