    (∀ y : Fin n → ℝ,
      ContDiff ℝ 2 (fun a : ℝ =&gt; f (Fin.cons a y)) ∧
      HasCompactSupport (fun a : ℝ =&gt; f (Fin.cons a y))) ∧
    (∀ a : ℝ,
      ContDiff ℝ 2 (fun y : Fin n → ℝ =&gt; f (Fin.cons a y)) ∧
