  "sealed_proposed_interfaces": {
    "meaning_carrying_definition": "noncomputable def singleBlockPrecision {n : ℕ} (κ : ℝ)\n    (O : Matrix.orthogonalGroup (Fin n) ℝ) : Matrix (Fin n) (Fin n) ℝ :=\n  ((κ + 1) / 2) • (1 : Matrix (Fin n) (Fin n) ℝ) -\n    ((κ - 1) / 4) • ((O : Matrix (Fin n) (Fin n) ℝ) +\n      (O : Matrix (Fin n) (Fin n) ℝ).transpose)",
    "proposed_signatures": {
      "singleBlockPrecision_factorization": "theorem singleBlockPrecision_factorization {n : ℕ} (_hn : 3 ≤ n) {κ : ℝ}\n    (hκ : 4 ≤ κ) (O : Matrix.orthogonalGroup (Fin n) ℝ) :\n    singleBlockPrecision κ O = (1 / 4 : ℝ) •\n      ((((Real.sqrt κ + 1) • (1 : Matrix (Fin n) (Fin n) ℝ) -\n        (Real.sqrt κ - 1) • (O : Matrix (Fin n) (Fin n) ℝ)).transpose) *\n       ((Real.sqrt κ + 1) • (1 : Matrix (Fin n) (Fin n) ℝ) -\n        (Real.sqrt κ - 1) • (O : Matrix (Fin n) (Fin n) ℝ)))",
      "singleBlockPrecision_sqrt_det": "theorem singleBlockPrecision_sqrt_det {n : ℕ} (hn : 3 ≤ n) {κ : ℝ}\n    (hκ : 4 ≤ κ) (O : Matrix.orthogonalGroup (Fin n) ℝ) :\n    Real.sqrt (singleBlockPrecision κ O).det = (1 / (2 : ℝ) ^ n) *\n      (((Real.sqrt κ + 1) • (1 : Matrix (Fin n) (Fin n) ℝ) -\n        (Real.sqrt κ - 1) • (O : Matrix (Fin n) (Fin n) ℝ)).det)",
      "singleBlockPrecision_signed_sqrt_det": "theorem singleBlockPrecision_signed_sqrt_det {n : ℕ} (hn : 3 ≤ n) {κ : ℝ}\n    (hκ : 4 ≤ κ) (O : Matrix.orthogonalGroup (Fin n) ℝ) :\n    (O : Matrix (Fin n) (Fin n) ℝ).det * Real.sqrt (singleBlockPrecision κ O).det =\n      (1 / (2 : ℝ) ^ n) *\n      (((Real.sqrt κ + 1) • (O : Matrix (Fin n) (Fin n) ℝ) -\n        (Real.sqrt κ - 1) • (1 : Matrix (Fin n) (Fin n) ℝ)).det)"
    },
