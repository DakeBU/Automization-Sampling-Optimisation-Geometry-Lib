{
  "schema_version": 1,
  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.BernoulliLogSobolev.bernoulli_function_logSobolev",
      "title": "True finite Boolean function log-Sobolev inequality",
      "sources": [
        {
          "url": "https://github.com/YuanheZ/lean-stat-learning-theory/blob/d0f506f0a695018265dccb33bcb05e2f5ca1c876/SLT/GaussianLSI/BernoulliLSI.lean",
          "label": "bernoulli_logSobolev L1236 onward; actual law L113-L225; authored entropy/RMS induction replaces Han proof route",
          "scope": "Genuine signed two-point and true finite Bool function LSI with exact half coefficient, derived probability/L1 domains; authored direct RMS-induction route. No GaussianLSI/T2/FIRST4.6/W2/bias/main/work/composition. Focused2653 passed actual n0/indicator/signed/normalizedRademacher n2 tests; all6 prints standard3 only. Independent wholeproof/blind/source/exactcommit admission, integration and exposition remain separate."
        }
      ],
      "tests": [
        "lake build Tests.BernoulliLogSobolev"
      ],
      "assumptions": [
        "Arbitrary natural n, including0; arbitrary signed real h on all Fin n→Bool.",
        "Literal normalized counting law and full Function.update flip; probability/three L1 domains are outputs. No public inequality, smoothness or domain certificates."
      ],
      "statement": "For every finite n including zero and arbitrary signed real h on all Boolean coordinates, normalized counting measure is probability and all three integrals are genuine L1; homogeneous entropy of h squared is at most half the expectation of the unnormalized sum of full coordinate-flip squares.",
      "formula": "\\mu_n=2^{-n}\\sum_{\\varepsilon\\in\\{0,1\\}^n}\\delta_\\varepsilon,\\qquad\\operatorname{Ent}_{\\mu_n}(h^2)\\le\\frac12\\mathbb E_{\\mu_n}\\sum_{j=1}^n(h(\\varepsilon)-h(\\varepsilon^{(j)}))^2.",
      "boundary": "Genuine signed two-point and true finite Bool function LSI with exact half coefficient, derived probability/L1 domains; authored direct RMS-induction route. No GaussianLSI/T2/FIRST4.6/W2/bias/main/work/composition. Focused2653 passed actual n0/indicator/signed/normalizedRademacher n2 tests; all6 prints standard3 only. Independent wholeproof/blind/source/exactcommit admission, integration and exposition remain separate.",
      "steps": [
        {
          "title": "Use the actual finite law",
          "text": "Construct probability from normalized counting measure and actual cardinal2^n. Finite Bochner integrability is derived, and Fin.snoc gives the true balanced last-coordinate integral decomposition.",
          "formula": "\\mathbb E_{\\mu_{n+1}}F=\\mathbb E_{\\mu_n}\\frac{F(x,+)+F(x,-)}2.",
          "lean": "private probability; bernoulli_integral_succ_split; Integrable.of_finite"
        },
        {
          "title": "Exact entropy chain",
          "text": "Let g(x)=sqrt((h(x,+)²+h(x,-)²)/2). Expanding both sides under the same finite law gives an equality: the last-coordinate two-point entropy plus the entropy of g². No conditional entropy bound is assumed.",
          "formula": "\\operatorname{Ent}_{\\mu_{n+1}}(h^2)=\\mathbb E_{\\mu_n}\\operatorname{Ent}_2(h_+^2,h_-^2)+\\operatorname{Ent}_{\\mu_n}(g^2).",
          "lean": "private rms_sq; entropy_chain"
        },
        {
          "title": "Genuine RMS contraction",
          "text": "The reverse two-dimensional Euclidean norm inequality yields the squared difference bound for g across each retained coordinate. Its proof derives the Cauchy-Schwarz cross term from (ad-bc)²≥0 and actual sqrt square identities.",
          "formula": "(\\sqrt{(a^2+b^2)/2}-\\sqrt{(c^2+d^2)/2})^2\\le\\tfrac12((a-c)^2+(b-d)^2).",
          "lean": "private rms_contraction; rms_energy"
        },
        {
          "title": "Integrate the two bounds with the exact energy split",
          "text": "Use the signed two-point theorem for the last coordinate and induction for g. Summing the RMS contraction and splitting the actual full-flip energy gives the same half constant. For n=0 there is one state, zero entropy and no energy.",
          "formula": "\\operatorname{Ent}(h^2)\\le\\tfrac12\\mathbb E L+\\tfrac12\\mathbb E D_g\\le\\tfrac12\\mathbb E(L+A)=\\tfrac12\\mathbb E D_h.",
          "lean": "TwoPointEntropy.two_point_squared_entropy_le_half_sq_sub; private energy_chain; entropy_bound"
        }
      ],
      "lean_statement": "For every finite n including zero and arbitrary signed real h on all Boolean coordinates, normalized counting measure is probability and all three integrals are genuine L1; homogeneous entropy of h squared is at most half the expectation of the unnormalized sum of full coordinate-flip squares.",
      "lean_proof": "Use the actual finite law; Exact entropy chain; Genuine RMS contraction; Integrate the two bounds with the exact energy split",
      "astis_dependencies": [
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.TwoPointEntropy.two_point_squared_entropy_le_half_sq_sub"
      ],
      "mathlib_dependencies": [
        "MeasureTheory.Integrable.of_finite",
        "MeasureTheory.integral_fintype"
      ]
    }
  ]
}
