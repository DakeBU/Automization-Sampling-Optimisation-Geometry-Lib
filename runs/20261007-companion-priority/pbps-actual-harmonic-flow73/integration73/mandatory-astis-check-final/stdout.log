  (hd : 0 < ↑(Module.finrank ℝ E)) (η τ : NNReal × E × E × ℕ × (ℕ → E) → ℝ) (hη : Measurable η) (hτ : Measurable τ)
  (hη0 : ∀ (s : NNReal × E × E × ℕ × (ℕ → E)), 0 < η s) (hτ0 : ∀ (s : NNReal × E × E × ℕ × (ℕ → E)), 0 < τ s)
