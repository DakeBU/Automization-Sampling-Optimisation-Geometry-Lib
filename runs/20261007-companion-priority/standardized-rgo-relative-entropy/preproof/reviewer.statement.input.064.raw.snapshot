  "nodes": [
    {
      "id": "STANDING-V",
      "kind": "SOURCE",
      "source_anchors": [
        "S1.E1",
        "S2.p1.1"
      ],
      "formula": "C2 V, normalized kappa>=1 and kappa^-1 I<=HessV<=I",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "ETA-POSITIVE",
      "kind": "SOURCE",
      "source_anchors": [
        "S3.SS1.p1.1"
      ],
      "formula": "eta>0, arbitrary y; all positive eta, no numerical cap",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "TRUE-PROX",
      "kind": "SOURCE",
      "source_anchors": [
        "S2.E1",
        "S4.Ex3",
        "S4.SS1.p4.1"
      ],
      "formula": "Unique trueprox p minimizes V(x)+||x-y||²/(2eta); gradV(p)=(y-p)/eta",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "TRUE-RGO",
      "kind": "SOURCE",
      "source_anchors": [
        "S2.Ex1"
      ],
      "formula": "R_eta,y actual normalized Gibbs conditional mu(dx)*exp(-||x-y||²/(2eta)); mu proportional exp(-V)volume",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "ORACLE",
      "kind": "SOURCE",
      "source_anchors": [
        "S3.E2"
      ],
      "formula": "hatg_eta(y;G)=gradV(p+sqrteta G), actual G~N(0,I)",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "SMOOTHED-SCORE",
      "kind": "SOURCE",
      "source_anchors": [
        "S3.Ex1",
        "S3.SS1.p2.1",
        "S3.E1",
        "S4.Ex2",
        "S4.E1"
      ],
      "formula": "Actual pi_eta=pi*Gaussian_eta and Veta=-log(exp(-V)*Gaussian_eta), g_eta=gradient Veta. Score conditional mean (3.1): g_eta(y)=E_R gradV(X); selected score half of (4.1): g_eta(y)=eta^-1(y-E_R X). Phase product Pi_eta and Hessian/covariance half explicitly outside this slice.",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "RHO",
      "kind": "SOURCE",
      "source_anchors": [
        "S4.Ex8"
      ],
      "formula": "rho(u)=V(p+sqrteta u)-V(p)-sqrteta<gradV(p),u>; rho0=0, gradrho0=0,0<=Hessrho<=etaI",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "STANDARDIZED-R",
      "kind": "SOURCE",
      "source_anchors": [
        "S4.SS1.p4.2"
      ],
      "formula": "r=(x->(x-p)/sqrteta)_# R; density proportional exp(-||u||²/2-rho(u))",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "W2-METRIC",
      "kind": "DEFINITION",
      "source_anchors": [
        "S4.Ex1"
      ],
      "formula": "Euclidean W2=infcouplings(sqrt integral ||x-y||²); gamma=N(0,I) actual covarianceI probability",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "DENSITY-DOMAIN-GAP",
      "kind": "SOURCE_GAP",
      "source_anchors": [
        "S4.SS1.p4.2",
        "S4.SS1.p4.3"
      ],
      "formula": "Produce actual q=exp(-rho)/Zgamma, Zgamma=Egamma exp(-rho)>0 finite; r=q gamma; sqrtq C1/W12; qlogq L1; gradrho L2(r); both laws finite2; no supplied certificate",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "GAUSSIAN-LSI-GAP",
      "kind": "SOURCE_GAP",
      "source_anchors": [
        "S4.SS1.p4.3"
      ],
      "formula": "Variance1 Gaussian LSI Ent_gamma(f²)<=2 integral||gradf||², on honest smooth/Sobolev+entropy domain; omitted analytic background",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "GAUSSIAN-T2-GAP",
      "kind": "SOURCE_GAP",
      "source_anchors": [
        "S4.SS1.p4.3"
      ],
      "formula": "Gaussian Talagrand W2(r,gamma)²<=2 KL(r||gamma), actual probabilities/relative entropy/Euclidean metric; omitted background",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "METRIC-KL-ADAPTER-GAP",
      "kind": "SOURCE_GAP",
      "source_anchors": [
        "S4.Ex1",
        "S4.SS1.p4.3"
      ],
      "formula": "Explicit q entropy equals finite measure KL; actual Gaussian/isometric Euclidean carrier and finite ENNReal transport; no toReal infinity collapse",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "FUNCTION-LSI-ROUTE",
      "kind": "AUTHORED_ADAPTER",
      "source_anchors": [
        "S4.SS1.p4.3"
      ],
      "formula": "f=sqrtq; gradf=-1/2 f gradrho; Ent(f²)=KL, integral||gradf||²=I/4",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "GENERATOR-DOMAIN-GAP",
      "kind": "AUTHORED_OPEN_GAP",
      "source_anchors": [
        "S4.SS1.p4.3"
      ],
      "formula": "Alternative generator LSI route must internally produce Gaussian LSI predicate, canonical density admissibility, representative/IBP/carre-du-champ domains; hScore not inferable from a.e. smooth RN equality",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "GENERATOR-LSI-ROUTE",
      "kind": "AUTHORED_ALTERNATIVE",
      "source_anchors": [
        "S4.SS1.p4.3"
      ],
      "formula": "A genuinely produced Gaussian generator LSI plus genuine score/Dirichlet adapters could imply same KL<=I/2; current conditional API alone insufficient",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "LSI-KL",
      "kind": "DERIVED_OPEN",
      "source_anchors": [
        "S4.SS1.p4.3"
      ],
      "formula": "KL(r||gamma)<=I/2, I=integral||gradrho||²dr, Fisher coefficient1",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "T2-KL",
      "kind": "DERIVED_OPEN",
      "source_anchors": [
        "S4.SS1.p4.3"
      ],
      "formula": "W2(r,gamma)²<=2 KL(r||gamma)",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "FIRST46",
      "kind": "SOURCE_TARGET",
      "source_anchors": [
        "S4.E6"
      ],
      "formula": "W2(r,gamma)<=sqrt(integral||gradrho||²dr); coefficient1",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "IBP-MOMENT-GAP",
      "kind": "SOURCE_GAP",
      "source_anchors": [
        "S4.SS1.p4.3"
      ],
      "formula": "For context last4.6 internally justify fullspace IBP under Q=||u||²/2+rho, HessQ>=I,gradQ0=0 and actual decay/integrability",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "CONTEXT46-SECOND-LAST",
      "kind": "SOURCE_CONTEXT",
      "source_anchors": [
