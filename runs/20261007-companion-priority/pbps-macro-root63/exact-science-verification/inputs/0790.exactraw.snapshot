      ∀ φ x i,
        brownianCoordinateGenerator φ x i =
          ∫ z : Real, sourceTaylorIntegrand φ x i z ∂
            (ProbabilityTheory.gaussianReal (0 : Real) (variance φ x i)) := by
  exact
