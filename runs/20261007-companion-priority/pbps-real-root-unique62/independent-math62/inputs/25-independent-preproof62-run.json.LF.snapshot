          "raw_sha256": "832e5eba8dbe8fd2b0361f4514814d7e6462b20418b04693badb9aa6122ce341",
          "lf_sha256": "832e5eba8dbe8fd2b0361f4514814d7e6462b20418b04693badb9aa6122ce341"
        },
        "qualified_LF_slice": {
