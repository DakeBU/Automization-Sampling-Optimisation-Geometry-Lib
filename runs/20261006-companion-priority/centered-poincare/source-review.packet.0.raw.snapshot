    "lesson": {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.CenteredDomainPoincare.gibbs_centered_domain_poincare",
      "title": "Actual centered original-gradient Poincare",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06905v1#A3.SS1",
          "label": "PBPS reflected score variance and explicitly bounded canonical background",
          "scope": "Finite-dimensional real Hilbert/Borel full E including0, genuine C2 W with actual exponential integrability/positive partition, normalized tilted probability, BOTH global mI<=HessW<=MI and0<m<=M. SAME original exact compact-smooth closable weighted gradient D BEFORE all truly mean-zero domain z. Actual positiveepsilon variational solutions from residual/globalcoercivity producers are identified by SAME D/epsilon/forcing uniqueness, then tested against z; strong scaled residual limit and genuine scalar Cauchy-Schwarz/zero-norm branch give m*normz^2<=normDclosurez^2. No uniform unscaled solution bound, centered resolvent, epsilon0 solution, core/range/adjoint certificate or input Poincare. Actual C1 scalar/gradientL2 pairs and centered function are admitted to a genuine original graph, actual probability/AE quotient identities and real integrability produce Admissible and m*Var<=DirichletEnergy. Actual common Gaussian J/R/S, sourceC2 alpha-beta eta cap, reflected W_y, positive partitions and one original D_y precede allcentered z/score directions; actual unnormalized parameter-y score variance <=(eta^-1-alpha)^2*norma^2/(4*(alpha+eta^-1)), with exact reflected m=(alpha+eta^-1)/4 and source-derived upper M=(beta+eta^-1)/4. Auxiliary normalized density equality only; no R2=R/alternateD identification/jointselector or normalized conditional density derivative. BOTH-curvature generic statement is narrower than lower-only source D6 and is disclosed; source companion models supply the upper bound. Anisotropic BL, unreflected linear moments/covariance-upper and SPHMC Hessian lower, outer-y/marginal Poincare, PBPS sampler/reflection/invariance/nonexplosion/hypocoercivity/implementation/cost, SPHMC complete algorithm/Wp/proxywarmness, main results/composition/expectedcost remainopen. TV does not transfer unbounded cost."
        }
      ],
      "tests": [
        "lake build Tests.CenteredPoincare"
      ],
      "assumptions": [
        "Finite-dimensional real Hilbert/Borel full E including0. Actual C2 potential W, ordinary-volume exp(-W) integrability and positive partition. Actual normalized probability mu=volume.tilted(-W).",
        "BOTH actual global mI<=HessW<=MI and0<m<=M. SAME exact original compact-smooth closable weighted gradient D BEFORE ALL mean-zero z in D.closure.domain. No input Poincare or supplied resolvent/coercivity/limit certificate. This canonical library contract is narrower than lower-only source D6."
      ],
      "statement": "For every genuinely centered z in the SAME original closed weighted-gradient domain, prove m*normz^2<=normDclosurez^2 from actual positive-epsilon solutions, SAME variational uniqueness, global coercivity and true strong scaled residual limit.",
      "formula": "\\mu=Z^{-1}e^{-W}dx,\\quad mI\\preceq\\nabla^2W\\preceq MI,\\quad\\int z\\,d\\mu=0\\Longrightarrow m\\|z\\|_{L^2(\\mu)}^2\\le\\|\\overline Dz\\|_{L^2(\\mu)}^2.",
      "steps": [
        {
          "title": "Use actual positive-epsilon solutions",
          "text": "Take epsilon_n=1/(n+1). The accepted centered Gibbs residual producer gives actual solutions in SAME original closure domain and genuine strong epsilon_n*u_n->0. No zero-epsilon solution or uniform unscaled bound is assumed.",
          "formula": "\\varepsilon_n=(n+1)^{-1},\\quad\\varepsilon_nu_n\\to0.",
          "lean": "CenteredGibbsResolventLimit.gibbs_centered_resolvent_sequence"
        },
        {
          "title": "Identify the two genuine witnesses",
          "text": "Global weighted coercivity constructs another solution v_n with m*normDvn^2<=normz^2. Both solve ALL tests in SAME D/epsilon/forcing. Actual closed-graph resolvent uniqueness identifies u_n=v_n, so no existential witnesses or operators are silently identified.",
          "formula": "u_n=v_n,\\qquad m\\|\\overline Du_n\\|^2\\le\\|z\\|^2.",
          "lean": "GlobalWeightedResolventCoercivity.global_weak_resolvent_coercivity; ClosedGraphResolvent.weak_resolvent"
        },
        {
          "title": "Test against the centered domain element",
          "text": "The true all-domain variational equation allows v=z and gives its squared norm. No requirement that the resolvent itself have mean0 is introduced.",
          "formula": "\\|z\\|^2=\\langle\\varepsilon_nu_n,z\\rangle+\\langle\\overline Du_n,\\overline Dz\\rangle.",
          "lean": "poincare_from_actual_variational_limits; real_inner_self_eq_norm_sq"
        },
