{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Future root-bound normalizer v3 read-only context; this schema is not authorization",
  "type": "object",
  "required": [
    "authorized_by",
    "authorization_kind",
    "advance_id",
    "proof_owner_to_preserve",
    "source_verifier_to_preserve",
    "integration_owner",
    "accepted_immutable_core",
    "source_digest",
    "publication_binding_sha256",
    "proposal_report_sha256",
    "browser_checker_sha256",
    "new_source_verdict",
    "parking_authorized",
    "source_lineage"
  ],
  "properties": {
    "authorized_by": {
      "const": "/root"
    },
    "authorization_kind": {
      "const": "normalizer-postcore-readonly-context"
    },
    "advance_id": {
      "const": "ASTIS-SA-20261108-GaussianComplexityFixedSpectrumNormalizer"
    },
    "proof_owner_to_preserve": {
      "const": "huanjian_gc_20261108_fixed_spectrum_normalizer"
    },
    "source_verifier_to_preserve": {
      "type": "string",
      "minLength": 1
    },
    "integration_owner": {
      "type": "string",
      "minLength": 1
    },
    "accepted_immutable_core": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publication_binding_sha256": {
      "const": "b2f41e36a9d705ff68da71f72f0ec14f1cd2ff105bcf0ae5000ef1406a5d1f41"
    },
    "proposal_report_sha256": {
      "const": "6b86afe6caeaf8e1cc83fc782b1221c7b316edfa20f2439cd204d840da4bc87a"
    },
    "browser_checker_sha256": {
      "const": "acd0b2be49b2c3059f9ae4659058a18c157f3dda673f4ebfb6e0d7a51e7a408f"
    },
    "new_source_verdict": {
      "const": false
    },
    "parking_authorized": {
      "const": false
    },
    "source_lineage": {
      "type": "object",
      "required": [
        "checked_commit",
        "accepted_audit_first_commit",
        "source_V_first_commit",
        "accepted_audit",
        "source_review_run",
        "source_V_before",
        "source_V_after",
        "source_V_append",
        "source_V_API_receipt"
      ],
      "properties": {
        "checked_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "accepted_audit_first_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_V_first_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "accepted_audit": {
          "$ref": "#/$defs/ref"
        },
        "source_review_run": {
          "$ref": "#/$defs/ref"
        },
        "source_V_before": {
          "$ref": "#/$defs/ref"
        },
        "source_V_after": {
          "$ref": "#/$defs/ref"
        },
        "source_V_append": {
          "$ref": "#/$defs/ref"
        },
        "source_V_API_receipt": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "actual_gate": {
      "$ref": "#/$defs/ref"
    },
    "site_metadata": {
      "$ref": "#/$defs/ref"
    },
    "actual_checks": {
      "description": "Required only for final acceptance, after actual immutable-core execution; every receipt retains its actual raw log.",
      "type": "object",
      "required": [
        "canonical_lean",
        "site_build",
        "site_check",
        "graph_check",
        "publication",
        "contributor",
        "semantic",
        "frontier",
        "browser"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/ref"
      }
    },
    "browser_report": {
      "$ref": "#/$defs/ref"
    },
    "independent_original_image_review": {
      "$ref": "#/$defs/ref"
    },
    "retained_archive_manifest": {
      "$ref": "#/$defs/ref"
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "encoding": {
          "enum": [
            "raw",
            "gzip"
          ]
        }
      }
    }
  }
}
