<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E9.m1" class="ltx_Math" alttext="(\mathsf{U}_{\mathsf{P}\mathsf{P}}f)(y)=\mathbb{E}[f(Y_{-})\mid Y_{+}=y]\,,\hskip 20.00003pt\|\mathsf{U}_{\perp\mathsf{P}}f\|^{2}=\mathbb{E}\Var(f(Y_{-})\mid Y_{+})\,." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>𝖴</mi><mi>𝖯𝖯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mrow><msub><mi>Y</mi><mo>+</mo></msub><mo>=</mo><mi>y</mi></mrow></mrow><mo rspace="0.150em" stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝖴</mi><mrow><mphantom></mphantom><mo>⟂</mo><mi>𝖯</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>f</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>=</mo><mrow><mi>𝔼</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi mathsize="0.900em">Var</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><msub><mi>Y</mi><mo>+</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0.150em">.</mo></mrow><annotation encoding="application/x-tex">(\mathsf{U}_{\mathsf{P}\mathsf{P}}f)(y)=\mathbb{E}[f(Y_{-})\mid Y_{+}=y]\,,\hskip 20.00003pt\|\mathsf{U}_{\perp\mathsf{P}}f\|^{2}=\mathbb{E}\Var(f(Y_{-})\mid Y_{+})\,.</annotation></semantics></math></td>
