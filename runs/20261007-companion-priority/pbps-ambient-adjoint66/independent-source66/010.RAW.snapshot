            "exact_code_raw_sha256": "4d6c1fed4350c14695a1dfbb910763cc4bbde326a2e62f5a59ad88b68ceb1c4e"
          }
        },
        {
          "title": "Eliminate the constant direction and recover the ambient adjoint",
          "text": "The SAME Gram/root identities and Γ_Pq_P=0 imply Bq_P=0. Adjoint pairing therefore puts B* g in H_P^0. Pair against each centered vector, use PB=0 and selfadjointness of P to remove Pg, and obtain the canonical extension of the intrinsic block adjoint.",
          "formula": "\\|Bq_P\\|^2=\\langle q_P,\\Gamma_P^2q_P\\rangle=0,\\quad B^*g=i_0B_0^*Rg.",
          "lean": "  have hGramLocal : B.adjoint ∘L B=ΓP*ΓP := hGram\n  have hRootq : ΓP qP=0 := hΓPq\n  have hBq : B qP=0 := by\n    have hn := B.apply_norm_sq_eq_inner_adjoint_right qP\n    rw [hGramLocal] at hn\n    have hz : (ΓP*ΓP) qP=0 := by\n      change ΓP (ΓP qP)=0\n      rw [hRootq,map_zero]\n    rw [hz,inner_zero_right] at hn\n    exact norm_eq_zero.mp (sq_eq_zero_iff.mp hn)\n  have hBCenter (g : Lp ℝ 2 J) : B.adjoint g ∈ HP0 := by\n    change inner ℝ qP (B.adjoint g)=0\n    rw [B.adjoint_inner_right,hBq,inner_zero_left]\n  have hAmbient (g : Lp ℝ 2 J) :\n      B.adjoint g=HP0.subtypeL (B0.adjoint (R g)) := by\n    let b : HP0 := ⟨B.adjoint g,hBCenter g⟩\n    have heq : b=B0.adjoint (R g) := by\n      apply ext_inner_left ℝ\n      intro u\n      change inner ℝ (u : HP) (B.adjoint g)=inner ℝ u (B0.adjoint (R g))\n      rw [B.adjoint_inner_right,B0.adjoint_inner_right]\n      change inner ℝ (B (u : HP)) g=inner ℝ (B0 u : Lp ℝ 2 J) (R g : Lp ℝ 2 J)\n      rw [hB0,hR,inner_sub_right]\n      have ho : inner ℝ (B (u : HP)) (P g)=0 := by\n        rw [← hPself,hPB,inner_zero_left]\n      rw [ho,sub_zero]\n    exact congrArg (fun z : HP0 => HP0.subtypeL z) heq\n",
          "detail": "Literal compiled BODY excerpt; exact preceding local definitions/derived facts remain in scope. Private statement definition is fully included in reviewed module text and source download.",
          "lean_source_region": {
            "path": "AutoSamplingTheory/ExampleCases/ProximalBPS/AmbientAdjointCorrector.lean",
            "source_raw_sha256": "377663f86e8e139907b6ffeda890d6933efd101a6f43f79064a264f9e0f384d4",
