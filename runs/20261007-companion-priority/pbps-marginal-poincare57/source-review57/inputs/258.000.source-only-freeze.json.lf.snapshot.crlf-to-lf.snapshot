      "consumer": "pbps57:differentiate-logdensity",
      "consumer_use_site": "D.10 preceding paragraph",
      "semantics": "AND within this single printed route",
      "conditional_discharge": "Gaussian smoothing actual probability density and differentiations remain explicit analytical edge obligations.",
      "formal_dependency_admitted": false
    },
    {
      "id": "pbps57:edge:D10",
      "parents": [
        "pbps57:differentiate-logdensity"
      ],
      "consumer": "pbps57:D10",
      "consumer_use_site": "D.10",
      "semantics": "AND within this single printed route",
      "conditional_discharge": "Sigma normalization eta^-1, conditional moments not silently assumed.",
      "formal_dependency_admitted": false
    },
    {
      "id": "pbps57:edge:Eq213",
      "parents": [
        "pbps57:D10",
        "pbps57:covariance"
      ],
      "consumer": "pbps57:marginal-curvature",
      "consumer_use_site": "D.10 final paragraph gives Eq2.13",
      "semantics": "AND within this single printed route",
      "conditional_discharge": "Both conditional covariance sides yield corresponding opposite Hessian sides; eta^-1(1-1/(1+alpha eta))=alpha/(1+alpha eta).",
      "formal_dependency_admitted": false
    },
    {
      "id": "pbps57:edge:marginalPI",
      "parents": [
        "pbps57:BE",
        "pbps57:marginal-curvature",
