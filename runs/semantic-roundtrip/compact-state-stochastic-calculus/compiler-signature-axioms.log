  (hvar : ∀ t ∈ Set.Icc 0 1, ‖fderiv ℝ (fderiv ℝ f) (x + t • v) - fderiv ℝ (fderiv ℝ f) x‖ ≤ ε) :
  ‖AutoSamplingTheory.TechnicalLemmas.Analysis.CompactTaylorRemainder.secondOrderRemainder f x v‖ ≤ ε * ‖v‖ ^ 2
END_1
