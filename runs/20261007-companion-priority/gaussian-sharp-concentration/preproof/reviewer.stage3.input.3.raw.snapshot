      "declaration_level": "canonical-library-node",
      "exact_statement": "{E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]\n    [CompleteSpace E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]\n    {L : ℝ≥0} {f : E → ℝ} (hf : LipschitzWith L f) (t : ℝ) :\n    (∫ x, Real.exp (t * (f x - ∫ z, f z ∂ProbabilityTheory.stdGaussian E))\n      ∂ProbabilityTheory.stdGaussian E) ≤ Real.exp ((L : ℝ)^2 * t^2 / 2)",
      "statement_sha256": "eca82156ec2499acafd23ec9f7d1b3db142b50bb01aa9f90a3c10613dddd287b",
      "verdict": "accepted-statement-only",
