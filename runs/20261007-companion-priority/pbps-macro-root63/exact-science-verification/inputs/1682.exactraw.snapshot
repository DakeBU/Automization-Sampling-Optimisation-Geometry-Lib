          "wording_status": "faithful paraphrase",
          "attribution": "Mathlib supplies the one-sided Grönwall comparison; Samplinglib packages the forced energy-dissipation specialization used by semigroup and optimization arguments."
        },
        "statement": "For a continuous scalar energy with exact right derivative E'=-qD, a positive rate r and the inequality rE≤qD+b imply the sharp exponential interpolation E(t)≤E(s)e^{-r(t-s)}+(b/r)(1-e^{-r(t-s)}) for s≤t.",
        "formulae": [
          {
            "label": "forced differential inequality",
            "tex": "E'(u)\\le-rE(u)+b"
          },
          {
            "label": "exponential forcing envelope",
            "tex": "E(t)\\le E(s)e^{-r(t-s)}+\\frac{b}{r}\\bigl(1-e^{-r(t-s)}\\bigr)"
          }
        ],
        "assumptions": [
          "The energy is continuous and has the supplied exact right derivative at every time.",
          "The decay rate is strictly positive.",
          "The forced coercivity inequality holds at every time.",
          "The two endpoint times are ordered."
