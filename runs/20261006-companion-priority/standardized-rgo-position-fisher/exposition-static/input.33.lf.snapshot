    {
      "id": "transport:curvature-growth",
      "kind": "concept-bridge",
      "label": "Second-order curvature → growth / PL controls",
      "status": "proposal",
      "subtitle": "curvature-to-coercivity pattern",
      "summary": "A lower-curvature or second-order control can generate a quadratic lower model and then a first-order/gap coercivity inequality. In sampling, Bakry–Émery curvature is a distinct route from strong log-concavity to LSI and exponential KL decay.",
      "formula": "\\begin{gathered}f(y)\\ge f(x)+\\langle\\operatorname{grad}f(x),\\log_x y\\rangle+\\frac{\\alpha}{2}d(x,y)^2\\\\\\alpha\\text{-geodesic convexity}\\Rightarrow\\text{metric PL in its valid setting}\\\\CD(\\alpha,\\infty)\\Rightarrow C_{\\mathrm{LSI}}\\le\\alpha^{-1}\\end{gathered}",
      "details": [
        {
          "label": "Evidence boundary",
          "value": "Literature/structural correspondence; no Lean-certified functor or theorem transfer."
        },
        {
          "label": "Conceptual families",
          "value": "family:curvature-growth"
        },
        {
          "label": "Mechanism",
          "value": "A lower-curvature or second-order control can generate a quadratic lower model and then a first-order/gap coercivity inequality. In sampling, Bakry–Émery curvature is a distinct route from strong log-concavity to LSI and exponential KL decay."
        },
        {
          "label": "Hypothesis Map",
          "value": "Translate the notion of curvature before translating the conclusion: Euclidean strong convexity, geodesic strong convexity, displacement/geodesic convexity on P2, and Bakry–Émery CD are different hypotheses with different regularity domains."
        },
        {
          "label": "Conclusion Map",
          "value": "Reuse the proof pattern 'curvature → growth/coercivity → dissipation rate', while preserving the exact source theorem at each arrow. The current strong-convex first-order SAU is a Euclidean substrate, not a proof of the other arrows."
        },
        {
          "label": "Failure Boundary",
          "value": "Euclidean Hessian lower bounds, Riemannian geodesic convexity, displacement convexity and Bakry–Émery curvature are not interchangeable. Strong convexity is sufficient for several PL-style controls but PL need not imply strong convexity."
        },
        {
          "label": "Category objects",
          "value": "A problem plus its explicit curvature notion, metric, domain and regularity."
        },
        {
          "label": "Category morphisms",
          "value": "Only source-backed implication/adapter records; no general curvature-preserving morphism map is claimed."
        },
        {
          "label": "Category identity",
          "value": "Not established; this is a proof-pattern family, not a certified functor."
        },
        {
          "label": "Category composition",
          "value": "Each curvature-to-coercivity arrow keeps its own hypotheses and constants; transitive composition is never inferred from the diagram alone."
        },
        {
          "label": "Shared planned checkpoints",
          "value": "convex, manifold, transport, entropy, flow"
        },
