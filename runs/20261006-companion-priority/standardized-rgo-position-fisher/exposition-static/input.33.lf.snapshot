    {
      "id": "transport:proximal-half-turn",
      "kind": "concept-bridge",
      "label": "Proximal geometry meets discrete hypocoercivity",
      "status": "proposal",
      "subtitle": "model-specific adapter candidate",
      "summary": "An augmented reflection U, conditional projection P, and conditional half-turn H form a discrete Markov operator. A modified L2 corrector exposes transfer between undamped macro and damped micro modes.",
      "formula": "\\mathsf K=\\mathsf U[\\mathsf P+(1-\\rho)\\mathsf H_{\\perp\\perp}]",
      "details": [
        {
          "label": "Evidence boundary",
          "value": "Literature/structural correspondence; no Lean-certified functor or theorem transfer."
        },
        {
          "label": "Review status",
          "value": "candidate"
        },
        {
          "label": "Review boundary",
          "value": "A candidate awaits independent source review. Source review does not certify a Lean transport."
        },
        {
          "label": "Conceptual families",
          "value": "family:discrete-hypocoercivity"
        },
        {
          "label": "Mechanism",
          "value": "An augmented reflection U, conditional projection P, and conditional half-turn H form a discrete Markov operator. A modified L2 corrector exposes transfer between undamped macro and damped micro modes."
        },
        {
          "label": "Hypothesis Map",
          "value": "Positive conditional normalizers; non-explosive harmonic bounce process; invariant augmented law; centered L2 domain; macroscopic gap and half-turn operator estimate."
        },
        {
          "label": "Conclusion Map",
          "value": "Reuse the modified-energy mechanism through explicit discrete operator bounds before proving chi-square block contraction and marginal TV decay."
        },
        {
          "label": "Failure Boundary",
          "value": "Not the ordinary proximal chain or vanilla BPS; the unrefreshed conditional process alone need not mix. Continuous-time DMS/Fan–Li–Lu rates do not transfer verbatim."
        },
        {
          "label": "Category objects",
          "value": "Specified centered Hilbert spaces, projections, involutions and half-turn contractions."
        },
        {
          "label": "Category morphisms",
          "value": "Candidate mechanism adapters, not implication edges between arbitrary samplers."
        },
        {
          "label": "Category identity",
          "value": "No category certificate."
        },
        {
          "label": "Category composition",
          "value": "Requires each operator, norm and domain estimate; no certified functor."
        },
        {
          "label": "Shared planned checkpoints",
          "value": "linear-algebra, measure, kernel-algebra, entropy"
