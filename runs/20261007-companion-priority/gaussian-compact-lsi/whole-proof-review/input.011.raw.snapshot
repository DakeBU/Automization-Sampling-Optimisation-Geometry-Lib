    {
      "id": "P34",
      "kind": "EXISTING_COMPILED_SUBSTRATE",
      "formula": "Actual half Bernoulli count LSI/probability/L1 for everyN andh",
      "classification": "SEALED_PARENT_ONLY",
      "anchors": [
        {
          "input_role": "parent34_signature",
          "start_line": 1,
          "end_line": 12,
          "literal_LF_sha256": "23f48bd92530e7aa11507bf287b6e9969cba918bc397022b9b17386d8fbea665",
          "literal": "theorem bernoulli_function_logSobolev (n : ℕ) (h : (Fin n → Bool) → ℝ) :\n    let μ : Measure (Fin n → Bool) :=\n      (Fintype.card (Fin n → Bool) : ℝ≥0∞)⁻¹ • Measure.count\n    let D := fun ε : Fin n → Bool =>\n      ∑ j : Fin n, (h ε - h (Function.update ε j (!ε j))) ^ 2\n    IsProbabilityMeasure μ ∧\n      Integrable (fun ε => (h ε) ^ 2) μ ∧\n      Integrable (fun ε => (h ε) ^ 2 * Real.log ((h ε) ^ 2)) μ ∧\n      Integrable D μ ∧\n      ((∫ ε, (h ε) ^ 2 * Real.log ((h ε) ^ 2) ∂μ) -\n        (∫ ε, (h ε) ^ 2 ∂μ) * Real.log (∫ ε, (h ε) ^ 2 ∂μ) ≤\n      (1 / 2 : ℝ) * ∫ ε, D ε ∂μ)\n"
        }
      ],
      "state": "verified receipt provenance frozen; body not read"
    },
