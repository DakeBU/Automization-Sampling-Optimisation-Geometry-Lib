{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native independent PBPS statement-only review capsule v1",
  "type": "object",
  "required": ["schema_version", "artifact_kind", "reviewer_identity", "verdict", "primary_stage_receipts", "candidate_receipts", "binder_audit", "seven_semantic_slots", "blocking_deltas", "remaining_boundaries", "independence", "proof_admission", "self_hash_recipe", "content_self_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "native-independent-statement-binder-source-review"},
    "reviewer_identity": {"type": "string"},
    "verdict": {"const": "ACCEPT_SCOPED_STATEMENT_ONLY"},
    "primary_stage_receipts": {"type": "array", "minItems": 3},
    "candidate_receipts": {"type": "array", "minItems": 6},
    "binder_audit": {"type": "array", "minItems": 8},
    "seven_semantic_slots": {"type": "object", "required": ["objects", "domains", "quantifiers", "assumptions", "conclusion", "scopes_senses", "constant_dependencies"]},
    "blocking_deltas": {"type": "array", "maxItems": 0},
    "remaining_boundaries": {"type": "array", "minItems": 1},
    "independence": {"type": "object"},
    "proof_admission": {"const": false},
    "self_hash_recipe": {"type": "object"},
    "content_self_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
