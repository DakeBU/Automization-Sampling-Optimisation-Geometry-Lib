      "lf_sha256": "b2688934e449664ddc9da827d11db18f3031034c86dcfdbffd13577ab91e86b0",
      "source_text": "k_{a,\\widetilde{w}}(w,p)\\coloneqq-a^{\\top}\\{\\bar{w}_{y}+g_{y}(\\widetilde{w})\\}-2\\,[p^{\\top}\\{g_{y}(w)-g_{y}(\\widetilde{w})\\}]_{+}^{2}\\,\\frac{a^{\\top}\\{g_{y}(w)-g_{y}(\\widetilde{w})\\}}{\\|g_{y}(w)-g_{y}(\\widetilde{w})\\|^{2}}\\,,"
    },
    {
