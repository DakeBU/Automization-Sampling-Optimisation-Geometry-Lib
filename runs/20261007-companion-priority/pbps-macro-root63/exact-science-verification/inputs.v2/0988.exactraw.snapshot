publication_issue=dict(step=3,classification='exact-multiline-excerpt-binding',blocking_for_mathematics=False,blocking_for_exact_publication_code_seal=True,description='Advertised lines57–146 target the header first let A; snippet changes its first indentation by10bytes. Its claimed code digest hashes authored snippet, not literal line span. No source theorem or proof statement changes.',actual_literal_old_span_sha256='90b9b65491cb5fdace9c60c5e65ddae6e777b2eea20b588dbcd74a1311cae609',advertised_digest='d4b931631b5995d6e13d7b177d06aac175dffcec137ffc204d938203759b38a0',minimal_proposed_repair=dict(path=pairs[0]['original']['path'],source_raw_sha256=pairs[0]['original']['raw_sha256'],start_line=120,end_line=146,exact_code_raw_sha256=sha(repair_bytes),lean=repair_bytes.decode(),status='independent proposal only; root adoption/new publication binding required'))
