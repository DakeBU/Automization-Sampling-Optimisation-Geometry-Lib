    J → AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.ProgressiveL2.ProgressiveL2Integrand filtration mu T)
  (hT : 0 < T)
  (hB :
    ∀ (j : J),
      AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.BrownianMotion.IsBrownianMotionWithFiltration (B j)
        filtration mu)
  (hUsual : AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.ProgressiveL2.SatisfiesUsualConditions filtration mu)
  {n : ℕ} (times : Fin (n + 1) → NNReal) (hmono : Monotone times) (hlast : times (Fin.last n) ≤ T) :
  have row := fun f t omega =>
    ∑ j,
      AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.ItoIntegralProcess.itoIntegralProcess (f j) hT ⋯ hUsual t
        omega;
  have qv := fun f omega => ∑ i, (row f (times i.succ) omega - row f (times i.castSucc) omega) ^ 2;
  MeasureTheory.Integrable (fun omega => qv eta omega - qv xi omega) mu ∧
    ∫ (omega : Omega), |qv eta omega - qv xi omega| ∂mu ≤
      ↑(Fintype.card J) *
