    "generic": {
      "declaration": "AutoSamplingTheory.TechnicalLemmas.Measure.L2RealSquareRootUnique.positive_square_roots_unique",
      "binders": [
        {
          "name": "Ω",
          "classification": "domain",
          "expanded": "arbitrary universe type, may be empty"
        },
        {
          "name": "MeasurableSpace Ω",
          "classification": "typing",
          "expanded": "measurable structure only"
        },
        {
          "name": "μ",
          "classification": "domain",
          "expanded": "any measure on same Ω; not finite/probability/sigma-finite"
        },
        {
          "name": "A,B",
          "classification": "mathematical-input",
          "expanded": "continuous bounded real-linear endomorphisms of complete real Lp2μ"
        },
        {
          "name": "hA,hB",
          "classification": "source-background-hypothesis",
          "expanded": "IsPositive = symmetry and nonnegative real quadratic form; complete L2 gives selfadjoint equivalence"
        },
        {
          "name": "hSq",
          "classification": "mathematical-input",
          "expanded": "operator composition equality A*A=B*B, not pointwise product or adjoint square"
        }
      ],
      "conclusion": "ALL positive REAL bounded operators A,B on same arbitrary μ with SAME squared operator imply A=B. Equivalent real unique-positive-root consequence of printed D1 background; no root construction or energy supplied.",
      "zero_excess": true
    },
    "actual": {
      "declaration": "AutoSamplingTheory.ExampleCases.ProximalBPS.RealDefectRootUnique.actual_unique_positive_real_defect_root",
      "binders": [
        {
          "name": "E/NormedAddCommGroup/InnerProductSpace ℝ",
          "classification": "domain/typing",
          "expanded": "real Hilbert base geometry"
        },
        {
          "name": "FiniteDimensional ℝ E",
          "classification": "source-domain-elaboration",
          "expanded": "finite base Euclidean adapter, includes rank0; not finite-dimensional L2"
        },
        {
          "name": "MeasurableSpace E/BorelSpace E",
          "classification": "typing",
          "expanded": "canonical Borel geometry compatible with volume/Gaussian"
        },
        {
          "name": "V",
          "classification": "source-object",
          "expanded": "real potential"
        },
        {
          "name": "α,β : ℝ≥0",
          "classification": "source-constant-typing",
          "expanded": "positive alpha and alpha<=beta separately displayed"
        },
