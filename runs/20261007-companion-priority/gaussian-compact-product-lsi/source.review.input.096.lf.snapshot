def enc(o):return (json.dumps(o,ensure_ascii=False,indent=2)+'\n').encode()
def lf(b):return b.replace(b'\r\n',b'\n').replace(b'\r',b'\n')
def put(n,b):
 if not isinstance(b,bytes):b=enc(b)
 with (O/n).open('xb') as f:f.write(b)
 return H(b)
