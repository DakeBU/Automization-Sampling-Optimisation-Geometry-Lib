            "exact_code_raw_sha256": "5ba039460588e4217d1b74ac25c5339e53bec4727deb16504c9d6a0ef9ac8d9a"
          }
        },
        {
          "title": "Identify actual joint mean with the transported constant",
          "text": "Pull the ν-almost-everywhere constant q back by the actual measure-preserving second coordinate. Thus i q_P is exactly the constant-one L²(J) class, and its pairing is the Bochner integral of every joint L² observable. No representative or integrability assumption is added.",
          "formula": "i q_P=1\\quad J\\text{-a.e.},\\qquad\\langle i q_P,g\\rangle=\\int g\\,dJ.",
          "lean": "  let hp : MeasurePreserving (Prod.snd : E × E → E) J ν := ⟨measurable_snd,rfl⟩\n  let M : Lp ℝ 2 ν →ₗᵢ[ℝ] Lp ℝ 2 J := Lp.compMeasurePreservingₗᵢ ℝ Prod.snd hp\n  have hqOne : (qP : Lp ℝ 2 J)=\n      AutoSamplingTheory.TechnicalLemmas.Measure.L2Expectation.one J := by\n    rw [show (qP : Lp ℝ 2 J)=M q from he q]\n    apply Lp.ext\n    have hqaPull : (fun z : E × E => q z.2)=ᵐ[J] (fun _ => (1 : ℝ)) :=\n      hp.quasiMeasurePreserving.ae hqa\n    exact (Lp.coeFn_compMeasurePreserving q hp).trans\n      (hqaPull.trans (Lp.coeFn_const (p:=(2 : ℝ≥0∞)) (μ:=J) (c:=(1 : ℝ))).symm)\n  have hqIntegral (g : Lp ℝ 2 J) : inner ℝ (qP : Lp ℝ 2 J) g=∫ z, g z ∂J := by\n    rw [hqOne]\n    exact AutoSamplingTheory.TechnicalLemmas.Measure.L2Expectation.inner_one_eq_integral J g\n  have hPq : P (qP : Lp ℝ 2 J)=qP := hPf qP\n",
          "detail": "Literal compiled BODY excerpt; exact preceding local definitions/derived facts remain in scope. Private statement definition is fully included in reviewed module text and source download.",
          "lean_source_region": {
            "path": "AutoSamplingTheory/ExampleCases/ProximalBPS/AmbientAdjointCorrector.lean",
            "source_raw_sha256": "377663f86e8e139907b6ffeda890d6933efd101a6f43f79064a264f9e0f384d4",
            "start_line": 215,
            "end_line": 228,
            "exact_code_raw_sha256": "fc22604959b0f696994e76c8f832d586e4a5409dd927385ca6edcc6c4663bc7d"
          }
        },
        {
          "title": "Construct centered macroscopic input and its exact norm decomposition",
          "text": "For every globally centered f, selfadjoint conditional expectation and Pq_P=q_P give E[f|Y]∈H_P^0. Apply the ambient identity to Rf and its idempotence, then the SAME restricted-root relation. Orthogonal projection gives the Pythagorean norm identity.",
          "formula": "\\int f\\,dJ=0\\Rightarrow f_P\\in H_P^0,\\quad B^*i_\\perp f_\\perp=i_0\\Gamma_0f_V=\\Gamma_Pi_0f_V,\\quad\\|f\\|^2=\\|f_P\\|^2+\\|f_\\perp\\|^2.",
          "lean": "  refine ⟨hμ,hJ,hν,hRange,hPf,S,hS,hSd,hSc,hSf,hSs,e,he,U,hU,hUi,hUs,T,hTs,hAll,\n    hAeq,hAs,hAn,hPB,Γ,hΓ,hΓSq,hΓP,hΓPSq,hGram,q,hqa,hTq,hq,hCenter,hΓPq,hγ,\n    ΓP0,hΓP0,hPos0,hOrder0,hUnit,Inv,hLeft,hRight,hNormInv,B0,hB0,V0,hVdef,\n    hFactor,hVadj,hVnorm,R,hR,hAmbient,?_⟩\n  intro f hf\n  have hCf : C f ∈ HP0 := by\n    change inner ℝ qP (C f)=0\n    change inner ℝ (qP : Lp ℝ 2 J) (P f)=0\n    rw [← hPself,hPq,hqIntegral,hf]\n  let fP : HP0 := ⟨C f,hCf⟩\n  refine ⟨fP,rfl,?_,?_,?_,hVcontract (R f)⟩\n  · calc\n      B.adjoint (R f : Lp ℝ 2 J)=HP0.subtypeL (B0.adjoint (R (R f))) := hAmbient _\n      _ = HP0.subtypeL (B0.adjoint (R f)) := congrArg\n        (fun z : Hperp => HP0.subtypeL (B0.adjoint z)) (hRself (R f))\n      _ = HP0.subtypeL (ΓP0 (V0.adjoint (R f))) :=\n        congrArg (fun z : HP0 => HP0.subtypeL z)\n          (congrArg (fun D : Hperp →L[ℝ] HP0 => D (R f)) hBAdj)\n  · exact hΓP0 _\n  · have hn := HP.norm_sq_eq_add_norm_sq_starProjection f\n    have hProj : HP.starProjection=P := rfl\n    rw [hProj,HP.starProjection_orthogonal_val] at hn\n    change ‖f‖^2=‖(C f : Lp ℝ 2 J)‖^2+‖f-P f‖^2 at hn\n    exact hn\n",
          "detail": "Literal compiled BODY excerpt; exact preceding local definitions/derived facts remain in scope. Private statement definition is fully included in reviewed module text and source download.",
          "lean_source_region": {
            "path": "AutoSamplingTheory/ExampleCases/ProximalBPS/AmbientAdjointCorrector.lean",
            "source_raw_sha256": "377663f86e8e139907b6ffeda890d6933efd101a6f43f79064a264f9e0f384d4",
            "start_line": 229,
