      {
        "label": "unit0-proof-5",
        "url": "http://127.0.0.1:50371/example-cases/samplewiki/companions/proximal-bouncy-particle.html",
        "scrollY": 159889,
        "bodyHeight": 458540,
        "targetRect": {
