1: #!/usr/bin/env python3
2: """Validate and summarize collaborative ASTIS Frontier Cell records.
3: 
4: A Frontier Cell is the GitHub-visible unit of mathematical progress used by the
5: SampleWiki, Riemannian Optimization, Optimisation, and shared-foundation lanes.
6: The validator is intentionally stdlib-only so it can run in every ASTIS CI job.
7: """
8: 
9: from __future__ import annotations
10: 
11: import argparse
12: import json
13: import sys
14: from collections import Counter, defaultdict
15: from pathlib import Path
16: from typing import Any
17: 
18: 
19: ROOT = Path(__file__).resolve().parents[1]
20: DEFAULT_CELL_ROOT = ROOT / "research-wiki" / "frontier-cells"
21: PROCESS_MEMORY = ROOT / "research-wiki" / "process-memory.json"
22: 
23: ROUTES = {"samplewiki-route", "riemannian-optimization", "optimisation", "statistical-optimal-transport", "higher-order-sampling", "discrete-sampling", "mcmc", "shared"}
24: MODES = {"faithfulPaper", "exploratoryProof"}
25: STATUSES = {
26:     "claimed",
27:     "proved_locally",
28:     "independently_verified",
29:     "stabilized",
30:     "merged",
31:     "blocked",
32:     "quarantined",
33: }
34: CLASSIFICATIONS = {"reuse", "adapt", "missing", "out_of_scope"}
35: DECISIONS = {
36:     "reuse_existing",
37:     "adapt_existing",
38:     "new_route_local",
39:     "new_canonical_shared",
40:     "out_of_scope",
41: }
42: FAILURE_CLASSES = {
43:     "REFUTED",
44:     "SOURCE_INVALID",
45:     "API_BLOCKED",
46:     "ENV_BLOCKED",
47:     "IMPLEMENTATION_FAILED",
48:     "NONE",
49: }
50: SALVAGE_STATUSES = {"pending", "completed", "not-applicable"}
51: PARALLEL_DECISIONS = {"serial", "parallel"}
52: CROSS_ROUTE_STATUSES = {"pending", "accepted", "not-applicable"}
53: PURIFICATION_STATUSES = {"pending", "purified", "not-applicable"}
54: EXPOSITION_STATUSES = {"pending", "accepted", "not-applicable"}
55: 
56: 
57: def cell_paths(root: Path = DEFAULT_CELL_ROOT) -> list[Path]:
58:     if not root.exists():
59:         return []
60:     return sorted(
61:         path
62:         for path in root.rglob("*.json")
63:         if not path.name.startswith("_") and path.name != "schema.json"
64:     )
65: 
66: 
67: def load_cells(root: Path = DEFAULT_CELL_ROOT) -> list[dict[str, Any]]:
68:     cells: list[dict[str, Any]] = []
69:     for path in cell_paths(root):
70:         try:
71:             raw = json.loads(path.read_text(encoding="utf-8"))
72:         except (OSError, json.JSONDecodeError) as exc:
73:             cells.append({"__path__": str(path), "__load_error__": str(exc)})
74:             continue
75:         if not isinstance(raw, dict):
76:             cells.append({"__path__": str(path), "__load_error__": "top level must be an object"})
77:             continue
78:         raw["__path__"] = path.relative_to(ROOT).as_posix() if path.is_relative_to(ROOT) else str(path)
79:         cells.append(raw)
80:     return cells
81: 
82: 
83: def _nonempty(value: Any) -> bool:
84:     return isinstance(value, str) and bool(value.strip())
85: 
86: 
87: def _list(value: Any) -> list[Any]:
88:     return value if isinstance(value, list) else []
89: 
90: 
