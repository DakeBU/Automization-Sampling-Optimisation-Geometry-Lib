    {
      "id": "micro-macro-spaces",
      "source_ids": [
        "A2.E1",
        "A2.E2",
        "A2.E3"
      ],
      "role": "source-definition",
      "statement": "H=L2(pi_eta), P=conditional expectation given Y, HP=range P identified with L2(pi_eta^Y), Hperp=ker P; the first block index is the target and second is the source.",
      "literal_formula_alttexts": {
        "A2.E1": [
          "(\\mathsf{P}f)(x,y)\\coloneqq\\int f(x^{\\prime},y)\\,\\pi_{\\eta}^{X\\mid Y=y}(\\mathrm{d}x^{\\prime})=\\mathbb{E}[f(X,Y)\\mid Y=y]\\,."
        ],
        "A2.E2": [
          "\\begin{split}\\mathfrak{H}_{\\mathsf{P}}&\\coloneqq\\operatorname{ran}(\\mathsf{P})=\\{f\\in\\mathfrak{H}:f(x,y)=g(y)\\text{ for some }g\\in L^{2}(\\pi_{\\eta}^{Y})\\}\\,,\\\\\n\\mathfrak{H}_{\\perp}&\\coloneqq\\ker(\\mathsf{P})=\\operatorname{ran}(\\mathsf{P}^{\\perp})=\\{f\\in\\mathfrak{H}:\\mathbb{E}[f(X,Y)\\mid Y]=0\\}\\,.\\end{split}"
        ],
        "A2.E3": [
          "\\mathsf{T}=\\begin{pmatrix}\\mathsf{T}_{\\mathsf{P}\\mathsf{P}}&\\mathsf{T}_{\\mathsf{P}\\perp}\\\\\n\\mathsf{T}_{\\perp\\mathsf{P}}&\\mathsf{T}_{\\perp\\perp}\\end{pmatrix}\\,,\\hskip 20.00003pt\\begin{aligned} \\mathsf{T}_{\\mathsf{P}\\mathsf{P}}&\\coloneqq\\mathsf{P}\\mathsf{T}\\mathsf{P}\\,,&\\mathsf{T}_{\\mathsf{P}\\perp}&\\coloneqq\\mathsf{P}\\mathsf{T}\\mathsf{P}^{\\perp}\\,,\\\\\n\\mathsf{T}_{\\perp\\mathsf{P}}&\\coloneqq\\mathsf{P}^{\\perp}\\mathsf{T}\\mathsf{P}\\,,&\\mathsf{T}_{\\perp\\perp}&\\coloneqq\\mathsf{P}^{\\perp}\\mathsf{T}\\mathsf{P}^{\\perp}\\,.\\end{aligned}"
        ]
      },
      "literal_byte_anchors": {
        "A2.E1": [
          {
            "math_id": "A2.E1.m1",
            "byte_start": 717768,
            "byte_end_exclusive": 719465,
            "raw_sha256": "63e94b61ca0f8c12e8daddc817d5b476416ba759fa158a16ff674036288044a2"
          }
        ],
        "A2.E2": [
          {
            "math_id": "A2.E2.m1",
            "byte_start": 720692,
            "byte_end_exclusive": 723787,
            "raw_sha256": "69c506c95c65a72bd4164a4e1da15ad3b45efdcef4e430894b1da0f44973b00b"
          }
        ],
        "A2.E3": [
          {
            "math_id": "A2.E3.m1",
            "byte_start": 728917,
            "byte_end_exclusive": 732205,
            "raw_sha256": "8b0fcf274f61f957b82aaebd7f8c08167997363814521dab4578fad6b9b9099d"
          }
        ]
      },
      "centered_domain": "HP0=HP intersect L2_0(pi_eta), identified with L2_0(pi_eta^Y); Hperp consists of conditional-mean-zero observables, hence is globally centered."
    },
    {
      "id": "selfadjoint-unitary-reflection",
      "source_ids": [
        "A2.E4",
        "A2.E5"
      ],
      "role": "compiled-target-independent-source-ingredient",
      "statement": "Uf(x,y)=f(x,2x-y); preservation and involution imply self-adjoint unitary U. A=UPP is a self-adjoint contraction HP->HP; T=UperpP maps HP->Hperp and T* T=I-A^2.",
      "literal_formula_alttexts": {
        "A2.E4": [
          "(\\mathsf{U}f)(x,y)\\coloneqq f(\\mathsf{U}(x,y))=f(x,2x-y)\\,."
        ],
        "A2.E5": [
          "\\mathsf{U}_{\\perp\\mathsf{P}}^{*}\\mathsf{U}_{\\perp\\mathsf{P}}=I-\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}^{2}\\,,\\hskip 20.00003pt\\mathsf{U}_{\\perp\\mathsf{P}}^{*}\\mathsf{U}_{\\perp\\perp}=-\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}\\mathsf{U}_{\\perp\\mathsf{P}}^{*}\\,."
        ]
      },
      "literal_byte_anchors": {
        "A2.E4": [
          {
            "math_id": "A2.E4.m1",
            "byte_start": 734566,
            "byte_end_exclusive": 735679,
            "raw_sha256": "9debcae7f1e1c9dacd3aa2a8208b4da1d4be26908f328358c084af88ff2163a1"
          }
        ],
        "A2.E5": [
          {
            "math_id": "A2.E5.m1",
            "byte_start": 740478,
            "byte_end_exclusive": 742053,
            "raw_sha256": "3cfe91e3f7ea684be38e111f4aa98afa7e3cb18e0d7b37d0b40532e974754919"
          }
        ]
      }
    },
    {
      "id": "conditional-variance-and-root",
      "source_ids": [
        "A2.E8",
        "A2.E9",
        "A2.E10",
        "A2.E11"
      ],
      "role": "source-definition-and-identity",
      "statement": "The exchangeable Y+/Y- pair represents Af as E[f(Y-)|Y+]; ||Tf||^2 is expected conditional variance. Gamma=(I-A^2)^(1/2) is the unique non-negative operator root on HP, T*T=Gamma^2 and ||Tf||=||Gamma f|| for every f in HP.",
      "literal_formula_alttexts": {
        "A2.E8": [
          "Y_{+}\\coloneqq X+\\sqrt{\\eta}\\,Z\\,,\\hskip 20.00003ptY_{-}\\coloneqq X-\\sqrt{\\eta}\\,Z\\,,\\hskip 20.00003ptZ\\sim\\mathcal{N}(0,I)\\,,\\hskip 20.00003ptX\\sim\\mu\\,."
        ],
        "A2.E9": [
          "(\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}f)(y)=\\mathbb{E}[f(Y_{-})\\mid Y_{+}=y]\\,,\\hskip 20.00003pt\\|\\mathsf{U}_{\\perp\\mathsf{P}}f\\|^{2}=\\mathbb{E}\\Var(f(Y_{-})\\mid Y_{+})\\,."
        ],
        "A2.E10": [
          "\\mathsf{\\Gamma}_{\\mathsf{P}}\\coloneqq(I-\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}^{2})^{1/2}\\hskip 10.00002pt\\text{on }\\mathfrak{H}_{\\mathsf{P}}\\,."
        ],
        "A2.E11": [
          "\\mathsf{U}_{\\perp\\mathsf{P}}^{*}\\mathsf{U}_{\\perp\\mathsf{P}}=\\mathsf{\\Gamma}_{\\mathsf{P}}^{2}\\,,\\hskip 20.00003pt\\|\\mathsf{U}_{\\perp\\mathsf{P}}f\\|=\\|\\mathsf{\\Gamma}_{\\mathsf{P}}f\\|\\,,\\hskip 10.00002ptf\\in\\mathfrak{H}_{\\mathsf{P}}\\,."
        ]
      },
      "literal_byte_anchors": {
        "A2.E8": [
          {
            "math_id": "A2.E8.m1",
            "byte_start": 762739,
            "byte_end_exclusive": 764015,
            "raw_sha256": "f8a8fff0ab21ddb22a901e4c600fee25cb6fe314fb5e728cfaaf50163c462188"
          }
        ],
        "A2.E9": [
