    {
      "id": "transport:pi-chi2",
      "kind": "concept-bridge",
      "label": "Poincaré ↔ χ²: L² PL-shaped coercivity",
      "status": "proposal",
      "subtitle": "functional-inequality mirror",
      "summary": "Poincaré is a quadratic L2 coercivity inequality. For the reversible semigroup it controls the Dirichlet dissipation of the density fluctuation and yields exponential chi-square decay by the same scalar PL/Gronwall pattern.",
      "formula": "\\begin{gathered}\\chi^2(\\mu\\Vert\\pi)=\\|\\rho-1\\|_{L^2(\\pi)}^2\\\\\\operatorname{Var}_\\pi(f)\\le C_{\\mathrm{PI}}\\mathcal E(f,f)\\\\\\chi^2(\\pi_t\\Vert\\pi)\\le e^{-2t/C_{\\mathrm{PI}}}\\chi^2(\\pi_0\\Vert\\pi)\\end{gathered}",
      "details": [
        {
          "label": "Evidence boundary",
          "value": "Literature/structural correspondence; no Lean-certified functor or theorem transfer."
        },
        {
          "label": "Conceptual families",
          "value": "family:l2-coercivity"
        },
        {
          "label": "Mechanism",
          "value": "Poincaré is a quadratic L2 coercivity inequality. For the reversible semigroup it controls the Dirichlet dissipation of the density fluctuation and yields exponential chi-square decay by the same scalar PL/Gronwall pattern."
        },
        {
          "label": "Hypothesis Map",
          "value": "Use the exact reversible Markov-semigroup/Dirichlet-form domain and density hypotheses from the sampling source. On the optimization side the analogy is to a quadratic gap controlled by its gradient/dissipation, not an identification of objectives."
        },
        {
          "label": "Conclusion Map",
          "value": "Poincaré occupies the PL-shaped coercivity slot for the chi-square/L2 gap, while LSI occupies it for KL. This gives a clean family-level comparison of convergence mechanisms."
        },
        {
          "label": "Failure Boundary",
          "value": "Poincaré and LSI are different functional inequalities; chi-square and KL are different gaps. PI is generally weaker than LSI, and the reversible/domain hypotheses cannot be erased by the analogy."
        },
        {
          "label": "Category objects",
          "value": "A reversible semigroup together with its invariant measure, density gap and Dirichlet dissipation."
        },
        {
          "label": "Category morphisms",
          "value": "A conceptual slot correspondence with quadratic optimization coercivity; no direct theorem transport is claimed."
        },
        {
          "label": "Category identity",
          "value": "Not established; this is a functional-inequality mirror."
        },
        {
          "label": "Category composition",
          "value": "Do not compose PI/chi-square with LSI/KL edges by label similarity; exact comparison theorems must be cited separately."
        },
        {
          "label": "Shared planned checkpoints",
          "value": "semigroup, flow"
        },
