        "classification": "NODE",
        "clipped_at_region_boundary": false,
        "formula": "\\begin{split}\\mathsf{L}_{y,\\widetilde{x}}f(x,p)&\\coloneqq\\sqrt{\\eta}\\,p^{\\top}\\nabla_{x}f(x,p)-\\frac{(x-c_{y,\\widetilde{x}})^{\\top}}{\\sqrt{\\eta}}\\nabla_{p}f(x,p)\\\\\n&\\quad+\\sqrt{\\eta}\\,[p^{\\top}h_{\\widetilde{x}}(x)]_{+}\\bigl\\{f(x,R_{h_{\\widetilde{x}}(x)}p)-f(x,p)\\bigr\\}\\,.\\end{split}",
        "item_id": "S011",
