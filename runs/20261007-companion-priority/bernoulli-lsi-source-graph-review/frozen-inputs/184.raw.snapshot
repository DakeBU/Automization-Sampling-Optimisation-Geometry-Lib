      "formula": "theorem gradientNormSq_succ_decomposition {n : ℕ} (h : (Fin (n + 1) → Bool) → ℝ)\n    (ε : Fin (n + 1) → Bool) :\n    gradientNormSq (n + 1) h ε =\n    (∑ j : Fin n, (h ε - h (flipCoord (Fin.castSucc j) ε))^2) +\n    (h ε - h (flipCoord (Fin.last n) ε))^2",
