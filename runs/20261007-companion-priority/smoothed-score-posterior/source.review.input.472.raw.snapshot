  "source_gaps": [
    {
      "id": "GAP-PARTITION-L1",
      "obligation": "Derive0<Z_V,Z_eta(y)<infinity and actual R/r probabilities plus ordinary gradient/position L1 from source curvature; no supplied normalizer/moment certificates.",
      "source_status": "Implicit in proportional-law and conditional-mean notation."
    },
    {
      "id": "GAP-SCORE-DIFFERENTIATION",
      "obligation": "Prove actual derivative of unnormalized convolution with local integrable domination, positive log chain rule and unchanged normalization shift.",
      "source_status": "3.1 and4.1 asserted without complete differentiation proof."
    },
    {
      "id": "GAP-POSTERIOR-GRADIENT",
      "obligation": "Identify score with true posterior gradient mean; either direct convolution derivative or actual fullspace IBP after posterior-mean derivative.",
      "source_status": "3.1/p3.2 states the equality; analytical interchange/IBP conditions omitted."
    },
    {
      "id": "GAP-AFFINE-LAW",
      "obligation": "Prove literal affine pushforward equals normalized exp(-||u||²/2-rho(u)) law, using actual stationary p, change of variables and probability normalizers; Jacobian factors must cancel once.",
      "source_status": "p4.2 says under R standardized variable has this law; details omitted."
    },
    {
      "id": "GAP-INTEGRATE-CHAIN",
      "obligation": "Actual C1 chain/Riesz gradient equality, measurable affine map, Bochner integrability and integral_map/add/scalar rules; no assumed final integral identity.",
      "source_status": "Ex9 stated moreover with no written expanded proof."
    }
  ],
  "printed_author_route": "Source3.1/p3.2 states posterior gradient-score identity; p4.1 states proximal stationarity; Ex8 defines rho; p4.2 asserts actual standardized law; Ex9 states two identities. No full analytic proof of differentiation/normalization/integrating chain rule is printed.",
  "or_routes": [
    {
      "id": "DIRECT-CONVOLUTION-DERIVATIVE",
      "classification": "authored sufficient analytic expansion, not printed source topology",
      "steps": [
        "Derive true partitions and polynomial/Gaussian domination from C2 curvature.",
        "Differentiate h_eta(y)=E exp(-V(y-sqrteta*G)) with actual local domination.",
        "Log derivative equals posterior average gradV after exact change of variables/normalization."
      ],
      "avoids": "Separate integration-by-parts proof and separate posterior-position mean identity are not mandatory on this route."
    },
    {
      "id": "GAUSSIAN-DENSITY-DERIVATIVE-PLUS-IBP",
      "classification": "authored alternative sufficient analytic expansion",
      "steps": [
        "Differentiate Gaussian convolution in y to produce eta^-1(y-E_R X).",
        "Derive grad_x exp(-W)=-(gradV+(x-y)/eta)exp(-W) and all actual full-space L1 products/derivative/decay conditions.",
        "Integrate derivative to0 and identify E_RgradV=eta^-1(y-E_RX)."
      ],
      "hidden_obligations": "No supplied IBP/boundary/integrability certificate; source curvature must derive them. Mandatory compact cutoff is not asserted."
    }
  ],
  "source_to_identity_route_at_most7steps": [
    "Source potential/eta -> actual positive finite unnormalized convolution and R partition.",
    "Choose one of the two explicit sufficient derivative/IBP routes -> actual g_eta=E_RgradV.",
    "Actual proximal argmin -> stationary p (no supplied selector).",
    "Actual C2 affine chain rule -> grad rho=sqrteta*(gradV(p+sqrteta*u)-gradV(p)).",
    "Stationarity/change-of-variables/normalization -> true affine pushforward r_y, with exact Jacobian cancellation.",
    "Derive Bochner L1 of position/gradV/grad rho under the true laws; no added public moment.",
    "Integrate deterministic chain identity under r_y for first Ex9 equality; evaluate it at Gaussian noise for second equality."
  ],
  "consumer_use_boundary": "p5.2 uses identities with gradient-rho Lipschitz and4.6 to obtain4.2; that quantitative transport/bias consumer remains outside this packet.",
  "fixed_eta_joint_kernel_not_required": true,
  "source_anchor_correction": {
    "target": "S4.Ex9",
    "excluded": "S4.E9/(4.9)"
  },
