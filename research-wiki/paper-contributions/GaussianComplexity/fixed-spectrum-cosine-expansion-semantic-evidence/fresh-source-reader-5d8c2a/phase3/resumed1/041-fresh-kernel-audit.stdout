AutoSamplingTheory.ExampleCases.GaussianComplexity.FixedSpectrumCosineExpansion.cosine_series_value✝ {r : ℝ}
  (hr0 : 0 ≤ r) (hr1 : r < 1) (θ : ℝ) :
  1 + 2 * ∑' (j : ℕ), (-r) ^ (j + 1) * Real.cos (↑(j + 1) * θ) = (1 - r ^ 2) / (1 + 2 * r * Real.cos θ + r ^ 2)
