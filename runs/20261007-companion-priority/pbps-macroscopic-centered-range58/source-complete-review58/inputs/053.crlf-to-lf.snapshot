    "results": [
      {
        "schema_version": 1,
        "semantic_slots": {
          "objects": {
            "original": "PBPS B.1-B.5: actual joint Gaussian augmentation J, conditional projection P, reflection U, A=PUP and B=(I-P)UP.",
            "reconstructed": "The theorem fixes that J and P and produces one actual AE reflection isometry U with involution and self-adjointness.",
            "relation": "same",
            "evidence": "Literal J/F/P definitions match B.1/B.4. Actual55 produces U; hSameM equates M55 with canonical pullback using AE action, not an assumed operator equality."
          },
          "domains": {
            "original": "The source uses real L2 on Euclidean joint law and its centered macro subspace.",
            "reconstructed": "Finite real Hilbert/Borel E, including rank zero as an explicit extension; actual AE quotient real L2(J) with no L2 dimension constraint.",
            "relation": "explicit-elaboration",
            "evidence": "The only FiniteDimensional binder is on E. Corrected main/source/lesson prose allows finite or infinite L2; at rank zero J is Dirac and the centered macro space is zero. The separate stale current binding sentence is a publication blocker, not a Lean premise."
          },
          "quantifiers": {
            "original": "One reflection operator, followed by all centered macro observables.",
            "reconstructed": "Exists one U before all g and all f; AE composition holds for all g; the sharp bounds hold for every f in ran P with zero integral.",
            "relation": "same",
            "evidence": "hCentered supplies a centered u with Mu=f for each such f. hSameT compares T55 and T57 for every rough L2 input, using the same literal S density."
          },
          "assumptions": {
            "original": "C2 potential; 0<alpha<=beta; both global Hessian bounds; eta>0 and beta eta<=1.",
            "reconstructed": "Exactly this source floor, with finite Hilbert/Borel typing and conclusion input membership/centering.",
            "relation": "same",
            "evidence": "hH is explicitly the lower and upper quadratic-form bounds. No supplied normalization, operator, Poincare, range, root, conditional-law, compact-support or input-domain certificate is a caller premise."
          },
          "conclusion": {
            "original": "C.4 gives sharp centered macro contraction; B.5 and the final squared precursor to B.15 give gap 4 alpha eta/(1+alpha eta)^2.",
            "reconstructed": "Both exact norm inequalities for all true centered macro f in the actual J space.",
            "relation": "equivalent",
            "evidence": "Actual55 defect identity and MT=AM; actual57 scalar contraction; AE equality T55=T57; canonical M isometry. This proves the squared B gap, not the positive root conclusion."
          },
          "scopes": {
            "original": "Source C.3-C.4 use centering and scalar analytic bounds; printed centering follows self-adjointness together with constant preservation.",
            "reconstructed": "Test integration of actual55 production, new production range and actual57 Test. Stationarity/disintegration supplies centering on the actual marginal.",
            "relation": "explicit-elaboration",
            "evidence": "Current57 uses Lambda and S disintegration, equal marginals, and L2-to-L1 integrability to prove mean preservation. Constants alone are insufficient. Four formula steps agree with the exact current body; production modules do not import Tests."
          },
          "constant_dependencies": {
            "original": "rho=(1-t)/(1+t), t=alpha eta in (0,1], squared gap=4t/(1+t)^2.",
            "reconstructed": "Same constants and endpoint, no dimension factor.",
            "relation": "same",
            "evidence": "alpha<=beta and capped scale imply t<=1. rho is nonnegative before squaring. Only 1+t is divided by; t=1 gives rho=0 and gap=1 without division by 1-t."
          }
        },
