theorem AutoSamplingTheory.ExampleCases.GaussianComplexity.ProductDensity.actual_product_density : ∀ {d n : ℕ},
  3 ≤ n →
    n ≤ d →
      ∀ {κ : ℝ},
        4 ≤ κ →
          ∀ {b : ℝ},
            b = 1 ∨ b = -1 →
              have e :=
                ((((Equiv.prodComm (Fin n) (Fin (d / n))).trans finProdFinEquiv).sumCongr
                          (Equiv.refl (Fin (d % n)))).trans
                      finSumFinEquiv).trans
                  (finCongr ⋯);
              have split := fun x =>
                (fun j => WithLp.toLp 2 fun i => x.ofLp (e (Sum.inl (i, j))),
                  WithLp.toLp 2 fun i => x.ofLp (e (Sum.inr i)));
              have ν :=
                2 •
                  (AutoSamplingTheory.TechnicalLemmas.Probability.OrthogonalHaar.orthogonalHaar n).restrict
                    {O | (↑O).det = b};
              have D := Measure.map (DeterminantFamily.blockPrecision κ) (Measure.pi fun x => ν);
              have γ := fun A => multivariateGaussian 0 A⁻¹;
              have p := fun O x =>
                √(DeterminantFamily.singleBlockPrecision κ O).det / (2 * Real.pi) ^ (↑n / 2) *
                  Real.exp (-(x.ofLp ⬝ᵥ DeterminantFamily.singleBlockPrecision κ O *ᵥ x.ofLp) / 2);
              have pb := fun x => ∫ (O : ↥(orthogonalGroup (Fin n) ℝ)), p O x ∂ν;
              have φ := fun z => (2 * Real.pi) ^ (-↑(d % n) / 2) * Real.exp (-‖z‖ ^ 2 / 2);
              have q := fun y => (∏ j, pb (y.1 j)) * φ y.2;
              MeasurePreserving split ℙ ℙ ∧
                (∀ (y : (Fin (d / n) → EuclideanSpace ℝ (Fin n)) × EuclideanSpace ℝ (Fin (d % n))), 0 ≤ q y) ∧
                  Measurable q ∧
                    Integrable q ℙ ∧
                      ∫ (y : (Fin (d / n) → EuclideanSpace ℝ (Fin n)) × EuclideanSpace ℝ (Fin (d % n))), q y = 1 ∧
                        (Measure.map split (γ ∘ₘ D) = ℙ.withDensity fun y => ENNReal.ofReal (q y)) ∧
                          (γ ∘ₘ D = ℙ.withDensity fun x => ENNReal.ofReal (q (split x))) ∧
                            (d % n = 0 → ∀ (z : EuclideanSpace ℝ (Fin (d % n))), φ z = 1) :=
⋯
