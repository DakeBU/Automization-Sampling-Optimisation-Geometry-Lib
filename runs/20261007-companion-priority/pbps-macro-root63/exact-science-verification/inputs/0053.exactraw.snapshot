  "lean": {
    "statement": "∀ {E : Type u_1}\n  [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E]\n  [inst_3 : MeasurableSpace E] [BorelSpace E] (μ : MeasureTheory.Measure E) [MeasureTheory.IsProbabilityMeasure μ]\n  (b η τ : ℝ),\n  0 ≤ b →\n    0 ≤ η →\n      0 < τ →\n        ∀ (u : E),\n          have ρ := μ.tilted fun x => -(b / 2) * ‖x - u‖ ^ 2;\n          MeasureTheory.IsProbabilityMeasure ρ ∧\n            AutoSamplingTheory.TechnicalLemmas.Measure.GaussianSmoothing.gaussianSmoothing\n                  (AutoSamplingTheory.TechnicalLemmas.Measure.GaussianSmoothing.gaussianSmoothing ρ √η) √τ =\n                AutoSamplingTheory.TechnicalLemmas.Measure.GaussianSmoothing.gaussianSmoothing ρ √(η + τ) ∧\n              ∃ K,\n                ProbabilityTheory.IsMarkovKernel K ∧\n                  (∀ (y : E), K y = ρ.tilted fun x => -‖x - y‖ ^ 2 / (2 * (η + τ))) ∧\n                    ⇑K ∘ₘ\n                          AutoSamplingTheory.TechnicalLemmas.Measure.GaussianSmoothing.gaussianSmoothing\n                            (AutoSamplingTheory.TechnicalLemmas.Measure.GaussianSmoothing.gaussianSmoothing ρ √η) √τ =\n                        ρ ∧\n                      ∀ (ν : MeasureTheory.Measure E),\n                        MeasureTheory.IsProbabilityMeasure ν →\n                          ∀ (r : ℝ),\n                            0 ≤ r →\n                              AutoSamplingTheory.TechnicalLemmas.Measure.WassersteinSpace.wassersteinDistance ν\n                                    (AutoSamplingTheory.TechnicalLemmas.Measure.GaussianSmoothing.gaussianSmoothing ρ\n                                      √η) ≤\n                                  ENNReal.ofReal r →\n                                InformationTheory.klDiv\n                                    (⇑K ∘ₘ\n                                      AutoSamplingTheory.TechnicalLemmas.Measure.GaussianSmoothing.gaussianSmoothing ν\n                                        √τ)\n                                    ρ ≤\n                                  ENNReal.ofReal (r ^ 2 / (2 * τ))",
    "statement_sha256": "823a02fae44fdba23ffbb85825efd9dfb141131833b5b6ef2ab92391cb7a1075",
