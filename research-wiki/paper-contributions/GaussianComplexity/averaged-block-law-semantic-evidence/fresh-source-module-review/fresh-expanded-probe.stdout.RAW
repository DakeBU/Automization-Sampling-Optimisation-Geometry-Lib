@actual_averaged_block_product : ∀ {d n : ℕ},
  LE.le.{0} 3 n →
    LE.le.{0} n d →
      ∀ {κ : ℝ},
        LE.le.{0} 4 κ →
          ∀ {b : ℝ},
            Eq.{1} b 1 ∨ Eq.{1} b (-1) →
              have e :=
                Equiv.trans.{1, 1, 1}
                  (Equiv.trans.{1, 1, 1}
                    (Equiv.sumCongr.{0, 0, 0, 0}
                      (Equiv.trans.{1, 1, 1} (Equiv.prodComm.{0, 0} (Fin n) (Fin (HDiv.hDiv.{0, 0, 0} d n)))
                        finProdFinEquiv)
                      (Equiv.refl.{1} (Fin (HMod.hMod.{0, 0, 0} d n))))
                    finSumFinEquiv)
                  (finCongr ⋯);
              have split := fun x =>
                Prod.mk.{0, 0}
                  (fun j => WithLp.toLp.{0} 2 fun i => WithLp.ofLp.{0} x (e (Sum.inl.{0, 0} (Prod.mk.{0, 0} i j))))
                  (WithLp.toLp.{0} 2 fun i => WithLp.ofLp.{0} x (e (Sum.inr.{0, 0} i)));
              have ν :=
                HSMul.hSMul.{0, 0, 0} 2
                  (Measure.restrict.{0} (orthogonalHaar n) (Set.ofPred.{0} fun O => Eq.{1} (det.{0, 0} ↑O) b));
              have D := Measure.map.{0, 0} (blockPrecision κ) (Measure.pi.{0, 0} fun x => ν);
              have γ := fun A => multivariateGaussian.{0} 0 (Inv.inv.{0} A);
              have P :=
                Measure.bind.{0, 0} ν fun O => multivariateGaussian.{0} 0 (Inv.inv.{0} (singleBlockPrecision κ O));
              IsProbabilityMeasure.{0} D ∧
                (∀ᵐ (A : Matrix.{0, 0, 0} (Fin d) (Fin d) ℝ) ∂D, PosDef.{0, 0} A) ∧
                  IsProbabilityMeasure.{0} P ∧
                    IsProbabilityMeasure.{0} (Measure.bind.{0, 0} D γ) ∧
                      Eq.{1} (Measure.map.{0, 0} split (Measure.bind.{0, 0} D γ))
                        (Measure.prod.{0, 0} (Measure.pi.{0, 0} fun x => P)
                          (stdGaussian.{0} (EuclideanSpace.{0, 0} ℝ (Fin (HMod.hMod.{0, 0, 0} d n)))))
