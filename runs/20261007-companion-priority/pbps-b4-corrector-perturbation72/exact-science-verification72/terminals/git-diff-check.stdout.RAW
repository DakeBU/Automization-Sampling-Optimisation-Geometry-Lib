+{"math_id": "A2.E13.m1", "alttext": "4\\eta\\,\\|\\nabla\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}f\\|^{2}\\leq\\|f\\|^{2}-\\|\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}f\\|^{2}=\\|\\mathsf{\\Gamma}_{\\mathsf{P}}f\\|^{2}=\\|\\mathsf{U}_{\\perp\\mathsf{P}}f\\|^{2}\\,.", "RAW_start": 779019, "RAW_end_exclusive": 780803, "RAW_bytes": 1784, "RAW_sha256": "cc9c9564f917ef6e47ac9841b0de1817f9059ec52fbbd7d5aefd79c3ccbed99d"}
