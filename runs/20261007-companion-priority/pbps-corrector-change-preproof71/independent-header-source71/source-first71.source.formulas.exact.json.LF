    {
      "RAW_bytes": 963,
      "RAW_sha256": "1bd1077475c4494e87cde3f9878ba4d7cafd3debbd1ee97819aaef895c10a6fd",
      "alttext": "g_{\\mathsf{P}}\\coloneqq\\mathsf{P}g\\,,\\hskip 20.00003ptg_{\\mathsf{V}}\\coloneqq\\mathsf{V}_{\\perp\\mathsf{P}}^{*}\\mathsf{P}^{\\perp}g\\,.",
      "end_byte_exclusive": 831484,
      "id": "A2.Ex11.m1",
      "region": "corrector-sharp-energy-and-consumers-B3",
      "start_byte": 830521
    },
    {
      "RAW_bytes": 1734,
      "RAW_sha256": "93683d6e916a486e693ef973adc769288e6eb05bd245151942812f9e4b277a8d",
      "alttext": "\\begin{pmatrix}g_{\\mathsf{P}}\\\\\ng_{\\mathsf{V}}\\end{pmatrix}=\\begin{pmatrix}\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}&-\\mathsf{\\Gamma}_{\\mathsf{P}}\\\\\n\\mathsf{\\Gamma}_{\\mathsf{P}}&\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}\\end{pmatrix}\\begin{pmatrix}f_{\\mathsf{P}}\\\\\nf_{\\mathsf{V}}\\end{pmatrix}\\,.",
      "end_byte_exclusive": 833887,
      "id": "A2.Ex12.m1",
      "region": "corrector-sharp-energy-and-consumers-B3",
      "start_byte": 832153
    },
    {
      "RAW_bytes": 820,
      "RAW_sha256": "369d0863f8da4a69c1f2a6a548e8cf5ee314bd860ff7c74a51645ea5530dcba0",
      "alttext": "\\displaystyle\\mathscr{C}(g_{\\mathsf{P}},g_{\\mathsf{V}})-\\mathscr{C}(f_{\\mathsf{P}},f_{\\mathsf{V}})",
      "end_byte_exclusive": 851379,
      "id": "A2.Ex16.m1",
      "region": "corrector-sharp-energy-and-consumers-B3",
      "start_byte": 850559
    },
    {
      "RAW_bytes": 1829,
      "RAW_sha256": "5a368549b31dcd417d2a733e7713addfb8edf19b61f71f0aa014cc5add5e4046",
      "alttext": "\\displaystyle\\hskip 10.00002pt=\\mathscr{C}(\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}f_{\\mathsf{P}}-\\mathsf{\\Gamma}_{\\mathsf{P}}f_{\\mathsf{V}}\\,,\\mathsf{\\Gamma}_{\\mathsf{P}}f_{\\mathsf{P}}+\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}f_{\\mathsf{V}})-\\mathscr{C}(f_{\\mathsf{P}},f_{\\mathsf{V}})",
      "end_byte_exclusive": 853498,
      "id": "A2.Ex17.m1",
      "region": "corrector-sharp-energy-and-consumers-B3",
      "start_byte": 851669
    },
    {
      "RAW_bytes": 733,
      "RAW_sha256": "4232c70e799d987d5bb3b4efa325c7b750256bdcab32b35f0062519b376ba11b",
      "alttext": "\\displaystyle\\hskip 10.00002pt=-\\|f_{\\mathsf{P}}\\|^{2}+\\|f_{\\mathsf{V}}\\|^{2}\\,.",
      "end_byte_exclusive": 854520,
      "id": "A2.E21.m1",
      "region": "corrector-sharp-energy-and-consumers-B3",
      "start_byte": 853787
    },
    {
      "RAW_bytes": 1726,
      "RAW_sha256": "414c70fe9eeff784114cebd70f115324b5ef55693c1c073ce44fd195d39e1cf1",
      "alttext": "|\\mathscr{C}(f_{\\mathsf{P}},f_{\\mathsf{V}})|\\leq\\frac{1}{2\\gamma_{\\rm gap}}\\,\\bigl(\\|f_{\\mathsf{P}}\\|^{2}+\\|f_{\\mathsf{V}}\\|^{2}\\bigr)\\leq\\frac{1}{2\\gamma_{\\rm gap}}\\,\\|f\\|^{2}\\,.",
      "end_byte_exclusive": 877878,
      "id": "A2.E23.m1",
      "region": "corrector-sharp-energy-and-consumers-B3",
      "start_byte": 876152
    },
    {
      "RAW_bytes": 976,
      "RAW_sha256": "13dd4c9f48cc766b829faaa8d696e57caf1aac43c6ce1e3e9637a0664bc50a4a",
      "alttext": "\\frac{1}{2}\\,\\|f\\|^{2}\\leq\\mathscr{L}_{\\omega}(f)\\leq\\frac{3}{2}\\,\\|f\\|^{2}\\,.",
      "end_byte_exclusive": 862600,
      "id": "A2.E22.m1",
      "region": "corrector-sharp-energy-and-consumers-B3",
      "start_byte": 861624
    },
    {
      "RAW_bytes": 2160,
      "RAW_sha256": "f23382349cbd61146844fa48f185d7d40db1502d8cfb860de1e35ace58016692",
      "alttext": "r_{\\rho}\\coloneqq\\mathsf{V}_{\\perp\\mathsf{P}}^{*}\\bigl[I+(1-\\rho)\\mathsf{H}_{\\perp\\perp}\\bigr]f_{\\perp}=\\rho f_{\\mathsf{V}}+(1-\\rho)r\\,,\\hskip 20.00003ptr\\coloneqq\\mathsf{V}_{\\perp\\mathsf{P}}^{*}(I+\\mathsf{H}_{\\perp\\perp})f_{\\perp}\\,.",
      "end_byte_exclusive": 904096,
      "id": "A2.Ex27.m1",
      "region": "corrector-change-B4-consumer-proof",
      "start_byte": 901936
    },
    {
      "RAW_bytes": 1421,
      "RAW_sha256": "3d7644086a7382e1dcf9d90c06dd22cf6fb65717eaaa0bd62ef4fac82680c6e2",
      "alttext": "(\\mathsf{K}f)_{\\mathsf{P}}=g_{\\mathsf{P}}+\\mathsf{\\Gamma}_{\\mathsf{P}}r_{\\rho}\\,,\\hskip 20.00003pt(\\mathsf{K}f)_{\\mathsf{V}}=g_{\\mathsf{V}}-\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}r_{\\rho}\\,.",
      "end_byte_exclusive": 907280,
      "id": "A2.E27.m1",
      "region": "corrector-change-B4-consumer-proof",
      "start_byte": 905859
    },
    {
      "RAW_bytes": 2193,
      "RAW_sha256": "3aedade8d8c039b7e23b9000e71c7aa809da54f6e8c7d22ea85265a3e462a108",
      "alttext": "\\displaystyle\\hskip 10.00002pt=\\bigl[\\mathscr{C}\\bigl((\\mathsf{K}f)_{\\mathsf{P}},(\\mathsf{K}f)_{\\mathsf{V}}\\bigr)-\\mathscr{C}(g_{\\mathsf{P}},g_{\\mathsf{V}})\\bigr]+\\bigl[\\mathscr{C}(g_{\\mathsf{P}},g_{\\mathsf{V}})-\\mathscr{C}(f_{\\mathsf{P}},f_{\\mathsf{V}})\\bigr]",
      "end_byte_exclusive": 930640,
      "id": "A2.Ex36.m1",
      "region": "corrector-change-B4-consumer-proof",
      "start_byte": 928447
    },
    {
      "RAW_bytes": 1655,
      "RAW_sha256": "5abad36df9ceb52703220721f8b404e1032b289f5cbb9b94d6ce7baf82e178a9",
      "alttext": "\\displaystyle\\hskip 10.00002pt=-\\|f_{\\mathsf{P}}\\|^{2}+\\|f_{\\mathsf{V}}\\|^{2}+\\bigl\\langle g_{\\mathsf{P}},\\mathsf{\\Gamma}_{\\mathsf{P}}^{-1}r_{\\rho}\\bigr\\rangle+\\frac{1}{2}\\,\\|r_{\\rho}\\|^{2}\\,.",
      "end_byte_exclusive": 932584,
      "id": "A2.E28.m1",
      "region": "corrector-change-B4-consumer-proof",
      "start_byte": 930929
    },
    {
      "RAW_bytes": 1256,
      "RAW_sha256": "8debb9b418b9bb9227709d4a1ab70e6091fd5e388e2e470967f454731b715d23",
      "alttext": "\\Lambda_{\\rho}\\coloneqq\\log(1/\\gamma_{\\rm gap})+\\Bigl(\\frac{\\rho}{\\gamma_{\\rm gap}}\\Bigr)^{2}\\,,\\hskip 20.00003pt\\omega\\coloneqq\\frac{c_{\\rm hyp}\\rho}{\\Lambda_{\\rho}}\\,.",
      "end_byte_exclusive": 885697,
      "id": "A2.E25.m1",
      "region": "corrector-sharp-energy-and-consumers-B3",
      "start_byte": 884441
    },
    {
      "RAW_bytes": 1994,
      "RAW_sha256": "f87986c5a01cd206d8983c1a6e5f1a28e03aec4541ada040835c26d005092ea7",
      "alttext": "\\displaystyle\\mathscr{C}\\bigl((\\mathsf{K}f)_{\\mathsf{P}},(\\mathsf{K}f)_{\\mathsf{V}}\\bigr)-\\mathscr{C}(f_{\\mathsf{P}},f_{\\mathsf{V}})\\leq-\\frac{1}{2}\\,\\|f_{\\mathsf{P}}\\|^{2}+C\\Lambda_{\\rho}\\,\\|f_{\\perp}\\|^{2}\\,.",
      "end_byte_exclusive": 953981,
      "id": "A2.E31X.m2",
      "region": "corrector-change-B4-consumer-proof",
      "start_byte": 951987
    },
    {
      "RAW_bytes": 1219,
      "RAW_sha256": "e0471e2fa58a7c88700e0c33ec0a654a4ebe19a04a04b4a8dad65703c7af7f85",
      "alttext": "\\mathscr{L}_{\\omega}(\\mathsf{K}f)\\leq\\Bigl(1-\\frac{c\\rho}{\\Lambda_{\\rho}}\\Bigr)\\,\\mathscr{L}_{\\omega}(f)\\,.",
      "end_byte_exclusive": 888334,
      "id": "A2.E26.m1",
      "region": "corrector-sharp-energy-and-consumers-B3",
      "start_byte": 887115
    }
