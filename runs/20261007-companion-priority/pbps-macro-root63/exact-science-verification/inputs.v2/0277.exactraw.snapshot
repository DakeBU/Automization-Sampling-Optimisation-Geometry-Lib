      "status": "DEPENDENCY_READY_PROPOSAL_CONDITIONAL_ON62_VERIFIED_AND_DISTINCT_STATEMENT_TOPOLOGY_SEALS",
      "selected_target": "AutoSamplingTheory.ExampleCases.ProximalBPS.MacroscopicDefectRoot.actual_unique_positive_macroscopic_defect_root",
      "home": "One actual PBPS integration declaration; no new generic conjugation/adjoint/range wrappers",
      "source": [
        "PBPSv1 B1-B5(first equation),B10-B11,D1",
        "Original C2/two Hessian bounds0<alpha<=beta,eta>0,betaeta<=1"
      ],
      "public_binders": "Exact59 original finite real Hilbert/Borel E; V ContDiff ℝ2; alpha,beta NNReal with0<alpha≤beta; both global Hessian inequalities; eta>0,beta*eta≤1. Finite base E permits rank0 and potentially infinite-dimensional L2. No caller probability/normalizer/Markov/domain/onto/CompleteSpace/root/positivity/CFC or kernel certificate.",
      "canonical_objects": {
        "mu": "volume.tilted(-V)",
        "J": "(mu.prod(stdGaussian E)).map (x,z ↦ (x,x+sqrteta z))",
        "nu": "J.snd",
        "Lambda": "J.map(p ↦ (p.snd,2*p.fst-p.snd))",
        "S": "Internally produced literal tilted reflected conditional kernel, all y normalized and genuine Lambda.IsCondKernel with both marginalsnu",
        "HJ": "Lp ℝ2J",
        "HY": "Lp ℝ2nu",
        "mY": "MeasurableSpace.comap Prod.snd measurableSpaceE",
        "M": "Canonical Lp.compMeasurePreservingₗᵢ ℝ Prod.snd <measurable_snd,rfl>; not arbitrary isometry",
        "P": "H_P.subtypeL ∘L condExpL2 ℝ ℝ measurable_snd.comap_le = H_P.starProjection",
        "HP": "Preferred public domain model: lpMeas ℝ ℝ mY2J, with internally defined Fact(mY≤m0). Conclude HP=P.toLinearMap.range. This is the exact same closed submodule, not a supplied replacement.",
        "e": "Canonical M.equivRange composed LinearIsometryEquiv.ofEq of actual58 rangeM=lpMeas; e:HY≃ₗᵢ[ℝ]HP with subtype(eu)=Mu",
        "U": "Actual59 reflection isometric involution; AE pullback by F(x,y)=(x,2x-y). Align any ReflectionL2 witness by Lp.ext of same F, not only matching norms.",
        "T": "Actual59 SAME scalar conditional mean AE integral against literalS; retain selfadjointness/contractivity/mean preservation; scalar defect D=typed1HY-T*T",
        "A_joint": "P*U.toContinuousLinearMap*P : HJ→L[ℝ]HJ",
        "A_macro": "HP.orthogonalProjectionOnto ∘L U.toContinuousLinearMap ∘L HP.subtypeL : HP→L[ℝ]HP. Its inclusion equals A_joint applied to includedf; A_macro=e.conjStarAlgEquiv T.",
        "B_joint": "(typed1HJ-P)*U.toContinuousLinearMap*P : HJ→L[ℝ]HJ",
        "B_macro": "B_joint ∘L HP.subtypeL : HP→L[ℝ]HJ; values internally proved in P.ker. Source microscopic codomain inclusion is isometric; this ambient typed version suffices for B11.",
        "Gram": "B_macro.adjoint ∘L B_macro : HP→L[ℝ]HP",
        "GammaP": "e.conjStarAlgEquiv Gamma_scalar : HP→L[ℝ]HP"
      },
      "candidate_header_conclusions": [
        "Internally generated actual laws/S/U/canonicalM/e/T, with HP=P.range and every-vector actual intertwining incl(eu)=Mu and e(Tu)=A_macro(eu).",
        "A_macro IsSelfAdjoint/contractive and GammaP IsPositive; GammaP*GammaP=(1:HP→L[ℝ]HP)-A_macro*A_macro.",
        "B_macro.adjoint ∘L B_macro=GammaP*GammaP; forall f:HP, norm(B_macro f)=norm(GammaP f) and squared norms=norm(f)^2-norm(A_macro f)^2.",
        "forall G:HP→L[ℝ]HP, G.IsPositive→G*G=(typed1HP)-A_macro*A_macro→G=GammaP. This quantifies ALL competing positive roots; no supplied energy or commutation certificate."
      ],
      "named_type_boundary": "This is a semantic typed candidate, not compiled/sealed Lean header. Before proof, exact FULL named theorem TYPE must elaborate with intentional-fail criterion; local Fact(mY≤m0) derives from measurable_snd and CompleteSpace HP derives via Mathlib lpMeas. If choosing literal raw rangeP, construct completeness from P idempotence/closed range internally before adjoint/conjStarAlgEquiv elaboration; do not add CompleteSpace premise. Explicitly type every1 in operator expressions.",
      "route_max7": [
