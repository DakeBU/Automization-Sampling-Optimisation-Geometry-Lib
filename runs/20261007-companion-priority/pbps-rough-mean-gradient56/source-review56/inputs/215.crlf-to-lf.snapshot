from pathlib import Path
import json,hashlib,datetime
task=Path(__file__).parent
def read(name):
    with (task/name).open('rb') as handle:return handle.read()
def load(name):return json.loads(read(name).decode('utf-8'))
def save(name,obj):
    with (task/name).open('w',encoding='utf-8',newline='\n') as handle:json.dump(obj,handle,indent=2,ensure_ascii=False);handle.write('\n')
def preserve(name):
    path=task/(name+'.before-exhaustive-expansion.raw.snapshot')
    assert not path.exists()
    with path.open('wb') as handle:handle.write(read(name))
