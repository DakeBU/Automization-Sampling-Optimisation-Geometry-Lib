{"name":"canonical-publication","raw_bytes":7395,"raw_sha256":"16cf37a376d780be27d609234f0e754f95070b25b6e8f9935abafe481bfc559b"}
{
  "schema_version": 1,
  "items": [
    {
      "id": "real-l2-positive-square-order",
      "library": "pbps",
      "chapter": "pbps-01",
      "chapter_path": "example-cases/samplewiki/companions/proximal-bouncy-particle.html",
      "title": "Positive square order on arbitrary real L²",
      "source": {
        "url": "https://arxiv.org/html/2609.06905v1#A4.SS1",
        "edition": "arXiv:2609.06905v1; Lean4.33.0/fixedMathlib",
        "anchor": "Appendix D.1 bounded selfadjoint spectral calculus and unique nonnegative square root; ASTIS auxiliary real-L2 square-order corollary via Mathlib CFC monotonicity, consumed by B.15",
        "wording_status": "faithful paraphrase",
        "attribution": "Fan Chen, Sinho Chewi, Jianfeng Lu and Matthew S. Zhang provide Appendix D.1 spectral-calculus and unique nonnegative-root background. The displayed arbitrary-real-L2 square-order statement is an ASTIS auxiliary corollary using Mathlib CFC monotonicity and canonical complexification, not a separately printed D.1 theorem."
      },
      "statement": "For any measurable space Ω and any measure μ, let A and B be bounded real linear operators on real L²(μ). If A and B are positive (selfadjoint with nonnegative quadratic form) and B²−A² is positive, then B−A is positive. No finiteness or probability of μ, nontriviality, finite-dimensional L², commutation, or caller CFC instance is assumed. This is an ASTIS auxiliary consequence of positive square-root monotonicity, realized by the canonical complexification of real L²; it is consumed by the actual centered-root result.",
      "assumptions": [
        "Arbitrary measurable space and measure; bounded real operators A,B on real L²; A,B and B²−A² positive. No commutation, finiteness, probability, finite-dimensional L² or nontriviality premise."
      ],
      "formulae": [
        {
          "label": "Positive square order on arbitrary real L²",
          "tex": "A\\ge0,\\ B\\ge0,\\ B^2-A^2\\ge0\\Rightarrow B-A\\ge0."
        }
      ],
      "obligations": [
        {
          "id": "positive-square-order",
          "label": "Positive square order on arbitrary real L²"
        },
        {
          "id": "remaining-paper",
          "label": "Remaining paper, algorithm and cost obligations remain open"
        }
      ],
