flowchart TB
  Source["Textbooks · papers · research problems<br/>LaTeX and mathematical prose"]:::source

  subgraph ASTIS["Auto-Sampling-Theory-In-Sleep · hierarchical proving system"]
    direction LR
    Upper["UPPER<br/>source audit · assumptions<br/>proof DAG · process memory<br/><code>analytic_contract</code>"]:::upper
    Middle["MIDDLE<br/>source correspondence<br/>formal decomposition · retrieval<br/><code>formalization_map</code>"]:::middle
    Lower["LOWER<br/>proof scout · Lean worker<br/>Samplinglib / Mathlib API scout<br/><code>proof_attempt</code>"]:::lower
    Review["REVIEWERS<br/>source fidelity · hidden assumptions<br/>Lean gate · route and waste audit<br/><code>review</code>"]:::review
    Upper --> Middle --> Lower --> Review
  end

  subgraph Memory["Samplinglib · reusable verified formal memory"]
    direction TB
    subgraph Families["Mathematical library families"]
      direction LR
      Measure["Measure & Probability<br/>kernels · conditional expectation"]:::family
      Analysis["Analysis<br/>convexity · functional inequalities"]:::family
      Dynamics["Dynamics<br/>stochastic processes · SDE"]:::family
      Samplers["Sampling Algorithms<br/>Langevin · MCMC · proximal · diffusion"]:::family
    end
    Registry["Lean declarations · Registry · tests · source correspondence · exact gate digest"]:::registry
    Measure --> Registry
    Analysis --> Registry
    Dynamics --> Registry
    Samplers --> Registry
  end

  subgraph Surfaces["Learning and verification surfaces"]
    direction LR
    Calculation["Calculation Route<br/>textbook proof strategy"]:::surface
    Rigorous["Rigorous Details<br/>measurability · domains · limits"]:::surface
    Lean["Lean Foundations<br/>statements · dependencies · source"]:::surface
    Live["Live Formalization<br/>candidate · compile · packet export"]:::surface
  end

  Source --> Upper
  Review -->|accepted certificate| Registry
  Registry --> Calculation
  Registry --> Rigorous
  Registry --> Lean
  Registry --> Live

