    {
      "id": "M-SUM-INNER",
      "kind": "PINNED_API_DECLARATION",
      "statement": "protected theorem sum_inner_mul_inner (b : OrthonormalBasis ι 𝕜 E) (x y : E) :\n    ∑ i, ⟪x, b i⟫ * ⟪b i, y⟫ = ⟪x, y⟫ := by\n  have := congr_arg (innerSL 𝕜 x) (b.sum_repr y)\n  rw [map_sum] at this\n  convert! this\n  rw [map_smul, b.repr_apply_apply, mul_comm]\n  simp\n",
