      "id": "gibbs-linear-covariance-upper",
      "library": "samplewiki-route",
      "chapter": "sphmc-01",
      "chapter_path": "example-cases/samplewiki/companions/smoothed-picard-hmc.html",
      "title": "Actual Gibbs linear covariance upper",
      "source": {
        "url": "https://arxiv.org/html/2609.06906v1#S4.Thmtheorem1",
        "edition": "arXiv:2609.06906v1",
        "anchor": "SPHMC arXiv:2609.06906v1 Sections1-3 standing beta=1/alpha=kappa^-1/RGO/smoothing and Section4.1 S4.E1, Lemma4.1 S4.Thmtheorem1, S4.Ex4-6; actual unreflected posterior covariance and source unnormalized V_eta. Primary-first Smoothed_Hessian_lower_source_preread.md.",
        "wording_status": "faithful paraphrase",
        "attribution": "Fan Chen, Sinho Chewi, Jianfeng Lu, Matthew S. Zhang; canonical isotropic BOTH-curvature node."
      },
      "statement": "For each direction a, the genuine covariance bilinear form of the normalized BOTH-curvature Gibbs law satisfies Cov_mu(a,a)<=norma^2/m, using the actual linear observable, constant gradient and proven C1 Poincare.",
      "assumptions": [
        "Finite real Hilbert/Borel full E including0, actual C2 W, true exp(-W) volume integrability and positive partition, BOTH global mI<=HessW<=MI with0<m<=M.",
        "Genuine vector id in L2 of normalized tilted Gibbs law. This canonical node keeps the moment premise explicit to rule out totalized covariance outside its integrable domain; the actual paper consumer produces it internally. No covariance/Poincare certificate input."
      ],
      "formulae": [
        {
          "label": "Actual Gibbs linear covariance upper",
          "tex": "\\mu=Z^{-1}e^{-W}dx,\\quad mI\\preceq D^2W\\preceq MI,\\quad X\\in L^2(\\mu)\\Longrightarrow \\operatorname{Cov}_\\mu(a,a)\\le \\|a\\|^2/m."
        }
      ],
      "obligations": [
        {
          "id": "actual-hessian",
          "label": "Actual Lemma4.1 analytic bounds"
        },
        {
          "id": "full-bl",
          "label": "Full anisotropic BL remaining"
        },
        {
          "id": "full-papers",
          "label": "Both main results and actual-input expectedcost composition remaining"
        }
      ],
      "bindings": [
        {
          "declaration": "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.GibbsLinearCovarianceUpper.gibbs_linear_covariance_upper",
          "cell": "ASTIS-SHARED-gibbs-linear-covariance-upper",
          "role": "prerequisite",
          "supports": [
            "actual-hessian"
          ],
          "audit_id": "ASTIS-RT-20261006-GibbsLinearCovarianceUpper",
          "boundary": "Canonical BOTH-curvature Gibbs linear covariance upper with genuine vectorL2, actual positive partition and probability normalization; not full anisotropic Brascamp-Lieb. Actual source beta=1 alpha=kappa^-1, 1<=kappa, 0<eta<=1; genuine posterior law R_y, internally produced probability/vectorL2/positive partitions/C2 and normalized-U versus unnormalized-V_eta constant shift. Derive true covariance upper and both Hessian bounds (kappa+eta)^-1 and (1+eta)^-1, then true 1-Lipschitz gradient. Finite real Hilbert/Borel including zero dimension is disclosed representation extension. No input covariance/PI/oracle/moment/normalizer certificate on source Anchor. No joint measurable posterior kernel selector, higher smoothing derivatives, algorithm/Wp/proxy-warmness/main/querycost/composition. PBPS reflected quarter law and source-score remain separate. TV never transfers unbounded expected cost.",
          "assumption_deltas": [
            {
              "source": "Isotropic covariance estimate invoked through Brascamp-Lieb; source standing curvature beta1/alpha=kappa^-1.",
              "lean": "Finite real Hilbert/Borel full E including0, actual C2 W, true exp(-W) volume integrability and positive partition, BOTH global mI<=HessW<=MI with0<m<=M.\nGenuine vector id in L2 of normalized tilted Gibbs law. This canonical node keeps the moment premise explicit to rule out totalized covariance outside its integrable domain; the actual paper consumer produces it internally. No covariance/Poincare certificate input.",
              "classification": "generalization",
              "reason": "Canonical B explicitly includes actual vectorL2 and BOTH curvature, not full anisotropic BL. Source A has no added proof premise and produces genuine moments/normalizers internally."
            },
            {
              "source": "Printed covariance upper invocation and reverse-Cramer-Rao lower yield both Hessian bounds.",
              "lean": "For each direction a, the genuine covariance bilinear form of the normalized BOTH-curvature Gibbs law satisfies Cov_mu(a,a)<=norma^2/m, using the actual linear observable, constant gradient and proven C1 Poincare.",
              "classification": "source-implicit",
              "reason": "Poincare-derived isotropic covariance route is a sufficient authored OR-route; it does not certify full BL or external book theorem."
            },
            {
              "source": "Higher regularity, algorithms and both main/cost composition.",
              "lean": "Canonical BOTH-curvature Gibbs linear covariance upper with genuine vectorL2, actual positive partition and probability normalization; not full anisotropic Brascamp-Lieb. Actual source beta=1 alpha=kappa^-1, 1<=kappa, 0<eta<=1; genuine posterior law R_y, internally produced probability/vectorL2/positive partitions/C2 and normalized-U versus unnormalized-V_eta constant shift. Derive true covariance upper and both Hessian bounds (kappa+eta)^-1 and (1+eta)^-1, then true 1-Lipschitz gradient. Finite real Hilbert/Borel including zero dimension is disclosed representation extension. No input covariance/PI/oracle/moment/normalizer certificate on source Anchor. No joint measurable posterior kernel selector, higher smoothing derivatives, algorithm/Wp/proxy-warmness/main/querycost/composition. PBPS reflected quarter law and source-score remain separate. TV never transfers unbounded expected cost.",
              "classification": "unresolved",
              "reason": "Only actual analytic Lemma4.1 and its canonical covariance prerequisite are covered."
            }
          ]
        }
      ],
