hρH :
  ∀ (u v : E),
    0 ≤
        ((fderiv ℝ (fderiv ℝ ((fun s u => V (p s + √(eta s) • u) - V (p s) - √(eta s) * ⟪gradient V (p s), u⟫) s)) u) v)
          v ∧
      ((fderiv ℝ (fderiv ℝ ((fun s u => V (p s + √(eta s) • u) - V (p s) - √(eta s) * ⟪gradient V (p s), u⟫) s)) u) v)
          v ≤
        eta s * ‖v‖ ^ 2
_hQH :
  ∀ (u v : E),
