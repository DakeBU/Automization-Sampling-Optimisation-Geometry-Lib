    },
    {
      "RAW_bytes": 989,
      "RAW_sha256": "946011d2e98371791f53584d41eae9841f75b9c451b9ff9f0931a4efe26f158b",
      "alttext": "\\mathsf{\\Gamma}_{\\mathsf{P}}\\coloneqq(I-\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}^{2})^{1/2}\\hskip 10.00002pt\\text{on }\\mathfrak{H}_{\\mathsf{P}}\\,.",
      "id": "A2.E10.m1",
      "region": "same-root-polar-B2",
      "source_RAW_range_end_exclusive": [
        769191,
        770180
      ]
    },
    {
      "RAW_bytes": 1668,
      "RAW_sha256": "8338ca405c1266355b6cd55b01765254f3e0497cb0fe82e614bba2df54a6d99d",
      "alttext": "\\mathsf{U}_{\\perp\\mathsf{P}}^{*}\\mathsf{U}_{\\perp\\mathsf{P}}=\\mathsf{\\Gamma}_{\\mathsf{P}}^{2}\\,,\\hskip 20.00003pt\\|\\mathsf{U}_{\\perp\\mathsf{P}}f\\|=\\|\\mathsf{\\Gamma}_{\\mathsf{P}}f\\|\\,,\\hskip 10.00002ptf\\in\\mathfrak{H}_{\\mathsf{P}}\\,.",
      "id": "A2.E11.m1",
      "region": "same-root-polar-B2",
      "source_RAW_range_end_exclusive": [
        771747,
        773415
      ]
    },
    {
      "RAW_bytes": 1339,
      "RAW_sha256": "9905e9f217f502cb25f0d34745f831a303d95a84d654d90d2e42a9dc47d34413",
      "alttext": "\\rho_{\\rm mac}\\coloneqq\\frac{1-\\alpha\\eta}{1+\\alpha\\eta}\\,,\\hskip 20.00003pt\\gamma_{\\rm gap}\\coloneqq\\sqrt{1-\\rho_{\\rm mac}^{2}}=\\frac{2\\sqrt{\\alpha\\eta}}{1+\\alpha\\eta}\\,.",
      "id": "A2.E12.m1",
      "region": "same-root-polar-B2",
      "source_RAW_range_end_exclusive": [
        775269,
        776608
      ]
    },
    {
      "RAW_bytes": 1371,
      "RAW_sha256": "e9ed8d1a118281455eafe4b38f4468e972be4eaddf50b947b625126235b94c5f",
      "alttext": "\\|\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}\\|\\leq\\rho_{\\rm mac}\\hskip 10.00002pt\\text{and}\\hskip 10.00002pt\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}\\succeq-\\frac{1}{2}\\,I\\hskip 20.00003pt\\text{on }\\mathfrak{H}_{\\mathsf{P},0}\\,.",
      "id": "A2.E14.m1",
      "region": "same-root-polar-B2",
      "source_RAW_range_end_exclusive": [
        782215,
        783586
      ]
    },
    {
      "RAW_bytes": 1196,
      "RAW_sha256": "6358fac9054d2fc6d800079096ec3d1b56da3b3ff7ff3111bbdeb8d3125d9fa0",
      "alttext": "\\mathsf{\\Gamma}_{\\mathsf{P}}=(I-\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}^{2})^{1/2}\\succeq\\gamma_{\\rm gap}I\\hskip 20.00003pt\\text{on }\\mathfrak{H}_{\\mathsf{P},0}\\,.",
      "id": "A2.E15.m1",
      "region": "same-root-polar-B2",
      "source_RAW_range_end_exclusive": [
        784175,
        785371
      ]
    },
    {
      "RAW_bytes": 2311,
      "RAW_sha256": "e4f18034c8ed8792b4874b861748629ebb2839a41d78897340e2de1a4b6395c8",
      "alttext": "\\mathsf{U}_{\\perp\\mathsf{P}}=\\mathsf{V}_{\\perp\\mathsf{P}}\\mathsf{\\Gamma}_{\\mathsf{P}}\\,,\\hskip 20.00003pt\\mathsf{V}_{\\perp\\mathsf{P}}\\coloneqq\\mathsf{U}_{\\perp\\mathsf{P}}\\mathsf{\\Gamma}_{\\mathsf{P}}^{-1}\\,:\\mathfrak{H}_{\\mathsf{P},0}\\longrightarrow\\mathfrak{H}_{\\perp}\\,,\\hskip 20.00003pt\\mathsf{V}_{\\perp\\mathsf{P}}^{*}\\mathsf{V}_{\\perp\\mathsf{P}}=I_{\\mathfrak{H}_{\\mathsf{P},0}}\\,.",
      "id": "A2.E16.m1",
      "region": "same-root-polar-B2",
      "source_RAW_range_end_exclusive": [
        790765,
        793076
      ]
    },
    {
      "RAW_bytes": 1836,
      "RAW_sha256": "ae13fca7274c7ca95fa7ee22c576dea4192a0220a14809c24c843c7b20e40fa8",
      "alttext": "\\bigl\\|(I+\\mathsf{H}_{\\perp\\perp})\\mathsf{V}_{\\perp\\mathsf{P}}v\\bigr\\|^{2}\\leq C\\log(1/\\gamma_{\\rm gap})\\,\\|\\mathsf{\\Gamma}_{\\mathsf{P}}v\\|^{2}\\,,\\hskip 20.00003ptv\\in\\mathfrak{H}_{\\mathsf{P},0}\\,.",
      "id": "A2.E17.m1",
      "region": "same-root-polar-B2",
      "source_RAW_range_end_exclusive": [
        796738,
        798574
      ]
    },
    {
      "RAW_bytes": 3095,
      "RAW_sha256": "69c506c95c65a72bd4164a4e1da15ad3b45efdcef4e430894b1da0f44973b00b",
      "alttext": "\\begin{split}\\mathfrak{H}_{\\mathsf{P}}&\\coloneqq\\operatorname{ran}(\\mathsf{P})=\\{f\\in\\mathfrak{H}:f(x,y)=g(y)\\text{ for some }g\\in L^{2}(\\pi_{\\eta}^{Y})\\}\\,,\\\\\n\\mathfrak{H}_{\\perp}&\\coloneqq\\ker(\\mathsf{P})=\\operatorname{ran}(\\mathsf{P}^{\\perp})=\\{f\\in\\mathfrak{H}:\\mathbb{E}[f(X,Y)\\mid Y]=0\\}\\,.\\end{split}",
      "id": "A2.E2.m1",
      "region": "conditional-reflection-blocks-B1",
      "source_RAW_range_end_exclusive": [
        720692,
        723787
      ]
    },
    {
      "RAW_bytes": 1946,
      "RAW_sha256": "f1a5862a52d5ebf635a6a45763a8eb1a379cfe8e2326d31e0e698e357d3b2b5f",
      "alttext": "\\mathscr{C}(f_{\\mathsf{P}},f_{\\mathsf{V}})\\coloneqq\\frac{1}{2}\\,\\bigl(\\|f_{\\mathsf{P}}\\|^{2}-\\|f_{\\mathsf{V}}\\|^{2}\\bigr)-\\bigl\\langle\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}\\mathsf{\\Gamma}_{\\mathsf{P}}^{-1}f_{\\mathsf{P}},f_{\\mathsf{V}}\\bigr\\rangle\\,.",
      "id": "A2.E20.m1",
      "region": "corrector-sharp-energy-and-consumers-B3",
      "source_RAW_range_end_exclusive": [
        821632,
        823578
      ]
    },
    {
      "RAW_bytes": 733,
      "RAW_sha256": "4232c70e799d987d5bb3b4efa325c7b750256bdcab32b35f0062519b376ba11b",
      "alttext": "\\displaystyle\\hskip 10.00002pt=-\\|f_{\\mathsf{P}}\\|^{2}+\\|f_{\\mathsf{V}}\\|^{2}\\,.",
      "id": "A2.E21.m1",
      "region": "corrector-sharp-energy-and-consumers-B3",
      "source_RAW_range_end_exclusive": [
        853787,
        854520
      ]
    },
    {
      "RAW_bytes": 1256,
      "RAW_sha256": "8debb9b418b9bb9227709d4a1ab70e6091fd5e388e2e470967f454731b715d23",
      "alttext": "\\Lambda_{\\rho}\\coloneqq\\log(1/\\gamma_{\\rm gap})+\\Bigl(\\frac{\\rho}{\\gamma_{\\rm gap}}\\Bigr)^{2}\\,,\\hskip 20.00003pt\\omega\\coloneqq\\frac{c_{\\rm hyp}\\rho}{\\Lambda_{\\rho}}\\,.",
      "id": "A2.E25.m1",
      "region": "corrector-sharp-energy-and-consumers-B3",
      "source_RAW_range_end_exclusive": [
        884441,
        885697
      ]
    },
    {
      "RAW_bytes": 1219,
      "RAW_sha256": "e0471e2fa58a7c88700e0c33ec0a654a4ebe19a04a04b4a8dad65703c7af7f85",
      "alttext": "\\mathscr{L}_{\\omega}(\\mathsf{K}f)\\leq\\Bigl(1-\\frac{c\\rho}{\\Lambda_{\\rho}}\\Bigr)\\,\\mathscr{L}_{\\omega}(f)\\,.",
      "id": "A2.E26.m1",
      "region": "corrector-sharp-energy-and-consumers-B3",
      "source_RAW_range_end_exclusive": [
        887115,
        888334
      ]
    },
    {
      "RAW_bytes": 1421,
      "RAW_sha256": "3d7644086a7382e1dcf9d90c06dd22cf6fb65717eaaa0bd62ef4fac82680c6e2",
      "alttext": "(\\mathsf{K}f)_{\\mathsf{P}}=g_{\\mathsf{P}}+\\mathsf{\\Gamma}_{\\mathsf{P}}r_{\\rho}\\,,\\hskip 20.00003pt(\\mathsf{K}f)_{\\mathsf{V}}=g_{\\mathsf{V}}-\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}r_{\\rho}\\,.",
      "id": "A2.E27.m1",
      "region": "corrector-change-B4-consumer-proof",
