  "exact_mathematical_delta": [],
  "exact_signature_text": "theorem balanced_count_sum_tendsto_gaussian :\n    ∃ laws : ℕ → ProbabilityMeasure ℝ,\n      (∀ n : ℕ, (laws n : Measure ℝ) =\n        (((Fintype.card (Fin n → Bool) : ℝ≥0∞)⁻¹ •\n          (Measure.count : Measure (Fin n → Bool))).map\n          (fun ε : Fin n → Bool => (Real.sqrt (n : ℝ))⁻¹ *\n            ∑ j : Fin n, if ε j then (1 : ℝ) else -1))) ∧\n      (laws 0 : Measure ℝ) = Measure.dirac 0 ∧\n      Tendsto (fun n : ℕ => laws (n + 1)) atTop\n        (𝓝 (⟨gaussianReal 0 1, inferInstance⟩ : ProbabilityMeasure ℝ))\n",
  "fullname": "AutoSamplingTheory.TechnicalLemmas.Probability.BalancedRademacherCLT.balanced_count_sum_tendsto_gaussian",
