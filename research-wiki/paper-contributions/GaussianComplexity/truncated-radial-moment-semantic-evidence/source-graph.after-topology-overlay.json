  "nodes": [
    {
      "id": "row-index-dimension",
      "kind": "source-setup",
      "content": "r=q+1 and 1≤i≤d.",
      "source_ids": [
        "A3.SS2.p1.m1",
        "A3.SS2.p1.m3"
      ]
    },
    {
      "id": "row-definition",
      "kind": "source-definition",
      "content": "γ_i=((g_1)_i,…,(g_r)_i)ᵀ ∈ ℝ^r.",
      "source_ids": [
        "A3.Ex85.m1#row"
      ]
    },
    {
      "id": "row-marginal",
      "kind": "source-standing",
      "content": "Each γ_i has marginal law N(0,I_r).",
      "source_ids": [
        "A3.SS2.p1.m4",
        "A3.SS2.p1.m5"
      ]
    },
    {
      "id": "radial-variable",
      "kind": "source-definition",
      "content": "R_i=‖γ_i‖².",
      "source_ids": [
        "A3.SS2.p10.m2"
      ]
    },
    {
      "id": "cutoff",
      "kind": "source-definition",
      "content": "L=2r+3 log(1000d).",
      "source_ids": [
        "A3.SS2.p10.m1"
      ]
    },
    {
      "id": "exp-moment",
      "kind": "source-upstream-input",
      "content": "E exp(R_i/3)=3^(r/2). Its Gaussian computation is upstream of this increment.",
      "source_ids": [
        "A3.SS2.p10.m3"
      ]
    },
    {
      "id": "markov",
      "kind": "source-named-reuse",
      "content": "Markov’s inequality for a nonnegative integrable variable and positive threshold.",
      "source_ids": [
        "A3.SS2.p10.1#Markov"
      ]
    },
    {
      "id": "log3",
      "kind": "source-upstream-input",
      "content": "(log 3)/2<2/3.",
      "source_ids": [
        "A3.SS2.p10.m5"
      ]
    },
    {
      "id": "row-dimension-positive",
      "kind": "SOURCE_GAP",
      "content": "r≥1.",
      "source_ids": [
        "A3.SS2.p1.m1"
      ]
    },
    {
      "id": "log-argument-positive",
      "kind": "SOURCE_GAP",
      "content": "d≥1, so 1000d>0 and log(1000d)≥0.",
      "source_ids": [
        "A3.SS2.p1.m3",
        "A3.SS2.p10.m1"
      ]
    },
    {
      "id": "row-tail",
      "kind": "source-reused-display",
      "content": "For x≥0, P(R_i>2r+3x)≤exp((r/2)log 3−2r/3−x)≤exp(−x).",
      "source_ids": [
        "A3.SS2.p10.m4",
        "A3.Ex104.m1"
      ]
    },
    {
      "id": "cutoff-nonnegative",
      "kind": "SOURCE_GAP",
      "content": "L≥0.",
      "source_ids": [
        "A3.SS2.p10.m1"
      ]
    },
    {
      "id": "shift-substitution",
      "kind": "SOURCE_GAP",
      "content": "For s≥0 set x=log(1000d)+s/3; x≥0, 2r+3x=L+s, and exp(−x)=exp(−s/3)/(1000d).",
      "source_ids": [
        "A3.SS2.p11.m1",
        "A3.SS2.p11.1#same-tail"
      ]
    },
    {
      "id": "shifted-tail",
      "kind": "source-unnamed-estimate",
      "content": "For each i and real s≥0, P(R_i>L+s)≤exp(−s/3)/(1000d).",
      "source_ids": [
        "A3.SS2.p11.m1",
        "A3.SS2.p11.1#same-tail",
        "A3.SS2.p11.m2"
      ]
    },
    {
      "id": "radial-regularity",
      "kind": "SOURCE_GAP",
      "content": "R_i is nonnegative and measurable; the strict and weak threshold sets are measurable. Squared Euclidean norm is continuous.",
      "source_ids": [
        "A3.SS2.p1.m5",
        "A3.SS2.p10.m2"
      ]
    },
    {
      "id": "nonnegative-layer-cake",
      "kind": "SOURCE_GAP",
      "content": "Pointwise R_i 1_{R_i>L}=L 1_{R_i>L}+(R_i−L)_+ and (R_i−L)_+=∫₀∞1_{R_i>L+s}ds. Nonnegative Tonelli gives the displayed identity in extended nonnegative values.",
      "source_ids": [
        "A3.Ex106.m1",
        "A3.Ex106.m2#identity"
      ]
    },
    {
      "id": "integrate-envelope",
      "kind": "SOURCE_GAP",
      "content": "∫₀∞exp(−s/3)ds=3. The shifted bound gives finite integrable tail with integral ≤3/(1000d) and L P(R_i>L)≤L/(1000d).",
      "source_ids": [
        "A3.SS2.p11.1#hence",
        "A3.Ex106.m2#bound"
      ]
    },
    {
      "id": "tail-moment-identity",
      "kind": "source-unnamed-identity",
      "content": "E[R_i 1_{R_i>L}]=L P(R_i>L)+∫₀∞P(R_i>L+s)ds.",
      "source_ids": [
        "A3.Ex106.m1",
        "A3.Ex106.m2#identity"
      ]
    },
    {
      "id": "tail-moment-upper",
      "kind": "source-unnamed-bound",
      "content": "E[R_i 1_{R_i>L}]≤(L+3)/(1000d).",
      "source_ids": [
        "A3.SS2.p11.1#hence",
        "A3.Ex106.m2#bound"
      ]
    },
    {
      "id": "radial-second-moment",
      "kind": "SOURCE_GAP",
      "content": "R_i is a finite sum of squared centered coordinates with variance one. Each square is integrable with mean one; hence R_i is integrable and E R_i=r.",
      "source_ids": [
        "A3.SS2.p12.m3"
      ]
    },
    {
      "id": "radial-mean",
      "kind": "source-unnamed-estimate",
      "content": "E R_i=r, with the finite expectation supplied by the Gaussian second moment.",
      "source_ids": [
        "A3.SS2.p12.m3"
      ]
    },
    {
      "id": "scalar-a",
      "kind": "source-definition",
      "content": "a=(1/r)E[R_i 1_{R_i≤L}].",
      "source_ids": [
        "A3.Ex108.m1#a"
      ]
    },
    {
      "id": "truncated-integrability",
      "kind": "SOURCE_GAP",
      "content": "Both truncations R_i 1_{R_i≤L} and R_i 1_{R_i>L} are measurable, nonnegative, bounded by R_i and integrable.",
      "source_ids": [
        "A3.Ex108.m1#a",
        "A3.Ex109.m1#identity"
      ]
    },
    {
      "id": "common-a",
      "kind": "source-assertion",
      "content": "The same a works for each i.",
      "source_ids": [
        "A3.SS2.p12.m1",
        "A3.SS2.p12.3#common-a",
        "A3.SS2.p12.m2"
      ]
    },
    {
      "id": "complementary-truncations",
      "kind": "SOURCE_GAP",
      "content": "The two indicated variables sum to R_i pointwise, so their expectations add to r.",
      "source_ids": [
        "A3.Ex108.m1#a",
        "A3.Ex109.m1#identity"
      ]
    },
    {
      "id": "scalar-range",
      "kind": "source-unnamed-bound",
      "content": "0≤a≤1.",
      "source_ids": [
        "A3.SS2.p12.m4"
      ]
    },
    {
      "id": "scalar-bias-identity",
      "kind": "source-unnamed-identity",
      "content": "1−a=(1/r)E[R_i 1_{R_i>L}].",
      "source_ids": [
        "A3.Ex109.m1#identity"
      ]
    },
    {
      "id": "scalar-bias-upper",
      "kind": "source-unnamed-bound",
      "content": "1−a≤(L+3)/(1000rd).",
      "source_ids": [
        "A3.Ex109.m1#bound"
      ]
    }
  ],
