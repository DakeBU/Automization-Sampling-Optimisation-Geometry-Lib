{
  "schema_version": 1,
  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.TwoPointEntropy.two_point_squared_entropy_le_half_sq_sub",
      "title": "Signed two-point square entropy upper bound",
      "sources": [
        {
          "url": "https://github.com/YuanheZ/lean-stat-learning-theory/blob/d0f506f0a695018265dccb33bcb05e2f5ca1c876/SLT/GaussianLSI/TwoPoint.lean",
          "label": "rothaus_lemma L734-L814 and signed-square/zero extension",
          "scope": "Genuine signed two-point and true finite Bool function LSI with exact half coefficient, derived probability/L1 domains; authored direct RMS-induction route. No GaussianLSI/T2/FIRST4.6/W2/bias/main/work/composition. Focused2653 passed actual n0/indicator/signed/normalizedRademacher n2 tests; all6 prints standard3 only. Independent wholeproof/blind/source/exactcommit admission, integration and exposition remain separate."
        }
      ],
      "tests": [
        "lake build Tests.BernoulliLogSobolev"
      ],
      "assumptions": [
        "Arbitrary a,b in real numbers; signed and zero inputs retained. No extra hypotheses."
      ],
      "statement": "For every signed real a,b, including zero, the homogeneous two-point entropy of their squares is at most half their squared difference.",
      "formula": "\\frac{a^2\\log a^2+b^2\\log b^2}{2}-\\frac{a^2+b^2}{2}\\log\\frac{a^2+b^2}{2}\\le\\frac{(a-b)^2}{2}.",
      "boundary": "Genuine signed two-point and true finite Bool function LSI with exact half coefficient, derived probability/L1 domains; authored direct RMS-induction route. No GaussianLSI/T2/FIRST4.6/W2/bias/main/work/composition. Focused2653 passed actual n0/indicator/signed/normalizedRademacher n2 tests; all6 prints standard3 only. Independent wholeproof/blind/source/exactcommit admission, integration and exposition remain separate.",
      "steps": [
        {
          "title": "Positive squares: the upper Rothaus direction",
          "text": "For positive A,B, the actual scalar calculus proves the positive defect 2-2sqrt(1-t²)-phi(t) by two mean-value arguments, then rescales m=(A+B)/2, t=(A-B)/(A+B). All logarithm/sqrt derivative domains are proved inside the helper closure.",
          "formula": "\\frac{A\\log A+B\\log B}{2}-m\\log m\\le\\frac{(\\sqrt A-\\sqrt B)^2}{2},\\quad A,B>0.",
          "lean": "private rothausDefect_nonneg; rothaus_lemma"
        },
        {
          "title": "Pass to signed inputs",
          "text": "Apply the positive inequality to A=a²,B=b², then use sqrt(a²)=|a| and the reverse absolute-value triangle inequality. This is the upper entropy bound, not the unrelated lower-bound theorem.",
          "formula": "(|a|-|b|)^2\\le(a-b)^2.",
          "lean": "Real.sqrt_sq_eq_abs; abs_abs_sub_abs_le_abs_sub"
        },
        {
          "title": "Include zero values",
          "text": "If one square vanishes, expand log(A/2)=log A-log2. The remaining entropy is A log2/2≤A/2 because log2≤1; if both vanish, both sides are zero.",
          "formula": "\\operatorname{Ent}_2(A,0)=\\tfrac A2\\log2\\le\\tfrac A2.",
          "lean": "Real.log_div; Real.log_le_sub_one_of_pos; actual zero branches"
        }
      ],
      "lean_statement": "For every signed real a,b, including zero, the homogeneous two-point entropy of their squares is at most half their squared difference.",
      "lean_proof": "Positive squares: the upper Rothaus direction; Pass to signed inputs; Include zero values",
      "astis_dependencies": [],
      "mathlib_dependencies": [
        "Real.log_le_sub_one_of_pos",
        "Real.sqrt_sq_eq_abs"
      ]
    }
  ]
}
