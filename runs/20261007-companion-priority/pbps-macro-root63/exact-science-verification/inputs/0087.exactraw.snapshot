  "lean": {
    "statement": "{E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]\n    [CompleteSpace E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]\n    {L : ℝ≥0} {f : E → ℝ} (hf : LipschitzWith L f) (t : ℝ) :\n    (∫ x, Real.exp (t * (f x - ∫ z, f z ∂ProbabilityTheory.stdGaussian E))\n      ∂ProbabilityTheory.stdGaussian E) ≤ Real.exp ((L : ℝ)^2 * t^2 / 2)",
    "statement_sha256": "eca82156ec2499acafd23ec9f7d1b3db142b50bb01aa9f90a3c10613dddd287b",
    "compiled": true,
    "approved_definition_context": [
      "ProbabilityTheory.stdGaussian E is the actual canonical centered covariance-identity Gaussian probability measure on the finite-dimensional real Hilbert space E with its Borel measurable structure. Its covariance refers to the given inner product. Dimension zero is allowed.",
      "LipschitzWith L f is the actual global metric Lipschitz inequality for scalar f with nonnegative NNReal constant L, including zero. No differentiability or boundedness is required.",
      "The displayed integrals are actual real Bochner integrals under the same measure; the subtracted integral is f own mean. The real parameter t has both signs."
    ]
  },
