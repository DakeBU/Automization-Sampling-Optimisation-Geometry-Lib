        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.GaussianMarginalPoincare.actual_gaussian_marginal_centered_poincare",
        "AutoSamplingTheory.ExampleCases.ProximalBPS.CenteredDefectOperator.actual_centered_selfadjoint_defect",
        "AutoSamplingTheory.TechnicalLemmas.Measure.L2RealComplexOperator.exists_positive_complex_lift",
        "AutoSamplingTheory.TechnicalLemmas.Measure.L2RealSquareOrder.positive_square_order"
      ],
      "mathlib_dependencies": [
        "CFC.sqrt_le_sqrt",
        "CFC.sqrt_unique",
        "ContinuousLinearMap.isUnit_of_forall_le_norm_inner_map",
        "ContinuousLinearMap.opNorm_le_bound"
      ]
    },
    "binding": {
