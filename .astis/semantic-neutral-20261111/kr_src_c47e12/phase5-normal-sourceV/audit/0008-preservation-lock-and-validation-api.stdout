418: def check_advance(declarations: list[str], *, reviewed: bool) -> None:
419:     inputs.cache_clear()
420:     load.cache_clear()
421:     errors = roundtrip.validate_registry(roundtrip.load_registry())
422:     errors += validate(strict_names=set(declarations) if reviewed else None)
423:     known = {b['declaration'] for i in load() for b in i['bindings']}
424:     errors += [f'{n}: publication record missing' for n in declarations if n not in known]
425:     if errors:
426:         raise ValueError('Reader/round-trip publication gate:\n' + '\n'.join(errors))
