  "repaired_blocker": {
    "id": "MIRROR-COVARIANCE-NECESSITY",
    "status": "discharged",
    "accepted_sentence": "The actual source standard-Gaussian instance has identity covariance in the Hilbert metric; the sharp numerical coefficient requires a separate covariance-scale/concentration calibration and does not follow from product-rotation law invariance alone.",
    "reason": "This separates the actual source standard-Gaussian convention from Gaussian law invariance and numerical concentration calibration; it makes no false necessity claim. The original diag(1,1/2) counterexample remains valid and preserved as audit evidence."
  },
  "formula_check": {
    "status": "accepted",
    "formula": "S#nu=nu and R o Phi=Phi o S imply R#(Phi#nu)=Phi#nu",
    "types": "S:A->A, Phi:A->B, R:B->B, actual measurable maps between the corresponding measurable carriers. All instantiated maps are continuous on finite-dimensional Borel Hilbert products.",
    "derivation": "R#(Phi#nu)=(R o Phi)#nu=(Phi o S)#nu=Phi#(S#nu)=Phi#nu. This is a mathematical pushforward calculation, not a newly compiled transport theorem."
  },
  "source_checks": [
    {
      "source": "PBPS arXiv2609.06905v1 §2.2 (2.7)",
      "anchor": "S2.E7",
      "observed": "Independent X~mu and Z~N(0,I), Y=X+sqrt(eta)Z. Source ambient mu is its target Gibbs law and this section states 0<eta<=1/beta.",
      "verdict": "accepted for component correspondence",
      "boundary": "The existing ASTIS public reflection theorem explicitly generalizes the generative law to arbitrary probability mu and every positive eta; it does not identify its pushforward with density(2.6), certify the target assumptions, or transfer the paper algorithm cap."
    },
    {
      "source": "PBPS Proposition2.1(iii), (2.14)",
      "anchors": [
        "S2.I1.i3",
        "S2.E14"
      ],
      "observed": "U(x,y)=(x,2x-y) preserves pi_eta and is an involution. Printed proof says reflection follows directly from(2.6).",
      "verdict": "accepted",
      "boundary": "Noise-reflection intertwining is the existing ASTIS generative-law route using the printed(2.7)/(2.14) components; do not claim the author printed that exact proof topology."
    },
    {
      "source": "SPHMC arXiv2609.06906v1 §4.1 (4.3)",
      "anchor": "S4.E3",
      "observed": "E exp(inner(u,xi_eta(y;G)))<=exp(eta*norm(u)^2/2). Nearby proof invokes standard Gaussian concentration from sqrt(eta)-Lipschitz noise dependence.",
      "verdict": "accepted",
      "boundary": "Rotation, conditional Stein and Herbst are authored ASTIS background supplying this omitted concentration inequality; they are not printed SPHMC proof steps. Neighboring bias, W2/T2/LSI, algorithms and costs are not validated by this bridge."
    }
  ],
