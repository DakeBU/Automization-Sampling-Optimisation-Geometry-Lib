{
  "schema_version": 1,
  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.Probability.BalancedRademacherCLT.balanced_count_sum_tendsto_gaussian",
      "title": "Actual finite-count Rademacher sums converge weakly to the unit Gaussian",
      "sources": [
        {
          "url": "https://github.com/leanprover-community/mathlib4/blob/db584cd6d46c92f209a44c0f1c829460d327499d/Mathlib/Probability/CentralLimitTheorem.lean#L59",
          "label": "tendsto_charFun_inv_sqrt_mul_pow L59-L76; LevyConvergence L215; authored actual Bool-count specialization; SPHMC FIRST S4.E6 GaussianLSI omitted background",
          "scope": "Actual finite Bool count/card map for all N, signs true1 false-1, inverse sqrtN; N0 dirac0 and positive successor weak-law Gaussian0,1. No input law/moment/limit certificate. No Gaussian entropy/energy/LSI/T2/paper completion. Focused3160PASS: actual N1 mean0/secondmoment1 and actual N0secondmoment0, three standard3 prints. Independent wholeproof/blind/source/topology/commit admission and shared integration remain separate."
        },
        {
          "url": "https://arxiv.org/html/2609.06906v1#S4.E6",
          "label": "Actual SPHMC omitted GaussianLSI background consumer",
          "scope": "Not printedFIRST4.6 or GaussianLSI proof."
        }
      ],
      "tests": [
        "lake build Tests.BalancedRademacherCLT"
      ],
      "assumptions": [
        "Closed authored background specialization; no caller mathematical premises.",
        "Actual finite carrier and normalized count law, literal sign true1/false-1, totalized inverse square root and empty zero sum. All probability, measurability and finite moment domains are produced internally.",
        "ProbabilityMeasure Real has the canonical weak law topology. gaussianReal0,1 uses varianceNNReal1. No entropy, energy, W2, LSI, T2 or cost upgrade is implied."
      ],
      "statement": "There exists a family of real probability laws lambda_N, for every natural N, equal to the actual pushforward of normalized counting measure on all Fin N -> Bool configurations by the signed sum divided by sqrt(N). The true sign is +1 and the false sign is -1. Its zero law is dirac0, and the successor sequence lambda_(N+1) converges weakly to gaussianReal0,1 (mean0, variance1). No law, normalization, moment, independence or CLT certificate is supplied.",
      "formula": "\\mu_N=2^{-N}\\sum_{\\varepsilon\\in\\{0,1\\}^N}\\delta_\\varepsilon,\\quad S_N(\\varepsilon)=N^{-1/2}\\sum_{j=1}^N\\sigma(\\varepsilon_j),\\quad\\lambda_N=(S_N)_\\#\\mu_N,\\quad\\lambda_0=\\delta_0,\\quad\\lambda_{N+1}\\Rightarrow\\mathcal N(0,1).",
      "boundary": "Actual finite Bool count/card map for all N, signs true1 false-1, inverse sqrtN; N0 dirac0 and positive successor weak-law Gaussian0,1. No input law/moment/limit certificate. No Gaussian entropy/energy/LSI/T2/paper completion. Focused3160PASS: actual N1 mean0/secondmoment1 and actual N0secondmoment0, three standard3 prints. Independent wholeproof/blind/source/topology/commit admission and shared integration remain separate.",
      "steps": [
        {
          "title": "Build the actual laws, including zero",
          "text": "The finite carrier has positive cardinal2^N. Scaling counting measure by its reciprocal gives mass1. All finite functions are measurable and Bochner integrable; each normalized sum is pushed forward to a genuine probability law. AtN0 the empty sum is0, so its map law is the unit atom at0, without any fallback.",
          "formula": "\\mu_N(\\{0,1\\}^N)=2^{-N}2^N=1,\\qquad S_0=0,\\quad\\lambda_0=\\delta_0.",
          "lean": "private countLaw_probability; countLaw_integral; actualLaw; actualLaw_zero"
        },
        {
          "title": "Produce the single-coordinate moments",
          "text": "Use the actual balanced Bool count law and sigma(true)=1, sigma(false)=-1. The finite integral is the two-value average; hence the coordinate has mean0 and secondmoment1. These moments and measurable sign map are proof ingredients, never target premises.",
          "formula": "\\mathbb E\\sigma=\\tfrac12(1-1)=0,\\qquad\\mathbb E\\sigma^2=\\tfrac12(1+1)=1.",
          "lean": "private sign_mean; sign_second_moment; measurable_of_countable"
        },
        {
          "title": "Prove the finite characteristic-function product",
          "text": "For every configuration, exp(i t sum sigma_j) is the product of exp(i t sigma_j). Sum over all configurations using Fintype.sum_pow; multiplying by2^-N gives the Nth power of the actual single-coordinate characteristic function. This is an authored count-law adapter, not an assumed independence or copied infinite-iid construction.",
          "formula": "\\widehat\\lambda_N(t)=\\left[\\tfrac12\\sum_{b\\in\\{0,1\\}}\\exp(i t\\sigma(b)/\\sqrt N)\\right]^N.",
          "lean": "private coordinate_charFun; unscaled_charFun; normalized_charFun; Complex.exp_sum; Fintype.sum_pow"
        },
        {
          "title": "Apply the pinned scalar CLT to the derived moments",
          "text": "Mathlib characteristic-function CLT applies to this actual measurable balanced coordinate with its internally derived mean0 and secondmoment1. It yields convergence of the same Nth-power expression to exp(-t^2/2), the exact characteristic function of mean0 variance1 Gaussian.",
          "formula": "\\widehat\\lambda_N(t)\\longrightarrow\\exp(-t^2/2)=\\widehat{\\mathcal N(0,1)}(t).",
          "lean": "ProbabilityTheory.tendsto_charFun_inv_sqrt_mul_pow; ProbabilityTheory.charFun_gaussianReal"
        },
        {
          "title": "Return weak convergence and the actual successor family",
          "text": "Levy convergence upgrades the pointwise characteristic-function limit of genuine probability measures to weak convergence. Composition with the cofinal n->n+1 sequence gives the sealed positive-index limit. The same family supplies every literal map equality and its zero atom.",
          "formula": "\\lambda_N\\Rightarrow\\mathcal N(0,1)\\quad\\Longrightarrow\\quad\\lambda_{N+1}\\Rightarrow\\mathcal N(0,1).",
          "lean": "MeasureTheory.ProbabilityMeasure.tendsto_iff_tendsto_charFun; private actualLaw_tendsto; Filter.tendsto_add_atTop_nat"
        }
      ],
      "lean_statement": "There exists a family of real probability laws lambda_N, for every natural N, equal to the actual pushforward of normalized counting measure on all Fin N -> Bool configurations by the signed sum divided by sqrt(N). The true sign is +1 and the false sign is -1. Its zero law is dirac0, and the successor sequence lambda_(N+1) converges weakly to gaussianReal0,1 (mean0, variance1). No law, normalization, moment, independence or CLT certificate is supplied.",
      "lean_proof": "Build the actual laws, including zero; Produce the single-coordinate moments; Prove the finite characteristic-function product; Apply the pinned scalar CLT to the derived moments; Return weak convergence and the actual successor family",
      "astis_dependencies": [],
      "mathlib_dependencies": [
        "ProbabilityTheory.tendsto_charFun_inv_sqrt_mul_pow",
        "MeasureTheory.ProbabilityMeasure.tendsto_iff_tendsto_charFun",
        "MeasureTheory.charFun_map_mul_comp",
        "Fintype.sum_pow",
        "Complex.exp_sum",
        "MeasureTheory.integral_fintype"
      ]
    }
  ]
}
