          "end_line": 5,
          "literal_LF_sha256": "6f71701ef622be2c8f2027eb6d9ee7ec91850e8faf5c6e9d23601e9475b399b0",
          "literal": "<td class=\"ltx_eqn_cell ltx_align_center\"><math id=\"S4.E6.m1\" class=\"ltx_Math\" alttext=\"W_{2}(\\mathsf{r}_{y},\\mathsf{N}(0,I))\\leqslant\\sqrt{\\mathbb{E}_{\\mathsf{r}_{y}}[\\lVert\\nabla\\rho_{y}(U)\\rVert^{2}]}\\leqslant\\eta\\sqrt{\\mathbb{E}_{\\mathsf{r}_{y}}\\lVert U\\rVert^{2}}\\leqslant\\eta\\sqrt{d}\\,.\" display=\"block\" intent=\":literal\"><semantics><mrow><mrow><mrow><msub><mi>W</mi><mn>2</mn></msub><mo lspace=\"0em\" rspace=\"0em\">​</mo><mrow><mo stretchy=\"false\">(</mo><msub><mi>𝗋</mi><mi>y</mi></msub><mo>,</mo><mrow><mi>𝖭</mi><mo>⁡</mo><mrow><mo stretchy=\"false\">(</mo><mn>0</mn><mo>,</mo><mi>I</mi><mo stretchy=\"false\">)</mo></mrow></mrow><mo stretchy=\"false\">)</mo></mrow></mrow><mo>⩽</mo><msqrt><mrow><msub><mi>𝔼</mi><msub><mi>𝗋</mi><mi>y</mi></msub></msub><mo lspace=\"0em\" rspace=\"0em\">​</mo><mrow><mo stretchy=\"false\">[</mo><msup><mrow><mo fence=\"true\" lspace=\"0em\" rspace=\"0em\">∥</mo><mrow><mrow><mo rspace=\"0.167em\">∇</mo><msub><mi>ρ</mi><mi>y</mi></msub></mrow><mo lspace=\"0em\" rspace=\"0em\">​</mo><mrow><mo stretchy=\"false\">(</mo><mi>U</mi><mo stretchy=\"false\">)</mo></mrow></mrow><mo fence=\"true\" lspace=\"0em\" rspace=\"0em\">∥</mo></mrow><mn>2</mn></msup><mo stretchy=\"false\">]</mo></mrow></mrow></msqrt><mo>⩽</mo><mrow><mi>η</mi><mo lspace=\"0em\" rspace=\"0em\">​</mo><msqrt><mrow><msub><mi>𝔼</mi><msub><mi>𝗋</mi><mi>y</mi></msub></msub><mo lspace=\"0em\" rspace=\"0em\">​</mo><msup><mrow><mo fence=\"true\" rspace=\"0em\">∥</mo><mi>U</mi><mo fence=\"true\" lspace=\"0em\">∥</mo></mrow><mn>2</mn></msup></mrow></msqrt></mrow><mo>⩽</mo><mrow><mi>η</mi><mo lspace=\"0em\" rspace=\"0em\">​</mo><msqrt><mi>d</mi></msqrt></mrow></mrow><mo lspace=\"0.170em\">.</mo></mrow><annotation encoding=\"application/x-tex\">W_{2}(\\mathsf{r}_{y},\\mathsf{N}(0,I))\\leqslant\\sqrt{\\mathbb{E}_{\\mathsf{r}_{y}}[\\lVert\\nabla\\rho_{y}(U)\\rVert^{2}]}\\leqslant\\eta\\sqrt{\\mathbb{E}_{\\mathsf{r}_{y}}\\lVert U\\rVert^{2}}\\leqslant\\eta\\sqrt{d}\\,.</annotation></semantics></math></td>\n"
        }
      ],
      "mixed_scope": "Same physical line also contains2nd/last inequalities, excluded from this bounded delta."
