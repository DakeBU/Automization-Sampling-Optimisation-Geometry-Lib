      "type": "V:E->R; alpha,beta:NNReal; eta:R"
    },
    {
      "definition": "c(y,xRef)=y-eta*grad V(xRef)",
      "name": "c",
      "type": "E->E->E"
    },
    {
      "definition": "Phi(y,xRef,t,(q,p))=(c+cos(t)*(q-c)+(sqrt(eta)*sin(t))*p,(-sin(t)/sqrt(eta))*(q-c)+cos(t)*p), with c=c(y,xRef)",
      "name": "Phi",
      "type": "E->E->R->(E x E)->(E x E)"
