  "families": [
    {
      "id": "family:proxy-warm-composition",
      "label": "Transport control → proxy warmness → high accuracy",
      "plain_language": "A nearby Renyi-warm witness is enough for accuracy under the same implemented probability kernel; expected cost requires a different, actual-input bound.",
      "domains": [
        "concept:transport",
        "concept:sampling",
        "concept:mcmc"
      ],
      "functor_edges": [
        "transport:proxy-warm-handoff"
      ],
      "formal_search_nodes": [
        "AutoSamplingTheory.TechnicalLemmas.InformationTheory.Renyi",
        "AutoSamplingTheory.TechnicalLemmas.Probability.ConditionalKernel"
      ],
      "compiled_substrate_bindings": [],
      "reading_order": [
        "SPHMC Theorem 1.2",
        "proxy law and TV witness",
        "PBPS Corollary 4.4",
        "SPHMC Section 7.2",
        "actual-input cost audit"
      ],
      "do_not_conflate": "W2 proximity is not Renyi warmness; the actual law is not its proxy; TV closeness alone does not transfer unbounded costs.",
      "review": {
        "status": "candidate",
        "proposed_by": "ASTIS companion source audit",
        "independent_reviewer": null
      }
    },
    {
      "id": "family:discrete-hypocoercivity",
      "label": "Reflection coupling and discrete modified-L2 decay",
      "plain_language": "Use a conditional-expectation projection to separate macro and micro modes. An involution couples them; a half-turn estimate and corrected energy propagate microscopic damping to macroscopic control.",
      "domains": [
        "concept:mcmc",
        "concept:sampling"
      ],
      "functor_edges": [
        "transport:proximal-half-turn"
      ],
      "formal_search_nodes": [
        "AutoSamplingTheory.TechnicalLemmas.Probability.ConditionalKernel",
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.SemigroupDecay"
      ],
      "compiled_substrate_bindings": [],
      "reading_order": [
        "DMS modified-L2 ancestry",
        "Fan–Li–Lu gap-shifted refinement",
        "PBPS Lemma B.1",
        "PBPS Proposition B.2",
        "PBPS Appendix B.3 discrete corrector"
      ],
      "do_not_conflate": "The conditional PDMP, discrete augmented chain, and continuous-time Langevin theorem have different operators and domains. Reuse requires adapters, not renaming a generator.",
      "review": {
        "status": "candidate",
        "proposed_by": "ASTIS companion source audit",
        "independent_reviewer": null
      }
    },
    {
      "id": "family:metric-gradient-flow",
      "label": "Metric gradient flow → dissipation → exponential decay",
      "plain_language": "The state space changes, but the same proof skeleton can survive: choose an energy and a metric, identify its metric gradient, write energy dissipation, then use a PL-shaped inequality to turn dissipation into exponential convergence.",
      "domains": [
        "concept:optimization",
        "concept:riemannian",
        "concept:transport",
        "concept:sampling",
        "concept:discrete-sampling"
      ],
      "functor_edges": [
        "transport:metric-lift",
        "transport:wasserstein-flow",
        "transport:metric-pl",
        "transport:discrete-transport"
      ],
      "formal_search_nodes": [
        "AutoSamplingTheory.TechnicalLemmas.Geometry.GeodesicConvexity",
        "AutoSamplingTheory.TechnicalLemmas.InformationTheory.FisherTransport",
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.SemigroupDecay"
      ],
      "compiled_substrate_bindings": [],
      "reading_order": [
        "metric chooses the gradient",
        "gradient flow gives an energy-dissipation identity",
        "metric PL closes the scalar differential inequality",
        "only then specialize to Euclidean, Riemannian, or Wasserstein geometry"
      ],
      "do_not_conflate": "Wasserstein/Otto calculus needs rigorous first-variation and flow hypotheses; W2 is not globally a classical smooth finite-dimensional Riemannian manifold."
    },
    {
      "id": "family:curvature-growth",
      "label": "Second-order curvature → first-order/growth controls",
      "plain_language": "Strong convexity is not merely a faster convergence assumption. It is a lower-curvature statement that produces a quadratic lower model and, after the right geometry is chosen, often yields growth or PL-like coercivity.",
      "domains": [
        "concept:optimization",
        "concept:riemannian",
        "concept:transport",
        "concept:sampling"
      ],
      "functor_edges": [
        "transport:metric-lift",
        "transport:curvature-growth",
        "transport:pl-lsi"
      ],
      "formal_search_nodes": [
        "AutoSamplingTheory.TechnicalLemmas.Geometry.StrongConvexity",
        "AutoSamplingTheory.TechnicalLemmas.Geometry.GeodesicConvexity",
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.LogSobolev"
      ],
      "compiled_substrate_bindings": [
        {
          "node": "AutoSamplingTheory.TechnicalLemmas.Analysis.StrongConvexFirstOrder",
          "edges": [
            "transport:curvature-growth"
          ],
          "role": "Compiled Euclidean first-order quadratic lower model produced by strong convexity.",
          "truth_boundary": "This module is a substrate for the Euclidean curvature-to-growth pattern only. It does not certify Riemannian, Wasserstein, Bakry-Emery, PL, Poincare, or LSI arrows."
        }
      ],
      "reading_order": [
        "Euclidean strong-convex quadratic model",
        "geodesic/Riemannian curvature adapter",
        "Wasserstein geodesic convexity or Bakry-Emery curvature in their own settings",
        "derive only the coercivity statement justified by that setting"
      ],
      "do_not_conflate": "Euclidean Hessian bounds, geodesic convexity, displacement convexity, and Bakry-Emery curvature are related patterns but not interchangeable hypotheses."
    },
    {
      "id": "family:gap-gradient",
      "label": "PL / LSI mirror: objective gap versus gradient dissipation",
      "plain_language": "Optimization PL bounds the objective gap by a squared gradient. For Langevin, LSI bounds KL by relative Fisher information, which is the squared Wasserstein gradient norm of KL in the smooth formal picture. Both turn the same dissipation identity into exponential gap decay.",
      "domains": [
        "concept:optimization",
        "concept:transport",
        "concept:sampling",
        "concept:discrete-sampling"
      ],
      "functor_edges": [
        "transport:metric-pl",
        "transport:pl-lsi",
        "transport:entropy-sandwich",
        "transport:discrete-mlsi"
      ],
      "formal_search_nodes": [
        "AutoSamplingTheory.TechnicalLemmas.InformationTheory.RelativeFisher",
        "AutoSamplingTheory.TechnicalLemmas.InformationTheory.FisherTransport",
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.LogSobolev"
      ],
      "compiled_substrate_bindings": [],
      "reading_order": [
        "identify the gap functional",
        "identify its exact dissipation / metric-gradient norm",
        "state the PL-shaped coercivity with source normalization",
        "apply Gronwall"
      ],
      "do_not_conflate": "LSI is a functional inequality for measures/densities, not literally the Euclidean PL theorem; constants and factors of two depend on normalization."
    },
    {
      "id": "family:l2-coercivity",
      "label": "Poincare / chi-square mirror: quadratic gap versus Dirichlet dissipation",
      "plain_language": "For density ratio rho, chi-square is the squared L2 distance of rho from 1. Poincare controls this quadratic gap by Dirichlet energy, and reversible semigroup dissipation then gives exponential chi-square decay.",
      "domains": [
        "concept:optimization",
        "concept:sampling",
        "concept:discrete-sampling"
      ],
      "functor_edges": [
        "transport:pi-chi2",
        "transport:metric-pl",
        "transport:discrete-pi"
      ],
      "formal_search_nodes": [
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.Poincare",
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.Generator",
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.SemigroupDecay"
      ],
      "compiled_substrate_bindings": [],
      "reading_order": [
        "chi-square as an L2 density gap",
        "Poincare as coercivity of the Dirichlet form",
        "semigroup dissipation",
        "exponential chi-square decay"
      ],
      "do_not_conflate": "Poincare/chi-square and LSI/KL are parallel dissipation templates but different inequalities and generally different strengths."
    },
    {
      "id": "family:proximal-energy",
      "label": "Quadratic regularization: proximal minimizer or Gibbs draw",
      "plain_language": "Optimization and sampling can consume the same regularized energy differently: one chooses its minimizer, the other samples from its normalized exponential.",
      "domains": [
        "concept:optimization",
        "concept:sampling",
        "concept:mcmc",
        "concept:discrete-sampling"
      ],
      "functor_edges": [
        "transport:gibbs-prox",
