        "fragment_matches_full_canonical_element": false,
        "raw_start_char": 1359227,
        "raw_end_char": 1362999,
        "primary_text": "Lemma D.3 (Two-sided covariance bound) . Let \\nu(\\mathrm{d}z)\\propto e^{-W(z)}\\,\\mathrm{d}z with mI\\preceq\\nabla^{2}W(z)\\preceq LI\\,. (D.8) Then L^{-1}I\\preceq\\mathrm{Cov}_{\\nu}(Z)\\preceq m^{-1}I\\,. (D.9)"
