from pathlib import Path
import json,hashlib,sys
sys.stdout.reconfigure(encoding='utf-8')
ROOT=Path('E:/Samplinglib');O=Path(__file__).parent;R=ROOT/'runs/20261007-companion-priority/pbps-marginal-poincare-preproof57';P=ROOT/'runs/20261007-companion-priority/phase-pbps-gamma-preread57'
def canon(v):return json.dumps(v,ensure_ascii=False,sort_keys=True,separators=(',',':')).encode()
def sha(b):return hashlib.sha256(b).hexdigest()
def pin(p):
 b=p.read_bytes();return {'path':p.relative_to(ROOT).as_posix(),'bytes':len(b),'raw_sha256':sha(b),'lf_sha256':sha(b.replace(b'\r\n',b'\n'))}
def put(name,v):
 v['content_self_sha256']=sha(canon(v));p=O/name;p.write_bytes((json.dumps(v,ensure_ascii=False,indent=2)+'\n').encode());assert json.loads(p.read_bytes())==v;return pin(p)
proposal=json.loads((R/'root.statement-proposal.json').read_bytes());signature=(R/'prospective-statement.txt').read_bytes();lf=signature.replace(b'\r\n',b'\n');assert len(lf)==1244 and sha(lf)==proposal['signature_lf_sha256']=='e706b4e6c3c07f58a090ee86cb51dd91be2f11afe707db653737e4983c7181e9'
