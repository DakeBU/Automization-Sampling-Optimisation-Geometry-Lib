335: def _recover_unlocked(path: Path) -> list[dict[str, Any]]:
336:     records, _ = durable._recover_jsonl_unlocked(path)  # reuse the legacy durable primitive
337:     return records
338: 
339: 
340: def _append_unlocked(path: Path, record: dict[str, Any]) -> None:
341:     durable._append_jsonl_unlocked(path, record)
342: 
343: 
344: def _replay_advances(records: Iterable[dict[str, Any]]) -> dict[str, dict[str, Any]]:
345:     state: dict[str, dict[str, Any]] = {}
346:     for record in records:
347:         event = record.get("event")
348:         advance_id = record.get("advance_id")
349:         if not isinstance(advance_id, str) or not advance_id:
350:             continue
351:         if event == "proposal":
352:             item = dict(record)
353:             item.setdefault("frontier_cell", "global")
354:             item.setdefault("target_declarations", [])
355:             item.setdefault("checkpoint_count", 0)
356:             item.setdefault("no_progress_streak", 0)
357:             item.setdefault("needs_diagnosis", False)
358:             state[advance_id] = item
359:             continue
360:         if advance_id not in state:
361:             continue
362:         current = state[advance_id]
363:         if event == "transition":
364:             to_state = record.get("to_state", current.get("state"))
365:             current["state"] = to_state
366:             current["last_actor"] = record.get("worker_id", current.get("last_actor", ""))
367:             if to_state == "CLAIMED":
368:                 current["owner_id"] = record.get("worker_id", "")
369:                 current["no_progress_streak"] = 0
370:                 current["needs_diagnosis"] = False
371:             current["modes"] = list(record.get("modes") or current.get("modes") or [])
372:             if record.get("evidence"):
373:                 current["latest_evidence"] = record["evidence"]
374:                 if to_state == 'PROVED_LOCAL' and record['evidence'].get('publication_declarations'):
375:                     current['publication_declarations'] = record['evidence']['publication_declarations']
376:             current["updated_at"] = record.get("created_at", current.get("updated_at"))
377:         elif event == "checkpoint":
378:             previous = current.get("latest_checkpoint") or {}
379:             same_signature = (
380:                 previous.get("route_fingerprint") == record.get("route_fingerprint")
381:                 and previous.get("progress_signature") == record.get("progress_signature")
382:             )
383:             streak = int(current.get("no_progress_streak", 0)) + 1 if same_signature else 1
384:             current["checkpoint_count"] = int(current.get("checkpoint_count", 0)) + 1
385:             current["no_progress_streak"] = streak
386:             current["needs_diagnosis"] = streak >= NO_PROGRESS_FREEZE_AT
387:             current["latest_checkpoint"] = dict(record)
388:             current["updated_at"] = record.get("created_at", current.get("updated_at"))
389:     return state
390: 
391: 
392: def current_advances(path: Path = DEFAULT_ADVANCE_LEDGER) -> dict[str, dict[str, Any]]:
393:     """Recover an interrupted tail and replay current substantive-advance state."""
394: 
395:     return _replay_advances(durable.load_jsonl(path))
396: 
397: 
