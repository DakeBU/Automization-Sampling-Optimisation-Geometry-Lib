  "anchors": [
    {
      "id": "A2.E1",
      "primary_start_utf8_byte": 717553,
      "primary_end_utf8_byte_exclusive": 719703,
      "slice_bytes": 2150,
      "slice_raw_sha256": "1f2c060d3d5cadb913d3707396a03d12fcbee241933e4bdc134beac774b8f18f",
      "math_alttext_text": "(\\mathsf{P}f)(x,y)\\coloneqq\\int f(x^{\\prime},y)\\,\\pi_{\\eta}^{X\\mid Y=y}(\\mathrm{d}x^{\\prime})=\\mathbb{E}[f(X,Y)\\mid Y=y]\\,. (B.1)",
      "balanced": true
    },
    {
      "id": "A2.E2",
      "primary_start_utf8_byte": 720477,
      "primary_end_utf8_byte_exclusive": 724025,
      "slice_bytes": 3548,
      "slice_raw_sha256": "2a3ed85e38715b4d6c91c8dbfb4a485c159c4511ad42beaded2a796d4bcdf30b",
      "math_alttext_text": "\\begin{split}\\mathfrak{H}_{\\mathsf{P}}&\\coloneqq\\operatorname{ran}(\\mathsf{P})=\\{f\\in\\mathfrak{H}:f(x,y)=g(y)\\text{ for some }g\\in L^{2}(\\pi_{\\eta}^{Y})\\}\\,,\\\\ \\mathfrak{H}_{\\perp}&\\coloneqq\\ker(\\mathsf{P})=\\operatorname{ran}(\\mathsf{P}^{\\perp})=\\{f\\in\\mathfrak{H}:\\mathbb{E}[f(X,Y)\\mid Y]=0\\}\\,.\\end{split} (B.2)",
      "balanced": true
    },
    {
      "id": "A2.E3",
      "primary_start_utf8_byte": 728702,
      "primary_end_utf8_byte_exclusive": 732443,
      "slice_bytes": 3741,
      "slice_raw_sha256": "7cb41b24f384991a849eef67e263bfcf9b3b2903b8a6c8dbef78020da9beb8b2",
      "math_alttext_text": "\\mathsf{T}=\\begin{pmatrix}\\mathsf{T}_{\\mathsf{P}\\mathsf{P}}&\\mathsf{T}_{\\mathsf{P}\\perp}\\\\ \\mathsf{T}_{\\perp\\mathsf{P}}&\\mathsf{T}_{\\perp\\perp}\\end{pmatrix}\\,,\\hskip 20.00003pt\\begin{aligned} \\mathsf{T}_{\\mathsf{P}\\mathsf{P}}&\\coloneqq\\mathsf{P}\\mathsf{T}\\mathsf{P}\\,,&\\mathsf{T}_{\\mathsf{P}\\perp}&\\coloneqq\\mathsf{P}\\mathsf{T}\\mathsf{P}^{\\perp}\\,,\\\\ \\mathsf{T}_{\\perp\\mathsf{P}}&\\coloneqq\\mathsf{P}^{\\perp}\\mathsf{T}\\mathsf{P}\\,,&\\mathsf{T}_{\\perp\\perp}&\\coloneqq\\mathsf{P}^{\\perp}\\mathsf{T}\\mathsf{P}^{\\perp}\\,.\\end{aligned} (B.3)",
      "balanced": true
    },
    {
      "id": "A2.E4",
      "primary_start_utf8_byte": 734351,
      "primary_end_utf8_byte_exclusive": 735917,
      "slice_bytes": 1566,
      "slice_raw_sha256": "bd93f2e460e4f59aa562b2ba13e36ad16cd810424677c8b114e6a93474fc65b8",
      "math_alttext_text": "(\\mathsf{U}f)(x,y)\\coloneqq f(\\mathsf{U}(x,y))=f(x,2x-y)\\,. (B.4)",
      "balanced": true
    },
    {
      "id": "A2.E5",
      "primary_start_utf8_byte": 740263,
      "primary_end_utf8_byte_exclusive": 742291,
      "slice_bytes": 2028,
      "slice_raw_sha256": "fe258f4f7d272a57a2fa1293a3b4663924b5a3e556f87f1ce03cd28a3837f959",
      "math_alttext_text": "\\mathsf{U}_{\\perp\\mathsf{P}}^{*}\\mathsf{U}_{\\perp\\mathsf{P}}=I-\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}^{2}\\,,\\hskip 20.00003pt\\mathsf{U}_{\\perp\\mathsf{P}}^{*}\\mathsf{U}_{\\perp\\perp}=-\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}\\mathsf{U}_{\\perp\\mathsf{P}}^{*}\\,. (B.5)",
      "balanced": true
    },
    {
      "id": "A2.E10",
      "primary_start_utf8_byte": 768975,
      "primary_end_utf8_byte_exclusive": 770419,
      "slice_bytes": 1444,
      "slice_raw_sha256": "7b09ee8258f3e6c4ecc506e9513ec8256e0d1f4083f38b545d6c1dd03486c0fb",
      "math_alttext_text": "\\mathsf{\\Gamma}_{\\mathsf{P}}\\coloneqq(I-\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}^{2})^{1/2}\\hskip 10.00002pt\\text{on }\\mathfrak{H}_{\\mathsf{P}}\\,. (B.10)",
      "balanced": true
    },
    {
      "id": "A2.E11",
      "primary_start_utf8_byte": 771531,
      "primary_end_utf8_byte_exclusive": 773654,
      "slice_bytes": 2123,
      "slice_raw_sha256": "6d19997456600e603e6f081f055bf929069a5e636c8c8fa7d2cb37a8615428f7",
      "math_alttext_text": "\\mathsf{U}_{\\perp\\mathsf{P}}^{*}\\mathsf{U}_{\\perp\\mathsf{P}}=\\mathsf{\\Gamma}_{\\mathsf{P}}^{2}\\,,\\hskip 20.00003pt\\|\\mathsf{U}_{\\perp\\mathsf{P}}f\\|=\\|\\mathsf{\\Gamma}_{\\mathsf{P}}f\\|\\,,\\hskip 10.00002ptf\\in\\mathfrak{H}_{\\mathsf{P}}\\,. (B.11)",
      "balanced": true
    },
    {
      "id": "A2.E15",
      "primary_start_utf8_byte": 783959,
      "primary_end_utf8_byte_exclusive": 785610,
      "slice_bytes": 1651,
      "slice_raw_sha256": "0a85d657415c5c8dbb19e6014e528156f3ce5badc750e5849423f1f042da3ebf",
      "math_alttext_text": "\\mathsf{\\Gamma}_{\\mathsf{P}}=(I-\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}^{2})^{1/2}\\succeq\\gamma_{\\rm gap}I\\hskip 20.00003pt\\text{on }\\mathfrak{H}_{\\mathsf{P},0}\\,. (B.15)",
      "balanced": true
    },
    {
      "id": "A2.E16",
      "primary_start_utf8_byte": 790549,
      "primary_end_utf8_byte_exclusive": 793315,
      "slice_bytes": 2766,
      "slice_raw_sha256": "a6725987d1979361ae4770ec893b554213101161e297c456081d28b8ef5b9042",
      "math_alttext_text": "\\mathsf{U}_{\\perp\\mathsf{P}}=\\mathsf{V}_{\\perp\\mathsf{P}}\\mathsf{\\Gamma}_{\\mathsf{P}}\\,,\\hskip 20.00003pt\\mathsf{V}_{\\perp\\mathsf{P}}\\coloneqq\\mathsf{U}_{\\perp\\mathsf{P}}\\mathsf{\\Gamma}_{\\mathsf{P}}^{-1}\\,:\\mathfrak{H}_{\\mathsf{P},0}\\longrightarrow\\mathfrak{H}_{\\perp}\\,,\\hskip 20.00003pt\\mathsf{V}_{\\perp\\mathsf{P}}^{*}\\mathsf{V}_{\\perp\\mathsf{P}}=I_{\\mathfrak{H}_{\\mathsf{P},0}}\\,. (B.16)",
      "balanced": true
    },
    {
      "id": "A4.SS1",
      "primary_start_utf8_byte": 1348892,
      "primary_end_utf8_byte_exclusive": 1372363,
      "slice_bytes": 23471,
      "slice_raw_sha256": "22b19e2441e95e4cb6dc49530c7364dc2ff10d0d0b9d8dcfd1347206c98dc8c0",
      "math_alttext_text": "D.1 Hilbert space and Markov operator conventions Definition D.1 (Hilbert space notation) . Let \\zeta be a probability measure. The real Hilbert space L^{2}(\\zeta) consists of equivalence classes of measurable functions f such that \\int f^{2}\\,\\mathrm{d}\\zeta<\\infty . Its inner product and norm are \\langle f,g\\rangle_{L^{2}(\\zeta)}\\coloneqq\\int fg\\,\\mathrm{d}\\zeta\\,,\\hskip 20.00003pt\\|f\\|_{L^{2}(\\zeta)}\\coloneqq\\langle f,f\\rangle_{L^{2}(\\zeta)}^{1/2}\\,. (D.1) We write L_{0}^{2}(\\zeta)\\coloneqq\\Bigl\\{f\\in L^{2}(\\zeta):\\int f\\,\\mathrm{d}\\zeta=0\\Bigr\\}\\,. (D.2) When \\zeta=\\pi_{\\eta} , we abbreviate the inner product and norm by \\langle f,g\\rangle and \\|f\\| . Two functions equal \\zeta -almost everywhere represent the same vector. A closed linear subspace \\mathcal{M}\\subseteq L^{2}(\\zeta) has orthogonal complement \\mathcal{M}^{\\perp}\\coloneqq\\{g:\\langle f,g\\rangle=0\\text{ for all }f\\in\\mathcal{M}\\} . Its orthogonal projection is the unique bounded operator \\mathsf{P}_{\\mathcal{M}} for which \\mathsf{P}_{\\mathcal{M}}f\\in\\mathcal{M} and f-\\mathsf{P}_{\\mathcal{M}}f\\in\\mathcal{M}^{\\perp} . All operators in the convergence analysis are bounded linear operators on the indicated Hilbert spaces unless explicitly stated otherwise. The adjoint \\mathsf{L}^{*} is characterized by \\langle\\mathsf{L}f,g\\rangle=\\langle f,\\mathsf{L}^{*}g\\rangle . An operator is self-adjoint if \\mathsf{L}=\\mathsf{L}^{*} , a contraction if \\|\\mathsf{L}f\\|\\leq\\|f\\| , and unitary if it is onto and preserves norms. A self-adjoint involution, meaning \\mathsf{L}^{2}=I , is unitary. For self-adjoint operators \\mathsf{L}_{1},\\mathsf{L}_{2} , \\mathsf{L}_{1}\\preceq\\mathsf{L}_{2}\\hskip 10.00002pt\\Longleftrightarrow\\hskip 10.00002pt\\langle f,(\\mathsf{L}_{2}-\\mathsf{L}_{1})f\\rangle\\geq 0\\hskip 10.00002pt\\text{for every }f (D.3) is the Loewner order. If \\mathsf{L} is self-adjoint, the spectral theorem defines \\psi(\\mathsf{L}) for bounded Borel functions \\psi ; in particular \\mathbf{1}_{E}(\\mathsf{L}) is the orthogonal projection onto the spectral set E , and a non-negative operator has a unique non-negative square root. Definition D.2 (Markov operators and density evolution) . Let \\mathcal{K}(z,\\mathrm{d}z^{\\prime}) be a Markov kernel preserving \\zeta . Its Markov operator on observables is (\\mathsf{K}f)(z)\\coloneqq\\int f(z^{\\prime})\\,\\mathcal{K}(z,\\mathrm{d}z^{\\prime})\\,. (D.4) It is a contraction on L^{2}(\\zeta) . Its adjoint \\mathsf{K}^{*} governs density evolution: if a law has density h with respect to \\zeta , then its density after one step is \\mathsf{K}^{*}h . Constants are fixed by both operators. If P\\ll\\zeta has density h , then \\chi^{2}(P\\|\\zeta)=\\|h-1\\|_{\\zeta}^{2}\\,. (D.5) Consequently, an operator norm bound for \\mathsf{K} on L_{0}^{2}(\\zeta) gives the same bound for its adjoint \\mathsf{K}^{*} , and hence gives \\chi^{2} contraction.",
      "balanced": true
    },
    {
      "id": "A3.E3",
      "primary_start_utf8_byte": 1027228,
      "primary_end_utf8_byte_exclusive": 1029036,
      "slice_bytes": 1808,
      "slice_raw_sha256": "d3751b92957e3cd1d4b24d08a74d8631a7574cc23a58587aaaf2c9b176c1344b",
      "math_alttext_text": "\\|\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}f\\|^{2}=\\Var_{\\pi_{\\eta}^{Y}}(\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}f)\\leq\\Bigl(\\frac{1}{\\alpha}+\\eta\\Bigr)\\,\\|\\nabla\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}f\\|^{2}\\,. (C.3)",
      "balanced": true
    },
    {
      "id": "A3.E4",
      "primary_start_utf8_byte": 1029755,
      "primary_end_utf8_byte_exclusive": 1031371,
      "slice_bytes": 1616,
      "slice_raw_sha256": "832e5eba8dbe8fd2b0361f4514814d7e6462b20418b04693badb9aa6122ce341",
      "math_alttext_text": "\\|\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}f\\|\\leq\\frac{1-\\alpha\\eta}{1+\\alpha\\eta}\\,\\|f\\|=\\rho_{\\rm mac}\\,\\|f\\|\\,. (C.4)",
      "balanced": true
    },
    {
      "id": "A3.E5",
      "primary_start_utf8_byte": 1034261,
      "primary_end_utf8_byte_exclusive": 1037751,
      "slice_bytes": 3490,
      "slice_raw_sha256": "68a2e058083bcbec3135e78bc0583198ab5e85b33d32c280bd447ba48238b030",
      "math_alttext_text": "\\displaystyle\\bigl\\langle g,(I-\\mathsf{U}_{\\mathsf{P}\\mathsf{P}})g\\bigr\\rangle \\displaystyle=\\frac{1}{2}\\,\\mathbb{E}\\bigl[\\bigl(g(Y_{+})-g(Y_{-})\\bigr)^{2}\\bigr]=\\frac{1}{2}\\,\\mathbb{E}_{X}\\mathbb{E}_{Z}\\bigl[\\bigl(g(X+\\sqrt{\\eta}Z)-g(X-\\sqrt{\\eta}Z)\\bigr)^{2}\\bigr]\\,. (C.5)",
      "balanced": true
    },
    {
      "id": "A3.E6",
      "primary_start_utf8_byte": 1041792,
      "primary_end_utf8_byte_exclusive": 1043304,
      "slice_bytes": 1512,
      "slice_raw_sha256": "6c96bcd0743dff97b53b652fb11a261cdebb3b36127a6699374150ab31b21e3d",
      "math_alttext_text": "\\bigl\\langle g,(I-\\mathsf{U}_{\\mathsf{P}\\mathsf{P}})g\\bigr\\rangle\\leq 2\\eta\\,\\|\\nabla g\\|^{2}\\,. (C.6)",
      "balanced": true
    },
    {
      "id": "A3.E7",
      "primary_start_utf8_byte": 1048644,
      "primary_end_utf8_byte_exclusive": 1049943,
      "slice_bytes": 1299,
      "slice_raw_sha256": "8cbc609e2f04c60179a9e747cb2c907588f754fa2d7b39c5efb6b0c27655262b",
      "math_alttext_text": "(I-\\mathsf{U}_{\\mathsf{P}\\mathsf{P}})^{2}(I+2\\mathsf{U}_{\\mathsf{P}\\mathsf{P}})\\succeq 0\\,. (C.7)",
      "balanced": true
    },
