def Set.indicator.{u_1, u_3} : {α : Type u_1} → {M : Type u_3} → [Zero M] → Set α → (α → M) → α → M :=
fun {α} {M} [Zero M] s f x => if x ∈ s then f x else 0
def Set.piecewise.{u, v} : {α : Type u} →
  {β : α → Sort v} → (s : Set α) → ((i : α) → β i) → ((i : α) → β i) → [(j : α) → Decidable (j ∈ s)] → (i : α) → β i :=
fun {α} {β} s f g [(j : α) → Decidable (j ∈ s)] i => if i ∈ s then f i else g i
def Set.Ioi.{u_1} : {α : Type u_1} → [Preorder α] → α → Set α :=
fun {α} [Preorder α] b => {x | b < x}
def MeasureTheory.IntegrableOn.{u_1, u_3} : {α : Type u_1} →
  {ε : Type u_3} →
    {mα : MeasurableSpace α} →
      [inst : TopologicalSpace ε] →
        [ContinuousENorm ε] →
          (α → ε) → Set α → autoParam (MeasureTheory.Measure α) MeasureTheory.IntegrableOn._auto_1 → Prop :=
fun {α} {ε} {mα} [TopologicalSpace ε] [ContinuousENorm ε] f s μ => MeasureTheory.Integrable f (μ.restrict s)
def MeasureTheory.Measure.restrict.{u_2} : {α : Type u_2} →
  {_m0 : MeasurableSpace α} → MeasureTheory.Measure α → Set α → MeasureTheory.Measure α :=
fun {α} {_m0} μ s => (MeasureTheory.Measure.restrictₗ s) μ
protected def ENNReal.toReal : ENNReal → ℝ :=
fun a => ↑a.toNNReal
protected def ENNReal.toNNReal : ENNReal → NNReal :=
WithTop.untopD 0
def Real.log : ℝ → ℝ :=
fun x => if hx : x = 0 then 0 else Real.expOrderIso.symm ⟨|x|, ⋯⟩
