<p id="A3.Thmtheorem1.p1.1" class="ltx_p"><span id="A3.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">For every <math id="A3.Thmtheorem1.p1.m1" class="ltx_Math" alttext="f\in H^{1}(\pi_{\eta}^{Y})" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>π</mi><mi>η</mi><mi>Y</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f\in H^{1}(\pi_{\eta}^{Y})</annotation></semantics></math> and <math id="A3.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\pi_{\eta}^{Y}" display="inline" intent=":literal"><semantics><msubsup><mi>π</mi><mi>η</mi><mi>Y</mi></msubsup><annotation encoding="application/x-tex">\pi_{\eta}^{Y}</annotation></semantics></math>-almost every <math id="A3.Thmtheorem1.p1.m3" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>,</span></p>