  "standing": {
    "space": "R^d, Euclidean W2 on P2; pi proportional exp(-V)",
    "hypotheses": "V C2; 0<alpha<=beta, alpha I<=Hessian V<=beta I; kappa=beta/alpha; no third/higher derivative bound",
