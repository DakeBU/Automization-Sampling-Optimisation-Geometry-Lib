        "lf_sha256": "7b09ee8258f3e6c4ecc506e9513ec8256e0d1f4083f38b545d6c1dd03486c0fb"
      },
      "byte_range": [
        768975,
        770419
      ],
      "literal_source_text": "\\mathsf{\\Gamma}_{\\mathsf{P}}\\coloneqq(I-\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}^{2})^{1/2}\\hskip 10.00002pt\\text{on }\\mathfrak{H}_{\\mathsf{P}}\\,. (B.10)"
    },
    {
      "id": "A2.E11",
      "coverage": "EXCLUDED",
      "reason": "Printed microscopic norm/typed Gram relation; no ontoM/B*B transport62.",
