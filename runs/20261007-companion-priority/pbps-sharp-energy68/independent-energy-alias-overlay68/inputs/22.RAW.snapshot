            "exact_code_raw_sha256": "49b2427ff3ad0df9fbc373dabc9a557064dd2419cfcd84494111e45ea0d36c33"
          }
        },
        {
          "title": "Cancel the two block cross terms",
          "text": "Use the sum of the two squared component norms. Symmetry cancels the mixed terms; this is the Hilbert sum energy, without a product max-norm assertion.",
          "formula": "\\|u-Kv\\|^2+\\|Ku+v\\|^2=\\|Du\\|^2+\\|Dv\\|^2,\\quad E=\\langle u-Kv,u\\rangle-\\langle Ku+v,v\\rangle.",
          "lean": "  have hSym : inner ℝ u (K v)=inner ℝ (K u) v :=\n    (hK.isSymmetric u v).symm\n  have hBlock : ‖u-K v‖^2+‖K u+v‖^2=‖D u‖^2+‖D v‖^2 := by\n    rw [norm_sub_sq_real, norm_add_sq_real, hSym]\n    nlinarith only [hEnergy u, hEnergy v]\n  have hForm : inner ℝ (u-K v) u-inner ℝ (K u+v) v =\n      ‖u‖^2-‖v‖^2-2*inner ℝ (K u) v := by\n    have hSwap : inner ℝ (K v) u=inner ℝ (K u) v :=\n      (hK.isSymmetric v u).trans (real_inner_comm v (K u)).symm\n    rw [inner_sub_left, inner_add_left, hSwap, real_inner_self_eq_norm_sq,\n      real_inner_self_eq_norm_sq]\n    ring\n",
          "detail": "Literal compiled BODY span; exact preceding locals remain in scope.",
          "lean_source_region": {
            "path": "AutoSamplingTheory/TechnicalLemmas/Analysis/HilbertCorrectorBound.lean",
            "source_raw_sha256": "832e68d649c4f6a0c342a476a9d5a7bc5c95d3098abfe41c077cbabc5d51158a",
            "start_line": 39,
            "end_line": 50,
            "exact_code_raw_sha256": "9f867c93bb6aedab9ba178fd1922f2dd9bb3a89cd9441682609167d73178ab84"
          }
        },
        {
          "title": "Bound the quadratic form and block energy",
          "text": "Set S=‖u‖²+‖v‖² and T=‖u-Kv‖²+‖Ku+v‖²=‖Du‖²+‖Dv‖² throughout this five-step proof. Triangle inequality and the inner-product bound control E. The operator norm controls each D component.",
          "formula": "|E|\\le\\|u-Kv\\|\\|u\\|+\\|Ku+v\\|\\|v\\|,\\quad T\\le c^2 S.",
          "lean": "  have hAbs : |‖u‖^2-‖v‖^2-2*inner ℝ (K u) v| ≤\n      ‖u-K v‖*‖u‖+‖K u+v‖*‖v‖ := by\n    rw [← hForm]\n    exact (abs_sub _ _).trans (add_le_add\n      (abs_real_inner_le_norm _ _) (abs_real_inner_le_norm _ _))\n  have hDx (x : H) : ‖D x‖^2 ≤ c^2*‖x‖^2 := by\n    have hb : ‖D x‖ ≤ c*‖x‖ :=\n      (D.le_opNorm x).trans (mul_le_mul_of_nonneg_right hNorm (norm_nonneg x))\n    have hs := (sq_le_sq₀ (norm_nonneg (D x)) (mul_nonneg hc (norm_nonneg x))).2 hb\n    nlinarith only [hs]\n  have hBlockBound : ‖u-K v‖^2+‖K u+v‖^2 ≤ c^2*(‖u‖^2+‖v‖^2) := by\n    rw [hBlock]\n    nlinarith only [hDx u, hDx v]\n",
          "detail": "Literal compiled BODY span; exact preceding locals remain in scope.",
          "lean_source_region": {
            "path": "AutoSamplingTheory/TechnicalLemmas/Analysis/HilbertCorrectorBound.lean",
            "source_raw_sha256": "832e68d649c4f6a0c342a476a9d5a7bc5c95d3098abfe41c077cbabc5d51158a",
            "start_line": 51,
            "end_line": 63,
            "exact_code_raw_sha256": "86718d728669a29444e103a04b1e6c2b4004d7c4dc19704e4e4207952fc6c8cd"
          }
        },
        {
          "title": "Apply two-component Cauchy-Schwarz",
          "text": "The scalar inequality follows from a single nonnegative square. Combine with the block energy bound, keeping S nonnegative.",
          "formula": "(ab+de)^2\\le(a^2+d^2)(b^2+e^2),\\quad E^2\\le S T\\le c^2S^2.",
