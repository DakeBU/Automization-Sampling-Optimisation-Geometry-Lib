  "source_target": {
    "anchor": "S4.E6 first inequality only",
    "literal": "W_2(r_y,N(0,I)) <= sqrt(E_{r_y} ||grad rho_y(U)||^2)",
    "standing": "V C2, actual kappa^-1 I<=HessV<=I, kappa>=1; eta>0; every fixedy in Euclidean R^d. Numerical eta<=1/(2beta) and neighboringLemma4.1 eta<=1 are not analytic premises.",
    "metric": "S4.Ex1 defines W_{q,M}=infcouplings(E||X-Y||_M^q)^(1/q). Here q2,M=I Euclidean quadratic optimal-transport distance, not weighted or truncateddist; reference actual centered covarianceI Gaussian.",
    "printed_route": "S4.SS1.p4.3 explicitly says first inequality combines Talagrand for standardGaussian and GaussianLSI. No exact external citation/theorem-number supplied here.",
    "actual_laws": "p=trueprox_etaV(y), rho(u)=V(p+sqrteta*u)-V(p)-sqrteta<gradV(p),u>, r is pushforward trueRGO R_eta,y under (x-p)/sqrteta and has actual normalized volume density exp(-||u||²/2-rho(u))."
  },
  "exact_constant_reconstruction": {
    "gamma": "stdGaussian=N(0,I), probability density (2pi)^(-d/2)exp(-||u||²/2)",
    "density_ratio": "q=d r/d gamma=exp(-rho)/Z_gamma, Z_gamma=E_gamma exp(-rho)>0; q positive normalized, not arbitrary supplied probability density.",
    "relative_entropy": "KL(r||gamma)=int qlogq dgamma=int(-rho-logZ_gamma) dr; entropy direction fixedr relativegamma.",
    "relative_Fisher": "I(r||gamma)=int||gradlogq||²dr=int||gradrho||²dr, because gradlogq=-gradrho; no1/2 coefficient in Fisher.",
    "GaussianLSI_density": "KL(r||gamma)<=I/2. Equivalent squarefunction convention Ent_gamma(f²)<=2 int||gradf||²dgamma with f=sqrtq and gradf=-(1/2)fgradrho.",
    "GaussianT2": "W2(r,gamma)²<=2 KL(r||gamma).",
    "composition": "W2²<=2KL<=I hence nonnegativeW2<=sqrtI; exact printedconstant1, independentdimension/eta.",
    "analytic_domains_derived": "Both laws probability/finite2, actual absolutecontinuity and positive RN derivative, q/f Sobolev/C1 representative, entropyL1 and Fisherfinite, squaredroot derivative/energy normalization, couplings/nonnegativefiniteW2 must be produced internally from literal sourcepotential. No public LSI/T2/Fisher/domain certificate."
  },
