      "targetText": "3. Transport and construct the exact centered restrictionConjugate commutation. Tq=q implies AqP=qP;symmetry preserves the exact zero-mean kernel. Construct A0 by codomain restriction and prove selfadjointness.[ΓP,A]=0,AqP=qP,⟨qP,Au⟩=⟨AqP,u⟩=0(u∈HP0).Corresponding Lean step  have hCommP : Commute ΓP A := by\n    change ΓP*A=A*ΓP\n    change (e.conjStarAlgEquiv Γ)*A=A*(e.conjStarAlgEquiv Γ)\n    rw [hAeqLocal,← map_mul,← map_mul,hCommRoot.eq]\n  have hAq : A qP=qP := by\n    rw [hAeqLocal]\n    change e (T (e.symm (e q)))=e q\n    rw [e.symm_apply_apply,hTq]\n  have hAPreserves (u : HP0) : A (u : HP) ∈ HP0 := by\n    change inner ℝ qP (A (u : HP))=0\n    calc\n      inner ℝ qP (A (u : HP))=inner ℝ (A qP) (u : HP) :=\n        (hAsLocal.isSymmetric qP (u : HP)).symm\n      _ = inner ℝ qP (u : HP) := by rw",
