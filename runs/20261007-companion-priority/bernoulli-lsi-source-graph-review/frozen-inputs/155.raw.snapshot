theorem sum_twoPointEntropyCoord_nonneg {n : ℕ} (h : (Fin n → Bool) → ℝ)
    (ε : Fin n → Bool) :
    0 ≤ ∑ j : Fin n, twoPointEntropyCoord j h ε := by
  apply Finset.sum_nonneg
  intro j _
  exact twoPointEntropyCoord_nonneg j h ε

