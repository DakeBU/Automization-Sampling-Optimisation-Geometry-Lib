  "primary_full_raw_sha256": "ec485cdad5fe140114be35eef93d19398e0cafcf21abb3fff1bdbbf462e5f94d",
  "printed_slice": "W2(r_y,N(0,I))<=sqrt(E_r||grad rho_y||²); printed author says this first bound combines standard Gaussian Talagrand and log-Sobolev. No compact finite product tensorization proof printed here.",
  "proof_credit": false,
