    {
      "id": "transport:entropy-sandwich",
      "kind": "concept-bridge",
      "label": "MFLD: entropy sandwich and PL controls",
      "status": "proposal",
      "subtitle": "source-backed correspondence",
      "summary": "For a differentiable mixture-convex F, set L=F+λ Ent and q_μ proportional to exp(−δF(μ)/λ). Gibbs variational inequalities sandwich the gap.",
      "formula": "\\begin{gathered}\\lambda\\mathrm{KL}(\\mu\\Vert\\mu_*)\\leq\\mathcal L(\\mu)-\\mathcal L(\\mu_*)\\\\\\mathcal L(\\mu)-\\mathcal L(\\mu_*)\\leq\\lambda\\mathrm{KL}(\\mu\\Vert q_\\mu)\\end{gathered}",
      "details": [
        {
          "label": "Evidence boundary",
          "value": "Literature/structural correspondence; no Lean-certified functor or theorem transfer."
        },
        {
          "label": "Conceptual families",
          "value": "family:gap-gradient"
        },
        {
          "label": "Mechanism",
          "value": "For a differentiable mixture-convex F, set L=F+λ Ent and q_μ proportional to exp(−δF(μ)/λ). Gibbs variational inequalities sandwich the gap."
        },
        {
          "label": "Hypothesis Map",
          "value": "Require a minimizer, normalizable q_μ, and the source differentiability/integrability contracts. Uniform LSI for q_μ is an EXTRA hypothesis, not a consequence of mixture convexity."
        },
        {
          "label": "Conclusion Map",
          "value": "LSI KL≤I/(2ρ) and dL/dt=−λ²I give a PL-type dissipation control. The lower sandwich is a KL-growth control; W2 quadratic growth additionally needs a transport-entropy inequality for μ*."
        },
        {
          "label": "Failure Boundary",
          "value": "Mixture convexity ≠ displacement convexity. Neither LSI nor W2 quadratic growth follows merely from an entropy term. This connects proof mechanisms, not identical geometries."
        },
        {
          "label": "Category objects",
          "value": "Typed problem presentations, not field names."
        },
        {
          "label": "Category morphisms",
          "value": "A specified solution/certificate transport; no total morphism map is claimed."
        },
        {
          "label": "Category identity",
          "value": "Not established; not asserted to be a functor."
        },
        {
          "label": "Category composition",
          "value": "Not established; side conditions of consecutive transports must be checked."
        },
        {
          "label": "Shared planned checkpoints",
          "value": "convex, entropy, flow"
        },
