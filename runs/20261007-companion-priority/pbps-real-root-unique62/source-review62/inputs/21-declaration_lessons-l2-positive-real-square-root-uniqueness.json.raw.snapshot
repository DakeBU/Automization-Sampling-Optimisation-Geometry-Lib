{
  "schema_version": 1,
  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.Measure.L2RealSquareRootUnique.positive_square_roots_unique",
      "title": "Positive real L² operators: equality from equal squares",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06905v1#A4",
          "label": "arXiv2609.06905v1 D1 positive-root uniqueness background; scalar antecedent to printed B10 canonical joint root",
          "scope": "Exported real scalar uniqueness and genuine original-input same defect/root only. Printed joint GammaP/ontoM/typed B*B, centered order/inverse/polar/H1/dynamics/main/cost/composition remain separate."
        }
      ],
      "tests": [
        "lake build Tests.ProximalBPSRealDefectRootUnique"
      ],
      "assumptions": [
        "Let Ω be any measurable space, μ any measure, and A,B bounded positive real-linear operators on L²(μ;ℝ). Assume A²=B², where multiplication is composition. Then A=B. Positivity is symmetry plus nonnegative quadratic form on the complete real L² space. No finite/probability measure, finite-dimensional L², nontriviality, energy identity or real/complex CFC/extension certificate is assumed.",
        "Arbitrary measure, including zero/subsingleton/infinite-dimensional L²; no energy, CFC, complex extension or norm-preserving embedding certificate supplied."
      ],
      "statement": "Let Ω be any measurable space, μ any measure, and A,B bounded positive real-linear operators on L²(μ;ℝ). Assume A²=B², where multiplication is composition. Then A=B. Positivity is symmetry plus nonnegative quadratic form on the complete real L² space. No finite/probability measure, finite-dimensional L², nontriviality, energy identity or real/complex CFC/extension certificate is assumed.",
      "formula": "A\\ge0,\\quad B\\ge0,\\quad A^2=B^2\\quad\\Longrightarrow\\quad A=B.",
      "boundary": "Exported real scalar uniqueness and genuine original-input same defect/root only. Printed joint GammaP/ontoM/typed B*B, centered order/inverse/polar/H1/dynamics/main/cost/composition remain separate.",
      "steps": [
        {
          "title": "Lift both positive real operators canonically",
          "text": "Use the compiled shared positive complex lift twice over the SAME arbitrary measure. The actual quotient maps ι,R,Q are identical in both results. The internally produced positive complex Ac,Bc satisfy Acι=ιA, Bcι=ιB and the literal coordinate formula for every complex L² class. The same theorem proves ‖ιu‖=‖u‖.",
          "formula": "A_{\\mathbb C},B_{\\mathbb C}\\ge0,\\quad A_{\\mathbb C}\\iota=\\iota A,\\quad B_{\\mathbb C}\\iota=\\iota B,\\quad\\|\\iota u\\|=\\|u\\|.",
          "lean": "L2RealComplexOperator.exists_positive_complex_lift; hNorm; hAf; hBf; hAi; hBi"
        },
        {
          "title": "Transport equality of squares",
          "text": "Complex linearity and intertwining give Ac²g=ι(A²Rg)+iι(A²Qg), and the corresponding formula for Bc. The original equality A²=B² applies separately to Rg and Qg, giving Ac²=Bc² on every complex class. No multiplicativity or decomposition certificate is a public premise.",
          "formula": "A_{\\mathbb C}^2g=\\iota A^2Rg+i\\iota A^2Qg=\\iota B^2Rg+i\\iota B^2Qg=B_{\\mathbb C}^2g.",
          "lean": "hReal; hComplexSquare; map_add; map_smul; ContinuousLinearMap.ext"
        },
        {
          "title": "Apply complex positive-root uniqueness internally",
          "text": "The fixed Mathlib complex operator algebra provides complex functional calculus and its restricted real selfadjoint instance internally. Both positive Ac and Bc equal the positive square root of their common square by CFC.sqrt_unique. Hence Ac=Bc. This requires no real functional-calculus instance on the original operator algebra.",
          "formula": "A_{\\mathbb C}=\\sqrt{B_{\\mathbb C}^2}=B_{\\mathbb C}.",
          "lean": "hAcNonneg; hBcNonneg; CFC.sqrt_unique; hSame"
        },
        {
          "title": "Recover equality of the real operators",
          "text": "Norm preservation constructs a real-linear isometry e=ι, so ι is injective. Evaluate Ac=Bc on ιu; intertwining gives ιAu=ιBu, then injectivity gives Au=Bu for every real L² class. Extensionality proves A=B, including zero/subsingleton spaces.",
          "formula": "\\iota Au=A_{\\mathbb C}\\iota u=B_{\\mathbb C}\\iota u=\\iota Bu\\quad\\Longrightarrow\\quad A=B.",
          "lean": "e; LinearIsometry.injective; hAi; hBi; ContinuousLinearMap.ext"
        }
      ],
      "lean_statement": "Let Ω be any measurable space, μ any measure, and A,B bounded positive real-linear operators on L²(μ;ℝ). Assume A²=B², where multiplication is composition. Then A=B. Positivity is symmetry plus nonnegative quadratic form on the complete real L² space. No finite/probability measure, finite-dimensional L², nontriviality, energy identity or real/complex CFC/extension certificate is assumed.",
      "lean_proof": "Lift both positive real operators canonically; Transport equality of squares; Apply complex positive-root uniqueness internally; Recover equality of the real operators",
      "astis_dependencies": [
        "AutoSamplingTheory.TechnicalLemmas.Measure.L2RealComplexOperator.exists_positive_complex_lift"
      ],
      "mathlib_dependencies": [
        "ContinuousLinearMap.ext",
        "map_add",
        "map_smul",
        "ContinuousLinearMap.nonneg_iff_isPositive",
        "CFC.sqrt_unique",
        "LinearIsometry.injective"
      ]
    }
  ]
}
