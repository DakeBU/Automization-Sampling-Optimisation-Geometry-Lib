ActualGramProducerSealedKernelCheck (of_decide_eq_true (id (Eq.refl true))) : let D := EuclideanSpace ℝ (Fin 2);
let E := EuclideanSpace ℝ (Fin (0 + 1));
let Ω := Fin (0 + 1) → D;
have μ := Measure.pi fun x => stdGaussian D;
have r := ↑(0 + 1);
have L := 2 * r + 3 * Real.log (1000 * ↑2);
have θ := fun i => (↑↑i + 1 - 1 / 2) * Real.pi / ↑2;
have t := fun i k => if ↑k = 0 then 1 else √2 * Real.cos (↑↑k * θ i);
have row := fun i ω => WithLp.toLp 2 fun b => (ω b).ofLp i;
have Y := fun i ω =>
  if ‖row i ω‖ ^ 2 ≤ L then
    (↑2)⁻¹ • (Matrix.vecMulVec (row i ω).ofLp (row i ω).ofLp).kronecker (Matrix.vecMulVec (t i) (t i))
  else 0;
have mean := fun i => ∫ (ω : Ω), Y i ω ∂μ;
have Z := fun i ω => Y i ω - mean i;
have a := (∫ (x : E), {y | ‖y‖ ^ 2 ≤ L}.indicator (fun y => ‖y‖ ^ 2) x ∂stdGaussian E) / r;
have w := fun i => Real.cos (↑(2 * 0 + 1) * θ i);
have B := fun ω i u => (√↑2)⁻¹ * (row i ω).ofLp u.1 * t i u.2;
have G := fun ω => ∀ (i : Fin 2), ‖row i ω‖ ^ 2 ≤ L;
∀ (ω : Ω), G ω → ∑ i, Z i ω = (B ω)ᵀ * B ω - a • 1 ∧ ∑ i, w i • Z i ω = (B ω)ᵀ * Matrix.diagonal w * B ω
ActualGramConsumerSealedKernelCheck (of_decide_eq_true (id (Eq.refl true))) : let D := EuclideanSpace ℝ (Fin 2);
let E := EuclideanSpace ℝ (Fin (0 + 1));
let Ω := Fin (0 + 1) → D;
have μ := Measure.pi fun x => stdGaussian D;
