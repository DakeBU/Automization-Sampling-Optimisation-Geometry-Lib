  "local_findings": [
    {
      "module": "FunctionalInequalities.LogSobolev",
      "kind": "BOOKKEEPING",
      "actual": "Reexports lsiKlFi sqrt-density/normalization/RN entropy/Fisher-chain scalar and finite-sum handoffs from Probability; no analytic Gaussian LSI producer."
    },
    {
      "module": "FunctionalInequalities.Generator",
      "kind": "DEFINITION",
      "actual": "LogSobolevAdmissible pi generator rho requires rho nonnegative, L1, mass1, rho log rho L1 and rho generator(log rho) L1. SatisfiesLogSobolev additionally pi probability, C>0 and densityEntropy <= (C/2) dirichletForm on all admissible rho."
    },
    {
      "module": "FunctionalInequalities.CanonicalLogSobolev.finite_klDiv_and_toReal_le_half_mul_information",
      "kind": "CONDITIONAL_INTERFACE",
      "actual": "Given hLSI, hAdmissible, hScore, hPair, hGamma on EuclideanSpace finite coordinates, mu probability/SigmaFinite/decomposition: klDiv != infinity AND toReal <= C/2 information. Analytic Gaussian LSI, admissibility and generator/score domains are inputs, not generated."
    },
    {
      "module": "InformationTheory.CanonicalRelativeFisher.SmoothFiniteScoreDomain",
      "kind": "DOMAIN_DEFINITION",
      "actual": "mu << pi; differentiable_ae of the pointwise chosen RNLogRatio.logRatio mu pi under mu; scoreSq_integrable. A.e. equality of chosen RN density to smooth exp(-rho)/Z cannot by itself imply differentiability of the chosen representative. Source target is explicit grad rho integral; adding public hScore would be excess. Explicit smooth square-root-density function route or honest representative-independent Sobolev bridge is necessary."
    },
    {
      "module": "InformationTheory.RelativeFisher.information",
      "kind": "DEFINITION",
      "actual": "Real integral density*norm(gradient logratio)^2 under supplied base; domain obligations must be established, not inferred from total Bochner integral."
    },
    {
      "module": "InformationTheory.QuadraticTiltFisher.information_quadratic_representative",
      "kind": "DIFFERENT_PRODUCER",
      "actual": "Two quadratic RGO fibers, explicit quadratic relative logratio, eta^-2*norm(y-yprime)^2; not rho-tilt versus Gaussian and not LSI/T2."
    },
    {
      "module": "Measure.WassersteinSpace",
      "kind": "METRIC_AND_COUPLING_INTERFACES",
      "actual": "quadraticCost=ENNReal.ofReal norm(x-y)^2; wassersteinDistance=Transport.transportCost ^(1/2); square identity, coupling upper bounds and approximate strict infimum witness. Preserve ENNReal finiteness instead of unguarded toReal."
    },
    {
      "module": "Measure.WassersteinFiniteSecondMoment.wassersteinDistance_lt_top_of_integrable_norm_sq",
      "kind": "GENUINE_DOMAIN_PRODUCER",
      "actual": "Probability laws + actual squared norm integrability produce finite quadratic transport using product coupling."
    },
    {
      "module": "Measure.WassersteinLipschitzMoment.of_wassersteinDistance_sq_le",
      "kind": "DIFFERENT_MOMENT_INTERFACE",
      "actual": "Transfers squared norm moment with factor2; not vector first-mean Lipschitz comparison needed for source4.2."
    },
    {
      "module": "Probability.GaussianLipschitzExponential",
      "kind": "GAUSSIAN_CONCENTRATION",
      "actual": "Sharp centered Lipschitz MGF from previous packet; no Gaussian LSI/T2 implication claimed or available here."
    },
    {
      "module": "Registry lsi.product-gaussian",
      "kind": "EXTERNAL_PORT_CANDIDATE",
      "actual": "Status portCandidate with upstream gaussian_logSobolev_W12_pi and no local declaration. Registry metadata is not callable mathematics."
    }
  ],
