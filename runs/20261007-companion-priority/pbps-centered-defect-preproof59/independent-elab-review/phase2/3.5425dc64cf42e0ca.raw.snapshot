import Mathlib.Analysis.InnerProductSpace.Positive
import Mathlib.Analysis.InnerProductSpace.LinearMap
open scoped NNReal
set_option pp.notation false
set_option pp.explicit true
set_option pp.instances false
set_option pp.proofs false
example {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H] :
    ∃ q : H, let H0 : Submodule ℝ H := (innerSL ℝ q).ker
      ∃ T0 : H0 →L[ℝ] H0, (1-T0*T0).IsPositive := by
  refine ⟨0,0,?_⟩
  simpa only [mul_zero,sub_zero] using (ContinuousLinearMap.isPositive_one : (1 : ((innerSL ℝ (0:H)).ker) →L[ℝ] ((innerSL ℝ (0:H)).ker)).IsPositive)
