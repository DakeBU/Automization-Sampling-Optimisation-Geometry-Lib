    <pre class="code-block"><code class="language-lean">private theorem epsilon_bounds (n : ℕ) : 0 &lt; epsilon n ∧ epsilon n ≤ 1 := by
  constructor
  · unfold epsilon
    positivity
  · unfold epsilon
    have hn : (1 : ℝ) ≤ (n : ℝ) + 1 := by linarith [Nat.cast_nonneg (α := ℝ) n]
