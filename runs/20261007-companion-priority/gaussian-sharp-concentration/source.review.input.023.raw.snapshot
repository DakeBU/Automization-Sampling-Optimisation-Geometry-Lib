      "source_anchors": [
        "S4.E5",
        "S4.SS1.p5.2"
      ],
      "formula": "‖H_y(z)−H_y(w)‖≤√η‖z−w‖",
      "parents": [
        "GAUSSIAN-ORACLE",
        "GRADIENT-LIPSCHITZ",
        "ETA-POSITIVE"
      ],
      "conclusion": "Actual √η-noise-Lipschitz bound.",
      "truth_boundary": "Proof ingredient must be internally produced; no public supplied Lipschitz certificate."
    },
    {
      "id": "GAUSSIAN-RADIAL-DOMAIN-BACKGROUND",
      "kind": "AuthoredPrerequisite-SourceGap",
      "source_anchors": [
        "S4.Ex7",
        "S4.E3",
        "S4.SS1.p5.2"
      ],
      "formula": "∫‖z‖dγd<∞ and ∀c≥0,∫exp(c‖z‖)dγd<∞",
      "parents": [
        "CANONICAL-GAUSSIAN"
      ],
      "conclusion": "One sufficient Gaussian background for actual firstL1 and allsigned exponential domains.",
      "truth_boundary": "Implicit/non-source bookkeeping alternative; source does not print radial proof. Finiteness alone never gives sharp1/2."
    },
    {
      "id": "ACTUAL-MOMENT-AND-EXP-DOMAIN",
      "kind": "SourceImplicitPrerequisite-SourceGap",
      "source_anchors": [
        "S4.Ex7",
        "S4.E3"
      ],
      "formula": "∫‖H_y‖dγd<∞; ∀a∈R^d, ∀t∈R,exp(t⟨a,H_y−∫H_y dγd⟩)∈L¹(γd)",
      "parents": [
        "GAUSSIAN-ORACLE",
        "NOISE-LIPSCHITZ",
        "GAUSSIAN-RADIAL-DOMAIN-BACKGROUND"
      ],
      "conclusion": "Genuine Bochner/scalar mean, integrable allsigned exponential expressions and projection/integral commutation.",
      "truth_boundary": "Source analytic prerequisites, never extra public assumptions. Historical packet29 domain result only potential later implementation candidate, not source authority or freshly verified."
    },
    {
      "id": "ACTUAL-CENTER",
      "kind": "SourceDecomposition-Elaboration",
      "source_anchors": [
        "S4.Ex7"
      ],
      "formula": "H_y=gη(y)+bη(y)+ξη(y;·), Eγξη=0; hence ξη=H_y−mη(y), mη=∫H_y dγd",
      "parents": [
        "GAUSSIAN-ORACLE",
        "ACTUAL-MOMENT-AND-EXP-DOMAIN"
      ],
      "conclusion": "Actual own Bochner expectation center fixed for eachy.",
      "truth_boundary": "gη+bη deterministic; need no bias size bound or smoothed-score theorem to reconstruct ownmean center. H_y−gη is not ξη."
    },
    {
      "id": "SCALAR-DIRECTION-LIPSCHITZ",
      "kind": "SourceImplicitDirectionalAdapter",
      "source_anchors": [
        "S4.E3",
        "S4.Thmtheorem2.p1.2",
        "S4.SS1.p5.2"
      ],
      "formula": "f_a(z)=⟨a,H_y(z)⟩, Lip(f_a)≤√η‖a‖",
      "parents": [
        "NOISE-LIPSCHITZ"
      ],
      "conclusion": "Directional scalar Gaussian observable, arbitrary a including0.",
      "truth_boundary": "Cauchy-Schwarz projection adapter; source u arbitrary, signedt absorbed into u=t a."
    },
    {
      "id": "GAUSSIAN-CONCENTRATION-BACKGROUND",
      "kind": "NamedSourceBackground-SourceGap",
      "source_anchors": [
