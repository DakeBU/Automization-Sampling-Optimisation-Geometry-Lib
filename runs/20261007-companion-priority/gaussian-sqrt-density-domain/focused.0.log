                                      u) ∂stdGaussian E)
                            s)
                      s u ∂stdGaussian E =
                  1 ∧
                ContDiff ℝ 2
                    ((fun s u =>
                        Real.exp
                            (-(fun s u => V (p s + √(eta s) • u) - V (p s) - √(eta s) * ⟪gradient V (p s), u⟫) s u /
