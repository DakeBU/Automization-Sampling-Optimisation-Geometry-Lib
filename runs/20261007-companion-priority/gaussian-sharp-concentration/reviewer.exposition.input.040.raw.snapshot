</details><details class="declaration" id="decl-autosamplingtheory-technicallemmas-probability-gaussianlipschitzexponent-aa440ceb18">
  <summary><span class="kind">theorem</span> <code>AutoSamplingTheory.TechnicalLemmas.Probability.GaussianLipschitzExponential.centered_exp_integral_of_subsingleton</code> <span class="status status-yellow">Partial</span> <span class="status status-gray">Not mapped</span></summary>
  <div class="declaration-content">
    <p class="muted">No declaration docstring.</p>
    <pre class="code-block"><code class="language-lean">private theorem centered_exp_integral_of_subsingleton
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [CompleteSpace E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
    [Subsingleton E] (f : E → ℝ) (t : ℝ) :
    (∫ x, Real.exp (t * (f x - ∫ z, f z ∂stdGaussian E))
      ∂stdGaussian E) = 1 := by
  have hconst : f = fun _ =&gt; f 0 := by
    funext x
    exact congrArg f (Subsingleton.elim x 0)
  rw [hconst]
  simp

/- Radial domination is used on the actual product Gaussian when differentiating
the rotation integral. Its constants are domination constants, not the sharp
concentration coefficient. -/</code></pre>
