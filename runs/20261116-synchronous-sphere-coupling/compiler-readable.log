def Real.toNNReal : ℝ → NNReal :=
fun r => NNReal.mk (max r 0) ⋯
constructor WithLp.toLp.{u_1} : (p : ENNReal) → {V : Type u_1} → V → WithLp p V
private def SynchronousSphereCoupling.block : {d : ℕ} →
  Bool → EuclideanSpace ℝ (Bool × Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d) :=
fun {d} b =>
  ↑(PiLp.continuousLinearEquiv 2 ℝ fun x => ℝ).symm ∘SL ContinuousLinearMap.pi fun j => PiLp.proj 2 (fun x => ℝ) (b, j)
private def SynchronousSphereCoupling.difference : {d : ℕ} →
  EuclideanSpace ℝ (Bool × Fin d) →L[ℝ] EuclideanSpace ℝ (Fin d) :=
fun {d} => block false - block true
private def SynchronousSphereCoupling.pair : {d : ℕ} →
  EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Bool × Fin d) :=
fun {d} x y => WithLp.toLp 2 fun q => if q.1 = true then y.ofLp q.2 else x.ofLp q.2
