280: def semantic_reviewer_packet(audit: dict[str, Any]) -> dict[str, Any]:
281:     """Create an independent source-review packet after blind reconstruction.
282: 
283:     This packet intentionally includes the source contract because the reviewer
284:     must compare it with the reconstruction. It intentionally omits any existing
285:     semantic slots, deltas, verdict, reviewer decision, or repair proposal so the
286:     reviewer is not anchored by a previous model's conclusions.
287:     """
288: 
289:     source = audit.get("source", {}) if isinstance(audit.get("source"), dict) else {}
290:     lean = audit.get("lean", {}) if isinstance(audit.get("lean"), dict) else {}
291:     reconstruction = audit.get("reconstruction", {}) if isinstance(audit.get("reconstruction"), dict) else {}
292:     identity_material = {
293:         "source_text_sha256": source.get("text_sha256", ""),
294:         "lean_statement_sha256": lean.get("statement_sha256", ""),
295:         "reconstructed_text_sha256": reconstruction.get("text_sha256", ""),
296:     }
297:     core = {
298:         "schema_version": 1,
299:         "task": "independent-semantic-source-review",
300:         "packet_id": "ASTIS-REVIEW-" + sha256_json(identity_material)[:16],
301:         "anti_anchoring": {
302:             "prior_semantic_slots_included": False,
303:             "prior_deltas_included": False,
304:             "prior_verdict_included": False,
305:             "prior_repairs_included": False,
306:         },
307:         "roles": {
308:             "formalizer": lean.get("formalizer", ""),
309:             "blind_decoder": reconstruction.get("decoder", ""),
310:             "reviewer_must_differ_from_both": True,
311:         },
312:         "source": {
313:             "source_id": source.get("source_id", ""),
314:             "anchor": source.get("anchor", ""),
315:             "original_text": source.get("original_text", ""),
316:             "text_sha256": source.get("text_sha256", ""),
317:         },
318:         "lean": {
319:             "declaration": lean.get("declaration", ""),
320:             "file": lean.get("file", ""),
321:             "statement": lean.get("statement", ""),
322:             "statement_sha256": lean.get("statement_sha256", ""),
323:             "compiled": lean.get("compiled", False),
324:         },
325:         "blind_reconstruction": {
326:             "text": reconstruction.get("text", ""),
327:             "text_sha256": reconstruction.get("text_sha256", ""),
328:             "decoder": reconstruction.get("decoder", ""),
329:             "decoder_packet_sha256": reconstruction.get("decoder_packet_sha256", ""),
330:             "decoder_run_sha256": reconstruction.get("decoder_run_sha256", ""),
331:             "source_text_visible": reconstruction.get("source_text_visible"),
332:         },
333:         "review_contract": {
334:             "semantic_slots": list(SEMANTIC_SLOTS),
335:             "slot_relations": sorted(SLOT_RELATIONS),
336:             "verdicts": sorted(VERDICTS - {"pending"}),
337:             "repair_classes": sorted(REPAIR_CLASSES),
338:             "repair_necessities": sorted(REPAIR_NECESSITIES),
339:             "rule": "Text similarity is not semantic equivalence. Repair proposals remain separate from the pinned source theorem.",
340:         },
341:         "output_contract": {
342:             "semantic_slots": {
343:                 slot: {
344:                     "original": "",
345:                     "reconstructed": "",
346:                     "relation": "not-audited",
347:                     "evidence": "",
348:                 }
349:                 for slot in SEMANTIC_SLOTS
