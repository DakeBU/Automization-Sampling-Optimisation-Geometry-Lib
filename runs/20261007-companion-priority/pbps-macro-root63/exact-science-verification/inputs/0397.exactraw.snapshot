steps0=[
dict(title='Reuse the genuine positive complex lift',text='The compiled canonical complexification theorem constructs ι, the real-part map R, pointwise conjugation C and positive complex-linear Dc from D. It proves Fix(C)=ran(ι) and Dcι=ιD internally. All maps act on actual AE classes for the same arbitrary measure.',formula=r'D_{\mathbb C}\ge0,\quad D_{\mathbb C}\iota=\iota D,\quad\operatorname{Fix}(C)=\operatorname{ran}(\iota).',lean='L2RealComplexOperator.exists_positive_complex_lift; hfixed; hintertwine'),
dict(title='Establish the antiunitary quotient identities',text='Pointwise scalar conjugation lifted by compLpL satisfies C²=I, C(cg)=conj(c)Cg and ⟨Cg,Ch⟩ℂ=conj(⟨g,h⟩ℂ). The AE formulas and conjugation of the Bochner integral establish these identities without choosing additional representatives. Also Rι=I and the embedding preserves the integral inner product.',formula=r'C^2=I,\quad C(cg)=\overline c\,Cg,\quad\langle Cg,Ch\rangle_{\mathbb C}=\overline{\langle g,h\rangle_{\mathbb C}},\quad R\iota=I.',lean='conjugate_involutive; conjugate_smul; inner_conjugate; real_embed; inner_embed'),
dict(title='Construct the complex positive square root internally',text='On the complex L² operator algebra the pinned Mathlib supplies complex CFC, and its restricted-real selfadjoint CFC is explicitly target-typed inside the proof. Thus Rc=sqrt(Dc) is positive and Rc²=Dc. This derives the needed instance rather than adding a real functional-calculus premise to the theorem.',formula=r'R_{\mathbb C}=\sqrt{D_{\mathbb C}}\ge0,\quad R_{\mathbb C}^2=D_{\mathbb C}.',lean='hRcNonneg; hRc; hRcSq; CFC.sqrt_nonneg; CFC.sqrt_mul_sqrt_self'),
dict(title='Prove root preservation by positive-root uniqueness',text='K=CRcC is bounded and complex-linear because conjugation reverses complex scalars twice. Its quadratic form is the conjugate of the nonnegative real quadratic form of Rc at Cg, so K is positive. C²=I and CDc=DcC give K²=Dc. Uniqueness of the complex positive square root gives K=Rc, hence CRc=RcC. This is pointwise conjugation, never operator adjoint.',formula=r'K=CR_{\mathbb C}C\ge0,\quad K^2=D_{\mathbb C},\quad K=R_{\mathbb C},\quad CR_{\mathbb C}=R_{\mathbb C}C.',lean='conjugateOperator; conjugateOperator_positive; hKSq; hK; CFC.sqrt_unique; hrootConj'),
dict(title='Descend to the full real L² space',text='Define the bounded real map Γ=R Rc ι. Since Rc preserves Fix(C), its value Rcιu lies in the full image of ι. The identity Rι=I then gives ιΓu=Rcιu. Applying this twice and using Dcι=ιD proves Γ²=D, with embedding injectivity. Real uniqueness and the centered restriction are separate statements.',formula=r'\Gamma=RR_{\mathbb C}\iota,\quad\iota\Gamma=R_{\mathbb C}\iota,\quad\Gamma^2=D.',lean='Γ; hbridge; hinj; hΓSq'),
dict(title='Transport positivity and derive the energy identity',text='The embedding preserves inner products. Therefore complex selfadjointness and positivity of Rc imply real selfadjointness and positivity of Γ. Its symmetry and exact square now yield ‖Γu‖²=⟨Γu,Γu⟩ℝ=⟨Γ²u,u⟩ℝ=⟨Du,u⟩ℝ for every u. No invertibility or strict positive lower bound follows on the full space.',formula=r'\Gamma\ge0,\quad\|\Gamma u\|^2=\langle\Gamma^2u,u\rangle_{\mathbb R}=\langle Du,u\rangle_{\mathbb R}.',lean='inner_embed; hΓ; hΓSq; real_inner_self_eq_norm_sq')]
steps1=[
dict(title='Produce the genuine reflected kernel and scalar defect',text='The independently verified centered-defect producer under the displayed original potential and step assumptions supplies probability μ,J,ν, the every-state normalized Markov S, genuine disintegration with both stationary marginals, and the same selfadjoint contractive mean-preserving T with AE conditional action. It proves D=I−T² positive internally, including the nontrivial constant mode; no caller operator or positivity certificate is used.',formula=r'S(y,dx)\propto\exp\!\left[-V\!\left(\frac{y+x}{2}\right)-\frac{\|y-x\|^2}{8\eta}\right]dx,\quad Tu(y)=\int u(x)S(y,dx),\quad D=I-T^2\ge0.',lean='CenteredDefectOperator.actual_centered_selfadjoint_defect; hBase; hAll; hD'),
dict(title='Apply the shared real-root theorem to that same defect',text='Apply the generic theorem to the actual marginal ν and the produced D. Its internally constructed positive real Γ satisfies Γ²=I−T². This supplies the real scalar root even when L² is infinite-dimensional and includes rank-zero base geometry and the legal αη=1 endpoint.',formula=r'\Gamma\ge0,\quad\Gamma^2=I-T^2\quad\text{on actual }L^2(\nu;\mathbb R).',lean='L2RealSquareRoot.exists_positive_real_square_root; hΓ; hΓSq'),
dict(title='Identify the scalar norm defect',text='For every scalar observable u, root energy equals ⟨(I−T²)u,u⟩. Selfadjointness of the same T gives ⟨T²u,u⟩=‖Tu‖²; thus ‖Γu‖²=‖u‖²−‖Tu‖². The anonymous actual-input Test also checks ‖Γu‖≤‖u‖. This is a scalar B.11 precursor. Printed joint ΓP still requires the same onto M, restriction to ran(P) and the typed B*B identity; no full-space inverse is claimed.',formula=r'\|\Gamma u\|^2=\|u\|^2-\|Tu\|^2,\quad\|\Gamma u\|\le\|u\|.',lean='hEnergy; hTs.isSymmetric; hs; real_inner_self_eq_norm_sq')]
