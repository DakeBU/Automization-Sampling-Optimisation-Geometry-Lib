info: Tests/ItoIntegralProcess.lean:26:0: AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.ItoIntegralProcess.chewi_theorem_1_1_8.{u_1} {Omega : Type u_1}
  {m : MeasurableSpace Omega} {filtration : MeasureTheory.Filtration NNReal m} {mu : MeasureTheory.Measure Omega}
  {T : NNReal} {B : NNReal → Omega → ℝ} [MeasureTheory.IsFiniteMeasure mu]
  (eta : ProgressiveL2.ProgressiveL2Integrand filtration mu T) (hT : 0 < T)
  (hB : BrownianMotion.IsBrownianMotionWithFiltration B filtration mu)
  (hUsual : ProgressiveL2.SatisfiesUsualConditions filtration mu) :
  ∃ I,
    MeasureTheory.StronglyAdapted filtration I ∧
      MeasureTheory.Martingale I filtration mu ∧
        (∀ᵐ (omega : Omega) ∂mu, ContinuousOn (fun t => I t omega) (Set.Icc 0 T)) ∧
          (∀ t ≤ T,
              I t =ᵐ[mu] fun omega => ↑↑(ItoTerminalCompletion.itoIntegralTerminal (eta.restrictAt t) hT hB) omega) ∧
            (∀ t ≤ T,
                ∫ (omega : Omega), I t omega ^ 2 ∂mu =
                  ∫ (z : Omega × NNReal),
                    ProgressiveL2.processFunction (eta.restrictAt t).process z ^
                      2 ∂ElementaryItoIntegral.processTimeMeasure mu T) ∧
              ∀ (J : NNReal → Omega → ℝ),
                MeasureTheory.StronglyAdapted filtration J →
                  (∀ᵐ (omega : Omega) ∂mu, ContinuousOn (fun t => J t omega) (Set.Icc 0 T)) →
                    (∀ t ≤ T,
                        J t =ᵐ[mu] fun omega =>
                          ↑↑(ItoTerminalCompletion.itoIntegralTerminal (eta.restrictAt t) hT hB) omega) →
                      ∀ᵐ (omega : Omega) ∂mu, ∀ t ∈ Set.Icc 0 T, J t omega = I t omega
