    },
    {
      "id": "I50.meanlift",
      "kind": "internal-obligation",
      "contract": "For smooth compact f, parent gives g=[f∘snd], Pg=g, Ag=[∫f S0∘snd]. Lift AEν equality of conditional means to AEJ along measurable snd. This changes quotient representative only; true differentiability stays49 literal Tf."
    },
    {
      "id": "I50.normtransport",
      "kind": "internal-obligation",
      "contract": "Use actual f/Tf L2ν and AE representatives to express ||g||²=∫f²ν, ||Ag||²=∫Tf²ν. Actual J.snd pushforward and L2 integral inner product supply every squared-domain/integrability premise internally."
    },
    {
      "id": "I50.defect",
      "kind": "internal-obligation",
