        "Optlib",
        "CvxLean"
      ],
      "boundary": "Mixture convexity, geodesic convexity and displacement convexity remain different predicates."
    },
    {
      "id": "sf-coupling-wasserstein",
      "title": "Couplings, marginal constraints and Wasserstein metric core",
      "parents": [
        "sf-euclidean-linear-algebra",
