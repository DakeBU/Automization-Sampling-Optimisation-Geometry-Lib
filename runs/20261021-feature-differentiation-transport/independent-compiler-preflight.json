      "complete_source_signature": "theorem actual_gaussian_polynomial_ridge_L2_frechet_derivative\n    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]\n    [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]\n    (p : Polynomial ℝ) :\n    let γ := ProbabilityTheory.stdGaussian E\n    let f : E → E → ℝ := fun w x => p.eval ⟪w,x⟫_ℝ\n    let df : E → E → E → ℝ := fun w v x => p.derivative.eval ⟪w,x⟫_ℝ * ⟪v,x⟫_ℝ\n    ∃ hf : ∀ w, MemLp (f w) 2 γ,\n    ∃ hdf : ∀ w v, MemLp (df w v) 2 γ,\n    ∃ D : E → E →L[ℝ] Lp ℝ 2 γ,\n      (∀ w v, D w v = (hdf w v).toLp (df w v)) ∧\n      ∀ w, HasFDerivAt (fun u => (hf u).toLp (f u)) (D w) w",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.Probability.GaussianPolynomialDifferentiation.actual_gaussian_polynomial_ridge_L2_frechet_derivative",
      "file": "AutoSamplingTheory/TechnicalLemmas/Probability/GaussianPolynomialDifferentiation.lean",
