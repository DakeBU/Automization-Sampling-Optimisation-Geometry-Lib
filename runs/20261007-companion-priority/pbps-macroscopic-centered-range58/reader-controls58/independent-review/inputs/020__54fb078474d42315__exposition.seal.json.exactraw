          "proof_ingredients": []
        },
        {
          "id": "BG:pushforward-Lp",
          "anchor": "B.2 omitted Lp transfer",
          "kind": "mathlib-available",
          "statement": "Since nu=map snd J, AE measurability and MemLp of h composed snd imply h in MemLp(2,nu), via memLp_map_measure_iff. Measurability is discharged from h and snd.",
