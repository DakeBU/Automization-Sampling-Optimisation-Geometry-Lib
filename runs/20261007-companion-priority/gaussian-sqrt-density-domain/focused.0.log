                                          (-(fun s u =>
                                                V (p s + √(eta s) • u) - V (p s) - √(eta s) * ⟪gradient V (p s), u⟫)
                                              s u) /
                                        (fun s =>
                                            ∫ (u : E),
                                              Real.exp
                                                (-(fun s u =>
