<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E5.m2" class="ltx_Math" alttext="\displaystyle\leqslant C\Lambda_{J}\sqrt{d+q}\,\Bigl\{B_{J,q}h\,\Bigl(\frac{h}{\sqrt{\eta}}\Bigr)^{J}+h^{3}\,(h^{2}\Lambda_{J})^{K-1}\Bigr\}\,," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>⩽</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>J</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>d</mi><mo>+</mo><mi>q</mi></mrow></msqrt><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>B</mi><mrow><mi>J</mi><mo>,</mo><mi>q</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>h</mi><mo lspace="0.170em" rspace="0em">​</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mi>h</mi><msqrt><mi>η</mi></msqrt></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mi>J</mi></msup></mrow><mo>+</mo><mrow><msup><mi>h</mi><mn>3</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msup><mi>h</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Λ</mi><mi>J</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>K</mi><mo>−</mo><mn>1</mn></mrow></msup></mrow></mrow><mo rspace="0.170em" stretchy="false">}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leqslant C\Lambda_{J}\sqrt{d+q}\,\Bigl\{B_{J,q}h\,\Bigl(\frac{h}{\sqrt{\eta}}\Bigr)^{J}+h^{3}\,(h^{2}\Lambda_{J})^{K-1}\Bigr\}\,,</annotation></semantics></math></td>
