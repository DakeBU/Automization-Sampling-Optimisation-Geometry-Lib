                  s))
              u)
            v)
          v ∧
      ((fderiv ℝ
              (fderiv ℝ
                ((fun s u =>
                    ‖u‖ ^ 2 / 2 + (fun s u => V (p s + √(eta s) • u) - V (p s) - √(eta s) * ⟪gradient V (p s), u⟫) s u)
                  s))
              u)
            v)
          v ≤
        (1 + eta s) * ‖v‖ ^ 2
hlaw :
  (fun s =>
        Measure.map (fun x => (√(eta s))⁻¹ • (x - p s))
          ((fun s => (ℙ.tilted fun x => -V x).tilted fun x => -‖x - y s‖ ^ 2 / (2 * eta s)) s))
      s =
    ℙ.tilted fun u =>
      -(fun s u => ‖u‖ ^ 2 / 2 + (fun s u => V (p s + √(eta s) • u) - V (p s) - √(eta s) * ⟪gradient V (p s), u⟫) s u) s
          u
_hrest :
  IsProbabilityMeasure
      ((fun s =>
          Measure.map (fun x => (√(eta s))⁻¹ • (x - p s))
            ((fun s => (ℙ.tilted fun x => -V x).tilted fun x => -‖x - y s‖ ^ 2 / (2 * eta s)) s))
        s) ∧
    MemLp id 2
        ((fun s =>
            Measure.map (fun x => (√(eta s))⁻¹ • (x - p s))
              ((fun s => (ℙ.tilted fun x => -V x).tilted fun x => -‖x - y s‖ ^ 2 / (2 * eta s)) s))
          s) ∧
      Integrable (fun u => ‖u‖ ^ 2)
          ((fun s =>
              Measure.map (fun x => (√(eta s))⁻¹ • (x - p s))
                ((fun s => (ℙ.tilted fun x => -V x).tilted fun x => -‖x - y s‖ ^ 2 / (2 * eta s)) s))
            s) ∧
        ∫ (u : E),
              ‖u‖ ^
                2 ∂(fun s =>
                  Measure.map (fun x => (√(eta s))⁻¹ • (x - p s))
                    ((fun s => (ℙ.tilted fun x => -V x).tilted fun x => -‖x - y s‖ ^ 2 / (2 * eta s)) s))
                s ≤
            ↑(Module.finrank ℝ E) ∧
          MemLp (gradient ((fun s u => V (p s + √(eta s) • u) - V (p s) - √(eta s) * ⟪gradient V (p s), u⟫) s)) 2
              ((fun s =>
                  Measure.map (fun x => (√(eta s))⁻¹ • (x - p s))
                    ((fun s => (ℙ.tilted fun x => -V x).tilted fun x => -‖x - y s‖ ^ 2 / (2 * eta s)) s))
                s) ∧
            ∫ (u : E),
                  ‖gradient ((fun s u => V (p s + √(eta s) • u) - V (p s) - √(eta s) * ⟪gradient V (p s), u⟫) s) u‖ ^
                    2 ∂(fun s =>
                      Measure.map (fun x => (√(eta s))⁻¹ • (x - p s))
                        ((fun s => (ℙ.tilted fun x => -V x).tilted fun x => -‖x - y s‖ ^ 2 / (2 * eta s)) s))
                    s ≤
                eta s ^ 2 *
                  ∫ (u : E),
                    ‖u‖ ^
                      2 ∂(fun s =>
                        Measure.map (fun x => (√(eta s))⁻¹ • (x - p s))
                          ((fun s => (ℙ.tilted fun x => -V x).tilted fun x => -‖x - y s‖ ^ 2 / (2 * eta s)) s))
                      s ∧
              ∫ (u : E),
                  ‖gradient ((fun s u => V (p s + √(eta s) • u) - V (p s) - √(eta s) * ⟪gradient V (p s), u⟫) s) u‖ ^
                    2 ∂(fun s =>
                      Measure.map (fun x => (√(eta s))⁻¹ • (x - p s))
                        ((fun s => (ℙ.tilted fun x => -V x).tilted fun x => -‖x - y s‖ ^ 2 / (2 * eta s)) s))
                    s ≤
                eta s ^ 2 * ↑(Module.finrank ℝ E)
hρzero : rho s 0 = 0
L : ℝ≥0 := ⟨eta s, ⋯⟩
hHρ : ∀ (u v : E), 0 ≤ ((fderiv ℝ (fderiv ℝ (rho s)) u) v) v ∧ ((fderiv ℝ (fderiv ℝ (rho s)) u) v) v ≤ ↑L * ‖v‖ ^ 2
