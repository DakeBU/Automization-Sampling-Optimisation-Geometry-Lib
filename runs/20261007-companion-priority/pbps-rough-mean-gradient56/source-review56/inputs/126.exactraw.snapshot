<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex18.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}\Bigl[f(Y_{-})\,\Bigl\{\frac{1}{2}\nabla V(X)-\frac{y-Y_{-}}{4\eta}\Bigr\}\,\Bigm|\,Y_{+}=y\Bigr]-\mathrm{Cov}(f(Y_{-}),\nabla V(X)\mid Y_{+}=y)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mo>−</mo></msub><mo rspace="0.150em" stretchy="false">)</mo></mrow><mrow><mo maxsize="0.900em" minsize="0.900em">{</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>y</mi><mo>−</mo><msub><mi>Y</mi><mo>−</mo></msub></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>η</mi></mrow></mfrac></mstyle><mo maxsize="0.900em" minsize="0.900em" rspace="0.150em">}</mo></mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.317em" stretchy="true">|</mo><msub><mi>Y</mi><mo>+</mo></msub><mo>=</mo><mi>y</mi><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo>−</mo><mi>Cov</mi><mrow><mo stretchy="false">(</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mo>−</mo></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mo rspace="0.167em">∇</mo><mi>V</mi><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>Y</mi><mo>+</mo></msub><mo>=</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}\Bigl[f(Y_{-})\,\Bigl\{\frac{1}{2}\nabla V(X)-\frac{y-Y_{-}}{4\eta}\Bigr\}\,\Bigm|\,Y_{+}=y\Bigr]-\mathrm{Cov}(f(Y_{-}),\nabla V(X)\mid Y_{+}=y)</annotation></semantics></math></td>
