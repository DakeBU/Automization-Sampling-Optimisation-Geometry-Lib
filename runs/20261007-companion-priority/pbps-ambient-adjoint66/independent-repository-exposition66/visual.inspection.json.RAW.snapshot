        "targetText": "4. Identify actual joint mean with the transported constantPull the ν-almost-everywhere constant q back by the actual measure-preserving second coordinate. Thus i q_P is exactly the constant-one L²(J) class, and its pairing is the Bochner integral of every joint L² observable. No representative or integrability assumption is added.iqP=1J-a.e.,⟨iqP,g⟩=∫gdJ.Corresponding Lean step  let hp : MeasurePreserving (Prod.snd : E × E → E) J ν := ⟨measurable_snd,rfl⟩\n  let M : Lp ℝ 2 ν →ₗᵢ[ℝ] Lp ℝ 2 J := Lp.compMeasurePreservingₗᵢ ℝ Prod.snd hp\n  have hqOne : (qP : Lp ℝ 2 J)=\n      AutoSamplingTheory.TechnicalLemmas.Measure.L2Expectation.one J := by\n    rw [show (qP : Lp ℝ 2 J)=M q from he q]\n    apply Lp.ext\n    have hqaPull : (fun z : E × E => q z.2)=ᵐ[J] (fun _ => (1 : ℝ)) :=\n      hp.quasiMeasure",
