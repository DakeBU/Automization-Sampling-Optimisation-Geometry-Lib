          "formula": "m\\operatorname{Var}_\\mu(f_a)\\le\\int\\|\\nabla f_a\\|^2d\\mu.",
          "lean": "GibbsC1Poincare.gibbs_c1_variance_poincare"
        },
        {
          "title": "Preserve exact normalization",
