                          have n := 2 * q + 1;
                          have θ := fun i => (↑↑i + 1 / 2) * Real.pi / ↑d;
                          have eigenvalue := fun i => (κ + 1) / 2 + (κ - 1) / 2 * Real.cos (θ i);
                          have Λ := Matrix.diagonal eigenvalue;
                          have μ := multivariateGaussian 0 Λ⁻¹;
                          have Q := fun x => ∑ i, Real.cos (↑n * θ i) * x.ofLp i ^ 2;
                          have τ :=
                            C * ((↑q + 1) * √(Real.log ↑d / ↑d) + (↑q + 1) * (↑q + 1 + Real.log ↑d) * Real.log ↑d / ↑d);
                          have M := ∫ (x : EuclideanSpace ℝ (Fin d)), ‖x‖ ^ 2 ∂μ;
                          have b := ∫ (x : EuclideanSpace ℝ (Fin d)), Q x ∂μ;
                          have β := |b| / M;
                          0 ≤ τ ∧ τ ≤ 1 / 2 ∧ τ ≤ β / 4
