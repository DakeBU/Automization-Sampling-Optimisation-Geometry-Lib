    {
      "id": "M-OSUM-INNER",
      "kind": "PINNED_API_DECLARATION",
      "statement": "open scoped InnerProductSpace in\nprotected theorem sum_repr' (b : OrthonormalBasis ι 𝕜 E) (x : E) : ∑ i, ⟪b i, x⟫_𝕜 • b i = x := by\n  nth_rw 2 [← (b.sum_repr x)]\n  simp_rw [b.repr_apply_apply x]\n",
