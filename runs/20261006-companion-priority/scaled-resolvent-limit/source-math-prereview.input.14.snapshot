  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.ExampleCases.ProximalBPS.ConditionalCenteredResolventLimit.conditional_centered_resolvent_sequence",
      "title": "Actual reflected conditional centered residual limit",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06905v1#A3.SS1",
          "label": "PBPS AppC1 omitted-background analytic prerequisite",
          "scope": "Fix real complete Hilbert H,K and SAME actual closed partial linear D before forcing f, positive epsilon sequence->0 and actual variational solutions u_n. H separable explicitly; actual finite-dimensional Borel Gibbs E gives genuine scalar L2 separability by countably generated finite measure, not finite-dimensional L2. Actual energy/scaled domain, Riesz WeakDual sequential compactness, WithLp2 genuine graph double-orthogonal and forcing orthogonal to EVERY kernel give strong epsilon*u_n->0 and epsilon*D(u_n)->0 without Poincare or uniform unscaled u. True C1 Gibbs W/positive exponential normalizer/actual normalized probability and SAME exact original compact-smooth closable gradient beforeALLf; genuine mean-zero L2 forcing is integrable and kernel-orthogonal via actual AEconstant. Construct actual positive-epsilon variational solutions, retaining ordinary localL1/weakC1 test integrabilities. Actual common PBPS J/R/S/reflected law/sourceC2 alpha-beta/eta cap/positive partitions and originalD_y beforeALLf/epsilon; fiberwise only. No epsilon0 solution/range/unscaled uniform bound/extra spatial moment/supplied weak-limit or graph or residual certificate/Poincare/BL/core/adjoint/jointselector/normalized conditional-score derivative/both main/composition; TV never transfers unbounded expectedcost."
        }
      ],
      "tests": [
        "lake build Tests.ScaledResolventLimit"
      ],
      "assumptions": [
        "Source V C2, NNReal0<alpha<=beta and actual allpoint/allvector alphaI<=HessV<=betaI; eta>0,beta*eta<=1. Full finite-dimensional real Hilbert/Borel E including0.",
        "Actual common Gaussian J=(x,x+sqrteta*xi)#(mu*Gamma), Markov/disintegrating R and actual reflected S_y=(2x-y)#R_y. W_y(u)=V((y+u)/2)+norm(u-y)^2/(8eta), exact normalized reflected density and positive integrable partition. SAME original dense closable compact-smooth gradient D_y chosen BEFORE ALL meanzero L2 forcing f and epsilon sequences.",
        "Mean-zero forcing is with respect to actual S_y; real variational solutions and scaled residual limit are constructed fiberwise. No identification of auxiliary conditional versions, jointly measurable solution selector, or normalized score derivative."
      ],
      "statement": "Construct true common Gaussian/disintegrating/reflected J/R/S and one original dense closable D_y before ALL centered forcing/epsilon sequences. Construct true same-domain variational solutions on actual S_y with strong epsilon_n*u_n zero limit, retaining source curvature/eta cap/partition/order.",
      "formula": "S_y=(2x-y)_\\#R_y=Z_y^{-1}e^{-W_y}du,\\quad W_y(u)=V((y+u)/2)+\\|u-y\\|^2/(8\\eta),\\quad\\int f\\,dS_y=0\\Longrightarrow\\varepsilon_nu_n\\to0\\text{ in }L^2(S_y).",
      "boundary": "Fix real complete Hilbert H,K and SAME actual closed partial linear D before forcing f, positive epsilon sequence->0 and actual variational solutions u_n. H separable explicitly; actual finite-dimensional Borel Gibbs E gives genuine scalar L2 separability by countably generated finite measure, not finite-dimensional L2. Actual energy/scaled domain, Riesz WeakDual sequential compactness, WithLp2 genuine graph double-orthogonal and forcing orthogonal to EVERY kernel give strong epsilon*u_n->0 and epsilon*D(u_n)->0 without Poincare or uniform unscaled u. True C1 Gibbs W/positive exponential normalizer/actual normalized probability and SAME exact original compact-smooth closable gradient beforeALLf; genuine mean-zero L2 forcing is integrable and kernel-orthogonal via actual AEconstant. Construct actual positive-epsilon variational solutions, retaining ordinary localL1/weakC1 test integrabilities. Actual common PBPS J/R/S/reflected law/sourceC2 alpha-beta/eta cap/positive partitions and originalD_y beforeALLf/epsilon; fiberwise only. No epsilon0 solution/range/unscaled uniform bound/extra spatial moment/supplied weak-limit or graph or residual certificate/Poincare/BL/core/adjoint/jointselector/normalized conditional-score derivative/both main/composition; TV never transfers unbounded expectedcost.",
      "steps": [
        {
          "title": "Keep the actual common law and original domain order",
          "text": "Accepted ConditionalScoreClosedDomain constructs common Gaussian J/R/S, disintegration/reflection, true C2 W_y/positive partition and original dense/closable/exact D_y before every centered forcing or epsilon query. Source curvature/eta cap retained.",
          "formula": "J=(x,x+\\sqrt\\eta\\xi)_\\#(\\mu\\otimes\\Gamma),\\quad S_y=(2x-y)_\\#R_y.",
          "lean": "ConditionalScoreClosedDomain.conditional_score_closed_gradient_domain"
        },
        {
          "title": "Transfer by literal actual density only",
          "text": "Use exact S_y=volume.tilted(-W_y) to rewrite the shared Gibbs prerequisite onto this SAME conditional law and SAME D_y. No auxiliary R2=R or alternate-operator identification is used.",
          "formula": "S_y=Z_y^{-1}e^{-W_y}du.",
          "lean": "CenteredGibbsResolventLimit.gibbs_centered_resolvent_sequence; conditional_centered_resolvent_sequence"
        },
        {
          "title": "Produce real conditional solutions and normzero",
          "text": "For every true centered L2 forcing and every positive epsilon sequence->0, the shared actual producer gives same-domain u_n, all variational equations and the strong scaled residual limit. This supplies a later actual centered-domain Poincare node; that node/score variance/BL/main remain open.",
          "formula": "\\forall f:\\ \\int f\\,dS_y=0\\Longrightarrow\\exists u_n\\in\\operatorname{dom}\\overline D_y:\\ \\varepsilon_nu_n\\to0.",
          "lean": "conditional_centered_resolvent_sequence; Tests.ScaledResolventLimit.actual_nonquadratic_centered_resolvent"
        }
      ],
      "lean_statement": "Construct true common Gaussian/disintegrating/reflected J/R/S and one original dense closable D_y before ALL centered forcing/epsilon sequences. Construct true same-domain variational solutions on actual S_y with strong epsilon_n*u_n zero limit, retaining source curvature/eta cap/partition/order.",
      "lean_proof": "Keep the actual common law and original domain order; Transfer by literal actual density only; Produce real conditional solutions and normzero",
      "astis_dependencies": [
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.CenteredGibbsResolventLimit.gibbs_centered_resolvent_sequence",
        "AutoSamplingTheory.ExampleCases.ProximalBPS.ConditionalScoreClosedDomain.conditional_score_closed_gradient_domain"
      ],
      "mathlib_dependencies": []
    }
  ]
