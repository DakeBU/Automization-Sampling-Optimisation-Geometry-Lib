∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E] [inst_2 : CompleteSpace E]
  [inst_3 : FiniteDimensional ℝ E] [inst_4 : MeasurableSpace E] [inst_5 : BorelSpace E] {rho : E → ℝ} {L : ℝ≥0},
  ContDiff ℝ 2 rho →
    rho 0 = 0 →
      gradient rho 0 = 0 →
        (∀ (u v : E), 0 ≤ ((fderiv ℝ (fderiv ℝ rho) u) v) v ∧ ((fderiv ℝ (fderiv ℝ rho) u) v) v ≤ ↑L * ‖v‖ ^ 2) →
