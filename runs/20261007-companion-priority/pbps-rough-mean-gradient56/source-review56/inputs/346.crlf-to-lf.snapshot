{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent source topology review56 v1",
  "type": "object",
  "required": ["schema_version", "artifact_kind", "reviewer", "verdict", "statement_verdict", "coverage", "blockers", "minimal_edge_repair", "negative_chronology", "input_verification", "sourcegraph_admission", "proof_admission", "self_hash_recipe", "content_self_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "independent-source-topology-review"},
    "reviewer": {"type": "string"},
    "verdict": {"const": "SOURCE_TOPOLOGY_BLOCKED_MISSING_INPUT_EDGES"},
    "statement_verdict": {"const": "ACCEPT_SCOPED_STATEMENT_ONLY_UNCHANGED"},
    "coverage": {"type": "object", "required": ["inventory", "covered", "excluded", "target_slots", "parent_slots", "source_nodes"]},
    "blockers": {"type": "array", "minItems": 2, "maxItems": 2},
    "minimal_edge_repair": {"type": "object"},
    "negative_chronology": {"type": "object"},
    "input_verification": {"type": "object"},
    "sourcegraph_admission": {"const": false},
    "proof_admission": {"const": false},
    "self_hash_recipe": {"type": "object"},
    "content_self_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
