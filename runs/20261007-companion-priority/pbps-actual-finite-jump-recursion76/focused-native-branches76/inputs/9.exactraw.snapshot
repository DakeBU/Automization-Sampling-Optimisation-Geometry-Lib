        ],
        "header_literal": "(hαβ : α ≤ β)",
        "id": "hαβ",
        "source_items": [
          "S1.p1.m4"
        ],
        "statement": "α ≤ β"
      },
      {
        "header_RAW_range": [
          1019,
          1042
        ],
        "header_literal": "(hV : ContDiff ℝ 2 V)",
        "id": "hV",
        "source_items": [
          "S1.p1.m3"
        ],
        "statement": "V ∈ C² on the whole finite-dimensional real inner-product space"
      },
      {
        "header_RAW_range": [
          1047,
          1208
        ],
        "header_literal": "(hH : ∀ x v : E,\n      (α : ℝ) * ‖v‖ ^ 2 ≤ (fderiv ℝ (fderiv ℝ V) x v) v ∧\n      (fderiv ℝ (fderiv ℝ V) x v) v ≤ (β : ℝ) * ‖v‖ ^ 2)",
        "id": "hH",
        "source_items": [
          "S1.E1.m1"
        ],
        "statement": "For every x and v, α * ‖v‖² ≤ inner (Hess V x v) v and inner (Hess V x v) v ≤ β * ‖v‖²"
      },
      {
        "header_RAW_range": [
          1213,
          1227
        ],
        "header_literal": "(hη : 0 < η)",
        "id": "hη",
        "source_items": [
          "S2.SS2.p1.m1"
        ],
        "statement": "0 < η"
      },
      {
        "header_RAW_range": [
          1228,
          1259
        ],
        "header_literal": "(hβη : (β : ℝ) * η ≤ 1)",
        "id": "hβη",
        "source_items": [
          "S2.SS2.p1.m1"
        ],
        "statement": "β * η ≤ 1"
      }
    ],
    "conclusion_groups": [
      {
        "header_RAW_range": [
          3508,
          3627
        ],
        "id": "C01",
        "literal": "    (∀ y xRef : E, ∀ z₀ : E × E, ∀ e : ℕ → ℝ≥0,\n      record y xRef z₀ e 0 = Sum.inl (0, z₀)) ∧\n",
        "title": "Base"
      },
      {
        "header_RAW_range": [
          3627,
          4173
        ],
        "id": "C02",
        "literal": "    (∀ y xRef : E, ∀ z₀ : E × E, ∀ e : ℕ → ℝ≥0, ∀ n : ℕ,\n      record y xRef z₀ e (n + 1) = next y xRef (e n) (record y xRef z₀ e n) ∧\n      (∀ a : ℝ≥0 × (E × E), record y xRef z₀ e n = Sum.inl a →\n        (record y xRef z₀ e (n + 1) = Sum.inr () ↔ τ y xRef a.2 (e n) = ⊤) ∧\n        (τ y xRef a.2 (e n) ≠ ⊤ → record y xRef z₀ e (n + 1) =\n          Sum.inl (a.1 + (τ y xRef a.2 (e n)).untopD 0,\n            S xRef (Φ y xRef (((τ y xRef a.2 (e n)).untopD 0 : ℝ≥0) : ℝ) a.2))))) ∧\n",
        "title": "Recursion and finite/top update"
      },
      {
        "header_RAW_range": [
          4173,
          4296
        ],
        "id": "C03",
        "literal": "    Measurable (fun a : (E × E) × ℝ≥0 × ((ℝ≥0 × (E × E)) ⊕ Unit) =>\n      next a.1.1 a.1.2 a.2.1 a.2.2) ∧\n",
        "title": "Joint Borel next"
      },
      {
        "header_RAW_range": [
          4296,
          4424
        ],
        "id": "C04",
        "literal": "    (∀ n : ℕ, Measurable (fun a : (E × E) × (E × E) × (ℕ → ℝ≥0) =>\n      record a.1.1 a.1.2 a.2.1 a.2.2 n)) ∧\n",
        "title": "Joint Borel finite record"
      },
      {
        "header_RAW_range": [
          4424,
          4555
        ],
        "id": "C05",
        "literal": "    (∀ n : ℕ, Measurable (fun a : (E × E) × (E × E) × (ℕ → ℝ≥0) =>\n      eventTime a.1.1 a.1.2 a.2.1 a.2.2 n)) ∧\n",
        "title": "Joint Borel event time"
      },
      {
        "header_RAW_range": [
          4555,
          4700
        ],
        "id": "C06",
        "literal": "    (∀ y xRef : E, ∀ z₀ : E × E, ∀ e : ℕ → ℝ≥0,\n      eventTime y xRef z₀ e 0 = 0 ∧ Monotone (eventTime y xRef z₀ e)) ∧\n",
        "title": "Initial and monotone event times"
      },
      {
        "header_RAW_range": [
          4700,
          4881
        ],
        "id": "C07",
        "literal": "    (∀ y xRef : E, ∀ z₀ : E × E, ∀ e : ℕ → ℝ≥0, ∀ n k : ℕ,\n      record y xRef z₀ e n = Sum.inr () →\n        record y xRef z₀ e (n + k) = Sum.inr ()) ∧\n",
        "title": "Absorbing stop"
      },
      {
        "header_RAW_range": [
          4881,
          5337
        ],
        "id": "C08",
        "literal": "    (∀ y xRef : E, ∀ z₀ : E × E, ∀ e : ℕ → ℝ≥0, ∀ n : ℕ,\n      ∀ a : ℝ≥0 × (E × E), record y xRef z₀ e n = Sum.inl a →\n        H y xRef a.2 = H y xRef z₀ ∧\n        ∀ t : ℝ≥0, (t : WithTop ℝ≥0) < τ y xRef a.2 (e n) →\n          H y xRef (Φ y xRef (t : ℝ) a.2) = H y xRef z₀ ∧\n          0 ≤ rate xRef (Φ y xRef (t : ℝ) a.2) ∧\n          rate xRef (Φ y xRef (t : ℝ) a.2) ≤ C y xRef z₀) ∧\n",
        "title": "Same original energy and outgoing arc cap"
      },
      {
        "header_RAW_range": [
          5337,
          5821
        ],
        "id": "C09",
        "literal": "    (∀ y xRef : E, ∀ z₀ : E × E, ∀ e : ℕ → ℝ≥0,\n      0 ≤ C y xRef z₀ ∧\n      (0 < C y xRef z₀ → ∀ n : ℕ,\n        eventTime y xRef z₀ e n +\n          (Real.toNNReal ((e n : ℝ) / C y xRef z₀) : WithTop ℝ≥0) ≤\n        eventTime y xRef z₀ e (n + 1)) ∧\n      (C y xRef z₀ = 0 → ∀ n : ℕ, ∀ a : ℝ≥0 × (E × E),\n        record y xRef z₀ e n = Sum.inl a → 0 < e n →\n          record y xRef z₀ e (n + 1) = Sum.inr ())) ∧\n",
        "title": "Uniform extended time increment and zero cap"
      },
      {
        "header_RAW_range": [
          5821,
          6172
        ],
        "id": "C10",
        "literal": "    (∀ y xRef : E, ∀ z₀ : E × E, ∀ e : ℕ → ℝ≥0, ∀ n : ℕ,\n      ∀ a : ℝ≥0 × (E × E), record y xRef z₀ e n = Sum.inl a →\n        (e n = 0 → record y xRef z₀ e (n + 1) = Sum.inl (a.1, S xRef a.2)) ∧\n        (∀ b : ℝ≥0 × (E × E), 0 < e n →\n          record y xRef z₀ e (n + 1) = Sum.inl b → a.1 < b.1))",
        "title": "Zero threshold and conditional strict growth"
      }
    ],
    "counts": {
      "callers": 6,
      "conclusion_groups": 10,
      "literal_definitions": 11,
      "typing": 5
    },
    "data_quantifiers": {
      "arc_variable": "t:NNReal or finite real t with t≥0; outgoing arc interpretation restricted to 0≤t<τ",
      "fixed_analytic_data": "E,V,α,β,η with original six callers and five typing classes",
      "joint_variables": "y,xRef:E; z0:E×E; e:Nat→NNReal; n:Nat",
      "legal_degenerate_cases": [
        "rank(E)=0",
        "α*η=1",
        "H(z0)=0",
        "C0=0",
        "e_n=0",
        "τ=∞"
      ]
    },
    "literal_definitions": [
      {
        "header_RAW_range": [
          1270,
          1340
        ],
        "id": "D01",
        "literal": "    let c : E → E → E := fun y xRef => y - η • gradient V xRef\n",
        "name": "c"
      },
      {
        "header_RAW_range": [
          1340,
          1594
        ],
        "id": "D02",
        "literal": "    let Φ : E → E → ℝ → (E × E) → (E × E) := fun y xRef t z =>\n      (c y xRef + Real.cos t • (z.1 - c y xRef) +\n          (Real.sqrt η * Real.sin t) • z.2,\n       (-Real.sin t / Real.sqrt η) • (z.1 - c y xRef) + Real.cos t • z.2)\n",
        "name": "Φ"
      },
      {
        "header_RAW_range": [
          1594,
          1817
        ],
        "id": "D03",
        "literal": "    let S : E → (E × E) → (E × E) := fun xRef z =>\n      (z.1, z.2 - (2 * inner ℝ z.2 (gradient V z.1 - gradient V xRef) /\n        ‖gradient V z.1 - gradient V xRef‖ ^ 2) • (gradient V z.1 - gradient V xRef))\n",
        "name": "S"
      },
      {
        "header_RAW_range": [
          1817,
          1950
        ],
        "id": "D04",
        "literal": "    let rate : E → (E × E) → ℝ := fun xRef z =>\n      Real.sqrt η * max 0 (inner ℝ z.2 (gradient V z.1 - gradient V xRef))\n",
        "name": "rate"
      },
      {
        "header_RAW_range": [
          1950,
          2073
        ],
        "id": "D05",
        "literal": "    let H : E → E → (E × E) → ℝ := fun y xRef z =>\n      (η⁻¹ * ‖z.1 - c y xRef‖ ^ 2 + ‖z.2‖ ^ 2) / 2\n",
        "name": "H"
      },
      {
        "header_RAW_range": [
          2073,
          2262
        ],
        "id": "D06",
        "literal": "    let C : E → E → (E × E) → ℝ := fun y xRef z =>\n      Real.sqrt η * (β : ℝ) * Real.sqrt (2 * H y xRef z) *\n        (Real.sqrt (2 * η * H y xRef z) + ‖c y xRef - xRef‖)\n",
        "name": "C"
      },
      {
        "header_RAW_range": [
          2262,
          2400
        ],
        "id": "D07",
        "literal": "    let Λ : E → E → (E × E) → ℝ≥0 → ℝ := fun y xRef z t =>\n      ∫ s in (0 : ℝ)..(t : ℝ), rate xRef (Φ y xRef s z)\n",
        "name": "Λ"
      },
      {
        "header_RAW_range": [
          2400,
          2689
        ],
        "id": "D08",
        "literal": "    let τ : E → E → (E × E) → ℝ≥0 → WithTop ℝ≥0 := fun y xRef z e =>\n      MeasureTheory.hittingAfter\n        (fun t : ℝ≥0 => fun a : (E × E) × (E × E) × ℝ≥0 =>\n          Λ a.1.1 a.1.2 a.2.1 t - (a.2.2 : ℝ))\n        (Set.Ici (0 : ℝ)) 0 ((y, xRef), z, e)\n",
        "name": "τ"
      },
      {
        "header_RAW_range": [
          2689,
          3089
        ],
        "id": "D09",
        "literal": "    let next : E → E → ℝ≥0 → ((ℝ≥0 × (E × E)) ⊕ Unit) →\n        ((ℝ≥0 × (E × E)) ⊕ Unit) := fun y xRef e r =>\n      match r with\n      | Sum.inr _ => Sum.inr ()\n      | Sum.inl a =>\n        if τ y xRef a.2 e = ⊤ then Sum.inr () else\n          Sum.inl (a.1 + (τ y xRef a.2 e).untopD 0,\n            S xRef (Φ y xRef (((τ y xRef a.2 e).untopD 0 : ℝ≥0) : ℝ) a.2))\n",
        "name": "next"
      },
      {
        "header_RAW_range": [
          3089,
          3297
        ],
        "id": "D10",
        "literal": "    let record : E → E → (E × E) → (ℕ → ℝ≥0) → ℕ →\n        ((ℝ≥0 × (E × E)) ⊕ Unit) := fun y xRef z₀ e n =>\n      Nat.rec (Sum.inl (0, z₀)) (fun k r => next y xRef (e k) r) n\n",
        "name": "record"
      },
      {
        "header_RAW_range": [
          3297,
          3508
        ],
        "id": "D11",
        "literal": "    let eventTime : E → E → (E × E) → (ℕ → ℝ≥0) → ℕ → WithTop ℝ≥0 :=\n      fun y xRef z₀ e n => (record y xRef z₀ e n).elim\n        (fun a => (a.1 : WithTop ℝ≥0)) (fun _ => ⊤)\n",
        "name": "eventTime"
      }
    ],
