        "literal_text": "\\mathsf{T}=\\begin{pmatrix}\\mathsf{T}_{\\mathsf{P}\\mathsf{P}}&\\mathsf{T}_{\\mathsf{P}\\perp}\\\\ \\mathsf{T}_{\\perp\\mathsf{P}}&\\mathsf{T}_{\\perp\\perp}\\end{pmatrix}\\,,\\hskip 20.00003pt\\begin{aligned} \\mathsf{T}_{\\mathsf{P}\\mathsf{P}}&\\coloneqq\\mathsf{P}\\mathsf{T}\\mathsf{P}\\,,&\\mathsf{T}_{\\mathsf{P}\\perp}&\\coloneqq\\mathsf{P}\\mathsf{T}\\mathsf{P}^{\\perp}\\,,\\\\ \\mathsf{T}_{\\perp\\mathsf{P}}&\\coloneqq\\mathsf{P}^{\\perp}\\mathsf{T}\\mathsf{P}\\,,&\\mathsf{T}_{\\perp\\perp}&\\coloneqq\\mathsf{P}^{\\perp}\\mathsf{T}\\mathsf{P}^{\\perp}\\,.\\end{aligned} (B.3)",
