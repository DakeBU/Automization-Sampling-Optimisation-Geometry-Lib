      "source_raw_fragment": "<p id=\"A2.Thmtheorem1.p2.1\" class=\"ltx_p\"><span id=\"A2.Thmtheorem1.p2.1.1\" class=\"ltx_text ltx_font_italic\">(1) For every <math id=\"A2.Thmtheorem1.p2.m1\" class=\"ltx_Math\" alttext=\"f\\in L^{2}(\\pi_{\\eta}^{Y})\" display=\"inline\" intent=\":literal\"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><msup><mi>L</mi><mn>2</mn></msup><mo lspace=\"0em\" rspace=\"0em\">​</mo><mrow><mo stretchy=\"false\">(</mo><msubsup><mi>π</mi><mi>η</mi><mi>Y</mi></msubsup><mo stretchy=\"false\">)</mo></mrow></mrow></mrow><annotation encoding=\"application/x-tex\">f\\in L^{2}(\\pi_{\\eta}^{Y})</annotation></semantics></math>,\n<math id=\"A2.Thmtheorem1.p2.m2\" class=\"ltx_Math\" alttext=\"\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}f\\in H^{1}(\\pi_{\\eta}^{Y})\" display=\"inline\" intent=\":literal\"><semantics><mrow><mrow><msub><mi>𝖴</mi><mi>𝖯𝖯</mi></msub><mo lspace=\"0em\" rspace=\"0em\">​</mo><mi>f</mi></mrow><mo>∈</mo><mrow><msup><mi>H</mi><mn>1</mn></msup><mo lspace=\"0em\" rspace=\"0em\">​</mo><mrow><mo stretchy=\"false\">(</mo><msubsup><mi>π</mi><mi>η</mi><mi>Y</mi></msubsup><mo stretchy=\"false\">)</mo></mrow></mrow></mrow><annotation encoding=\"application/x-tex\">\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}f\\in H^{1}(\\pi_{\\eta}^{Y})</annotation></semantics></math> and</span></p>"
