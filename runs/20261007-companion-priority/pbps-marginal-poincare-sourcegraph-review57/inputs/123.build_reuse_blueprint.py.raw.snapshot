from pathlib import Path
import json,hashlib,re,datetime,sys
sys.stdout.reconfigure(encoding='utf-8')
ROOT=Path('E:/Samplinglib');O=Path(__file__).parent
def canon(v):return json.dumps(v,ensure_ascii=False,sort_keys=True,separators=(',',':')).encode()
def sha(b):return hashlib.sha256(b).hexdigest()
def pin(p):
 b=p.read_bytes();return {'path':p.relative_to(ROOT).as_posix(),'bytes':len(b),'raw_sha256':sha(b),'lf_sha256':sha(b.replace(b'\r\n',b'\n'))}
def put(name,v):
 v['content_self_sha256']=sha(canon(v));p=O/name;p.write_bytes((json.dumps(v,ensure_ascii=False,indent=2)+'\n').encode());assert json.loads(p.read_bytes())==v;return pin(p)
frozen=json.loads((O/'primary.contract.json').read_bytes());assert sha(canon({k:v for k,v in frozen.items() if k!='content_self_sha256'}))==frozen['content_self_sha256']
files=[f'AutoSamplingTheory/TechnicalLemmas/FunctionalInequalities/{n}.lean' for n in ['ClosedGraphResolvent','WeightedGradientWeak','ScaledClosedGraphResolvent','CenteredDomainPoincare','GaussianMarginalGradient','GibbsC1Poincare','GibbsLinearCovarianceUpper']]+['AutoSamplingTheory/TechnicalLemmas/Measure/GaussianConvolutionRegularity.lean']
records=[]
for file in files:
 p=ROOT/file;lines=p.read_text(encoding='utf-8').splitlines(keepends=True);headers=[];context=[]
 for i,l in enumerate(lines):
  if re.match(r'^(?:import|open |open scoped|namespace|section|noncomputable section|set_option)',l):context.append(l)
  if l.startswith('variable '):
   text=l;j=i+1
   while j<len(lines) and lines[j].strip() and lines[j][0].isspace():text+=lines[j];j+=1
   context.append(text)
  if re.match(r'^(?:theorem|lemma) ',l):
   h='';j=i
   while j<len(lines):
    h+=lines[j]
    if ':= by' in lines[j]:h=h[:h.index(':= by')];break
    j+=1
   assert j<len(lines);headers.append({'name':l.split()[1],'start_line':i+1,'proof_marker_line':j+1,'header':h})
 target=O/(p.stem+'.public-contracts.lf.snapshot.lean');target.write_text(''.join(context)+'\n'+'\n'.join(h['header'] for h in headers),encoding='utf-8',newline='\n')
 assert ':= by' not in target.read_text(encoding='utf-8')
 records.append({'source_file':pin(p),'actual_contract_snapshot':pin(target),'declarations':[{k:v for k,v in h.items() if k!='header'} for h in headers],'typing_context':'All declaration-level variable blocks retained, including finiteHilbert/Borel for WeightedGradientWeak and complete K for ScaledClosedGraphResolvent.','proof_marker_cutoff':'literal := by; let := binders retained','source_body_text_exposure':False})
