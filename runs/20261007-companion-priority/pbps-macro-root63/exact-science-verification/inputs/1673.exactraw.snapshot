          "title": "Backward interpolation turns growth into contraction",
          "statement": "Let Φ be a continuous scalar interpolation with an exact right derivative. If Φ'(u)≥rΦ(u) at every time, then reading the interpolation from s to t gives Φ(s)≤Φ(t)e^{-r(t-s)} for every s≤t.",
          "formula": "\\Phi'(u)\\ge r\\Phi(u)\\Longrightarrow \\Phi(s)\\le \\Phi(t)e^{-r(t-s)}",
          "assumptions": [
            "Φ and its supplied derivative are real-valued on the whole real line.",
            "Φ is continuous.",
            "At every u, the right derivative within [u,∞) is exactly Φ'(u).",
            "The lower differential inequality rΦ(u)≤Φ'(u) holds at every real u.",
            "The endpoints satisfy s≤t.",
            "No sign condition on Φ or r is required."
          ],
          "steps": [
            {
              "title": "Reverse the inequality by negating the curve",
              "text": "For g=-Φ, the lower growth bound becomes the upper differential inequality g'≤rg required by one-sided Grönwall.",
              "formula": "g=-\\Phi,\\qquad g'=-\\Phi'\\le-r\\Phi=rg",
              "lean": "Negate `hgrowth`; `HasDerivWithinAt.neg` supplies the exact right derivative of g."
            },
            {
              "title": "Apply one-sided Grönwall between the two endpoints",
              "text": "The comparison theorem gives -Φ(t)≤-Φ(s)e^{r(t-s)}, equivalently Φ(s)e^{r(t-s)}≤Φ(t).",
              "formula": "\\Phi(s)e^{r(t-s)}\\le\\Phi(t)",
              "lean": "Use `le_gronwallBound_of_liminf_deriv_right_le`, then `gronwallBound_ε0`."
            },
            {
              "title": "Move the exponential to the terminal side",
              "text": "Multiply by the positive inverse exponential and use e^{rΔ}e^{-rΔ}=1.",
              "formula": "\\Phi(s)\\le\\Phi(t)e^{-r(t-s)}",
              "lean": "Use `Real.exp_nonneg`, `Real.exp_add`, and exact ring normalization of the exponents."
            }
          ],
