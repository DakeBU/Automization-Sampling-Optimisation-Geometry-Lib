      }
    },
    {
      "id": "transport:metric-lift",
      "label": "Change the metric, change the gradient",
      "family_ids": [
        "family:metric-gradient-flow",
        "family:curvature-growth"
      ],
      "tails": [
        "concept:optimization"
      ],
      "heads": [
        "concept:riemannian"
      ],
      "relation_kind": "source-backed correspondence",
      "status": "not-Lean-certified",
      "formula": "df_x[\\xi]=\\langle\\operatorname{grad}f(x),\\xi\\rangle_x",
      "mechanism": "A differential is a covector; a Riemannian metric converts it to a tangent gradient. Euclidean geometry is one instance.",
      "hypothesis_map": "Replace the ambient inner product by a metric. Distinguish pullback smoothness, geodesic convexity and a retraction-based local model.",
      "conclusion_map": "Descent, PL and stationarity arguments transport only after the metric gradient and metric/retraction effects are identified.",
      "failure_boundary": "A Euclidean Hessian lower bound in arbitrary coordinates does not imply geodesic strong convexity.",
      "source_ids": [
        "opt",
        "boumal"
      ],
      "shared_stages": [
        "calculus",
        "manifold"
      ],
      "formal_refs": [],
      "category_contract": {
        "objects": "(space, metric, f, regularity) ↦ (manifold, metric, f, regularity).",
        "morphisms": "A specified solution/certificate transport; no total morphism map is claimed.",
        "identity": "Not established; not asserted to be a functor.",
        "composition": "Not established; side conditions of consecutive transports must be checked."
      }
    },
    {
      "id": "transport:gibbs-prox",
      "label": "One energy: minimizer or Gibbs law",
      "family_ids": [
        "family:proximal-energy"
      ],
      "tails": [
        "concept:optimization"
      ],
      "heads": [
        "concept:sampling"
      ],
      "relation_kind": "shared-energy span",
      "status": "not-Lean-certified",
      "formula": "\\begin{gathered}E_{y,h}(x)=g(x)+\\frac{\\|x-y\\|^2}{2h}\\\\\\operatorname{prox}_{hg}(y)\\in\\arg\\min E_{y,h}\\\\Q_{y,h}(dx)\\propto e^{-E_{y,h}(x)}dx\\end{gathered}",
      "mechanism": "Optimization selects a minimum; an RGO draws from a normalized exponential of the same energy. This is a span through a common energy, not an equivalence of outputs.",
      "hypothesis_map": "Require existence (and, when claimed, uniqueness) of the minimizer; separately require 0 < partition function < infinity. Fix temperature and quadratic scaling.",
      "conclusion_map": "Quadratic regularization, convexity and some perturbation lemmas are shared; kernel simulation and target invariance are extra.",
      "failure_boundary": "An RGO is not itself the full proximal sampler, not automatically a JKO step, and not an exact deterministic proximal map.",
      "source_ids": [
        "prox",
        "opt"
      ],
      "shared_stages": [
        "convex",
        "entropy"
      ],
      "formal_refs": [],
      "category_contract": {
        "objects": "Typed problem presentations, not field names.",
        "morphisms": "A specified solution/certificate transport; no total morphism map is claimed.",
        "identity": "Not established; not asserted to be a functor.",
        "composition": "Not established; side conditions of consecutive transports must be checked."
      }
    },
    {
      "id": "transport:dirac",
      "label": "Deterministic maps inside kernels",
      "family_ids": [],
      "tails": [
        "concept:optimization"
      ],
      "heads": [
        "concept:sampling"
      ],
      "relation_kind": "functor candidate",
      "status": "not-Lean-certified",
      "formula": "\\begin{gathered}K_T(x,\\cdot)=\\delta_{T(x)}\\\\K_{S\\circ T}=K_T K_S\\end{gathered}",
      "mechanism": "Embed a measurable update map as a deterministic probability kernel. The product denotes first T, then S.",
      "hypothesis_map": "Updates must be measurable; pin kernel composition orientation and the measurable-space contracts.",
      "conclusion_map": "Transport deterministic iteration into a special case of Markov evolution; this does not manufacture Gibbs invariance.",
      "failure_boundary": "Continuity is not a substitute for checking the actual measurable structures. Stochastic kernels are not generally deterministic maps.",
      "source_ids": [
        "kernel"
      ],
      "shared_stages": [
        "measure"
      ],
      "formal_refs": [],
      "category_contract": {
        "objects": "Measurable spaces ↦ the same spaces.",
        "morphisms": "Measurable T ↦ the Dirac kernel K_T.",
        "identity": "Target: K_id is the identity kernel; no local certificate yet.",
        "composition": "Target: K_(S∘T) = K_T K_S with the stated convention; no local certificate yet."
      }
    },
    {
      "id": "transport:wasserstein-flow",
      "label": "Energy descent on probability laws",
      "family_ids": [
        "family:metric-gradient-flow"
      ],
      "tails": [
        "concept:optimization",
        "concept:transport"
      ],
      "heads": [
        "concept:sampling"
      ],
      "relation_kind": "source-backed correspondence",
      "status": "not-Lean-certified",
      "formula": "\\begin{gathered}\\partial_t\\rho=\\nabla\\!\\cdot(\\rho\\nabla V)+\\lambda\\Delta\\rho\\\\\\mathcal F(\\rho)=\\int V\\rho+\\lambda\\int\\rho\\log\\rho\\end{gathered}",
      "mechanism": "A free energy on probability laws generates Fokker–Planck through the Wasserstein gradient-flow interpretation.",
      "hypothesis_map": "Fix Euclidean base, positive temperature, finite moments/entropy and weak solution or EDI/EVI hypotheses. Nonlinear first variations require additional contracts.",
      "conclusion_map": "Energy-dissipation proofs connect sampling evolution with optimization over measures.",
      "failure_boundary": "Formal Otto notation alone is not a proof of existence, uniqueness, SDE-law correspondence or EVI; W2 is not globally a classical smooth manifold.",
      "source_ids": [
        "ot",
        "sampling"
      ],
      "shared_stages": [
        "transport",
        "entropy",
        "flow"
      ],
      "formal_refs": [],
      "category_contract": {
        "objects": "Typed probability-law energies equipped with an explicit transport metric structure.",
        "morphisms": "A specified flow/certificate transport; formal Otto notation alone supplies no total morphism map.",
        "identity": "Not established; not asserted to be a functor.",
        "composition": "Not established; EDI/EVI and first-variation side conditions must be checked."
      }
    },
    {
      "id": "transport:metric-pl",
      "label": "Metric gradient flow: PL controls dissipation",
      "family_ids": [
        "family:metric-gradient-flow",
        "family:gap-gradient"
      ],
      "tails": [
        "concept:optimization",
        "concept:riemannian",
        "concept:transport"
      ],
      "heads": [
        "concept:sampling"
      ],
      "relation_kind": "shared dissipation template",
      "status": "not-Lean-certified",
      "formula": "\\begin{gathered}\\dot z_t=-\\operatorname{grad}_g\\mathcal E(z_t)\\\\\\frac{d}{dt}(\\mathcal E(z_t)-\\mathcal E_*)=-\\|\\operatorname{grad}_g\\mathcal E(z_t)\\|_g^2\\\\\\|\\operatorname{grad}_g\\mathcal E(z)\\|_g^2\\ge 2\\alpha(\\mathcal E(z)-\\mathcal E_*)\\end{gathered}",
      "mechanism": "The common proof skeleton is metric gradient flow plus a gap-versus-squared-gradient coercivity inequality. The scalar differential inequality then gives exponential energy-gap decay.",
      "hypothesis_map": "Identify the actual metric gradient, a valid chain rule/energy-dissipation identity, a lower energy level E_*, and flow existence. Discrete algorithms need an additional descent/local-error argument.",
      "conclusion_map": "The final Gronwall step is shared across Euclidean PL, Riemannian PL and Wasserstein PL; only the metric, energy and proof of the coercivity premise change.",
      "failure_boundary": "This template does not identify the underlying spaces or prove that a formal Wasserstein gradient exists. W2/Otto geometry requires rigorous first-variation and EDI/EVI hypotheses in infinite-dimensional settings.",
      "source_ids": [
        "opt",
        "boumal",
        "ot",
        "sampling"
      ],
      "shared_stages": [
        "calculus",
        "manifold",
        "transport",
        "flow"
      ],
      "formal_refs": [],
      "category_contract": {
        "objects": "Metric energy problems (X,g,E,E_*) carrying a justified gradient-flow/dissipation structure.",
        "morphisms": "Translations that preserve the energy/dissipation inequality and explicitly map constants; no total morphism class is defined.",
        "identity": "The scalar dissipation template is reusable, but no category-level identity law is certified.",
        "composition": "Metric and regularity side conditions must be recomputed after each transport; no composition certificate is claimed."
      }
    },
    {
      "id": "transport:curvature-growth",
      "label": "Second-order curvature → growth / PL controls",
      "family_ids": [
        "family:curvature-growth"
      ],
      "tails": [
        "concept:optimization",
        "concept:riemannian"
      ],
      "heads": [
        "concept:transport",
        "concept:sampling"
      ],
      "relation_kind": "curvature-to-coercivity pattern",
      "status": "not-Lean-certified",
      "formula": "\\begin{gathered}f(y)\\ge f(x)+\\langle\\operatorname{grad}f(x),\\log_x y\\rangle+\\frac{\\alpha}{2}d(x,y)^2\\\\\\alpha\\text{-geodesic convexity}\\Rightarrow\\text{metric PL in its valid setting}\\\\CD(\\alpha,\\infty)\\Rightarrow C_{\\mathrm{LSI}}\\le\\alpha^{-1}\\end{gathered}",
      "mechanism": "A lower-curvature or second-order control can generate a quadratic lower model and then a first-order/gap coercivity inequality. In sampling, Bakry–Émery curvature is a distinct route from strong log-concavity to LSI and exponential KL decay.",
      "hypothesis_map": "Translate the notion of curvature before translating the conclusion: Euclidean strong convexity, geodesic strong convexity, displacement/geodesic convexity on P2, and Bakry–Émery CD are different hypotheses with different regularity domains.",
      "conclusion_map": "Reuse the proof pattern 'curvature → growth/coercivity → dissipation rate', while preserving the exact source theorem at each arrow. The current strong-convex first-order SAU is a Euclidean substrate, not a proof of the other arrows.",
      "failure_boundary": "Euclidean Hessian lower bounds, Riemannian geodesic convexity, displacement convexity and Bakry–Émery curvature are not interchangeable. Strong convexity is sufficient for several PL-style controls but PL need not imply strong convexity.",
      "source_ids": [
        "opt",
        "boumal",
        "ot",
        "sampling"
      ],
      "shared_stages": [
        "convex",
        "manifold",
        "transport",
        "entropy",
        "flow"
      ],
      "formal_refs": [],
      "category_contract": {
        "objects": "A problem plus its explicit curvature notion, metric, domain and regularity.",
        "morphisms": "Only source-backed implication/adapter records; no general curvature-preserving morphism map is claimed.",
        "identity": "Not established; this is a proof-pattern family, not a certified functor.",
        "composition": "Each curvature-to-coercivity arrow keeps its own hypotheses and constants; transitive composition is never inferred from the diagram alone."
      }
    },
    {
      "id": "transport:pl-lsi",
      "label": "PL ↔ LSI mirror: gap vs metric gradient",
      "family_ids": [
        "family:gap-gradient"
      ],
      "tails": [
        "concept:optimization",
        "concept:transport"
      ],
      "heads": [
        "concept:sampling"
      ],
      "relation_kind": "functional-inequality mirror",
      "status": "not-Lean-certified",
      "formula": "\\begin{gathered}f(x)-f_*\\le\\frac{C_{\\mathrm{PL}}}{2}\\|\\nabla f(x)\\|^2\\\\\\mathrm{KL}(\\mu\\Vert\\pi)\\le\\frac{C_{\\mathrm{LSI}}}{2}\\,\\mathrm{FI}(\\mu\\Vert\\pi)\\end{gathered}",
      "mechanism": "PL bounds an optimization gap by squared gradient norm. LSI has the same gap-versus-dissipation shape for KL; in the smooth Wasserstein/Langevin picture, relative Fisher information is the squared metric-gradient norm of KL. Both close an energy-dissipation identity to exponential gap decay.",
      "hypothesis_map": "For the sampling side require the source density/absolute-continuity, finite entropy/Fisher information, reversible Langevin/semigroup calculus and normalization conventions. For the optimization side retain the exact PL constant and chosen metric.",
      "conclusion_map": "The conceptual mirror is the coercivity slot in the metric-gradient template: Euclidean/Riemannian objective gap ↔ KL gap; squared gradient norm ↔ Fisher dissipation. The scalar Gronwall conclusion is shared after each premise is separately proved.",
      "failure_boundary": "LSI is not literally the Euclidean PL theorem and need not follow from smoothness alone. Constants and factors of two depend on conventions; formal Fisher = Wasserstein-gradient-norm statements require their own analytic hypotheses.",
      "source_ids": [
        "sampling",
        "opt",
        "ot"
      ],
      "shared_stages": [
        "entropy",
        "flow"
      ],
      "formal_refs": [],
      "category_contract": {
        "objects": "Optimization or probability-law energies with a named gap and a named dissipation functional.",
        "morphisms": "A source-backed identification of the gap/dissipation slots; no theorem equivalence map is claimed.",
        "identity": "Not established; mirror language is deliberately weaker than functorial equivalence.",
        "composition": "A PL/LSI mirror cannot be composed with another bridge unless all metric, density and constant contracts match."
      }
    },
    {
      "id": "transport:pi-chi2",
      "label": "Poincaré ↔ χ²: L² PL-shaped coercivity",
      "family_ids": [
        "family:l2-coercivity"
      ],
      "tails": [
        "concept:optimization"
      ],
      "heads": [
        "concept:sampling"
      ],
      "relation_kind": "functional-inequality mirror",
      "status": "not-Lean-certified",
      "formula": "\\begin{gathered}\\chi^2(\\mu\\Vert\\pi)=\\|\\rho-1\\|_{L^2(\\pi)}^2\\\\\\operatorname{Var}_\\pi(f)\\le C_{\\mathrm{PI}}\\mathcal E(f,f)\\\\\\chi^2(\\pi_t\\Vert\\pi)\\le e^{-2t/C_{\\mathrm{PI}}}\\chi^2(\\pi_0\\Vert\\pi)\\end{gathered}",
      "mechanism": "Poincaré is a quadratic L2 coercivity inequality. For the reversible semigroup it controls the Dirichlet dissipation of the density fluctuation and yields exponential chi-square decay by the same scalar PL/Gronwall pattern.",
      "hypothesis_map": "Use the exact reversible Markov-semigroup/Dirichlet-form domain and density hypotheses from the sampling source. On the optimization side the analogy is to a quadratic gap controlled by its gradient/dissipation, not an identification of objectives.",
      "conclusion_map": "Poincaré occupies the PL-shaped coercivity slot for the chi-square/L2 gap, while LSI occupies it for KL. This gives a clean family-level comparison of convergence mechanisms.",
      "failure_boundary": "Poincaré and LSI are different functional inequalities; chi-square and KL are different gaps. PI is generally weaker than LSI, and the reversible/domain hypotheses cannot be erased by the analogy.",
      "source_ids": [
        "sampling",
        "opt"
      ],
      "shared_stages": [
        "semigroup",
        "flow"
      ],
      "formal_refs": [],
      "category_contract": {
        "objects": "A reversible semigroup together with its invariant measure, density gap and Dirichlet dissipation.",
        "morphisms": "A conceptual slot correspondence with quadratic optimization coercivity; no direct theorem transport is claimed.",
        "identity": "Not established; this is a functional-inequality mirror.",
        "composition": "Do not compose PI/chi-square with LSI/KL edges by label similarity; exact comparison theorems must be cited separately."
      }
    },
    {
      "id": "transport:entropy-sandwich",
      "label": "MFLD: entropy sandwich and PL controls",
      "family_ids": [
        "family:gap-gradient"
      ],
      "tails": [
        "concept:optimization",
        "concept:sampling"
      ],
      "heads": [
        "concept:transport"
      ],
      "relation_kind": "source-backed correspondence",
      "status": "not-Lean-certified",
      "formula": "\\begin{gathered}\\lambda\\mathrm{KL}(\\mu\\Vert\\mu_*)\\leq\\mathcal L(\\mu)-\\mathcal L(\\mu_*)\\\\\\mathcal L(\\mu)-\\mathcal L(\\mu_*)\\leq\\lambda\\mathrm{KL}(\\mu\\Vert q_\\mu)\\end{gathered}",
      "mechanism": "For a differentiable mixture-convex F, set L=F+λ Ent and q_μ proportional to exp(−δF(μ)/λ). Gibbs variational inequalities sandwich the gap.",
      "hypothesis_map": "Require a minimizer, normalizable q_μ, and the source differentiability/integrability contracts. Uniform LSI for q_μ is an EXTRA hypothesis, not a consequence of mixture convexity.",
      "conclusion_map": "LSI KL≤I/(2ρ) and dL/dt=−λ²I give a PL-type dissipation control. The lower sandwich is a KL-growth control; W2 quadratic growth additionally needs a transport-entropy inequality for μ*.",
      "failure_boundary": "Mixture convexity ≠ displacement convexity. Neither LSI nor W2 quadratic growth follows merely from an entropy term. This connects proof mechanisms, not identical geometries.",
      "source_ids": [
        "mfld",
        "ot"
      ],
      "shared_stages": [
        "convex",
        "entropy",
        "flow"
      ],
      "formal_refs": [],
      "category_contract": {
        "objects": "Typed problem presentations, not field names.",
        "morphisms": "A specified solution/certificate transport; no total morphism map is claimed.",
        "identity": "Not established; not asserted to be a functor.",
        "composition": "Not established; side conditions of consecutive transports must be checked."
      }
    },
    {
      "id": "transport:duality",
      "label": "Convex duality to transport duality",
      "family_ids": [],
      "tails": [
        "concept:optimization"
      ],
      "heads": [
        "concept:transport"
      ],
      "relation_kind": "source-backed correspondence",
      "status": "not-Lean-certified",
      "formula": "\\begin{gathered}\\inf_{\\gamma\\in\\Pi(\\mu,\\nu)}\\int c\\,d\\gamma\\\\\\longleftrightarrow\\\\\\sup_{u(x)+v(y)\\leq c(x,y)}\\left(\\int u\\,d\\mu+\\int v\\,d\\nu\\right)\\end{gathered}",
      "mechanism": "Coupling optimization and Kantorovich potentials reuse convex duality, with feasibility and topology specific to transport.",
      "hypothesis_map": "Retain the exact source hypotheses for no duality gap and attainment; noncompact spaces need extra care.",
      "conclusion_map": "Convex conjugacy and variational inequalities feed transport-map stability and entropic duals.",
      "failure_boundary": "Equality of optimal values does not by itself give optimizers, smooth potentials, a Monge map or statistical rates.",
      "source_ids": [
        "ot",
        "opt"
      ],
      "shared_stages": [
        "convex",
