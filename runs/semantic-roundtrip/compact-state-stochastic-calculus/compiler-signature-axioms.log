  (hB :
    AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.BrownianMotion.IsStandardBrownianMotionWithFiltration B
      filtration mu)
  {j k : kappa} (hjk : j ≠ k) (T : NNReal) (weight : (level : ℕ) → Fin (2 ^ level) → Omega → ℝ)
  (hAdapted : ∀ (level : ℕ) (i : Fin (2 ^ level)), MeasureTheory.StronglyMeasurable (weight level i))
  (hWeight : ∀ (level : ℕ) (i : Fin (2 ^ level)), MeasureTheory.MemLp (weight level i) 2 mu) (C : ℝ)
  (hC : ∀ (level : ℕ) (i : Fin (2 ^ level)), ∫ (omega : Omega), weight level i omega ^ 2 ∂mu ≤ C) :
