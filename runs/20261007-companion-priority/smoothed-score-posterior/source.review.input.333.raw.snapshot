<math id="S4.E8.m2" class="ltx_math_unparsed" alttext="\displaystyle\leqslant(k-1)!\,\eta^{-(k-2)/2}\,." display="inline" intent=":literal"><semantics><mrow><mo>⩽</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo rspace="0.170em">!</mo><msup><mi>η</mi><mrow><mo>−</mo><mo stretchy="false">(</mo><mi>k</mi><mo>−</mo><mn>2</mn><mo stretchy="false">)</mo><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leqslant(k-1)!\,\eta^{-(k-2)/2}\,.</annotation></semantics></math>