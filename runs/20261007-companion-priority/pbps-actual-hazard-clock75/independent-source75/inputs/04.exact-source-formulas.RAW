      ],
      "RAW_sha256": "6cffa97e8ac1d0231eaef53779b8c41bb095b358f1790af9151182ccaddc37e5",
      "credit": "Exact source formula only; not a proved Lean clause",
      "id": "S3.Ex7.m1",
      "literal_source_alttext": "\\|h_{\\widetilde{x}}(x)\\|=\\|\\nabla V(x)-\\nabla V(\\widetilde{x})\\|\\leq\\beta\\,\\|x-\\widetilde{x}\\|\\,.",
      "source_URL": "https://arxiv.org/html/2609.06905v1#S3.Ex7.m1"
    },
    {
      "LF_sha256": "e414f6370902cc5791cda78c679082dbf20edc8cf764c1e5fd6c7dfd52141bf6",
