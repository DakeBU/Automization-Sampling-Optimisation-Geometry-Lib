    {
      "title": "Combine the homogeneous entropy, including zero mass",
      "formula": "\\operatorname{Ent}_{\\mu_N}(f^2\\circ S_N)=\\int B(S_N)\\,d\\mu_N-m_N\\log m_N\\longrightarrow\\int B\\,d\\gamma-m\\log m."
    }
