      "formula": "theorem twoPointEntropyCoord_condMeanSqrt_le {n : ℕ} (j : Fin n)\n    (h : (Fin (n+1) → Bool) → ℝ) (ε' : Fin n → Bool) :\n    twoPointEntropyCoord j (condMeanSqrt h) ε' ≤\n    (twoPointEntropyCoord j (sliceTrue h) ε' + twoPointEntropyCoord j (sliceFalse h) ε') / 2",
