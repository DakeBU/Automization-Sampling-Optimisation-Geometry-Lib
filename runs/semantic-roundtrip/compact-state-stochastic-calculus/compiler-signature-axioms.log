AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.BrownianPredictableQuadraticVariationL2.predictable_weighted_quadraticVariationError_L2.{u_1}
  {Omega : Type u_1} {m : MeasurableSpace Omega} {mu : MeasureTheory.Measure Omega} {B : NNReal → Omega → ℝ}
  {filtration : MeasureTheory.Filtration NNReal m}
  (hB :
    AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.BrownianMotion.IsBrownianMotionWithFiltration B filtration
      mu)
  {n : ℕ} {times : Fin (n + 1) → NNReal} (hmono : Monotone times) (weight : Fin n → Omega → ℝ)
  (hAdapted : ∀ (i : Fin n), MeasureTheory.StronglyMeasurable (weight i))
  (hWeight : ∀ (i : Fin n), MeasureTheory.MemLp (weight i) 2 mu) :
  have error := fun omega =>
    ∑ i,
      weight i omega *
        AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.BrownianQuadraticVariation.centeredSquaredIncrement B
          times i omega;
  MeasureTheory.MemLp error 2 mu ∧
    ∫ (omega : Omega), error omega ^ 2 ∂mu =
      ∑ i, (∫ (omega : Omega), weight i omega ^ 2 ∂mu) * (2 * ↑(times i.succ - times i.castSucc) ^ 2)
END_16
