      "targetText": "6. Recover the macro norm and energy identitiesApply the scalar energy theorem to e⁻¹f and use the same isometry and A-conjugation to obtain macro energy. The adjoint inner-product identities for B and the positive selfadjoint Γ_P have equal squared norms since B*B=Γ_P²; nonnegative norms then give equality of norms.‖Bf‖=‖ΓPf‖,‖ΓPf‖2=‖f‖2−‖Af‖2(f∈HP).Corresponding Lean step  have hMacroEnergy (f : HP) : ‖ΓP f‖^2=‖f‖^2-‖A f‖^2 := by\n    have hs : ‖Γ (e.symm f)‖^2=‖e.symm f‖^2-‖T (e.symm f)‖^2 :=\n      (hEnergy (e.symm f)).trans (hDef (e.symm f))\n    simpa only [ΓP,LinearIsometryEquiv.conjStarAlgEquiv_apply_apply,hAapply,\n      e.norm_map,e.symm.norm_map] using hs\n  have hNorm (f : HP) : ‖B f‖=‖ΓP f‖ := by\n    have hb := B.apply_norm_sq_eq_inner_adjoint_right f\n    have hg := ΓP.apply_norm_s",
