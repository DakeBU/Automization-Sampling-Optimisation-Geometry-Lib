def AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.SphereCoordinateSDE.sphereNoiseIntegrand.{u_1, u_2} : {I :
    Type u_1} →
  [inst : Fintype I] →
    [DecidableEq I] →
      {Ω : Type u_2} →
        [inst_2 : MeasurableSpace Ω] →
          {filtration : MeasureTheory.Filtration NNReal inferInstance} →
            {μ : MeasureTheory.Measure Ω} →
              [MeasureTheory.IsFiniteMeasure μ] →
                (T : NNReal) →
                  (X : NNReal → Ω → ↑(Metric.sphere 0 1)) →
                    Measurable (Function.uncurry X) →
                      MeasureTheory.IsStronglyProgressive filtration X →
                        (temperature : NNReal → ℝ) →
                          Continuous temperature →
                            I →
                              I →
                                AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.ProgressiveL2.ProgressiveL2Integrand
                                  filtration μ T :=
fun {I} [Fintype I] [DecidableEq I] {Ω} [MeasurableSpace Ω] {filtration} {μ} [MeasureTheory.IsFiniteMeasure μ] T X hX
    hProgressive temperature hTemperature i j =>
  have L := fun k => PiLp.proj 2 (fun x => ℝ) k;
  let c := fun q =>
    √(2 * temperature q.1) *
      (AutoSamplingTheory.TechnicalLemmas.Geometry.SphereProjectedNoise.projectedNoiseColumn j ↑q.2).ofLp i;
  have hState := ⋯;
  have hProjected := ⋯;
  have hScale := ⋯;
  have hc := ⋯;
  have h := ⋯;
  { process := fun t ω => c (t, X t ω), progressive := ⋯, memLp := ⋯ }
END_57
