      "alttext": "\\mathsf{\\Gamma}_{\\mathsf{P}}\\mathsf{V}_{\\perp\\mathsf{P}}^{*}\\mathsf{U}_{\\perp\\perp}=-\\mathsf{\\Gamma}_{\\mathsf{P}}\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}\\mathsf{V}_{\\perp\\mathsf{P}}^{*}\\,.",
