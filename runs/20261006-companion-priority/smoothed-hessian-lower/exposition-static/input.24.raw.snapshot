  "proof_checks": [
    {
      "check": "Canonical covariance genuine domain",
      "finding": "hX actual id in L2 is explicit; hX.const_inner supplies real scalarL2. Mass1 and gradient=a yield exact energy norm², so totalized covariance outside L2 is never used."
    },
    {
      "check": "C1 PI consumer",
      "finding": "Same actual W and normalized law under BOTH m/M curvature; existing C1 producer constructs its originalD and derives Admissible integrability. No supplied PI/covariance or unrelated graph identity."
    },
    {
      "check": "Source original normalizer",
      "finding": "Source lowerκ^-1>0, C2 and genuine Hessian give exponential integrability/positive partition/probability/C2 convolution internally; no minimizer/partition premise."
    },
    {
      "check": "Gaussian posterior moments",
      "finding": "Actual μ probability and η>0 feed true convolution producer; every literal unreflected R_y has probability and idL2 by weighted Gaussian domination, without input original moments."
    },
    {
      "check": "True W_y Hessian",
      "finding": "W=V+η^-1/2 norm(x-y)²; actual first derivative η^-1 innerSL(x-y), second η^-1J, no supplied Hessian field. Genuine bounds m=κ^-1+η^-1 and M=1+η^-1."
    },
    {
      "check": "Literal tilted_tilted law",
      "finding": "Original exp(-V) integrability is supplied to Mathlib tilted_tilted, negated potential algebra uses η nonzero. W_y exponential integrability/positive partition are independently derived and idL2 transported over exact measure equality."
    },
    {
      "check": "Source U normalization",
      "finding": "Actual source unnormalized Vη=-log(C volume integral) with exact Gaussian C, source smoothed Gibbs producer gives U=Vη+logZV. fderiv_add_const transfers both true derivatives; normalizedU is never renamed sourceVη."
    },
    {
      "check": "Exact signed Hessian constants",
      "finding": "κ,η,m,κ+η positive. Covupper norm²/m subtracts with η²≥0 to give exact1/(κ+η). Existing actual reverseCR parent specialized β1 gives1/(1+η), no assumed bound or false scalar inequality."
    },
    {
      "check": "True global gradient Lipschitz",
      "finding": "Produced C2 and 0≤Hess≤I satisfy canonical QuadraticRegularization m0 L1 r0. Actual Hessian symmetry/Riesz/Rayleigh operator norm and whole-space mean value yield1-Lip including0D, with no classical Hessian or operator-norm certificate."
    },
    {
      "check": "Source η cap",
      "finding": "0<η<=1 retained literally in sealed signature. hη1 remains unused since the mathematical estimates generalize; no silent signature weakening."
    },
    {
      "check": "No circular or fake consumers",
      "finding": "Canonical PI and reverseCR branches are actual prior proof producers. NewCovUpper feeds actual W_y/R_y in new source theorem; Test exercises nonconstant potential allposteriors andE0. Production imports no Tests."
    }
  ],
