    {
      "id": "M-BSUM-REPR",
      "kind": "PINNED_API_DECLARATION",
      "statement": "theorem Basis.sum_equivFun [Fintype ι] (b : Basis ι R M) (u : M) :\n    ∑ i, b.equivFun u i • b i = u := by\n  rw [← b.equivFun_symm_apply, b.equivFun.symm_apply_apply]\n",
      "source_anchors": [
