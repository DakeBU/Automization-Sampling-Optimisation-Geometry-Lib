        "wording_status": "faithful paraphrase",
        "attribution": "Yuanhe Zhang, Jason D. Lee, Fanghui Liu. Necessary function-entropy background; SPHMC Gaussian/paper consumers remain open."
      },
      "statement": "For every signed real a,b, including zero, the homogeneous two-point entropy of their squares is at most half their squared difference.",
      "assumptions": [
        "Arbitrary a,b in real numbers; signed and zero inputs retained. No extra hypotheses."
      ],
      "formulae": [
        {
          "label": "Signed two-point square entropy upper bound",
          "tex": "\\frac{a^2\\log a^2+b^2\\log b^2}{2}-\\frac{a^2+b^2}{2}\\log\\frac{a^2+b^2}{2}\\le\\frac{(a-b)^2}{2}."
        }
      ],
