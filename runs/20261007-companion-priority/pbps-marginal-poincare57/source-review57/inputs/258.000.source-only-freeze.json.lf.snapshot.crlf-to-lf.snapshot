      "source_text": "\\displaystyle\\leq 2\\beta\\eta\\,\\|a\\|\\,\\|p\\|^{2}\\,\\|w-\\widetilde{w}\\|\\,."
    },
    {
      "region_id": "A3.SS2.p10.2",
      "anchor_container": "A3.SS2",
