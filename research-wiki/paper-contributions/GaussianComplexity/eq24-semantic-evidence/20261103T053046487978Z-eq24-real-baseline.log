info: Tests/GaussianComplexityMixtureExpectation.lean:46:0: AutoSamplingTheory.ExampleCases.GaussianComplexity.MixtureExpectation.actual_mixture_expectation_gap {n : ℕ}
  (hn : 3 ≤ n) {κ : ℝ} (hκ : 4 ≤ κ) {ℓ : ℝ} (hℓ : 0 ≤ ℓ) :
  have μ := orthogonalHaar n;
  have νpos := 2 • μ.restrict {O | (↑O).det = 1};
  have νneg := 2 • μ.restrict {O | (↑O).det = -1};
  have γ := fun O => multivariateGaussian 0 (singleBlockPrecision κ O)⁻¹;
  have t := fun x => Real.exp (-ℓ * ‖x‖ ^ 2);
  have f := fun O => ∫ (x : EuclideanSpace ℝ (Fin n)), t x ∂γ O;
  Integrable t (γ ∘ₘ νpos) ∧
    Integrable t (γ ∘ₘ νneg) ∧
      Integrable f νpos ∧
        Integrable f νneg ∧
          ∫ (x : EuclideanSpace ℝ (Fin n)), t x ∂γ ∘ₘ νpos = ∫ (O : ↥(orthogonalGroup (Fin n) ℝ)), f O ∂νpos ∧
            ∫ (x : EuclideanSpace ℝ (Fin n)), t x ∂γ ∘ₘ νneg = ∫ (O : ↥(orthogonalGroup (Fin n) ℝ)), f O ∂νneg ∧
              ∫ (x : EuclideanSpace ℝ (Fin n)), t x ∂γ ∘ₘ νpos - ∫ (x : EuclideanSpace ℝ (Fin n)), t x ∂γ ∘ₘ νneg =
                2 * ∫ (O : ↥(orthogonalGroup (Fin n) ℝ)), (↑O).det * f O ∂μ
