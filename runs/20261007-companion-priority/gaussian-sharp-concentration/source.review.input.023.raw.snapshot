  "source_scope_and_parameters": {
    "objects": {
      "domain": "finite-dimensional Euclidean R^d with ordinary real inner product and norm",
      "potential": "V∈C²(R^d), π∝exp(−V), κ=β/α",
      "literal_prox": "p_η(y)=unique global argmin_x {V(x)+‖x−y‖²/(2η)}; original definition S2.E1, reused S4.Ex3",
      "literal_oracle": "H_y(z)=∇V(p_η(y)+√ηz), original S3.E2",
      "law": "G∼γ_d=N(0,I_d), actual output law pushforward H_y#γ_d; neither R_{η,y} nor affine standardized posterior r_y",
      "mean": "m_η(y)=∫H_y(z)dγ_d(z) is the actual first Bochner expectation; construct actual integrability before using it",
      "center": "ξ_η(y;z)=H_y(z)−m_η(y). Deterministic b_η(y)=m_η(y)−g_η(y). Source zero-mean decomposition forces this centering once L1 exists.",
      "smoothed_score": "g_η=∇V_η, exp(−V_η)=exp(−V)*N(0,ηI). It is an RGO/conditional expectation and generally differs from m_η by bias."
    },
    "domains": {
      "smoothing": "η>0 inherited S3.SS1.p1.1; no analytic upper eta cap stated on Lemma4.2 sharp Gaussian-noise clause",
      "directions": "all u∈R^d; no unit-norm, bounded, positive or nonzero restriction",
      "scalar": "source printed formula has no separate scalar. Signed parametrization t∈R via u=t a, with arbitrary a∈R^d, is equivalent.",
      "endpoints": "u=0, t=0 and a=0 included. Source does not explicitly impose positive dimension in these source anchors; zero-dimensional Euclidean extension gives identity1≤1."
    },
    "quantifiers": "For every allowed V satisfying the global standing normalized assumptions, every η>0, every y∈R^d and every u∈R^d, one actual m_η(y) is fixed before varying u, and E_γ exp(⟨u,H_y−m_η(y)⟩)≤exp(η‖u‖²/2). Equivalent signed version: ∀a ∀t∈R, E_γ exp(t⟨a,H_y−m_η(y)⟩)≤exp(η t²‖a‖²/2).",
    "assumptions": {
      "standing": "V genuinely globally C²; original 0<α≤β, αI≼D²V(x)≼βI pointwise; normalized β=1 and α=κ⁻¹ with κ≥1. Original source S1.p1.1/S1.E1/S2.p1.1.",
      "local": "η>0; y,u arbitrary deterministic Euclidean vectors; integration against actual canonical standard Gaussian.",
      "ingredients_not_public_premises": [
        "proximal existence/uniqueness and measurable construction",
        "gradient1-Lipschitz derived from C² and normalized Hessian",
        "actual noise√η-Lipschitz and scalar direction√η‖a‖-Lipschitz",
        "actual Gaussian probability, vector/scalar firstL1 and integrable signed exponentials",
        "actual Bochner/scalar mean and projection/integral commutation",
        "genuine standard Gaussian concentration with exact1/2 coefficient"
      ],
      "reference_point": "S2 assumes admissible x_ref for sampling algorithm; no x_ref occurs in Lemma4.2 estimator/concentration clause, so it is irrelevant to this local observable result."
    },
    "conclusion": "Exact finite numerical exponential expectation inequality with sharp dimensionfree variance proxyη‖u‖² and coefficient1/2. Finite/domain-only expectations do not establish it. No totalized integral alone substitutes for genuine domain proof.",
    "scopes_senses": "Fixed y unconditional expectation only over the Gaussian noise in the actual gradient estimator. Source is not conditional concentration in y, posterior law concentration, invariant distribution convergence, W2/T2, bias, numerical query/cost, full Lemma4.2 or main sampler theorem.",
    "constant_dependencies": {
      "sharp_rhs": "exp(η‖u‖²/2); signed version exp(ηt²‖a‖²/2)",
      "noise_scale": "√η",
      "scalar_lipschitz_scale": "√η‖a‖",
      "dimension": "No d in numerical sharp coefficient. Radial norm envelopes may certify finiteness but cannot supply sharp dimensionfree1/2.",
      "normalized_beta": "Exact source formula uses β=1. An unnormalized bound would require independently tracked β², not silently copied source coefficient.",
      "kappa": "Retained source curvature lower bound enables actual prox; sharp numerical concentration coefficient does not depend onκ."
    }
