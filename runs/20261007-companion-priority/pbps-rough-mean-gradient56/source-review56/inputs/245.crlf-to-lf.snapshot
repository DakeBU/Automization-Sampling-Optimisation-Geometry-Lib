            <span id="alg2.l4a.3" class="ltx_text ltx_font_bold">for</span> <math id="alg2.l4a.m1" class="ltx_Math" alttext="k=0,\ldots,T-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">k=0,\ldots,T-1</annotation></semantics></math> <span id="alg2.l4a.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l5a" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l5a.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
              <math id="alg2.l5a.m1" class="ltx_Math" alttext="Y_{k+1}\leftarrow 2X_{k}-Y_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>k</mi></msub></mrow><mo>−</mo><msub><mi>Y</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">Y_{k+1}\leftarrow 2X_{k}-Y_{k}</annotation></semantics></math>

</div>
<div id="alg2.l6a" class="ltx_listingline">
