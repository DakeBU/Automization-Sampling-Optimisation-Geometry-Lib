  <summary><span class="kind">theorem</span> <code>AutoSamplingTheory.TechnicalLemmas.Probability.GaussianLipschitzExponential.integral_exp_centered_le_stdGaussian_of_lipschitz</code> <span class="status status-yellow">Partial</span> <span class="status status-gray">Not mapped</span></summary><p data-lesson-link="AutoSamplingTheory.TechnicalLemmas.Probability.GaussianLipschitzExponential.integral_exp_centered_le_stdGaussian_of_lipschitz"><a href="../lessons/autosamplingtheory-technicallemmas-probability-gaussianlipschitzexponential-integral-exp-centered-le-stdgaussian-of-lipschitz-8b96b74de99f.html">Read the complete mathematical statement and proof, with Lean below each</a></p>
  <div class="declaration-content">
    <p class="docstring">- Sharp centered Laplace bound for the actual standard Gaussian, with all
domains and the smooth approximation produced internally.</p>
    <pre class="code-block"><code class="language-lean">theorem integral_exp_centered_le_stdGaussian_of_lipschitz
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [CompleteSpace E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
    {L : ℝ≥0} {f : E → ℝ} (hf : LipschitzWith L f) (t : ℝ) :
    (∫ x, Real.exp (t * (f x - ∫ z, f z ∂ProbabilityTheory.stdGaussian E))
      ∂ProbabilityTheory.stdGaussian E) ≤ Real.exp ((L : ℝ)^2 * t^2 / 2) := by
  by_cases hL : L = 0
  · subst L
    rw [centered_exp_integral_of_lipschitz_zero hf t]
    norm_num
  · rcases subsingleton_or_nontrivial E with hE | hE
    · letI : Subsingleton E := hE
      rw [centered_exp_integral_of_subsingleton f t]
      exact Real.one_le_exp_iff.mpr (by positivity)
    · exact le_of_tendsto&#x27; (smoothApprox_centered_exp_integral_tendsto hf t)
        (fun n =&gt; gaussian_centered_laplace_bound_c1
          (smoothApprox_contDiff hf n) (smoothApprox_lipschitz hf n) t)

end AutoSamplingTheory.TechnicalLemmas.Probability.GaussianLipschitzExponential
end</code></pre>
