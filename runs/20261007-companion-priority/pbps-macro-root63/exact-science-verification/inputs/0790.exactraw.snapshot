theorem generalMovingTargetDiscreteSourceTestLaplacianEqStdIteratedFDeriv
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace Real E]
    [FiniteDimensional Real E] (sourceTest : E → Real) :
    Laplacian.laplacian sourceTest =
      fun x => ∑ i, iteratedFDeriv Real 2 sourceTest x
