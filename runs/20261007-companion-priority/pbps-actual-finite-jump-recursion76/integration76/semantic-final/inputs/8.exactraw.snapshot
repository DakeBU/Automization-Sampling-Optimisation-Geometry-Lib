    "literal_definitions": [
      {
        "header_RAW_range": [
          1270,
          1340
        ],
        "id": "D01",
        "literal": "    let c : E → E → E := fun y xRef => y - η • gradient V xRef\n",
        "name": "c"
      },
      {
        "header_RAW_range": [
          1340,
          1594
        ],
        "id": "D02",
        "literal": "    let Φ : E → E → ℝ → (E × E) → (E × E) := fun y xRef t z =>\n      (c y xRef + Real.cos t • (z.1 - c y xRef) +\n          (Real.sqrt η * Real.sin t) • z.2,\n       (-Real.sin t / Real.sqrt η) • (z.1 - c y xRef) + Real.cos t • z.2)\n",
        "name": "Φ"
      },
      {
        "header_RAW_range": [
          1594,
          1817
        ],
        "id": "D03",
        "literal": "    let S : E → (E × E) → (E × E) := fun xRef z =>\n      (z.1, z.2 - (2 * inner ℝ z.2 (gradient V z.1 - gradient V xRef) /\n        ‖gradient V z.1 - gradient V xRef‖ ^ 2) • (gradient V z.1 - gradient V xRef))\n",
        "name": "S"
      },
      {
        "header_RAW_range": [
          1817,
          1950
        ],
        "id": "D04",
        "literal": "    let rate : E → (E × E) → ℝ := fun xRef z =>\n      Real.sqrt η * max 0 (inner ℝ z.2 (gradient V z.1 - gradient V xRef))\n",
        "name": "rate"
      },
      {
        "header_RAW_range": [
          1950,
          2073
        ],
        "id": "D05",
        "literal": "    let H : E → E → (E × E) → ℝ := fun y xRef z =>\n      (η⁻¹ * ‖z.1 - c y xRef‖ ^ 2 + ‖z.2‖ ^ 2) / 2\n",
        "name": "H"
      },
      {
        "header_RAW_range": [
          2073,
          2262
        ],
        "id": "D06",
        "literal": "    let C : E → E → (E × E) → ℝ := fun y xRef z =>\n      Real.sqrt η * (β : ℝ) * Real.sqrt (2 * H y xRef z) *\n        (Real.sqrt (2 * η * H y xRef z) + ‖c y xRef - xRef‖)\n",
        "name": "C"
      },
      {
        "header_RAW_range": [
          2262,
          2400
        ],
        "id": "D07",
        "literal": "    let Λ : E → E → (E × E) → ℝ≥0 → ℝ := fun y xRef z t =>\n      ∫ s in (0 : ℝ)..(t : ℝ), rate xRef (Φ y xRef s z)\n",
        "name": "Λ"
      },
      {
        "header_RAW_range": [
          2400,
          2689
        ],
        "id": "D08",
        "literal": "    let τ : E → E → (E × E) → ℝ≥0 → WithTop ℝ≥0 := fun y xRef z e =>\n      MeasureTheory.hittingAfter\n        (fun t : ℝ≥0 => fun a : (E × E) × (E × E) × ℝ≥0 =>\n          Λ a.1.1 a.1.2 a.2.1 t - (a.2.2 : ℝ))\n        (Set.Ici (0 : ℝ)) 0 ((y, xRef), z, e)\n",
        "name": "τ"
      },
      {
        "header_RAW_range": [
          2689,
          3089
        ],
        "id": "D09",
        "literal": "    let next : E → E → ℝ≥0 → ((ℝ≥0 × (E × E)) ⊕ Unit) →\n        ((ℝ≥0 × (E × E)) ⊕ Unit) := fun y xRef e r =>\n      match r with\n      | Sum.inr _ => Sum.inr ()\n      | Sum.inl a =>\n        if τ y xRef a.2 e = ⊤ then Sum.inr () else\n          Sum.inl (a.1 + (τ y xRef a.2 e).untopD 0,\n            S xRef (Φ y xRef (((τ y xRef a.2 e).untopD 0 : ℝ≥0) : ℝ) a.2))\n",
        "name": "next"
      },
      {
        "header_RAW_range": [
          3089,
          3297
        ],
        "id": "D10",
        "literal": "    let record : E → E → (E × E) → (ℕ → ℝ≥0) → ℕ →\n        ((ℝ≥0 × (E × E)) ⊕ Unit) := fun y xRef z₀ e n =>\n      Nat.rec (Sum.inl (0, z₀)) (fun k r => next y xRef (e k) r) n\n",
        "name": "record"
      },
      {
        "header_RAW_range": [
          3297,
          3508
        ],
        "id": "D11",
        "literal": "    let eventTime : E → E → (E × E) → (ℕ → ℝ≥0) → ℕ → WithTop ℝ≥0 :=\n      fun y xRef z₀ e n => (record y xRef z₀ e n).elim\n        (fun a => (a.1 : WithTop ℝ≥0)) (fun _ => ⊤)\n",
        "name": "eventTime"
      }
    ],
