      ],
      "formula": "I<=eta² Er||U||²<=eta² d; entire4.6 W2<=sqrtI<=eta sqrtEr||U||²<=eta sqrt d; outside current completion",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "BIAS-IDENTITY",
      "kind": "SOURCE",
      "source_anchors": [
        "S4.Ex7",
        "S4.Ex9"
      ],
      "formula": "Ex7: hatg_eta(y;G)=g_eta(y)+b_eta(y)+xi_eta(y;G), E_gamma xi_eta=0; hence b_eta=E_gamma hatg_eta-g_eta and xi_eta=hatg_eta-E_gamma hatg_eta. Ex9: g_eta=gradV(p)+eta^-1/2 E_r gradrho, hatg pointwise=gradV(p)+eta^-1/2 gradrho; therefore b_eta=eta^-1/2(E_gamma gradrho-E_r gradrho). Actual means require ACTUAL-MEAN-DOMAIN-GAP; no Gaussian MGF centered at g_eta is inferred.",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "VECTOR-MEAN-GAP",
      "kind": "SOURCE_GAP",
      "source_anchors": [
        "S4.SS1.p5.2"
      ],
      "formula": "Consume ACTUAL-MEAN-DOMAIN-GAP genuine Bochner means plus actual eta-Lipschitz gradrho; coupling/CauchySchwarz/infimum adapter proves norm(E_gamma gradrho-E_r gradrho)<=eta W2. This comparison is distinct from mere domain production.",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "BIAS42-LINK",
      "kind": "SOURCE_OPEN_CONSUMER",
      "source_anchors": [
        "S4.E2",
        "S4.SS1.p5.2"
      ],
      "formula": "norm(actualoraclemean-gradientVeta)<=sqrteta W2<=eta^(3/2)sqrt d; no bias/fullLemma admission",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "SCORE-IDENTITY-GAP",
      "kind": "SOURCE_GAP",
      "source_anchors": [
        "S3.E1",
        "S4.Ex9"
      ],
      "formula": "Actual convolution derivative/normalization, actual R gradient and position L1, Gibbs score cancellation and affine expectation map justify printed Ex9 mean identity; previous source31 may supply genuine separately admitted parent, but is not a printed premise or new completion here.",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    },
    {
      "id": "ACTUAL-MEAN-DOMAIN-GAP",
      "kind": "SOURCE_GAP",
      "source_anchors": [
        "S4.Ex7",
        "S4.Ex9",
        "S4.SS1.p5.2"
      ],
      "formula": "Internally produce actual gradrho BochnerL1 under both r and gamma, actual hatg BochnerL1 under gamma, and resulting xi/b ownmean integrability. Actual probabilities/finite2 and rho eta-Lipschitz gradient yield these domains; no public integrability/mean certificate. This vertex asserts no coupling comparison.",
      "status": "SOURCE_RECONSTRUCTED_OPEN"
    }
