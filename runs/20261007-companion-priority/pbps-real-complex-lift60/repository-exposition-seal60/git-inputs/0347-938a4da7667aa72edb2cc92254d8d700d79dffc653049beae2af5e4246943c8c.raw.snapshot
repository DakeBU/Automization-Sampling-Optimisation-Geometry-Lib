from pathlib import Path
import datetime,gzip,hashlib,json,re,subprocess
r=Path('runs/20261007-companion-priority/pbps-real-complex-lift60'); load=lambda p:json.loads(Path(p).read_bytes()); sha=lambda b:hashlib.sha256(b).hexdigest()
def write(p,x):Path(p).write_text(json.dumps(x,ensure_ascii=False,indent=2)+'\n',encoding='utf-8',newline='\n')
def pin(p):
 p=Path(p);b=p.read_bytes();return dict(path=p.as_posix(),bytes=len(b),raw_sha256=sha(b),lf_sha256=sha(b.replace(b'\r\n',b'\n')))
labels=['mandatory-astis-check','python-compile','contributor','publication','semantic','frontier','website-ci-build','official-graph-ci-output','graph-producer','graph-consumer','site-check','science-push','visual-capture60'];checks=[]
for label in labels:
 p=r/'integration60'/label/'receipt.json';x=load(p);assert x['exit_code']==0 and x['terminal_closed'];checks.append(dict(label=label,receipt=pin(p),stdout=x['stdout'],stderr=x['stderr']))
jobs=[int(x) for x in re.findall(r'Build completed successfully \((\d+) jobs\)',(r/'integration60/mandatory-astis-check/stdout.log').read_text(encoding='utf-8'))];assert jobs==[9165,9457]
assert load(r/'root.exact-verification60.adoption.json')['native_verified']
capture=Path('.astis/pbps-real-complex-lift60/visual60-cdp');native=load(capture/'capture.json');assert native['ownedBrowserExit']['code']==0 and len(native['records'])==8
dest=r/'integration60/visual60';dest.mkdir(exist_ok=False);visualpins=[]
for p in capture.iterdir():
 if p.is_file():q=dest/p.name;q.write_bytes(p.read_bytes());visualpins.append(pin(q))
visual=dict(status='SCOPED_ACTUAL_LOCAL_DESKTOP_VISUALLY_INSPECTED',viewed_by_root=True,viewport='1440x1800 isolated headless Chrome; browser/server actual closure',capture=native,capture_files=visualpins,observations=['Both complete attributed statements preserve their sealed arbitrary-measure and actual C2/two-Hessian/positive capped eta binders; actual rank-zero and infinite L2 boundaries remain visible.','Five shared formula steps plus two actual mathematical steps and one explicit remaining-boundary step render. Their corresponding Lean, exact statements and proofs are initially folded.','Both exact declaration graph targets are Registry-backed compiled, with actual source locations and the shared-to-actual consumer shown.','Solid imports/ownership and dashed incomplete name/source/semantic scans remain distinct; no real-root, GammaP or conceptual transport certificate appears.'],debts=['Dense inline mathematics and repeated assumptions remain existing reader debt.','Long declaration labels wrap and overall branch requires zoom; entire paper/Chapter1.3/full Exposition Seal not accepted.'],main_live_purified=False)
write(r/'visual.inspection.json',visual)
out=r/'integration60/tracked-whitespace-preserved';out.mkdir(exist_ok=False);command=['git','-c','core.whitespace=cr-at-eol','diff','--check'];p=subprocess.run(command,capture_output=True);(out/'stdout.log').write_bytes(p.stdout);(out/'stderr.log').write_bytes(p.stderr)
if p.returncode:
 assert p.returncode==2;hits=re.findall(r'^(.+):(\d+): (trailing whitespace\.|new blank line at EOF\.)$',p.stdout.decode('utf-8'),re.M);assert hits and {x[0] for x in hits}=={'runs/20261007-companion-priority/pbps-real-complex-lift-preproof60/commit-science60/stdout.log'}
 # Exact immutable observer path only; no broad directory exclusion.
 complement=subprocess.run(command+['--','.',':(exclude)'+hits[0][0]],capture_output=True);assert complement.returncode==0
 (out/'authored.stdout.log').write_bytes(complement.stdout);(out/'authored.stderr.log').write_bytes(complement.stderr)
 diagnosis=dict(full_tracked_exit=2,full_tracked_called_PASS=False,immutable_observer_paths=sorted({x[0] for x in hits}),findings=hits,authored_complement_exit=0,observer_history=(r/'commit-observer-split.json').as_posix(),no_immutable_rewrite=True)
else:assert p.returncode==0;diagnosis=dict(full_tracked_exit=0,full_tracked_called_PASS=True,authored_complement_exit=0)
write(out/'diagnosis.json',diagnosis)
plan=load(r/'publication-plan.json');updates=[]
for cid in plan['active_cells']:
 p=Path('research-wiki/frontier-cells')/(cid+'.json');x=load(p);assert x['status']=='independently_verified';snap=r/'integration60'/(cid+'.before-aggregate.exactraw.snapshot.json');snap.write_bytes(p.read_bytes());x['evidence']['serialized_shared_gate']=dict(evidence=(r/'integration60/mandatory-astis-check/receipt.json').as_posix(),root_jobs=9165,test_jobs=9457,registry_count=503,status='PASS',proof_commit='0a77416f5ec38702c46ec1358966b9dd4846c8d3',scope='Actual aggregate60; independent exact science separate; main/live/PURIFIED open.');x['graph_contribution']['visual_review']=(r/'visual.inspection.json').as_posix();write(p,x);updates.append(dict(cell=cid,before=pin(snap),after=pin(p)))
p=Path('docs/companion-papers-handoff.md');b=p.read_bytes();old=b'Serialized Registry503/root imports/tests, affected graph/page gates and\nrepository/exposition seals are still integration work; this entry alone\ndoes not certify MERGED, live publication, PURIFIED, a paper or the Goal.\n';assert b.count(old)==1
new=b'Serialized aggregate60 PASSES: root9165, Tests9457, Registry503, publication224,\ncontributor/semantic/frontier/Python/site and both affected graph checks.\nEight actual desktop captures were viewed: two exact statements, eight\nformula/boundary steps and two Registry-backed branches. Canonical metadata\nfrom63 cards is preserved;80 unrelated generator changes were restored.\nScience0a77416f was safely pushed to existing PR315. Repository/exposition\nseals and remote CI remain separate; no MERGED/live/PURIFIED/paper/Goal closure.\n';p.write_bytes(b.replace(old,new))
notes=dict(status='SERIALIZED_SHARED_AGGREGATE_PASS_NOT_MAIN_NOT_PURIFIED',utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),proof_commit='0a77416f5ec38702c46ec1358966b9dd4846c8d3',registry_count=503,root_jobs=9165,test_jobs=9457,checks=checks,cell_administration_updates=updates,visual_inspection=(r/'visual.inspection.json').as_posix(),whitespace_diagnosis=pin(out/'diagnosis.json'),graph_delta='Two public compiled positive-complex-lift declarations;26 private providers owned by the accepted shared declaration, not separate progress claims. Same real D=I-T*T internally produced by actual PBPS59. Four affected module graph artifacts and two new enriched module cards.63 canonical card metadata preserved,80 unrelated generated files restored, current511 production module inventory retained. No new real root/GammaP/functor.',remaining=plan['remaining_boundary']+' Reader seal/main/live/postmerge purification and complete Goal open.',sole_stabilization_owner='ASTIS-SA-20261005-SPHMCImplementedPhaseKernel')
write(r/'integration.notes.json',notes);print('Recorded13 actual gates,8 viewed captures,9165/9457/503; cell/handoff admin only, no self-VERIFIED.')
