    {
      "id": "S-FINAL",
      "kind": "SOURCE_CONCLUSION",
      "formula": "gaussian_logSobolev_CompSmo: homogeneousGaussian entropy(f²)<=2 integralderiv²",
      "classification": "EXTERNAL_SOURCE_NOT_LOCAL_PRODUCER",
      "anchors": [
        {
          "input_role": "external_compact_lsi",
