AutoSamplingTheory.TechnicalLemmas.Geometry.SphereDiffusionGenerator.sum_hessian_projectedNoiseColumn.{u_1}
  {I : Type u_1} [Fintype I] [DecidableEq I] (f : EuclideanSpace ℝ I → ℝ) {w : EuclideanSpace ℝ I} (hw : ‖w‖ = 1) :
  ∑ j,
      ((fderiv ℝ (fderiv ℝ f) w)
          (AutoSamplingTheory.TechnicalLemmas.Geometry.SphereProjectedNoise.projectedNoiseColumn j w))
        (AutoSamplingTheory.TechnicalLemmas.Geometry.SphereProjectedNoise.projectedNoiseColumn j w) =
    Laplacian.laplacian f w - ((fderiv ℝ (fderiv ℝ f) w) w) w
END_5
