assert status['exit_code']==cl['exit_code']==0 and cl['status']=='CLOSED' and status['process_id']==cl['process_id']
assert sha(src)==status['source_raw_sha256']==cl['source_raw_sha256'] and sha(log)==status['log_raw_sha256']
snapshot=src.decode().replace('\r\n','\n');assert '#check fun' in snapshot and ':= by' not in snapshot and 'theorem ' not in snapshot
body=snapshot.split('#check fun',1)[1].strip();expected=lf.decode().split('actual_gaussian_marginal_centered_poincare',1)[1].strip();assert body.replace('(hβη : (β : ℝ)*η ≤ 1) =>','(hβη : (β : ℝ)*η ≤ 1) :').strip()==expected
assert log.decode().find('→ Prop')>=0 and not (ROOT/'AutoSamplingTheory/TechnicalLemmas/FunctionalInequalities/GaussianMarginalPoincare.lean').exists() and not (ROOT/'Tests/GaussianMarginalPoincare.lean').exists()
for key in ['primary_contract','source_precision','independent_source_first_blueprint','closed_primary_lease']:
 p=proposal[key];a=pin(ROOT/p['path']);assert a==p
for f in ['primary.contract.json','source.precision-addendum.json','next-consumer.blueprint.json','reviewer.primary.run.json','lease.json']:
 v=json.loads((P/f).read_bytes());assert sha(canon({k:x for k,x in v.items() if k!='content_self_sha256'}))==v['content_self_sha256']
assert json.loads((P/'lease.json').read_bytes())['status']=='CLOSED'
files=list(R.iterdir())+[P/f for f in ['primary.contract.json','source.precision-addendum.json','next-consumer.blueprint.json','reviewer.primary.run.json','lease.json','S2.SS2.raw.html','A3.SS1.raw.html','A4.SS1.raw.html','A4.SS2.raw.html','CenteredDomainPoincare.public-contracts.lf.snapshot.lean','GaussianMarginalGradient.public-contracts.lf.snapshot.lean','WeightedGradientWeak.public-contracts.lf.snapshot.lean','GaussianConvolutionRegularity.public-contracts.lf.snapshot.lean','GibbsLinearCovarianceUpper.public-contracts.lf.snapshot.lean']]
files+=[ROOT/'runs/20261007-companion-priority/pbps-rough-mean-gradient56/source-review56/production.header.seal.normalized.lf.snapshot.lean',ROOT/'runs/20261007-companion-priority/pbps-rough-mean-gradient56/source-review56/L2MacroscopicMean.header.lf.snapshot.lean',ROOT/'lean-toolchain',ROOT/'lake-manifest.json']
