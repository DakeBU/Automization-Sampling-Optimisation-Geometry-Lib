  <summary><span class="kind">theorem</span> <code>AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.TwoPointEntropy.rothaus_lemma</code> <span class="status status-yellow">Partial</span> <span class="status status-gray">Not mapped</span></summary>
