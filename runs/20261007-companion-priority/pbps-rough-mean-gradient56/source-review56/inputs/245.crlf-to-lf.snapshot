</div>
<div id="alg2.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
               Query <math id="alg2.l15.m1" class="ltx_Math" alttext="\nabla V(\widetilde{X})" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∇</mo><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo mathsize="0.900em">~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla V(\widetilde{X})</annotation></semantics></math>

</div>
<div id="alg2.l16" class="ltx_listingline">
