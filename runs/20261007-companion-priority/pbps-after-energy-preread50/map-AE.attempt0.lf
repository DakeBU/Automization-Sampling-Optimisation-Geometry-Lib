theorem ae_map_iff {f : α → β} (hf : AEMeasurable f μ) {p : β → Prop}    (hp : MeasurableSet { x | p x }) : (∀ᵐ y ∂μ.map f, p y) ↔ ∀ᵐ x ∂μ, p (f x) :=  mem_ae_map_iff hf hptheorem ae_of_ae_map {f : α → β} (hf : AEMeasurable f μ) {p : β → Prop} (h : ∀ᵐ y ∂μ.map f, p y) :    ∀ᵐ x ∂μ, p (f x) :=  mem_ae_of_mem_ae_map hf h
