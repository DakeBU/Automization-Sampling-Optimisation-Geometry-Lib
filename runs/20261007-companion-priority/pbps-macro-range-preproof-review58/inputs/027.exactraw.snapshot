      "formula": "\\begin{split}\\mathfrak{H}_{\\mathsf{P}}&\\coloneqq\\operatorname{ran}(\\mathsf{P})=\\{f\\in\\mathfrak{H}:f(x,y)=g(y)\\text{ for some }g\\in L^{2}(\\pi_{\\eta}^{Y})\\}\\,,\\\\\n\\mathfrak{H}_{\\perp}&\\coloneqq\\ker(\\mathsf{P})=\\operatorname{ran}(\\mathsf{P}^{\\perp})=\\{f\\in\\mathfrak{H}:\\mathbb{E}[f(X,Y)\\mid Y]=0\\}\\,.\\end{split}",
      "disposition": "NODE",
      "nodes": [
