        },
        "formula": "\\langle(I+T)u,u\\rangle\\ge\\|u\\|^2-\\|Tu\\|\\|u\\|\\ge0,\\quad[\\Gamma^2,I+T]=0\\Rightarrow[\\Gamma,T]=0.",
