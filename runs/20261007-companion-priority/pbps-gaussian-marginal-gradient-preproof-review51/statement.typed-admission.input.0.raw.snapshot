  "semantic_slots": {
    "objects": "Actual independent augmentation J=(mu.prod stdGaussian E).map(x,z)->(x,x+sqrt(eta) z); actual outer nu=J.snd; scalar/vector Lp2(nu) and a partial real-linear gradient D. This is outer law, not conditional fiber S_y.",
    "domains": "D has exactly smooth C-infinity compact scalar representatives and their genuine global Riesz gradients, identified AE in actual nu. Dense domain refers to scalar Lp2, and closability/closed closure refer to the product graph. These are outputs, not caller certificates.",
    "quantifiers": "Every finite real Hilbert/Borel E, any probability mu and positive eta; exists D before all u/v; exact graph iff exists smooth compact f. No selector, moments, potential, domain/closure, energy, or inequality premise.",
    "assumptions": "NormedAddCommGroup/InnerProductSpace/FiniteDimensional/MeasurableSpace/BorelSpace typing; mu probability and eta>0. These are legitimate authored generic background premises, distinct from source Gibbs/C2/alpha-beta/beta eta<=1 which stay required at the actual paper consumer.",
    "conclusion": "Dense genuine compact-smooth gradient graph, D.IsClosable and D.closure.IsClosed on the same actual nu. Does not yet put Tf in that closure for rough f, identify maximal weak H1, construct Gamma, or prove B.13.",
    "scopes": "Authored Gaussian-marginal sufficient dependency for PBPS Appendix C.1 density/closedness phrase. Arbitrary probability mu and finite Hilbert/rank0 are disclosed extensions, not printed standalone source theorem. Original Gibbs probability is internally produced at actual50 consumer, and same literal J/nu still needs a real integration join.",
    "constant_dependencies": "No estimate coefficient in this leaf; positive eta permits genuine Gaussian density. stdGaussian is variance-one via finite orthonormal coordinates; sqrt eta scales it to covariance eta. No beta eta cap needed for this generic smooth positive outer-law prerequisite; paper B.13 quantitative consumer retains beta eta<=1."
  },
  "binder_classification": [
    {
      "binder": "E and five typeclasses",
      "class": "TYPING",
      "audit": "Finite real Hilbert with Borel structure; no CompleteSpace/Nontrivial supplied. Rank0 included."
    },
    {
      "binder": "mu : Measure E / IsProbabilityMeasure mu",
      "class": "AUTHORED_STANDING_BACKGROUND",
      "audit": "Any true probability input; source Gibbs mu is an actual internally produced instance. No Gaussian density or moment certificate."
    },
    {
      "binder": "eta : Real / h_eta > 0",
      "class": "SOURCE_SCALE_AND_AUTHORED_EXTENSION",
      "audit": "Allpositive eta legitimate for this marginal-regularity dependency; does not extend source quantitative beta eta bound."
    },
    {
      "binder": "J and nu lets",
      "class": "CHARACTERIZED_DEFINITION",
      "audit": "Literal augmentation and snd pushforward, no arbitrary kernel/law witness assumption."
    },
    {
      "binder": "D, dense/closable/closure/graph properties",
      "class": "DERIVED_OUTPUT",
      "audit": "Exact genuine graph and analytic closure internally produced."
    },
    {
      "binder": "f smooth compact in graph iff",
      "class": "OUTPUT_DOMAIN_DEFINITION",
      "audit": "Every graph element iff represented by actual smooth compact f; totalized gradient agrees with Riesz derivative since ContDiff infinity implies differentiability."
    }
  ],
  "definition_audit": {
    "gradient": "Literal global gradient f x=(toDual Real E).symm(fderiv Real f x). Its totalization is harmless only because graph f is smooth; does not authorize rough pointwise derivative.",
    "Lp": "Actual scalar/vector L2 AE classes for the same actual nu, not ordinary volume norms.",
    "LinearPMap": "Partial real-linear map from a submodule; graph has unique value on domain. Dense domain is an actual analytic conclusion.",
    "closure": "IsClosable means closed graph limit is itself a graph; closure chooses that extension when closable (otherwise fallback is original). Explicit IsClosable plus IsClosed closure avoids fallback falsely serving as a result.",
    "Gaussian_parent": "Public actual Gaussian convolution gives everywhere positive C2 density without input moments/density; parent W-C1 integrable exponential assumptions must be internally met and true tilted law identified, not copied as new public binders.",
    "rank0": "stdGaussian has empty-coordinate law and probability, outer marginal is true onepoint law; scalar smooth compact constants and zero gradients fit the graph. No unit-vector assumption or scalar-space triviality inferred."
  },
