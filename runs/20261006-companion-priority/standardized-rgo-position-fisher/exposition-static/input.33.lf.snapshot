    {
      "id": "transport:metric-lift",
      "kind": "concept-bridge",
      "label": "Change the metric, change the gradient",
      "status": "proposal",
      "subtitle": "source-backed correspondence",
      "summary": "A differential is a covector; a Riemannian metric converts it to a tangent gradient. Euclidean geometry is one instance.",
      "formula": "df_x[\\xi]=\\langle\\operatorname{grad}f(x),\\xi\\rangle_x",
      "details": [
        {
          "label": "Evidence boundary",
          "value": "Literature/structural correspondence; no Lean-certified functor or theorem transfer."
        },
        {
          "label": "Conceptual families",
          "value": "family:metric-gradient-flow, family:curvature-growth"
        },
        {
          "label": "Mechanism",
          "value": "A differential is a covector; a Riemannian metric converts it to a tangent gradient. Euclidean geometry is one instance."
        },
        {
          "label": "Hypothesis Map",
          "value": "Replace the ambient inner product by a metric. Distinguish pullback smoothness, geodesic convexity and a retraction-based local model."
        },
        {
          "label": "Conclusion Map",
          "value": "Descent, PL and stationarity arguments transport only after the metric gradient and metric/retraction effects are identified."
        },
        {
          "label": "Failure Boundary",
          "value": "A Euclidean Hessian lower bound in arbitrary coordinates does not imply geodesic strong convexity."
        },
        {
          "label": "Category objects",
          "value": "(space, metric, f, regularity) ↦ (manifold, metric, f, regularity)."
        },
        {
          "label": "Category morphisms",
          "value": "A specified solution/certificate transport; no total morphism map is claimed."
        },
        {
          "label": "Category identity",
          "value": "Not established; not asserted to be a functor."
        },
        {
          "label": "Category composition",
          "value": "Not established; side conditions of consecutive transports must be checked."
        },
        {
          "label": "Shared planned checkpoints",
          "value": "calculus, manifold"
        },
        {
          "label": "Library scope (curated)",
          "value": "Optimisation · Riemannian Optimisation"
        },
        {
          "label": "Scope evidence boundary",
          "value": "conceptual incidence scope, not compiled cross-domain use"
        }
      ],
      "url": "progress/index.html#shared-order",
      "source_url": "https://arxiv.org/abs/2605.07006",
      "hyperedge": {
        "id": "transport:metric-lift",
        "label": "Change the metric, change the gradient",
        "family_ids": [
