              "raw_sha256": "99811e95b98193f7a26106db2082af30c23d4d4bc11e10b9546da09b866d494a",
              "lf_sha256": "23f48bd92530e7aa11507bf287b6e9969cba918bc397022b9b17386d8fbea665"
            }
