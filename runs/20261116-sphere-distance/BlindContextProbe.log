STATEMENT_BEGIN
AutoSamplingTheory.TechnicalLemmas.Geometry.UnitSphereInducedPathDistance.unit_sphere_induced_riemannianEDist_eq_arccos.{u_1}
  {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] (n : ℕ)
  [Fact (Module.finrank ℝ E = n + 1)] (hn : 0 < n) (x y : ↑(Metric.sphere 0 1)) :
  Manifold.riemannianEDist (modelWithCornersSelf ℝ (EuclideanSpace ℝ (Fin n))) x y =
    ENNReal.ofReal (Real.arccos (Inner.inner ℝ ↑x ↑y))
STATEMENT_END
Manifold.riemannianEDist_def.{u_4, u_5, u_6} {E : Type u_4} [NormedAddCommGroup E] [NormedSpace ℝ E] {H : Type u_5}
  [TopologicalSpace H] (I : ModelWithCorners ℝ E H) {M : Type u_6} [TopologicalSpace M] [ChartedSpace H M]
  [(x : M) → ENorm (TangentSpace I x)] (x y : M) :
  Manifold.riemannianEDist I x y =
    ⨅ γ,
      ⨅ (_ : ContMDiff (modelWithCornersEuclideanHalfSpace 1) I 1 ⇑γ), ∫⁻ (x_2 : ↑unitInterval), ‖(mfderiv% ⇑γ x_2) 1‖ₑ
Manifold.pathELength_def.{u_4, u_5, u_6} {E : Type u_4} [NormedAddCommGroup E] [NormedSpace ℝ E] {H : Type u_5}
  [TopologicalSpace H] (I : ModelWithCorners ℝ E H) {M : Type u_6} [TopologicalSpace M] [ChartedSpace H M]
  [(x : M) → ENorm (TangentSpace I x)] (γ : ℝ → M) (a b : ℝ) :
  Manifold.pathELength I γ a b = ∫⁻ (t : ℝ) in Set.Icc a b, ‖(mfderiv% γ t) 1‖ₑ
structure Path.{u_1} {X : Type u_1} [TopologicalSpace X] (x y : X) : Type u_1
number of parameters: 4
parents:
  Path.toContinuousMap : C(↑unitInterval, X)
fields:
  ContinuousMap.toFun : ↑unitInterval → X
  ContinuousMap.continuous_toFun : Continuous self.toFun := by
    fun_prop
  Path.source' : self.toFun 0 = x
  Path.target' : self.toFun 1 = y
constructor:
  Path.mk.{u_1} {X : Type u_1} [TopologicalSpace X] {x y : X} (toContinuousMap : C(↑unitInterval, X))
    (source' : toContinuousMap.toFun 0 = x) (target' : toContinuousMap.toFun 1 = y) : Path x y
field notation resolution order:
  Path, ContinuousMap
@[reducible] def unitInterval : Set ℝ :=
Set.Icc 0 1
@[instance_reducible] def EuclideanSpace.instChartedSpaceSphere.{u_1} : {E : Type u_1} →
  [inst : NormedAddCommGroup E] →
    [inst_1 : InnerProductSpace ℝ E] →
      {n : ℕ} → [Fact (Module.finrank ℝ E = n + 1)] → ChartedSpace (EuclideanSpace ℝ (Fin n)) ↑(Metric.sphere 0 1) :=
fun {E} [NormedAddCommGroup E] [InnerProductSpace ℝ E] {n} [Fact (Module.finrank ℝ E = n + 1)] =>
  { atlas := {f | ∃ v, f = stereographic' n v}, chartAt := fun v => stereographic' n (-v), mem_chart_source := ⋯,
    chart_mem_atlas := ⋯ }
