    ],
    "conclusion_groups": [
      {
        "header_RAW_range": [
          3508,
          3627
        ],
        "id": "C01",
        "literal": "    (∀ y xRef : E, ∀ z₀ : E × E, ∀ e : ℕ → ℝ≥0,\n      record y xRef z₀ e 0 = Sum.inl (0, z₀)) ∧\n",
        "title": "Base"
      },
      {
        "header_RAW_range": [
          3627,
          4173
        ],
        "id": "C02",
        "literal": "    (∀ y xRef : E, ∀ z₀ : E × E, ∀ e : ℕ → ℝ≥0, ∀ n : ℕ,\n      record y xRef z₀ e (n + 1) = next y xRef (e n) (record y xRef z₀ e n) ∧\n      (∀ a : ℝ≥0 × (E × E), record y xRef z₀ e n = Sum.inl a →\n        (record y xRef z₀ e (n + 1) = Sum.inr () ↔ τ y xRef a.2 (e n) = ⊤) ∧\n        (τ y xRef a.2 (e n) ≠ ⊤ → record y xRef z₀ e (n + 1) =\n          Sum.inl (a.1 + (τ y xRef a.2 (e n)).untopD 0,\n            S xRef (Φ y xRef (((τ y xRef a.2 (e n)).untopD 0 : ℝ≥0) : ℝ) a.2))))) ∧\n",
        "title": "Recursion and finite/top update"
      },
      {
        "header_RAW_range": [
          4173,
          4296
        ],
        "id": "C03",
        "literal": "    Measurable (fun a : (E × E) × ℝ≥0 × ((ℝ≥0 × (E × E)) ⊕ Unit) =>\n      next a.1.1 a.1.2 a.2.1 a.2.2) ∧\n",
        "title": "Joint Borel next"
      },
      {
        "header_RAW_range": [
          4296,
          4424
        ],
        "id": "C04",
        "literal": "    (∀ n : ℕ, Measurable (fun a : (E × E) × (E × E) × (ℕ → ℝ≥0) =>\n      record a.1.1 a.1.2 a.2.1 a.2.2 n)) ∧\n",
        "title": "Joint Borel finite record"
      },
      {
        "header_RAW_range": [
          4424,
          4555
        ],
        "id": "C05",
        "literal": "    (∀ n : ℕ, Measurable (fun a : (E × E) × (E × E) × (ℕ → ℝ≥0) =>\n      eventTime a.1.1 a.1.2 a.2.1 a.2.2 n)) ∧\n",
        "title": "Joint Borel event time"
      },
      {
        "header_RAW_range": [
          4555,
          4700
        ],
        "id": "C06",
        "literal": "    (∀ y xRef : E, ∀ z₀ : E × E, ∀ e : ℕ → ℝ≥0,\n      eventTime y xRef z₀ e 0 = 0 ∧ Monotone (eventTime y xRef z₀ e)) ∧\n",
        "title": "Initial and monotone event times"
      },
      {
        "header_RAW_range": [
          4700,
          4881
        ],
        "id": "C07",
        "literal": "    (∀ y xRef : E, ∀ z₀ : E × E, ∀ e : ℕ → ℝ≥0, ∀ n k : ℕ,\n      record y xRef z₀ e n = Sum.inr () →\n        record y xRef z₀ e (n + k) = Sum.inr ()) ∧\n",
        "title": "Absorbing stop"
      },
      {
        "header_RAW_range": [
          4881,
          5337
        ],
        "id": "C08",
        "literal": "    (∀ y xRef : E, ∀ z₀ : E × E, ∀ e : ℕ → ℝ≥0, ∀ n : ℕ,\n      ∀ a : ℝ≥0 × (E × E), record y xRef z₀ e n = Sum.inl a →\n        H y xRef a.2 = H y xRef z₀ ∧\n        ∀ t : ℝ≥0, (t : WithTop ℝ≥0) < τ y xRef a.2 (e n) →\n          H y xRef (Φ y xRef (t : ℝ) a.2) = H y xRef z₀ ∧\n          0 ≤ rate xRef (Φ y xRef (t : ℝ) a.2) ∧\n          rate xRef (Φ y xRef (t : ℝ) a.2) ≤ C y xRef z₀) ∧\n",
        "title": "Same original energy and outgoing arc cap"
      },
      {
        "header_RAW_range": [
          5337,
          5821
        ],
        "id": "C09",
        "literal": "    (∀ y xRef : E, ∀ z₀ : E × E, ∀ e : ℕ → ℝ≥0,\n      0 ≤ C y xRef z₀ ∧\n      (0 < C y xRef z₀ → ∀ n : ℕ,\n        eventTime y xRef z₀ e n +\n          (Real.toNNReal ((e n : ℝ) / C y xRef z₀) : WithTop ℝ≥0) ≤\n        eventTime y xRef z₀ e (n + 1)) ∧\n      (C y xRef z₀ = 0 → ∀ n : ℕ, ∀ a : ℝ≥0 × (E × E),\n        record y xRef z₀ e n = Sum.inl a → 0 < e n →\n          record y xRef z₀ e (n + 1) = Sum.inr ())) ∧\n",
        "title": "Uniform extended time increment and zero cap"
      },
      {
        "header_RAW_range": [
          5821,
          6172
        ],
        "id": "C10",
        "literal": "    (∀ y xRef : E, ∀ z₀ : E × E, ∀ e : ℕ → ℝ≥0, ∀ n : ℕ,\n      ∀ a : ℝ≥0 × (E × E), record y xRef z₀ e n = Sum.inl a →\n        (e n = 0 → record y xRef z₀ e (n + 1) = Sum.inl (a.1, S xRef a.2)) ∧\n        (∀ b : ℝ≥0 × (E × E), 0 < e n →\n          record y xRef z₀ e (n + 1) = Sum.inl b → a.1 < b.1))",
        "title": "Zero threshold and conditional strict growth"
      }
    ],
