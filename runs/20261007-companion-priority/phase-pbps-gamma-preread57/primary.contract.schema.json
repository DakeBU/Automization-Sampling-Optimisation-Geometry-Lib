{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent primary-first PBPS57 native source contract",
  "type": "object",
  "required": [
    "schema_version",
    "actor",
    "status",
    "source",
    "standing_assumptions",
    "objects",
    "exact_formulae",
    "source_dependency_graph",
    "gradient_laplacian_convention",
    "remaining_boundaries",
    "chronology",
    "compiler_started",
    "formal_admission",
    "content_self_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "actor": {
      "const": "/root/next_primary56"
    },
    "status": {
      "const": "PRIMARY_ONLY_SOURCE_CONTRACT_SEALED"
    },
    "compiler_started": {
      "const": false
    },
    "formal_admission": {
      "const": false
    },
    "content_self_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
