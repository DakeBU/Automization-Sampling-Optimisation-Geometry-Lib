    {
      "id": "semantic-audit:ASTIS-RT-ANDI-OPT-BregmanGradient",
      "kind": "semantic-audit",
      "label": "ASTIS-RT-ANDI-OPT-BregmanGradient",
      "status": "fidelity-mismatch",
      "subtitle": "chewi-opt-v1-exercise-3-1 · implicit-assumption-exposed",
      "summary": "Blind reconstruction and seven-slot semantic comparison for AutoSamplingTheory.TechnicalLemmas.Analysis.ConvexSmoothGradient.gradient_gap_sq_le_bregman.",
      "column": 7,
      "url": "lean-foundations.html?view=semantic",
      "source_url": "",
      "original_theorem": "Let f be a convex C1 beta-smooth real-valued function on all Euclidean d-space, with beta>=0 as in Definition1.12. Smoothness means f(y)<=f(x)+<grad f(x),y-x>+(beta/2)||y-x||^2 for every x,y. Exercise3.1 explicitly says second differentiability is not required. Equation (3.4) asserts f(y)>=f(x)+<grad f(x),y-x>+(1/(2 beta))||grad f(y)-grad f(x)||^2. Its hint subtracts the tangent plane at x and applies the descent estimate. The exercise does not explicitly state beta>0 although its reciprocal expression and hinted step have that positive denominator domain.",
      "reconstructed_theorem": "Let E be any complete real inner product space and let f:E→ℝ be continuously Fréchet differentiable and convex on all of E. Let β be strictly positive real number β. Assume that for every x,y∈E, f(y) ≤ f(x)+⟨∇f(x),y−x⟩+(β/2)‖y−x‖², where ∇f(x) is the Riesz vector representing the Fréchet derivative. Then for every x,y∈E, ‖∇f(y)−∇f(x)‖² ≤ 2β(f(y)−f(x)−⟨∇f(x),y−x⟩).",
      "fidelity_verdict": "implicit-assumption-exposed",
      "blindness": "source hidden from decoder",
      "semantic_slots": [
        {
          "slot": "objects",
          "original": "A real-valued function and its Euclidean gradient.",
          "reconstructed": "A real-valued function and the Riesz gradient of its Frechet derivative.",
          "relation": "explicit-elaboration",
          "evidence": "For E equal to Euclidean d-space the Riesz vector is precisely the ordinary gradient. ContDiff ensures this is an actual derivative, not an arbitrary vector field."
        },
        {
          "slot": "domains",
          "original": "All of Euclidean d-space.",
          "reconstructed": "All of any complete real inner-product space E.",
          "relation": "stronger-in-lean",
          "evidence": "The module-scoped CompleteSpace and InnerProductSpace instances permit infinite dimension. Euclidean specialization is supported, but the unrestricted statements are not identical. All-space convexity is retained; a constrained-domain version is not certified."
        },
        {
          "slot": "quantifiers",
          "original": "Each admissible f and modulus, with the model and conclusion holding for every ordered pair x,y.",
          "reconstructed": "Each admissible E,f,modulus; the upper model and bound are global in x,y.",
          "relation": "same",
          "evidence": "No minimizer, exceptional set, bounded ball, or point-dependent constant appears. LipschitzWith packages exactly the universal pairwise norm estimate."
        },
        {
          "slot": "assumptions",
          "original": "Convex C1 function with the global quadratic upper model at a nonnegative modulus.",
          "reconstructed": "ContDiff real 1, ConvexOn univ, the same quadratic upper model; strictly positive real beta.",
          "relation": "stronger-in-lean",
          "evidence": "Definition 1.12 supplies C1 and beta>=0; Exercise 3.1 explicitly removes the section-wide C2 convention. Beta>0 restricts this declaration to the reciprocal formula's positive-denominator domain; it does not settle a reciprocal expression at zero."
        },
        {
          "slot": "conclusion",
          "original": "Reciprocal Bregman lower bound (3.4).",
          "reconstructed": "Squared gradient difference <= 2 beta times the Bregman gap.",
          "relation": "equivalent",
          "evidence": "Multiplication/division by 2 beta preserves order only for beta>0; exactly on that domain, the coefficients and endpoint orientation agree."
        },
        {
          "slot": "scopes",
          "original": "Exercise 3.1, with its individual Bregman/cocoercivity/Lipschitz obligations.",
