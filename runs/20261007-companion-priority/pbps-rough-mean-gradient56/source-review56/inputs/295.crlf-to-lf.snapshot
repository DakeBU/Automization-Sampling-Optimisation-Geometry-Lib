{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent source topology edge repair review56 v1",
  "type": "object",
  "required": ["schema_version", "artifact_kind", "reviewer", "verdict", "exact_deep_diff", "accepted_graph", "reachability", "coverage", "negative_history", "sourcegraph_admission", "proof_admission", "root_claim_proof_gate", "self_hash_recipe", "content_self_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "independent-source-topology-edge-repair-review"},
    "reviewer": {"type": "string"},
    "verdict": {"const": "ACCEPT_REPAIRED_SOURCE_TOPOLOGY_ONLY"},
    "exact_deep_diff": {"type": "array", "minItems": 2, "maxItems": 2},
    "accepted_graph": {"type": "object"},
    "reachability": {"type": "object"},
    "coverage": {"type": "object"},
    "negative_history": {"type": "object"},
    "sourcegraph_admission": {"const": true},
    "proof_admission": {"const": false},
    "root_claim_proof_gate": {"const": "ACTUAL55_ACCEPTED_VERIFICATION_SERIALIZED_CYCLE_REQUIRED"},
    "self_hash_recipe": {"type": "object"},
    "content_self_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
