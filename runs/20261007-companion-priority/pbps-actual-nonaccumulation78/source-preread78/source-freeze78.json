  "scope": "Actual event-time comparison/nonaccumulation only: Appendix A.1 (A.1),(A.2),Ex8/Ex9 with Proposition3.1 context. No process uniqueness/Markov/invariance credit.",
  "source_statement_freeze": "For every fixed y,xref and initial phase point, under source standing V/eta conditions and independent unit exponential inputs, the source integrated-hazard recursion either terminates after finitely many events, or its actual times tend to +infinity almost surely. More explicitly, L=0 gives no jumps; L>0 gives every finite prefix T_n >= L^-1 sum_(j=1)^n E_j, and on a common full-measure input event continuing times diverge. Therefore actual events cannot accumulate before a finite physical time.",
  "binder_map": [
    {
      "binder": "d and Rd phase carrier",
      "class": "TYPING",
      "source": "Euclidean finite dimension, x,p,y,xref real finite vectors; no positivity of dimension is used by this edge."
    },
    {
      "binder": "V C2, 0<alpha<=beta, Hessian bounds",
      "class": "STANDING",
      "source": "S1.p1.1;S1.E1. Strong convex lower bound and alpha are paper standing context, not analytical needs of this local nonaccumulation mechanism."
    },
    {
      "binder": "0<eta<=1/beta",
      "class": "STANDING",
      "source": "S2.SS2.p1.1. Local mechanism uses eta>0; retain source restriction or explicitly mark a generalized leaf."
    },
    {
      "binder": "fixed y,xref and arbitrary x0,p0",
      "class": "SOURCE",
      "source": "S3.Thmtheorem1;A1.SS1.p1.1;p2.1. No stationary/warm/Gaussian law required."
    },
    {
      "binder": "iid Exp1 inputs",
      "class": "SOURCE sampling specification",
      "source": "A1.SS1.p2.1; construct with existing actual product rather than requiring producer conclusion as added source-facing hypothesis."
    },
    {
      "binder": "finite cap/Lipschitz certificate/crossing witness/sum divergence",
      "class": "EXCESS if public in source anchor",
      "source": "Must be internal dependency edges derived from standing data and actual inputs; allowed as hypotheses only for honestly named generic library lemmas, not the source Anchor."
    }
  ],
  "definitions": {
    "center": "literal c=y-eta grad V(xref)",
    "residual": "literal grad V(x)-grad V(xref)",
    "flow": "literal explicit harmonic flow for all real t; actual waiting domain t>=0",
    "bounce": "literal source reflection incl R0=I",
    "rate": "literal sqrt eta max(inner p h,0), nonnegative",
    "hazard": "literal integral along current post-bounce state flow, not physical global time integral across old segments",
    "waiting_time": "characterized inf on real nonnegative u with extended infinity only for empty set; finite attainment requires continuity bridge; no choose/default witness may replace hitting-time definition",
    "clock": "literal T0=0 and T_(n+1)=T_n+S_(n+1) only while finite",
    "state": "literal z_(n+1)=bounce(flow_S(z_n)) only finite wait; no meaningful post-stop state is prescribed",
    "energy_cap": "literal source Ex4/Ex6 from initial state, fixed for all finite prefixes/segments, not per-step arbitrary cap"
  },
  "index_initialization_stopping": {
    "source_index": "E_1 feeds first wait S_1 from zeta0 at T0=0; step n uses E_(n+1).",
    "zero_based_adapter": "With X_k=E_(k+1), sum_(k in range n) X_k equals source sum_(j=1)^n E_j. Any state iterate n must mean post-nth-bounce phase state.",
    "finite_prefix": "States/times through nth jump exist only if first n waits are finite. At each finite hit strict positive E implies strictly positive wait, so clocks increase.",
    "termination": "When hitting set empty, S and next T are infinity and recursion stops. Do not silently claim a continuing finite state or evaluate flow at infinity.",
    "totalized_time_option": "ASTIS may extend all later event times to infinity with an explicit reviewed stop/absorption convention; this is an implementation totalization, not new literal source state semantics. Source-faithful conclusion can instead use a terminated-or-divergent dichotomy.",
    "quantifier_order": "For each fixed deterministic parameter/initial data, AE inputs. A shared input positivity/divergence event may support all deterministic choices via a pathwise bound, but do not claim joint parameter measurability or uncountable AE intersection without proof.",
    "horizon": "Arbitrary finite physical H>=0; pi only a later consumer. Finite event count/nonaccumulation is weaker than fully constructed global process."
  },
  "cap_map": {
    "value": "L=sqrt eta beta sqrt(2 Ecal)(sqrt(2 eta Ecal)+||c-xref||)",
    "dependencies": "eta,beta, y,xref,grad V(xref),x0,p0 through c and Ecal; no n, sample or time dependence for fixed data.",
    "zero_case": "L=0 -> rate0 -> positive thresholds unreachable -> first wait infinity -> no jumps.",
    "positive_case": "0<L finite -> finite S>=E/L; sum comparison for every finite prefix. Never divide by L before case split.",
    "energy_zero": "May force L=0; must remain included. No assumption Ecal>0 or L>0 may remove this branch.",
    "beta_zero": "Paper beta>0 via alpha; generalized leaf could allow beta=0 but must distinguish it from standing source assumptions."
  },
  "source_proof_graph": {
