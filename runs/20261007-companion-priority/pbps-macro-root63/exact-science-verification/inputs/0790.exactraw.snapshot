def discreteSaldEulerMaruyamaContract : EulerMaruyamaContract where
  id := "ASTIS.SALD.forward_KL_discrete.euler_maruyama"
  updateFormula := "X_{k+1}^eta = X_k^eta + eta*nabla log pi_{t_k}(X_k^eta) + sqrt(2*eta)*xi_k, with t_k=t(k*eta)."
  interpolationFormula := "For s in [s_k,s_{k+1}], hat X_s = X_k^eta + (s-s_k)*nabla log pi_{t_k}(X_k^eta) + sqrt(2)*(W_s-W_{s_k})."
