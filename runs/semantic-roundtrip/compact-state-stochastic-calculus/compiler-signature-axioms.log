AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.BrownianDiffusionQuadraticVariation.dyadic_predictable_diffusion_row_quadraticVariation_L2.{u_1,
    u_2}
  {Omega : Type u_1} {kappa : Type u_2} [MeasurableSpace Omega] [Fintype kappa] [DecidableEq kappa]
  {filtration : MeasureTheory.Filtration NNReal inferInstance} {mu : MeasureTheory.Measure Omega}
  {B : NNReal → Omega → EuclideanSpace ℝ kappa}
  (hB :
    AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.BrownianMotion.IsStandardBrownianMotionWithFiltration B
      filtration mu)
  (T : NNReal) (coeff : (level : ℕ) → Fin (2 ^ level) → kappa → Omega → ℝ)
  (hAdapted : ∀ (level : ℕ) (i : Fin (2 ^ level)) (j : kappa), MeasureTheory.StronglyMeasurable (coeff level i j))
  (hCoeff : ∀ (level : ℕ) (i : Fin (2 ^ level)) (j : kappa), MeasureTheory.MemLp (coeff level i j) 4 mu) (C : ℝ)
  (hC : ∀ (level : ℕ) (i : Fin (2 ^ level)) (j : kappa), ∫ (omega : Omega), coeff level i j omega ^ 4 ∂mu ≤ C) :
  have error := fun level omega =>
    have times :=
      AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.SampledElementaryApproximation.regularGridTimes
        (AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.SampledElementaryApproximation.dyadicMesh T level)
        (2 ^ level);
    ∑ i,
      ((∑ j, coeff level i j omega * ((B (times i.succ) omega).ofLp j - (B (times i.castSucc) omega).ofLp j)) ^ 2 -
        (∑ j, coeff level i j omega ^ 2) * ↑(times i.succ - times i.castSucc));
  (∀ (level : ℕ), MeasureTheory.MemLp (error level) 2 mu) ∧
    Filter.Tendsto (fun level => ∫ (omega : Omega), error level omega ^ 2 ∂mu) Filter.atTop (nhds 0)
END_12
