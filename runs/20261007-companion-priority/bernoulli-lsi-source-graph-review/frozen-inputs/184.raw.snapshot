      "formula": "theorem last_coord_gradient_bound {n : ℕ} (h : (Fin (n + 1) → Bool) → ℝ)\n    (ε' : Fin n → Bool) (b : Bool) :\n    (h (Fin.snoc ε' b) - h (flipCoord (Fin.last n) (Fin.snoc ε' b)))^2 =\n    (h (Fin.snoc ε' b) - h (Fin.snoc ε' (!b)))^2",
