  (hg : ContDiff ℝ 2 g) (x : E) :
  Laplacian.laplacian (f * g) x =
    f x * Laplacian.laplacian g x + g x * Laplacian.laplacian f x + 2 * inner ℝ (gradient f x) (gradient g x)
