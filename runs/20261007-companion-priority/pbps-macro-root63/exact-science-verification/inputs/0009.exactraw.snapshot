    "statement": "∀ {E : Type u_1}\n  [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E]\n  [inst_3 : MeasurableSpace E] [BorelSpace E] (μ : MeasureTheory.Measure E) [MeasureTheory.IsProbabilityMeasure μ]\n  (a : ℝ≥0 × E × ℕ × (ℕ → E) → ℝ),\n  Measurable a →\n    ∀ (ha0 : ∀ (s : ℝ≥0 × E × ℕ × (ℕ → E)), 0 < a s) (threshold : ℝ≥0),\n      have F := fun p =>\n        (⟨↑p.1.1 + (a p.1)⁻¹, add_nonneg (NNReal.coe_nonneg p.1.1) (le_of_lt (inv_pos.mpr (ha0 p.1)))⟩,\n          (↑p.1.1 + (a p.1)⁻¹)⁻¹ • (↑p.1.1 • p.1.2.1 + (a p.1)⁻¹ • p.2), p.1.2.2.1 + 1, fun n =>\n          Nat.casesOn n p.2 p.1.2.2.2);\n      ∃ T H,\n        ProbabilityTheory.IsMarkovKernel T ∧\n          ProbabilityTheory.IsMarkovKernel H ∧\n            (∀ (s : ℝ≥0 × E × ℕ × (ℕ → E)), T s = μ.tilted fun x => -(↑s.1 / 2) * ‖x - s.2.1‖ ^ 2) ∧\n              (∀ (s : ℝ≥0 × E × ℕ × (ℕ → E)),\n                  H s = AutoSamplingTheory.TechnicalLemmas.Measure.GaussianSmoothing.gaussianSmoothing (T s) √(a s)) ∧\n                ∀ (Q L : ProbabilityTheory.Kernel (ℝ≥0 × E × ℕ × (ℕ → E)) E),\n                  ProbabilityTheory.IsMarkovKernel Q →\n                    ProbabilityTheory.IsMarkovKernel L →\n                      ∃ P R,\n                        ProbabilityTheory.IsMarkovKernel P ∧\n                          (∀ (n : ℕ), ProbabilityTheory.IsMarkovKernel (R n)) ∧\n                            (∀ (s : ℝ≥0 × E × ℕ × (ℕ → E)),\n                                P s =\n                                  if threshold ≤ s.1 then MeasureTheory.Measure.dirac s\n                                  else MeasureTheory.Measure.map (fun y => F (s, y)) (Q s)) ∧\n                              R 0 = L ∧\n                                (∀ (n : ℕ) (s : ℝ≥0 × E × ℕ × (ℕ → E)),\n                                    (R (n + 1)) s =\n                                      if threshold ≤ s.1 then L s else (fun y => (R n) (F (s, y))) ∘ₘ Q s) ∧\n                                  (∀ (n : ℕ) (s : ℝ≥0 × E × ℕ × (ℕ → E)), threshold ≤ s.1 → (R n) s = L s) ∧\n                                    (∀ (n : ℕ),\n                                        have κ := fun k =>\n                                          P.comap (fun h => h ⟨k, Finset.mem_Iic.mpr le_rfl⟩)\n                                            (measurable_pi_apply ⟨k, Finset.mem_Iic.mpr le_rfl⟩);\n                                        L ∘ₖ\n                                            ((ProbabilityTheory.Kernel.partialTraj κ 0 n).map fun h =>\n                                                  h ⟨n, Finset.mem_Iic.mpr le_rfl⟩).comap\n                                              (fun s x => s)\n                                              (measurable_pi_lambda (fun s x => s) fun a => measurable_id') =\n                                          R n) ∧\n                                      (Q = H → L = T → ∀ (n : ℕ), R n = T)",
    "statement_sha256": "1ee10f9d9dad5b69734cc4533b46f7ee1514f6a2033468e4a33e598fb50a8502",
