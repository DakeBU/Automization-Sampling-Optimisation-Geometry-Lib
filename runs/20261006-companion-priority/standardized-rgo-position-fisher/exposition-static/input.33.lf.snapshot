          "reconstructed": "Q(g, eta, eps, y, fuel, x) returning Option(E × ℕ).",
          "relation": "same",
          "evidence": "The definition body and reconstructed argument order agree. The center remains fixed during recursion; only fuel and current point change."
        },
        {
          "slot": "domains",
          "original": "Real normed vector space, arbitrary E-valued oracle, real parameters and natural fuel.",
          "reconstructed": "NormedAddCommGroup E and NormedSpace ℝ E; g:E→E; eta,eps:ℝ; fuel:ℕ.",
          "relation": "same",
          "evidence": "No finite-dimensional, complete, inner-product or measurable-space structure is required by proximalQuery."
        },
        {
          "slot": "quantifiers",
          "original": "The construction is defined for every supplied oracle, parameter pair, center, fuel and current point.",
          "reconstructed": "A function accepting each of these arguments without propositional premises.",
          "relation": "same",
          "evidence": "The displayed Lean type and definition introduce no existential choices of parameters or assumptions restricting their values."
        },
        {
