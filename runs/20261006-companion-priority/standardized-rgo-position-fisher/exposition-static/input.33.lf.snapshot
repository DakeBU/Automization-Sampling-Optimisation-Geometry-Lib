    {
      "id": "transport:gibbs-prox",
      "kind": "concept-bridge",
      "label": "One energy: minimizer or Gibbs law",
      "status": "proposal",
      "subtitle": "shared-energy span",
      "summary": "Optimization selects a minimum; an RGO draws from a normalized exponential of the same energy. This is a span through a common energy, not an equivalence of outputs.",
      "formula": "\\begin{gathered}E_{y,h}(x)=g(x)+\\frac{\\|x-y\\|^2}{2h}\\\\\\operatorname{prox}_{hg}(y)\\in\\arg\\min E_{y,h}\\\\Q_{y,h}(dx)\\propto e^{-E_{y,h}(x)}dx\\end{gathered}",
      "details": [
        {
          "label": "Evidence boundary",
          "value": "Literature/structural correspondence; no Lean-certified functor or theorem transfer."
        },
