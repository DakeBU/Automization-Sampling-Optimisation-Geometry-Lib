          "end_line": 1613,
          "literal_LF_sha256": "91b812e49e2fbb5c5f35fb1b3b88420127d903aa2f98314c880213dba641fda7",
          "literal": "theorem bernoulli_logSobolev_app {f : ℝ → ℝ} (hf : CompactlySupportedSmooth f) (n : ℕ) :\n    LogSobolev.entropy (rademacherLaw (n + 1)).toMeasure (fun x => (f x)^2) ≤\n    (1/2) * ∑ i : Fin (n + 1), ∫ x,\n        (f (rademacherSumProd (n + 1) x) - f (rademacherSumShifted (n + 1) i x))^2\n          ∂rademacherProductMeasure (n + 1) := by\n"
        },
        {
          "input_role": "prospective37_signature_only",
          "start_line": 10,
          "end_line": 15,
          "literal_LF_sha256": "1eb2e32f2f2217018ae2c9520fff4ab05470ff707e17408a503cb7f2fa0f7a19",
          "literal": "      (fun ε : Fin n → Bool => ∑ j : Fin n,\n        (f (S n (Function.update ε j (!ε j))) - f (S n ε))^2) (μ n)) ∧\n    Tendsto (fun n : ℕ => ∫ ε : Fin (n+1) → Bool,\n      (∑ j : Fin (n+1),\n        (f (S (n+1) (Function.update ε j (!ε j))) - f (S (n+1) ε))^2)\n      ∂μ (n+1)) atTop (𝓝 (4 * ∫ x, (deriv f x)^2 ∂γ))\n"
        }
      ]
    }
