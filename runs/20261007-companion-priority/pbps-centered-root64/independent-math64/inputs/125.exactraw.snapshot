    {
      "id": "transport:proximal-half-turn",
      "label": "Proximal geometry meets discrete hypocoercivity",
      "family_ids": [
        "family:discrete-hypocoercivity"
      ],
      "tails": [
        "concept:sampling"
      ],
      "heads": [
        "concept:mcmc"
      ],
      "relation_kind": "model-specific adapter candidate",
      "status": "not-Lean-certified",
      "formula": "\\mathsf K=\\mathsf U[\\mathsf P+(1-\\rho)\\mathsf H_{\\perp\\perp}]",
      "mechanism": "An augmented reflection U, conditional projection P, and conditional half-turn H form a discrete Markov operator. A modified L2 corrector exposes transfer between undamped macro and damped micro modes.",
      "hypothesis_map": "Positive conditional normalizers; non-explosive harmonic bounce process; invariant augmented law; centered L2 domain; macroscopic gap and half-turn operator estimate.",
      "conclusion_map": "Reuse the modified-energy mechanism through explicit discrete operator bounds before proving chi-square block contraction and marginal TV decay.",
      "failure_boundary": "Not the ordinary proximal chain or vanilla BPS; the unrefreshed conditional process alone need not mix. Continuous-time DMS/Fan–Li–Lu rates do not transfer verbatim.",
      "source_ids": [
        "pbps-2026",
        "fan-li-lu-2026"
      ],
      "shared_stages": [
        "linear-algebra",
        "measure",
        "kernel-algebra",
        "entropy"
      ],
      "formal_refs": [],
      "url": "example-cases/samplewiki/companions/proof-delta.html",
      "review": {
