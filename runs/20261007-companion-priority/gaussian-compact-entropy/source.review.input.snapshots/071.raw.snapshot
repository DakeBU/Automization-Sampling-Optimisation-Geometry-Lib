from pathlib import Path
import json,hashlib,subprocess,datetime,re
R=Path('runs/20261007-companion-priority/gaussian-compact-entropy-preproof-review');P=Path('runs/20261007-companion-priority/gaussian-compact-entropy-preread');D=Path('.astis/compact-entropy36');V='picard_commit_verifier_20261005'
def sha(b):return hashlib.sha256(b).hexdigest()
def desc(p):
 b=Path(p).read_bytes();return {'path':Path(p).as_posix(),'raw_sha256':sha(b),'lf_sha256':sha(b.replace(b'\r\n',b'\n')),'bytes':len(b)}
def j(p):return json.loads(Path(p).read_text(encoding='utf-8'))
def w(p,d):Path(p).write_bytes((json.dumps(d,ensure_ascii=False,indent=2)+'\n').encode())
assert not (R/'statement.review.json').exists()
w(R/'lease.open.json',{'status':'OPEN','reviewer_id':V,'compiler':'NOT_STARTED','read':'Prospective signature/typecheck only + own CLOSED independent primary/API contract','write':'Own statement review/contract/input snapshots only','canonical_mutations':False})
contract=j(P/'source-detail-packet.json')
assert desc(P/'source-detail-packet.json')['raw_sha256']=='e7f59409ef10c3ae368e5c777180a15d0fedef8be0b85df97bb5da42072605e0'
assert contract['leases']['read']==contract['leases']['write']=='CLOSED'
for row in contract['input_artifacts']:
 assert desc(row['raw_snapshot'])['raw_sha256']==row['raw_sha256'] and sha(Path(row['lf_snapshot']).read_bytes())==row['lf_sha256']
sig=(D/'signature.prospective.txt').read_text(encoding='utf-8');probe=(D/'StatementProbe.lean').read_text(encoding='utf-8');status=j(D/'typecheck.0.status.json')
assert status['exit_code']==0 and status['compiler_lease']=='CLOSED'
assert desc(D/'typecheck.0.log')['raw_sha256']==status['log_raw_sha256']
assert sig.startswith('theorem compact_count_gaussian_entropy_limits\n    (f : ℝ → ℝ) (hf : ContDiff ℝ 2 f) (hs : HasCompactSupport f) :\n')
tail=sig.split('(hs : HasCompactSupport f) :\n',1)[1].rstrip()
assert probe.split('#check (∀ (f : ℝ → ℝ), ContDiff ℝ 2 f → HasCompactSupport f →\n',1)[1]==tail+'\n : Prop)\n'
assert ':= by' not in sig and not re.search(r'\b(sorry|admit|axiom)\b',probe)
assert sig.count('    Tendsto ')==4 and sig.count('Integrable (fun')==6 and '∀ n : ℕ' in sig
inputfiles=[D/'signature.prospective.txt',D/'StatementProbe.lean',D/'typecheck.0.log',D/'typecheck.0.status.json',P/'source-detail-packet.json',P/'run.closed.json',P/'lease.closed.json',Path('lean-toolchain'),Path('lake-manifest.json')]
inputs=[]
for i,p in enumerate(inputfiles):
 b=p.read_bytes();a=R/f'input.{i:03}.raw.snapshot';l=R/f'input.{i:03}.lf.snapshot';a.write_bytes(b);l.write_bytes(b.replace(b'\r\n',b'\n'));inputs.append({**desc(p),'raw_snapshot':a.as_posix(),'lf_snapshot':l.as_posix()})
primary={'schema_version':1,'artifact_kind':'independent-primary-first-prospective-statement-contract','status':'accepted-statement-only','reviewer_id':V,'primary_preread_reused':desc(P/'source-detail-packet.json'),'reuse_scope':'All28 immutable primary/SLT/pinnedMathlib inputs rechecked by frozen raw/LF snapshots. No prospective36 proof body or graph, current35 implementation/blind/source verdict read.','source_contract':'SPHMC S4.E6 uses Gaussian LSI+independent Talagrand for actual noncompact standardized-RGO density. This declaration is an authored C_c² analytic core needed by a Bernoulli/CLT proof, not printedSPHMC nor full source-domain LSI.','analytic_binders':[{'name':'f','type':'Real -> Real','scope':'every real function, signed values/zeros admitted'},{'name':'hf','type':'ContDiff Real 2 f','scope':'genuine C², not C-infinity'},{'name':'hs','type':'HasCompactSupport f','scope':'authored compact core, visible new theorem scope, not additional paper hypothesis'}],'derived_objects':contract['fixed_definitions'],'dependency_edge_not_public_binder':['Actual35 law/map/CLT producer','Mathlib compact BCF/real tlogt continuity/derivative support and continuity','Actual map integral and L1 domain APIs'],'outputs':'Three true Gaussian observer L1 domains, same three true finite-count observer L1 domains for EVERY N including0, successor limits of mass/entropy integrand/derivative-square and homogeneous entropy.','excluded':['Full coordinate-flip energy factor4 limit','Gaussian LSI final comparison','Noncompact actualsqrtRN/cutoff/hilbert extension','T2/W2/bias/main/work/composition','Query-cost transfer or numerical runtime'],'proof_implementation_admission':False,'input_artifacts':inputs}
w(R/'primary.contract.json',primary)
semantic={'objects':'Exactly f and its real derivative; dependent finite Bool cube, cardinal reciprocal times count, actual sign-sum over inverse sqrtN; gamma=gaussianReal0,1. No supplied law or generic substitute.','domains':'Real functions and measures, Bochner L1 for three specified real observers. Bool cube canonical pi measurable structure. Real logs zero-totalized; continuous tlogt ensures zeros valid.','quantifiers':'Universally f with exactly C² and genuine compact support. Domain outputs forallN including0, four limits atTop of successorN. All quantities use same f and literal μ/S/γ.','assumptions':'Only explicit hf/hs after real f. No supplied probability/normalization/map/moment/CLT/limit/L1/cost certificate, no fpositive or normalizedf assumption.','conclusion':'Exact three Gaussian+forallN three count L1 outputs and four specified real Tendsto conclusions. Derivative-observer expectation tends without claiming full discrete flip-energy comparison.','scopes':'μ n and S n depend on same n and cube. Every limit uses n+1 for both map and measure; N0 appears only in L1 forallN and remains actualdirac0 law. Entropy correction uses same integral as both prefactor and log argument.','constant_dependencies':'No adjustable constant. Gaussian mean0 variance1, squarepower2 and actualsqrt(N) inverse. No mass normalization or factor4/2 claim in these limits.'}
review={'schema_version':1,'reviewer_id':V,'status':'accepted-statement-only','verdict':'ACCEPTED_SCOPED_PROSPECTIVE_STATEMENT_ONLY','blocking':False,'blockers':[],'independent_from_formalizer':True,'formalizer':'companion_root_20261005','observed_HEAD':subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),'declaration_name':'compact_count_gaussian_entropy_limits','signature':desc(D/'signature.prospective.txt'),'signature_text':sig,'type_only_probe':desc(D/'StatementProbe.lean'),'signature_probe_exact_tail_match':True,'typecheck':{'status':desc(D/'typecheck.0.status.json'),'log':desc(D/'typecheck.0.log'),'exit_code':0,'reuse':'Existing exact #check-only compiler result reused; no independent compiler or theorem proof credit claimed.'},'primary_contract':desc(R/'primary.contract.json'),'semantic_slots':semantic,'independent_checks':['Raw signature/probe exact proposition-tail identity, including terminalnewline and all binder types.','Count measure and +/-signsum agree byte-semantic contract, positive cardinal finite evenN0; scale n+1 consistently in every limit.','Gaussian variance1 exactly, three domain and four limit outputs rather than premises.','Zero mass entropy remains valid because tlogt continuous at0; no division by f² integral or positive integral premise.','No final law/limit/domain certificate binder and no fullflipenergy4 claim. CompactC2 scope explicit and not promoted to noncompact32 source result.'],'statement_is_not_mathematical_proof':True,'source_topology_admission_not_performed':True,'no_source_graph_or_future_body_exposure':True,'current35_body_blind_source_verdict_read':False,'canonical_mutations':[],'compiler_started':False,'remaining_boundary':primary['excluded'],'input_artifacts':inputs,'read_lease':'CLOSED','write_lease':'CLOSED','compiler_lease':'NOT_STARTED_CLOSED','Python_lease':'CLOSED'}
w(R/'statement.review.json',review)
for row in inputs:assert desc(row['path'])['raw_sha256']==row['raw_sha256']
run={'status':'CLOSED','reviewer_id':V,'review':desc(R/'statement.review.json'),'primary_contract':desc(R/'primary.contract.json'),'signature':review['signature'],'input_count':len(inputs),'prior_source_inputs':28,'all_inputs_rechecked':True,'compiler_started':False,'read':'CLOSED','write':'CLOSED','compiler':'NOT_STARTED_CLOSED','Python':'CLOSED','canonical_mutations':[],'completed_utc':datetime.datetime.now(datetime.timezone.utc).isoformat()}
w(R/'run.closed.json',run);w(R/'lease.closed.json',{'status':'CLOSED','read':'CLOSED','write':'CLOSED','compiler':'NOT_STARTED_CLOSED','Python':'CLOSED','review':run['review'],'run':desc(R/'run.closed.json')})
print(json.dumps({'status':review['status'],'review':run['review'],'signature':review['signature'],'leases':'CLOSED'}))
