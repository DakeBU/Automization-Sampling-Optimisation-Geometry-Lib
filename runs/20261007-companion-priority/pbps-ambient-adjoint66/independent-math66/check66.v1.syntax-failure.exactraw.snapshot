import json,os,pathlib,re,subprocess,sys
sys.path.insert(0,str(pathlib.Path(__file__).resolve().parent))
from math66 import R,O,D,H,BASE,ACTOR,read,write,pin,check,frozen,sha,canon,now
M='AutoSamplingTheory/ExampleCases/ProximalBPS/AmbientAdjointCorrector.lean';T='Tests/ProximalBPSAmbientAdjointCorrector.lean'
manifest=read(O/'inputs.manifest.json')
for x in manifest['inputs']:check(x['RAW_snapshot']);check(x['LF_snapshot'])
m=json.loads(frozen(D.relative_to(R).as_posix()+'/math-freeze.json'));represent=json.loads(frozen(H.relative_to(R).as_posix()+'/root.type-representation66.adoption.json'));rows=[]
for n,p in enumerate([M,T]):
 b=frozen(p);s=b.decode();x=m['private_statement_definitions'][n];private=s[s.index('private def '):s.index('\n\n\ntheorem ')].rstrip()+'\n';public=s[s.index('\ntheorem ')+1:s.index(' := by\n')]+'\n';expanded=private.replace('private def ','theorem ',1).replace('_statement\n','\n',1).replace(' : Prop :=\n',' :\n',1);header=frozen(H.relative_to(R).as_posix()+f'/header{n}.lean')
 assert private==x['definition'] and sha(private.encode())==x['raw_sha256'];assert public==x['actual_public_header'];assert expanded==x['expanded_statement'] and expanded.encode()==header
 rr=represent['exact_statement_mappings'][n];assert sha(private.encode())==rr['private_literal_definition_RAW_sha256'] and sha(public.encode())==rr['actual_public_header_RAW_sha256'] and sha(header)==rr['expanded_original_header_RAW_sha256']
 private_binders=private[private.index('\n'):private.index(' : Prop :=\n')];name=private.splitlines()[0].split()[-1];public_binders=public[public.index('\n'):public.index(' : '+name+' ')];assert private_binders==public_binders
 assert len(re.findall(r'^private def ',s,re.M))==1 and len(re.findall(r'^theorem ',s,re.M))==1 and not re.search(r'^private (?:theorem|lemma|axiom|opaque)',s,re.M)
 assert not re.search(r'\b(?:sorry|admit|axiom)\b|Prop\s*:=\s*True|:=\s*trivial',s.replace('#print axioms',''),re.M)
 expected='AutoSamplingTheory.ExampleCases.ProximalBPS.'+('PolarIsometry' if n==0 else 'AmbientAdjointCorrector');assert re.findall(r'^import (.+)$',s,re.M)==[expected]
 rows.append({'path':p,'candidate_RAW_sha256':sha(b),'private_literal_definition_RAW_sha256':sha(private.encode()),'actual_public_header_RAW_sha256':sha(public.encode()),'expanded_original_header_RAW_sha256':sha(header),'same_public_binders_and_exact_literal_expansion':True,'private_Prop_definitions':1,'private_mathematical_providers':0,'public_mathematical_declarations':1,'single_actual_parent_import':expected,'whole_file_fakeclosure_matches':[]})
lesson=json.loads(frozen('website/content/declaration_lessons/pbps-ambient-adjoint-corrector.json'))['units'][0];literal=[]
assert len(lesson['steps'])==6
for n,step in enumerate(lesson['steps'],1):
 reg=step['lean_source_region'];b=frozen(reg['path']);s=b.decode();body_start=s[:s.index(' := by\n')].count('\n')+1;assert reg['start_line']>body_start
 excerpt=b''.join(b.splitlines(keepends=True)[reg['start_line']-1:reg['end_line']]);assert sha(b)==reg['source_raw_sha256'] and excerpt.decode()==step['lean'] and sha(excerpt)==reg['exact_code_raw_sha256'];literal.append({'step':n,'title':step['title'],'formula':step['formula'],'source_region':reg,'whole_file_RAW_and_line_span_RAW_are_distinct_bindings':True,'literal_BODY_match':True})
ad=represent;rp=H/'independent-type-diagnosis66';r=json.loads(frozen(rp.relative_to(R).as_posix()+'/review-run.json'));rh=r.pop('run_sha256');assert sha(canon(r))==rh==ad['whole_logical_run_sha256'];assert sha(frozen(rp.relative_to(R).as_posix()+'/review-run.json'))==ad['complete_RAW_review_sha256'];assert sha(frozen(rp.relative_to(R).as_posix()+'/complete-RAW-decisions.json'))==ad['complete_RAW_decision_sha256'];assert sha(frozen(rp.relative_to(R).as_posix()+'/lease.final.json'))==ad['final_lease_RAW_sha256'];assert ad['owned_files']==147 and ad['prior_bare_unknown_tactic_type_credit_withdrawn'] and not ad['kernel_proof_credit']
parentpins=[]
for p in ['AutoSamplingTheory/ExampleCases/ProximalBPS/PolarIsometry.lean','AutoSamplingTheory/ExampleCases/ProximalBPS/CenteredRootOrderInverse.lean']:
 g=subprocess.check_output(['git','show',BASE+':'+p],cwd=R);assert g==frozen(p);parentpins.append({'path':p,'base':BASE,'exact_Git_RAW_sha256':sha(g),'unchanged_accepted_parent':True})
APIS=['.lake/packages/mathlib/Mathlib/MeasureTheory/Function/ConditionalExpectation/CondexpL2.lean','.lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/Adjoint.lean','.lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/Projection/Basic.lean','AutoSamplingTheory/TechnicalLemmas/Measure/L2Expectation.lean']
api=[]
for i,p in enumerate(APIS):
 src=R/p;b=src.read_bytes();a=O/'api-inputs'/f'{i}.RAW.snapshot';l=O/'api-inputs'/f'{i}.LF.snapshot';a.parent.mkdir(exist_ok=True);a.write_bytes(b);l.write_bytes(b.replace(b'\r\n',b'\n'));api.append({'original':pin(src),'RAW_snapshot':pin(a),'LF_snapshot':pin(l)})
write('inputs.api-supplement.json',{'schema':'math66-actual-used-API-inputs-v1','inputs':api,'Mathlib_commit':subprocess.check_output(['git','-C','.lake/packages/mathlib','rev-parse','HEAD'],cwd=R).decode().strip(),'read_boundaries':{'CondexpL2':'definition68–70 and selfadjoint106–109: orthogonal projection; no extra input measure premise','Adjoint':'adjoint_inner_right127; Gram norm152–155; composition138; Hilbert completeness internally supplied','Projection':'starProjection_orthogonal_val196–199 and Pythagoras557–560','L2Expectation':'one and inner_one_eq_integral require finite measure, supplied by internal hJ'}}})
write('structural-math-check.result.json',{'schema':'independent-precommit-math66-structural-check-v1','status':'PASS','actual_pid':os.getpid(),'base':BASE,'candidate_commit':'UNCOMMITTED','whole_main_and_Test_read':True,'statement_representation':rows,'all6_literal_BODY_formula_steps':literal,'CLOSED147_representation_only':{'whole':rh,'complete_RAW_review':ad['complete_RAW_review_sha256'],'complete_RAW_decisions':ad['complete_RAW_decision_sha256'],'prior_type_credit_withdrawn':True,'no_mathematical_proof_credit_from_diagnosis':True},'unchanged_accepted65_parent_Git_RAW':parentpins,'no_source66_verdict_consumed':True,'own_initial_observer_query_note':'A preliminary public-header comparison omitted its terminating LF and reported false at EXIT0; exact checked header extraction includes LF and matches the independently sealed RAW. No source or candidate change.','utc':now()})
