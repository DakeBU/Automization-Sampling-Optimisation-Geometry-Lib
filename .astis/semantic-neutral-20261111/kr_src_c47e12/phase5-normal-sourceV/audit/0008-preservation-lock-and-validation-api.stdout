114: def file_lock(path: Path) -> Iterator[None]:
115:     """Take a cross-process exclusive lock associated with ``path``."""
116: 
117:     canonical = os.path.normcase(str(path.resolve()))
118:     lock_root = ROOT / ".astis" / "locks"
119:     lock_root.mkdir(parents=True, exist_ok=True)
120:     lock_path = lock_root / (hashlib.sha256(canonical.encode("utf-8")).hexdigest() + ".lock")
121:     with lock_path.open("a+b") as handle:
122:         if os.name == "nt":
123:             # Byte-range locks may extend beyond EOF, including on a new empty
124:             # lock file. Always lock byte zero, independent of append position.
125:             handle.seek(0)
126:             while True:
127:                 try:
128:                     msvcrt.locking(handle.fileno(), msvcrt.LK_NBLCK, 1)
129:                     break
130:                 except OSError as exc:
131:                     if exc.errno != errno.EACCES:
132:                         raise
133:                     # LK_LOCK gives up after ten attempts; match flock's
134:                     # blocking behavior without swallowing unrelated failures.
135:                     time.sleep(0.05)
136:         else:
137:             fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
138:         try:
139:             yield
140:         finally:
141:             if os.name == "nt":
142:                 handle.seek(0)
143:                 msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)
144:             else:
145:                 fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
146: 
