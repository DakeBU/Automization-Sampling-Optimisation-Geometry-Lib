</details><details class="declaration" id="decl-autosamplingtheory-technicallemmas-functionalinequalities-bernoullilogso-47c88ed80f">
  <summary><span class="kind">theorem</span> <code>AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.BernoulliLogSobolev.sum_fin_succ_bool_eq_sum_snoc</code> <span class="status status-yellow">Partial</span> <span class="status status-gray">Not mapped</span></summary>
  <div class="declaration-content">
    <p class="muted">No declaration docstring.</p>
    <pre class="code-block"><code class="language-lean">private theorem sum_fin_succ_bool_eq_sum_snoc {n : ℕ} (f : (Fin (n+1) → Bool) → ℝ) :
    ∑ ε : Fin (n+1) → Bool, f ε =
    ∑ ε&#x27; : Fin n → Bool, (f (Fin.snoc ε&#x27; true) + f (Fin.snoc ε&#x27; false)) := by
  -- Use Fin.snocEquiv: (Fin (n+1) → α) ≃ α × (Fin n → α) at last position
  -- But we need (Fin n → α) × α, so use Prod.swap
  let h_equiv : (Fin (n+1) → Bool) ≃ (Fin n → Bool) × Bool :=
    (Fin.snocEquiv (fun _ =&gt; Bool)).symm.trans (Equiv.prodComm _ _)
  calc ∑ ε : Fin (n+1) → Bool, f ε
      = ∑ p : (Fin n → Bool) × Bool, f (h_equiv.symm p) := by
          rw [Fintype.sum_equiv h_equiv.symm]
          simp
    _ = ∑ ε&#x27; : Fin n → Bool, ∑ b : Bool, f (h_equiv.symm (ε&#x27;, b)) := by
          rw [Fintype.sum_prod_type]
    _ = ∑ ε&#x27; : Fin n → Bool, (f (h_equiv.symm (ε&#x27;, true)) + f (h_equiv.symm (ε&#x27;, false))) := by
          congr 1
          ext ε&#x27;
          simp only [Fintype.sum_bool]
    _ = ∑ ε&#x27; : Fin n → Bool, (f (Fin.snoc ε&#x27; true) + f (Fin.snoc ε&#x27; false)) := by
          congr 1</code></pre>
    <p class="source-links"><a href="../modules/autosamplingtheory-technicallemmas-functionalinequalities-bernoullilogsobolev.html#complete-module-source">AutoSamplingTheory/TechnicalLemmas/FunctionalInequalities/BernoulliLogSobolev.lean:52</a><span>local preview source</span></p>
    
  </div>
</details><details class="declaration" id="decl-autosamplingtheory-technicallemmas-functionalinequalities-bernoullilogso-6879d5975b">
  <summary><span class="kind">theorem</span> <code>AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.BernoulliLogSobolev.bernoulli_integral_succ_split</code> <span class="status status-yellow">Partial</span> <span class="status status-gray">Not mapped</span></summary>
  <div class="declaration-content">
    <p class="muted">No declaration docstring.</p>
    <pre class="code-block"><code class="language-lean">private theorem bernoulli_integral_succ_split {n : ℕ} (f : (Fin (n+1) → Bool) → ℝ) :
    ∫ ε, f ε ∂(bernoulliUniform (n+1)) =
    ∫ ε&#x27;, (f (Fin.snoc ε&#x27; true) + f (Fin.snoc ε&#x27; false)) / 2 ∂(bernoulliUniform n) := by
  rw [bernoulli_integral_eq_sum, bernoulli_integral_eq_sum]
  rw [sum_fin_succ_bool_eq_sum_snoc]
  rw [pow_succ]
  rw [Finset.sum_div]
  -- Goal: ∑ i, (f true + f false) / (2^n * 2) = (∑ i, (f true + f false) / 2) / 2^n
  -- Rewrite RHS: (∑ (x/2)) / 2^n = ∑ (x / (2 * 2^n)) = ∑ (x / (2^n * 2))
  rw [Finset.sum_div]
  congr 1
  ext i
  ring</code></pre>
    <p class="source-links"><a href="../modules/autosamplingtheory-technicallemmas-functionalinequalities-bernoullilogsobolev.html#complete-module-source">AutoSamplingTheory/TechnicalLemmas/FunctionalInequalities/BernoulliLogSobolev.lean:72</a><span>local preview source</span></p>
    
