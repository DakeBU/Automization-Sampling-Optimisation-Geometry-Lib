{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Actual successful normal V execution manifest; specification only, not an execution record",
  "type": "object",
  "required": [
    "actor",
    "normal_API_calls",
    "exact_append_sha256",
    "verified_commit",
    "publication_binding_sha256",
    "accepted_audit_sha256",
    "source_review_run_sha256",
    "actual_V_append",
    "before_ledger",
    "after_ledger",
    "elapsed_seconds",
    "receipts",
    "own_cell_projection",
    "raw_old_ledger_prefix_preserved",
    "proof_owner",
    "exact_append_path",
    "before_ledger_sha256",
    "after_ledger_sha256"
  ],
  "properties": {
    "actor": {
      "const": "/root/source_reader_9a6d2f"
    },
    "normal_API_calls": {
      "const": 1
    },
    "exact_append_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verified_commit": {
      "const": "ab8b47caed9f781191f8408154cd355c7e7c104c"
    },
    "publication_binding_sha256": {
      "const": "69c4f115a417c0aea6a8ebc9384cfc66ff07e6fae92de806831b79075a4760fa"
    },
    "accepted_audit_sha256": {
      "const": "a101634a005e20e54c8791cf340b871a3adf79807b75b607f422957392b0bc6c"
    },
    "source_review_run_sha256": {
      "const": "1e40574a0ace4e7477aff07046611e5bfe70d5747b98d07fd52681a3b0e7dadb"
    },
    "actual_V_append": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes",
        "parsed_path",
        "created_at_from_actual_API"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "parsed_path": {
          "type": "string",
          "minLength": 1
        },
        "created_at_from_actual_API": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "before_ledger": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes",
        "lossless_archive"
      ]
    },
    "after_ledger": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes",
        "lossless_archive"
      ]
    },
    "elapsed_seconds": {
      "type": "object",
      "required": [
        "API_actual"
      ],
      "properties": {
        "API_actual": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "receipts": {
      "type": "object",
      "required": [
        "preflight",
        "preflight_sha256",
        "normal_API",
        "normal_API_sha256"
      ]
    },
    "own_cell_projection": {
      "type": "object",
      "required": [
        "path",
        "before_sha256",
        "after_sha256",
        "status"
      ],
      "properties": {
        "before_sha256": {
          "const": "61b6d11ca37531af201bed9f4872b6024b3cf788ce2c7631b23078053e64a6e7"
        },
        "after_sha256": {
          "const": "b040beefc7779754ff075dbd8de3c553f35d217a8923b193ebeeddcfe5465174"
        }
      }
    },
    "raw_old_ledger_prefix_preserved": {
      "const": true
    },
    "proof_owner": {
      "const": "huanjian_gc_20261109_fixed_spectrum_geometry"
    },
    "exact_append_path": {
      "type": "string",
      "minLength": 1
    },
    "before_ledger_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "after_ledger_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$comment": "No object satisfying this success schema is emitted during preparation. Event append path/hash/time and elapsed/receipts are populated only after the one real normal API call. The helper writes an actual-event manifest before its separately gated exact own-cell projection, then marks the projection applied after raw preservation checks."
}
