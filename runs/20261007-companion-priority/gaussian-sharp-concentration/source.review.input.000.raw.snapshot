    "file": "e46ea6518b151be180528574a4eb89d76b03aaf0b6f5e78784ffa9da7d0b1e75",
    "current_lean_module": "import Mathlib.Probability.Distributions.Gaussian.Fernique\nimport Mathlib.Probability.Distributions.Gaussian.Multivariate\nimport AutoSamplingTheory.TechnicalLemmas.Measure.IsotropicGaussianDensity\nimport Mathlib.Analysis.Calculus.LineDeriv.IntegrationByParts\nimport Mathlib.Analysis.Calculus.ParametricIntegral\nimport Mathlib.Analysis.InnerProductSpace.Calculus\nimport Mathlib.Analysis.SpecialFunctions.Trigonometric.Deriv\nimport Mathlib.MeasureTheory.Integral.Prod\nimport Mathlib.Probability.Moments.MGFAnalytic\nimport Mathlib.Analysis.Calculus.BumpFunction.Convolution\nimport Mathlib.Analysis.Calculus.ContDiff.Convolution\nimport AutoSamplingTheory.TechnicalLemmas.Probability.StdGaussianMoment\nimport Mathlib.Tactic\n\n/-!\n# Gaussian exponential domains and sharp standard Gaussian concentration\n\nFernique domination gives first moments and every signed centered exponential\nmoment on a real second-countable Banach Borel space. For the actual standard\nGaussian on a finite-dimensional real Hilbert space, rotation and conditional\nStein yield the sharp coefficient 1/2; normalized smooth convolution removes\nthe internal C1 restriction without changing the Lipschitz constant. SPHMC's\nactual Gaussian output consumes these results with its own Bochner mean.\nDegenerate dimensions, zero constants and all signed parameters are included.\n-/\n\nnoncomputable section\nopen MeasureTheory ProbabilityTheory\nopen scoped NNReal ENNReal Convolution Topology\n\nnamespace AutoSamplingTheory.TechnicalLemmas.Probability.GaussianLipschitzExponential\n\ntheorem integrable_and_integrable_exp_centered_of_lipschitz\n    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]\n    [CompleteSpace E] [SecondCountableTopology E] [MeasurableSpace E] [BorelSpace E]\n    {μ : MeasureTheory.Measure E} [ProbabilityTheory.IsGaussian μ]\n    {L : ℝ≥0} {f : E → ℝ} (hf : LipschitzWith L f) :\n    MeasureTheory.Integrable f μ ∧ ∀ t : ℝ,\n      MeasureTheory.Integrable\n        (fun x => Real.exp (t * (f x - ∫ z, f z ∂μ))) μ := by\n  have hbound (x : E) : |f x| ≤ (L : ℝ)*‖x‖+|f 0| := by\n    have hd := hf.dist_le_mul x 0\n    simp only [dist_eq_norm, sub_zero, Real.norm_eq_abs] at hd\n    calc\n      |f x| = |(f x-f 0)+f 0| := by congr 1; ring\n      _ ≤ |f x-f 0|+|f 0| := abs_add_le _ _\n      _ ≤ (L : ℝ)*‖x‖+|f 0| := add_le_add hd le_rfl\n  have hi : Integrable f μ :=\n    (((IsGaussian.integrable_id (μ := μ)).norm.const_mul (L : ℝ)).add\n      (integrable_const |f 0|)).mono' hf.continuous.aestronglyMeasurable\n        (ae_of_all _ fun x => by simpa only [Real.norm_eq_abs, Pi.add_apply, id_eq] using hbound x)\n  refine ⟨hi,fun t => ?_⟩\n  obtain ⟨C,hC,hint⟩ := IsGaussian.exists_integrable_exp_sq μ\n  let b : ℝ := |t| *(L : ℝ)\n  let D : ℝ := |t| *(|f 0|+|∫ z, f z ∂μ|)\n  have hb : 0 ≤ b := mul_nonneg (abs_nonneg _) L.coe_nonneg\n  have hdom (x : E) : t*(f x-∫ z, f z ∂μ) ≤\n      D+C⁻¹*b^2+C*‖x‖^2 := by\n    have hlin : t*(f x-∫ z, f z ∂μ) ≤ b*‖x‖+D := by\n      calc\n        _ ≤ |t*(f x-∫ z, f z ∂μ)| := le_abs_self _\n        _ = |t| *|f x-∫ z, f z ∂μ| := abs_mul _ _\n        _ ≤ |t| *(|f x|+|∫ z, f z ∂μ|) :=\n          mul_le_mul_of_nonneg_left (by simpa only [sub_zero, zero_sub, abs_neg] using\n            (abs_sub_le (f x) 0 (∫ z, f z ∂μ))) (abs_nonneg _)\n        _ ≤ |t| *((L : ℝ)*‖x‖+|f 0|+|∫ z, f z ∂μ|) :=\n          mul_le_mul_of_nonneg_left (add_le_add (hbound x) le_rfl) (abs_nonneg _)\n        _ = b*‖x‖+D := by dsimp [b,D]; ring\n    have hy : 2*‖x‖*b ≤ C*‖x‖^2+C⁻¹*b^2 := two_mul_le_add_mul_sq hC\n    have hnon : 0 ≤ b*‖x‖ := mul_nonneg hb (norm_nonneg _)\n    nlinarith\n  apply (hint.const_mul (Real.exp (D+C⁻¹*b^2))).mono'\n    (by fun_prop)\n  filter_upwards with x\n  rw [Real.norm_eq_abs,abs_of_pos (Real.exp_pos _),← Real.exp_add]\n  exact Real.exp_le_exp.mpr (hdom x)\n\n/- The zero-Lipschitz branch of the sealed sharp target is internal; this is\nnot an assertion of the remaining positive-dimensional concentration bound. -/\nprivate theorem centered_exp_integral_of_lipschitz_zero\n    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]\n    [CompleteSpace E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]\n    {f : E → ℝ} (hf : LipschitzWith 0 f) (t : ℝ) :\n    (∫ x, Real.exp (t * (f x - ∫ z, f z ∂stdGaussian E))\n      ∂stdGaussian E) = 1 := by\n  have hconst : f = fun _ => f 0 := by\n    funext x\n    have hd := hf.dist_le_mul x 0\n    simp only [NNReal.coe_zero, zero_mul] at hd\n    exact dist_eq_zero.mp (le_antisymm hd (dist_nonneg))\n  rw [hconst]\n  simp\n\nprivate theorem centered_exp_integral_of_subsingleton\n    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]\n    [CompleteSpace E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]\n    [Subsingleton E] (f : E → ℝ) (t : ℝ) :\n    (∫ x, Real.exp (t * (f x - ∫ z, f z ∂stdGaussian E))\n      ∂stdGaussian E) = 1 := by\n  have hconst : f = fun _ => f 0 := by\n    funext x\n    exact congrArg f (Subsingleton.elim x 0)\n  rw [hconst]\n  simp\n\n/- Radial domination is used on the actual product Gaussian when differentiating\nthe rotation integral. Its constants are domination constants, not the sharp\nconcentration coefficient. -/\nprivate theorem gaussian_radial_exponential_integrable\n    {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]\n    [CompleteSpace H] [SecondCountableTopology H] [MeasurableSpace H] [BorelSpace H]\n    {μ : Measure H} [IsGaussian μ] (a : ℝ) :\n    Integrable (fun x : H => Real.exp (a * ‖x‖)) μ := by\n  have hi := (integrable_and_integrable_exp_centered_of_lipschitz\n    (μ := μ) (lipschitzWith_one_norm : LipschitzWith 1 (norm : H → ℝ))).2 a\n  apply (hi.const_mul (Real.exp (a * ∫ x : H, ‖x‖ ∂μ))).congr\n  filter_upwards with x\n  rw [← Real.exp_add]\n  congr 1\n  ring\n\nprivate theorem gaussian_polynomial_radial_integrable\n    {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]\n    [CompleteSpace H] [SecondCountableTopology H] [MeasurableSpace H] [BorelSpace H]\n    {μ : Measure H} [IsGaussian μ] (a : ℝ) :\n    Integrable (fun x : H => (1 + ‖x‖)^2 * Real.exp (a * ‖x‖)) μ := by\n  apply (gaussian_radial_exponential_integrable (μ := μ) (a + 2)).mono' (by fun_prop)\n  filter_upwards with x\n  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]\n  have hs : (1 + ‖x‖)^2 ≤ (Real.exp ‖x‖)^2 :=\n    (sq_le_sq₀ (by positivity) (Real.exp_pos _).le).2\n      (by simpa only [add_comm] using Real.add_one_le_exp ‖x‖)\n  calc\n    _ ≤ (Real.exp ‖x‖)^2 * Real.exp (a * ‖x‖) :=\n      mul_le_mul_of_nonneg_right hs (Real.exp_pos _).le\n    _ = _ := by\n      rw [pow_two, ← Real.exp_add, ← Real.exp_add]\n      congr 1\n      ring\n\nsection GaussianDensity\nvariable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]\n    [CompleteSpace E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]\n\nprivate def standardWeight (x : E) : ℝ :=\n  ((Real.sqrt (2 * Real.pi))⁻¹) ^ Module.finrank ℝ E * Real.exp (-‖x‖^2 / 2)\n\nprivate theorem standardWeight_pos (x : E) : 0 < standardWeight x := by\n  dsimp [standardWeight]\n  positivity\n\nprivate theorem standardGaussian_density :\n    stdGaussian E = (volume : Measure E).withDensity\n      (fun x => ENNReal.ofReal (standardWeight x)) := by\n  have h := AutoSamplingTheory.TechnicalLemmas.Measure.IsotropicGaussianDensity.map_sqrt_smul_stdGaussian_eq_withDensity\n    (E := E) 1 (by norm_num)\n  simpa only [Real.sqrt_one, one_smul, Measure.map_id', mul_one,\n    standardWeight] using h\n\nprivate theorem standardGaussian_weighted_integral (g : E → ℝ) :\n    (∫ x, g x ∂stdGaussian E) = ∫ x, standardWeight x * g x := by\n  rw [standardGaussian_density]\n  rw [integral_withDensity_eq_integral_toReal_smul (by unfold standardWeight; fun_prop)\n    (ae_of_all _ fun _ => ENNReal.ofReal_lt_top) g]\n  apply integral_congr_ae\n  filter_upwards with x\n  simp only [ENNReal.toReal_ofReal (standardWeight_pos x).le, smul_eq_mul]\n\nprivate theorem standardGaussian_weighted_integrable {g : E → ℝ}\n    (hg : Integrable g (stdGaussian E)) :\n    Integrable (fun x => standardWeight x * g x) (volume : Measure E) := by\n  rw [standardGaussian_density] at hg\n  have h := (integrable_withDensity_iff (by unfold standardWeight; fun_prop)\n    (ae_of_all _ fun _ => ENNReal.ofReal_lt_top)).1 hg\n  simpa only [ENNReal.toReal_ofReal (standardWeight_pos _).le, mul_comm] using h\n\nprivate theorem standardWeight_hasFDerivAt (x : E) :\n    HasFDerivAt (standardWeight : E → ℝ)\n      (-(standardWeight x) • innerSL ℝ x) x := by\n  let c : ℝ := ((Real.sqrt (2 * Real.pi))⁻¹) ^ Module.finrank ℝ E\n  have h := (((hasFDerivAt_id x).norm_sq.const_mul (-1 / 2 : ℝ)).exp).const_mul c\n  convert h using 1\n  all_goals try rfl\n  · funext y\n    dsimp only [standardWeight, c, id]\n    congr 1\n    ring\n  · ext v\n    dsimp only [standardWeight, c, id]\n    simp only [smul_apply, smul_eq_mul, innerSL_apply_apply,\n      ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply]\n    have he : (-1 / 2 : ℝ) * ‖x‖^2 = -‖x‖^2 / 2 := by ring\n    rw [he]\n    ring\n\nprivate theorem standardGaussian_stein_lipschitz_c1\n    {f : E → ℝ} {L : ℝ≥0} (hf : ContDiff ℝ 1 f)\n    (hLip : LipschitzWith L f) (v : E) :\n    (∫ x, inner ℝ x v * f x ∂stdGaussian E) =\n      ∫ x, fderiv ℝ f x v ∂stdGaussian E := by\n  have hfi := (integrable_and_integrable_exp_centered_of_lipschitz\n    (μ := stdGaussian E) hLip).1\n  have hn : Integrable (fun x : E => ‖x‖) (stdGaussian E) := IsGaussian.integrable_id.norm\n  have hsq := (StdGaussianMoment.integrable_norm_sq_and_integral_stdGaussian (E := E)).1\n  have hbound (x : E) : |f x| ≤ (L : ℝ)*‖x‖+|f 0| := by\n    have hd := hLip.dist_le_mul x 0\n    simp only [dist_eq_norm, sub_zero, Real.norm_eq_abs] at hd\n    calc\n      |f x| = |(f x-f 0)+f 0| := by congr 1; ring\n      _ ≤ |f x-f 0|+|f 0| := abs_add_le _ _\n      _ ≤ (L : ℝ)*‖x‖+|f 0| := add_le_add hd le_rfl\n  have hixf : Integrable (fun x => inner ℝ x v*f x) (stdGaussian E) := by\n    apply (((hsq.const_mul (L : ℝ)).add (hn.const_mul |f 0|)).const_mul ‖v‖).mono'\n      (by fun_prop)\n    filter_upwards with x\n    change ‖inner ℝ x v*f x‖ ≤ ‖v‖*((L : ℝ)*‖x‖^2+|f 0| * ‖x‖)\n    rw [norm_mul, Real.norm_eq_abs (f x)]\n    calc\n      ‖inner ℝ x v‖*|f x| ≤ (‖x‖*‖v‖)*((L : ℝ)*‖x‖+|f 0|) :=\n        mul_le_mul (norm_inner_le_norm x v) (hbound x) (abs_nonneg _) (by positivity)\n      _ = _ := by ring\n  have hdf : Integrable (fun x => fderiv ℝ f x v) (stdGaussian E) := by\n    apply (integrable_const ((L : ℝ)*‖v‖)).mono'\n      ((hf.continuous_fderiv (by norm_num)).clm_apply continuous_const).aestronglyMeasurable\n    filter_upwards with x\n    exact (ContinuousLinearMap.le_opNorm _ _).trans\n      (mul_le_mul_of_nonneg_right (norm_fderiv_le_of_lipschitz ℝ hLip) (norm_nonneg _))\n  have hDw (x : E) : fderiv ℝ (standardWeight : E → ℝ) x v =\n      -standardWeight x*inner ℝ x v := by\n    rw [(standardWeight_hasFDerivAt x).fderiv]\n    simp only [smul_apply, smul_eq_mul, innerSL_apply_apply]\n  have hwp := standardGaussian_weighted_integrable hfi\n  have hwdf := standardGaussian_weighted_integrable hdf\n  have hwxf := standardGaussian_weighted_integrable hixf\n  have hDwf : Integrable (fun x => fderiv ℝ (standardWeight : E → ℝ) x v*f x)\n      (volume : Measure E) := by\n    convert hwxf.neg using 1\n    ext x\n    rw [hDw]\n    simp only [Pi.neg_apply]\n    ring\n  have hparts := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable hDwf hwdf hwp\n    (fun x _ => (standardWeight_hasFDerivAt x).differentiableAt)\n    (fun x _ => hf.differentiable_one x)\n  rw [standardGaussian_weighted_integral, standardGaussian_weighted_integral]\n  calc\n    (∫ x, standardWeight x*(inner ℝ x v*f x)) =\n        -(∫ x, fderiv ℝ (standardWeight : E → ℝ) x v*f x) := by\n      rw [← integral_neg]\n      apply integral_congr_ae\n      filter_upwards with x\n      rw [hDw]\n      ring\n    _ = ∫ x, standardWeight x*fderiv ℝ f x v := hparts.symm\n\n/- This uses Stein only for the affine pullback of the Lipschitz observable.\nThe exponential test function is not asserted to be globally Lipschitz. -/\nprivate theorem standardGaussian_stein_affine\n    {f : E → ℝ} {L : ℝ≥0} (hf : ContDiff ℝ 1 f)\n    (hLip : LipschitzWith L f) (c s : ℝ) (u a : E) :\n    (∫ v, inner ℝ v a * f (c • u - s • v) ∂stdGaussian E) =\n      -s * ∫ v, fderiv ℝ f (c • u - s • v) a ∂stdGaussian E := by\n  have hca : ContDiff ℝ 1 (fun v : E => c • u - s • v) := by fun_prop\n  have hla : LipschitzWith (L * Real.nnabs s) (fun v : E => f (c • u - s • v)) := by\n    apply LipschitzWith.of_dist_le_mul\n    intro x y\n    calc\n      _ ≤ (L : ℝ) * dist (c • u - s • x) (c • u - s • y) := hLip.dist_le_mul _ _\n      _ = ((L * Real.nnabs s : ℝ≥0) : ℝ) * dist x y := by\n        simp only [dist_eq_norm]\n        rw [show (c • u - s • x) - (c • u - s • y) = s • (y - x) by module]\n        rw [norm_smul, Real.norm_eq_abs, norm_sub_rev]\n        simp only [NNReal.coe_mul, Real.coe_nnabs]\n        ring\n  have hd (v : E) :\n      fderiv ℝ (fun v : E => f (c • u - s • v)) v a =\n        -s * fderiv ℝ f (c • u - s • v) a := by\n    have ha := ((hasFDerivAt_id (𝕜 := ℝ) v).const_smul s).const_sub (c • u)\n    have hh := ((hf.differentiable_one _).hasFDerivAt.comp v ha).fderiv\n    simp only [Function.comp_def, Pi.smul_apply, id_eq] at hh\n    rw [hh]\n    simp\n  rw [standardGaussian_stein_lipschitz_c1\n    (f := fun v => f (c • u - s • v)) (hf.comp hca) hla a]\n  simp_rw [hd]\n  exact integral_const_mul _ _\n\nprivate theorem standardGaussian_rotation_integral\n    (θ : ℝ) {h : E × E → ℝ} (hh : Continuous h) :\n    (∫ p, h (ContinuousLinearMap.rotation θ p)\n      ∂(stdGaussian E).prod (stdGaussian E)) =\n      ∫ p, h p ∂(stdGaussian E).prod (stdGaussian E) := by\n  have hm := IsGaussian.map_rotation_eq_self\n    (μ := stdGaussian E) (integral_id_stdGaussian (E := E)) θ\n  have hi := integral_map (μ := (stdGaussian E).prod (stdGaussian E))\n    (ContinuousLinearMap.rotation θ).continuous.measurable.aemeasurable\n    hh.aestronglyMeasurable\n  rw [hm] at hi\n  exact hi.symm\n\nprivate def rotX (θ : ℝ) (p : E × E) : E :=\n  Real.cos θ • p.1 + Real.sin θ • p.2\n\nprivate def rotY (θ : ℝ) (p : E × E) : E :=\n  -Real.sin θ • p.1 + Real.cos θ • p.2\n\nprivate theorem norm_linear_pair_le_two {c s : ℝ}\n    (hc : |c| ≤ 1) (hs : |s| ≤ 1) (p : E × E) :\n    ‖c • p.1 + s • p.2‖ ≤ 2 * ‖p‖ := by\n  calc\n    _ ≤ ‖c • p.1‖ + ‖s • p.2‖ := norm_add_le _ _\n    _ = |c| * ‖p.1‖ + |s| * ‖p.2‖ := by simp only [norm_smul, Real.norm_eq_abs]\n    _ ≤ ‖p.1‖ + ‖p.2‖ := add_le_add\n      (by simpa only [one_mul] using mul_le_mul_of_nonneg_right hc (norm_nonneg p.1))\n      (by simpa only [one_mul] using mul_le_mul_of_nonneg_right hs (norm_nonneg p.2))\n    _ ≤ 2 * ‖p‖ := by linarith [norm_fst_le p, norm_snd_le p]\n\nprivate theorem norm_rotX_le (θ : ℝ) (p : E × E) : ‖rotX θ p‖ ≤ 2 * ‖p‖ :=\n  norm_linear_pair_le_two (Real.abs_cos_le_one θ) (Real.abs_sin_le_one θ) p\n\nprivate theorem norm_rotY_le (θ : ℝ) (p : E × E) : ‖rotY θ p‖ ≤ 2 * ‖p‖ :=\n  norm_linear_pair_le_two (by simpa only [abs_neg] using Real.abs_sin_le_one θ)\n    (Real.abs_cos_le_one θ) p\n\nprivate theorem rotX_hasDerivAt (θ : ℝ) (p : E × E) :\n    HasDerivAt (fun θ => rotX θ p) (rotY θ p) θ := by\n  exact ((Real.hasDerivAt_cos θ).smul_const p.1).add\n    ((Real.hasDerivAt_sin θ).smul_const p.2)\n\nprivate theorem lipschitz_growth_bound {f : E → ℝ} {L : ℝ≥0}\n    (hf : LipschitzWith L f) (x : E) : |f x| ≤ (L : ℝ) * ‖x‖ + |f 0| := by\n  have hd := hf.dist_le_mul x 0\n  simp only [dist_eq_norm, sub_zero, Real.norm_eq_abs] at hd\n  calc\n    |f x| = |(f x - f 0) + f 0| := by congr 1; ring\n    _ ≤ |f x - f 0| + |f 0| := abs_add_le _ _\n    _ ≤ (L : ℝ) * ‖x‖ + |f 0| := add_le_add hd le_rfl\n\nprivate theorem rotated_laplace_bound {f : E → ℝ} {L : ℝ≥0}\n    (hf : LipschitzWith L f) (t m θ : ℝ) (p : E × E) :\n    Real.exp (t * (f (rotX θ p) - m)) ≤\n      Real.exp (|t| * (|f 0| + |m|)) * Real.exp ((2 * |t| * (L : ℝ)) * ‖p‖) := by\n  rw [← Real.exp_add]\n  apply Real.exp_le_exp.mpr\n  have hfrot : |f (rotX θ p)| ≤ (L : ℝ) * (2 * ‖p‖) + |f 0| :=\n    (lipschitz_growth_bound hf _).trans\n      (add_le_add (mul_le_mul_of_nonneg_left (norm_rotX_le θ p) L.coe_nonneg) le_rfl)\n  calc\n    _ ≤ |t * (f (rotX θ p) - m)| := le_abs_self _\n    _ = |t| * |f (rotX θ p) - m| := abs_mul _ _\n    _ ≤ |t| * (|f (rotX θ p)| + |m|) :=\n      mul_le_mul_of_nonneg_left (abs_sub _ _) (abs_nonneg _)\n    _ ≤ |t| * ((L : ℝ) * (2 * ‖p‖) + |f 0| + |m|) :=\n      mul_le_mul_of_nonneg_left (add_le_add hfrot le_rfl) (abs_nonneg _)\n    _ = _ := by ring\n\nprivate theorem rotated_laplace_value_integrable {f : E → ℝ} {L : ℝ≥0}\n    (hf : LipschitzWith L f) (t m θ : ℝ) :\n    Integrable (fun p : E × E => f p.1 * Real.exp (t * (f (rotX θ p) - m)))\n      ((stdGaussian E).prod (stdGaussian E)) := by\n  let C : ℝ := (L : ℝ) + |f 0|\n  let B : ℝ := Real.exp (|t| * (|f 0| + |m|))\n  let A : ℝ := 2 * |t| * (L : ℝ)\n  have hcont := hf.continuous\n  apply ((gaussian_polynomial_radial_integrable\n    (μ := (stdGaussian E).prod (stdGaussian E)) A).const_mul (C * B)).mono'\n    (by unfold rotX; fun_prop)\n  filter_upwards with p\n  change ‖f p.1 * Real.exp (t * (f (rotX θ p) - m))‖ ≤\n    (C * B) * ((1 + ‖p‖)^2 * Real.exp (A * ‖p‖))\n  have hc : 0 ≤ C := by dsimp [C]; positivity\n  have hg : |f p.1| ≤ C * (1 + ‖p‖) := by\n    have h := (lipschitz_growth_bound hf p.1).trans\n      (add_le_add (mul_le_mul_of_nonneg_left (norm_fst_le p) L.coe_nonneg) le_rfl)\n    dsimp [C]\n    nlinarith [norm_nonneg p, abs_nonneg (f 0)]\n  have hp : 1 + ‖p‖ ≤ (1 + ‖p‖)^2 := by nlinarith [norm_nonneg p]\n  rw [norm_mul, Real.norm_eq_abs (f p.1), Real.norm_eq_abs,\n    abs_of_pos (Real.exp_pos _)]\n  calc\n    _ ≤ (C * (1 + ‖p‖)) * (B * Real.exp (A * ‖p‖)) :=\n      mul_le_mul hg (rotated_laplace_bound hf t m θ p) (Real.exp_pos _).le\n        (mul_nonneg hc (by positivity))\n    _ = (C * B * Real.exp (A * ‖p‖)) * (1 + ‖p‖) := by ring\n    _ ≤ (C * B * Real.exp (A * ‖p‖)) * (1 + ‖p‖)^2 :=\n      mul_le_mul_of_nonneg_left hp (by dsimp [B]; positivity)\n    _ = _ := by ring\n\nprivate def rotatedLaplaceDerivative (f : E → ℝ) (t m θ : ℝ) (p : E × E) : ℝ :=\n  f p.1 * (Real.exp (t * (f (rotX θ p) - m)) * (t * fderiv ℝ f (rotX θ p) (rotY θ p)))\n\nprivate theorem rotated_laplace_hasDerivAt {f : E → ℝ}\n    (hf : ContDiff ℝ 1 f) (t m θ : ℝ) (p : E × E) :\n    HasDerivAt (fun θ => f p.1 * Real.exp (t * (f (rotX θ p) - m)))\n      (rotatedLaplaceDerivative f t m θ p) θ := by\n  have hd := (hf.differentiable_one (rotX θ p)).hasFDerivAt.comp_hasDerivAt θ\n    (rotX_hasDerivAt θ p)\n  simpa only [Function.comp_def, rotatedLaplaceDerivative] using\n    (((hd.sub_const m).const_mul t).exp.const_mul (f p.1))\n\nprivate theorem rotated_laplace_derivative_bound {f : E → ℝ} {L : ℝ≥0}\n    (hf : LipschitzWith L f) (t m θ : ℝ) (p : E × E) :\n    ‖rotatedLaplaceDerivative f t m θ p‖ ≤\n      (2 * ((L : ℝ) + |f 0|) * Real.exp (|t| * (|f 0| + |m|)) * |t| * (L : ℝ)) *\n        ((1 + ‖p‖)^2 * Real.exp ((2 * |t| * (L : ℝ)) * ‖p‖)) := by\n  let C : ℝ := (L : ℝ) + |f 0|\n  let B : ℝ := Real.exp (|t| * (|f 0| + |m|))\n  let A : ℝ := 2 * |t| * (L : ℝ)\n  have hc : 0 ≤ C := by dsimp [C]; positivity\n  have hb : 0 < B := Real.exp_pos _\n  have hg : |f p.1| ≤ C * (1 + ‖p‖) := by\n    have h := (lipschitz_growth_bound hf p.1).trans\n      (add_le_add (mul_le_mul_of_nonneg_left (norm_fst_le p) L.coe_nonneg) le_rfl)\n    dsimp [C]\n    nlinarith [norm_nonneg p, abs_nonneg (f 0)]\n  have hd : |fderiv ℝ f (rotX θ p) (rotY θ p)| ≤ (L : ℝ) * (2 * ‖p‖) := by\n    rw [← Real.norm_eq_abs]\n    exact ((ContinuousLinearMap.le_opNorm _ _).trans\n      (mul_le_mul_of_nonneg_right (norm_fderiv_le_of_lipschitz ℝ hf) (norm_nonneg _))).trans\n        (mul_le_mul_of_nonneg_left (norm_rotY_le θ p) L.coe_nonneg)\n  change ‖f p.1 * (Real.exp (t * (f (rotX θ p) - m)) *\n    (t * fderiv ℝ f (rotX θ p) (rotY θ p)))‖ ≤\n      (2 * C * B * |t| * (L : ℝ)) * ((1 + ‖p‖)^2 * Real.exp (A * ‖p‖))\n  rw [Real.norm_eq_abs]\n  simp only [abs_mul, abs_of_pos (Real.exp_pos _)]\n  calc\n    _ ≤ (C * (1 + ‖p‖)) * ((B * Real.exp (A * ‖p‖)) *\n        (|t| * ((L : ℝ) * (2 * ‖p‖)))) := by\n      gcongr\n      exact rotated_laplace_bound hf t m θ p\n    _ = (2 * C * B * |t| * (L : ℝ) * Real.exp (A * ‖p‖)) * ((1 + ‖p‖) * ‖p‖) := by ring\n    _ ≤ (2 * C * B * |t| * (L : ℝ) * Real.exp (A * ‖p‖)) * (1 + ‖p‖)^2 :=\n      mul_le_mul_of_nonneg_left (by nlinarith [norm_nonneg p]) (by positivity)\n    _ = _ := by ring\n\nprivate theorem rotated_laplace_derivative_integrable {f : E → ℝ} {L : ℝ≥0}\n    (hf : ContDiff ℝ 1 f) (hLip : LipschitzWith L f) (t m θ : ℝ) :\n    Integrable (rotatedLaplaceDerivative f t m θ) ((stdGaussian E).prod (stdGaussian E)) := by\n  have hcf := hf.continuous\n  have hdf := hf.continuous_fderiv (by norm_num)\n  apply ((gaussian_polynomial_radial_integrable\n    (μ := (stdGaussian E).prod (stdGaussian E)) (2 * |t| * (L : ℝ))).const_mul\n      (2 * ((L : ℝ) + |f 0|) * Real.exp (|t| * (|f 0| + |m|)) * |t| * (L : ℝ))).mono'\n    (by unfold rotatedLaplaceDerivative rotX rotY; fun_prop)\n  exact ae_of_all _ (rotated_laplace_derivative_bound hLip t m θ)\n\nprivate theorem rotated_laplace_integral_hasDerivAt {f : E → ℝ} {L : ℝ≥0}\n    (hf : ContDiff ℝ 1 f) (hLip : LipschitzWith L f) (t m θ : ℝ) :\n    HasDerivAt\n      (fun θ => ∫ p : E × E, f p.1 * Real.exp (t * (f (rotX θ p) - m))\n        ∂(stdGaussian E).prod (stdGaussian E))\n      (∫ p, rotatedLaplaceDerivative f t m θ p\n        ∂(stdGaussian E).prod (stdGaussian E)) θ := by\n  have hcf := hf.continuous\n  have hdf := hf.continuous_fderiv (by norm_num)\n  have h := hasDerivAt_integral_of_dominated_loc_of_deriv_le\n    (μ := (stdGaussian E).prod (stdGaussian E))\n    (F := fun θ p => f p.1 * Real.exp (t * (f (rotX θ p) - m)))\n    (F' := fun θ => rotatedLaplaceDerivative f t m θ)\n    (s := Set.univ)\n    (bound := fun p =>\n      (2 * ((L : ℝ) + |f 0|) * Real.exp (|t| * (|f 0| + |m|)) * |t| * (L : ℝ)) *\n        ((1 + ‖p‖)^2 * Real.exp ((2 * |t| * (L : ℝ)) * ‖p‖)))\n    (by simp)\n    (Filter.Eventually.of_forall fun _ => by unfold rotX; fun_prop)\n    (rotated_laplace_value_integrable hLip t m θ)\n    (by unfold rotatedLaplaceDerivative rotX rotY; fun_prop)\n    (ae_of_all _ fun p θ _ => rotated_laplace_derivative_bound hLip t m θ p)\n    ((gaussian_polynomial_radial_integrable\n      (μ := (stdGaussian E).prod (stdGaussian E)) (2 * |t| * (L : ℝ))).const_mul _)\n    (ae_of_all _ fun p θ _ => rotated_laplace_hasDerivAt hf t m θ p)\n  exact h.2\n\nprivate theorem affine_stein_laplace_slice {f : E → ℝ} {L : ℝ≥0}\n    (hf : ContDiff ℝ 1 f) (hLip : LipschitzWith L f) (t m c s : ℝ) (u : E) :\n    (∫ v, f (c • u - s • v) *\n      (Real.exp (t * (f u - m)) * (t * fderiv ℝ f u v)) ∂stdGaussian E) =\n      -s * Real.exp (t * (f u - m)) * t *\n        ∫ v, fderiv ℝ f (c • u - s • v)\n          ((InnerProductSpace.toDual ℝ E).symm (fderiv ℝ f u)) ∂stdGaussian E := by\n  let a : E := (InnerProductSpace.toDual ℝ E).symm (fderiv ℝ f u)\n  have ha (v : E) : inner ℝ v a = fderiv ℝ f u v := by\n    rw [real_inner_comm]\n    exact InnerProductSpace.toDual_symm_apply\n  have he : (fun v => f (c • u - s • v) *\n      (Real.exp (t * (f u - m)) * (t * fderiv ℝ f u v))) =\n      fun v => (Real.exp (t * (f u - m)) * t) * (inner ℝ v a * f (c • u - s • v)) := by\n    funext v\n    rw [ha]\n    ring\n  rw [he, integral_const_mul, standardGaussian_stein_affine hf hLip c s u a]\n  ring\n\nprivate theorem affine_directional_derivative_integral_norm_le {f : E → ℝ} {L : ℝ≥0}\n    (hf : ContDiff ℝ 1 f) (hLip : LipschitzWith L f) (c s : ℝ) (u : E) :\n    ‖∫ v, fderiv ℝ f (c • u - s • v)\n      ((InnerProductSpace.toDual ℝ E).symm (fderiv ℝ f u)) ∂stdGaussian E‖ ≤ (L : ℝ)^2 := by\n  let a : E := (InnerProductSpace.toDual ℝ E).symm (fderiv ℝ f u)\n  have hn : ‖a‖ ≤ (L : ℝ) := by\n    dsimp [a]\n    rw [LinearIsometryEquiv.norm_map]\n    exact norm_fderiv_le_of_lipschitz ℝ hLip\n  have hb (v : E) : ‖fderiv ℝ f (c • u - s • v) a‖ ≤ (L : ℝ)^2 := by\n    calc\n      _ ≤ ‖fderiv ℝ f (c • u - s • v)‖ * ‖a‖ := ContinuousLinearMap.le_opNorm _ _\n      _ ≤ (L : ℝ) * (L : ℝ) :=\n        mul_le_mul (norm_fderiv_le_of_lipschitz ℝ hLip) hn (norm_nonneg _) L.coe_nonneg\n      _ = _ := by ring\n  have h := norm_integral_le_of_norm_le_const (μ := stdGaussian E) (ae_of_all _ hb)\n  simpa [a] using h\n\nprivate theorem rotation_inverse_first (θ : ℝ) (p : E × E) :\n    Real.cos θ • rotX θ p - Real.sin θ • rotY θ p = p.1 := by\n  have hc : Real.cos θ * Real.cos θ + Real.sin θ * Real.sin θ = 1 := by\n    nlinarith [Real.sin_sq_add_cos_sq θ]\n  calc\n    _ = (Real.cos θ * Real.cos θ + Real.sin θ * Real.sin θ) • p.1 +\n        (Real.cos θ * Real.sin θ - Real.sin θ * Real.cos θ) • p.2 := by\n      dsimp [rotX, rotY]\n      module\n    _ = _ := by simp [hc, mul_comm]\n\nprivate theorem rotated_laplace_derivative_integral_identity {f : E → ℝ} {L : ℝ≥0}\n    (hf : ContDiff ℝ 1 f) (hLip : LipschitzWith L f) (t m θ : ℝ) :\n    (∫ p, rotatedLaplaceDerivative f t m θ p\n      ∂(stdGaussian E).prod (stdGaussian E)) =\n      (-Real.sin θ * t) * ∫ u, Real.exp (t * (f u - m)) *\n        (∫ v, fderiv ℝ f (Real.cos θ • u - Real.sin θ • v)\n          ((InnerProductSpace.toDual ℝ E).symm (fderiv ℝ f u)) ∂stdGaussian E)\n        ∂stdGaussian E := by\n  let h : E × E → ℝ := fun p => f (Real.cos θ • p.1 - Real.sin θ • p.2) *\n    (Real.exp (t * (f p.1 - m)) * (t * fderiv ℝ f p.1 p.2))\n  have hcf := hf.continuous\n  have hdf := hf.continuous_fderiv (by norm_num)\n  have hcont : Continuous h := by dsimp [h]; fun_prop\n  have he (p : E × E) : h (ContinuousLinearMap.rotation θ p) =\n      rotatedLaplaceDerivative f t m θ p := by\n    change f (Real.cos θ • rotX θ p - Real.sin θ • rotY θ p) *\n      (Real.exp (t * (f (rotX θ p) - m)) * (t * fderiv ℝ f (rotX θ p) (rotY θ p))) = _\n    rw [rotation_inverse_first]\n    rfl\n  have hm := IsGaussian.map_rotation_eq_self\n    (μ := stdGaussian E) (integral_id_stdGaussian (E := E)) θ\n  have hi : Integrable h ((stdGaussian E).prod (stdGaussian E)) := by\n    have hic : Integrable (h ∘ ContinuousLinearMap.rotation θ)\n        ((stdGaussian E).prod (stdGaussian E)) :=\n      (rotated_laplace_derivative_integrable hf hLip t m θ).congr\n        (ae_of_all _ fun p => (he p).symm)\n    have hmap := (integrable_map_measure\n      (μ := (stdGaussian E).prod (stdGaussian E)) hcont.aestronglyMeasurable\n      (ContinuousLinearMap.rotation θ).continuous.measurable.aemeasurable).2 hic\n    rwa [hm] at hmap\n  calc\n    _ = ∫ p, h (ContinuousLinearMap.rotation θ p)\n        ∂(stdGaussian E).prod (stdGaussian E) := integral_congr_ae\n          (ae_of_all _ fun p => (he p).symm)\n    _ = ∫ p, h p ∂(stdGaussian E).prod (stdGaussian E) :=\n      standardGaussian_rotation_integral θ hcont\n    _ = ∫ u, ∫ v, h (u, v) ∂stdGaussian E ∂stdGaussian E := integral_prod _ hi\n    _ = ∫ u, -Real.sin θ * Real.exp (t * (f u - m)) * t *\n        (∫ v, fderiv ℝ f (Real.cos θ • u - Real.sin θ • v)\n          ((InnerProductSpace.toDual ℝ E).symm (fderiv ℝ f u)) ∂stdGaussian E)\n        ∂stdGaussian E := by\n      apply integral_congr_ae\n      filter_upwards with u\n      exact affine_stein_laplace_slice hf hLip t m (Real.cos θ) (Real.sin θ) u\n    _ = _ := by\n      rw [← integral_const_mul]\n      apply integral_congr_ae\n      filter_upwards with u\n      ring\n\nprivate theorem rotated_laplace_derivative_integral_lower_bound {f : E → ℝ} {L : ℝ≥0}\n    (hf : ContDiff ℝ 1 f) (hLip : LipschitzWith L f) (t m θ : ℝ)\n    (ht : 0 ≤ t) (hs : 0 ≤ Real.sin θ) :\n    (-Real.sin θ * t) * ((L : ℝ)^2 * ∫ u, Real.exp (t * (f u - m)) ∂stdGaussian E) ≤\n      ∫ p, rotatedLaplaceDerivative f t m θ p\n        ∂(stdGaussian E).prod (stdGaussian E) := by\n  let I : E → ℝ := fun u => ∫ v, fderiv ℝ f (Real.cos θ • u - Real.sin θ • v)\n    ((InnerProductSpace.toDual ℝ E).symm (fderiv ℝ f u)) ∂stdGaussian E\n  have hdf := hf.continuous_fderiv (by norm_num)\n  have hcf := hf.continuous\n  have hI : StronglyMeasurable I := by\n    have hcont : Continuous (fun p : E × E =>\n        fderiv ℝ f (Real.cos θ • p.1 - Real.sin θ • p.2)\n          ((InnerProductSpace.toDual ℝ E).symm (fderiv ℝ f p.1))) := by fun_prop\n    exact hcont.stronglyMeasurable.integral_prod_right'\n  have hIn (u : E) : ‖I u‖ ≤ (L : ℝ)^2 :=\n    affine_directional_derivative_integral_norm_le hf hLip (Real.cos θ) (Real.sin θ) u\n  have hExp : Integrable (fun u => Real.exp (t * (f u - m))) (stdGaussian E) := by\n    have he := (integrable_and_integrable_exp_centered_of_lipschitz\n      (μ := stdGaussian E) hLip).2 t\n    apply (he.const_mul (Real.exp (t * (∫ u, f u ∂stdGaussian E - m)))).congr\n    filter_upwards with u\n    rw [← Real.exp_add]\n    congr 1\n    ring\n  have hJ : Integrable (fun u => Real.exp (t * (f u - m)) * I u) (stdGaussian E) := by\n    apply (hExp.mul_const ((L : ℝ)^2)).mono'\n      ((by fun_prop : Continuous (fun u => Real.exp (t * (f u - m)))).aestronglyMeasurable.mul\n        hI.aestronglyMeasurable)\n    filter_upwards with u\n    change ‖Real.exp (t * (f u - m)) * I u‖ ≤ Real.exp (t * (f u - m)) * (L : ℝ)^2\n    simp only [norm_mul, Real.norm_eq_abs (Real.exp _), abs_of_pos (Real.exp_pos _)]\n    exact mul_le_mul_of_nonneg_left (hIn u) (Real.exp_pos _).le\n  have hupper : (∫ u, Real.exp (t * (f u - m)) * I u ∂stdGaussian E) ≤\n      (L : ℝ)^2 * ∫ u, Real.exp (t * (f u - m)) ∂stdGaussian E := by\n    rw [← integral_const_mul]\n    apply integral_mono hJ (hExp.const_mul _)\n    intro u\n    change Real.exp (t * (f u - m)) * I u ≤ (L : ℝ)^2 * Real.exp (t * (f u - m))\n    rw [mul_comm ((L : ℝ)^2)]\n    exact mul_le_mul_of_nonneg_left\n      ((le_abs_self (I u)).trans (by simpa only [Real.norm_eq_abs] using hIn u))\n      (Real.exp_pos _).le\n  rw [rotated_laplace_derivative_integral_identity hf hLip]\n  exact mul_le_mul_of_nonpos_left hupper (mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr hs) ht)\n\nprivate theorem gaussian_laplace_covariance_bound {f : E → ℝ} {L : ℝ≥0}\n    (hf : ContDiff ℝ 1 f) (hLip : LipschitzWith L f) (t m : ℝ) (ht : 0 ≤ t) :\n    (∫ x, f x * Real.exp (t * (f x - m)) ∂stdGaussian E) -\n      (∫ x, f x ∂stdGaussian E) * (∫ x, Real.exp (t * (f x - m)) ∂stdGaussian E) ≤\n        t * (L : ℝ)^2 * ∫ x, Real.exp (t * (f x - m)) ∂stdGaussian E := by\n  let F : ℝ → ℝ := fun θ => ∫ p : E × E, f p.1 * Real.exp (t * (f (rotX θ p) - m))\n    ∂(stdGaussian E).prod (stdGaussian E)\n  let M : ℝ := ∫ x, Real.exp (t * (f x - m)) ∂stdGaussian E\n  let C : ℝ := t * (L : ℝ)^2 * M\n  let H : ℝ → ℝ := fun θ => F θ - Real.cos θ * C\n  let D : ℝ → ℝ := fun θ => ∫ p, rotatedLaplaceDerivative f t m θ p\n    ∂(stdGaussian E).prod (stdGaussian E)\n  have hd (θ : ℝ) : HasDerivAt H (D θ + Real.sin θ * C) θ := by\n    simpa only [H, F, D, Pi.sub_apply, neg_mul, sub_neg_eq_add] using!\n      (rotated_laplace_integral_hasDerivAt hf hLip t m θ).sub\n        ((Real.hasDerivAt_cos θ).mul_const C)\n  have hcont : Continuous H := continuous_iff_continuousAt.2 (fun θ => (hd θ).continuousAt)\n  have hm : MonotoneOn H (Set.Icc 0 (Real.pi / 2)) := by\n    apply monotoneOn_of_hasDerivWithinAt_nonneg (convex_Icc _ _) hcont.continuousOn\n      (fun θ _ => (hd θ).hasDerivWithinAt)\n    intro θ hθ\n    have hθ' := interior_subset hθ\n    have hs : 0 ≤ Real.sin θ := Real.sin_nonneg_of_nonneg_of_le_pi hθ'.1\n      (by linarith [hθ'.2, Real.pi_pos])\n    have hb := rotated_laplace_derivative_integral_lower_bound hf hLip t m θ ht hs\n    change 0 ≤ D θ + Real.sin θ * C\n    dsimp [D, C, M]\n    nlinarith\n  have hzero : F 0 = ∫ x, f x * Real.exp (t * (f x - m)) ∂stdGaussian E := by\n    dsimp [F]\n    rw [integral_prod _ (rotated_laplace_value_integrable hLip t m 0)]\n    simp [rotX]\n  have hpi : F (Real.pi / 2) = (∫ x, f x ∂stdGaussian E) * M := by\n    dsimp [F, M]\n    rw [integral_prod _ (rotated_laplace_value_integrable hLip t m (Real.pi / 2))]\n    simp only [rotX, Real.cos_pi_div_two, Real.sin_pi_div_two, zero_smul, one_smul,\n      zero_add, integral_const_mul, integral_mul_const]\n  have hh := hm (show 0 ∈ Set.Icc 0 (Real.pi / 2) by constructor; rfl; positivity)\n    (show Real.pi / 2 ∈ Set.Icc 0 (Real.pi / 2) by constructor; positivity; rfl)\n    (by positivity)\n  simp only [H, Real.cos_zero, one_mul, Real.cos_pi_div_two, zero_mul, sub_zero,\n    hzero, hpi] at hh\n  dsimp [C, M] at hh\n  linarith\n\nprivate theorem gaussian_centered_integrableExpSet {f : E → ℝ} {L : ℝ≥0}\n    (hf : LipschitzWith L f) :\n    integrableExpSet (fun x => f x - ∫ z, f z ∂stdGaussian E) (stdGaussian E) = Set.univ := by\n  apply Set.eq_univ_of_forall\n  intro t\n  exact (integrable_and_integrable_exp_centered_of_lipschitz (μ := stdGaussian E) hf).2 t\n\nprivate theorem gaussian_centered_laplace_hasDerivAt {f : E → ℝ} {L : ℝ≥0}\n    (hf : LipschitzWith L f) (t : ℝ) :\n    HasDerivAt\n      (fun t => ∫ x, Real.exp (t * (f x - ∫ z, f z ∂stdGaussian E)) ∂stdGaussian E)\n      (∫ x, (f x - ∫ z, f z ∂stdGaussian E) *\n        Real.exp (t * (f x - ∫ z, f z ∂stdGaussian E)) ∂stdGaussian E) t := by\n  have ht : t ∈ interior (integrableExpSet\n      (fun x => f x - ∫ z, f z ∂stdGaussian E) (stdGaussian E)) := by\n    rw [gaussian_centered_integrableExpSet hf, interior_univ]\n    exact Set.mem_univ t\n  convert! hasDerivAt_mgf ht using 1\n\nprivate theorem gaussian_centered_laplace_derivative_bound {f : E → ℝ} {L : ℝ≥0}\n    (hf : ContDiff ℝ 1 f) (hLip : LipschitzWith L f) (t : ℝ) (ht : 0 ≤ t) :\n    (∫ x, (f x - ∫ z, f z ∂stdGaussian E) *\n      Real.exp (t * (f x - ∫ z, f z ∂stdGaussian E)) ∂stdGaussian E) ≤\n      t * (L : ℝ)^2 * ∫ x, Real.exp (t * (f x - ∫ z, f z ∂stdGaussian E)) ∂stdGaussian E := by\n  let m : ℝ := ∫ z, f z ∂stdGaussian E\n  have he := (integrable_and_integrable_exp_centered_of_lipschitz (μ := stdGaussian E) hLip).2 t\n  have hti : t ∈ interior (integrableExpSet (fun x => f x - m) (stdGaussian E)) := by\n    rw [gaussian_centered_integrableExpSet hLip, interior_univ]\n    exact Set.mem_univ t\n  have hp : Integrable (fun x => (f x - m) * Real.exp (t * (f x - m))) (stdGaussian E) := by\n    simpa only [pow_one] using integrable_pow_mul_exp_of_mem_interior_integrableExpSet hti 1\n  have hfp : Integrable (fun x => f x * Real.exp (t * (f x - m))) (stdGaussian E) := by\n    apply (hp.add (he.const_mul m)).congr\n    filter_upwards with x\n    change (f x - m) * Real.exp (t * (f x - m)) + m * Real.exp (t * (f x - m)) = _\n    ring\n  change (∫ x, (f x - m) * Real.exp (t * (f x - m)) ∂stdGaussian E) ≤ _\n  calc\n    _ = (∫ x, f x * Real.exp (t * (f x - m)) ∂stdGaussian E) -\n        m * (∫ x, Real.exp (t * (f x - m)) ∂stdGaussian E) := by\n      rw [← integral_const_mul, ← integral_sub hfp (he.const_mul m)]\n      apply integral_congr_ae\n      filter_upwards with x\n      ring\n    _ ≤ _ := gaussian_laplace_covariance_bound hf hLip t m ht\n\nprivate theorem gaussian_centered_laplace_bound_c1_nonneg {f : E → ℝ} {L : ℝ≥0}\n    (hf : ContDiff ℝ 1 f) (hLip : LipschitzWith L f) (t : ℝ) (ht : 0 ≤ t) :\n    (∫ x, Real.exp (t * (f x - ∫ z, f z ∂stdGaussian E)) ∂stdGaussian E) ≤\n      Real.exp ((L : ℝ)^2 * t^2 / 2) := by\n  let M : ℝ → ℝ := fun s => ∫ x, Real.exp (s * (f x - ∫ z, f z ∂stdGaussian E)) ∂stdGaussian E\n  let D : ℝ → ℝ := fun s => ∫ x, (f x - ∫ z, f z ∂stdGaussian E) *\n    Real.exp (s * (f x - ∫ z, f z ∂stdGaussian E)) ∂stdGaussian E\n  let W : ℝ → ℝ := fun s => Real.exp ((-(L : ℝ)^2 / 2) * s^2) * M s\n  have hd (s : ℝ) : HasDerivAt W\n      (Real.exp ((-(L : ℝ)^2 / 2) * s^2) * (D s - (L : ℝ)^2 * s * M s)) s := by\n    have hq : HasDerivAt (fun y : ℝ => (-(L : ℝ)^2 / 2) * y^2) (-(L : ℝ)^2 * s) s := by\n      convert! ((hasDerivAt_id s).pow 2).const_mul (-(L : ℝ)^2 / 2) using 1 <;>\n        simp only [id_eq] <;> ring\n    convert! hq.exp.mul (gaussian_centered_laplace_hasDerivAt hLip s) using 1 <;>\n      dsimp only [W, M, D] <;> ring\n  have hcont : Continuous W := continuous_iff_continuousAt.2 (fun s => (hd s).continuousAt)\n  have hm : AntitoneOn W (Set.Ici 0) := by\n    apply antitoneOn_of_hasDerivWithinAt_nonpos (convex_Ici _) hcont.continuousOn\n      (fun s _ => (hd s).hasDerivWithinAt)\n    intro s hs\n    have hs' : 0 ≤ s := interior_subset hs\n    have hb := gaussian_centered_laplace_derivative_bound hf hLip s hs'\n    apply mul_nonpos_of_nonneg_of_nonpos (Real.exp_pos _).le\n    dsimp [D, M]\n    nlinarith\n  have hw := hm (show 0 ∈ Set.Ici (0 : ℝ) by simp)\n    (show t ∈ Set.Ici (0 : ℝ) by simpa only [Set.mem_Ici] using ht) ht\n  have hw' : Real.exp ((-(L : ℝ)^2 / 2) * t^2) * M t ≤ 1 := by\n    simpa [W, M] using hw\n  change M t ≤ _\n  calc\n    M t = Real.exp ((L : ℝ)^2 * t^2 / 2) *\n        (Real.exp ((-(L : ℝ)^2 / 2) * t^2) * M t) := by\n      rw [← mul_assoc, ← Real.exp_add]\n      have hz : (L : ℝ)^2 * t^2 / 2 + (-(L : ℝ)^2 / 2) * t^2 = 0 := by ring\n      rw [hz, Real.exp_zero, one_mul]\n    _ ≤ Real.exp ((L : ℝ)^2 * t^2 / 2) * 1 :=\n      mul_le_mul_of_nonneg_left hw' (Real.exp_pos _).le\n    _ = _ := mul_one _\n\nprivate theorem gaussian_centered_laplace_bound_c1 {f : E → ℝ} {L : ℝ≥0}\n    (hf : ContDiff ℝ 1 f) (hLip : LipschitzWith L f) (t : ℝ) :\n    (∫ x, Real.exp (t * (f x - ∫ z, f z ∂stdGaussian E)) ∂stdGaussian E) ≤\n      Real.exp ((L : ℝ)^2 * t^2 / 2) := by\n  by_cases ht : 0 ≤ t\n  · exact gaussian_centered_laplace_bound_c1_nonneg hf hLip t ht\n  · have h := gaussian_centered_laplace_bound_c1_nonneg hf.neg hLip.neg (-t) (by linarith)\n    simp only [Pi.neg_apply, integral_neg] at h\n    convert! h using 1\n    · apply integral_congr_ae\n      filter_upwards with x\n      congr 1\n      ring\n    · congr 1\n      ring\n\nprivate theorem normed_bump_convolution_lipschitz {f : E → ℝ} {L : ℝ≥0}\n    (hf : LipschitzWith L f) (φ : ContDiffBump (0 : E)) :\n    LipschitzWith L (φ.normed volume ⋆[ContinuousLinearMap.lsmul ℝ ℝ, volume] f) := by\n  have hc := φ.hasCompactSupport_normed (μ := (volume : Measure E))\n  have he := hc.convolutionExists_left (μ := (volume : Measure E)) (ContinuousLinearMap.lsmul ℝ ℝ)\n    φ.continuous_normed hf.continuous.locallyIntegrable\n  have hei (x : E) : Integrable (fun z => φ.normed volume z * f (x - z)) (volume : Measure E) := by\n    simpa only [ConvolutionExistsAt, ContinuousLinearMap.lsmul_apply, smul_eq_mul] using he x\n  apply LipschitzWith.of_dist_le_mul\n  intro x y\n  change ‖(∫ z, φ.normed volume z * f (x - z)) -\n    (∫ z, φ.normed volume z * f (y - z))‖ ≤ (L : ℝ) * dist x y\n  rw [← integral_sub (hei x) (hei y)]\n  calc\n    _ ≤ ∫ z, ‖φ.normed volume z * f (x - z) - φ.normed volume z * f (y - z)‖ :=\n      norm_integral_le_integral_norm _\n    _ ≤ ∫ z, φ.normed volume z * ((L : ℝ) * dist x y) := by\n      apply integral_mono ((hei x).sub (hei y)).norm\n        (φ.integrable_normed.mul_const _)\n      intro z\n      change ‖φ.normed volume z * f (x - z) - φ.normed volume z * f (y - z)‖ ≤ _\n      rw [← mul_sub, norm_mul, Real.norm_eq_abs (φ.normed volume z),\n        abs_of_nonneg (φ.nonneg_normed z)]\n      apply mul_le_mul_of_nonneg_left _ (φ.nonneg_normed z)\n      simpa only [dist_eq_norm, sub_sub_sub_cancel_right] using hf.dist_le_mul (x - z) (y - z)\n    _ = _ := by rw [integral_mul_const, φ.integral_normed, one_mul]\n\nprivate theorem normed_bump_convolution_error {f : E → ℝ} {L : ℝ≥0}\n    (hf : LipschitzWith L f) (φ : ContDiffBump (0 : E)) (x : E) :\n    |(φ.normed volume ⋆[ContinuousLinearMap.lsmul ℝ ℝ, volume] f) x - f x| ≤\n      (L : ℝ) * φ.rOut := by\n  rw [← Real.norm_eq_abs, ← dist_eq_norm]\n  apply φ.dist_normed_convolution_le hf.continuous.aestronglyMeasurable\n  intro z hz\n  exact (hf.dist_le_mul z x).trans\n    (mul_le_mul_of_nonneg_left (Metric.mem_ball.mp hz).le L.coe_nonneg)\n\nprivate def approximationBump (n : ℕ) : ContDiffBump (0 : E) where\n  rIn := ((1 / 2 : ℝ)^n) / 2\n  rOut := (1 / 2 : ℝ)^n\n  rIn_pos := by positivity\n  rIn_lt_rOut := half_lt_self (by positivity)\n\nprivate def smoothApprox (f : E → ℝ) (n : ℕ) : E → ℝ :=\n  (approximationBump n).normed volume ⋆[ContinuousLinearMap.lsmul ℝ ℝ, volume] f\n\nprivate theorem smoothApprox_contDiff {f : E → ℝ} {L : ℝ≥0}\n    (hf : LipschitzWith L f) (n : ℕ) : ContDiff ℝ 1 (smoothApprox f n) := by\n  exact (approximationBump n).hasCompactSupport_normed.contDiff_convolution_left\n    (ContinuousLinearMap.lsmul ℝ ℝ) (approximationBump n).contDiff_normed\n    hf.continuous.locallyIntegrable\n\nprivate theorem smoothApprox_lipschitz {f : E → ℝ} {L : ℝ≥0}\n    (hf : LipschitzWith L f) (n : ℕ) : LipschitzWith L (smoothApprox f n) :=\n  normed_bump_convolution_lipschitz hf (approximationBump n)\n\nprivate theorem smoothApprox_error {f : E → ℝ} {L : ℝ≥0}\n    (hf : LipschitzWith L f) (n : ℕ) (x : E) :\n    |smoothApprox f n x - f x| ≤ (L : ℝ) * (1 / 2 : ℝ)^n :=\n  normed_bump_convolution_error hf (approximationBump n) x\n\nprivate theorem smoothApprox_tendsto {f : E → ℝ} {L : ℝ≥0}\n    (hf : LipschitzWith L f) (x : E) :\n    Filter.Tendsto (fun n => smoothApprox f n x) Filter.atTop (𝓝 (f x)) := by\n  apply ContDiffBump.convolution_tendsto_right_of_continuous\n    (φ := fun n => approximationBump (E := E) n) (μ := (volume : Measure E)) _ hf.continuous x\n  exact tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num)\n\nprivate theorem smoothApprox_mean_error {f : E → ℝ} {L : ℝ≥0}\n    (hf : LipschitzWith L f) (n : ℕ) :\n    |(∫ x, smoothApprox f n x ∂stdGaussian E) - (∫ x, f x ∂stdGaussian E)| ≤\n      (L : ℝ) * (1 / 2 : ℝ)^n := by\n  have hi := (integrable_and_integrable_exp_centered_of_lipschitz (μ := stdGaussian E) hf).1\n  have hin := (integrable_and_integrable_exp_centered_of_lipschitz\n    (μ := stdGaussian E) (smoothApprox_lipschitz hf n)).1\n  rw [← integral_sub hin hi, ← Real.norm_eq_abs]\n  have h := norm_integral_le_of_norm_le_const (μ := stdGaussian E)\n    (f := fun x => smoothApprox f n x - f x) (C := (L : ℝ) * (1 / 2 : ℝ)^n)\n    (ae_of_all _ fun x => by simpa only [Real.norm_eq_abs] using smoothApprox_error hf n x)\n  simpa using h\n\nprivate theorem smoothApprox_mean_tendsto {f : E → ℝ} {L : ℝ≥0}\n    (hf : LipschitzWith L f) :\n    Filter.Tendsto (fun n => ∫ x, smoothApprox f n x ∂stdGaussian E) Filter.atTop\n      (𝓝 (∫ x, f x ∂stdGaussian E)) := by\n  rw [tendsto_iff_norm_sub_tendsto_zero]\n  have he : Filter.Tendsto (fun n : ℕ => (L : ℝ) * (1 / 2 : ℝ)^n) Filter.atTop (𝓝 0) := by\n    simpa only [mul_zero] using\n      (tendsto_pow_atTop_nhds_zero_of_lt_one\n        (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num)).const_mul (L : ℝ)\n  exact squeeze_zero (fun _ => norm_nonneg _) (fun n => by\n    simpa only [Real.norm_eq_abs] using smoothApprox_mean_error hf n) he\n\nprivate theorem smoothApprox_centered_exp_bound {f : E → ℝ} {L : ℝ≥0}\n    (hf : LipschitzWith L f) (t : ℝ) (n : ℕ) (x : E) :\n    Real.exp (t * (smoothApprox f n x - ∫ z, smoothApprox f n z ∂stdGaussian E)) ≤\n      Real.exp (2 * |t| * (L : ℝ)) * Real.exp (t * (f x - ∫ z, f z ∂stdGaussian E)) := by\n  let mn : ℝ := ∫ z, smoothApprox f n z ∂stdGaussian E\n  let m : ℝ := ∫ z, f z ∂stdGaussian E\n  have hrad : (L : ℝ) * (1 / 2 : ℝ)^n ≤ (L : ℝ) := by\n    simpa only [mul_one] using mul_le_mul_of_nonneg_left\n      (pow_le_one₀ (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num : (1 / 2 : ℝ) ≤ 1)) L.coe_nonneg\n  have hx : |smoothApprox f n x - f x| ≤ (L : ℝ) := (smoothApprox_error hf n x).trans hrad\n  have hm : |mn - m| ≤ (L : ℝ) := (smoothApprox_mean_error hf n).trans hrad\n  have hc : |(smoothApprox f n x - mn) - (f x - m)| ≤ 2 * (L : ℝ) := by\n    calc\n      _ = |(smoothApprox f n x - f x) - (mn - m)| := by congr 1; ring\n      _ ≤ |smoothApprox f n x - f x| + |mn - m| := abs_sub _ _\n      _ ≤ _ := by linarith\n  have hb : t * ((smoothApprox f n x - mn) - (f x - m)) ≤ 2 * |t| * (L : ℝ) := by\n    calc\n      _ ≤ |t * ((smoothApprox f n x - mn) - (f x - m))| := le_abs_self _\n      _ = |t| * |(smoothApprox f n x - mn) - (f x - m)| := abs_mul _ _\n      _ ≤ |t| * (2 * (L : ℝ)) := mul_le_mul_of_nonneg_left hc (abs_nonneg _)\n      _ = _ := by ring\n  rw [← Real.exp_add]\n  apply Real.exp_le_exp.mpr\n  change t * (smoothApprox f n x - mn) ≤ 2 * |t| * (L : ℝ) + t * (f x - m)\n  nlinarith\n\nprivate theorem smoothApprox_centered_exp_integral_tendsto {f : E → ℝ} {L : ℝ≥0}\n    (hf : LipschitzWith L f) (t : ℝ) :\n    Filter.Tendsto\n      (fun n => ∫ x, Real.exp (t * (smoothApprox f n x - ∫ z, smoothApprox f n z ∂stdGaussian E))\n        ∂stdGaussian E) Filter.atTop\n      (𝓝 (∫ x, Real.exp (t * (f x - ∫ z, f z ∂stdGaussian E)) ∂stdGaussian E)) := by\n  apply tendsto_integral_of_dominated_convergence\n    (fun x => Real.exp (2 * |t| * (L : ℝ)) * Real.exp (t * (f x - ∫ z, f z ∂stdGaussian E)))\n  · intro n\n    have hcont := (smoothApprox_lipschitz hf n).continuous\n    fun_prop\n  · exact ((integrable_and_integrable_exp_centered_of_lipschitz\n      (μ := stdGaussian E) hf).2 t).const_mul _\n  · intro n\n    filter_upwards with x\n    rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]\n    exact smoothApprox_centered_exp_bound hf t n x\n  · filter_upwards with x\n    exact Real.continuous_exp.continuousAt.tendsto.comp\n      (((smoothApprox_tendsto hf x).sub (smoothApprox_mean_tendsto hf)).const_mul t)\n\nend GaussianDensity\n\n/-- Sharp centered Laplace bound for the actual standard Gaussian, with all\ndomains and the smooth approximation produced internally. -/\ntheorem integral_exp_centered_le_stdGaussian_of_lipschitz\n    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]\n    [CompleteSpace E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]\n    {L : ℝ≥0} {f : E → ℝ} (hf : LipschitzWith L f) (t : ℝ) :\n    (∫ x, Real.exp (t * (f x - ∫ z, f z ∂ProbabilityTheory.stdGaussian E))\n      ∂ProbabilityTheory.stdGaussian E) ≤ Real.exp ((L : ℝ)^2 * t^2 / 2) := by\n  by_cases hL : L = 0\n  · subst L\n    rw [centered_exp_integral_of_lipschitz_zero hf t]\n    norm_num\n  · rcases subsingleton_or_nontrivial E with hE | hE\n    · letI : Subsingleton E := hE\n      rw [centered_exp_integral_of_subsingleton f t]\n      exact Real.one_le_exp_iff.mpr (by positivity)\n    · exact le_of_tendsto' (smoothApprox_centered_exp_integral_tendsto hf t)\n        (fun n => gaussian_centered_laplace_bound_c1\n          (smoothApprox_contDiff hf n) (smoothApprox_lipschitz hf n) t)\n\nend AutoSamplingTheory.TechnicalLemmas.Probability.GaussianLipschitzExponential\nend\n",
