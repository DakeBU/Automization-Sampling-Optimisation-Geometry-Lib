E : Type u_1
S : Type u_2
inst✝⁶ : NormedAddCommGroup E
inst✝⁵ : InnerProductSpace ℝ E
inst✝⁴ : CompleteSpace E
inst✝³ : FiniteDimensional ℝ E
inst✝² : MeasurableSpace E
inst✝¹ : BorelSpace E
inst✝ : MeasurableSpace S
V : E → ℝ
κ : ℝ
hκ : 1 ≤ κ
hV : ContDiff ℝ 2 V
hH : ∀ (x v : E), κ⁻¹ * ‖v‖ ^ 2 ≤ ((fderiv ℝ (fderiv ℝ V) x) v) v ∧ ((fderiv ℝ (fderiv ℝ V) x) v) v ≤ ‖v‖ ^ 2
eta : S → ℝ
y : S → E
heta : Measurable eta
hy : Measurable y
hpos : ∀ (s : S), 0 < eta s
p : S → E
hpm : Measurable p
heq : ∀ (s : S), p s + eta s • gradient V (p s) = y s
hparent :
  have rho := fun s u => V (p s + √(eta s) • u) - V (p s) - √(eta s) * ⟪gradient V (p s), u⟫;
  have Q := fun s u => ‖u‖ ^ 2 / 2 + rho s u;
  have mu := ℙ.tilted fun x => -V x;
  have R := fun s => mu.tilted fun x => -‖x - y s‖ ^ 2 / (2 * eta s);
  have r := fun s => Measure.map (fun x => (√(eta s))⁻¹ • (x - p s)) (R s);
  IsProbabilityMeasure mu ∧
    ∀ (s : S),
      IsProbabilityMeasure (R s) ∧
        ContDiff ℝ 2 (rho s) ∧
          ContDiff ℝ 2 (Q s) ∧
            gradient (rho s) 0 = 0 ∧
              gradient (Q s) 0 = 0 ∧
                (∀ (u v : E),
                    0 ≤ ((fderiv ℝ (fderiv ℝ (rho s)) u) v) v ∧
                      ((fderiv ℝ (fderiv ℝ (rho s)) u) v) v ≤ eta s * ‖v‖ ^ 2) ∧
                  (∀ (u v : E),
                      ‖v‖ ^ 2 ≤ ((fderiv ℝ (fderiv ℝ (Q s)) u) v) v ∧
                        ((fderiv ℝ (fderiv ℝ (Q s)) u) v) v ≤ (1 + eta s) * ‖v‖ ^ 2) ∧
                    (r s = ℙ.tilted fun u => -Q s u) ∧
                      IsProbabilityMeasure (r s) ∧
                        MemLp id 2 (r s) ∧
                          Integrable (fun u => ‖u‖ ^ 2) (r s) ∧
                            ∫ (u : E), ‖u‖ ^ 2 ∂r s ≤ ↑(Module.finrank ℝ E) ∧
                              MemLp (gradient (rho s)) 2 (r s) ∧
                                ∫ (u : E), ‖gradient (rho s) u‖ ^ 2 ∂r s ≤ eta s ^ 2 * ∫ (u : E), ‖u‖ ^ 2 ∂r s ∧
                                  ∫ (u : E), ‖gradient (rho s) u‖ ^ 2 ∂r s ≤ eta s ^ 2 * ↑(Module.finrank ℝ E)
rho : S → E → ℝ := fun s u => V (p s + √(eta s) • u) - V (p s) - √(eta s) * ⟪gradient V (p s), u⟫
mu : Measure E := ℙ.tilted fun x => -V x
R : S → Measure E := fun s => mu.tilted fun x => -‖x - y s‖ ^ 2 / (2 * eta s)
r : S → Measure E := fun s => Measure.map (fun x => (√(eta s))⁻¹ • (x - p s)) (R s)
gamma : Measure E := stdGaussian E
Z : S → ℝ := fun s => ∫ (u : E), Real.exp (-rho s u) ∂gamma
q : S → E → ℝ := fun s u => Real.exp (-rho s u) / Z s
f : S → E → ℝ := fun s u => Real.exp (-rho s u / 2) / √(Z s)
s : S
_hRp : IsProbabilityMeasure ((fun s => (ℙ.tilted fun x => -V x).tilted fun x => -‖x - y s‖ ^ 2 / (2 * eta s)) s)
hρ : ContDiff ℝ 2 ((fun s u => V (p s + √(eta s) • u) - V (p s) - √(eta s) * ⟪gradient V (p s), u⟫) s)
_hQ :
  ContDiff ℝ 2
    ((fun s u => ‖u‖ ^ 2 / 2 + (fun s u => V (p s + √(eta s) • u) - V (p s) - √(eta s) * ⟪gradient V (p s), u⟫) s u) s)
hρgrad : gradient ((fun s u => V (p s + √(eta s) • u) - V (p s) - √(eta s) * ⟪gradient V (p s), u⟫) s) 0 = 0
_hQgrad :
  gradient
      ((fun s u => ‖u‖ ^ 2 / 2 + (fun s u => V (p s + √(eta s) • u) - V (p s) - √(eta s) * ⟪gradient V (p s), u⟫) s u)
