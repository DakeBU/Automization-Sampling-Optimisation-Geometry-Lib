      ],
      "formula": "For γd and genuine L-Lipschitz f: Eγexp(t(f−Eγf))≤exp(t²L²/2), ∀t∈R, L≥0",
      "parents": [
        "CANONICAL-GAUSSIAN",
        "SCALAR-DIRECTION-LIPSCHITZ",
        "ACTUAL-MOMENT-AND-EXP-DOMAIN"
      ],
      "conclusion": "Sharp dimensionfree standard Gaussian Lipschitz concentration.",
      "truth_boundary": "Source names inequality but gives no theorem number/proof. No API/SLT/Lean result read or certificate invented. Must discharge exact Gaussian/background extension obligations."
    },
    {
      "id": "SHARP-CENTERED-MGF",
