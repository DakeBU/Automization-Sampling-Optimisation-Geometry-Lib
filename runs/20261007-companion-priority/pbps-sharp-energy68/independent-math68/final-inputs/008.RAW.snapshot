    {
      "id": "family:gaussian-law-symmetry",
      "label": "Gaussian symmetries through actual pushforwards",
      "plain_language": "Preserve a genuine Gaussian law by a symmetry and carry that symmetry through the actual measurable generative map; concentration calibration remains a separate proof.",
      "domains": [
        "concept:probability",
        "concept:sampling",
