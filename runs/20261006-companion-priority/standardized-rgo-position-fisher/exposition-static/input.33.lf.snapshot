      "id": "semantic-audit:ASTIS-RT-20261004-unit-rank-one-covariance-moments",
      "kind": "semantic-audit",
      "label": "ASTIS-RT-20261004-unit-rank-one-covariance-moments",
      "status": "fidelity-exact",
      "subtitle": "empirical-covariance-preconcentration:unit-rank-one-covariance-moments · exact",
      "summary": "Blind reconstruction and seven-slot semantic comparison for AutoSamplingTheory.TechnicalLemmas.Probability.EmpiricalCovariance.unitRankOneCovariance_momentPackage.",
      "column": 7,
      "url": "lean-foundations.html?view=semantic",
      "source_url": "https://arxiv.org/abs/1501.01571",
      "original_theorem": "Let E be a complete real inner-product space, let μ be a probability measure on Ω, and let X : Ω → E have norm one at every ω. Assume the rank-one operator-valued map ω ↦ X(ω) ⊗ X(ω) is Bochner integrable, and let C be its Bochner expectation. Then C is self-adjoint, ||C|| ≤ 1, the centered operator second moment is exactly ∫ (X ⊗ X - C)^2 dμ = C - C^2, and ||C - C^2|| ≤ 2||C||. This is the model-independent first/second moment calculation used before self-adjoint matrix Bernstein; it asserts no independence, matrix moment-generating-function estimate, probability tail, dimension factor, or sample-complexity conclusion.",
      "reconstructed_theorem": "Let E be a complete real inner-product space, let (Ω, μ) be a measurable probability space, let X : Ω → E, and let Σ be a continuous linear endomorphism of E. For ω∈Ω, define Rω : E→E by Rω(y)=⟪X(ω),y⟫X(ω). Assume ‖X(ω)‖=1 for every ω, the operator-valued map ω↦Rω is Bochner integrable, and ∫Ω Rω dμ(ω)=Σ. Then Σ is self-adjoint, ‖Σ‖≤1, ∫Ω(Rω−Σ)² dμ(ω)=Σ−Σ², and ‖Σ−Σ²‖≤2‖Σ‖.",
      "fidelity_verdict": "exact",
      "blindness": "source hidden from decoder",
      "semantic_slots": [
        {
          "slot": "objects",
          "original": "A complete real inner-product space E, a probability space (Omega, mu), a map X, the rank-one operators X(omega) tensor X(omega), and their expectation C.",
          "reconstructed": "A complete real inner-product space E, a measurable probability space (Omega, mu), a map X, R_omega(y) = inner(X(omega), y) X(omega), and a continuous linear endomorphism Sigma.",
          "relation": "same",
          "evidence": "R_omega is exactly Lean's self rank-one operator; Sigma merely renames C/population."
        },
        {
          "slot": "domains",
          "original": "E is a complete real inner-product space; Omega is measurable; mu is a probability measure; C is a continuous linear endomorphism of E.",
          "reconstructed": "The same domains and structures.",
          "relation": "same",
          "evidence": "CompleteSpace, MeasurableSpace, IsProbabilityMeasure, and E →L[ℝ] E implement these conditions exactly; no finite-dimensional hypothesis occurs."
        },
        {
          "slot": "quantifiers",
          "original": "The unit-norm condition holds for every omega.",
          "reconstructed": "For every omega, norm(X(omega)) = 1.",
          "relation": "same",
          "evidence": "Lean uses the pointwise hypothesis hsampleUnit, not an almost-everywhere condition."
        },
        {
          "slot": "assumptions",
          "original": "The operator-valued map omega ↦ X(omega) tensor X(omega) is Bochner integrable, and C equals its Bochner integral.",
          "reconstructed": "The map omega ↦ R_omega is Bochner integrable and its integral is Sigma.",
          "relation": "same",
          "evidence": "The refreshed lesson requires only integrability of X tensor X, not Bochner integrability of X itself. Integrability of the centered square follows from R² = R and integrability of R, R Sigma, Sigma R, and the constant Sigma²."
        },
        {
          "slot": "conclusion",
          "original": "C is self-adjoint, norm(C) ≤ 1, the integral of (X tensor X - C)² is C - C², and norm(C - C²) ≤ 2 norm(C).",
          "reconstructed": "Sigma is self-adjoint, norm(Sigma) ≤ 1, the integral of (R_omega - Sigma)² is Sigma - Sigma², and norm(Sigma - Sigma²) ≤ 2 norm(Sigma).",
          "relation": "same",
          "evidence": "The four Lean conjuncts agree term by term; the square of a continuous linear endomorphism is its composition square."
        },
        {
          "slot": "scopes",
          "original": "Only the model-independent first/second-moment calculation preceding self-adjoint matrix Bernstein; no independence, MGF, tail, dimension factor, or sample-complexity claim.",
          "reconstructed": "Only the four moment properties of the population operator.",
          "relation": "same",
          "evidence": "Neither the Lean signature nor conclusion contains any concentration premise or conclusion."
        },
        {
          "slot": "constant dependencies",
          "original": "The constants are 1 and 2, with no dimension or sample-size dependence.",
          "reconstructed": "norm(Sigma) ≤ 1 and norm(Sigma - Sigma²) ≤ 2 norm(Sigma).",
          "relation": "same",
          "evidence": "The Lean constants are exactly 1 and 2 and no hidden parameter occurs."
        }
