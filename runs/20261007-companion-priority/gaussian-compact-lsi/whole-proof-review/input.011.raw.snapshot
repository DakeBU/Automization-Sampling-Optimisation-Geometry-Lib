      "id": "P-FIRST",
      "kind": "PRIMARY_CONTEXT",
      "formula": "W2(r_y,N(0,I)) <= sqrt(E_r|grad rho|²); only FIRST inequality",
      "classification": "SOURCE_CONTEXT",
      "anchors": [
        {
          "input_role": "primary_first",
