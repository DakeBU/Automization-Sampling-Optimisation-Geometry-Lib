  "standing_assumptions": "Printed R^d, V C2, 0<alpha<=beta, global alpha I<=Hess V<=beta I, eta>0 and beta eta<=1 for B.1. No added higher derivatives. Finite real Hilbert/rank0 is a later explicitly authored extension, not printed source setting.",
  "objects": {
    "mu": "Normalized exp(-V) target on X.",
    "J": "pi_eta=law(X,X+sqrt(eta)Z), independent X~mu,Z~N(0,I).",
    "nu": "pi_eta^Y=J.snd, not mu.",
    "Hilbert": "H=L2(J), generally infinite dimensional despite finite d. H_P=ranP identified isometrically with L2(nu), H_perp=kerP. P is conditional expectation onto Y.",
    "U": "Self-adjoint unitary reflection pullback f(x,y)->f(x,2x-y).",
    "A": "U_PP=PUP restricted H_P, self-adjoint contraction. Full-joint PUP is not the same operator space as I on H_P.",
    "B": "U_perpP=(I-P)UP:H_P->H_perp; B*B=I_H_P-A², sourceB.5.",
    "Gamma_P": "(I_H_P-A²)^(1/2), sourceB.10; positive self-adjoint square root by standard spectral convention, bounded on full H_P. Not a gradient/Laplacian resolvent.",
    "macro_mean_zero": "H_P,0=H_P intersect L2_0(J), corresponding centered L2(nu).",
    "inverse": "Gamma_P inverse only asserted bounded on H_P,0 after B.15 gap; constants preclude an inverse on full H_P. V_perpP=B Gamma_P^-1 is isometry from H_P,0 into H_perp, not onto H_perp."
  },
  "exact_formulae": [
    {
      "anchor": "B.10/B.11",
      "formula": "Gamma_P²=I-A²=B*B; ||Gamma_P f||²=||Bf||²=||f||²-||Af||² for every f in H_P.",
      "eta_coefficient": "Gamma_P definition/norm identity has NO eta prefactor."
    },
    {
      "anchor": "B.13",
      "formula": "For every f in L2(nu), Af belongs to H1(nu), and 4eta||grad Af||²<=||f||²-||Af||²=||Gamma_P f||²=||Bf||².",
      "quantifiers": "All rough L2; not only meanzero. Gradient-domain conclusion is source weighted H1."
    },
    {
      "anchor": "C.2 equation",
      "formula": "eta||grad Af||²<=[(1-alpha eta)²/(4(1+alpha eta))]||Bf||².",
      "scope": "Smooth compact calculation followed by density/closedness; not C.2 subsection halfturn."
    },
    {
      "anchor": "B.12/B.14/B.15",
      "formula": "rho_mac=(1-alpha eta)/(1+alpha eta), gamma_gap=2sqrt(alpha eta)/(1+alpha eta); ||A||<=rho_mac and A>=-I/2 on H_P,0; Gamma_P>=gamma_gap I there.",
      "scope": "Bounded inverse with norm<=1/gamma_gap is source spectral consequence; never all H_P."
    },
    {
      "anchor": "B.16",
      "formula": "V_perpP=B Gamma_P^-1; V_perpP*V_perpP=I_H_P,0."
    },
    {
      "anchor": "C.28",
      "formula": "On ran1_[1/2,1](A), apply B.13 to A^-1w and A^-1(I-A)w: sqrt(eta)||grad w||<=C||Gamma_P w||, sqrt(eta)||grad(I-A)w||<=C||Gamma_P³w||.",
      "scope": "Inverse A is only on this spectral band; no inverse at zero eigenvalue. A spectral restriction commutes with Gamma_P."
    }
  ],
