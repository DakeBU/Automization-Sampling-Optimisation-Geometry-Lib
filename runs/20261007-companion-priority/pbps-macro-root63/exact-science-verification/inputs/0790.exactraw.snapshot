    {Ω Test E : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup E] [InnerProductSpace Real E]
    [FiniteDimensional Real E] [MeasurableSpace E] [BorelSpace E]
    (P : MeasureTheory.Measure Ω)
    (scalarBrownianCoordinate :
