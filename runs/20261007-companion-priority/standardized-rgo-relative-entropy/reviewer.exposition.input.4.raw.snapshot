      "title": "True standardized RGO unique proximal point and finite canonical entropy",
      "source": {
        "url": "https://arxiv.org/html/2609.06906v1#S4.Ex8",
        "edition": "arXiv:2609.06906v1 with pinned Mathlib db584cd6",
        "anchor": "S3.E2/S4.Ex3 actual proximal point; S4.Ex8 standardized posterior; S4.SS1.p4.2-p4.3/FIRST S4.E6 omitted canonical entropy domains.",
        "wording_status": "faithful paraphrase",
        "attribution": "Fan Chen, Sinho Chewi, Jianfeng Lu, Matthew S. Zhang. Internally authored entropy/coherence background for the printed GaussianLSI/T2 invocation, not a separately printed theorem or full inequality."
      },
      "statement": "Under unchanged normalized source curvature and C2 assumptions, produce the measurable uniquely stationary proximal point and the true affine standardized posterior; prove canonical KL finite, canonical llr L1 and only AE equality with the literal logdensity, actual residual L1 and both exact real entropy identities for every eta>0.",
      "assumptions": [
        "Complete finite-dimensional real Hilbert/Borel E, including dimension zero; canonical volume and covariance-I Gaussian.",
        "Source kappa>=1 and actual global C2 V with Hessian kappa^-1 I..I; positive eta. No supplied selector, probability, normalizer, integrability, entropy, LSI/T2 or final comparison certificate.",
        "Authored measurable family S with measurable eta/y, every eta(s)>0. Constant Unit specializes printed fixed parameters. Stationary uniqueness is an internally proved conclusion."
      ],
      "formulae": [
        {
          "label": "True standardized RGO unique proximal point and finite canonical entropy",
          "tex": "p_s+\\eta_s\\nabla V(p_s)=y_s,\\quad\\mathrm{KL}(r_s\\Vert\\gamma)<\\infty,\\quad\\log\\frac{dr_s}{d\\gamma}=\\log q_s\\quad r_s\\text{-a.e.},\\quad\\mathrm{KL}(r_s\\Vert\\gamma)=\\int q_s\\log q_s\\,d\\gamma=-\\mathbb E_{r_s}\\rho_s-\\log Z_s."
        }
      ],
      "obligations": [
        {
          "id": "canonical-entropy",
          "label": "Actual canonical finite entropy/llr domains and two exact formulas"
        },
        {
          "id": "unique-prox",
          "label": "Derived uniqueness of the internally produced actual stationary proximal point"
        },
        {
          "id": "remaining-paper",
          "label": "ActualGaussianLSI/T2/weakSobolev/W2/bias/algorithm/main/work/composition remain open"
        }
      ],
