1: theorem compact_stdGaussian_logSobolev
2:     {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
3:     [CompleteSpace E] [FiniteDimensional ℝ E]
4:     [MeasurableSpace E] [BorelSpace E]
5:     (f : E → ℝ) (hf : ContDiff ℝ 2 f) (hs : HasCompactSupport f) :
6:     let γ : Measure E := ProbabilityTheory.stdGaussian E
7:     Integrable (fun x => (f x)^2) γ ∧
8:     Integrable (fun x => (f x)^2 * Real.log ((f x)^2)) γ ∧
9:     Integrable (fun x => ‖gradient f x‖^2) γ ∧
10:     (∫ x, (f x)^2 * Real.log ((f x)^2) ∂γ) -
11:       (∫ x, (f x)^2 ∂γ) * Real.log (∫ x, (f x)^2 ∂γ) ≤
12:       2 * ∫ x, ‖gradient f x‖^2 ∂γ
