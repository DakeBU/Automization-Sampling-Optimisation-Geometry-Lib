          }
        },
        {
          "title": "Pass from B0 to the same polar adjoint",
          "text": "The exact produced equation V0=B0 Inv and selfadjointness of the same Inv give V0*=Inv B0*. Its previously proved commutation with A0 then transports B0*D=-A0B0* without any range or surjectivity restriction.",
          "formula": "V_0^*=\\mathrm{Inv}\\,B_0^*,\\quad V_0^*D=-\\mathrm{Inv}A_0B_0^*=-A_0\\mathrm{Inv}B_0^*=-A_0V_0^*.",
          "lean": "  have hVdefTyped : V0=B0 ∘L Inv := hVdef\n  have hInvSelfTyped : IsSelfAdjoint Inv := hInvSelf\n  have hVadjEq : V0.adjoint=Inv ∘L B0.adjoint := by\n    calc\n      V0.adjoint=(B0 ∘L Inv).adjoint :=\n        congrArg (fun L : HP0 →L[ℝ] Hperp => L.adjoint) hVdefTyped\n      _ = Inv.adjoint ∘L B0.adjoint := ContinuousLinearMap.adjoint_comp B0 Inv\n      _ = Inv ∘L B0.adjoint := by rw [hInvSelfTyped.adjoint_eq]\n  have hIntertwine : V0.adjoint ∘L D= -(A0 ∘L V0.adjoint) := by\n    calc\n      V0.adjoint ∘L D=Inv ∘L (B0.adjoint ∘L D) := by rw [hVadjEq,ContinuousLinearMap.comp_assoc]\n      _ = Inv ∘L (-(A0 ∘L B0.adjoint)) := by rw [hB0intertwine]\n      _ = -(A0 ∘L V0.adjoint) := by\n        apply ContinuousLinearMap.ext\n        intro h\n        change Inv (-(A0 (B0.adjoint h)))= -(A0 (V0.adjoint h))\n        rw [map_neg,hVadjEq]\n        change -(Inv (A0 (B0.adjoint h)))= -(A0 (Inv (B0.adjoint h)))\n        exact congrArg Neg.neg (DFunLike.congr_fun hCommInv.eq (B0.adjoint h)).symm\n",
          "detail": "Literal compiled BODY span; exact preceding module locals remain in scope.",
          "lean_source_region": {
            "path": "AutoSamplingTheory/ExampleCases/ProximalBPS/ReflectionIntertwining.lean",
            "source_raw_sha256": "7bbaae1abd67305749d385153019061eb055a7968a707f919e7d9ac9fc21846d",
