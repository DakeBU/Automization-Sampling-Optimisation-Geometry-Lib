  "nodes": [
    {
      "id": "pbps57:standing",
      "kind": "source-assumptions",
      "source_anchor": "S1.p1/Eq1.1; S2.SS2",
      "statement": "R^d, V in C2, 0<alpha<=beta, global alpha I<=Hess V<=beta I; 0<eta<=1/beta.",
      "boundary": "Source-only assertion; no Lean admission"
    },
    {
      "id": "pbps57:actual-law",
      "kind": "source-definition",
      "source_anchor": "S2.E6/E7/E8",
      "statement": "X~normalized exp(-V), Z~N(0,I) independent, Y=X+sqrt(eta)Z; nu=pi_eta^Y=mu*N(0,eta I).",
      "boundary": "Source-only assertion; no Lean admission"
    },
    {
      "id": "pbps57:conditional-potential",
      "kind": "source-definition-estimate",
      "source_anchor": "S2.E9/E10",
      "statement": "V_y(x)=V(x)+||x-y||²/(2eta); alpha+eta^-1<=Hess V_y<=beta+eta^-1.",
      "boundary": "Source-only assertion; no Lean admission"
    },
    {
      "id": "pbps57:BE",
      "kind": "external-citation",
      "source_anchor": "A4.SS2.p1.3/D.6; bibliography3 Chapters4/5",
      "statement": "Bakry-Emery curvature criterion: m-strong logconcavity implies Var(f)<=m^-1 E||grad f||² for smooth f; source citation not locally proved.",
      "boundary": "Source-only assertion; no Lean admission"
    },
    {
      "id": "pbps57:BL",
      "kind": "external-citation",
      "source_anchor": "D.3 proof bibliography3 Chapter4",
      "statement": "Brascamp-Lieb on linear functions gives covariance upper bound from lower Hessian curvature.",
      "boundary": "Source-only assertion; no Lean admission"
    },
    {
      "id": "pbps57:CR",
      "kind": "external-result",
      "source_anchor": "D.3 proof",
      "statement": "Cramer-Rao location-family inequality gives covariance lower bound from upper Hessian curvature; smooth density/tail/IBP conditions implicit in source.",
      "boundary": "Source-only assertion; no Lean admission"
    },
    {
      "id": "pbps57:covariance",
      "kind": "source-lemma",
      "source_anchor": "A4.Thmtheorem3/D.8/D.9; S2.E12",
      "statement": "For m I<=Hess W<=L I, L^-1 I<=Cov(Z)<=m^-1 I; conditional Cov between eta/(1+beta eta) I and eta/(1+alpha eta) I.",
      "boundary": "Source-only assertion; no Lean admission"
    },
    {
      "id": "pbps57:differentiate-logdensity",
      "kind": "source-proof-step",
      "source_anchor": "A4.SS2.SSS0.Px1.p1.1",
      "statement": "Differentiate actual Gaussian-convolved marginal log-density; differentiation under integral, normalization, finite conditional moments and representative conventions remain analytic obligations.",
      "boundary": "Source-only assertion; no Lean admission"
    },
    {
      "id": "pbps57:D10",
      "kind": "reused-equation",
      "source_anchor": "A4.E10",
      "statement": "grad U_eta=eta^-1(y-E[X|Y=y]); Hess U_eta=eta^-1(I-Sigma_y), Sigma_y=eta^-1 Cov(X|Y=y).",
      "boundary": "Source-only assertion; no Lean admission"
    },
    {
      "id": "pbps57:marginal-curvature",
      "kind": "source-proposition",
      "source_anchor": "S2.E13; A4.SS2.SSS0.Px1.p1.2",
      "statement": "alpha/(1+alpha eta) I<=Hess U_eta<=beta/(1+beta eta) I; actual nu, not supplied measure.",
      "boundary": "Source-only assertion; no Lean admission"
    },
    {
      "id": "pbps57:smooth-marginal-PI",
      "kind": "source-consequence",
      "source_anchor": "D.6 applied at Eq2.13; C.3 use site",
      "statement": "Var_nu(g)<=((1/alpha)+eta) E_nu||grad g||² for smooth g; alpha_nu=alpha/(1+alpha eta)>0.",
      "boundary": "Source-only assertion; no Lean admission"
    },
    {
      "id": "pbps57:weak-H1-adapter",
      "kind": "SOURCE_GAP",
      "source_anchor": "C.1 opening density/closedness; C.3 rough Af use",
      "statement": "Extend smooth PI to source weighted H1(nu); source does not prove smooth density and gradient closedness. Authored compact-gradient closure gives a scoped extension only, without asserting equivalence with weighted H1.",
      "boundary": "Source-only assertion; no Lean admission"
    },
    {
      "id": "pbps57:centered-Af",
      "kind": "source-proof-step",
      "source_anchor": "A3.SS1 C.3 preceding paragraph; B.1/B.2/B.9",
      "statement": "f in macro mean-zero implies Af centered because A preserves constants and actual marginal law; var_nu(Af)=||Af||².",
      "boundary": "Source-only assertion; no Lean admission"
    },
    {
      "id": "pbps57:C3",
      "kind": "actual-consumer",
      "source_anchor": "A3.E3",
      "statement": "For f in H_P,0: ||Af||²<=((1/alpha)+eta)||grad Af||². Domain requirement Af in source H1 is discharged using B.13 in printed argument, not an added public PI certificate.",
      "boundary": "Source-only assertion; no Lean admission"
    },
    {
      "id": "pbps57:C2",
      "kind": "independent-source-input",
      "source_anchor": "A3.E2",
      "statement": "eta||grad Af||²<=(1-alpha eta)²/[4(1+alpha eta)] (||f||²-||Af||²); separate gradient proof. Current closure result is a scoped adapter, not source H1 equivalence.",
      "boundary": "Source-only assertion; no Lean admission"
    },
    {
      "id": "pbps57:C4",
      "kind": "actual-downstream-consumer",
      "source_anchor": "A3.E4",
      "statement": "Combine C.2 with C.3 and rearrange: ||Af||<=(1-alpha eta)/(1+alpha eta)||f|| on mean-zero macro subspace; no claim candidate57 alone proves C.4.",
      "boundary": "Source-only assertion; no Lean admission"
    },
    {
      "id": "pbps57:Gamma-root",
      "kind": "separate-source-root",
      "source_anchor": "B.5/B.10/B.11; D.1",
      "statement": "Gamma=(I-A²)^(1/2) positive operator square root on macro L2; B*B=I-A² and norm defect; no weighted-Laplacian/resolvent identification, no eta prefactor.",
      "boundary": "Source-only assertion; no Lean admission"
    }
  ],
