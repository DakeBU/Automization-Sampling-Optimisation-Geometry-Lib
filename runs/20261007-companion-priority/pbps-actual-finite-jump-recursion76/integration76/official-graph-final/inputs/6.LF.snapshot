      {
        "id": "S2.Thmtheorem2",
        "tag": "div",
        "class": "ltx_theorem ltx_theorem_definition",
        "start_line": 777,
        "end_line": 784,
        "raw_sha256": "b82308ccee23ff7825c21760f156e93eeb18fb57a71ab5b4290d4c4f854613a7",
        "mathtext": "Definition 2.2 (Restricted Gaussian oracle).\n\nFor $\\eta>0$ , a restricted Gaussian oracle (RGO) takes input\n$y\\in\\mathbb{R}^{d}$ and, using fresh randomness, returns a sample with law\n$\\pi_{\\eta}^{X\\mid Y=y}$ .\n",
        "disposition": "EXCLUDED",
        "classification": "excluded-with-reason",
        "reason": "Retained §2 context outside the selected reflection/scale/notation background: vanilla process, refresh/thinning, Gibbs/geometric/oracle/divergence results are not admitted.",
        "overlap_policy": "Nested paragraph/theorem/display records overlap intentionally; coverage is by source region, not a theorem-count metric.",
        "compiled76_projection": {
          "status": "EXCLUDED_OPEN_OR_CONTEXT",
          "current_BODY_or_definition_lines": [],
          "compiled_parent_regions": [],
          "reason": "Retained §2 context outside the selected reflection/scale/notation background: vanilla process, refresh/thinning, Gibbs/geometric/oracle/divergence results are not admitted."
        }
      },
      {
        "id": "S2.Thmtheorem2.p1",
        "tag": "div",
        "class": "ltx_para",
        "start_line": 779,
        "end_line": 783,
        "raw_sha256": "2793d01948a205652c4e6b1a9edd18aba02f395d996c30a1f4cef50166f68689",
        "mathtext": "For $\\eta>0$ , a restricted Gaussian oracle (RGO) takes input\n$y\\in\\mathbb{R}^{d}$ and, using fresh randomness, returns a sample with law\n$\\pi_{\\eta}^{X\\mid Y=y}$ .\n",
