  have W := fun x => U x + ↑r / 2 * ‖x - u‖ ^ 2;
  have α := κ⁻¹ + ↑r;
  have β := 1 + r;
  have K := ↑β / α;
  have rp := ↑r + a⁻¹;
  have w := rp⁻¹ • (↑r • u + a⁻¹ • y);
  StrongConvexOn Set.univ α W ∧
    LipschitzWith β (gradient W) ∧
