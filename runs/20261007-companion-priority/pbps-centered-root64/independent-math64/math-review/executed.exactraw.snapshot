from review64 import *
def review():
 freeze=load(BASE/'math-freeze.json');candidates=[Path(x['path']) for x in freeze['inputs'][:3]];steps=[];issues=[]
 draft=load(BASE/'exposition.draft.json')
 for ui,u in enumerate(draft['units']):
  for j,s in enumerate(u['steps'],1):
   reg=s['lean_source_region'];p=ROOT/reg['path'];raw=p.read_bytes();lines=raw.splitlines(keepends=True);actual=b''.join(lines[reg['start_line']-1:reg['end_line']]);start=sum(map(len,lines[:reg['start_line']-1]));body=raw.index(b':= by')+len(b':= by')
   row={'unit':ui,'step':j,'title':s['title'],'formula':s['formula'],'source_region':reg,'full_source_RAW_matches':sha(raw)==reg['source_raw_sha256'],'literal_source_span_matches':actual==s['lean'].encode(),'raw_span_digest_matches':sha(actual)==reg['exact_code_raw_sha256'],'starts_in_BODY':start>=body,'provided_excerpt_RAW_sha256':sha(s['lean'].encode()),'actual_literal_span_RAW_sha256':sha(actual)};steps.append(row)
   if not all(row[k] for k in ['full_source_RAW_matches','literal_source_span_matches','raw_span_digest_matches','starts_in_BODY']):issues.append(row)
 assert len(steps)==12 and len(issues)==1 and (issues[0]['unit'],issues[0]['step'])==(1,6)
 p=candidates[1];body=b''.join(p.read_bytes().splitlines(keepends=True)[250:293]);proposal={'source_path':p.as_posix(),'source_RAW_sha256':sha(p.read_bytes()),'body_start_line':251,'body_end_line':293,'exact_BODY_RAW_sha256':sha(body),'exact_BODY_Lean':body.decode(),'status':'PROPOSED_ONLY_NO_CANONICAL_REPAIR','repair_boundary':'Replace only step6 excerpt/source-region, then independently source/exposition-review current12steps; not theorem/assumption repair.'};write('step6.BODY-repair.proposal.json',proposal)
 # Three exact preproof statement seals; strip only final LF plus single delimiter gap before := by.
 seals=[ROOT/'runs/20261007-companion-priority/pbps-centered-root-preproof64/header0.lean',ROOT/'runs/20261007-companion-priority/pbps-centered-root-preproof64/header1.lean',BASE/'test.header64.lean'];headers=[]
 for p,q in zip(candidates,seals):
  raw=p.read_bytes();header=raw[raw.index(b'theorem '):raw.index(b':= by')];sealed=q.read_bytes();assert header.rstrip(b' \r\n')==sealed.rstrip(b'\r\n');headers.append({'candidate':rawpin(p),'seal':rawpin(q),'match':'Exact header bytes after removing only final newline and delimiter-adjacent gap before := by; no internal whitespace normalization.'})
 late=[seals[2],ROOT/'.lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/Positive.lean',ROOT/'.lake/packages/mathlib/Mathlib/Analysis/SpecialFunctions/ContinuousFunctionalCalculus/Rpow/Order.lean']
 for i,p in enumerate(late):(OUT/'inputs'/f'late-{i}.exactraw.snapshot').write_bytes(p.read_bytes())
 write('late-inspection.inputs.json',{'qualification':'Statement-seal/Mathlib API read after independent compile, not compilation pre-inputs; fixed package HEAD remains pinned','inputs':[rawpin(p) for p in late]})
 f=load(OUT/'focused/receipt.json');assert f['exit_code']==0 and f['terminal_closed'] and f['pre_post_equal']
 log=(OUT/'focused/stdout.log').read_text(encoding='utf-8');assert 'Build completed successfully (3944 jobs).' in log
 names=freeze['mathematical_declarations']+[freeze['genuine_consumer']];axioms=[]
 for n in names:
  m=re.search(re.escape("'"+n+"' depends on axioms: [")+r'([^\]]+)\]',log,re.S);assert m,n;a={v.strip() for v in m.group(1).split(',')};assert a=={'propext','Classical.choice','Quot.sound'};axioms.append({'declaration':n,'axioms':sorted(a)})
 sys.path.insert(0,str(ROOT/'tools'));import astis
 hits=[];decls=[]
 for p in candidates:
  text=astis.strip_lean_comments_and_strings(p.read_text());assert not re.search(r'^\s*private\s+(?:theorem|def|abbrev)',text,re.M)
  decls+=re.findall(r'^theorem\s+(\w+)',text,re.M)
  for i,line in enumerate(text.splitlines(),1):
   if astis.FORBIDDEN_REGEX.search(line):hits.append({'file':p.as_posix(),'line':i,'text':line})
 assert len(decls)==3 and hits==[]
 # Qualify the sole concurrent metadata correction using exact before/current objects.
 sm=load(OUT/'input.supplement.json');lessonmap=sm['qualified_maps'][0];old=load(lessonmap['map']['explicit_exact_raw_snapshot']['path']);new=load(lessonmap['current']['path']);a=old['units'][0].copy();b=new['units'][0].copy();olddeps=a.pop('astis_dependencies');newdeps=b.pop('astis_dependencies');assert a==b and newdeps==olddeps+[names[0]]
 auditmap=sm['qualified_maps'][1];a=load(auditmap['map']['explicit_exact_raw_snapshot']['path']);b=load(auditmap['current']['path']);a.pop('publication_binding_sha256');b.pop('publication_binding_sha256');a['publication_context']['lesson'].pop('astis_dependencies');b['publication_context']['lesson'].pop('astis_dependencies');assert a==b
 mirror=load(BASE/'conceptual-mirror-audit64.json');assert mirror['status']=='none-found' and mirror['discovery_ids']==[]
 # Reuse63 by exact already accepted native identity and unchanged source, not transcript replay.
 macro=candidates[1].parent/'MacroscopicDefectRoot.lean';assert sha(macro.read_bytes())=='1022d344a428efaafd7443c65317c5bde0a2f3ed05161caaac8bf15ae239858a'
 native=ROOT/'runs/20261007-companion-priority/pbps-macro-root63/exact-science-verification';assert load(native/'lease.json')['status']=='CLOSED_LAST'
 stages=[
 {'stage':'Arbitrary real L2 operator order','finding':'Accepted. Three canonical complex lifts preserve positivity and share literal real/imaginary decomposition. Extensionality proves Dc=Bc^2-Ac^2 without commutation; internal nonunital complex/real CFC gives sqrt monotonicity and uniqueness, then canonical isometric real embedding descends the positive quadratic form. Arbitrary measure, zero/trivial L2 and no caller CFC/nontrivial/finite-dimensional premise are preserved.'},
 {'stage':'Same actual root and centering','finding':'Accepted. Actual63 witnesses are destructured once and SAME e/U/T/Gamma reused. q is canonical constant one; integral preservation plus selfadjointness prove Tq=q; transported macro energy proves Gamma q=0. No replacement root/gap supplied.'},
 {'stage':'Same production gradient and C4','finding':'Accepted. Rough and Gaussian-marginal Poincare compact-gradient graph equalities prove SAME G via LinearPMap graph extensionality. Every-observable normalized-kernel AE action identifies rough Tr with SAME T. Poincare and sharp rough bound yield rho=(1-alphaeta)/(1+alphaeta), gamma^2=1-rho^2 with gamma=2sqrt(alphaeta)/(1+alphaeta).'},
 {'stage':'Genuine positive operator order','finding':'Accepted. Q=I-q tensor q is selfadjoint positive idempotent; Qu centered, GammaQ=Gamma. Energy/sharp centered contraction prove Gamma^2-(gammaQ)^2 positive on FULL scalar L2. Auxiliary square order yields Gamma-gammaQ positive, not merely norm lower bound. Transport/restrict to exact HP0 proves GammaP0-gamma I positive.'},
 {'stage':'Exact centered space and inverse','finding':'Accepted. HP0=ker inner(e q,.) closed and complete, exact zero-nu-mean under e inverse. GammaP annihilates qP and symmetry preserves HP0. codRestrict uses inherited Hilbert structure. Positive operator order gives gamma||f||^2<=<GammaP0 f,f>; CompleteSpace coercivity API internally derives IsUnit without onto/inverse premise. Unit inverse satisfies BOTH products=I; Cauchy-Schwarz derives norm inverse<=1/gamma.'},
 {'stage':'Genuine Test consumer','finding':'Accepted. Only original potential/Hessian/step/structural inputs. Reuses SAME typed Gram and centered right inverse to prove norm of B i0 Inv f equals norm f and P B i0 Inv f=0. No completed public polar-isometry/codomain-closed-complement/onto theorem is claimed.'},
 {'stage':'Endpoints and assumptions','finding':'Accepted. Original C2 and TWO global Hessian bounds,0<alpha<=beta,eta>0,betaeta<=1. alphaeta=1 gives rho=0,gamma=1 with no division by1-alphaeta. Rank0 permits trivial HP0; no source-positive-dimension/finite-L2/nontrivial binder introduced. Gamma inverse only on HP0; constants force full-space Gamma kernel.'},
 {'stage':'Reuse/imports/conceptual mirror','finding':'Accepted bounded reuse. Generic leaf imports existing canonical complex lift and targeted StarOrder/CFC instance/rpow order APIs; actual node imports four exact compiled parents plus Banach; Test imports actual node. No new private provider. none-found is consistent: exact real/complex lift, constant projection and within-model centered restriction are genuine dependency adapters, with no newly proposed weaker cross-model bridge. Existing coercivity mechanism is reused without upgrading conceptual edges.'}]
 write('mathematical-review.json',{'status':'MATHEMATICS_ACCEPTED_PRECOMMIT_PUBLICATION_BLOCKED','actor':ACTOR,'actual_pid':os.getpid(),'checked_BASE':COMMIT,'candidate_uncommitted':True,'VERIFIED_transition':False,'candidate_headers_exact_sealed':headers,'independent_compiler':rawpin(OUT/'focused/receipt.json'),'standard_three_axioms':axioms,'fake_closure_hits':hits,'new_declarations':decls,'private_providers':0,'proof_stages':stages,'all_12_formula_texts_mathematically_supported':True,'12_raw_body_region_inventory':steps,'presentation_blockers':[{'class':'EXCERPT_BODY_BINDING','unit':1,'step':6,'severity':'publication-blocking','finding':'Claimed73-293 starts at16-space theorem-header let qP, includes statement/initial proof; supplied excerpt first line removes14spaces and raw digest fails. Allother11 literal spans and body checks pass.','body_only_repair_proposal':rawpin(OUT/'step6.BODY-repair.proposal.json')}],'concurrent_metadata_dependency_change':'Exactly two finite original-to-RAW mappings accepted; only actual lesson dependencies and DRAFT binding context refresh, allstatement/formula/Lean/excerpts unchanged.','source_review':'Independent source-blind decoder and anti-anchored source admission remain separate; this mathematical review does not perform their acceptance.','remaining_boundary':['Presentation step6 body binding repair and independent source/exposition admission.','Exact SCI64 commit review not yet possible; current review covers uncommitted candidates against BASE only.','Full-joint inverse or public completed polar/closed-complement codomain/onto theorem.','OtherB5,H1/B13/B14 source obligations,event dynamics/nonexplosion/invariance/hypocoercivity/main mixing/error/expected costs/actual-input PBPS-SPHMC composition.','GaussianCloud/midpoint/fullpaper/Goal/readerdelivery/PURIFIED/main/live.']})
 print(json.dumps({'status':'MATHEMATICS_ACCEPTED_PRECOMMIT_PUBLICATION_BLOCKED','actual_pid':os.getpid(),'independent_compile_pid':f['actual_foreground_pid'],'jobs':3944,'literal_BODY_steps_pass':11,'presentation_blockers':1,'private_providers':0,'new_standard_three_declarations':3}))
