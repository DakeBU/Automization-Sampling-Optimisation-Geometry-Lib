  "pull_forward_rules": [
    {
      "from": "Optimization Chapter 9 Fenchel duality",
      "to": "sf-convex-duality",
      "unlocks": "Statistical OT §§1.5-1.6",
      "status_effect": "No Optimization Chapter 9 completion credit; only the exact shared lemmas audited are registered."
    },
    {
      "from": "Boumal Chapter 3 first-order embedded geometry",
      "to": "sf-manifold-first-order",
      "unlocks": "Sampling §2.5",
      "status_effect": "Boumal Chapters 1-2 need not be exhaustively closed first; source dependencies required by the extracted Chapter 3 lemma must still be proved."
    },
    {
      "from": "Statistical OT Chapter 1 coupling/Wasserstein core",
      "to": "sf-coupling-wasserstein",
      "unlocks": "Sampling §§1.3-1.4",
      "status_effect": "Sampling must reuse the canonical transport core instead of proving a second Wasserstein mini-library."
    },
    {
      "from": "Optimization Chapter 1 convex core",
      "to": "sf-convex-energy",
      "unlocks": "Sampling Chapter 2 strong-convexity/log-concavity arguments and OT Brenier prerequisites",
      "status_effect": "Route wrappers retain each textbook's exact definitions and constants."
    },
    {
      "to": "sf-finite-dirichlet",
      "unlocks": "Finite-chain mixing plus shared Chapter 2 L2/coercivity consumers",
      "status_effect": "Only exact audited leaves count; §12 Ising model definitions may also be read early without mixing-theorem credit.",
      "from": "Discrete Sampling §3"
    }
  ],
  "integration_gates": [
