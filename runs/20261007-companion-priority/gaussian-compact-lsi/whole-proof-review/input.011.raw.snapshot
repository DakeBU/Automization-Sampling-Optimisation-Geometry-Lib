    {
      "id": "TARGET",
      "kind": "PROSPECTIVE_CONCLUSION",
      "formula": "Every signed C2compact scalar f: literal Ent_gaussianReal0,1(f²)<=2 integral(derivf)²",
      "classification": "PROSPECTIVE_STATEMENT_ONLY",
      "anchors": [
        {
          "input_role": "root38_signature",
          "start_line": 1,
          "end_line": 6,
          "literal_LF_sha256": "cf52aef70523e2e4f95eb9ccefc2ea661ddb6ed1e0400bc8f02473c282ee0e63",
          "literal": "theorem compact_gaussian_logSobolev\n    (f : ℝ → ℝ) (hf : ContDiff ℝ 2 f) (hs : HasCompactSupport f) :\n    let γ : Measure ℝ := gaussianReal 0 1\n    (∫ x, (f x)^2 * Real.log ((f x)^2) ∂γ) -\n      (∫ x, (f x)^2 ∂γ) * Real.log (∫ x, (f x)^2 ∂γ) ≤\n    2 * ∫ x, (deriv f x)^2 ∂γ\n"
        }
      ],
      "status": "not proved/claimed; independent statement review is separate"
    },
    {
      "id": "A-ZERO",
      "kind": "BOUNDARY_CONVENTION",
      "formula": "f0/zero Gaussian mass allowed:0log0=0; no mass division; parent36 genuine entropy convergence includes0",
      "classification": "DERIVED_BOUNDARY_NOT_NEW_BINDER",
      "anchors": [
        {
          "input_role": "local_zero_mass_continuity",
          "start_line": 45,
          "end_line": 63,
          "literal_LF_sha256": "811a9ca8239c7b83b932a0c1fa6e964a4e6e126a1f8e892bdeaf09fca0d8557b",
          "literal": "lemma continuous_mul_log : Continuous fun x ↦ x * log x := by\n  rw [continuous_iff_continuousAt]\n  intro x\n  obtain hx | rfl := ne_or_eq x 0\n  · exact (continuous_id'.continuousAt).mul (continuousAt_log hx)\n  rw [ContinuousAt, zero_mul]\n  simp_rw [mul_comm _ (log _)]\n  nth_rewrite 1 [← nhdsWithin_univ]\n  have : (Set.univ : Set ℝ) = Set.Iio 0 ∪ Set.Ioi 0 ∪ {0} := by ext; simp [em]\n  rw [this, nhdsWithin_union, nhdsWithin_union]\n  simp only [nhdsWithin_singleton, Filter.tendsto_sup]\n  refine ⟨⟨tendsto_log_mul_self_nhdsLT_zero, ?_⟩, ?_⟩\n  · simpa only [rpow_one] using tendsto_log_mul_rpow_nhdsGT_zero zero_lt_one\n  · convert! tendsto_pure_nhds (fun x ↦ log x * x) 0\n    simp\n\n@[fun_prop]\nlemma Continuous.mul_log {α : Type*} [TopologicalSpace α] {f : α → ℝ} (hf : Continuous f) :\n    Continuous fun a ↦ f a * log (f a) := continuous_mul_log.comp hf\n"
        },
        {
          "input_role": "parent36_signature",
          "start_line": 22,
          "end_line": 27,
          "literal_LF_sha256": "218fcf2bf3b3e87a76eacaae1464f75388da2be36398b740c6d2b073fcc6518f",
          "literal": "    Tendsto (fun n : ℕ =>\n      (∫ ε, (f (S (n+1) ε))^2 * Real.log ((f (S (n+1) ε))^2) ∂μ (n+1)) -\n      (∫ ε, (f (S (n+1) ε))^2 ∂μ (n+1)) *\n        Real.log (∫ ε, (f (S (n+1) ε))^2 ∂μ (n+1))) atTop\n      (𝓝 ((∫ x, (f x)^2 * Real.log ((f x)^2) ∂γ) -\n        (∫ x, (f x)^2 ∂γ) * Real.log (∫ x, (f x)^2 ∂γ)))\n"
        }
      ]
    },
    {
      "id": "A-N0",
      "kind": "BOUNDARY_CONVENTION",
      "formula": "FiniteN0 singletoncount,S0=0,entropy0,empty fullflip0; derivative observer atN0 may be(derivf0)²; limits are only successors",
      "classification": "AUTHORED_DEFINITION_BOUNDARY",
      "anchors": [
        {
          "input_role": "parent34_signature",
          "start_line": 1,
          "end_line": 5,
          "literal_LF_sha256": "1e97f2f46a3d77edf9e22eb16368db391a427ec8211f28383efceee3fc5137a5",
          "literal": "theorem bernoulli_function_logSobolev (n : ℕ) (h : (Fin n → Bool) → ℝ) :\n    let μ : Measure (Fin n → Bool) :=\n      (Fintype.card (Fin n → Bool) : ℝ≥0∞)⁻¹ • Measure.count\n    let D := fun ε : Fin n → Bool =>\n      ∑ j : Fin n, (h ε - h (Function.update ε j (!ε j))) ^ 2\n"
        },
        {
          "input_role": "parent36_signature",
          "start_line": 5,
          "end_line": 6,
          "literal_LF_sha256": "23f648fe1637156c1ee08247dbeee89be1e8f7b0fdc3adca65a41208a1077e1b",
          "literal": "    let S : (n : ℕ) → (Fin n → Bool) → ℝ := fun n ε =>\n      (Real.sqrt (n : ℝ))⁻¹ * ∑ j : Fin n, if ε j then (1 : ℝ) else -1\n"
        },
        {
          "input_role": "prospective37_signature_only",
          "start_line": 10,
          "end_line": 15,
          "literal_LF_sha256": "1eb2e32f2f2217018ae2c9520fff4ab05470ff707e17408a503cb7f2fa0f7a19",
          "literal": "      (fun ε : Fin n → Bool => ∑ j : Fin n,\n        (f (S n (Function.update ε j (!ε j))) - f (S n ε))^2) (μ n)) ∧\n    Tendsto (fun n : ℕ => ∫ ε : Fin (n+1) → Bool,\n      (∑ j : Fin (n+1),\n        (f (S (n+1) (Function.update ε j (!ε j))) - f (S (n+1) ε))^2)\n      ∂μ (n+1)) atTop (𝓝 (4 * ∫ x, (deriv f x)^2 ∂γ))\n"
        }
      ]
    },
    {
      "id": "GAP-CARRIER-TRANSPORT",
      "kind": "SOURCE_GAP",
      "formula": "Printed real-product/sum-of-integrals route is not interchangeable with actual count route without a genuine measure-map/L1 finite-sum adapter. Direct authored route avoids needing that transport.",
      "classification": "SOURCE_REPRESENTATION_BOUNDARY_NOT_PUBLIC_BINDER",
      "anchors": [
        {
          "input_role": "external_Bernoulli_app",
