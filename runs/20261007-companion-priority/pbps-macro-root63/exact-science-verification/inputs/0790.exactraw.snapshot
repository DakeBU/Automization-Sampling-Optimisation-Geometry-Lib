-/
theorem generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDominated
    {Ω State Vec Test : Type*} [MeasurableSpace Ω] [MeasurableSpace State]
    [NormedAddCommGroup Vec] [NormedSpace ℝ Vec] [CompleteSpace Vec]
    [InnerProductSpace Real Vec] [StandardBorelSpace State] [Nonempty State]
    {P : MeasureTheory.Measure Ω} [MeasureTheory.IsFiniteMeasure P]
    {hatX : Real → Ω → State}
    {hatRhoS : Real → MeasureTheory.Measure State}
    {Xk : Ω → State}
    {guideIntegrand scoreIntegrand : State × State → Vec}
    (testEval : Test → State → Real)
    (testGrad : Test → State → Vec)
    (Admissible : Test → Prop)
    (commonSpace conditionalKernel driftRegular densityRegular testRegular
      boundaryBehavior : Prop)
    (driftAction diffusionAction driftDiv laplacian : Test → Real)
    (s0 sLeft sRight dotTk sigmaEta sigmaCoeff : Real)
    (pairBound : Test → Real)
    (sampleDeriv : Test → Real → Ω → Real)
    (bound : Test → Ω → Real)
    (hhatRhoS : ∀ s, hatRhoS s = MeasureTheory.Measure.map (hatX s) P)
    (hhatXAtS : Measurable (hatX s0))
    (hhatX : ∀ s, AEMeasurable (hatX s) P)
    (hXk : AEMeasurable Xk P)
    (hguideMeas :
      MeasureTheory.AEStronglyMeasurable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hguideInt :
      MeasureTheory.Integrable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreMeas :
      MeasureTheory.AEStronglyMeasurable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreInt :
      MeasureTheory.Integrable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (htestMeas :
      ∀ φ s, Admissible φ →
        MeasureTheory.AEStronglyMeasurable (testEval φ) (hatRhoS s))
    (htestInt :
      ∀ φ s, Admissible φ →
        MeasureTheory.Integrable (testEval φ) (hatRhoS s))
    (hcommon : commonSpace)
    (hkernel : conditionalKernel)
    (hdrift : driftRegular)
    (hdensity : densityRegular)
    (htests : testRegular)
    (hboundary : boundaryBehavior)
    (hcoeff : sigmaCoeff = sigmaEta ^ 2 / 2)
    (hs0Interval : s0 ∈ Set.Ioo sLeft sRight)
    (hsampleDerivMeas :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.AEStronglyMeasurable (sampleDeriv φ s0) P)
    (hsampleDerivBound :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          ‖sampleDeriv φ s ω‖ ≤ bound φ ω)
    (hboundInt :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.Integrable (bound φ) P)
    (hpathDeriv :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          HasDerivAt (fun t => testEval φ (hatX t ω))
            (sampleDeriv φ s ω) s)
    (hderivValue :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        (∫ ω, sampleDeriv φ s0 ω ∂P) = driftAction φ + diffusionAction φ)
    (hdiffusionSource :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        diffusionAction φ = sigmaCoeff • laplacian φ) :
    let canonicalBarB : State → Vec :=
      fun x =>
        dotTk •
            (∫ y, guideIntegrand (x, y)
              ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x) +
          sigmaCoeff •
            (∫ y, scoreIntegrand (x, y)
              ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x)
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftAction φ =
        (fun f ψ => ∫ x, inner Real (testGrad ψ x) (f x) ∂(hatRhoS s0))
          canonicalBarB φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      MeasureTheory.AEStronglyMeasurable
        (fun x => inner Real (testGrad φ x) (canonicalBarB x)) (hatRhoS s0)) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      ∀ᵐ x ∂(hatRhoS s0), ‖testGrad φ x‖ ≤ pairBound φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftDiv φ =
        -(∫ x, inner Real (testGrad φ x) (canonicalBarB x) ∂(hatRhoS s0))) →
    ∀ φ, Admissible φ →
      HasDerivAt
        (fun s => ∫ x, testEval φ x ∂hatRhoS s)
        (-(driftDiv φ) + (sigmaEta ^ 2 / 2) • laplacian φ) s0 := by
  exact
    generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasDominated
      testEval testGrad Admissible commonSpace conditionalKernel driftRegular
      densityRegular testRegular boundaryBehavior driftAction diffusionAction
      driftDiv laplacian s0 sLeft sRight dotTk sigmaEta sigmaCoeff
      pairBound sampleDeriv bound hhatRhoS hhatXAtS hhatX hXk hguideMeas
      hguideInt hscoreMeas hscoreInt htestMeas hcommon hkernel hdrift
      hdensity htests hboundary hcoeff hs0Interval
      (by
        intro φ hφ _hcommon _hkernel _hdrift _hdensity _htests _hboundary
        have htestIntMap :
            MeasureTheory.Integrable (testEval φ)
              (MeasureTheory.Measure.map (hatX s0) P) := by
          simpa [hhatRhoS s0] using htestInt φ s0 hφ
        simpa [Function.comp_def] using
          htestIntMap.comp_aemeasurable (hhatX s0))
      hsampleDerivMeas hsampleDerivBound hboundInt hpathDeriv hderivValue
      hdiffusionSource

/-- Canonical `barB` dominated weak derivative on the source EM interval,
with sample derivative measurability derived from a concrete EM derivative
representative.

This cycle-123 lower theorem removes the supplied `hsampleDerivMeas` premise
from the cycle-122 packet.  The source-facing input is now that the concrete
sample derivative
`fun omega => deriv (fun t => testEval phi (hatX t omega)) s0` is a.e.
strongly measurable and agrees a.e. with the chosen `sampleDeriv phi s0`
representative.  The remaining EM calculus facts are local domination,
bound integrability, pointwise `HasDerivAt`, derivative-value splitting, and
source actions.
-/
theorem generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDerivMeasDominated
    {Ω State Vec Test : Type*} [MeasurableSpace Ω] [MeasurableSpace State]
    [NormedAddCommGroup Vec] [NormedSpace ℝ Vec] [CompleteSpace Vec]
    [InnerProductSpace Real Vec] [StandardBorelSpace State] [Nonempty State]
    {P : MeasureTheory.Measure Ω} [MeasureTheory.IsFiniteMeasure P]
    {hatX : Real → Ω → State}
    {hatRhoS : Real → MeasureTheory.Measure State}
    {Xk : Ω → State}
    {guideIntegrand scoreIntegrand : State × State → Vec}
    (testEval : Test → State → Real)
    (testGrad : Test → State → Vec)
    (Admissible : Test → Prop)
    (commonSpace conditionalKernel driftRegular densityRegular testRegular
      boundaryBehavior : Prop)
    (driftAction diffusionAction driftDiv laplacian : Test → Real)
    (s0 sLeft sRight dotTk sigmaEta sigmaCoeff : Real)
    (pairBound : Test → Real)
    (sampleDeriv : Test → Real → Ω → Real)
    (bound : Test → Ω → Real)
    (hhatRhoS : ∀ s, hatRhoS s = MeasureTheory.Measure.map (hatX s) P)
    (hhatXAtS : Measurable (hatX s0))
    (hhatX : ∀ s, AEMeasurable (hatX s) P)
    (hXk : AEMeasurable Xk P)
    (hguideMeas :
      MeasureTheory.AEStronglyMeasurable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hguideInt :
      MeasureTheory.Integrable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreMeas :
      MeasureTheory.AEStronglyMeasurable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreInt :
      MeasureTheory.Integrable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (htestMeas :
      ∀ φ s, Admissible φ →
        MeasureTheory.AEStronglyMeasurable (testEval φ) (hatRhoS s))
    (htestInt :
      ∀ φ s, Admissible φ →
        MeasureTheory.Integrable (testEval φ) (hatRhoS s))
    (hcommon : commonSpace)
    (hkernel : conditionalKernel)
    (hdrift : driftRegular)
    (hdensity : densityRegular)
    (htests : testRegular)
    (hboundary : boundaryBehavior)
    (hcoeff : sigmaCoeff = sigmaEta ^ 2 / 2)
    (hs0Interval : s0 ∈ Set.Ioo sLeft sRight)
    (hconcreteSampleDerivMeas :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.AEStronglyMeasurable
          (fun ω => deriv (fun t : Real => testEval φ (hatX t ω)) s0) P)
    (hsampleDerivConcreteAeEq :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        sampleDeriv φ s0 =ᵐ[P]
          (fun ω => deriv (fun t : Real => testEval φ (hatX t ω)) s0))
    (hsampleDerivBound :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          ‖sampleDeriv φ s ω‖ ≤ bound φ ω)
    (hboundInt :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.Integrable (bound φ) P)
    (hpathDeriv :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          HasDerivAt (fun t => testEval φ (hatX t ω))
            (sampleDeriv φ s ω) s)
    (hderivValue :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        (∫ ω, sampleDeriv φ s0 ω ∂P) = driftAction φ + diffusionAction φ)
    (hdiffusionSource :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        diffusionAction φ = sigmaCoeff • laplacian φ) :
    let canonicalBarB : State → Vec :=
      fun x =>
        dotTk •
            (∫ y, guideIntegrand (x, y)
              ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x) +
          sigmaCoeff •
            (∫ y, scoreIntegrand (x, y)
              ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x)
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftAction φ =
        (fun f ψ => ∫ x, inner Real (testGrad ψ x) (f x) ∂(hatRhoS s0))
          canonicalBarB φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      MeasureTheory.AEStronglyMeasurable
        (fun x => inner Real (testGrad φ x) (canonicalBarB x)) (hatRhoS s0)) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      ∀ᵐ x ∂(hatRhoS s0), ‖testGrad φ x‖ ≤ pairBound φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftDiv φ =
        -(∫ x, inner Real (testGrad φ x) (canonicalBarB x) ∂(hatRhoS s0))) →
    ∀ φ, Admissible φ →
      HasDerivAt
        (fun s => ∫ x, testEval φ x ∂hatRhoS s)
        (-(driftDiv φ) + (sigmaEta ^ 2 / 2) • laplacian φ) s0 := by
  exact
    generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDominated
      testEval testGrad Admissible commonSpace conditionalKernel driftRegular
      densityRegular testRegular boundaryBehavior driftAction diffusionAction
      driftDiv laplacian s0 sLeft sRight dotTk sigmaEta sigmaCoeff
      pairBound sampleDeriv bound hhatRhoS hhatXAtS hhatX hXk hguideMeas
      hguideInt hscoreMeas hscoreInt htestMeas htestInt hcommon hkernel
      hdrift hdensity htests hboundary hcoeff hs0Interval
      (by
        intro φ hφ hcommon hkernel hdrift hdensity htests hboundary
        exact
          (hconcreteSampleDerivMeas φ hφ hcommon hkernel hdrift hdensity
              htests hboundary).congr
            (hsampleDerivConcreteAeEq φ hφ hcommon hkernel hdrift hdensity
              htests hboundary).symm)
      hsampleDerivBound hboundInt hpathDeriv hderivValue hdiffusionSource

/-- Canonical `barB` dominated weak derivative on the source EM interval,
with the local sample-derivative bound transported from the concrete EM
derivative representative.

This cycle-124 lower theorem removes the supplied `hsampleDerivBound` premise
from the cycle-123 packet.  The source-facing input is now a concrete bound for
`deriv (fun t => testEval phi (hatX t omega)) s` on the EM interval plus an
a.e. interval equality between that concrete derivative and the chosen
`sampleDeriv phi s` representative.  The theorem keeps bound integrability,
pointwise `HasDerivAt`, derivative-value splitting, and source actions explicit.
-/
theorem generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDerivMeasBoundDominated
    {Ω State Vec Test : Type*} [MeasurableSpace Ω] [MeasurableSpace State]
    [NormedAddCommGroup Vec] [NormedSpace ℝ Vec] [CompleteSpace Vec]
    [InnerProductSpace Real Vec] [StandardBorelSpace State] [Nonempty State]
    {P : MeasureTheory.Measure Ω} [MeasureTheory.IsFiniteMeasure P]
    {hatX : Real → Ω → State}
    {hatRhoS : Real → MeasureTheory.Measure State}
    {Xk : Ω → State}
    {guideIntegrand scoreIntegrand : State × State → Vec}
    (testEval : Test → State → Real)
    (testGrad : Test → State → Vec)
    (Admissible : Test → Prop)
    (commonSpace conditionalKernel driftRegular densityRegular testRegular
      boundaryBehavior : Prop)
    (driftAction diffusionAction driftDiv laplacian : Test → Real)
    (s0 sLeft sRight dotTk sigmaEta sigmaCoeff : Real)
    (pairBound : Test → Real)
    (sampleDeriv : Test → Real → Ω → Real)
    (bound : Test → Ω → Real)
    (hhatRhoS : ∀ s, hatRhoS s = MeasureTheory.Measure.map (hatX s) P)
    (hhatXAtS : Measurable (hatX s0))
    (hhatX : ∀ s, AEMeasurable (hatX s) P)
    (hXk : AEMeasurable Xk P)
    (hguideMeas :
      MeasureTheory.AEStronglyMeasurable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hguideInt :
      MeasureTheory.Integrable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreMeas :
      MeasureTheory.AEStronglyMeasurable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreInt :
      MeasureTheory.Integrable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (htestMeas :
      ∀ φ s, Admissible φ →
        MeasureTheory.AEStronglyMeasurable (testEval φ) (hatRhoS s))
    (htestInt :
      ∀ φ s, Admissible φ →
        MeasureTheory.Integrable (testEval φ) (hatRhoS s))
    (hcommon : commonSpace)
    (hkernel : conditionalKernel)
    (hdrift : driftRegular)
    (hdensity : densityRegular)
    (htests : testRegular)
    (hboundary : boundaryBehavior)
    (hcoeff : sigmaCoeff = sigmaEta ^ 2 / 2)
    (hs0Interval : s0 ∈ Set.Ioo sLeft sRight)
    (hconcreteSampleDerivMeas :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.AEStronglyMeasurable
          (fun ω => deriv (fun t : Real => testEval φ (hatX t ω)) s0) P)
    (hsampleDerivConcreteAeEqInterval :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          sampleDeriv φ s ω =
            deriv (fun t : Real => testEval φ (hatX t ω)) s)
    (hconcreteSampleDerivBound :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          ‖deriv (fun t : Real => testEval φ (hatX t ω)) s‖ ≤ bound φ ω)
    (hboundInt :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.Integrable (bound φ) P)
    (hpathDeriv :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          HasDerivAt (fun t => testEval φ (hatX t ω))
            (sampleDeriv φ s ω) s)
    (hderivValue :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        (∫ ω, sampleDeriv φ s0 ω ∂P) = driftAction φ + diffusionAction φ)
    (hdiffusionSource :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        diffusionAction φ = sigmaCoeff • laplacian φ) :
    let canonicalBarB : State → Vec :=
      fun x =>
        dotTk •
            (∫ y, guideIntegrand (x, y)
              ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x) +
          sigmaCoeff •
            (∫ y, scoreIntegrand (x, y)
              ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x)
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftAction φ =
        (fun f ψ => ∫ x, inner Real (testGrad ψ x) (f x) ∂(hatRhoS s0))
          canonicalBarB φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      MeasureTheory.AEStronglyMeasurable
        (fun x => inner Real (testGrad φ x) (canonicalBarB x)) (hatRhoS s0)) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      ∀ᵐ x ∂(hatRhoS s0), ‖testGrad φ x‖ ≤ pairBound φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftDiv φ =
        -(∫ x, inner Real (testGrad φ x) (canonicalBarB x) ∂(hatRhoS s0))) →
    ∀ φ, Admissible φ →
      HasDerivAt
        (fun s => ∫ x, testEval φ x ∂hatRhoS s)
        (-(driftDiv φ) + (sigmaEta ^ 2 / 2) • laplacian φ) s0 := by
  exact
    generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDerivMeasDominated
      testEval testGrad Admissible commonSpace conditionalKernel driftRegular
      densityRegular testRegular boundaryBehavior driftAction diffusionAction
      driftDiv laplacian s0 sLeft sRight dotTk sigmaEta sigmaCoeff
      pairBound sampleDeriv bound hhatRhoS hhatXAtS hhatX hXk hguideMeas
      hguideInt hscoreMeas hscoreInt htestMeas htestInt hcommon hkernel
      hdrift hdensity htests hboundary hcoeff hs0Interval
      hconcreteSampleDerivMeas
      (by
        intro φ hφ hcommon hkernel hdrift hdensity htests hboundary
        filter_upwards
          [hsampleDerivConcreteAeEqInterval φ hφ hcommon hkernel hdrift
            hdensity htests hboundary] with ω hω
        exact hω s0 hs0Interval)
      (by
        intro φ hφ hcommon hkernel hdrift hdensity htests hboundary
        filter_upwards
          [hconcreteSampleDerivBound φ hφ hcommon hkernel hdrift hdensity
              htests hboundary,
            hsampleDerivConcreteAeEqInterval φ hφ hcommon hkernel hdrift
              hdensity htests hboundary] with ω hbound heq s hs
        calc
          ‖sampleDeriv φ s ω‖ =
              ‖deriv (fun t : Real => testEval φ (hatX t ω)) s‖ := by
            rw [heq s hs]
          _ ≤ bound φ ω := hbound s hs)
      hboundInt hpathDeriv hderivValue hdiffusionSource

/-- Canonical `barB` dominated weak derivative on the source EM interval,
with the dominating bound integrability transported from the joint EM law.

This lower theorem removes the supplied `hboundInt` premise from the
cycle-124 interval packet.  The source-facing input is now an integrable bound
on the joint law of `(hatX s0, Xk)` together with an a.e. equality identifying
the selected sample-space bound with that joint-law representative.  Pointwise
`HasDerivAt`, derivative-value splitting, and source actions remain explicit.
-/
theorem generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDerivMeasBoundIntDominated
    {Ω State Vec Test : Type*} [MeasurableSpace Ω] [MeasurableSpace State]
    [NormedAddCommGroup Vec] [NormedSpace ℝ Vec] [CompleteSpace Vec]
    [InnerProductSpace Real Vec] [StandardBorelSpace State] [Nonempty State]
    {P : MeasureTheory.Measure Ω} [MeasureTheory.IsFiniteMeasure P]
    {hatX : Real → Ω → State}
    {hatRhoS : Real → MeasureTheory.Measure State}
    {Xk : Ω → State}
    {guideIntegrand scoreIntegrand : State × State → Vec}
    (testEval : Test → State → Real)
    (testGrad : Test → State → Vec)
    (Admissible : Test → Prop)
    (commonSpace conditionalKernel driftRegular densityRegular testRegular
      boundaryBehavior : Prop)
    (driftAction diffusionAction driftDiv laplacian : Test → Real)
    (s0 sLeft sRight dotTk sigmaEta sigmaCoeff : Real)
    (pairBound : Test → Real)
    (sampleDeriv : Test → Real → Ω → Real)
    (bound : Test → Ω → Real)
    (jointBound : Test → State × State → Real)
    (hhatRhoS : ∀ s, hatRhoS s = MeasureTheory.Measure.map (hatX s) P)
    (hhatXAtS : Measurable (hatX s0))
    (hhatX : ∀ s, AEMeasurable (hatX s) P)
    (hXk : AEMeasurable Xk P)
    (hguideMeas :
      MeasureTheory.AEStronglyMeasurable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hguideInt :
      MeasureTheory.Integrable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreMeas :
      MeasureTheory.AEStronglyMeasurable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreInt :
      MeasureTheory.Integrable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (htestMeas :
      ∀ φ s, Admissible φ →
        MeasureTheory.AEStronglyMeasurable (testEval φ) (hatRhoS s))
    (htestInt :
      ∀ φ s, Admissible φ →
        MeasureTheory.Integrable (testEval φ) (hatRhoS s))
    (hcommon : commonSpace)
    (hkernel : conditionalKernel)
    (hdrift : driftRegular)
    (hdensity : densityRegular)
    (htests : testRegular)
    (hboundary : boundaryBehavior)
    (hcoeff : sigmaCoeff = sigmaEta ^ 2 / 2)
    (hs0Interval : s0 ∈ Set.Ioo sLeft sRight)
    (hconcreteSampleDerivMeas :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.AEStronglyMeasurable
          (fun ω => deriv (fun t : Real => testEval φ (hatX t ω)) s0) P)
    (hsampleDerivConcreteAeEqInterval :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          sampleDeriv φ s ω =
            deriv (fun t : Real => testEval φ (hatX t ω)) s)
    (hconcreteSampleDerivBound :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          ‖deriv (fun t : Real => testEval φ (hatX t ω)) s‖ ≤ bound φ ω)
    (hjointBoundInt :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.Integrable (jointBound φ)
          (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hboundAeEqJoint :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        bound φ =ᵐ[P] (fun ω => jointBound φ (hatX s0 ω, Xk ω)))
    (hpathDeriv :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          HasDerivAt (fun t => testEval φ (hatX t ω))
            (sampleDeriv φ s ω) s)
    (hderivValue :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        (∫ ω, sampleDeriv φ s0 ω ∂P) = driftAction φ + diffusionAction φ)
    (hdiffusionSource :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        diffusionAction φ = sigmaCoeff • laplacian φ) :
    let canonicalBarB : State → Vec :=
      fun x =>
        dotTk •
            (∫ y, guideIntegrand (x, y)
              ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x) +
          sigmaCoeff •
            (∫ y, scoreIntegrand (x, y)
              ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x)
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftAction φ =
        (fun f ψ => ∫ x, inner Real (testGrad ψ x) (f x) ∂(hatRhoS s0))
          canonicalBarB φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      MeasureTheory.AEStronglyMeasurable
        (fun x => inner Real (testGrad φ x) (canonicalBarB x)) (hatRhoS s0)) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      ∀ᵐ x ∂(hatRhoS s0), ‖testGrad φ x‖ ≤ pairBound φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftDiv φ =
        -(∫ x, inner Real (testGrad φ x) (canonicalBarB x) ∂(hatRhoS s0))) →
    ∀ φ, Admissible φ →
      HasDerivAt
        (fun s => ∫ x, testEval φ x ∂hatRhoS s)
        (-(driftDiv φ) + (sigmaEta ^ 2 / 2) • laplacian φ) s0 := by
  exact
    generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDerivMeasBoundDominated
      testEval testGrad Admissible commonSpace conditionalKernel driftRegular
      densityRegular testRegular boundaryBehavior driftAction diffusionAction
      driftDiv laplacian s0 sLeft sRight dotTk sigmaEta sigmaCoeff
      pairBound sampleDeriv bound hhatRhoS hhatXAtS hhatX hXk hguideMeas
      hguideInt hscoreMeas hscoreInt htestMeas htestInt hcommon hkernel
      hdrift hdensity htests hboundary hcoeff hs0Interval
      hconcreteSampleDerivMeas hsampleDerivConcreteAeEqInterval
      hconcreteSampleDerivBound
      (by
        intro φ hφ hcommon hkernel hdrift hdensity htests hboundary
        have hpair :
            AEMeasurable (fun ω => (hatX s0 ω, Xk ω)) P :=
          (hhatX s0).prodMk hXk
        have hjoint :
            MeasureTheory.Integrable
              ((jointBound φ) ∘ (fun ω => (hatX s0 ω, Xk ω))) P :=
          (hjointBoundInt φ hφ hcommon hkernel hdrift hdensity htests
            hboundary).comp_aemeasurable hpair
        simpa [Function.comp_def] using
          hjoint.congr
            (hboundAeEqJoint φ hφ hcommon hkernel hdrift hdensity htests
              hboundary).symm)
      hpathDeriv hderivValue hdiffusionSource

/-- Canonical `barB` dominated weak derivative on the source EM interval,
with the path derivative obtained from differentiability of the concrete EM
weak-test path.

This cycle-125 lower theorem removes the supplied `hpathDeriv` premise from
the cycle-124 bound-integrability packet.  The source-facing input is now
a.e. differentiability on the EM interval of
`fun t => testEval phi (hatX t omega)`.  Mathlib's
`DifferentiableAt.hasDerivAt` gives the concrete derivative representative
`deriv (fun t => testEval phi (hatX t omega)) s`; the existing interval a.e.
equality then transports it to the selected `sampleDeriv` representative.
Derivative-value splitting and source actions remain explicit.
-/
theorem generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDerivMeasBoundIntPathDominated
    {Ω State Vec Test : Type*} [MeasurableSpace Ω] [MeasurableSpace State]
    [NormedAddCommGroup Vec] [NormedSpace ℝ Vec] [CompleteSpace Vec]
    [InnerProductSpace Real Vec] [StandardBorelSpace State] [Nonempty State]
    {P : MeasureTheory.Measure Ω} [MeasureTheory.IsFiniteMeasure P]
    {hatX : Real → Ω → State}
    {hatRhoS : Real → MeasureTheory.Measure State}
    {Xk : Ω → State}
    {guideIntegrand scoreIntegrand : State × State → Vec}
    (testEval : Test → State → Real)
    (testGrad : Test → State → Vec)
    (Admissible : Test → Prop)
    (commonSpace conditionalKernel driftRegular densityRegular testRegular
      boundaryBehavior : Prop)
    (driftAction diffusionAction driftDiv laplacian : Test → Real)
    (s0 sLeft sRight dotTk sigmaEta sigmaCoeff : Real)
    (pairBound : Test → Real)
    (sampleDeriv : Test → Real → Ω → Real)
    (bound : Test → Ω → Real)
    (jointBound : Test → State × State → Real)
    (hhatRhoS : ∀ s, hatRhoS s = MeasureTheory.Measure.map (hatX s) P)
    (hhatXAtS : Measurable (hatX s0))
    (hhatX : ∀ s, AEMeasurable (hatX s) P)
    (hXk : AEMeasurable Xk P)
    (hguideMeas :
      MeasureTheory.AEStronglyMeasurable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hguideInt :
      MeasureTheory.Integrable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreMeas :
      MeasureTheory.AEStronglyMeasurable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreInt :
      MeasureTheory.Integrable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (htestMeas :
      ∀ φ s, Admissible φ →
        MeasureTheory.AEStronglyMeasurable (testEval φ) (hatRhoS s))
    (htestInt :
      ∀ φ s, Admissible φ →
        MeasureTheory.Integrable (testEval φ) (hatRhoS s))
    (hcommon : commonSpace)
    (hkernel : conditionalKernel)
    (hdrift : driftRegular)
    (hdensity : densityRegular)
    (htests : testRegular)
    (hboundary : boundaryBehavior)
    (hcoeff : sigmaCoeff = sigmaEta ^ 2 / 2)
    (hs0Interval : s0 ∈ Set.Ioo sLeft sRight)
    (hconcreteSampleDerivMeas :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.AEStronglyMeasurable
          (fun ω => deriv (fun t : Real => testEval φ (hatX t ω)) s0) P)
    (hsampleDerivConcreteAeEqInterval :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          sampleDeriv φ s ω =
            deriv (fun t : Real => testEval φ (hatX t ω)) s)
    (hconcreteSampleDerivBound :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          ‖deriv (fun t : Real => testEval φ (hatX t ω)) s‖ ≤ bound φ ω)
    (hjointBoundInt :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.Integrable (jointBound φ)
          (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hboundAeEqJoint :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        bound φ =ᵐ[P] (fun ω => jointBound φ (hatX s0 ω, Xk ω)))
    (hconcretePathDifferentiable :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          DifferentiableAt Real
            (fun t : Real => testEval φ (hatX t ω)) s)
    (hderivValue :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        (∫ ω, sampleDeriv φ s0 ω ∂P) = driftAction φ + diffusionAction φ)
    (hdiffusionSource :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        diffusionAction φ = sigmaCoeff • laplacian φ) :
    let canonicalBarB : State → Vec :=
      fun x =>
        dotTk •
            (∫ y, guideIntegrand (x, y)
              ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x) +
          sigmaCoeff •
            (∫ y, scoreIntegrand (x, y)
              ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x)
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftAction φ =
        (fun f ψ => ∫ x, inner Real (testGrad ψ x) (f x) ∂(hatRhoS s0))
          canonicalBarB φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      MeasureTheory.AEStronglyMeasurable
        (fun x => inner Real (testGrad φ x) (canonicalBarB x)) (hatRhoS s0)) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      ∀ᵐ x ∂(hatRhoS s0), ‖testGrad φ x‖ ≤ pairBound φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftDiv φ =
        -(∫ x, inner Real (testGrad φ x) (canonicalBarB x) ∂(hatRhoS s0))) →
    ∀ φ, Admissible φ →
      HasDerivAt
        (fun s => ∫ x, testEval φ x ∂hatRhoS s)
        (-(driftDiv φ) + (sigmaEta ^ 2 / 2) • laplacian φ) s0 := by
  exact
    generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDerivMeasBoundIntDominated
      testEval testGrad Admissible commonSpace conditionalKernel driftRegular
      densityRegular testRegular boundaryBehavior driftAction diffusionAction
      driftDiv laplacian s0 sLeft sRight dotTk sigmaEta sigmaCoeff
      pairBound sampleDeriv bound jointBound hhatRhoS hhatXAtS hhatX hXk
      hguideMeas hguideInt hscoreMeas hscoreInt htestMeas htestInt hcommon
      hkernel hdrift hdensity htests hboundary hcoeff hs0Interval
      hconcreteSampleDerivMeas hsampleDerivConcreteAeEqInterval
      hconcreteSampleDerivBound hjointBoundInt hboundAeEqJoint
      (by
        intro φ hφ hcommon hkernel hdrift hdensity htests hboundary
        filter_upwards
          [hconcretePathDifferentiable φ hφ hcommon hkernel hdrift
              hdensity htests hboundary,
            hsampleDerivConcreteAeEqInterval φ hφ hcommon hkernel hdrift
              hdensity htests hboundary] with ω hdiff heq s hs
        simpa [heq s hs] using (hdiff s hs).hasDerivAt)
      hderivValue hdiffusionSource

/-- Canonical `barB` dominated weak derivative on the source EM interval,
with the derivative-value identity transported from the concrete EM derivative.

This cycle-126 lower theorem removes the supplied `hderivValue` premise from
the cycle-125 path-derivative packet.  The source-facing input is the smaller
concrete integral split for
`deriv (fun t => testEval phi (hatX t omega)) s0`.  The existing interval
a.e. equality between that concrete representative and `sampleDeriv` is
specialized at `s0` and transported through `MeasureTheory.integral_congr_ae`.
The canonical `barB` weak action, no-boundary divergence, and diffusion source
action remain explicit.
-/
theorem generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDerivMeasBoundIntPathValueDominated
    {Ω State Vec Test : Type*} [MeasurableSpace Ω] [MeasurableSpace State]
    [NormedAddCommGroup Vec] [NormedSpace ℝ Vec] [CompleteSpace Vec]
    [InnerProductSpace Real Vec] [StandardBorelSpace State] [Nonempty State]
    {P : MeasureTheory.Measure Ω} [MeasureTheory.IsFiniteMeasure P]
    {hatX : Real → Ω → State}
    {hatRhoS : Real → MeasureTheory.Measure State}
    {Xk : Ω → State}
    {guideIntegrand scoreIntegrand : State × State → Vec}
    (testEval : Test → State → Real)
    (testGrad : Test → State → Vec)
    (Admissible : Test → Prop)
    (commonSpace conditionalKernel driftRegular densityRegular testRegular
      boundaryBehavior : Prop)
    (driftAction diffusionAction driftDiv laplacian : Test → Real)
    (s0 sLeft sRight dotTk sigmaEta sigmaCoeff : Real)
    (pairBound : Test → Real)
    (sampleDeriv : Test → Real → Ω → Real)
    (bound : Test → Ω → Real)
    (jointBound : Test → State × State → Real)
    (hhatRhoS : ∀ s, hatRhoS s = MeasureTheory.Measure.map (hatX s) P)
    (hhatXAtS : Measurable (hatX s0))
    (hhatX : ∀ s, AEMeasurable (hatX s) P)
    (hXk : AEMeasurable Xk P)
    (hguideMeas :
      MeasureTheory.AEStronglyMeasurable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hguideInt :
      MeasureTheory.Integrable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreMeas :
      MeasureTheory.AEStronglyMeasurable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreInt :
      MeasureTheory.Integrable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (htestMeas :
      ∀ φ s, Admissible φ →
        MeasureTheory.AEStronglyMeasurable (testEval φ) (hatRhoS s))
    (htestInt :
      ∀ φ s, Admissible φ →
        MeasureTheory.Integrable (testEval φ) (hatRhoS s))
    (hcommon : commonSpace)
    (hkernel : conditionalKernel)
    (hdrift : driftRegular)
    (hdensity : densityRegular)
    (htests : testRegular)
    (hboundary : boundaryBehavior)
    (hcoeff : sigmaCoeff = sigmaEta ^ 2 / 2)
    (hs0Interval : s0 ∈ Set.Ioo sLeft sRight)
    (hconcreteSampleDerivMeas :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.AEStronglyMeasurable
          (fun ω => deriv (fun t : Real => testEval φ (hatX t ω)) s0) P)
    (hsampleDerivConcreteAeEqInterval :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          sampleDeriv φ s ω =
            deriv (fun t : Real => testEval φ (hatX t ω)) s)
    (hconcreteSampleDerivBound :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          ‖deriv (fun t : Real => testEval φ (hatX t ω)) s‖ ≤ bound φ ω)
    (hjointBoundInt :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.Integrable (jointBound φ)
          (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hboundAeEqJoint :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        bound φ =ᵐ[P] (fun ω => jointBound φ (hatX s0 ω, Xk ω)))
    (hconcretePathDifferentiable :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          DifferentiableAt Real
            (fun t : Real => testEval φ (hatX t ω)) s)
    (hconcreteDerivativeIntegralSplit :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        (∫ ω, deriv (fun t : Real => testEval φ (hatX t ω)) s0 ∂P) =
          driftAction φ + diffusionAction φ)
    (hdiffusionSource :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        diffusionAction φ = sigmaCoeff • laplacian φ) :
    let canonicalBarB : State → Vec :=
      fun x =>
        dotTk •
            (∫ y, guideIntegrand (x, y)
              ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x) +
          sigmaCoeff •
            (∫ y, scoreIntegrand (x, y)
              ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x)
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftAction φ =
        (fun f ψ => ∫ x, inner Real (testGrad ψ x) (f x) ∂(hatRhoS s0))
          canonicalBarB φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      MeasureTheory.AEStronglyMeasurable
        (fun x => inner Real (testGrad φ x) (canonicalBarB x)) (hatRhoS s0)) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      ∀ᵐ x ∂(hatRhoS s0), ‖testGrad φ x‖ ≤ pairBound φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftDiv φ =
        -(∫ x, inner Real (testGrad φ x) (canonicalBarB x) ∂(hatRhoS s0))) →
    ∀ φ, Admissible φ →
      HasDerivAt
        (fun s => ∫ x, testEval φ x ∂hatRhoS s)
        (-(driftDiv φ) + (sigmaEta ^ 2 / 2) • laplacian φ) s0 := by
  exact
    generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDerivMeasBoundIntPathDominated
      testEval testGrad Admissible commonSpace conditionalKernel driftRegular
      densityRegular testRegular boundaryBehavior driftAction diffusionAction
      driftDiv laplacian s0 sLeft sRight dotTk sigmaEta sigmaCoeff
      pairBound sampleDeriv bound jointBound hhatRhoS hhatXAtS hhatX hXk
      hguideMeas hguideInt hscoreMeas hscoreInt htestMeas htestInt hcommon
      hkernel hdrift hdensity htests hboundary hcoeff hs0Interval
      hconcreteSampleDerivMeas hsampleDerivConcreteAeEqInterval
      hconcreteSampleDerivBound hjointBoundInt hboundAeEqJoint
      hconcretePathDifferentiable
      (by
        intro φ hφ hcommon hkernel hdrift hdensity htests hboundary
        have hae :
            sampleDeriv φ s0 =ᵐ[P]
              (fun ω => deriv (fun t : Real => testEval φ (hatX t ω)) s0) := by
          filter_upwards
            [hsampleDerivConcreteAeEqInterval φ hφ hcommon hkernel hdrift
              hdensity htests hboundary] with ω hω
          exact hω s0 hs0Interval
        calc
          (∫ ω, sampleDeriv φ s0 ω ∂P) =
              ∫ ω, deriv (fun t : Real => testEval φ (hatX t ω)) s0 ∂P := by
            exact MeasureTheory.integral_congr_ae hae
          _ = driftAction φ + diffusionAction φ :=
            hconcreteDerivativeIntegralSplit φ hφ hcommon hkernel hdrift
              hdensity htests hboundary)
      hdiffusionSource

/-- Canonical `barB` dominated weak derivative on the source EM interval,
with the drift weak-action identity derived from guide/score component
pairings.

This cycle-127 dynamic-leaf theorem removes the first post-`canonicalBarB`
continuation from the cycle-126 packet.  Instead of taking the supplied
`hdriftBarBAction` identity directly, it derives the canonical drift action
from the paper's guide and score component actions and the concrete Bochner
integral linearity of the weak test-gradient pairing.  Pairing measurability,
the gradient bound, no-boundary divergence, and diffusion source action remain
explicit.
-/
theorem generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDerivMeasBoundIntPathValueDriftActionDominated
    {Ω State Vec Test : Type*} [MeasurableSpace Ω] [MeasurableSpace State]
    [NormedAddCommGroup Vec] [NormedSpace ℝ Vec] [CompleteSpace Vec]
    [InnerProductSpace Real Vec] [StandardBorelSpace State] [Nonempty State]
    {P : MeasureTheory.Measure Ω} [MeasureTheory.IsFiniteMeasure P]
    {hatX : Real → Ω → State}
    {hatRhoS : Real → MeasureTheory.Measure State}
    {Xk : Ω → State}
    {guideIntegrand scoreIntegrand : State × State → Vec}
    (testEval : Test → State → Real)
    (testGrad : Test → State → Vec)
    (Admissible : Test → Prop)
    (commonSpace conditionalKernel driftRegular densityRegular testRegular
      boundaryBehavior : Prop)
    (driftAction diffusionAction driftDiv laplacian : Test → Real)
    (guideAction scoreAction : Test → Real)
    (s0 sLeft sRight dotTk sigmaEta sigmaCoeff : Real)
    (pairBound : Test → Real)
    (sampleDeriv : Test → Real → Ω → Real)
    (bound : Test → Ω → Real)
    (jointBound : Test → State × State → Real)
    (hhatRhoS : ∀ s, hatRhoS s = MeasureTheory.Measure.map (hatX s) P)
    (hhatXAtS : Measurable (hatX s0))
    (hhatX : ∀ s, AEMeasurable (hatX s) P)
    (hXk : AEMeasurable Xk P)
    (hguideMeas :
      MeasureTheory.AEStronglyMeasurable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hguideInt :
      MeasureTheory.Integrable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreMeas :
      MeasureTheory.AEStronglyMeasurable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreInt :
      MeasureTheory.Integrable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (htestMeas :
      ∀ φ s, Admissible φ →
        MeasureTheory.AEStronglyMeasurable (testEval φ) (hatRhoS s))
    (htestInt :
      ∀ φ s, Admissible φ →
        MeasureTheory.Integrable (testEval φ) (hatRhoS s))
    (hcommon : commonSpace)
    (hkernel : conditionalKernel)
    (hdrift : driftRegular)
    (hdensity : densityRegular)
    (htests : testRegular)
    (hboundary : boundaryBehavior)
    (hcoeff : sigmaCoeff = sigmaEta ^ 2 / 2)
    (hs0Interval : s0 ∈ Set.Ioo sLeft sRight)
    (hconcreteSampleDerivMeas :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.AEStronglyMeasurable
          (fun ω => deriv (fun t : Real => testEval φ (hatX t ω)) s0) P)
    (hsampleDerivConcreteAeEqInterval :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          sampleDeriv φ s ω =
            deriv (fun t : Real => testEval φ (hatX t ω)) s)
    (hconcreteSampleDerivBound :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          ‖deriv (fun t : Real => testEval φ (hatX t ω)) s‖ ≤ bound φ ω)
    (hjointBoundInt :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.Integrable (jointBound φ)
          (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hboundAeEqJoint :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        bound φ =ᵐ[P] (fun ω => jointBound φ (hatX s0 ω, Xk ω)))
    (hconcretePathDifferentiable :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          DifferentiableAt Real
            (fun t : Real => testEval φ (hatX t ω)) s)
    (hconcreteDerivativeIntegralSplit :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        (∫ ω, deriv (fun t : Real => testEval φ (hatX t ω)) s0 ∂P) =
          driftAction φ + diffusionAction φ)
    (hdiffusionSource :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        diffusionAction φ = sigmaCoeff • laplacian φ) :
    let canonicalGuide : State → Vec :=
      fun x =>
        ∫ y, guideIntegrand (x, y)
          ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x
    let canonicalScore : State → Vec :=
      fun x =>
        ∫ y, scoreIntegrand (x, y)
          ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x
    let canonicalBarB : State → Vec :=
      fun x => dotTk • canonicalGuide x + sigmaCoeff • canonicalScore x
    let weakGradPairing : (State → Vec) → Test → Real :=
      fun f ψ => ∫ x, inner Real (testGrad ψ x) (f x) ∂(hatRhoS s0)
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftAction φ = dotTk • guideAction φ + sigmaCoeff • scoreAction φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      guideAction φ = weakGradPairing canonicalGuide φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      scoreAction φ = weakGradPairing canonicalScore φ) →
    (∀ {f g : State → Vec}, (∀ x, f x = g x) →
      ∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      weakGradPairing f φ = weakGradPairing g φ) →
    (∀ (f g : State → Vec) (φ : Test), Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      weakGradPairing (fun x => f x + g x) φ =
        weakGradPairing f φ + weakGradPairing g φ) →
    (∀ (a : Real) (f : State → Vec) (φ : Test), Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      weakGradPairing (fun x => a • f x) φ = a • weakGradPairing f φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      MeasureTheory.AEStronglyMeasurable
        (fun x => inner Real (testGrad φ x) (canonicalBarB x)) (hatRhoS s0)) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      ∀ᵐ x ∂(hatRhoS s0), ‖testGrad φ x‖ ≤ pairBound φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftDiv φ =
        -(∫ x, inner Real (testGrad φ x) (canonicalBarB x) ∂(hatRhoS s0))) →
    ∀ φ, Admissible φ →
      HasDerivAt
        (fun s => ∫ x, testEval φ x ∂hatRhoS s)
        (-(driftDiv φ) + (sigmaEta ^ 2 / 2) • laplacian φ) s0 := by
  dsimp only
  intro hdriftActionComponents hguideActionPairing hscoreActionPairing
    hweakCongr hweakAdd hweakSmul hpairMeas hgradNormBound hdivNoBoundary
  let canonicalGuide : State → Vec :=
    fun x =>
      ∫ y, guideIntegrand (x, y)
        ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x
  let canonicalScore : State → Vec :=
    fun x =>
      ∫ y, scoreIntegrand (x, y)
        ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x
  let canonicalBarB : State → Vec :=
    fun x => dotTk • canonicalGuide x + sigmaCoeff • canonicalScore x
  let weakGradPairing : (State → Vec) → Test → Real :=
    fun f ψ => ∫ x, inner Real (testGrad ψ x) (f x) ∂(hatRhoS s0)
  have hdriftComponents :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        driftAction φ =
          dotTk • weakGradPairing canonicalGuide φ +
            sigmaCoeff • weakGradPairing canonicalScore φ := by
    intro φ hφ hcommon hkernel hdrift hdensity htests hboundary
    calc
      driftAction φ = dotTk • guideAction φ + sigmaCoeff • scoreAction φ := by
        exact
          hdriftActionComponents φ hφ hcommon hkernel hdrift hdensity htests
            hboundary
      _ =
          dotTk • weakGradPairing canonicalGuide φ +
            sigmaCoeff • weakGradPairing canonicalScore φ := by
        rw [
          hguideActionPairing φ hφ hcommon hkernel hdrift hdensity htests
            hboundary,
          hscoreActionPairing φ hφ hcommon hkernel hdrift hdensity htests
            hboundary
        ]
  have hdriftBarBAction :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        driftAction φ = weakGradPairing canonicalBarB φ := by
    intro φ hφ hcommon hkernel hdrift hdensity htests hboundary
    have hcombo :
        weakGradPairing canonicalBarB φ =
          dotTk • weakGradPairing canonicalGuide φ +
            sigmaCoeff • weakGradPairing canonicalScore φ := by
      calc
        weakGradPairing canonicalBarB φ =
            weakGradPairing
              (fun x => dotTk • canonicalGuide x + sigmaCoeff • canonicalScore x)
              φ := by
          exact
            hweakCongr (by intro x; simp [canonicalBarB]) φ hφ hcommon
              hkernel hdrift hdensity htests hboundary
        _ =
            weakGradPairing (fun x => dotTk • canonicalGuide x) φ +
              weakGradPairing (fun x => sigmaCoeff • canonicalScore x) φ := by
          exact
            hweakAdd (fun x => dotTk • canonicalGuide x)
              (fun x => sigmaCoeff • canonicalScore x) φ hφ hcommon hkernel
              hdrift hdensity htests hboundary
        _ =
            dotTk • weakGradPairing canonicalGuide φ +
              sigmaCoeff • weakGradPairing canonicalScore φ := by
          have hguideSmul :
              weakGradPairing (fun x => dotTk • canonicalGuide x) φ =
                dotTk • weakGradPairing canonicalGuide φ := by
            simpa [weakGradPairing] using
              hweakSmul dotTk canonicalGuide φ hφ hcommon hkernel hdrift
                hdensity htests hboundary
          have hscoreSmul :
              weakGradPairing (fun x => sigmaCoeff • canonicalScore x) φ =
                sigmaCoeff • weakGradPairing canonicalScore φ := by
            simpa [weakGradPairing] using
              hweakSmul sigmaCoeff canonicalScore φ hφ hcommon hkernel hdrift
                hdensity htests hboundary
          rw [
            hguideSmul,
            hscoreSmul
          ]
    calc
      driftAction φ =
          dotTk • weakGradPairing canonicalGuide φ +
            sigmaCoeff • weakGradPairing canonicalScore φ := by
        exact
          hdriftComponents φ hφ hcommon hkernel hdrift hdensity htests
            hboundary
      _ = weakGradPairing canonicalBarB φ := hcombo.symm
  exact
    generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDerivMeasBoundIntPathValueDominated
      testEval testGrad Admissible commonSpace conditionalKernel driftRegular
      densityRegular testRegular boundaryBehavior driftAction diffusionAction
      driftDiv laplacian s0 sLeft sRight dotTk sigmaEta sigmaCoeff
      pairBound sampleDeriv bound jointBound hhatRhoS hhatXAtS hhatX hXk
      hguideMeas hguideInt hscoreMeas hscoreInt htestMeas htestInt hcommon
      hkernel hdrift hdensity htests hboundary hcoeff hs0Interval
      hconcreteSampleDerivMeas hsampleDerivConcreteAeEqInterval
      hconcreteSampleDerivBound hjointBoundInt hboundAeEqJoint
      hconcretePathDifferentiable hconcreteDerivativeIntegralSplit
      hdiffusionSource
      (by simpa [weakGradPairing, canonicalBarB] using hdriftBarBAction)
      (by simpa [canonicalBarB] using hpairMeas)
      hgradNormBound
      (by simpa [canonicalBarB] using hdivNoBoundary)

/-- Canonical `barB` dominated weak derivative on the source EM interval,
with the drift weak-action identity and pairing measurability derived from
separate field measurability facts.

This lower refinement removes the raw `hpairMeas` continuation from the
cycle-127 drift-action packet.  The replacement inputs are the source-facing
measurability of the admissible weak-test gradient and of the canonical
conditional drift field.  Mathlib's `AEStronglyMeasurable.inner` supplies the
measurability of their real inner-product contraction; the gradient bound,
no-boundary divergence, and diffusion source action remain explicit.
-/
theorem generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDerivMeasBoundIntPathValueDriftActionPairMeasDominated
    {Ω State Vec Test : Type*} [MeasurableSpace Ω] [MeasurableSpace State]
    [NormedAddCommGroup Vec] [NormedSpace ℝ Vec] [CompleteSpace Vec]
    [InnerProductSpace Real Vec] [StandardBorelSpace State] [Nonempty State]
    {P : MeasureTheory.Measure Ω} [MeasureTheory.IsFiniteMeasure P]
    {hatX : Real → Ω → State}
    {hatRhoS : Real → MeasureTheory.Measure State}
    {Xk : Ω → State}
    {guideIntegrand scoreIntegrand : State × State → Vec}
    (testEval : Test → State → Real)
    (testGrad : Test → State → Vec)
    (Admissible : Test → Prop)
    (commonSpace conditionalKernel driftRegular densityRegular testRegular
      boundaryBehavior : Prop)
    (driftAction diffusionAction driftDiv laplacian : Test → Real)
    (guideAction scoreAction : Test → Real)
    (s0 sLeft sRight dotTk sigmaEta sigmaCoeff : Real)
    (pairBound : Test → Real)
    (sampleDeriv : Test → Real → Ω → Real)
    (bound : Test → Ω → Real)
    (jointBound : Test → State × State → Real)
    (hhatRhoS : ∀ s, hatRhoS s = MeasureTheory.Measure.map (hatX s) P)
    (hhatXAtS : Measurable (hatX s0))
    (hhatX : ∀ s, AEMeasurable (hatX s) P)
    (hXk : AEMeasurable Xk P)
    (hguideMeas :
      MeasureTheory.AEStronglyMeasurable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hguideInt :
      MeasureTheory.Integrable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreMeas :
      MeasureTheory.AEStronglyMeasurable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreInt :
      MeasureTheory.Integrable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (htestMeas :
      ∀ φ s, Admissible φ →
        MeasureTheory.AEStronglyMeasurable (testEval φ) (hatRhoS s))
    (htestInt :
      ∀ φ s, Admissible φ →
        MeasureTheory.Integrable (testEval φ) (hatRhoS s))
    (hcommon : commonSpace)
    (hkernel : conditionalKernel)
    (hdrift : driftRegular)
    (hdensity : densityRegular)
    (htests : testRegular)
    (hboundary : boundaryBehavior)
    (hcoeff : sigmaCoeff = sigmaEta ^ 2 / 2)
    (hs0Interval : s0 ∈ Set.Ioo sLeft sRight)
    (hconcreteSampleDerivMeas :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.AEStronglyMeasurable
          (fun ω => deriv (fun t : Real => testEval φ (hatX t ω)) s0) P)
    (hsampleDerivConcreteAeEqInterval :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          sampleDeriv φ s ω =
            deriv (fun t : Real => testEval φ (hatX t ω)) s)
    (hconcreteSampleDerivBound :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          ‖deriv (fun t : Real => testEval φ (hatX t ω)) s‖ ≤ bound φ ω)
    (hjointBoundInt :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.Integrable (jointBound φ)
          (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hboundAeEqJoint :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        bound φ =ᵐ[P] (fun ω => jointBound φ (hatX s0 ω, Xk ω)))
    (hconcretePathDifferentiable :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          DifferentiableAt Real
            (fun t : Real => testEval φ (hatX t ω)) s)
    (hconcreteDerivativeIntegralSplit :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        (∫ ω, deriv (fun t : Real => testEval φ (hatX t ω)) s0 ∂P) =
          driftAction φ + diffusionAction φ)
    (hdiffusionSource :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        diffusionAction φ = sigmaCoeff • laplacian φ) :
    let canonicalGuide : State → Vec :=
      fun x =>
        ∫ y, guideIntegrand (x, y)
          ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x
    let canonicalScore : State → Vec :=
      fun x =>
        ∫ y, scoreIntegrand (x, y)
          ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x
    let canonicalBarB : State → Vec :=
      fun x => dotTk • canonicalGuide x + sigmaCoeff • canonicalScore x
    let weakGradPairing : (State → Vec) → Test → Real :=
      fun f ψ => ∫ x, inner Real (testGrad ψ x) (f x) ∂(hatRhoS s0)
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftAction φ = dotTk • guideAction φ + sigmaCoeff • scoreAction φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      guideAction φ = weakGradPairing canonicalGuide φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      scoreAction φ = weakGradPairing canonicalScore φ) →
    (∀ {f g : State → Vec}, (∀ x, f x = g x) →
      ∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      weakGradPairing f φ = weakGradPairing g φ) →
    (∀ (f g : State → Vec) (φ : Test), Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      weakGradPairing (fun x => f x + g x) φ =
        weakGradPairing f φ + weakGradPairing g φ) →
    (∀ (a : Real) (f : State → Vec) (φ : Test), Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      weakGradPairing (fun x => a • f x) φ = a • weakGradPairing f φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      MeasureTheory.AEStronglyMeasurable (testGrad φ) (hatRhoS s0)) →
    (commonSpace → conditionalKernel → driftRegular → densityRegular →
      testRegular → boundaryBehavior →
      MeasureTheory.AEStronglyMeasurable canonicalBarB (hatRhoS s0)) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      ∀ᵐ x ∂(hatRhoS s0), ‖testGrad φ x‖ ≤ pairBound φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftDiv φ =
        -(∫ x, inner Real (testGrad φ x) (canonicalBarB x) ∂(hatRhoS s0))) →
    ∀ φ, Admissible φ →
      HasDerivAt
        (fun s => ∫ x, testEval φ x ∂hatRhoS s)
        (-(driftDiv φ) + (sigmaEta ^ 2 / 2) • laplacian φ) s0 := by
  dsimp only
  intro hdriftActionComponents hguideActionPairing hscoreActionPairing
    hweakCongr hweakAdd hweakSmul htestGradMeas hcanonicalBarBMeas
    hgradNormBound hdivNoBoundary
  let canonicalGuide : State → Vec :=
    fun x =>
      ∫ y, guideIntegrand (x, y)
        ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x
  let canonicalScore : State → Vec :=
    fun x =>
      ∫ y, scoreIntegrand (x, y)
        ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x
  let canonicalBarB : State → Vec :=
    fun x => dotTk • canonicalGuide x + sigmaCoeff • canonicalScore x
  have hpairMeas :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.AEStronglyMeasurable
          (fun x => inner Real (testGrad φ x) (canonicalBarB x))
          (hatRhoS s0) := by
    intro φ hφ hcommon hkernel hdrift hdensity htests hboundary
    have hbarBMeas :
        MeasureTheory.AEStronglyMeasurable canonicalBarB (hatRhoS s0) := by
      simpa [canonicalGuide, canonicalScore, canonicalBarB] using
        hcanonicalBarBMeas hcommon hkernel hdrift hdensity htests hboundary
    exact
      (htestGradMeas φ hφ hcommon hkernel hdrift hdensity htests hboundary).inner
        hbarBMeas
  exact
    generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDerivMeasBoundIntPathValueDriftActionDominated
      testEval testGrad Admissible commonSpace conditionalKernel driftRegular
      densityRegular testRegular boundaryBehavior driftAction diffusionAction
      driftDiv laplacian guideAction scoreAction s0 sLeft sRight dotTk
      sigmaEta sigmaCoeff pairBound sampleDeriv bound jointBound hhatRhoS
      hhatXAtS hhatX hXk hguideMeas hguideInt hscoreMeas hscoreInt
      htestMeas htestInt hcommon hkernel hdrift hdensity htests hboundary
      hcoeff hs0Interval hconcreteSampleDerivMeas
      hsampleDerivConcreteAeEqInterval hconcreteSampleDerivBound
      hjointBoundInt hboundAeEqJoint hconcretePathDifferentiable
      hconcreteDerivativeIntegralSplit hdiffusionSource
      hdriftActionComponents hguideActionPairing hscoreActionPairing
      hweakCongr hweakAdd hweakSmul
      (by simpa [canonicalGuide, canonicalScore, canonicalBarB] using hpairMeas)
      hgradNormBound
      (by simpa [canonicalGuide, canonicalScore, canonicalBarB] using
        hdivNoBoundary)

/-- Canonical `barB` dominated weak derivative with no-boundary narrowed to
trace/product-rule facts.

This cycle-128 refinement removes the direct `hdivNoBoundary` continuation
from the post-cycle-127 pair-measurability theorem.  The replacement inputs
are the source-facing product rule for `hatRhoS s0 * canonicalBarB`, the
divergence-theorem boundary-flux identity, the boundary trace integral, and
zero admissible-test trace.  The separate weak-test-gradient/canonical-field
measurability inputs, `hgradNormBound`, and `hdiffusionSource` remain explicit.
-/
theorem generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDerivMeasBoundIntPathValueDriftActionPairMeasNoBoundaryTraceDominated
    {Ω State Vec Test Boundary : Type*} [MeasurableSpace Ω]
    [MeasurableSpace State] [MeasurableSpace Boundary]
    [NormedAddCommGroup Vec] [NormedSpace ℝ Vec] [CompleteSpace Vec]
    [InnerProductSpace Real Vec] [StandardBorelSpace State] [Nonempty State]
    {P : MeasureTheory.Measure Ω} [MeasureTheory.IsFiniteMeasure P]
    {hatX : Real → Ω → State}
    {hatRhoS : Real → MeasureTheory.Measure State}
    {Xk : Ω → State}
    {guideIntegrand scoreIntegrand : State × State → Vec}
    (testEval : Test → State → Real)
    (testGrad : Test → State → Vec)
    (boundaryMeasure : MeasureTheory.Measure Boundary)
    (testTrace : Test → Boundary → Real)
    (normalFluxTrace : Boundary → Real)
    (Admissible : Test → Prop)
    (commonSpace conditionalKernel driftRegular densityRegular testRegular
      boundaryBehavior : Prop)
    (driftAction diffusionAction driftDiv laplacian : Test → Real)
    (guideAction scoreAction : Test → Real)
    (divTotal boundaryFlux : Test → Real)
    (s0 sLeft sRight dotTk sigmaEta sigmaCoeff : Real)
    (pairBound : Test → Real)
    (sampleDeriv : Test → Real → Ω → Real)
    (bound : Test → Ω → Real)
    (jointBound : Test → State × State → Real)
    (hhatRhoS : ∀ s, hatRhoS s = MeasureTheory.Measure.map (hatX s) P)
    (hhatXAtS : Measurable (hatX s0))
    (hhatX : ∀ s, AEMeasurable (hatX s) P)
    (hXk : AEMeasurable Xk P)
    (hguideMeas :
      MeasureTheory.AEStronglyMeasurable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hguideInt :
      MeasureTheory.Integrable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreMeas :
      MeasureTheory.AEStronglyMeasurable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreInt :
      MeasureTheory.Integrable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (htestMeas :
      ∀ φ s, Admissible φ →
        MeasureTheory.AEStronglyMeasurable (testEval φ) (hatRhoS s))
    (htestInt :
      ∀ φ s, Admissible φ →
        MeasureTheory.Integrable (testEval φ) (hatRhoS s))
    (hcommon : commonSpace)
    (hkernel : conditionalKernel)
    (hdrift : driftRegular)
    (hdensity : densityRegular)
    (htests : testRegular)
    (hboundary : boundaryBehavior)
    (hcoeff : sigmaCoeff = sigmaEta ^ 2 / 2)
    (hs0Interval : s0 ∈ Set.Ioo sLeft sRight)
    (hconcreteSampleDerivMeas :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.AEStronglyMeasurable
          (fun ω => deriv (fun t : Real => testEval φ (hatX t ω)) s0) P)
    (hsampleDerivConcreteAeEqInterval :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          sampleDeriv φ s ω =
            deriv (fun t : Real => testEval φ (hatX t ω)) s)
    (hconcreteSampleDerivBound :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          ‖deriv (fun t : Real => testEval φ (hatX t ω)) s‖ ≤ bound φ ω)
    (hjointBoundInt :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.Integrable (jointBound φ)
          (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hboundAeEqJoint :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        bound φ =ᵐ[P] (fun ω => jointBound φ (hatX s0 ω, Xk ω)))
    (hconcretePathDifferentiable :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          DifferentiableAt Real
            (fun t : Real => testEval φ (hatX t ω)) s)
    (hconcreteDerivativeIntegralSplit :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        (∫ ω, deriv (fun t : Real => testEval φ (hatX t ω)) s0 ∂P) =
          driftAction φ + diffusionAction φ)
    (hdiffusionSource :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        diffusionAction φ = sigmaCoeff • laplacian φ) :
    let canonicalGuide : State → Vec :=
      fun x =>
        ∫ y, guideIntegrand (x, y)
          ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x
    let canonicalScore : State → Vec :=
      fun x =>
        ∫ y, scoreIntegrand (x, y)
          ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x
    let canonicalBarB : State → Vec :=
      fun x => dotTk • canonicalGuide x + sigmaCoeff • canonicalScore x
    let weakGradPairing : (State → Vec) → Test → Real :=
      fun f ψ => ∫ x, inner Real (testGrad ψ x) (f x) ∂(hatRhoS s0)
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftAction φ = dotTk • guideAction φ + sigmaCoeff • scoreAction φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      guideAction φ = weakGradPairing canonicalGuide φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      scoreAction φ = weakGradPairing canonicalScore φ) →
    (∀ {f g : State → Vec}, (∀ x, f x = g x) →
      ∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      weakGradPairing f φ = weakGradPairing g φ) →
    (∀ (f g : State → Vec) (φ : Test), Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      weakGradPairing (fun x => f x + g x) φ =
        weakGradPairing f φ + weakGradPairing g φ) →
    (∀ (a : Real) (f : State → Vec) (φ : Test), Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      weakGradPairing (fun x => a • f x) φ = a • weakGradPairing f φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      MeasureTheory.AEStronglyMeasurable (testGrad φ) (hatRhoS s0)) →
    (commonSpace → conditionalKernel → driftRegular → densityRegular →
      testRegular → boundaryBehavior →
      MeasureTheory.AEStronglyMeasurable canonicalBarB (hatRhoS s0)) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      ∀ᵐ x ∂(hatRhoS s0), ‖testGrad φ x‖ ≤ pairBound φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftDiv φ + (∫ x, inner Real (testGrad φ x) (canonicalBarB x)
        ∂(hatRhoS s0)) = divTotal φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      divTotal φ = boundaryFlux φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      boundaryFlux φ =
        ∫ y, testTrace φ y * normalFluxTrace y ∂boundaryMeasure) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      ∀ᵐ y ∂boundaryMeasure, testTrace φ y = 0) →
    ∀ φ, Admissible φ →
      HasDerivAt
        (fun s => ∫ x, testEval φ x ∂hatRhoS s)
        (-(driftDiv φ) + (sigmaEta ^ 2 / 2) • laplacian φ) s0 := by
  dsimp only
  intro hdriftActionComponents hguideActionPairing hscoreActionPairing
    hweakCongr hweakAdd hweakSmul htestGradMeas hcanonicalBarBMeas
    hgradNormBound hproductRule hdivergenceTheorem hboundaryFluxIntegral
    htestTraceZero
  let canonicalGuide : State → Vec :=
    fun x =>
      ∫ y, guideIntegrand (x, y)
        ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x
  let canonicalScore : State → Vec :=
    fun x =>
      ∫ y, scoreIntegrand (x, y)
        ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x
  let canonicalBarB : State → Vec :=
    fun x => dotTk • canonicalGuide x + sigmaCoeff • canonicalScore x
  have htraceProductZero :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ y ∂boundaryMeasure, testTrace φ y * normalFluxTrace y = 0 :=
    by
      intro φ hφ hcommon hkernel hdrift hdensity htests hboundary
      exact
        (htestTraceZero φ hφ hcommon hkernel hdrift hdensity htests
          hboundary).mono
          (by
            intro y hy
            simp [hy])
  have hzeroBoundary :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        boundaryFlux φ = 0 :=
    by
      intro φ hφ hcommon hkernel hdrift hdensity htests hboundary
      calc
        boundaryFlux φ =
            ∫ y, testTrace φ y * normalFluxTrace y ∂boundaryMeasure :=
          hboundaryFluxIntegral φ hφ hcommon hkernel hdrift hdensity htests
            hboundary
        _ = ∫ _y, (0 : Real) ∂boundaryMeasure :=
          MeasureTheory.integral_congr_ae
            (htraceProductZero φ hφ hcommon hkernel hdrift hdensity htests
              hboundary)
        _ = 0 := by simp
  have hdivNoBoundary :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        driftDiv φ =
          -(∫ x, inner Real (testGrad φ x) (canonicalBarB x)
            ∂(hatRhoS s0)) :=
    generalMovingTargetDiscreteDriftDivNoBoundaryOfProductRule
      driftDiv
      (fun φ => ∫ x, inner Real (testGrad φ x) (canonicalBarB x)
        ∂(hatRhoS s0))
      divTotal boundaryFlux Admissible commonSpace conditionalKernel
      driftRegular densityRegular testRegular boundaryBehavior hproductRule
      hdivergenceTheorem hzeroBoundary
  exact
    generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDerivMeasBoundIntPathValueDriftActionPairMeasDominated
      testEval testGrad Admissible commonSpace conditionalKernel driftRegular
      densityRegular testRegular boundaryBehavior driftAction diffusionAction
      driftDiv laplacian guideAction scoreAction s0 sLeft sRight dotTk
      sigmaEta sigmaCoeff pairBound sampleDeriv bound jointBound hhatRhoS
      hhatXAtS hhatX hXk hguideMeas hguideInt hscoreMeas hscoreInt
      htestMeas htestInt hcommon hkernel hdrift hdensity htests hboundary
      hcoeff hs0Interval hconcreteSampleDerivMeas
      hsampleDerivConcreteAeEqInterval hconcreteSampleDerivBound
      hjointBoundInt hboundAeEqJoint hconcretePathDifferentiable
      hconcreteDerivativeIntegralSplit hdiffusionSource
      hdriftActionComponents hguideActionPairing hscoreActionPairing
      hweakCongr hweakAdd hweakSmul htestGradMeas hcanonicalBarBMeas
      hgradNormBound
      (by simpa [canonicalGuide, canonicalScore, canonicalBarB] using
        hdivNoBoundary)

/-- Canonical `barB` dominated weak derivative with no-boundary narrowed and
canonical-field measurability derived from the condDistrib regularity theorem.

This follow-on removes the separate `hcanonicalBarBMeas` premise from the
cycle-128 no-boundary trace refiner.  The canonical guide-plus-score field is
measurable under `hatRhoS s0` by
`generalMovingTargetDiscreteCondDistribCanonicalDriftRegularity`; weak-test
gradient measurability, the gradient bound, and the diffusion source action
remain explicit.
-/
theorem generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDerivMeasBoundIntPathValueDriftActionPairMeasNoBoundaryTraceCanonicalMeasDominated
    {Ω State Vec Test Boundary : Type*} [MeasurableSpace Ω]
    [MeasurableSpace State] [MeasurableSpace Boundary]
    [NormedAddCommGroup Vec] [NormedSpace ℝ Vec] [CompleteSpace Vec]
    [InnerProductSpace Real Vec] [StandardBorelSpace State] [Nonempty State]
    {P : MeasureTheory.Measure Ω} [MeasureTheory.IsFiniteMeasure P]
    {hatX : Real → Ω → State}
    {hatRhoS : Real → MeasureTheory.Measure State}
    {Xk : Ω → State}
    {guideIntegrand scoreIntegrand : State × State → Vec}
    (testEval : Test → State → Real)
    (testGrad : Test → State → Vec)
    (boundaryMeasure : MeasureTheory.Measure Boundary)
    (testTrace : Test → Boundary → Real)
    (normalFluxTrace : Boundary → Real)
    (Admissible : Test → Prop)
    (commonSpace conditionalKernel driftRegular densityRegular testRegular
      boundaryBehavior : Prop)
    (driftAction diffusionAction driftDiv laplacian : Test → Real)
    (guideAction scoreAction : Test → Real)
    (divTotal boundaryFlux : Test → Real)
    (s0 sLeft sRight dotTk sigmaEta sigmaCoeff : Real)
    (pairBound : Test → Real)
    (sampleDeriv : Test → Real → Ω → Real)
    (bound : Test → Ω → Real)
    (jointBound : Test → State × State → Real)
    (hhatRhoS : ∀ s, hatRhoS s = MeasureTheory.Measure.map (hatX s) P)
    (hhatXAtS : Measurable (hatX s0))
    (hhatX : ∀ s, AEMeasurable (hatX s) P)
    (hXk : AEMeasurable Xk P)
    (hguideMeas :
      MeasureTheory.AEStronglyMeasurable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hguideInt :
      MeasureTheory.Integrable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreMeas :
      MeasureTheory.AEStronglyMeasurable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreInt :
      MeasureTheory.Integrable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (htestMeas :
      ∀ φ s, Admissible φ →
        MeasureTheory.AEStronglyMeasurable (testEval φ) (hatRhoS s))
    (htestInt :
      ∀ φ s, Admissible φ →
        MeasureTheory.Integrable (testEval φ) (hatRhoS s))
    (hcommon : commonSpace)
    (hkernel : conditionalKernel)
    (hdrift : driftRegular)
    (hdensity : densityRegular)
    (htests : testRegular)
    (hboundary : boundaryBehavior)
    (hcoeff : sigmaCoeff = sigmaEta ^ 2 / 2)
    (hs0Interval : s0 ∈ Set.Ioo sLeft sRight)
    (hconcreteSampleDerivMeas :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.AEStronglyMeasurable
          (fun ω => deriv (fun t : Real => testEval φ (hatX t ω)) s0) P)
    (hsampleDerivConcreteAeEqInterval :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          sampleDeriv φ s ω =
            deriv (fun t : Real => testEval φ (hatX t ω)) s)
    (hconcreteSampleDerivBound :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          ‖deriv (fun t : Real => testEval φ (hatX t ω)) s‖ ≤ bound φ ω)
    (hjointBoundInt :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.Integrable (jointBound φ)
          (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hboundAeEqJoint :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        bound φ =ᵐ[P] (fun ω => jointBound φ (hatX s0 ω, Xk ω)))
    (hconcretePathDifferentiable :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          DifferentiableAt Real
            (fun t : Real => testEval φ (hatX t ω)) s)
    (hconcreteDerivativeIntegralSplit :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        (∫ ω, deriv (fun t : Real => testEval φ (hatX t ω)) s0 ∂P) =
          driftAction φ + diffusionAction φ)
    (hdiffusionSource :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        diffusionAction φ = sigmaCoeff • laplacian φ) :
    let canonicalGuide : State → Vec :=
      fun x =>
        ∫ y, guideIntegrand (x, y)
          ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x
    let canonicalScore : State → Vec :=
      fun x =>
        ∫ y, scoreIntegrand (x, y)
          ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x
    let canonicalBarB : State → Vec :=
      fun x => dotTk • canonicalGuide x + sigmaCoeff • canonicalScore x
    let weakGradPairing : (State → Vec) → Test → Real :=
      fun f ψ => ∫ x, inner Real (testGrad ψ x) (f x) ∂(hatRhoS s0)
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftAction φ = dotTk • guideAction φ + sigmaCoeff • scoreAction φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      guideAction φ = weakGradPairing canonicalGuide φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      scoreAction φ = weakGradPairing canonicalScore φ) →
    (∀ {f g : State → Vec}, (∀ x, f x = g x) →
      ∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      weakGradPairing f φ = weakGradPairing g φ) →
    (∀ (f g : State → Vec) (φ : Test), Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      weakGradPairing (fun x => f x + g x) φ =
        weakGradPairing f φ + weakGradPairing g φ) →
    (∀ (a : Real) (f : State → Vec) (φ : Test), Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      weakGradPairing (fun x => a • f x) φ = a • weakGradPairing f φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      MeasureTheory.AEStronglyMeasurable (testGrad φ) (hatRhoS s0)) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      ∀ᵐ x ∂(hatRhoS s0), ‖testGrad φ x‖ ≤ pairBound φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftDiv φ + (∫ x, inner Real (testGrad φ x) (canonicalBarB x)
        ∂(hatRhoS s0)) = divTotal φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      divTotal φ = boundaryFlux φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      boundaryFlux φ =
        ∫ y, testTrace φ y * normalFluxTrace y ∂boundaryMeasure) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      ∀ᵐ y ∂boundaryMeasure, testTrace φ y = 0) →
    ∀ φ, Admissible φ →
      HasDerivAt
        (fun s => ∫ x, testEval φ x ∂hatRhoS s)
        (-(driftDiv φ) + (sigmaEta ^ 2 / 2) • laplacian φ) s0 := by
  dsimp only
  intro hdriftActionComponents hguideActionPairing hscoreActionPairing
    hweakCongr hweakAdd hweakSmul htestGradMeas hgradNormBound hproductRule
    hdivergenceTheorem hboundaryFluxIntegral htestTraceZero
  let canonicalGuide : State → Vec :=
    fun x =>
      ∫ y, guideIntegrand (x, y)
        ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x
  let canonicalScore : State → Vec :=
    fun x =>
      ∫ y, scoreIntegrand (x, y)
        ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x
  let canonicalBarB : State → Vec :=
    fun x => dotTk • canonicalGuide x + sigmaCoeff • canonicalScore x
  have hcanonicalBarBMeas :
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
        MeasureTheory.AEStronglyMeasurable canonicalBarB (hatRhoS s0) := by
    intro _ _ _ _ _ _
    have hcanonicalRegularity :
        MeasureTheory.AEStronglyMeasurable canonicalBarB (hatRhoS s0) ∧
          MeasureTheory.Integrable canonicalBarB (hatRhoS s0) := by
      simpa [canonicalGuide, canonicalScore, canonicalBarB] using
        (generalMovingTargetDiscreteCondDistribCanonicalDriftRegularity
          (P := P) (hatRhoS := hatRhoS s0) (hatXAtS := hatX s0)
          (Xk := Xk) (guideIntegrand := guideIntegrand)
          (scoreIntegrand := scoreIntegrand) dotTk sigmaCoeff
          (hhatRhoS s0) hXk hguideMeas hguideInt hscoreMeas hscoreInt)
    exact hcanonicalRegularity.1
  exact
    generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDerivMeasBoundIntPathValueDriftActionPairMeasNoBoundaryTraceDominated
      testEval testGrad boundaryMeasure testTrace normalFluxTrace Admissible
      commonSpace conditionalKernel driftRegular densityRegular testRegular
      boundaryBehavior driftAction diffusionAction driftDiv laplacian
      guideAction scoreAction divTotal boundaryFlux s0 sLeft sRight dotTk
      sigmaEta sigmaCoeff pairBound sampleDeriv bound jointBound hhatRhoS
      hhatXAtS hhatX hXk hguideMeas hguideInt hscoreMeas hscoreInt
      htestMeas htestInt hcommon hkernel hdrift hdensity htests hboundary
      hcoeff hs0Interval hconcreteSampleDerivMeas
      hsampleDerivConcreteAeEqInterval hconcreteSampleDerivBound
      hjointBoundInt hboundAeEqJoint hconcretePathDifferentiable
      hconcreteDerivativeIntegralSplit hdiffusionSource
      hdriftActionComponents hguideActionPairing hscoreActionPairing
      hweakCongr hweakAdd hweakSmul htestGradMeas
      (by simpa [canonicalGuide, canonicalScore, canonicalBarB] using
        hcanonicalBarBMeas)
      hgradNormBound hproductRule hdivergenceTheorem hboundaryFluxIntegral
      htestTraceZero

/-- Canonical `barB` dominated weak derivative with the diffusion source action
split into the EM/Brownian weak diffusion action and weak Laplacian action.

This cycle-129 lower continuation removes the direct `hdiffusionSource` premise
from the canonical EM weak-FP consumer.  The remaining analytic boundary is the
source-facing pair from `appendix.tex:1379-1387`: identify the frozen
EM/Brownian diffusion generator contribution with a named weak diffusion
action, then identify that action with the positive
`sigmaCoeff • laplacian phi` term by the weak Laplacian
integration-by-parts theorem.
-/
theorem generalMovingTargetDiscreteCanonicalBarBWeakConditionalFpNamedLawDerivativeOfEmIntervalMeasIntDerivMeasBoundIntPathValueDriftActionPairMeasNoBoundaryTraceCanonicalMeasDiffusionSourceDominated
    {Ω State Vec Test Boundary : Type*} [MeasurableSpace Ω]
    [MeasurableSpace State] [MeasurableSpace Boundary]
    [NormedAddCommGroup Vec] [NormedSpace ℝ Vec] [CompleteSpace Vec]
    [InnerProductSpace Real Vec] [StandardBorelSpace State] [Nonempty State]
    {P : MeasureTheory.Measure Ω} [MeasureTheory.IsFiniteMeasure P]
    {hatX : Real → Ω → State}
    {hatRhoS : Real → MeasureTheory.Measure State}
    {Xk : Ω → State}
    {guideIntegrand scoreIntegrand : State × State → Vec}
    (testEval : Test → State → Real)
    (testGrad : Test → State → Vec)
    (boundaryMeasure : MeasureTheory.Measure Boundary)
    (testTrace : Test → Boundary → Real)
    (normalFluxTrace : Boundary → Real)
    (Admissible : Test → Prop)
    (commonSpace conditionalKernel driftRegular densityRegular testRegular
      boundaryBehavior : Prop)
    (driftAction diffusionAction weakDiffusionAction driftDiv laplacian :
      Test → Real)
    (guideAction scoreAction : Test → Real)
    (divTotal boundaryFlux : Test → Real)
    (s0 sLeft sRight dotTk sigmaEta sigmaCoeff : Real)
    (pairBound : Test → Real)
    (sampleDeriv : Test → Real → Ω → Real)
    (bound : Test → Ω → Real)
    (jointBound : Test → State × State → Real)
    (hhatRhoS : ∀ s, hatRhoS s = MeasureTheory.Measure.map (hatX s) P)
    (hhatXAtS : Measurable (hatX s0))
    (hhatX : ∀ s, AEMeasurable (hatX s) P)
    (hXk : AEMeasurable Xk P)
    (hguideMeas :
      MeasureTheory.AEStronglyMeasurable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hguideInt :
      MeasureTheory.Integrable guideIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreMeas :
      MeasureTheory.AEStronglyMeasurable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hscoreInt :
      MeasureTheory.Integrable scoreIntegrand
        (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (htestMeas :
      ∀ φ s, Admissible φ →
        MeasureTheory.AEStronglyMeasurable (testEval φ) (hatRhoS s))
    (htestInt :
      ∀ φ s, Admissible φ →
        MeasureTheory.Integrable (testEval φ) (hatRhoS s))
    (hcommon : commonSpace)
    (hkernel : conditionalKernel)
    (hdrift : driftRegular)
    (hdensity : densityRegular)
    (htests : testRegular)
    (hboundary : boundaryBehavior)
    (hcoeff : sigmaCoeff = sigmaEta ^ 2 / 2)
    (hs0Interval : s0 ∈ Set.Ioo sLeft sRight)
    (hconcreteSampleDerivMeas :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.AEStronglyMeasurable
          (fun ω => deriv (fun t : Real => testEval φ (hatX t ω)) s0) P)
    (hsampleDerivConcreteAeEqInterval :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          sampleDeriv φ s ω =
            deriv (fun t : Real => testEval φ (hatX t ω)) s)
    (hconcreteSampleDerivBound :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          ‖deriv (fun t : Real => testEval φ (hatX t ω)) s‖ ≤ bound φ ω)
    (hjointBoundInt :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        MeasureTheory.Integrable (jointBound φ)
          (MeasureTheory.Measure.map (fun ω => (hatX s0 ω, Xk ω)) P))
    (hboundAeEqJoint :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        bound φ =ᵐ[P] (fun ω => jointBound φ (hatX s0 ω, Xk ω)))
    (hconcretePathDifferentiable :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        ∀ᵐ ω ∂P, ∀ s ∈ Set.Ioo sLeft sRight,
          DifferentiableAt Real
            (fun t : Real => testEval φ (hatX t ω)) s)
    (hconcreteDerivativeIntegralSplit :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        (∫ ω, deriv (fun t : Real => testEval φ (hatX t ω)) s0 ∂P) =
          driftAction φ + diffusionAction φ)
    (hdiffusionAction :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        diffusionAction φ = weakDiffusionAction φ)
    (hlaplacianAction :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        weakDiffusionAction φ = sigmaCoeff • laplacian φ) :
    let canonicalGuide : State → Vec :=
      fun x =>
        ∫ y, guideIntegrand (x, y)
          ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x
    let canonicalScore : State → Vec :=
      fun x =>
        ∫ y, scoreIntegrand (x, y)
          ∂ProbabilityTheory.condDistrib Xk (hatX s0) P x
    let canonicalBarB : State → Vec :=
      fun x => dotTk • canonicalGuide x + sigmaCoeff • canonicalScore x
    let weakGradPairing : (State → Vec) → Test → Real :=
      fun f ψ => ∫ x, inner Real (testGrad ψ x) (f x) ∂(hatRhoS s0)
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftAction φ = dotTk • guideAction φ + sigmaCoeff • scoreAction φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      guideAction φ = weakGradPairing canonicalGuide φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      scoreAction φ = weakGradPairing canonicalScore φ) →
    (∀ {f g : State → Vec}, (∀ x, f x = g x) →
      ∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      weakGradPairing f φ = weakGradPairing g φ) →
    (∀ (f g : State → Vec) (φ : Test), Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      weakGradPairing (fun x => f x + g x) φ =
        weakGradPairing f φ + weakGradPairing g φ) →
    (∀ (a : Real) (f : State → Vec) (φ : Test), Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      weakGradPairing (fun x => a • f x) φ = a • weakGradPairing f φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      MeasureTheory.AEStronglyMeasurable (testGrad φ) (hatRhoS s0)) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      ∀ᵐ x ∂(hatRhoS s0), ‖testGrad φ x‖ ≤ pairBound φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      driftDiv φ + (∫ x, inner Real (testGrad φ x) (canonicalBarB x)
        ∂(hatRhoS s0)) = divTotal φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      divTotal φ = boundaryFlux φ) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      boundaryFlux φ =
        ∫ y, testTrace φ y * normalFluxTrace y ∂boundaryMeasure) →
    (∀ φ, Admissible φ →
      commonSpace → conditionalKernel → driftRegular → densityRegular →
        testRegular → boundaryBehavior →
      ∀ᵐ y ∂boundaryMeasure, testTrace φ y = 0) →
    ∀ φ, Admissible φ →
      HasDerivAt
        (fun s => ∫ x, testEval φ x ∂hatRhoS s)
        (-(driftDiv φ) + (sigmaEta ^ 2 / 2) • laplacian φ) s0 := by
  have hdiffusionSource :
      ∀ φ, Admissible φ →
        commonSpace → conditionalKernel → driftRegular → densityRegular →
          testRegular → boundaryBehavior →
        diffusionAction φ = sigmaCoeff • laplacian φ :=
    generalMovingTargetDiscreteWeakConditionalFpDiffusionSourceOfLaplacianAction
