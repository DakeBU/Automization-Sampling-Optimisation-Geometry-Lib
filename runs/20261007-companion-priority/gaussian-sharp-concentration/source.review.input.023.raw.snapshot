      "truth_boundary": "Neighbor Lemma4.1 η≤1 and numerical query≤1/(2β) are separate excluded scopes."
    },
    {
      "id": "PROX-WELLDEFINED",
      "kind": "CharacterizedSourceDefinition-SourceGap",
      "source_anchors": [
        "S2.E1",
        "S4.Ex3"
      ],
      "formula": "pη(y)=argmin_x[V(x)+‖x−y‖²/(2η)]",
      "parents": [
        "STANDING-V",
        "ETA-POSITIVE"
      ],
      "conclusion": "Genuine unique proximal point, not a supplied minimizer/selector.",
      "truth_boundary": "Source omits full existence/uniqueness construction. No compiled credit; any measurable-family construction is future representation extension."
    },
    {
      "id": "CANONICAL-GAUSSIAN",
      "kind": "LiteralSourceDefinition",
      "source_anchors": [
        "S3.E2"
      ],
      "formula": "G∼γd=N(0,I_d)",
      "parents": [],
      "conclusion": "Actual identity-covariance standard Gaussian probability, including dimension0 endpoint.",
      "truth_boundary": "Not arbitrary supplied probability law, posteriorRGO, standardizedr_y or HMC kernel."
    },
    {
      "id": "GAUSSIAN-ORACLE",
      "kind": "LiteralSourceDefinition",
      "source_anchors": [
        "S3.E2"
      ],
      "formula": "H_y(z)=∇V(pη(y)+√η z)",
      "parents": [
        "STANDING-V",
        "ETA-POSITIVE",
        "PROX-WELLDEFINED"
      ],
      "conclusion": "Actual gradient observable; random output H_y(G).",
      "truth_boundary": "All source mean/concentration concern this literal oracle."
    },
    {
      "id": "GRADIENT-LIPSCHITZ",
      "kind": "DerivedSourceFact",
      "source_anchors": [
        "S4.SS1.p5.2",
        "S4.SS1.p5.m6",
        "S4.SS1.p5.m7"
      ],
      "formula": "‖∇V(x)−∇V(x′)‖≤‖x−x′‖",
      "parents": [
        "STANDING-V"
      ],
      "conclusion": "True gradient1-Lipschitz from C² and normalized Hessian upper bound.",
      "truth_boundary": "Printed fact appears in spatial4.4 proof clause but is reusable for noise4.5; no spatial4.4 completion claimed."
    },
    {
      "id": "NOISE-LIPSCHITZ",
