@import url("./site-base.css");
@import url("./reader-polish.css");
/* Actions stay with their folded source block. */
.lean-source-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: .75rem;
  margin: .8rem 0;
}
.lean-source-actions button {
  font: inherit;
  color: inherit;
  background: transparent;
  border: 1px solid currentColor;
  border-radius: .35rem;
  padding: .3rem .65rem;
  cursor: pointer;
}
