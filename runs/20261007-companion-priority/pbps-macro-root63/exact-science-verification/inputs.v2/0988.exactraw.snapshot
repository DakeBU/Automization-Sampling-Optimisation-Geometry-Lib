import datetime,hashlib,json,os,pathlib,re
R=pathlib.Path('E:/Samplinglib');O=pathlib.Path(__file__).resolve().parent
def sha(b):return hashlib.sha256(b).hexdigest()
def wr(n,x):(O/n).write_bytes((json.dumps(x,ensure_ascii=False,indent=2)+'\n').encode('utf-8'))
def j(n):return json.loads((O/n).read_bytes())
m=j('input.manifest.json');pairs=m['qualified_raw_LF_pairs']
def raw(i):return (R/pairs[i]['raw_snapshot']['path']).read_bytes()
def obj(i):return json.loads(raw(i))
def text(i):return raw(i).decode('utf-8')
headers=[]
for i,h in [(0,22),(1,23)]:
 s=text(i);start=s.index('theorem ');end=s.index(':= by',start)
 if s[end-1]==' ':end-=1 # Exclude the single theorem/body delimiter space, not header content.
 actual=s[start:end].encode();sealed=raw(h)
 assert actual.rstrip(b'\n')==sealed.rstrip(b'\n')
 headers.append(dict(production=pairs[i]['original'],sealed_header=pairs[h]['original'],comparison='Literal bytes after removal of ONLY trailing LF blank lines; no token/space/assumption normalization.',match=True,header=sealed.decode()))
draft=obj(20);steps=[s for u in draft['units'] for s in u['steps']];codes=obj(21)
assert len(steps)==8 and len(codes['regions'])==8
verified_steps=[]
reasons=[
 'The actual59 producer takes only the original potential/Hessian/capped-step hypotheses. Its probability witnesses are installed locally. LinearIsometry.ext and Lp.ext align its M0 with the canonical pullback using each observable\'s AE representative action, so the later onto map transports the SAME T and kernel rather than a substituted model.',
 'P is definitionally HP.starProjection, where HP is the closed lpMeas subspace for comap snd. range_starProjection identifies ran(P)=HP and starProjection fixes every member. The genuine58 actual-range theorem proves ran(M)=ran(P); M.equivRange and ofEq then produce an onto isometric equivalence e with subtype(eu)=Mu. Completeness and the ambient-product containment Fact are derived; none is a public hypothesis.',
 'For arbitrary f:HP, evaluate actual59 MT=PUPM at e.symm f. Inclusion is injective and P fixes f, yielding iAf=AJif and A=e.conj T. Conjugation by an isometric equivalence preserves selfadjointness and norms; the scalar contraction transfers to all macro f. AJ is the ambient PUP, A is the HP endomorphism; no positivity of A is asserted or used.',
 'P((I-P)UP f)=0 follows from projection idempotence. A second actual reflection witness is identified with the same U by its per-observable AE action, not by an assumed uniqueness certificate. The existing ReflectionL2 first block identity yields the full-joint B0.adjoint∘B0=P-AJ². This is never replaced by I_joint-AJ².',
 'The real scalar root theorem consumes the internally derived actual D positivity. ΓP=e.conj Γ is positive and squares to I_HP-A². Adjoint composition rewrites B†B as i†(P-AJ²)i; P fixes HP and AJ intertwines iA, so this restriction is I_HP-A²=ΓP². The typed B:HP→joint makes its adjoint joint→HP; all composition domains agree.',
 'The scalar energy identity at e.symm f, followed by the actual59 defect identity and isometry norm preservation, gives norm(ΓP f)²=norm(f)²-norm(Af)² for every f. The typed Gram identity plus positivity/selfadjointness of ΓP equates norm(Bf)² and norm(ΓP f)²; nonnegative norms justify the unsquared equality.',
 'For ANY positive G:HP→L[ℝ]HP with G²=I_HP-A², inverse conjugation gives positive G0=e.symm.conj G with G0²=I_scalar-T². Generic62 positive_square_roots_unique applies to G0 and Γ on L2(ν). Conjugating back proves G=ΓP. The competing-root quantifier is outside the forall-f energy conjunct and requires no alternative energy, CFC, commutation or supplied root certificate.',
 'The named Test binds exactly original source inputs. It derives Product measurability and the containment Fact locally, calls the actual theorem, and keeps all witnesses. Every-f root contractivity follows from energy and norm(Af)²≥0 by nonnegative-norm arithmetic. The consumer supplies no probabilities, S, e, U, T, positivity, square-root, onto, completeness or energy certificate.'
]
for n,s in enumerate(steps):
 q=s['lean_source_region'];bb=(R/q['path']).read_bytes();assert sha(bb)==q['source_raw_sha256']
 excerpt=b''.join(bb.splitlines(keepends=True)[q['start_line']-1:q['end_line']])
 exact=(sha(excerpt)==q['exact_code_raw_sha256'] and excerpt==s['lean'].encode('utf-8'))
 if n!=2:assert exact
 else:
  assert not exact and sha(excerpt)=='90b9b65491cb5fdace9c60c5e65ddae6e777b2eea20b588dbcd74a1311cae609'
  assert excerpt.replace(b'            let A :',b'  let A :',1)==s['lean'].encode('utf-8')
 assert q==codes['regions'][n]
 verified_steps.append(dict(number=n+1,authored_step=s,whole_body_mathematical_reason=reasons[n],exact_multiline_excerpt_verified=exact,actual_literal_span_sha256=sha(excerpt),verdict='accepted-scoped-mathematical-step' if exact else 'mathematical-reason-accepted; exact-publication-excerpt-binding-blocked'))
repair_bytes=b''.join(raw(0).splitlines(keepends=True)[119:146])
