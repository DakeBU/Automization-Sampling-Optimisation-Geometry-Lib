theorem generalMovingTargetDiscreteWeakConditionalFpDiffusionSourceOfSecondGreenBoxBoundaryFluxOfPointwiseTraceEqPointwiseTestTraceZeroOfStdBasisSourceFormula
    {n : Nat} {Boundary Test E : Type*} [MeasurableSpace Boundary]
