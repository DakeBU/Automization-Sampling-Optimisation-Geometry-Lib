  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.WeightedC1GradientDomain.c1_in_closed_gradient",
      "title": "Actual weighted C1 pair in original gradient closure",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06905v1#A3.SS1",
          "label": "PBPS AppC1 authored original-gradient domain prerequisite",
          "scope": "Actual finite real Hilbert/Borel E including0. Fix actual finite mu and SAME original closable exact compact-C-infinity gradient D BEFORE ALL C1 f with actual MemLp f2mu and MemLp gradientf2mu. Genuine smooth cutoff exhaustion/derivative-product/weighted L2 limits put actual class pair into SAME closure graph, without compact support or extra spatial moment. Finite mu constants are genuinely in original closure domain with outputzero. For actual C1 Gibbs W/exp(-W) integrable, combine actual constants-domain with accepted one-way implication for full zero-output iff AEconstant on SAME D. Actual PBPS common Gaussian J/R/S/Sdensity/positive partitions/sourceC2 alpha beta eta cap and original D_y beforeALL constants/u/directions; real unnormalized y-score C1/L2/boundedgradient from accepted score producer transfers along ONLY explicit reflected density equality S2_y=S_y and enters SAME original closed graph. No R2=R or alternateD equality, global ordinary L1, C-infinity potential, gradient of rough representative, Nontrivial E, spatial moment, supplied domain/fullkernel/spectralgap/Poincare certificate, epsilon0/range/centering/measurablejointselector/core/BL/main/composition. TV never transfers unbounded cost."
        }
      ],
      "tests": [
        "lake build Tests.WeightedC1GradientDomain"
      ],
      "assumptions": [
        "Full finite real Hilbert/Borel E including dimension0. Fix SAME original real weighted-L2 partial-linear gradient D with exact compact-C-infinity genuine gradient graph and closability BEFORE all queried functions or classes.",
        "Actual finite mu, actual C1 f, scalar MemLp f2mu and vector MemLp(gradient f)2mu. These are genuine weighted classes; finite probability alone does not make unbounded f L2."
      ],
      "statement": "Every actual C1 f with genuine weighted scalar and gradient L2 classes has its actual pair (f,gradientf) in SAME original compact-smooth D.closure.graph, with no compact-support premise.",
      "formula": "f\\in C^1(E),\\ f,\\nabla f\\in L^2(\\mu)\\Longrightarrow([f],[\\nabla f])\\in\\operatorname{graph}\\overline D.",
      "boundary": "Actual finite real Hilbert/Borel E including0. Fix actual finite mu and SAME original closable exact compact-C-infinity gradient D BEFORE ALL C1 f with actual MemLp f2mu and MemLp gradientf2mu. Genuine smooth cutoff exhaustion/derivative-product/weighted L2 limits put actual class pair into SAME closure graph, without compact support or extra spatial moment. Finite mu constants are genuinely in original closure domain with outputzero. For actual C1 Gibbs W/exp(-W) integrable, combine actual constants-domain with accepted one-way implication for full zero-output iff AEconstant on SAME D. Actual PBPS common Gaussian J/R/S/Sdensity/positive partitions/sourceC2 alpha beta eta cap and original D_y beforeALL constants/u/directions; real unnormalized y-score C1/L2/boundedgradient from accepted score producer transfers along ONLY explicit reflected density equality S2_y=S_y and enters SAME original closed graph. No R2=R or alternateD equality, global ordinary L1, C-infinity potential, gradient of rough representative, Nontrivial E, spatial moment, supplied domain/fullkernel/spectralgap/Poincare certificate, epsilon0/range/centering/measurablejointselector/core/BL/main/composition. TV never transfers unbounded cost.",
      "steps": [
        {
          "title": "Choose actual smooth expanding compact cutoffs",
          "text": "Fix R_n=n+1 and genuine radialSmoothCutoff chi_n. Positive scales give genuine smoothness/compact support,0<=chi_n<=1 and pointwise chi_n->1, including dimension0. The first derivative bound needs no Nontrivial premise.",
          "formula": "R_n=n+1,\\quad0\\le\\chi_n\\le1,\\quad\\chi_n\\to1,\\quad\\|\\nabla\\chi_n\\|\\le C/R_n.",
          "lean": "radialSmoothCutoff_contDiff; radialSmoothCutoff_hasCompactSupport; radialSmoothCutoff_fderiv_bound"
        },
        {
          "title": "Prove weighted quotient L2 cutoff convergence",
          "text": "Actual MemLp-backed scalar/vector coefficient products converge to their original classes. Dominated square integrals use |chi_n-1|<=1 and actual L2 norm-square/sqrt conversion; representative convergence alone is insufficient.",
          "formula": "[(\\chi_n-1)f]\\to0,\\quad[(\\chi_n-1)\\nabla f]\\to0\\quad\\text{in }L^2(\\mu).",
          "lean": "bounded_coefficient_memLp; norm_sq_integral; bounded_coefficient_tendsto_zero; actual_cutoff_function_convergence"
        },
        {
          "title": "Control the genuine product derivative remainder",
          "text": "The actual cutoff gradient tends0 and is uniformly bounded by C because R_n>=1. Genuine weighted dominated convergence of norm(f*gradientchi_n)^2 proves its vector L2 class tends0. Domination is by C^2|f|^2, so no norm(x)*f moment is used.",
          "formula": "\\|f\\nabla\\chi_n\\|\\le C|f|,\\quad[f\\nabla\\chi_n]\\to0\\quad L^2(\\mu).",
          "lean": "dominated_L2_tendsto_zero; radialSmoothCutoff_fderiv_bound; c1_in_closed_gradient"
        },
        {
          "title": "Use a genuine C1 product rule",
          "text": "Each chi_n*f is actual C1 compact. Actual differentiability precedes the Frechet product derivative; the Riesz map identifies its genuine gradient as the two factors whose classes have just been controlled.",
          "formula": "\\nabla(\\chi_nf)=\\chi_n\\nabla f+f\\nabla\\chi_n.",
          "lean": "fderiv_fun_mul; toDual; c1_in_closed_gradient"
        },
        {
          "title": "Apply the actual compact-C1 producer in the SAME original graph",
          "text": "For each n, accepted joint compact mollification puts the actual function/gradient classes into SAME D.closure.graph. Actual AE quotient extensionality identifies those classes with the cutoff scalar and vector-sum classes. No common support or supplied density/domain certificate is assumed.",
          "formula": "([\\chi_nf],[\\chi_n\\nabla f+f\\nabla\\chi_n])\\in\\operatorname{graph}\\overline D.",
          "lean": "CompactC1GradientDomain.compact_c1_in_closed_gradient; Lp.ext"
        },
        {
          "title": "Pass by actual closed graph and product L2 convergence",
          "text": "Closable D has closure graph equal to topological closure of its original graph. Genuine scalar/vector L2 limits and graph closedness admit the actual limiting pair. This is first-order domain membership, not generator-core, rough Hessian, Poincare or BL.",
          "formula": "([f],[\\nabla f])=\\lim_n([\\chi_nf],[\\nabla(\\chi_nf)])\\in\\operatorname{graph}\\overline D.",
          "lean": "LinearPMap.IsClosable.graph_closure_eq_closure_graph; IsClosed.mem_of_tendsto; c1_in_closed_gradient"
        }
      ],
      "lean_statement": "Every actual C1 f with genuine weighted scalar and gradient L2 classes has its actual pair (f,gradientf) in SAME original compact-smooth D.closure.graph, with no compact-support premise.",
      "lean_proof": "Choose actual smooth expanding compact cutoffs; Prove weighted quotient L2 cutoff convergence; Control the genuine product derivative remainder; Use a genuine C1 product rule; Apply the actual compact-C1 producer in the SAME original graph; Pass by actual closed graph and product L2 convergence",
      "astis_dependencies": [
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.CompactC1GradientDomain.compact_c1_in_closed_gradient",
        "AutoSamplingTheory.TechnicalLemmas.Analysis.Calculus.Cutoff.radialSmoothCutoff_fderiv_bound",
        "AutoSamplingTheory.TechnicalLemmas.Analysis.Calculus.Cutoff.radialSmoothCutoff_contDiff",
        "AutoSamplingTheory.TechnicalLemmas.Analysis.Calculus.Cutoff.radialSmoothCutoff_mem_Icc",
        "AutoSamplingTheory.TechnicalLemmas.Analysis.Calculus.Cutoff.radialSmoothCutoff_tendsto_one",
        "AutoSamplingTheory.TechnicalLemmas.Analysis.Calculus.Cutoff.radialSmoothCutoff_hasCompactSupport"
      ],
