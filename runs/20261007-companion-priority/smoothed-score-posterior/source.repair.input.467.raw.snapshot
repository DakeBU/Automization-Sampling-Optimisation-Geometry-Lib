<div id="S4.Thmtheorem3" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem3.2" class="ltx_text ltx_font_bold">Lemma 4.3</span></span><span id="S4.Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(Derivatives of the smoothed potential)<span id="S4.Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem3.p1" class="ltx_para">
<p id="S4.Thmtheorem3.p1.1" class="ltx_p"><span id="S4.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">For every integer <math id="S4.Thmtheorem3.p1.m1" class="ltx_Math" alttext="k\geqslant 2" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>⩾</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">k\geqslant 2</annotation></semantics></math>,</span></p>
<table id="S4.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E7.m1" class="ltx_Math" alttext="\displaystyle\sup_{y\in\mathbb{R}^{d}}\,\lVert D^{k}V_{\eta}(y)\rVert_{\mathrm{HS}}" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mi>y</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></munder><msub><mrow><mo fence="true" lspace="0.170em" rspace="0em">∥</mo><mrow><msup><mi>D</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>η</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em">∥</mo></mrow><mi>HS</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{y\in\mathbb{R}^{d}}\,\lVert D^{k}V_{\eta}(y)\rVert_{\mathrm{HS}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E7.m2" class="ltx_math_unparsed" alttext="\displaystyle\leqslant(k-1)!\,\sqrt{d}\,\eta^{-(k-2)/2}\,," display="inline" intent=":literal"><semantics><mrow><mo>⩽</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo rspace="0.170em">!</mo><msqrt><mi>d</mi></msqrt><msup><mi>η</mi><mrow><mo>−</mo><mo stretchy="false">(</mo><mi>k</mi><mo>−</mo><mn>2</mn><mo stretchy="false">)</mo><mo>/</mo><mn>2</mn></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leqslant(k-1)!\,\sqrt{d}\,\eta^{-(k-2)/2}\,,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.7)</span></td></tr></tbody>
<tbody id="S4.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E8.m1" class="ltx_math_unparsed" alttext="\displaystyle\sup_{y\in\mathbb{R}^{d},\,\lVert v\rVert=1}\,\lVert D^{k}V_{\eta}(y)[v,\cdot^{k-1}]\rVert_{\mathrm{HS}}" display="inline" intent=":literal"><semantics><mrow><munder><mo movablelimits="false">sup</mo><mrow><mrow><mi>y</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><mo rspace="0.059em">,</mo><mrow><mrow><mo fence="true" rspace="0em">∥</mo><mi>v</mi><mo fence="true" lspace="0em" rspace="0.1389em">∥</mo></mrow><mo lspace="0.1389em">=</mo><mn>1</mn></mrow></mrow></munder><msub><mrow><mo fence="true" lspace="0.170em" rspace="0em">∥</mo><msup><mi>D</mi><mi>k</mi></msup><msub><mi>V</mi><mi>η</mi></msub><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">[</mo><mi>v</mi><mo rspace="0em">,</mo><msup><mo lspace="0em" rspace="0em">⋅</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msup><mo stretchy="false">]</mo></mrow><mo fence="true" lspace="0em">∥</mo></mrow><mi>HS</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\sup_{y\in\mathbb{R}^{d},\,\lVert v\rVert=1}\,\lVert D^{k}V_{\eta}(y)[v,\cdot^{k-1}]\rVert_{\mathrm{HS}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E8.m2" class="ltx_math_unparsed" alttext="\displaystyle\leqslant(k-1)!\,\eta^{-(k-2)/2}\,." display="inline" intent=":literal"><semantics><mrow><mo>⩽</mo><mrow><mo stretchy="false">(</mo><mi>k</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo rspace="0.170em">!</mo><msup><mi>η</mi><mrow><mo>−</mo><mo stretchy="false">(</mo><mi>k</mi><mo>−</mo><mn>2</mn><mo stretchy="false">)</mo><mo>/</mo><mn>2</mn></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leqslant(k-1)!\,\eta^{-(k-2)/2}\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.8)</span></td></tr></tbody>
</table>
<p id="S4.Thmtheorem3.p1.2" class="ltx_p"><span id="S4.Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">Consequently,</span></p>
<table id="S4.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E9.m1" class="ltx_math_unparsed" alttext="\lVert\nabla^{2}V_{\eta}(y)-\nabla^{2}V_{\eta}(y^{\prime})\rVert_{\mathrm{HS}}\leqslant 2\eta^{-1/2}\,\lVert y-y^{\prime}\rVert\,." display="block" intent=":literal"><semantics><mrow><msub><mrow><mo fence="true" rspace="0em">∥</mo><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mi>V</mi><mi>η</mi></msub><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mo rspace="0.167em">∇</mo><mn>2</mn></msup><msub><mi>V</mi><mi>η</mi></msub><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo fence="true" lspace="0em">∥</mo></mrow><mi>HS</mi></msub><mo>⩽</mo><mn>2</mn><msup><mi>η</mi><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo><mi>y</mi><mo>−</mo><msup><mi>y</mi><mo>′</mo></msup><mo fence="true" lspace="0em" rspace="0.085em">∥</mo></mrow><mo lspace="0.085em">.</mo></mrow><annotation encoding="application/x-tex">\lVert\nabla^{2}V_{\eta}(y)-\nabla^{2}V_{\eta}(y^{\prime})\rVert_{\mathrm{HS}}\leqslant 2\eta^{-1/2}\,\lVert y-y^{\prime}\rVert\,.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(4.9)</span></td></tr></tbody>
</table>
</div>
</div>