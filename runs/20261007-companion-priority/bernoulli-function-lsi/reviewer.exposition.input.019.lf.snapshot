  <summary><span class="kind">theorem</span> <code>AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.BernoulliLogSobolev.gradientNormSq_succ_decomposition</code> <span class="status status-yellow">Partial</span> <span class="status status-gray">Not mapped</span></summary>
