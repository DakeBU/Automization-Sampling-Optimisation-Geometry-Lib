    {
      "id": "M-CLE-INV",
      "kind": "PINNED_API_DECLARATION",
      "statement": "@[simp]\nlemma equivFunL_symm_apply_repr (v : Basis ι 𝕜 E) (x : E) :\n    v.equivFunL.symm (v.repr x) = x :=\n  v.equivFunL.symm_apply_apply x\n",
      "source_anchors": [
