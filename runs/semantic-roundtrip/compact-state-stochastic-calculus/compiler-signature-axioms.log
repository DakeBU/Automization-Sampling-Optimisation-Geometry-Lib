AutoSamplingTheory.TechnicalLemmas.Geometry.SphereDiffusionGenerator.ito_generator_eq_sphereLaplacian.{u_1}
  {I : Type u_1} [Fintype I] [DecidableEq I] (f : EuclideanSpace ℝ I → ℝ) {w : EuclideanSpace ℝ I} (hw : ‖w‖ = 1)
  (u : EuclideanSpace ℝ I) {temperature : ℝ} (hTemperature : 0 ≤ temperature) :
  have σ := fun j =>
    √(2 * temperature) • AutoSamplingTheory.TechnicalLemmas.Geometry.SphereProjectedNoise.projectedNoiseColumn j w;
  have b := -u - (temperature * ↑(Fintype.card I - 1)) • w;
  (fderiv ℝ f w) b + 1 / 2 * ∑ j, ((fderiv ℝ (fderiv ℝ f) w) (σ j)) (σ j) =
    -(fderiv ℝ f w) u +
      temperature * AutoSamplingTheory.TechnicalLemmas.Geometry.SphereDiffusionGenerator.sphereLaplacian f w
END_6
