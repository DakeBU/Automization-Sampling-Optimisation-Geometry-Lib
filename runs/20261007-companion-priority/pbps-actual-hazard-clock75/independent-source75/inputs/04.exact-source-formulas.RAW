      "RAW_sha256": "e414f6370902cc5791cda78c679082dbf20edc8cf764c1e5fd6c7dfd52141bf6",
      "credit": "Exact source formula only; not a proved Lean clause",
      "id": "S3.E8.m1",
      "literal_source_alttext": "\\dot{x}=\\sqrt{\\eta}\\,p\\,,\\hskip 20.00003pt\\dot{p}=-\\frac{x-y}{\\sqrt{\\eta}}-\\sqrt{\\eta}\\,\\nabla V(\\widetilde{X})\\,,",
      "source_URL": "https://arxiv.org/html/2609.06905v1#S3.E8.m1"
    },
    {
      "LF_sha256": "08a7a8edc68bf4e5cf0d2c0ee5f3ba6b50b91e70eadd7892e4182b6874e7555f",
