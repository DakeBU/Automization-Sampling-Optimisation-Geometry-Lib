def AutoSamplingTheory.TechnicalLemmas.Analysis.CompactTaylorRemainder.secondOrderRemainder.{u_1, u_2} : {E :
    Type u_1} →
  {F : Type u_2} →
    [inst : NormedAddCommGroup E] →
      [NormedSpace ℝ E] → [inst : NormedAddCommGroup F] → [NormedSpace ℝ F] → (E → F) → E → E → F :=
fun {E} {F} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup F] [NormedSpace ℝ F] f x v =>
  f (x + v) - f x - (fderiv ℝ f x) v - (1 / 2) • ((fderiv ℝ (fderiv ℝ f) x) v) v
END_0
'AutoSamplingTheory.TechnicalLemmas.Analysis.CompactTaylorRemainder.secondOrderRemainder' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
