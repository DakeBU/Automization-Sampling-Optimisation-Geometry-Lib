      "credit": "Exact source formula only; not a proved Lean clause",
      "id": "A1.SS1.p3.m1",
      "literal_source_alttext": "\\mathcal{E}\\coloneqq H_{y,\\widetilde{x}}(x_{0},p_{0})",
      "source_URL": "https://arxiv.org/html/2609.06905v1#A1.SS1.p3.m1"
    },
    {
