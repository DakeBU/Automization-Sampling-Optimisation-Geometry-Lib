  "visual_inspection": "runs/20261007-companion-priority/pbps-real-defect-root61/visual.inspection.json",
  "graph_delta": "Two public compiled positive REAL scalar root declarations; ten private providers owned by the shared theorem. SAME actual PBPS T/D consumer. Four affected module graph artifacts, two enriched module cards; canonical older metadata preserved. No exported real uniqueness or joint GammaP/transport certificate.",
  "preserved_canonical_cards": 65,
  "unrelated_emitted_paths": 82,
  "remaining": "REAL scalar positive root and scalar energy only. Generic real uniqueness, canonical joint GammaP / P U blocks / onto transport / typed B*B, centered root order/inverse/polar, weakH1,dynamics,hypocoercivity,main,error,cost,composition remain separate; paper/Goal open. Reader seal/main/live/postmerge purification and whole Goal remain open.",
  "sole_stabilization_owner": "ASTIS-SA-20261005-SPHMCImplementedPhaseKernel"
}
