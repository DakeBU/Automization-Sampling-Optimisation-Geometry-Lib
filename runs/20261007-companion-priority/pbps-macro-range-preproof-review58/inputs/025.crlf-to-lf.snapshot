  "nodes": [
    {
      "id": "S:model",
      "anchor": "S1.p1/p2;S2.SS2;2.6",
      "kind": "standing/source-model",
      "statement": "V is C2 on printed R^d, 0<alpha<=beta, alpha I<=Hess V<=beta I, eta>0, beta eta<=1; mu is normalized exp(-V) volume law; J=law(X,X+sqrt(eta)Z) with independent Gaussian Z; nu=J.snd.",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "S:real-L2",
      "anchor": "D.1/D.2",
      "kind": "definition/quotient",
      "statement": "H=L2(J) is the complete REAL Hilbert space of AE classes, not finite dimensional. H0=ker(mean_J).",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "S:P",
      "anchor": "B.1/D.1",
      "kind": "definition/orthogonal-projection",
      "statement": "Pf=E[f|Y], on the sigma algebra comap snd; P^2=P=P*, ran(P)=lpMeas(comap snd).",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "S:M",
      "anchor": "B.2/D.1",
      "kind": "definition/pullback",
      "statement": "Canonical M:L2(nu)->L2(J), Mu=[u composed snd]; ||Mu||=||u||, real-linear, with AE J action.",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "S:M-fixed",
      "anchor": "B.1/B.2",
      "kind": "derived-pullback-inclusion",
      "statement": "PM=M: a snd-pullback class is fixed by conditional expectation; ran(M) subset ran(P).",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "BG:comap-representative",
      "anchor": "B.2 omitted quotient bookkeeping",
      "kind": "mathlib-available",
      "statement": "A class in lpMeas(comap snd) has an AE J equal representative g strongly measurable for comap snd. No arbitrary every-y representative equality.",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "BG:Doob-Dynkin",
      "anchor": "B.2 omitted factorization",
      "kind": "mathlib-available",
      "statement": "For REAL target (nonempty, completely metrizable), strongly measurable g for comap snd factors as h composed snd for strongly measurable h. Fixed FactorsThrough exists_eq_measurable_comp; no additional StandardBorel assumption.",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "BG:pushforward-Lp",
      "anchor": "B.2 omitted Lp transfer",
      "kind": "mathlib-available",
      "statement": "Since nu=map snd J, AE measurability and MemLp of h composed snd imply h in MemLp(2,nu), via memLp_map_measure_iff. Measurability is discharged from h and snd.",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "S:M-onto",
      "anchor": "B.2",
      "kind": "source-identification",
      "statement": "ran(M)=ran(P); M is a real linear isometric equivalence L2(nu) to H_P=ran(P). Reverse inclusion constructs h in L2(nu), not a supplied caller certificate.",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "S:mean-pullback",
      "anchor": "D.2/B.2",
      "kind": "background integral transport",
      "statement": "mean_J(Mu)=mean_nu(u), by actual probability pushforward and L2 integrability; alternatively pair with class 1.",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "S:centered-onto",
      "anchor": "D.2/B.2/C.3",
      "kind": "derived-subspace-identification",
      "statement": "M maps the closed centered L2_0(nu) ONTO H_P,0=ran(P) intersect L2_0(J); onto identification and closedness are conclusions.",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "S:U",
      "anchor": "B.4/2.14",
      "kind": "actual-reflection",
      "statement": "Uf=[f(x,2x-y)]; reflection preserves actual J and is an involution, hence real selfadjoint unitary.",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "S:blocks",
      "anchor": "B.3/B.4",
      "kind": "actual-compression",
      "statement": "A=PUP restricted H_P; B=(I-P)UP:H_P->ker(P). The full joint PUP identity is P-A_full^2, not I-A_full^2.",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "S:block-defect",
      "anchor": "B.5",
      "kind": "source-identity",
      "statement": "On H_P, B*B=I-A^2 and ||Bf||^2=||f||^2-||Af||^2 by orthogonal decomposition/unitarity.",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "S:T-same",
      "anchor": "B.8/B.2/C.1",
      "kind": "actual-scalar-intertwining",
      "statement": "One uniform bounded scalar T on actual L2(nu), literal reflected conditional mean; same canonical M satisfies MT=AM. Operator choices identified from AE action, never a caller equality premise.",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "S:centered-A",
      "anchor": "C.3/B.4/D.2",
      "kind": "discharged-centering",
      "statement": "A is selfadjoint and A1=1, so <1,Af>=<A1,f>=<1,f>=0. Equivalent actual stationarity/mean preservation is an alternative sufficient route, not another mandatory AND input.",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "S:sharp-C2",
      "anchor": "C.1/C.2/density sentence",
      "kind": "source-proof-predecessor",
      "statement": "eta||G(Tu)||^2 <= (1-alpha eta)^2/[4(1+alpha eta)] (||u||^2-||Tu||^2), all rough L2 via accepted closed compact-gradient graph; full source weak H1 equality remains OPEN.",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "S:marginal-PI",
      "anchor": "C.3;2.13;D.6/D.10",
      "kind": "source-proof-predecessor",
      "statement": "On centered closed-gradient domain under actual nu: ||v||^2 <= (1/alpha+eta)||Gv||^2. Actual curvature implies marginal PI; no public PI certificate.",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "S:scalar-C4",
      "anchor": "C.3/C.4",
      "kind": "source-contraction",
      "statement": "For every u in centered L2(nu), ||Tu|| <= rho||u||, rho=(1-alpha eta)/(1+alpha eta), with SAME T/G/laws. Sharp C2 and PI yield rho by rearrangement.",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "S:macro-C4",
      "anchor": "C.4",
      "kind": "integration-target",
      "statement": "For every f in H_P,0, choose unique centered u with Mu=f; ||Af||=||MTu||=||Tu||<=rho||u||=rho||f||.",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "S:squared-gap",
      "anchor": "final C.1 paragraph proving B.15",
      "kind": "integration-target",
      "statement": "For every f in H_P,0, ||Bf||^2=||f||^2-||Af||^2 >= 4alpha eta/(1+alpha eta)^2 ||f||^2. No Gamma construction is needed for this squared predecessor.",
      "status": "SOURCE_NODE",
      "proof_ingredients": []
    },
    {
      "id": "BG:positive-root",
      "anchor": "B.10/D.1/D.3",
      "kind": "source-contract-gap",
      "statement": "Construct unique bounded nonnegative selfadjoint Gamma=(I-A^2)^(1/2) on true potentially infinite real H_P; source invokes spectral theorem. No eta prefactor, no gradient/Laplacian resolvent.",
      "status": "OPEN_SOURCE_GAP",
      "proof_ingredients": []
    },
    {
      "id": "S:Gamma-norm",
      "anchor": "B.11",
      "kind": "later-consumer",
      "statement": "After actual positive root construction, ||Gamma f||^2=||Bf||^2 for all H_P.",
      "status": "OPEN_CONSUMER",
      "proof_ingredients": []
    },
    {
      "id": "S:Gamma-gap",
      "anchor": "B.15",
      "kind": "later-consumer",
      "statement": "Positive root monotonicity/spectral calculus gives Gamma >= 2sqrt(alpha eta)/(1+alpha eta) I on H_P,0.",
      "status": "OPEN_CONSUMER",
      "proof_ingredients": []
    },
    {
      "id": "S:inverse-polar",
      "anchor": "B.16",
      "kind": "later-consumer",
      "statement": "Gamma inverse only on H_P,0 after positive gap; B Gamma^-1 is isometry INTO microscopic space, not onto.",
      "status": "OPEN_CONSUMER",
      "proof_ingredients": []
    }
