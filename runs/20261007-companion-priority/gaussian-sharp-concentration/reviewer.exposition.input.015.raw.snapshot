  "chapters": [
    {
      "id": "chapter-01",
      "number": 1,
      "title": "The Langevin Diffusion in Continuous Time",
      "source_pages": "3–47",
      "source_sections": [
        "1.1 A Primer on Stochastic Calculus (p. 3)",
        "1.2 Markov Semigroup Theory (p. 10)",
        "1.3 The Geometry of Optimal Transport (p. 19)",
        "1.4 The Langevin SDE as a Wasserstein Gradient Flow (p. 31)",
        "1.5 Overview of the Convergence Results (p. 36)"
      ],
      "goal": "Build the analytic language that turns Langevin dynamics into quantitative convergence estimates.",
      "prerequisites": [
        "Euclidean calculus and multivariable differentiation",
        "Lebesgue integration and probability measures",
        "Conditional expectation and elementary Markov-process notation"
      ],
      "concepts": [
        "Markov semigroup",
        "infinitesimal generator",
        "Dirichlet form",
        "Poincaré and log-Sobolev inequalities",
        "Langevin diffusion",
        "Gibbs measure",
        "cutoff approximation"
      ],
      "core_definitions": [
        "A Markov semigroup evolves observables by conditional expectation.",
        "The infinitesimal generator is a time-zero semigroup derivative on its stated domain.",
        "The overdamped Langevin SDE has drift minus the potential gradient and isotropic Brownian noise.",
        "The Wasserstein gradient-flow viewpoint identifies the Fokker-Planck evolution with entropy dissipation."
      ],
      "major_results": [
        "Itô's formula yields the formal Langevin generator.",
        "The weighted integration-by-parts calculation predicts the Gibbs stationary density.",
        "Poincaré and log-Sobolev inequalities turn dissipation identities into exponential convergence.",
        "Strong convexity supplies the condition-number-dependent convergence scale summarized at the end of the chapter."
      ],
      "calculation_route": [
        {
          "title": "From the SDE to a formal generator",
          "formula": "dX_t=-\\nabla V(X_t)\\,dt+\\sqrt{2}\\,dB_t \\quad\\Longrightarrow\\quad Lf=\\Delta f-\\langle\\nabla V,\\nabla f\\rangle.",
          "explanation": "Itô's formula identifies the first-order change of expectations. The displayed operator is only a formal generator until a function domain is fixed."
        },
        {
          "title": "From the generator to dissipation",
          "formula": "\\int f\\,Lg\\,d\\pi=-\\int\\langle\\nabla f,\\nabla g\\rangle\\,d\\pi,\\qquad d\\pi\\propto e^{-V}dx.",
          "explanation": "The cancellation explains symmetry and entropy/variance dissipation. ASTIS treats the integration-by-parts passage as a theorem chain, not as notation."
        },
        {
          "title": "From a functional inequality to convergence",
          "formula": "\\operatorname{Var}_\\pi(P_t f)\\le e^{-2t/C_{\\rm PI}}\\operatorname{Var}_\\pi(f).",
          "explanation": "Differentiate the variance along the semigroup, insert the Poincaré inequality, and solve the scalar differential inequality."
        }
      ],
      "rigorous_details": [
        "The weighted integration-by-parts identity first needs compactly supported test functions or a justified cutoff limit.",
        "Pointwise exhaustion of a cutoff does not imply convergence of its gradient term under an integral.",
        "A totalized Fréchet derivative equal to zero outside a support set does not assert differentiability there.",
        "The score-weighted source field must be integrable before dominated convergence can be applied.",
        "Formal symmetry, a closed generator on a stated domain, stationarity, and invariance are separate claims."
      ],
      "lean_modules": [
        "AutoSamplingTheory.TechnicalLemmas.Analysis.Calculus.Divergence",
        "AutoSamplingTheory.TechnicalLemmas.Measure.Transport",
        "AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.Langevin",
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities"
      ],
      "blockers": [
        "Concrete Langevin Markov semigroup construction (external/upstream dependency)",
        "Semigroup-stable generator-domain extension beyond the compiled C_c^2 core",
        "Full invariant Gibbs law and measure-determining extension"
      ],
      "consumers": [
        "Mixing estimates throughout Chapters 2–8",
        "Discretization analyses for LMC and ULMC",
        "Non-log-concave perturbation arguments"
      ],
      "recommended_order": [
        "Read the three calculation steps",
        "Open the cutoff and integrability detail packets",
        "Inspect the radial-cutoff Lean declarations",
        "Return to the semigroup-domain blockers"
      ],
      "status": "active"
    },
    {
      "id": "chapter-02",
      "number": 2,
      "title": "Functional Inequalities",
      "source_pages": "48–95",
      "source_sections": [
        "2.1 Overview of the Inequalities (p. 48)",
        "2.2 Proofs via Markov Semigroup Theory (p. 50)",
        "2.3 Operations Preserving Functional Inequalities (p. 60)",
        "2.4 Concentration of Measure and Isoperimetry (p. 68)",
        "2.5 Riemannian Manifolds (p. 77)",
        "2.6 Discrete Space and Time (p. 84)"
      ],
      "goal": "Develop Poincaré, log-Sobolev, transport, and isoperimetric tools, including semigroup proofs and preservation operations.",
      "prerequisites": [
        "Convex functions and convex sets",
        "Chapter 1 functional-inequality vocabulary"
      ],
