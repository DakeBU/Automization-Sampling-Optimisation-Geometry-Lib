      "kind": "theorem",
      "declaration": "AutoSamplingTheory.ExampleCases.ProximalBPS.CenteredRootOrderInverse.actual_centered_root_order_inverse",
      "title": "Actual PBPS centered root order and bounded inverse",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06905v1#A2",
