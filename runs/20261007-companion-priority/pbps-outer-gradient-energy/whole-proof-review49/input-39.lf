∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E]
  [inst_3 : MeasurableSpace E] [inst_4 : BorelSpace E] {V : E → ℝ} {α β : ℝ≥0} {η : ℝ},
  0 < ↑α →
    α ≤ β →
      ContDiff ℝ 2 V →
        (∀ (x a : E), ↑α * ‖a‖ ^ 2 ≤ ((fderiv ℝ (fderiv ℝ V) x) a) a ∧ ((fderiv ℝ (fderiv ℝ V) x) a) a ≤ ↑β * ‖a‖ ^ 2) →
          0 < η →
            ↑β * η ≤ 1 →
              let μ := ℙ.tilted fun x => -V x;
              let J := Measure.map (fun p => (p.1, p.1 + √η • p.2)) (μ.prod (stdGaussian E));
              let ν := J.snd;
              IsProbabilityMeasure μ ∧
                IsProbabilityMeasure J ∧
                  IsProbabilityMeasure ν ∧
                    ∃ R S,
                      IsMarkovKernel R ∧
                        IsMarkovKernel S ∧
                          (Measure.map Prod.swap J).IsCondKernel R ∧
                            (∀ (y : E), S y = Measure.map (fun x => 2 • x - y) (R y)) ∧
                              (∀ (y : E), S y = ℙ.tilted fun u => -V ((1 / 2) • (y + u)) - ‖y - u‖ ^ 2 / (8 * η)) ∧
                                ∀ (f : E → ℝ),
                                  ContDiff ℝ ∞ f →
                                    HasCompactSupport f →
                                      let Tf := fun y => ∫ (u : E), f u ∂S y;
                                      Differentiable ℝ Tf ∧
                                        MemLp f 2 ν ∧
                                          MemLp Tf 2 ν ∧
                                            MemLp (gradient Tf) 2 ν ∧
                                              Integrable
                                                  (fun y =>
                                                    AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.Poincare.variance
                                                      (S y) f)
                                                  ν ∧
                                                ∫ (y : E),
                                                      AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.Poincare.variance
                                                        (S y) f ∂ν =
                                                    ∫ (y : E), f y ^ 2 ∂ν - ∫ (y : E), Tf y ^ 2 ∂ν ∧
                                                  η * ∫ (y : E), ‖gradient Tf y‖ ^ 2 ∂ν ≤
                                                    (1 - ↑α * η) ^ 2 / (4 * (1 + ↑α * η)) *
                                                      (∫ (y : E), f y ^ 2 ∂ν - ∫ (y : E), Tf y ^ 2 ∂ν) : Prop
