<math id="S4.Ex10.m1" class="ltx_Math" alttext="D^{k}V_{\eta}(y)=-\eta^{-k}\operatorname{Cum}_{k}(X\mid Y=y)\,." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>D</mi><mi>k</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mi>η</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo>−</mo><mrow><msup><mi>η</mi><mrow><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>Cum</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>Y</mi><mo>=</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0.170em">.</mo></mrow><annotation encoding="application/x-tex">D^{k}V_{\eta}(y)=-\eta^{-k}\operatorname{Cum}_{k}(X\mid Y=y)\,.</annotation></semantics></math>