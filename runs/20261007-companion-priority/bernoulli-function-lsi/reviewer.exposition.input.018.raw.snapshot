    <pre class="code-block"><code class="language-lean">private theorem differentiableAt_rothausDefect {t : ℝ} (ht : t ∈ Ioo (-1 : ℝ) 1) :
    DifferentiableAt ℝ rothausDefect t := by
  unfold rothausDefect
  have h1 : 0 &lt; 1 - t^2 := by nlinarith [ht.1, ht.2, sq_nonneg t]
