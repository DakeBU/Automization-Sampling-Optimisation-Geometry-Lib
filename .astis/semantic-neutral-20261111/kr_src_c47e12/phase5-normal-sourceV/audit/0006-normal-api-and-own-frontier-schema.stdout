73:     "CLAIMED": frozenset({"EXPLORING", "BLOCKED", "QUARANTINED"}),
74:     "EXPLORING": frozenset({"PROVED_LOCAL", "BLOCKED", "QUARANTINED"}),
75:     "PROVED_LOCAL": frozenset({"VERIFIED", "EXPLORING", "BLOCKED", "QUARANTINED"}),
76:     "VERIFIED": frozenset({"STABILIZING", "EXPLORING", "BLOCKED", "QUARANTINED"}),
77:     "STABILIZING": frozenset({"MERGED", "VERIFIED", "BLOCKED", "QUARANTINED"}),
78:     "BLOCKED": frozenset({"CLAIMED", "EXPLORING", "QUARANTINED"}),
