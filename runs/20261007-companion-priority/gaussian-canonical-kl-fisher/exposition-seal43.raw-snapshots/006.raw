{
  "schema_version": 1,
  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.ExampleCases.SmoothedPicardHMC.StandardizedRGOKLFisher.standardized_rgo_unique_prox_and_kl_le_fisher",
      "title": "Canonical KL bound for the actual standardized RGO",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06906v1#S4.E6",
          "label": "SPHMC arXiv2609.06906v1 S2 normalized hypotheses/prox/RGO/KL definitions; S4.Ex8 actual standardized posterior and S4.E6 omitted GaussianLSI component.",
          "scope": "Authored sufficient same-unique-prox canonical KL<=Fisher/2 leaf for the literal standardized RGO. Exact source normalized C2/Hessian assumptions; all positive eta, actual measurable-family extension incl rank0. Probability/AC/finite KL/scoreL2 and same witness are internally derived. Coherent32/33 actual rho/Z/q/f/r transported by uniqueness, true Gaussian functionLSI42 coefficient2 and actual32 energyquarter. No extra witness/coherence/density/law/desiredbound certificate. GaussianT2/W2/FIRST4.6/fullW12/sampling/both mains/error/work/expectedcost/main/live/PURIFIED remain separate. Actual focused3826 PASS; independent wholeproof/blind/source/exactcommit/shared admission pending."
        }
      ],
      "tests": [
        "lake build Tests.StandardizedRGOKLFisher"
      ],
      "assumptions": [
        "Finite-dimensional complete real Hilbert/Borel E; measurable parameter space S. Rank0 is an explicit authored extension.",
        "V is globally C2, kappa>=1 and kappa^-1 norm(v)^2<=D²V(x)[v,v]<=norm(v)^2 for every x,v, exactly the source normalized potential bounds.",
        "eta/y are measurable and eta(s)>0 for every s; the measurable family is an authored extension, with Unit recovering source fixed parameters. No eta<=1 hypothesis is added.",
        "Actual p, all probability/AC/finite entropy/score domains and the half-Fisher inequality are produced internally. Canonical KL is finite before toReal is used; only the smooth rho is differentiated."
      ],
      "statement": "Under the source normalized globally C2 Hessian bounds kappa^-1 I<=Hessian V<=I, kappa>=1, and positive measurable eta with measurable y, there exists a measurable unique stationary proximal point p. Let R be the actual quadratic reweighting of volume.tilted(-V), let r be its actual affine standardization about the same p, and gamma=stdGaussian E. Then r is a probability absolutely continuous with respect to gamma, canonical KL is finite, the true smooth residual-potential gradient is in L2(r), and KL(r||gamma).toReal<=half integral norm(gradient rho)^2 dr. E is finite complete real Hilbert/Borel, including rank0; no eta upper bound or caller coherence/density/domain/inequality certificate is assumed.",
      "formula": "D_{\\mathrm{KL}}(r\\Vert\\gamma)\\le\\frac12\\int\\|\\nabla\\rho(u)\\|^2\\,dr(u),\\quad r=(x\\mapsto\\eta^{-1/2}(x-p))_{\\#}\\mathrm{RGO}_{\\eta,y},\\quad\\gamma=\\mathrm{stdGaussian}(E).",
      "boundary": "Authored sufficient same-unique-prox canonical KL<=Fisher/2 leaf for the literal standardized RGO. Exact source normalized C2/Hessian assumptions; all positive eta, actual measurable-family extension incl rank0. Probability/AC/finite KL/scoreL2 and same witness are internally derived. Coherent32/33 actual rho/Z/q/f/r transported by uniqueness, true Gaussian functionLSI42 coefficient2 and actual32 energyquarter. No extra witness/coherence/density/law/desiredbound certificate. GaussianT2/W2/FIRST4.6/fullW12/sampling/both mains/error/work/expectedcost/main/live/PURIFIED remain separate. Actual focused3826 PASS; independent wholeproof/blind/source/exactcommit/shared admission pending.",
      "steps": [
        {
          "title": "Produce one unique proximal point",
          "text": "Use the actual relative-entropy producer to obtain a measurable stationary p and uniqueness; its actual posterior already has absolute continuity and finite canonical KL. Actual32 supplies the probability output used below in Step3. All are derived from the source V/Hessian/eta assumptions.",
          "formula": "p_s+\\eta_s\\nabla V(p_s)=y_s,\\quad z+\\eta_s\\nabla V(z)=y_s\\Longrightarrow z=p_s.",
          "lean": "standardized_rgo_unique_prox_and_finite_entropy"
        },
        {
          "title": "Reconcile the square-root-density witness",
          "text": "The actual square-root-density producer initially returns p prime. Apply uniqueness to its stationarity, prove equality of the two functions by funext, and rewrite the entire dependent output. Thus rho, Z, q, f and r all refer to the same actual p; no coherence premise is supplied.",
          "formula": "p'_s+\\eta_s\\nabla V(p'_s)=y_s\\Longrightarrow p'=p,\\quad(\\rho',Z',q',f',r')=(\\rho,Z,q,f,r).",
          "lean": "huniq; hstat'; funext; rw [hp] at hd"
        },
        {
          "title": "Retrieve the real density and analytic domains",
          "text": "The actual32 outputs give q=exp(-rho)/Z, raw f=exp(-rho/2)/sqrtZ, f²=q and mass1. They also give C2 f, actual fL2 and gradientL2 under gamma, and qlogqL1. No compact-support or limit certificate is required.",
          "formula": "q=Z^{-1}e^{-\\rho},\\quad f=Z^{-1/2}e^{-\\rho/2},\\quad f^2=q,\\quad\\int q\\,d\\gamma=1,\\quad f,\\nabla f\\in L^2(\\gamma),\\ q\\log q\\in L^1(\\gamma).",
          "lean": "standardized_rgo_sqrt_density_domain; hq; hmass; hfC; hf2; hg2; hqint"
        },
        {
          "title": "Apply the noncompact Gaussian function LSI",
          "text": "Apply the actual42 theorem to this raw f, deriving integrability of Phi(f²) from f²=q and qlogqL1. The result is homogeneous entropy with exact variance-one coefficient2, on the actual canonical Gaussian.",
          "formula": "\\int f^2\\log f^2\\,d\\gamma-\\left(\\int f^2\\,d\\gamma\\right)\\log\\left(\\int f^2\\,d\\gamma\\right)\\le2\\int\\|\\nabla f\\|^2\\,d\\gamma.",
          "lean": "gaussian_logSobolev_of_contDiff; hphi; hLSI"
        },
        {
          "title": "Identify the finite canonical KL",
          "text": "The actual33 entropy identity uses canonical klDiv, with actual probability, absolute continuity and finiteness. Substitute f²=q and mass1 into the homogeneous entropy; log1=0 removes its mass term. No pointwise derivative of a Radon–Nikodym version is taken.",
          "formula": "D_{\\mathrm{KL}}(r\\Vert\\gamma)=\\int q\\log q\\,d\\gamma=\\operatorname{Ent}_{\\gamma}(f^2).",
          "lean": "hKLq; hfin; hsq; hmass; Real.log_one"
        },
        {
          "title": "Retain the exact half coefficient",
          "text": "Use actual32 quarter-energy identity for the true smooth rho gradient under the same literal r. Substitution in the Gaussian coefficient2 yields exactly half, with the actual Fisher integral finite because gradient rho is L2(r).",
          "formula": "\\int\\|\\nabla f\\|^2\\,d\\gamma=\\frac14\\int\\|\\nabla\\rho\\|^2\\,dr\\quad\\Longrightarrow\\quad D_{\\mathrm{KL}}(r\\Vert\\gamma)\\le\\frac12\\int\\|\\nabla\\rho\\|^2\\,dr.",
          "lean": "he; hrho2; rw [he]; ring"
        },
        {
          "title": "Exercise actual posterior consumers",
          "text": "Tests specialize the actual volume tilt and affine posterior at eta2, at the positive unbounded family eta(s)=s²+1 with y(s)=s v, and at the zero-dimensional constant potential. The last case proves actual canonical KL.toReal=0 using the zero score and nonnegativity. Gaussian T2 and the W2 portion of FIRST4.6 remain separate.",
          "formula": "\\eta=2;\\quad\\eta(s)=s^2+1;\\quad\\dim E=0\\Longrightarrow D_{\\mathrm{KL}}(r\\Vert\\gamma)=0.",
          "lean": "actual_fixed_posterior; actual_variable_step_family; rank_zero_actual_canonical_kl"
        }
      ],
      "lean_statement": "Under the source normalized globally C2 Hessian bounds kappa^-1 I<=Hessian V<=I, kappa>=1, and positive measurable eta with measurable y, there exists a measurable unique stationary proximal point p. Let R be the actual quadratic reweighting of volume.tilted(-V), let r be its actual affine standardization about the same p, and gamma=stdGaussian E. Then r is a probability absolutely continuous with respect to gamma, canonical KL is finite, the true smooth residual-potential gradient is in L2(r), and KL(r||gamma).toReal<=half integral norm(gradient rho)^2 dr. E is finite complete real Hilbert/Borel, including rank0; no eta upper bound or caller coherence/density/domain/inequality certificate is assumed.",
      "lean_proof": "Produce one unique proximal point; Reconcile the square-root-density witness; Retrieve the real density and analytic domains; Apply the noncompact Gaussian function LSI; Identify the finite canonical KL; Retain the exact half coefficient; Exercise actual posterior consumers",
      "astis_dependencies": [
        "AutoSamplingTheory.ExampleCases.SmoothedPicardHMC.StandardizedRGOSqrtDensity.standardized_rgo_sqrt_density_domain",
        "AutoSamplingTheory.ExampleCases.SmoothedPicardHMC.StandardizedRGORelativeEntropy.standardized_rgo_unique_prox_and_finite_entropy",
        "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.GaussianLogSobolev.gaussian_logSobolev_of_contDiff"
      ],
      "mathlib_dependencies": [
        "Real.log_one"
      ]
    }
  ]
