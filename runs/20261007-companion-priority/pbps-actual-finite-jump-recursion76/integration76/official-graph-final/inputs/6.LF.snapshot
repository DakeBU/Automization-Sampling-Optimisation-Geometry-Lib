        "raw_sha256": "25e4320122a14ef2748339911b681985b0eed0ade7ecefa9524643cc39d6c71a",
        "mathtext": "$\\pi_{\\eta}^{X\\mid Y=y}(\\mathrm{d}x)\\propto e^{-V_{y}(x)}\\,\\mathrm{d}x\\,,\\hskip 20.00003ptV_{y}(x)\\coloneqq V(x)+\\frac{\\|x-y\\|^{2}}{2\\eta}\\,.$\n",
        "disposition": "NODE",
        "classification": "selected-source-node",
        "reason": "Conditional potential background; not a finite-recursion premise requiring a random draw.",
        "overlap_policy": "Nested paragraph/theorem/display records overlap intentionally; coverage is by source region, not a theorem-count metric.",
