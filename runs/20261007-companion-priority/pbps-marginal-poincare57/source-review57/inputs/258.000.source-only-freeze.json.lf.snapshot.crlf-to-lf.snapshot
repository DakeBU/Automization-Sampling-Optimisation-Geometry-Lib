      "lf_sha256": "6b69764cb5d20bc8d783965f2f89e919687bf7e9ae4ef5a040c3aae808a3cb7b",
      "source_text": "\\displaystyle\\mathsf{T}_{t}^{y,\\widetilde{w}}\\ell_{a,y}-\\ell_{a,y} \\displaystyle=\\int_{0}^{t}\\mathsf{T}_{s}^{y,\\widetilde{w}}(a^{\\top}p)\\,\\mathrm{d}s\\,,"
    },
    {
      "region_id": "byte-1167257-1169494",
      "anchor_container": "A3.SS2",
      "kind": "display-equation",
      "disposition": "EXCLUDED",
