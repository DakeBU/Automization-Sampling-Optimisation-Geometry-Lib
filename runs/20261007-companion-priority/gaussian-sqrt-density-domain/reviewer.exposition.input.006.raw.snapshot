        have hs := (sq_le_sq₀ (norm_nonneg _) (mul_nonneg L.2 (norm_nonneg u))).mpr (hg u)
        convert! hs using 1 &lt;;&gt; simp only [one_mul, mul_pow] &lt;;&gt; rfl)

omit [CompleteSpace E] in</code></pre>
