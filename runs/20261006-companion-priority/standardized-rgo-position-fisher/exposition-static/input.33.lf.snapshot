        },
        {
          "slot": "assumptions",
          "original": "C², genuine positive lower and finite upper Hessian bounds, and beta*eta<=1.",
          "reconstructed": "C² and genuine second Frechet derivative bounds retained, alpha,beta NNReal with alpha>0; only eta>0.",
