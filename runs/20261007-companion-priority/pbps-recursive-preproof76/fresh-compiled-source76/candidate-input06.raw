      ],
      "header_literal": "(hV : ContDiff ℝ 2 V)",
      "id": "hV",
      "source_items": [
        "S1.p1.m3"
      ],
      "statement": "V ∈ C² on the whole finite-dimensional real inner-product space"
    },
    {
      "header_RAW_range": [
        1047,
        1208
      ],
      "header_literal": "(hH : ∀ x v : E,\n      (α : ℝ) * ‖v‖ ^ 2 ≤ (fderiv ℝ (fderiv ℝ V) x v) v ∧\n      (fderiv ℝ (fderiv ℝ V) x v) v ≤ (β : ℝ) * ‖v‖ ^ 2)",
      "id": "hH",
      "source_items": [
        "S1.E1.m1"
      ],
      "statement": "For every x and v, α * ‖v‖² ≤ inner (Hess V x v) v and inner (Hess V x v) v ≤ β * ‖v‖²"
    },
    {
      "header_RAW_range": [
        1213,
