      ],
      "formula": "V∈C²(R^d), κ≥1, κ⁻¹I≼D²V≼I pointwise, β=1",
      "parents": [],
      "conclusion": "Genuine global potential assumptions.",
      "truth_boundary": "Retained source standing hypothesis; no supplied derived certificate."
    },
    {
      "id": "ETA-POSITIVE",
      "kind": "SourceParameter",
