  "title": "Actual compact finite-product Gaussian log-Sobolev inequality",
  "mode": "faithfulPaper",
  "source_anchor": "SPHMC arXiv2609.06906v1 FIRST4.6 omitted GaussianLSI background; SLT d0f506f0 TensorizedGLSI coordinate-square-sum source; authored compact C2 fullFin n original-slice sufficient route.",
  "target_statement": "theorem compact_gaussian_pi_logSobolev\n    (n : ℕ) (f : (Fin n → ℝ) → ℝ)\n    (hf : ContDiff ℝ 2 f) (hs : HasCompactSupport f) :\n    let γ : Measure (Fin n → ℝ) := Measure.pi (fun _ : Fin n => gaussianReal 0 1)\n    let D : Fin n → (Fin n → ℝ) → ℝ := fun i x => fderiv ℝ f x (Pi.single i 1)\n    Integrable (fun x => (f x)^2) γ ∧\n    Integrable (fun x => (f x)^2 * Real.log ((f x)^2)) γ ∧\n    (∀ i, Integrable (fun x => (D i x)^2) γ) ∧\n    Integrable (fun x => ∑ i, (D i x)^2) γ ∧\n    (∫ x, (f x)^2 * Real.log ((f x)^2) ∂γ) -\n      (∫ x, (f x)^2 ∂γ) * Real.log (∫ x, (f x)^2 ∂γ) ≤\n    2 * ∫ x, ∑ i, (D i x)^2 ∂γ\n",
