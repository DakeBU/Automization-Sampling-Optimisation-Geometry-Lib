      "id": "sphmc-full-range-proximal-gaussian-oracle",
      "library": "samplewiki-route",
      "chapter": "sphmc-01",
      "chapter_path": "example-cases/samplewiki/companions/smoothed-picard-hmc.html",
      "title": "Actual proximal Gaussian oracle with sharp centered concentration",
      "source": {
        "url": "https://arxiv.org/html/2609.06906v1#S4.Thmtheorem2",
        "edition": "arXiv:2609.06906v1",
        "anchor": "SPHMC arXiv2609.06906v1 S4.E3 centered Gaussian-gradient-output concentration with exact eta*norm(u)^2/2; S3.E2 actual evaluator/S2.E1/S4.Ex3 proximal; inherited S1.E1 genuine C2 Hessian and S3.SS1.p1.1 every eta>0.",
        "wording_status": "faithful paraphrase",
        "attribution": "Fan Chen, Sinho Chewi, Jianfeng Lu, Matthew S. Zhang; actual (3.2), (4.3)-(4.5), with internal domain/measurability construction."
      },
      "statement": "Produce a measurable exact proximal selector p satisfying p+eta*gradientV(p)=y, the quantitative quadratic minimum and uniqueness, and equal-eta nonexpansivity. The literal G(s,z)=gradientV(p_s+sqrt(eta_s)*z) is jointly measurable and has equal-eta input/noise Lipschitz constants 1 and sqrteta. Produce the genuine Markov law K_s=G(s,-)_#stdGaussian with vector first Bochner moment. For its own mean m_s, every a and signed t have an integrable exponential and integral <=exp(eta_s*t^2*norm(a)^2/2). This covers (3.2) and (4.3)-(4.5), without identifying K with the RGO posterior or HMC transition.",
      "assumptions": [
        "Source beta=1, alpha=kappa^-1, real kappa>=1; actual C2 V with kappa^-1*normv^2 <= D2V(x)[v,v] <= normv^2 for every x,v.",
        "Finite real complete Hilbert/Borel full space E, including dimension zero; arbitrary measurable parameter space S; actual measurable eta:S->R and y:S->E with eta(s)>0 for every s. These coordinate-free/parameter-space extensions are disclosed. Printed Lemma4.2 inherits eta>0 from Section3.1; the eta<=1 premise of neighboring Lemma4.1 is not consumed.",
        "No supplied proximal point, minimizer, measurable selector, gradient estimate, Lipschitz bound, probability kernel, mean or concentration certificate. Exact witnesses, first moments, signed Laplace domains and sharp coefficient are produced internally. The numerical proximal call cap eta<=1/(2 beta) remains a separate computational contract."
      ],
      "formulae": [
        {
          "label": "Actual proximal Gaussian oracle with sharp centered concentration",
          "tex": "F_s(x)=V(x)+\\|x-y_s\\|^2/(2\\eta_s),\\quad p_s+\\eta_s\\nabla V(p_s)=y_s,\\quad G(s,z)=\\nabla V(p_s+\\sqrt{\\eta_s}z),\\quad K_s=G(s,\\cdot)_\\#\\gamma,\\quad m_s=\\int w\\,dK_s,\\quad\\int e^{t\\langle a,w-m_s\\rangle}dK_s\\le e^{\\eta_st^2\\|a\\|^2/2}."
        }
      ],
      "obligations": [
        {
          "id": "sharp-gaussian",
          "label": "Exact sharp centered bound and genuine Gaussian domains"
        },
        {
          "id": "remaining-paper",
          "label": "Bias/transport/full algorithms/main/work remain open"
        }
      ],
      "bindings": [
        {
          "declaration": "AutoSamplingTheory.ExampleCases.SmoothedPicardHMC.FullRangeProximalGaussianOracle.full_range_proximal_gaussian_oracle",
