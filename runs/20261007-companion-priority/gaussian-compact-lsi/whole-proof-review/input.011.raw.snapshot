    {
      "id": "API-SQUARE",
      "kind": "API_PRIMITIVE",
      "formula": "CommRing: (a-b)²=(b-a)²",
      "classification": "PINNED_LOCAL_API",
      "anchors": [
        {
          "input_role": "local_square_sign",
          "start_line": 199,
          "end_line": 215,
          "literal_LF_sha256": "6b818dca9d10b9b7e5fb7aef9591db6403cdc3c37905c83e5d4c29ad08ce50c1",
          "literal": "section CommRing\nvariable [CommRing R]\n\nlemma sq_sub_sq (a b : R) : a ^ 2 - b ^ 2 = (a + b) * (a - b) := (Commute.all a b).sq_sub_sq\n\nalias pow_two_sub_pow_two := sq_sub_sq\n\nlemma sub_sq (a b : R) : (a - b) ^ 2 = a ^ 2 - 2 * a * b + b ^ 2 := by\n  rw [sub_eq_add_neg, add_sq, neg_sq, mul_neg, ← sub_eq_add_neg]\n\nalias sub_pow_two := sub_sq\n\nlemma sub_sq' (a b : R) : (a - b) ^ 2 = a ^ 2 + b ^ 2 - 2 * a * b := by\n  rw [sub_eq_add_neg, add_sq', neg_sq, mul_neg, ← sub_eq_add_neg]\n\nlemma sub_sq_comm (a b : R) : (a - b) ^ 2 = (b - a) ^ 2 := by\n  rw [sub_sq', mul_right_comm, add_comm, sub_sq']\n"
        }
      ]
    },
    {
      "id": "API-CONSTMUL",
      "kind": "API_PRIMITIVE",
      "formula": "Tendsto.const_mul: under SeparatelyContinuousMul, multiply actual limit by fixed scalar",
      "classification": "PINNED_LOCAL_API",
      "anchors": [
        {
          "input_role": "local_multiplication_limit",
          "start_line": 112,
          "end_line": 134,
          "literal_LF_sha256": "cbd9f23fec8202145bdde6b1ea67a94da5acae3b4db83962803a686a32d1fa39",
          "literal": "section\n\nvariable {M : Type*} [TopologicalSpace M] [Mul M]\n\n@[to_additive]\ninstance [ContinuousMul M] : SeparatelyContinuousMul M where\n  continuous_const_mul := continuous_const.mul continuous_id\n  continuous_mul_const := continuous_id.mul continuous_const\n\nvariable [SeparatelyContinuousMul M]\n\n@[to_additive (attr := continuity, fun_prop)]\ntheorem continuous_const_mul (m : M) : Continuous (m * ·) :=\n  SeparatelyContinuousMul.continuous_const_mul\n\n@[to_additive (attr := continuity, fun_prop)]\ntheorem continuous_mul_const (m : M) : Continuous (· * m) :=\n  SeparatelyContinuousMul.continuous_mul_const\n\n@[to_additive]\ntheorem Filter.Tendsto.const_mul {α : Type*} {f : α → M} {x : Filter α} {a : M}\n    (b : M) (hf : Tendsto f x (𝓝 a)) : Tendsto (b * f ·) x (𝓝 (b * a)) :=\n  continuous_const_mul b |>.tendsto _ |>.comp hf\n"
        }
      ]
    },
    {
      "id": "API-ORDER",
      "kind": "API_PRIMITIVE",
      "formula": "OrderClosedTopology/Preorder: two Tendsto and eventual<= on NeBot filter imply limit<=",
      "classification": "PINNED_LOCAL_API",
