    {
      "id": "case:ASTIS-SW-SETTING-NONLOGCONCAVE-FISHER-BEST-UPPER-EXACT-ULD-FORS",
      "kind": "frontier-case",
      "label": "Exact ULD / FORS",
      "status": "audited",
      "subtitle": "Smooth non-log-concave + Fisher accuracy · best upper",
      "summary": "FI ⁡ ≤ ε 2 \\operatorname{FI}\\le\\varepsilon^2 FI ≤ ε 2",
      "formula": "\\mathsf{FI}(\\widehat\\pi\\Vert\\pi)\\le\\varepsilon^2,\\qquad \\widetilde O\\!\\left(M(d^{1/3}+\\log(M/p))\\right),\\quad M=O\\!\\left(1+\\frac{\\beta\\mathsf{KL}_0}{\\varepsilon^2}\\right)",
      "theorem": "Theorem 6.2, using Theorem 6.1 and Theorem 3.2(ii)",
      "source_proof": "proof in Appendix F",
      "proof_equations": [
        {
          "formula": "U(0)+\\tfrac12\\|x\\|^2\\le U(x)\\le U(0)+\\tfrac32\\|x\\|^2",
          "meaning": "Quadratic sandwich for each strongly-log-concave RGO subproblem."
        },
        {
          "formula": "\\mathsf R_\\infty(\\nu_0\\Vert\\varpi\\otimes N(0,I))\\le\\tfrac d2\\log 3",
          "meaning": "Warm-start bound for the auxiliary ULD sampler."
        },
        {
          "formula": "\\mathsf R_3(\\widehat\\nu\\Vert\\varpi\\otimes N(0,I))\\le\\delta_{\\rm RGO}^2",
          "meaning": "Theorem 3.2(ii), q=3."
        },
        {
          "formula": "\\text{data processing}\\;\\Longrightarrow\\;\\mathtt{Alg}\\text{ satisfies Theorem 6.1's RGO assumption}",
          "meaning": "Project phase-space output to position."
        },
        {
          "formula": "M=O(1+\\beta\\mathsf{KL}_0/\\varepsilon^2)\\quad\\Longrightarrow\\quad \\widetilde O(M(d^{1/3}+\\log(M/p)))",
          "meaning": "Union bound and summation over the M approximate RGO calls."
        }
      ],
      "url": "example-cases/samplewiki/cases/setting-nonlogconcave-fisher-best-upper-exact-uld-fors.html",
      "source_url": "https://arxiv.org/html/2608.05022#S6.Thmtheorem2",
