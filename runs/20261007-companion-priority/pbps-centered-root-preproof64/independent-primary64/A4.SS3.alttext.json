[
  {
    "id": "A4.Thmtheorem4.p1.m1",
    "alttext": "\\mathsf{A},\\mathsf{B}"
  },
  {
    "id": "A4.Thmtheorem4.p1.m2",
    "alttext": "\\mathcal{H}"
  },
  {
    "id": "A4.Thmtheorem4.p1.m3",
    "alttext": "M\\geq m>0"
  },
  {
    "id": "A4.Thmtheorem4.p1.m4",
    "alttext": "0<mI\\preceq\\mathsf{B}\\preceq MI"
  },
  {
    "id": "A4.Thmtheorem4.p1.m5",
    "alttext": "v\\in\\mathcal{H}"
  },
  {
    "id": "A4.Thmtheorem4.p1.m6",
    "alttext": "\\|\\mathsf{A}v\\|^{2}\\leq\\|v\\|\\,\\|\\mathsf{B}v\\|"
  },
  {
    "id": "A4.Thmtheorem4.p1.m7",
    "alttext": "K\\coloneqq\\frac{M}{m}"
  },
  {
    "id": "A4.Ex2.m1",
    "alttext": "\\mathsf{A}^{2}\\preceq\\bigl(1+\\frac{\\log K}{\\pi}\\bigr)\\,\\mathsf{B}\\,."
  },
  {
    "id": "A4.Ex3.m1",
    "alttext": "\\mathsf{A}\\leftarrow m^{-1/2}\\mathsf{A}\\,,\\hskip 20.00003pt\\mathsf{B}\\leftarrow m^{-1}\\mathsf{B}\\,,"
  },
  {
    "id": "A4.SS3.p1.m1",
    "alttext": "I\\preceq\\mathsf{B}\\preceq KI"
  },
  {
    "id": "A4.SS3.p1.m2",
    "alttext": "v\\in\\mathcal{H}"
  },
  {
    "id": "A4.Ex4.m1",
    "alttext": "\\displaystyle\\langle v,\\mathsf{A}^{2}v\\rangle"
  },
  {
    "id": "A4.Ex4.m2",
    "alttext": "\\displaystyle=\\langle\\mathsf{B}^{1/2}v,\\mathsf{B}^{-1/2}\\mathsf{A}^{2}\\mathsf{B}^{-1/2}\\mathsf{B}^{1/2}v\\rangle\\leq\\|\\mathsf{B}^{-1/2}\\mathsf{A}^{2}\\mathsf{B}^{-1/2}\\|\\,\\langle v,\\mathsf{B}v\\rangle=\\|\\mathsf{A}\\mathsf{B}^{-1}\\mathsf{A}\\|\\,\\langle v,\\mathsf{B}v\\rangle\\,."
  },
  {
    "id": "A4.Ex5.m1",
    "alttext": "\\displaystyle\\|\\mathsf{A}\\mathsf{B}^{-1}\\mathsf{A}\\|"
  },
  {
    "id": "A4.Ex5.m2",
    "alttext": "\\displaystyle=\\Bigl\\lVert\\frac{2}{\\pi}\\int_{0}^{\\infty}\\mathsf{A}(t^{2}I+\\mathsf{B}^{2})^{-1}\\mathsf{A}\\,\\mathrm{d}t\\Bigr\\rVert\\leq\\frac{2}{\\pi}\\int_{0}^{\\infty}\\|\\mathsf{A}(t^{2}I+\\mathsf{B}^{2})^{-1}\\mathsf{A}\\|\\,\\mathrm{d}t\\,."
  },
  {
    "id": "A4.Ex6.m1",
    "alttext": "\\displaystyle\\|\\mathsf{A}(t^{2}I+\\mathsf{B}^{2})^{-1}\\mathsf{A}\\|"
  },
  {
    "id": "A4.Ex6.m2",
    "alttext": "\\displaystyle=\\|(t^{2}I+\\mathsf{B}^{2})^{-1/2}\\mathsf{A}^{2}(t^{2}I+\\mathsf{B}^{2})^{-1/2}\\|"
  },
  {
    "id": "A4.Ex7.m1",
    "alttext": "\\displaystyle=\\sup_{v\\in\\mathcal{H}\\setminus\\{0\\}}\\frac{\\|\\mathsf{A}(t^{2}I+\\mathsf{B}^{2})^{-1/2}v\\|^{2}}{\\|v\\|^{2}}=\\sup_{u\\in\\mathcal{H}\\setminus\\{0\\}}\\frac{\\|\\mathsf{A}u\\|^{2}}{t^{2}\\,\\|u\\|^{2}+\\|\\mathsf{B}u\\|^{2}}"
  },
  {
    "id": "A4.Ex8.m1",
    "alttext": "\\displaystyle\\leq\\sup_{u\\in\\mathcal{H}\\setminus\\{0\\}}\\frac{\\|u\\|\\,\\|\\mathsf{B}u\\|}{t^{2}\\,\\|u\\|^{2}+\\|\\mathsf{B}u\\|^{2}}\\,."
  },
  {
    "id": "A4.SS3.p1.m3",
    "alttext": "r\\coloneqq\\|\\mathsf{B}u\\|/\\|u\\|\\in[1,K]"
  },
  {
    "id": "A4.Ex9.m1",
    "alttext": "\\displaystyle\\|\\mathsf{A}(t^{2}I+\\mathsf{B}^{2})^{-1}\\mathsf{A}\\|"
  },
  {
    "id": "A4.Ex9.m2",
    "alttext": "\\displaystyle\\leq\\sup_{r\\in[1,K]}\\frac{r}{t^{2}+r^{2}}=\\begin{cases}1/(t^{2}+1)\\,,&t<1\\,,\\\\\n1/(2t)\\,,&t\\in[1,K]\\,,\\\\\nK/(t^{2}+K^{2})\\,,&t>K\\,.\\end{cases}"
  },
  {
    "id": "A4.Ex10.m1",
    "alttext": "\\displaystyle\\|\\mathsf{A}\\mathsf{B}^{-1}\\mathsf{A}\\|"
  },
  {
    "id": "A4.Ex10.m2",
    "alttext": "\\displaystyle\\leq\\frac{2}{\\pi}\\,\\Bigl(\\int_{0}^{1}\\frac{1}{t^{2}+1}\\,\\mathrm{d}t+\\int_{1}^{K}\\frac{1}{2t}\\,\\mathrm{d}t+\\int_{K}^{\\infty}\\frac{K}{t^{2}+K^{2}}\\,\\mathrm{d}t\\Bigr)=1+\\frac{\\log K}{\\pi}\\,."
  },
  {
    "id": "A4.SS3.p2.m1",
    "alttext": "K"
  },
  {
    "id": "A4.Thmtheorem5.p1.m1",
    "alttext": "K>1"
  },
  {
    "id": "A4.Thmtheorem5.p1.m2",
    "alttext": "\\mathcal{H}=L^{2}([1,K],\\mathrm{d}x)"
  },
  {
    "id": "A4.Thmtheorem5.p1.m3",
    "alttext": "\\mathsf{A}f(x)\\coloneqq(\\pi\\,(K-1))^{-1/2}\\int_{1}^{K}f(y)\\,\\mathrm{d}y"
  },
  {
    "id": "A4.Thmtheorem5.p1.m4",
    "alttext": "\\mathsf{B}f(x)\\coloneqq xf(x)"
  },
  {
    "id": "A4.Ex11.m1",
    "alttext": "\\|\\mathsf{A}f\\|^{2}=\\frac{1}{\\pi}\\,\\Bigl(\\int_{1}^{K}f(y)\\,\\mathrm{d}y\\Bigr)^{2}\\leq\\|f\\|\\,\\|\\mathsf{B}f\\|\\,."
  },
  {
    "id": "A4.Thmtheorem5.p1.m5",
    "alttext": "f(x)\\coloneqq 1/x"
  },
  {
    "id": "A4.Thmtheorem5.p1.m6",
    "alttext": "\\|\\mathsf{A}f\\|^{2}=(\\log K)^{2}/\\pi"
  },
  {
    "id": "A4.Thmtheorem5.p1.m7",
    "alttext": "\\langle f,\\mathsf{B}f\\rangle=\\log K"
  },
  {
    "id": "A4.Thmtheorem5.p1.m8",
    "alttext": "\\max\\{1,(\\log K)/\\pi\\}"
  },
  {
    "id": "A4.Thmtheorem5.p1.m9",
    "alttext": "1"
  },
  {
    "id": "A4.Thmtheorem5.p1.m10",
    "alttext": "\\mathsf{A}=\\mathsf{B}=I"
  }
]
