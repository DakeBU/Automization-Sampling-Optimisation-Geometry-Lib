{
  "schema_version": 1,
  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.Measure.L2RealSquareRoot.exists_positive_real_square_root",
      "title": "Positive real L² operator: genuine square root and energy",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06905v1#A4",
          "label": "Appendix D.1 positive real square-root background; B.10-B.11 scalar defect energy precursor. ASTIS background completion, not printed joint GammaP.",
          "scope": "REAL scalar positive root and scalar energy only. Generic real uniqueness, canonical joint GammaP / P U blocks / onto transport / typed B*B, centered root order/inverse/polar, weakH1,dynamics,hypocoercivity,main,error,cost,composition remain separate; paper/Goal open."
        }
      ],
      "tests": [
        "lake build Tests.ProximalBPSRealDefectRoot"
      ],
      "assumptions": [
        "Let Ω be an arbitrary measurable space and μ any measure. Let D be a bounded positive real-linear operator on L²(μ;ℝ); positivity includes selfadjointness. There exists a bounded positive REAL operator Γ with Γ²=D, and for EVERY real L² class u, ‖Γu‖²=⟨Du,u⟩ℝ. No CFC instance, complex extension, root, finite/probability measure or finite-dimensional L² is a hypothesis.",
        "No finite/probability measure, finite-dimensional L², nontriviality, CFC/root or conjugation-preservation input.",
        "Pointwise conjugation is antiunitary on complex L² and differs from operator adjoint; its root-preservation and the descent are proved internally."
      ],
      "statement": "Let Ω be an arbitrary measurable space and μ any measure. Let D be a bounded positive real-linear operator on L²(μ;ℝ); positivity includes selfadjointness. There exists a bounded positive REAL operator Γ with Γ²=D, and for EVERY real L² class u, ‖Γu‖²=⟨Du,u⟩ℝ. No CFC instance, complex extension, root, finite/probability measure or finite-dimensional L² is a hypothesis.",
      "formula": "\\Gamma\\ge0,\\quad\\Gamma^2=D,\\quad\\forall u\\in L^2(\\mu;\\mathbb R),\\ \\|\\Gamma u\\|^2=\\langle Du,u\\rangle_{\\mathbb R}.",
      "boundary": "REAL scalar positive root and scalar energy only. Generic real uniqueness, canonical joint GammaP / P U blocks / onto transport / typed B*B, centered root order/inverse/polar, weakH1,dynamics,hypocoercivity,main,error,cost,composition remain separate; paper/Goal open.",
      "steps": [
        {
          "title": "Reuse the genuine positive complex lift",
          "text": "The compiled canonical complexification theorem constructs ι, the real-part map R, pointwise conjugation C and positive complex-linear Dc from D. It proves Fix(C)=ran(ι) and Dcι=ιD internally. All maps act on actual AE classes for the same arbitrary measure.",
          "formula": "D_{\\mathbb C}\\ge0,\\quad D_{\\mathbb C}\\iota=\\iota D,\\quad\\operatorname{Fix}(C)=\\operatorname{ran}(\\iota).",
          "lean": "L2RealComplexOperator.exists_positive_complex_lift; hfixed; hintertwine"
        },
        {
          "title": "Establish the antiunitary quotient identities",
          "text": "Pointwise scalar conjugation lifted by compLpL satisfies C²=I, C(cg)=conj(c)Cg and ⟨Cg,Ch⟩ℂ=conj(⟨g,h⟩ℂ). The AE formulas and conjugation of the Bochner integral establish these identities without choosing additional representatives. Also Rι=I and the embedding preserves the integral inner product.",
          "formula": "C^2=I,\\quad C(cg)=\\overline c\\,Cg,\\quad\\langle Cg,Ch\\rangle_{\\mathbb C}=\\overline{\\langle g,h\\rangle_{\\mathbb C}},\\quad R\\iota=I.",
          "lean": "conjugate_involutive; conjugate_smul; inner_conjugate; real_embed; inner_embed"
        },
        {
          "title": "Construct the complex positive square root internally",
          "text": "On the complex L² operator algebra the pinned Mathlib supplies complex CFC, and its restricted-real selfadjoint CFC is explicitly target-typed inside the proof. Thus Rc=sqrt(Dc) is positive and Rc²=Dc. This derives the needed instance rather than adding a real functional-calculus premise to the theorem.",
          "formula": "R_{\\mathbb C}=\\sqrt{D_{\\mathbb C}}\\ge0,\\quad R_{\\mathbb C}^2=D_{\\mathbb C}.",
          "lean": "hRcNonneg; hRc; hRcSq; CFC.sqrt_nonneg; CFC.sqrt_mul_sqrt_self"
        },
        {
          "title": "Prove root preservation by positive-root uniqueness",
          "text": "K=CRcC is bounded and complex-linear because conjugation reverses complex scalars twice. Its quadratic form is the conjugate of the nonnegative real quadratic form of Rc at Cg, so K is positive. C²=I and CDc=DcC give K²=Dc. Uniqueness of the complex positive square root gives K=Rc, hence CRc=RcC. This is pointwise conjugation, never operator adjoint.",
          "formula": "K=CR_{\\mathbb C}C\\ge0,\\quad K^2=D_{\\mathbb C},\\quad K=R_{\\mathbb C},\\quad CR_{\\mathbb C}=R_{\\mathbb C}C.",
          "lean": "conjugateOperator; conjugateOperator_positive; hKSq; hK; CFC.sqrt_unique; hrootConj"
        },
        {
          "title": "Descend to the full real L² space",
          "text": "Define the bounded real map Γ=R Rc ι. Since Rc preserves Fix(C), its value Rcιu lies in the full image of ι. The identity Rι=I then gives ιΓu=Rcιu. Applying this twice and using Dcι=ιD proves Γ²=D, with embedding injectivity. Real uniqueness and the centered restriction are separate statements.",
          "formula": "\\Gamma=RR_{\\mathbb C}\\iota,\\quad\\iota\\Gamma=R_{\\mathbb C}\\iota,\\quad\\Gamma^2=D.",
          "lean": "Γ; hbridge; hinj; hΓSq"
        },
        {
          "title": "Transport positivity and derive the energy identity",
          "text": "The embedding preserves inner products. Therefore complex selfadjointness and positivity of Rc imply real selfadjointness and positivity of Γ. Its symmetry and exact square now yield ‖Γu‖²=⟨Γu,Γu⟩ℝ=⟨Γ²u,u⟩ℝ=⟨Du,u⟩ℝ for every u. No invertibility or strict positive lower bound follows on the full space.",
          "formula": "\\Gamma\\ge0,\\quad\\|\\Gamma u\\|^2=\\langle\\Gamma^2u,u\\rangle_{\\mathbb R}=\\langle Du,u\\rangle_{\\mathbb R}.",
          "lean": "inner_embed; hΓ; hΓSq; real_inner_self_eq_norm_sq"
        }
      ],
      "lean_statement": "Let Ω be an arbitrary measurable space and μ any measure. Let D be a bounded positive real-linear operator on L²(μ;ℝ); positivity includes selfadjointness. There exists a bounded positive REAL operator Γ with Γ²=D, and for EVERY real L² class u, ‖Γu‖²=⟨Du,u⟩ℝ. No CFC instance, complex extension, root, finite/probability measure or finite-dimensional L² is a hypothesis.",
      "lean_proof": "Reuse the genuine positive complex lift; Establish the antiunitary quotient identities; Construct the complex positive square root internally; Prove root preservation by positive-root uniqueness; Descend to the full real L² space; Transport positivity and derive the energy identity",
      "astis_dependencies": [
        "AutoSamplingTheory.TechnicalLemmas.Measure.L2RealComplexOperator.exists_positive_complex_lift"
      ],
      "mathlib_dependencies": [
        "ContinuousLinearMap.compLpL",
        "ContinuousLinearMap.coeFn_compLpL",
        "Lp.ext",
        "L2.inner_def",
        "Complex.conjCLE.integral_comp_comm",
        "ContinuousLinearMap.isPositive_iff_complex",
        "ContinuousLinearMap.nonneg_iff_isPositive",
        "CFC.sqrt_nonneg",
        "CFC.sqrt_mul_sqrt_self",
        "CFC.sqrt_unique",
        "RCLike.re_to_complex",
        "real_inner_self_eq_norm_sq"
      ]
    }
  ]
}
