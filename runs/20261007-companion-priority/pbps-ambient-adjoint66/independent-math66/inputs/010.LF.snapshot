{
  "schema_version": 1,
  "status": "dependency plan only; no Lean completion is inferred",
  "companion_extension": {
    "metadata": "website/content/samplewiki_companion_frontiers.json",
    "proof_deltas": "website/content/samplewiki_proof_deltas.json",
    "status": "user-prioritized mathematical route; proof status remains evidence-driven",
    "reuse_first": ["sf-kernel-composition", "sf-measure-map-integral", "sf-convex-energy", "sf-euclidean-linear-algebra"],
    "rule": "Apply website/content/samplewiki_companion_frontiers.json execution first. Pull forward only needed paper dependencies; recommended_wave_order remains a reference, not a requirement to finish every textbook. Preserve older cell states. Analytic PDMP and discrete hypocoercivity consumers stay separate."
  },
  "goal": "Schedule the beginning of the textbook libraries, including finite-state Discrete Sampling by mathematical dependency rather than cover-to-cover order, so genuinely identical lower-level Lean lemmas are proved once and reused with explicit adapters.",
  "scope": [
    "Log-Concave Sampling Chapters 1-2",
    "Lectures on Optimization Chapters 1-2, with Chapter 9 duality pulled forward when OT Chapter 1 needs it",
    "Boumal Chapters 1-3 minimal first-order geometry, because Sampling Chapter 2.5 depends on it",
    "Statistical Optimal Transport Chapters 1-2",
    "Discrete Sampling §§1.1-1.3, §3 pulled forward, §2/§4.1 pinnings; §12.1 model definitions",
    "MCMC §§1.3,2.1 early; §1.4 diffusion, §1.5 RKHS and estimation as separate dependency branches"
  ],
  "policies": {
    "dependency_over_book_order": "A later source chapter may be mined early for one shared prerequisite when another textbook needs it. This never marks that later chapter complete.",
    "exact_match": "One source-neutral canonical Lean declaration, then source-facing wrappers if needed.",
    "near_match": "Factor only the mathematically identical core; keep norm, measure, manifold, extended-value, or convention adapters explicit.",
    "false_friend": "Do not merge results merely because they use the words convexity, gradient, geodesic, flow, entropy, or Wasserstein.",
    "ownership": "Shared foundations live in TechnicalLemmas or an audited Mathlib/upstream dependency, never inside a route-specific theorem file.",
    "chapter_status": "Reusing or pulling forward a prerequisite does not advance the source chapter status except for the exact source-facing theorem that was audited."
  },
  "textbook_windows": [
    {
      "id": "log-concave-sampling",
      "role": "canonical textbook spine, distinct from SampleWiki frontier work",
      "anchors": [
        "Chapter 1 §§1.1-1.5: stochastic calculus, semigroups, OT geometry, Wasserstein gradient flow",
        "Chapter 2 §§2.1-2.6: functional inequalities, convexity, concentration, manifolds"
      ]
    },
    {
      "id": "optimisation",
      "role": "principal producer of Euclidean convex/flow foundations",
      "anchors": [
        "Chapter 1: Introduction and basics of convex functions",
        "Chapter 2: Gradient flow",
        "Chapter 9: Fenchel duality, pulled forward only for the shared duality core"
      ]
    },
    {
      "id": "riemannian-optimization",
      "role": "principal producer of manifold first-order adapters",
      "anchors": [
        "Boumal Chapters 1-2: optimization problems and examples",
        "Boumal Chapter 3: Embedded geometry, first order; pulled forward as needed by Sampling §2.5"
      ]
    },
    {
      "id": "statistical-optimal-transport",
      "role": "principal producer of coupling/Wasserstein foundations and early statistical consumers",
      "anchors": [
        "Chapter 1 §§1.1-1.6: transport, Wasserstein, one-dimensional transport, Brenier, duality",
        "Chapter 2 §§2.1-2.8: empirical convergence, chaining, regularization"
      ]
    },
    {
      "id": "discrete-sampling",
      "role": "finite-state kernels and Dirichlet/entropy adapter producer; no SDE prerequisites",
      "anchors": [
        "arXiv:2307.13826v4 §§1.1-1.3 and §3",
        "§§2,4.1 influence matrices and pinnings",
        "§6.8 entropy; §12.1 Ising (external proofs required)"
      ]
    },
    {
      "id": "mcmc",
      "role": "method-family source spine; not all sampling problems",
      "anchors": [
        "Fearnhead et al. arXiv:2407.12751v1 §§1.3,2.1",
        "Roberts–Rosenthal math/0404033v4 §§2–5"
      ]
    }
  ],
  "nodes": [
    {
      "id": "sf-euclidean-linear-algebra",
      "title": "Euclidean, inner-product and matrix floor",
      "parents": [],
      "consumers": [
        "log-concave-sampling",
        "optimisation",
        "riemannian-optimization",
        "statistical-optimal-transport",
        "discrete-sampling",
        "mcmc"
      ],
      "source_anchors": [
        "Optimization Ch.1 + App.A",
        "Boumal Chs.1-2",
        "Sampling Chs.1-2",
        "OT Ch.1 quadratic-cost examples"
      ],
      "target": "Coordinates, norms, inner products, symmetric/PSD matrix facts and quadratic energies with conventions fixed once.",
      "search": [
        "Mathlib inner-product/matrix APIs",
        "TechnicalLemmas/Geometry/EuclideanSpaceCoordinates.lean"
      ],
      "boundary": "Do not package manifold tangent geometry into this node."
    },
    {
      "id": "sf-measure-map-integral",
      "title": "Measures, integration, maps and finite-moment floor",
      "parents": [],
      "consumers": [
        "log-concave-sampling",
        "statistical-optimal-transport",
        "discrete-sampling",
        "mcmc"
      ],
      "source_anchors": [
        "Sampling §§1.2-1.4",
        "OT §§1.1-1.3 and Ch.2"
      ],
      "target": "Probability normalization, map/pushforward, product measures, marginals, integrability and moment bookkeeping.",
      "search": [
        "Mathlib MeasureTheory",
        "TechnicalLemmas/Measure",
        "TechnicalLemmas/Analysis/BoundedQuadraticCostIntegrability.lean"
      ],
      "boundary": "Markov kernels and couplings get their own layers; a measurable map is not a stochastic kernel."
    },
    {
      "id": "sf-scalar-decay",
      "title": "Shared scalar decay/recurrence core",
      "parents": [],
      "consumers": [
        "discrete-sampling",
        "log-concave-sampling",
        "mcmc"
      ],
      "source_anchors": [
        "Discrete Sampling §§1-3,4.1,6.8",
        "Sampling Chapter 2"
      ],
      "target": "One scalar Gronwall/geometric-recurrence core. Consumers supply their own energy derivative; strong convexity is not a prerequisite.",
      "search": [
        "Samplinglib TechnicalLemmas",
        "Mathlib PMF, Kernel, Matrix, covariance",
        "Mathlib scalar comparison APIs"
      ],
      "boundary": "Planned reuse interface, not a compiled theorem or an automatic conceptual transport."
    },
    {
      "id": "sf-calculus-gradient",
      "title": "Differential, gradient, chain-rule and Hessian floor",
      "parents": [
        "sf-euclidean-linear-algebra"
      ],
      "consumers": [
        "log-concave-sampling",
        "optimisation",
        "riemannian-optimization",
        "statistical-optimal-transport",
        "mcmc"
      ],
      "source_anchors": [
        "Sampling §1.1",
        "Optimization Chs.1-2",
        "Boumal Ch.3",
        "OT §1.4 Brenier maps"
      ],
      "target": "Source-neutral Fréchet derivative/gradient/chain-rule interfaces; Hessian inequalities retain their exact ambient spaces.",
      "search": [
        "Mathlib calculus",
        "TechnicalLemmas/Analysis/Calculus",
        "TechnicalLemmas/Analysis/Calculus/Taylor.lean"
      ],
      "boundary": "Riemannian gradients are adapters through a metric, not aliases for Euclidean gradients."
    },
    {
      "id": "sf-convex-energy",
      "title": "Convexity, strong convexity, subgradients and log-concavity",
      "parents": [
        "sf-euclidean-linear-algebra"
      ],
      "consumers": [
        "log-concave-sampling",
        "optimisation",
        "statistical-optimal-transport",
        "riemannian-optimization"
      ],
      "source_anchors": [
        "Optimization Ch.1",
        "Sampling Ch.2",
        "OT §§1.4-1.5",
        "Boumal Euclidean/local models"
      ],
      "target": "One canonical Euclidean convex core: convexity inequalities, strong convexity, subgradients and quadratic-growth consequences; log-concavity is an explicit density/potential adapter.",
      "search": [
        "TechnicalLemmas/Analysis/ConvexSubgradient.lean",
        "TechnicalLemmas/Geometry/StrongConvexity.lean",
        "TechnicalLemmas/Geometry/LogConcavity.lean",
