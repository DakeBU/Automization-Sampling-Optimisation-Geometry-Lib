      "chapter_path": "example-cases/samplewiki/companions/smoothed-picard-hmc.html",
      "title": "Sharp standard Gaussian concentration for every Lipschitz observable",
      "source": {
        "url": "https://arxiv.org/html/2609.06906v1#S4.E3",
        "edition": "arXiv:2609.06906v1 with pinned Mathlib db584cd6 Gaussian background",
        "anchor": "SPHMC arXiv2609.06906v1 S4.E3 centered Gaussian-gradient-output concentration with exact eta*norm(u)^2/2; S3.E2 actual evaluator/S2.E1/S4.Ex3 proximal; inherited S1.E1 genuine C2 Hessian and S3.SS1.p1.1 every eta>0.",
        "wording_status": "faithful paraphrase",
        "attribution": "ASTIS authored Gaussian rotation/Stein/Herbst and internal approximation background, consumed by SPHMC (4.3)."
      },
      "statement": "For every globally L-Lipschitz scalar observable on the stated finite real Hilbert/Borel space, its actual standard Gaussian centered exponential integral is at most exp(L^2*t^2/2) for every signed real t. Actual first moments and all exponential domains are produced by the existing shared domain theorem; the C1 restriction used inside the proof is removed internally.",
      "assumptions": [
        "Finite-dimensional complete real Hilbert space E with its actual inner product and Borel measurable structure, including dimension zero; gamma is the canonical covariance-identity standard Gaussian.",
        "Actual globally L-Lipschitz f:E->R with NNReal L>=0 including zero; every signed t in R. No differentiability, boundedness, given mean, positive dimension or concentration/LSI/domain certificate."
      ],
      "formulae": [
        {
          "label": "Sharp standard Gaussian concentration for every Lipschitz observable",
          "tex": "\\gamma=\\operatorname{stdGaussian}(E),\\quad m=\\int f\\,d\\gamma,\\quad\\int e^{t(f-m)}\\,d\\gamma\\le e^{L^2t^2/2}\\quad(t\\in\\mathbb R)."
        }
      ],
      "obligations": [
        {
          "id": "sharp-gaussian",
          "label": "Exact sharp centered bound and genuine Gaussian domains"
        },
        {
          "id": "remaining-paper",
          "label": "Bias/transport/full algorithms/main/work remain open"
        }
      ],
      "bindings": [
        {
          "declaration": "AutoSamplingTheory.TechnicalLemmas.Probability.GaussianLipschitzExponential.integral_exp_centered_le_stdGaussian_of_lipschitz",
          "cell": "ASTIS-SHARED-gaussian-sharp-concentration",
          "role": "proof-edge",
          "supports": [
            "sharp-gaussian"
          ],
          "audit_id": "ASTIS-RT-20261007-GaussianSharpConcentration",
          "boundary": "Locally compiled sharp centered Gaussian-output estimate (4.3), retained exact positive-step proximal/evaluator and (4.4)-(4.5), genuine first Bochner moments and all signed exponential domains. Independent mathematics/blind/source/publication/exact-commit/integration admission pending. Bias (4.2), first W2 inequality in (4.6), LSI/T2 adapter, full Lemma4.2, higher smoothing/Picard/Wp/proxy-warmness/initialization, PBPS invariance/nonexplosion/hypocoercivity/implementation/work, both main results and actual-input precision/expected-query-cost composition remain open. Centers are actual Gaussian output means. TV proximity does not transfer unbounded expected cost.",
