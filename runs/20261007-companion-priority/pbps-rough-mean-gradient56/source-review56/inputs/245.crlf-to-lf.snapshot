              <span id="alg2.l12.3" class="ltx_text ltx_font_bold">if</span> <math id="alg2.l12.m1" class="ltx_Math" alttext="B_{k}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>k</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">B_{k}=1</annotation></semantics></math> <span id="alg2.l12.4" class="ltx_text ltx_font_bold">then</span>

