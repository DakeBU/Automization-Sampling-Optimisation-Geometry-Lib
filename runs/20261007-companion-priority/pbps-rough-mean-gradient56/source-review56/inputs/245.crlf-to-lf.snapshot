            <span id="alg2.l2.3" class="ltx_text ltx_font_bold">for</span> <math id="alg2.l2.m1" class="ltx_Math" alttext="k=0,\ldots,T-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">k=0,\ldots,T-1</annotation></semantics></math> <span id="alg2.l2.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
              <math id="alg2.l3.m1" class="ltx_Math" alttext="Y_{k+1}\leftarrow 2X_{k}-Y_{k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Y</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>X</mi><mi>k</mi></msub></mrow><mo>−</mo><msub><mi>Y</mi><mi>k</mi></msub></mrow></mrow><annotation encoding="application/x-tex">Y_{k+1}\leftarrow 2X_{k}-Y_{k}</annotation></semantics></math>

</div>
<div id="alg2.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
              Draw <math id="alg2.l4.m1" class="ltx_Math" alttext="B_{k}\sim\operatorname{Bernoulli}(\rho)" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>k</mi></msub><mo>∼</mo><mrow><mi>Bernoulli</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">B_{k}\sim\operatorname{Bernoulli}(\rho)</annotation></semantics></math>

</div>
<div id="alg2.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
              <span id="alg2.l5.3" class="ltx_text ltx_font_bold">if</span> <math id="alg2.l5.m1" class="ltx_Math" alttext="B_{k}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>k</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">B_{k}=1</annotation></semantics></math> <span id="alg2.l5.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg2.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
               Draw
<math id="alg2.l6.m1" class="ltx_Math" alttext="X_{k+1}\sim\pi_{\eta}^{X\mid Y=Y_{k+1}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∼</mo><msubsup><mi>π</mi><mi>η</mi><mrow><mi>X</mi><mo fence="false">|</mo><mrow><mi>Y</mi><mo>=</mo><msub><mi>Y</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow></msubsup></mrow><annotation encoding="application/x-tex">X_{k+1}\sim\pi_{\eta}^{X\mid Y=Y_{k+1}}</annotation></semantics></math> exactly

</div>
<div id="alg2.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
              <span id="alg2.l7.3" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="alg2.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
               <math id="alg2.l8.m1" class="ltx_Math" alttext="X_{k+1}\leftarrow\textsc{IdealHalfTurn}(X_{k},Y_{k+1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">IdealHalfTurn</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>X</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Y</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{k+1}\leftarrow\textsc{IdealHalfTurn}(X_{k},Y_{k+1})</annotation></semantics></math>
using <a href="#alg1" title="In 3.2 The ideal conditional half-turn process ‣ 3 The Proximal Bouncy Particle Sampler ‣ Accelerated High-Accuracy Sampling from a Warm Startvia the Proximal Bouncy Particle Sampler" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithm</span> <span class="ltx_text ltx_ref_tag">1</span></a>

</div>
