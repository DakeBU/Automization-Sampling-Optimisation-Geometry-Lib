  "exact_statement_seals": [
    {
      "declaration": "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.TwoPointEntropy.two_point_squared_entropy_le_half_sq_sub",
      "file": "two-point.signature.txt",
      "theorem_name": "two_point_squared_entropy_le_half_sq_sub",
      "signature_raw_sha256": "f5aaccdf8098ba9f8036913c5844238a211f9d421606ab1337b3e802d3bb0c34",
      "signature_lf_sha256": "c8c2aed496047dd170f5b06e5d70987acdf8510b8b7a41f1f894c19fecc1d597",
      "normalized_proposition_sha256": "48ea156063d87130e15b924cafbc3cbcfc59337253062b5980400636c6dbd10d",
      "probe_exact_whitespace_normalized_match": true,
      "signature_text": "theorem two_point_squared_entropy_le_half_sq_sub (a b : ℝ) :\n    (a ^ 2 * Real.log (a ^ 2) + b ^ 2 * Real.log (b ^ 2)) / 2 -\n      ((a ^ 2 + b ^ 2) / 2) * Real.log ((a ^ 2 + b ^ 2) / 2) ≤\n    (a - b) ^ 2 / 2\n",
      "source_stratum": "CanonicalLibraryNode: genuine finite-function entropy LSI background, not printed SPHMC source theorem",
      "exact_type_status": "body-free two-Prop probe exit0, no mathematical proof"
    },
    {
      "declaration": "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.BernoulliLogSobolev.bernoulli_function_logSobolev",
      "file": "bernoulli.signature.txt",
      "theorem_name": "bernoulli_function_logSobolev",
      "signature_raw_sha256": "99811e95b98193f7a26106db2082af30c23d4d4bc11e10b9546da09b866d494a",
      "signature_lf_sha256": "23f48bd92530e7aa11507bf287b6e9969cba918bc397022b9b17386d8fbea665",
      "normalized_proposition_sha256": "233a466561af8e3d206c9bc3703b759ca73f64b457569ef70f0c11600fb49214",
      "probe_exact_whitespace_normalized_match": true,
      "signature_text": "theorem bernoulli_function_logSobolev (n : ℕ) (h : (Fin n → Bool) → ℝ) :\n    let μ : Measure (Fin n → Bool) :=\n      (Fintype.card (Fin n → Bool) : ℝ≥0∞)⁻¹ • Measure.count\n    let D := fun ε : Fin n → Bool =>\n      ∑ j : Fin n, (h ε - h (Function.update ε j (!ε j))) ^ 2\n    IsProbabilityMeasure μ ∧\n      Integrable (fun ε => (h ε) ^ 2) μ ∧\n      Integrable (fun ε => (h ε) ^ 2 * Real.log ((h ε) ^ 2)) μ ∧\n      Integrable D μ ∧\n      ((∫ ε, (h ε) ^ 2 * Real.log ((h ε) ^ 2) ∂μ) -\n        (∫ ε, (h ε) ^ 2 ∂μ) * Real.log (∫ ε, (h ε) ^ 2 ∂μ) ≤\n      (1 / 2 : ℝ) * ∫ ε, D ε ∂μ)\n",
      "source_stratum": "CanonicalLibraryNode: genuine finite-function entropy LSI background, not printed SPHMC source theorem",
      "exact_type_status": "body-free two-Prop probe exit0, no mathematical proof"
    }
  ],
