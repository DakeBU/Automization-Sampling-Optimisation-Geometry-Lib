      "formula_tex": "\\mathsf{K}=\\mathsf{U}\\bigl[\\rho\\mathsf{P}+(1-\\rho)\\mathsf{H}\\bigr]=\\mathsf{U}\\bigl[\\mathsf{P}+(1-\\rho)\\mathsf{H}_{\\perp\\perp}\\bigr]\\,."
