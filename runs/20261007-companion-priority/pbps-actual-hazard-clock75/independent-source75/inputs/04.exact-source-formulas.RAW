      ],
      "RAW_sha256": "4a201d14e435f57ab9c9aeb0af9e92471f06a808b87069f37186e98c956c5bae",
      "credit": "Exact source formula only; not a proved Lean clause",
      "id": "S1.E1.m1",
      "literal_source_alttext": "\\alpha I\\preceq\\nabla^{2}V(x)\\preceq\\beta I\\,,\\hskip 20.00003ptx\\in\\mathbb{R}^{d}\\,,\\hskip 20.00003pt\\kappa\\coloneqq\\tfrac{\\beta}{\\alpha}\\,.",
      "source_URL": "https://arxiv.org/html/2609.06905v1#S1.E1.m1"
    },
    {
