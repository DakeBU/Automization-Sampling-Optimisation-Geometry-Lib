  "lean": {
    "statement": "∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E]\n  [inst_3 : MeasurableSpace E] [BorelSpace E] (f : E → ℝ),\n  Differentiable ℝ f →\n    ∀ (eta beta ell eps : ℝ),\n      0 < eta →\n        ∀ (hb : 0 < beta),\n          2 ≤ ell →\n            0 < eps →\n              eps ≤ 1 / 2 →\n                0 < ↑(Module.finrank ℝ E) →\n                  LipschitzWith ⟨beta, LT.lt.le hb⟩ (gradient f) →\n                    ∀ (x0 xp : E),\n                      ‖x0 - eta • gradient f xp - xp‖ ≤ √(↑(Module.finrank ℝ E) * eta) →\n                        64 * beta *\n                              (√(↑(Module.finrank ℝ E) * (ell + Real.log (1 / eps))) + (ell + Real.log (1 / eps))) ≤\n                            1 / eta →\n                          have g := gradient f xp;\n                          have h := x0 - eta • g;\n                          have P := MeasureTheory.Measure.map (fun z => √eta • z) (ProbabilityTheory.stdGaussian E);\n                          have nu := (MeasureTheory.MeasureSpace.volume.restrict (Set.Ioc 0 1)).prod P;\n                          have q := MeasureTheory.Measure.map (fun z => h + √eta • z) (ProbabilityTheory.stdGaussian E);\n                          have W := fun p =>\n                            Min.min 1\n                              (Max.max (-1)\n                                (Inner.inner ℝ\n                                  ((Real.pi / 2) •\n                                    (Real.cos (Real.pi / 2 * p.2.1) • (p.1 - h) -\n                                      Real.sin (Real.pi / 2 * p.2.1) • p.2.2))\n                                  (g -\n                                    gradient f\n                                      (h + Real.sin (Real.pi / 2 * p.2.1) • (p.1 - h) +\n                                        Real.cos (Real.pi / 2 * p.2.1) • p.2.2))));\n                          have m := fun x => ∫ (z : ℝ × E), W (x, z) ∂nu;\n                          have rho :=\n                            MeasureTheory.Measure.infinitePi fun x =>\n                              q.prod\n                                ((ProbabilityTheory.poissonMeasure\n                                      ⟨2 * 1,\n                                        le_of_lt\n                                          (mul_pos\n                                            (Mathlib.Meta.Positivity.pos_of_isNat\n                                              (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 2)) (Eq.refl (Nat.ble 1 2)))\n                                            (Mathlib.Meta.NormNum.isNat_lt_true\n                                              (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_zero)\n                                              (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_one)\n                                              (Eq.refl Bool.false)))⟩).prod\n                                  ((MeasureTheory.Measure.infinitePi fun x => nu).prod\n                                    (MeasureTheory.MeasureSpace.volume.restrict (Set.Icc 0 1))));\n                          have qhat := q.tilted m;\n                          have pi :=\n                            (MeasureTheory.Measure.map (fun z => x0 + √eta • z)\n                                  (ProbabilityTheory.stdGaussian E)).tilted\n                              fun x => -f x;\n                          (Measurable fun omega =>\n                              if h : ∃ n, omega n ∈ {p | p.2.2.2 ≤ ∏ i, (1 + W (p.1, p.2.2.1 ↑i)) / (2 * 1)} then\n                                (omega (Nat.find h)).1\n                              else x0) ∧\n                            MeasureTheory.Measure.map\n                                  (fun omega =>\n                                    if h : ∃ n, omega n ∈ {p | p.2.2.2 ≤ ∏ i, (1 + W (p.1, p.2.2.1 ↑i)) / (2 * 1)} then\n                                      (omega (Nat.find h)).1\n                                    else x0)\n                                  rho =\n                                qhat ∧\n                              rho\n                                    {omega |\n                                      ∀ (n : ℕ), omega n ∉ {p | p.2.2.2 ≤ ∏ i, (1 + W (p.1, p.2.2.1 ↑i)) / (2 * 1)}} =\n                                  0 ∧\n                                MeasureTheory.IsProbabilityMeasure rho ∧\n                                  MeasureTheory.IsProbabilityMeasure qhat ∧\n                                    MeasureTheory.IsProbabilityMeasure pi ∧\n                                      pi.AbsolutelyContinuous qhat ∧\n                                        qhat.AbsolutelyContinuous pi ∧\n                                          MeasureTheory.Integrable (fun x => (pi.rnDeriv qhat x).toReal ^ ell) qhat ∧\n                                            MeasureTheory.Integrable (fun x => (qhat.rnDeriv pi x).toReal ^ ell) pi ∧\n                                              0 < ∫ (x : E), (pi.rnDeriv qhat x).toReal ^ ell ∂qhat ∧\n                                                0 < ∫ (x : E), (qhat.rnDeriv pi x).toReal ^ ell ∂pi ∧\n                                                  ∫ (x : E), (pi.rnDeriv qhat x).toReal ^ ell ∂qhat ≤ 1 + eps ^ 2 ∧\n                                                    ∫ (x : E), (qhat.rnDeriv pi x).toReal ^ ell ∂pi ≤ 1 + eps ^ 2 ∧\n                                                      Real.log (∫ (x : E), (pi.rnDeriv qhat x).toReal ^ ell ∂qhat) /\n                                                            (ell - 1) ≤\n                                                          eps ^ 2 ∧\n                                                        Real.log (∫ (x : E), (qhat.rnDeriv pi x).toReal ^ ell ∂pi) /\n                                                              (ell - 1) ≤\n                                                            eps ^ 2 ∧\n                                                          ∫⁻ (omega : ℕ → E × ℕ × (ℕ → ℝ × E) × ℝ),\n                                                                1 +\n                                                                  ∑' (n : ℕ),\n                                                                    if\n                                                                        ∀ i < n,\n                                                                          omega i ∉\n                                                                            {p |\n                                                                              p.2.2.2 ≤\n                                                                                ∏ i,\n                                                                                  (1 + W (p.1, p.2.2.1 ↑i)) /\n                                                                                    (2 * 1)} then\n                                                                      ↑(omega n).2.1\n                                                                    else 0 ∂rho ≤\n                                                              ENNReal.ofReal (1 + 2 * Real.exp 2) ∧\n                                                            ∀ (p : ℝ),\n                                                              0 < p →\n                                                                p ≤ 1 / 2 →\n                                                                  rho\n                                                                      {omega |\n                                                                        ENNReal.ofReal\n                                                                            ((2 * (Real.exp 1 - 1) *\n                                                                                    (Real.exp 2 + 1 / Real.log 2) +\n                                                                                  1 +\n                                                                                1 / Real.log 2) *\n                                                                              Real.log (2 / p)) <\n                                                                          1 +\n                                                                            ∑' (n : ℕ),\n                                                                              if\n                                                                                  ∀ i < n,\n                                                                                    omega i ∉\n                                                                                      {p |\n                                                                                        p.2.2.2 ≤\n                                                                                          ∏ i,\n                                                                                            (1 + W (p.1, p.2.2.1 ↑i)) /\n                                                                                              (2 * 1)} then\n                                                                                ↑(omega n).2.1\n                                                                              else 0} ≤\n                                                                    ENNReal.ofReal p",
    "statement_sha256": "2e7416cc9541b652d17caf853cb132898a145a4cd187643609313706cf0cd742",
