      "formula_tex": "\\mathsf{H}=\\mathsf{P}+\\mathsf{H}_{\\perp\\perp}\\,,\\hskip 20.00003pt-I\\preceq\\mathsf{H}_{\\perp\\perp}\\preceq I\\hskip 10.00002pt\\text{on }\\mathfrak{H}_{\\perp}\\,."
