              <math id="alg2.l10a.m1" class="ltx_Math" alttext="\widetilde{X}\leftarrow\textsc{ApproximateRGO}(Y_{k+1},\widehat{x}_{+},a)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo mathsize="0.900em">~</mo></mover><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">ApproximateRGO</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>Y</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mover accent="true"><mi>x</mi><mo mathsize="0.900em">^</mo></mover><mo>+</mo></msub><mo>,</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{X}\leftarrow\textsc{ApproximateRGO}(Y_{k+1},\widehat{x}_{+},a)</annotation></semantics></math>

</div>
<div id="alg2.l11a" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l11a.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
              Draw <math id="alg2.l11a.m1" class="ltx_Math" alttext="B_{k}\sim\operatorname{Bernoulli}(\rho)" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>k</mi></msub><mo>∼</mo><mrow><mi>Bernoulli</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">B_{k}\sim\operatorname{Bernoulli}(\rho)</annotation></semantics></math> independently

</div>
