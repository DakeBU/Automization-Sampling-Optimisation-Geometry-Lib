813:def compLpL [Fact (1 ≤ p)] (L : E →SL[σ] F) : Lp E p μ →SL[σ] Lp F p μ :=
818:theorem coeFn_compLpL [Fact (1 ≤ p)] (L : E →SL[σ] F) (f : Lp E p μ) :
819:    L.compLpL p μ f =ᵐ[μ] fun a => L (f a) :=
822:theorem add_compLpL [Fact (1 ≤ p)] (L L' : E →SL[σ] F) :
823:    (L + L').compLpL p μ = L.compLpL p μ + L'.compLpL p μ := by ext1 f; exact add_compLp L L' f
825:theorem smul_compLpL [Fact (1 ≤ p)] {𝕜''} [NormedRing 𝕜''] [Module 𝕜'' F] [IsBoundedSMul 𝕜'' F]
827:    (c • L).compLpL p μ = c • L.compLpL p μ := by
830:theorem norm_compLpL_le [Fact (1 ≤ p)] (L : E →SL[σ] F) : ‖L.compLpL p μ‖ ≤ ‖L‖ :=
858:def compLpL₂ [Fact (1 ≤ p)] (B : G →L[𝕜] E →L[𝕜] F) :
864:@[simp] theorem compLpL₂_apply_apply [Fact (1 ≤ p)] (B : G →L[𝕜] E →L[𝕜] F) (g : G) (f : Lp E p μ) :
865:    compLpL₂ p μ B g f = (B g).compLp f := rfl
867:theorem norm_compLpL₂_le [Fact (1 ≤ p)] (B : G →L[𝕜] E →L[𝕜] F) :
868:    ‖B.compLpL₂ p μ‖ ≤ ‖B‖ :=
1020:lemma coeFn_star {p : ℝ≥0∞} (f : Lp R p μ) : (star f : Lp R p μ) =ᵐ[μ] star f :=
1021:    (f : α →ₘ[μ] R).coeFn_star
1024:  star_involutive _ := Subtype.ext <| star_involutive _
