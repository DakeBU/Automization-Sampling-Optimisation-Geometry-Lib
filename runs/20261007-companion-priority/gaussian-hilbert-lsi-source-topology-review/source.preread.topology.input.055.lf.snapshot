    {
      "id": "M-GAMMA",
      "kind": "PINNED_API_DECLARATION",
      "statement": "variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]\n  [MeasurableSpace E]\n\nvariable (E) in\n/-- Standard Gaussian distribution on a finite-dimensional real inner product space `E`.\nThis is the random vector whose coordinates in an orthonormal basis are independent standard\nGaussian.\n\nThe definition uses `stdOrthonormalBasis ℝ E` but does not actually depend on the\nbasis, see `stdGaussian_eq_map_pi_orthonormalBasis`. -/\nnoncomputable\ndef stdGaussian : Measure E :=\n  (Measure.pi (fun _ : Fin (Module.finrank ℝ E) ↦ gaussianReal 0 1)).map\n    (fun x ↦ ∑ i, x i • stdOrthonormalBasis ℝ E i)\n",
      "source_anchors": [
        {
          "pin": "M-GAUSSIAN",
          "start_line": 55,
          "end_line": 68
        }
      ],
      "canonical_api": "ProbabilityTheory.stdGaussian",
      "proof_status": "existing pinned local API source; no fresh compilation or new ASTIS producer credit"
    },
    {
      "id": "M-PROB",
      "kind": "PINNED_API_DECLARATION",
      "statement": "variable [BorelSpace E]\n\ninstance isProbabilityMeasure_stdGaussian : IsProbabilityMeasure (stdGaussian E) :=\n  Measure.isProbabilityMeasure_map (Measurable.aemeasurable (by fun_prop))\n",
      "source_anchors": [
        {
          "pin": "M-GAUSSIAN",
          "start_line": 70,
          "end_line": 73
        }
      ],
      "canonical_api": "ProbabilityTheory.isProbabilityMeasure_stdGaussian",
      "proof_status": "existing pinned local API source; no fresh compilation or new ASTIS producer credit"
    },
    {
      "id": "M-ISOMAP",
      "kind": "PINNED_API_DECLARATION",
      "statement": "lemma stdGaussian_map {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F] [MeasurableSpace F]\n    [BorelSpace F] (f : E ≃ₗᵢ[ℝ] F) :\n    haveI := f.finiteDimensional; (stdGaussian E).map f = stdGaussian F := by\n  have := f.finiteDimensional\n  apply Measure.ext_of_charFunDual\n  ext L\n  simp_rw [show ⇑f = f.toContinuousLinearEquiv.toContinuousLinearMap from rfl, charFunDual_map,\n    charFunDual_stdGaussian, L.opNorm_comp_linearIsometryEquiv]\n",
      "source_anchors": [
        {
          "pin": "M-GAUSSIAN",
          "start_line": 128,
          "end_line": 135
        }
      ],
      "canonical_api": "ProbabilityTheory.stdGaussian_map",
      "proof_status": "existing pinned local API source; no fresh compilation or new ASTIS producer credit"
    },
    {
      "id": "M-PIMAP",
      "kind": "PINNED_API_DECLARATION",
      "statement": "lemma map_pi_eq_stdGaussian :\n    (Measure.pi (fun _ ↦ gaussianReal 0 1)).map (toLp 2) = stdGaussian (EuclideanSpace ℝ ι) := by\n  apply Measure.ext_of_charFun (E := EuclideanSpace ℝ ι)\n  ext t\n  simp_rw [charFun_stdGaussian, charFun_pi, charFun_gaussianReal, ← exp_sum, ← ofReal_pow,\n    EuclideanSpace.real_norm_sq_eq]\n  simp [Finset.sum_div, neg_div]\n",
      "source_anchors": [
        {
          "pin": "M-GAUSSIAN",
          "start_line": 137,
          "end_line": 143
        }
      ],
      "canonical_api": "ProbabilityTheory.map_pi_eq_stdGaussian",
      "proof_status": "existing pinned local API source; no fresh compilation or new ASTIS producer credit"
    },
    {
      "id": "M-BASISLAW",
      "kind": "PINNED_API_DECLARATION",
      "statement": "/-- The definition of `stdGaussian` does not depend on the basis. -/\nlemma stdGaussian_eq_map_pi_orthonormalBasis (b : OrthonormalBasis ι ℝ E) :\n    stdGaussian E = (Measure.pi fun _ : ι ↦ gaussianReal 0 1).map (fun x ↦ ∑ i, x i • b i) := by\n  have : (fun (x : ι → ℝ) ↦ ∑ i, x i • b i) =\n      ⇑((EuclideanSpace.basisFun ι ℝ).equiv b (Equiv.refl ι)) ∘ (toLp 2) := by\n    simp_rw [← b.equiv_apply_euclideanSpace]\n    rfl\n  rw [this, ← Measure.map_map, map_pi_eq_stdGaussian, stdGaussian_map]\n  all_goals fun_prop\n",
      "source_anchors": [
        {
          "pin": "M-GAUSSIAN",
          "start_line": 145,
          "end_line": 153
        }
      ],
      "canonical_api": "ProbabilityTheory.stdGaussian_eq_map_pi_orthonormalBasis",
      "proof_status": "existing pinned local API source; no fresh compilation or new ASTIS producer credit"
    },
    {
      "id": "M-CLE",
      "kind": "PINNED_API_DECLARATION",
      "statement": "functions from its basis indexing type to `𝕜`. -/\n@[simps! apply]\ndef equivFunL (v : Basis ι 𝕜 E) : E ≃L[𝕜] ι → 𝕜 :=\n  { v.equivFun with\n    continuous_toFun :=\n      haveI : FiniteDimensional 𝕜 E := v.finiteDimensional_of_finite\n      v.equivFun.toLinearMap.continuous_of_finiteDimensional\n    continuous_invFun := by\n      change Continuous v.equivFun.symm.toFun\n      exact v.equivFun.symm.toLinearMap.continuous_of_finiteDimensional }\n",
      "source_anchors": [
        {
          "pin": "M-BASIS-CONTINUOUS",
          "start_line": 443,
