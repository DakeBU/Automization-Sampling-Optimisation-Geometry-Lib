@AutoSamplingTheory.TechnicalLemmas.Geometry.SphereAntipodalGenerator.sphere_differential_operators_comp_neg : ∀
  {I : Type u_1} [inst : Fintype I] [DecidableEq I] (f : EuclideanSpace ℝ I → ℝ) (w : EuclideanSpace ℝ I),
  (∀ (h : EuclideanSpace ℝ I), (fderiv ℝ (fun x => f (-x)) w) h = -(fderiv ℝ f (-w)) h) ∧
    AutoSamplingTheory.TechnicalLemmas.Geometry.SphereDiffusionGenerator.sphereLaplacian (fun x => f (-x)) w =
      AutoSamplingTheory.TechnicalLemmas.Geometry.SphereDiffusionGenerator.sphereLaplacian f (-w)
def AutoSamplingTheory.TechnicalLemmas.Geometry.SphereDiffusionGenerator.sphereLaplacian.{u_1} : {I : Type u_1} →
  [Fintype I] → (EuclideanSpace ℝ I → ℝ) → EuclideanSpace ℝ I → ℝ :=
fun {I} [Fintype I] f w =>
  Laplacian.laplacian f w - ((fderiv ℝ (fderiv ℝ f) w) w) w - ↑(Fintype.card I - 1) * (fderiv ℝ f w) w
'AutoSamplingTheory.TechnicalLemmas.Geometry.SphereAntipodalGenerator.sphere_differential_operators_comp_neg' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
