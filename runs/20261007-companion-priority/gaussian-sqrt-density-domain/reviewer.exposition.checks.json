      "id": "sphmc-standardized-rgo-sqrt-density:reader-step-2",
      "title": "Apply the new density-domain producer to that actual residual",
      "formula": "0<Z_s\\le1,\\quad q_s=e^{-\\rho_s}/Z_s,\\quad f_s=e^{-\\rho_s/2}/\\sqrt{Z_s},\\quad r_s=q_s\\gamma.",
      "proof_ingredient": "GaussianSqrtDensityDomain.gaussian_sqrt_density_domain; actual htrue",
      "source_status": "actual Ex8 true standardized RGO residual consumer, domain conclusions only"
    },
