      "credit": "Exact source formula only; not a proved Lean clause",
      "id": "A1.E1.m2",
      "literal_source_alttext": "\\displaystyle\\coloneqq\\inf\\Bigl\\{u\\geq 0:\\int_{0}^{u}\\lambda_{\\widetilde{x}}(\\Phi_{s}^{y,\\widetilde{x}}(\\zeta_{T_{n}}))\\,\\mathrm{d}s\\geq E_{n+1}\\Bigr\\}\\,,",
      "source_URL": "https://arxiv.org/html/2609.06905v1#A1.E1.m2"
    },
    {
