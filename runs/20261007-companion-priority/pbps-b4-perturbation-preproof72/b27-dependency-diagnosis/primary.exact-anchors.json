      "formula_tex": "(\\mathsf{H}f)(x,y)\\coloneqq\\int_{\\mathbb{R}^{d}}f(x^{\\prime},y)\\,\\mathcal{H}_{y}(x,\\mathrm{d}x^{\\prime})"
