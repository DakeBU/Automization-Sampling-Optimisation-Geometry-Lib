<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E3.m2" class="ltx_Math" alttext="\displaystyle\leqslant(1-ch/\kappa)\,\lVert z-z^{\prime}\rVert_{M_{\kappa}}\,," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>⩽</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo>/</mo><mi>κ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo fence="true" rspace="0em">∥</mo><mrow><mi>z</mi><mo>−</mo><msup><mi>z</mi><mo>′</mo></msup></mrow><mo fence="true" lspace="0em" rspace="0em">∥</mo></mrow><msub><mi>M</mi><mi>κ</mi></msub></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leqslant(1-ch/\kappa)\,\lVert z-z^{\prime}\rVert_{M_{\kappa}}\,,</annotation></semantics></math></td>
