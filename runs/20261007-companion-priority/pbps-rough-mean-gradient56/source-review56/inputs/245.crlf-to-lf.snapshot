               <math id="alg2.l13.m1" class="ltx_Math" alttext="X_{k+1}\leftarrow\widetilde{X}" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo><mover accent="true"><mi>X</mi><mo mathsize="0.900em">~</mo></mover></mrow><annotation encoding="application/x-tex">X_{k+1}\leftarrow\widetilde{X}</annotation></semantics></math>

</div>
<div id="alg2.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
