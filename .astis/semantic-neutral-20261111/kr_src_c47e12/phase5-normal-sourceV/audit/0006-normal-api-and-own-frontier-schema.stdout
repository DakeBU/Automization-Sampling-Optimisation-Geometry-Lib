63: )
64: TERMINAL_ADVANCE_STATES = frozenset({"MERGED", "QUARANTINED"})
65: WORKER_LANE_STATES = frozenset({"CLAIMED", "EXPLORING", "PROVED_LOCAL"})
66: WORKER_LANE_TARGETS = frozenset({"EXPLORING", "PROVED_LOCAL", "BLOCKED"})
67: SUBSTANTIVE_RESULT_KINDS = frozenset(
68:     {"theorem-edge", "reusable-interface", "integration-node"}
69: )
