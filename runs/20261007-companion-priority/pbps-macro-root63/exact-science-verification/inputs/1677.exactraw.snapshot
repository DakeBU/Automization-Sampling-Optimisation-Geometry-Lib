      "source": {
        "source_id": "bounded-stopped-ito-mean:mean-zero",
        "anchor": "standard bounded stopping consequence for a square-integrable real Ito integral; Samplinglib completed-process formulation",
        "url": "https://github.com/DakeBU/Automization-Sampling-Optimisation-Geometry-Lib",
        "original_text": "Let eta be a progressively measurable real integrand that is square-integrable on a positive finite horizon T, let B be Brownian motion relative to a filtration satisfying the usual conditions, and let tau be a nonnegative stopping time satisfying tau(omega) <= T for every omega. Then the expectation of the completed Ito integral I_tau = integral_0^tau eta_s dB_s is zero. This is the centered value of the constructed real global-L2 Ito process at a bounded stopping time; it is not a general optional-sampling theorem and asserts nothing about unbounded stopping times, local martingales before localization, vector stochastic integration, quadratic variation, or Ito's formula.",
        "text_sha256": "8d15678f29657a8b7e38e7a72f9c2108ea38220d2c8fa21a9b7f187f43d71db1"
      },
      "lean": {
        "declaration": "AutoSamplingTheory.TechnicalLemmas.StochasticProcesses.BoundedStoppedItoMean.integral_itoIntegralProcess_at_boundedStopping_eq_zero",
        "file": "AutoSamplingTheory/TechnicalLemmas/StochasticProcesses/BoundedStoppedItoMean.lean",
        "statement": "theorem integral_itoIntegralProcess_at_boundedStopping_eq_zero\n    [IsFiniteMeasure mu]\n    (eta : ProgressiveL2Integrand filtration mu T) (hT : 0 < T)\n    (tau : Omega → ℝ≥0)\n    (htau : IsChewiStoppingTime filtration\n      (fun omega => (tau omega : WithTop ℝ≥0)))\n    (htauT : ∀ omega, tau omega ≤ T)\n    (hB : IsBrownianMotionWithFiltration B filtration mu)\n    (hUsual : SatisfiesUsualConditions filtration mu) :\n    ∫ omega, itoIntegralProcess eta hT hB hUsual (tau omega) omega ∂mu = 0",
        "statement_sha256": "eab0b9be93901133cf145ced244411da95426281c7228b76f0c721f9aff79324",
        "compiled": true,
        "formalizer": "sphere_second_order_proof_auditor",
        "compiler_evidence": "Lean 4.33.0 production module and focused Tests/BoundedStoppedItoMean.lean passed.",
        "decoder_context": [
          "A filtration indexed by nonnegative reals is a monotone family of measurable subspaces on the sample space.",
          "A ProgressiveL2Integrand is a real progressively measurable integrand with finite product-space L2 norm on the stated finite horizon.",
          "An IsChewiStoppingTime condition says that every event where the nonnegative stopping time is at most a deterministic time is measurable at that time.",
          "IsBrownianMotionWithFiltration supplies the real Brownian-motion contract relative to the displayed filtration and measure.",
          "SatisfiesUsualConditions records completeness and right-continuity of the filtration.",
          "itoIntegralProcess is the constructed completed continuous real Ito integral process; Integrable and the displayed integral are Mathlib Bochner-integral notions."
        ]
      },
      "semantic_slots": {
        "objects": {
          "original": "样本空间、有限测度、非负实时间滤过、正有限范围、渐进 L2 被积过程、Brownian 运动、停止时间和完成的实 Ito 积分过程。",
          "reconstructed": "样本空间 Ω、有限测度 μ、滤过 filtration、时间范围 T、渐进 L² 被积过程 η、非负停止时间 τ、实 Brownian 过程 B，以及构造的连续 Ito 积分过程。",
          "relation": "same",
          "evidence": "Independent packet-bound review found this slot unchanged."
        },
        "domains": {
          "original": "实标量随机积分，时间索引和停止时间取非负实数，测度有限。",
          "reconstructed": "τ:Ω→ℝ≥0；T 是非负实时间参数且 0<T；filtration 以 ℝ≥0 为指标；η 是 ProgressiveL2Integrand filtration μ T；被积分的停止 Ito 积分取实值。",
          "relation": "explicit-elaboration",
          "evidence": "NNReal and WithTop make nonnegative finite time and the stopping-time encoding explicit without changing the domain."
        },
