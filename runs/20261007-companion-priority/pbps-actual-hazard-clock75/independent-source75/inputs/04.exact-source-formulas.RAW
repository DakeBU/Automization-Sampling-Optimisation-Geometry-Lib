      "credit": "Exact source formula only; not a proved Lean clause",
      "id": "S3.E9.m1",
      "literal_source_alttext": "\\lambda_{\\widetilde{X}}(x,p)=\\sqrt{\\eta}\\,\\bigl[p^{\\top}[\\nabla V(x)-\\nabla V(\\widetilde{X})]\\bigr]_{+}\\,.",
      "source_URL": "https://arxiv.org/html/2609.06905v1#S3.E9.m1"
    },
    {
      "LF_sha256": "9f915fa1c232ec186993965322f5ac30c280e78ac3c8875797fb1feba382be9e",
