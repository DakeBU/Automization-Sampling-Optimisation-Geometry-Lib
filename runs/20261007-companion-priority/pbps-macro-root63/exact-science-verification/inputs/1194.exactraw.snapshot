schema_version: 2
purpose: canonical registry for lower-level mathematics reused by two or more textbook/research lanes
frontloaded_spine: /Libraries/frontloaded-shared-spine.json
policy:
  exact_match: reuse one canonical Lean declaration
  near_match: factor one common core and keep explicit source/route adapters
  missing_shared_fact: open one route=shared Frontier Cell before route-local implementation continues
  different_statement: keep separate declarations
  pull_forward: a later textbook chapter may supply an early shared prerequisite without receiving chapter-completion credit
  stabilization: shared files and aggregators are integrated through one stabilization lane
search_order:
  - Samplinglib
  - Mathlib
  - active shared Frontier Cells
  - Optlib and CvxLean for optimisation-relevant work
  - compatible audited external Lean memories
source_spines:
  log-concave-sampling:
    source: Sinho Chewi, Log-Concave Sampling
    role: canonical textbook spine; not the SampleWiki frontier route
  optimisation:
    source: Sinho Chewi, Lectures on Optimization
  riemannian-optimization:
    source: Nicolas Boumal, An Introduction to Optimization on Smooth Manifolds
  statistical-optimal-transport:
    source: Chewi, Niles-Weed, Rigollet, Statistical Optimal Transport
  discrete-sampling:
    source: Chen, Štefankovič, Vigoda, arXiv:2307.13826v4
    role: finite-state source spine; not SDE time discretization
checkpoints:
  - id: finite-reversible-dirichlet-entropy
    consumers: [discrete-sampling, log-concave-sampling, statistical-optimal-transport]
    source_links: ["Discrete Sampling §§3.2-3.7 and §6.8", "Sampling Chapter 2", "Maas arXiv:1102.5238"]
    status: candidate
    note: share kernels, L2/entropy algebra and scalar decay; separate finite-jump and diffusion dissipation identities, clock rates and transport metrics

  - id: euclidean-linear-algebra-foundations
    consumers: [log-concave-sampling, optimisation, riemannian-optimization, statistical-optimal-transport]
    source_links:
      - "Chewi Optimization Chapter 1 and Appendix A"
      - "Boumal Chapters 1-2 examples"
      - "Chewi Sampling Chapters 1-2"
      - "Statistical OT Chapter 1 quadratic-cost examples"
    status: candidate
    note: coordinates, inner products, symmetric/PSD matrix facts and quadratic energies should be canonical when types coincide

  - id: calculus-gradient-foundations
    consumers: [log-concave-sampling, optimisation, riemannian-optimization, statistical-optimal-transport, higher-order-sampling]
    source_links:
      - "Chewi Sampling §1.1"
      - "Chewi Optimization Chapters 1-2"
      - "Boumal Chapter 3"
      - "Statistical OT §1.4"
    status: candidate
    note: share Fréchet derivative/gradient/chain-rule facts; Riemannian gradients remain explicit metric adapters

  - id: convex-analysis-foundations
    consumers: [log-concave-sampling, optimisation, statistical-optimal-transport, riemannian-optimization, samplewiki-route]
    source_links:
      - "Chewi Optimization Chapter 1"
      - "Chewi Log-Concave Sampling Chapter 2"
      - "Statistical OT §§1.4-1.5"
    status: candidate
    note: canonical Euclidean convexity, strong convexity and subgradient core; log/geodesic/mixture/displacement convexity are not aliases

  - id: transport-coupling-foundations
    consumers: [log-concave-sampling, statistical-optimal-transport]
    source_links:
      - "Statistical OT §§1.1-1.3 and Appendix B"
      - "Chewi Log-Concave Sampling §1.3"
      - "Samplinglib Measure interfaces"
    status: candidate
    note: OT Chapter 1 should produce the canonical coupling/Wasserstein core consumed by Sampling §1.3 rather than two route-local copies

  - id: convex-duality-pull-forward
    consumers: [statistical-optimal-transport, optimisation]
    source_links:
      - "Statistical OT §§1.5-1.6"
      - "Chewi Optimization Chapter 9 Fenchel duality"
    status: candidate
    note: pull forward only the exact shared conjugacy/duality lemmas needed by OT; this does not mark Optimization Chapter 9 complete

  - id: gradient-flow-energy-dissipation
    consumers: [optimisation, log-concave-sampling, riemannian-optimization, statistical-optimal-transport]
    source_links:
      - "Chewi Optimization Chapter 2 Gradient flow"
      - "Chewi Sampling §§1.4-1.5"
      - "Statistical OT Chapters 5-6 later consumer"
    status: candidate
    note: share chain-rule, scalar dissipation and Grönwall/contraction cores; Euclidean/Riemannian/Wasserstein flows remain distinct structures with adapters

  - id: manifold-foundations
    consumers: [log-concave-sampling, riemannian-optimization]
    source_links:
      - "Chewi Log-Concave Sampling §2.5 Riemannian Manifolds"
      - "Boumal Chapter 3 Embedded geometry: first order"
    status: candidate
    note: Boumal Chapter 3 may be pulled forward before exhaustive Chapters 1-2 closure when it is the true dependency for Sampling §2.5; tangent/differential/metric/gradient conventions must match

  - id: empirical-concentration-foundations
    consumers: [log-concave-sampling, statistical-optimal-transport]
    source_links:
      - "Chewi Log-Concave Sampling §2.4"
      - "Statistical OT Chapter 2"
    status: candidate
    note: share empirical-measure and basic Lipschitz concentration leaves; OT chaining/minimax arguments and sampling isoperimetry remain source-specific unless exact matches are proved

  - id: markov-semigroup-foundations
    consumers: [log-concave-sampling, samplewiki-route]
    source_links:
      - "Chewi Log-Concave Sampling §§1.1-1.2 and Chapter 2 semigroup proofs"
    status: candidate
    note: this is an early sampling critical path but must not serialize unrelated Optimization or OT Chapter 1 work

  - id: gibbs-entropy-foundations
    consumers: [log-concave-sampling, statistical-optimal-transport, optimisation, samplewiki-route]
    source_links:
      - "Chewi Log-Concave Sampling Chapter 2"
      - "Statistical Optimal Transport Chapter 4"
      - "Proximal sampling"
      - "MFLD entropy sandwich"
    status: candidate

  - id: proximal-foundations
    consumers: [log-concave-sampling, optimisation, samplewiki-route]
    source_links:
      - "Chewi Log-Concave Sampling Chapter 8"
      - "Chewi Lectures on Optimization Chapter 8"
    status: candidate
    note: proximal energies and supporting convex-analysis lemmas should be shared when statements coincide; sampler-specific kernels remain route-specific

  - id: mirror-stochastic-foundations
    consumers: [log-concave-sampling, optimisation, samplewiki-route]
    source_links:
      - "Chewi Log-Concave Sampling Chapter 10"
      - "Chewi Lectures on Optimization Chapters 10 and 12"
    status: candidate
    note: geometry or stochastic-gradient primitives may be shared; sampling-specific invariant-law arguments remain separate

  - id: taylor-local-error-foundations
    consumers: [higher-order-sampling, optimisation, riemannian-optimization]
    source_links:
      - "High-order optimization Taylor models"
      - "High-order sampling local-error estimates"
    status: candidate

  - id: information-oracle-contracts
    consumers: [samplewiki-route, higher-order-sampling, statistical-optimal-transport]
    status: candidate
    note: share discrepancy or testing interfaces only after distinguishing statistical observations from sampling queries

canonical_declarations:
  - AutoSamplingTheory.TechnicalLemmas.Probability.KernelInvariance.invariant_pow
shared_dependency_plan: /Libraries/cross-domain-program.json
transport_policy: conceptual correspondence never identifies Lean declarations without a compatibility proof

# MCMC readers use the same source-neutral floor; these are plans, not certificates.
mcmc_shared_floor:
  source: /Libraries/MCMC/source-map.json
  protocol: /docs/mcmc-library-protocol.md
  priorities:
    - target: "General-state MH flux / detailed-balance / invariance contract"
      consumers: [mcmc, discrete-sampling, log-concave-sampling]
      action: "Search Samplinglib and pinned Mathlib kernels; handle singular/zero-support adapters explicitly"
    - target: "Drift/minorisation and coupling; scalar decay without diffusion assumptions"
      consumers: [mcmc, discrete-sampling, log-concave-sampling]
      action: "Roberts-Rosenthal math/0404033v4 sections 3-4; one canonical shared cell"
    - target: "Ergodic averages / Poisson equations / estimator variance"
      consumers: [mcmc, discrete-sampling]
      action: "Keep invariant-law accuracy and Monte Carlo estimation error as separate obligations"
