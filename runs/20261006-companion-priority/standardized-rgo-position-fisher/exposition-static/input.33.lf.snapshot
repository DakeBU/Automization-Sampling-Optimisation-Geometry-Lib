    {
      "id": "transport:metric-pl",
      "kind": "concept-bridge",
      "label": "Metric gradient flow: PL controls dissipation",
      "status": "proposal",
      "subtitle": "shared dissipation template",
      "summary": "The common proof skeleton is metric gradient flow plus a gap-versus-squared-gradient coercivity inequality. The scalar differential inequality then gives exponential energy-gap decay.",
      "formula": "\\begin{gathered}\\dot z_t=-\\operatorname{grad}_g\\mathcal E(z_t)\\\\\\frac{d}{dt}(\\mathcal E(z_t)-\\mathcal E_*)=-\\|\\operatorname{grad}_g\\mathcal E(z_t)\\|_g^2\\\\\\|\\operatorname{grad}_g\\mathcal E(z)\\|_g^2\\ge 2\\alpha(\\mathcal E(z)-\\mathcal E_*)\\end{gathered}",
      "details": [
        {
          "label": "Evidence boundary",
          "value": "Literature/structural correspondence; no Lean-certified functor or theorem transfer."
        },
        {
          "label": "Conceptual families",
          "value": "family:metric-gradient-flow, family:gap-gradient"
        },
        {
          "label": "Mechanism",
          "value": "The common proof skeleton is metric gradient flow plus a gap-versus-squared-gradient coercivity inequality. The scalar differential inequality then gives exponential energy-gap decay."
        },
        {
          "label": "Hypothesis Map",
          "value": "Identify the actual metric gradient, a valid chain rule/energy-dissipation identity, a lower energy level E_*, and flow existence. Discrete algorithms need an additional descent/local-error argument."
        },
        {
          "label": "Conclusion Map",
          "value": "The final Gronwall step is shared across Euclidean PL, Riemannian PL and Wasserstein PL; only the metric, energy and proof of the coercivity premise change."
        },
        {
          "label": "Failure Boundary",
          "value": "This template does not identify the underlying spaces or prove that a formal Wasserstein gradient exists. W2/Otto geometry requires rigorous first-variation and EDI/EVI hypotheses in infinite-dimensional settings."
        },
        {
          "label": "Category objects",
          "value": "Metric energy problems (X,g,E,E_*) carrying a justified gradient-flow/dissipation structure."
        },
        {
          "label": "Category morphisms",
          "value": "Translations that preserve the energy/dissipation inequality and explicitly map constants; no total morphism class is defined."
        },
        {
          "label": "Category identity",
          "value": "The scalar dissipation template is reusable, but no category-level identity law is certified."
        },
        {
          "label": "Category composition",
          "value": "Metric and regularity side conditions must be recomputed after each transport; no composition certificate is claimed."
        },
        {
          "label": "Shared planned checkpoints",
          "value": "calculus, manifold, transport, flow"
        },
        {
          "label": "Library scope (curated)",
          "value": "Log-concave Sampling · Optimisation · Riemannian Optimisation · Optimal Transport"
        },
        {
          "label": "Scope evidence boundary",
          "value": "conceptual incidence scope, not compiled cross-domain use"
