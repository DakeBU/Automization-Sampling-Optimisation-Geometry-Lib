    {
      "id": "transport:discrete-pi",
      "kind": "concept-bridge",
      "label": "One L2 mechanism: finite chains and diffusions",
      "status": "proposal",
      "subtitle": "conceptual mirror candidate; independent review pending",
      "summary": "Replace diffusion integration by parts with finite summation and detailed balance; retain the same scalar gap-dissipation comparison.",
      "formula": "\\begin{gathered}r_t=d\\nu_t/d\\pi,\\quad L=P-I\\\\ \\partial_t\\chi^2(\\nu_t\\Vert\\pi)=-2\\mathcal E_P(r_t,r_t)\\\\ \\operatorname{Var}_\\pi(f)\\leq C_P\\mathcal E_P(f,f)\\\\ \\Longrightarrow\\ \\chi^2_t\\leq e^{-2t/C_P}\\chi^2_0\\end{gathered}",
      "details": [
        {
          "label": "Evidence boundary",
          "value": "Literature/structural correspondence; no Lean-certified functor or theorem transfer."
        },
        {
          "label": "Review status",
          "value": "candidate"
        },
        {
          "label": "Review boundary",
          "value": "A candidate awaits independent source review. Source review does not certify a Lean transport."
        },
        {
          "label": "Conceptual families",
          "value": "family:l2-coercivity"
        },
        {
          "label": "Mechanism",
          "value": "Replace diffusion integration by parts with finite summation and detailed balance; retain the same scalar gap-dissipation comparison."
        },
        {
          "label": "Hypothesis Map",
          "value": "Finite support, pi>0, pi-reversible stochastic P; continuous-time Poissonization L=P-I at total rate one; positive Poincare constant. For P^k instead, check absolute spectrum/laziness and aperiodicity separately."
        },
        {
          "label": "Conclusion Map",
          "value": "Reuse quadratic-gap algebra and scalar exponential decay after proving the finite-generator identity. The rate is normalized by the chosen generator."
        },
        {
          "label": "Failure Boundary",
          "value": "Spectral gap alone need not mix a periodic discrete-time chain. Per-site rate one scales L by n relative to total rate one. No finite-to-diffusion limit theorem is asserted."
        },
        {
          "label": "Category objects",
          "value": "Typed (state space, probability law, operator, discrepancy, metric, clock) presentations."
        },
