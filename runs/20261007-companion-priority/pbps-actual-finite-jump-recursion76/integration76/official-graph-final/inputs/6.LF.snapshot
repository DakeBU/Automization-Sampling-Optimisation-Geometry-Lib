      {
        "id": "S3.Thmtheorem1",
        "tag": "div",
        "class": "ltx_theorem ltx_theorem_proposition",
        "start_line": 1639,
        "end_line": 1649,
        "raw_sha256": "de6701cbbba6cbbfc73f8e4de8b4048f1f768f64871ec024b82423ec1cf3be6b",
        "mathtext": "Proposition 3.1 (Well-posedness and stationarity of the conditional phase space process).\n\nFor every fixed $y,\\widetilde{x}\\in\\mathbb{R}^{d}$ and initial phase space point\n$(x_{0},p_{0})$ , the event-driven dynamics in Algorithm 1, with\nthe reference point fixed at $\\widetilde{x}$ , defines a unique\nnon-explosive, time-homogeneous Markov process. The phase space measure\n$\\nu_{\\eta,y}$ is stationary for this process. In particular, the\nreturned position $x_{\\pi}$ is well-defined almost surely.\n",
        "disposition": "NODE",
        "classification": "selected-source-node",
        "reason": "Target context only: every fixed y,r and initial point; full nonexplosive Markov/stationary/a.s.-return conclusion remains OPEN.",
        "overlap_policy": "Nested paragraph/theorem/display records overlap intentionally; coverage is by source region, not a theorem-count metric.",
        "compiled76_projection": {
          "status": "partial-context-full-Proposition3.1-OPEN",
          "current_BODY_or_definition_lines": [
            225,
            409
          ],
          "compiled_parent_regions": [],
          "reason": "The source quantifiers are preserved for its finite ingredient. Nonexplosive global Markov/stationary process and a.s. terminal return are not admitted."
        }
      },
      {
        "id": "S3.Thmtheorem1.p1",
