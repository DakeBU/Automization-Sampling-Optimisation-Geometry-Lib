        }
      ],
      "canonical_api": "AutoSamplingTheory.TechnicalLemmas.Analysis.Calculus.Gradient.fderiv_apply_eq_inner_gradient_of_differentiableAt",
      "proof_status": "existing pinned local API source; no fresh compilation or new ASTIS producer credit"
