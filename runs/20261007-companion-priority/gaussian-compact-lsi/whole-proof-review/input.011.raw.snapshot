    {
      "id": "S-C2",
      "kind": "DEFINITION",
      "formula": "CompactlySupportedSmooth f = ContDiff Real2 f AND HasCompactSupport f",
      "classification": "EXTERNAL_SOURCE",
      "anchors": [
        {
          "input_role": "external_C2_definition",
          "start_line": 44,
          "end_line": 48,
          "literal_LF_sha256": "5632d80d50513cd9bbda28bda26a075ea6cb61f19c67a882b87b67eb4be9d44f",
          "literal": "variable {Ω : Type*}\n\n/-- Predicate for a function being `C²` with compact support. -/\ndef CompactlySupportedSmooth (f : ℝ → ℝ) : Prop :=\n  ContDiff ℝ 2 f ∧ HasCompactSupport f\n"
        }
      ]
    },
    {
      "id": "S-ENT",
      "kind": "DEFINITION",
      "formula": "Entropy μ g = integral g logg - (integral g) log(integral g)",
      "classification": "EXTERNAL_SOURCE",
      "anchors": [
        {
          "input_role": "external_entropy_definition",
          "start_line": 34,
          "end_line": 49,
          "literal_LF_sha256": "12be5af66fba3afd986d07f7b76c6ded90fa863102e358ba2cbbbcd6c1480b4f",
          "literal": "namespace LogSobolev\n\nvariable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}\n\n/-!\n## Definition of Entropy\n-/\n\n/-- The entropy of a nonnegative function f with respect to measure μ.\n    Ent_μ(f) = ∫ f * log(f) dμ - (∫ f dμ) * log(∫ f dμ)\n\n    This measures the \"spread\" of f relative to a constant function with the same integral.\n    When ∫ f dμ = 1 (f is a probability density), this reduces to the negative\n    of Shannon entropy: Ent_μ(f) = ∫ f log f dμ. -/\ndef entropy (μ : Measure Ω) (f : Ω → ℝ) : ℝ :=\n  ∫ ω, f ω * log (f ω) ∂μ - (∫ ω, f ω ∂μ) * log (∫ ω, f ω ∂μ)\n"
        }
      ]
    },
    {
      "id": "S-RAD",
      "kind": "DEFINITION",
      "formula": "Real Rademacher measure=(1/2)dirac(-1)+(1/2)dirac1",
      "classification": "EXTERNAL_SOURCE",
      "anchors": [
        {
          "input_role": "external_Rademacher_measure",
          "start_line": 43,
          "end_line": 45,
          "literal_LF_sha256": "f76df4c051fd558b39cd94f0094c03ef5507ba6ea3cea696c535fafe4232333a",
          "literal": "/-- The Rademacher measure: probability measure on ℝ assigning probability 1/2 to both -1 and 1. -/\ndef rademacherMeasure : Measure ℝ :=\n  (1/2 : ℝ≥0∞) • Measure.dirac (-1 : ℝ) + (1/2 : ℝ≥0∞) • Measure.dirac (1 : ℝ)\n"
        }
      ]
    },
    {
      "id": "S-RAD-PROB",
      "kind": "BACKGROUND_PREREQUISITE",
      "formula": "Actual upstream instance IsProbabilityMeasure rademacherMeasure",
      "classification": "EXTERNAL_HEADER_CUT",
      "anchors": [
        {
          "input_role": "external_Rademacher_measure",
          "start_line": 47,
          "end_line": 47,
          "literal_LF_sha256": "686a02229b7a3b562a393642fc63d6238084ce391348c7df56a27820cfd80a9e",
          "literal": "instance isProbabilityMeasure_rademacherMeasure : IsProbabilityMeasure rademacherMeasure := by\n"
        }
      ],
      "proof_boundary": "Probability instance provider proof outside compact38 integration; no supplied probability binder in target."
    },
    {
      "id": "S-PI-PROB",
      "kind": "API_PRIMITIVE",
      "formula": "Measure.pi.instIsProbabilityMeasure: probability of finite product from coordinate probabilities",
      "classification": "EXTERNAL_IMPORTED_PRIMITIVE",
      "anchors": [
        {
          "input_role": "external_C2_definition",
          "start_line": 357,
          "end_line": 359,
          "literal_LF_sha256": "96521736bf6489a9d2726756d48fcb203d4b7b37c5a49da2530ba7e032c2a802",
          "literal": "instance isProbabilityMeasure_rademacherProduct (n : ℕ) :\n    IsProbabilityMeasure (rademacherProductMeasure n) :=\n  Measure.pi.instIsProbabilityMeasure _\n"
        }
      ],
      "local_callable_credit": false
    },
    {
      "id": "S-AEMEAS",
      "kind": "API_PRIMITIVE",
      "formula": "Measurable.aemeasurable used for actual map",
      "classification": "EXTERNAL_IMPORTED_PRIMITIVE",
      "anchors": [
        {
          "input_role": "external_gaussian_definition",
