  "definitions": [
    {
      "file": ".lake/packages/mathlib/Mathlib/Data/Set/Operations.lean",
      "wholefile_raw_sha256": "abc0e2b74179711089a29eeee73d37ad81e6850373a00fb8371b6b183f5d0aab",
      "kind": "literal-canonical-definition",
      "context": "Set.range is the actual existential image; arbitrary real coefficient functions, not a supplied span/range certificate.",
      "start_character_inclusive": 6431,
      "end_character_exclusive": 6483,
      "start_line_1based": 174,
      "literal": "def range (f : ι → α) : Set α := {x | ∃ y, f y = x}\n",
      "literal_sha256": "6ea5f38bede17452fab4c6025aa7489ccb2b191c13d4a1ce86fc1d2bc8a6bbd0",
      "byte_start_inclusive": 6722,
      "byte_end_exclusive": 6781,
      "end_line_1based_inclusive": 174,
      "source_LF_included_exactly": true
    },
    {
      "file": ".lake/packages/mathlib/Mathlib/LinearAlgebra/Span/Defs.lean",
      "wholefile_raw_sha256": "826061d48780e93c2256bfb3f17efb697976e3fdee9761407c44dd813bae3ab3",
      "kind": "literal-canonical-definition",
      "context": "Submodule namespace; fixed ℝ module of functions Fin d → ℝ. General context Semiring R, AddCommMonoid M, Module R M; no norm chosen by span.",
      "start_character_inclusive": 1205,
      "end_character_exclusive": 1266,
      "start_line_1based": 48,
      "literal": "def span (s : Set M) : Submodule R M :=\n  sInf { p | s ⊆ p }\n",
      "literal_sha256": "a1f7eb30847dc05432458d8c384af035c784f9b75258176803bebe02ad4588b6",
      "byte_start_inclusive": 1245,
      "byte_end_exclusive": 1308,
      "end_line_1based_inclusive": 49,
      "source_LF_included_exactly": true
    },
    {
      "file": ".lake/packages/mathlib/Mathlib/Data/Matrix/Mul.lean",
      "wholefile_raw_sha256": "9ce6ecd0751e977f58fc47d6f271dff381e59868474a6955730ff07a99aa0e6b",
      "kind": "literal-canonical-definition",
      "context": "The ambient index m is finite. Fixed real scalar multiplication/addition in the target.",
      "start_character_inclusive": 2179,
      "end_character_exclusive": 2258,
      "start_line_1based": 72,
      "literal": "def dotProduct [Mul α] [AddCommMonoid α] (v w : m → α) : α :=\n  ∑ i, v i * w i\n",
      "literal_sha256": "845ac48216569b548ccb957fafad6c1307bea4e8024a0bb3aa0eb65f6207e854",
      "byte_start_inclusive": 2207,
      "byte_end_exclusive": 2294,
      "end_line_1based_inclusive": 73,
      "source_LF_included_exactly": true
    },
    {
      "file": ".lake/packages/mathlib/Mathlib/Data/Matrix/Mul.lean",
      "wholefile_raw_sha256": "9ce6ecd0751e977f58fc47d6f271dff381e59868474a6955730ff07a99aa0e6b",
      "kind": "literal-canonical-definition",
      "context": "Matrix namespace; NonUnitalNonAssocSemiring α. Both fixed finite matrix multiplication and vector products use ordinary sums.",
      "start_character_inclusive": 24209,
      "end_character_exclusive": 24302,
      "start_line_1based": 698,
      "literal": "def mulVec [Fintype n] (M : Matrix m n α) (v : n → α) : m → α\n  | i => (fun j => M i j) ⬝ᵥ v\n",
      "literal_sha256": "54fcc54d0ef324f7ecb15049d503453f385175d0d3ed840e92d5d68a82af5403",
      "byte_start_inclusive": 25262,
      "byte_end_exclusive": 25366,
      "end_line_1based_inclusive": 699,
      "source_LF_included_exactly": true
    },
    {
      "file": ".lake/packages/mathlib/Mathlib/Data/Matrix/Diagonal.lean",
      "wholefile_raw_sha256": "dce51ac9508413b1250bfe7eacabf288a1a52b317b2f036d3663764cc3ed4e43",
      "kind": "literal-canonical-definition",
      "context": "Matrix namespace; decidable equality on finite indices, fixed real zero. Matrix powers are ordinary Nat powers in the canonical finite real matrix semiring, not entrywise powers.",
      "start_character_inclusive": 1339,
      "end_character_exclusive": 1432,
      "start_line_1based": 50,
      "literal": "def diagonal [Zero α] (d : n → α) : Matrix n n α :=\n  of fun i j => if i = j then d i else 0\n",
      "literal_sha256": "5f9efb378f4c0dc5c2051a043a9a25eb2d99fa639205a00816d7ff84f68e569a",
      "byte_start_inclusive": 1348,
      "byte_end_exclusive": 1446,
      "end_line_1based_inclusive": 51,
      "source_LF_included_exactly": true
    },
    {
      "file": ".lake/packages/mathlib/Mathlib/Analysis/Normed/Lp/WithLp.lean",
      "wholefile_raw_sha256": "b05b66fcc68f3e3e7c20aae323b880e9edd8af18e5e096a207746df8bd3e79ba",
      "kind": "literal-canonical-definition",
      "context": "The literal constructor named toLp and projection ofLp identify the underlying values; this is not a norm-preserving claim about the raw function supremum norm.",
      "start_character_inclusive": 1917,
      "end_character_exclusive": 2122,
      "start_line_1based": 50,
      "literal": "structure WithLp (p : ℝ≥0∞) (V : Type*) where\n  /-- Converts an element of `V` to an element of `WithLp p V`. -/\n  toLp (p) ::\n  /-- Converts an element of `WithLp p V` to an element of `V`. -/\n  ofLp : V\n",
      "literal_sha256": "641cf72f4eee763d624e63cdc7779be0f3bfd015bfecb6cb63ed8c62a381c7f8",
      "byte_start_inclusive": 1921,
      "byte_end_exclusive": 2132,
      "end_line_1based_inclusive": 54,
      "source_LF_included_exactly": true
    },
    {
      "file": ".lake/packages/mathlib/Mathlib/Analysis/Normed/Lp/PiLp.lean",
      "wholefile_raw_sha256": "660f3ad7077490c9a8eae924e18731c400282b8dccf80bfec1c6b02fe11ee25f",
      "kind": "literal-canonical-definition",
      "context": "PiLp 2 supplies the L2 product structure.",
      "start_character_inclusive": 3908,
      "end_character_exclusive": 3997,
      "start_line_1based": 85,
      "literal": "abbrev PiLp (p : ℝ≥0∞) {ι : Type*} (α : ι → Type*) : Type _ :=\n  WithLp p (∀ i : ι, α i)\n",
      "literal_sha256": "abe73964b6d8ec659645635b45bfdd33b1d34c93b7d93ef03743acfb958c0b91",
      "byte_start_inclusive": 3950,
      "byte_end_exclusive": 4054,
      "end_line_1based_inclusive": 86,
      "source_LF_included_exactly": true
    },
    {
      "file": ".lake/packages/mathlib/Mathlib/Analysis/InnerProductSpace/PiL2.lean",
      "wholefile_raw_sha256": "1f9827b2db67213c725a2dcc3fec52a87772966d1fbd3fc6857a019dbd7a6053",
      "kind": "literal-canonical-definition",
      "context": "Fixed real scalars and finite indices. Actual norm and inner product in the consumer are those of EuclideanSpace, with WithLp.toLp shown explicitly.",
      "start_character_inclusive": 4856,
      "end_character_exclusive": 4938,
      "start_line_1based": 113,
      "literal": "abbrev EuclideanSpace (𝕜 : Type*) (n : Type*) : Type _ :=\n  PiLp 2 fun _ : n => 𝕜\n",
      "literal_sha256": "08244271bba9bc63f43a819f9bf6a0c56d16b7a255db6fe552cfce961d7c8566",
      "byte_start_inclusive": 5017,
      "byte_end_exclusive": 5105,
      "end_line_1based_inclusive": 114,
      "source_LF_included_exactly": true
    },
    {
      "file": ".lake/packages/mathlib/Mathlib/Analysis/Normed/Lp/PiLp.lean",
      "kind": "literal-definition",
      "context": [],
      "start_line_1based": 90,
      "literal": "instance (p : ℝ≥0∞) {ι : Type*} (α : ι → Type*) : CoeFun (PiLp p α) (fun _ ↦ (i : ι) → α i) where\n  coe := ofLp\n",
      "literal_sha256": "184c735243b143542a701cc63936063493fad4fd05939b5fc8583c62ffcc8c3d",
      "wholefile_raw_sha256": "660f3ad7077490c9a8eae924e18731c400282b8dccf80bfec1c6b02fe11ee25f",
      "start_character_inclusive": 4145,
      "end_character_exclusive": 4257,
