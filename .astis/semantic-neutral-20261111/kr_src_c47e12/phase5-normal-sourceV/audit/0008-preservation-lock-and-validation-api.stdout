173: def atomic_write_text(path: Path, text: str) -> None:
174:     """Publish a complete text file under a canonical-path lock.
175: 
176:     Sync the staged payload before same-directory replacement. POSIX then
177:     fsyncs the parent directory; Windows requests a write-through native rename
178:     instead, not a directory fsync. Crash durability remains bounded by the
179:     filesystem/device's flush guarantees; newly created ancestors are not
180:     individually synced. Windows readers denying delete sharing can prevent
181:     replacement, in which case the native error is propagated.
182:     """
183: 
PROCESS_DEFINITION tools/astis_harness.py 199
199: def _recover_jsonl_unlocked(path: Path) -> tuple[list[dict[str, Any]], bool]:
200:     if not path.exists():
201:         return [], False
202:     raw = path.read_bytes()
203:     complete_end = raw.rfind(b"\n") + 1
204:     complete = raw[:complete_end]
205:     trailing = raw[complete_end:]
206:     records: list[dict[str, Any]] = []
207:     for line_number, line in enumerate(complete.splitlines(), start=1):
208:         if not line.strip():
209:             continue
210:         try:
211:             value = json.loads(line)
212:         except json.JSONDecodeError as exc:
213:             raise ValueError(f"invalid complete JSONL record {path}:{line_number}: {exc}") from exc
214:         if not isinstance(value, dict):
215:             raise ValueError(f"JSONL record must be an object: {path}:{line_number}")
216:         records.append(value)
217:     recovered = bool(trailing)
218:     if recovered:
219:         with path.open("r+b") as handle:
220:             handle.truncate(complete_end)
221:             handle.flush()
222:             os.fsync(handle.fileno())
223:     return records, recovered
224: 
225: 
226: def recover_jsonl(path: Path) -> tuple[list[dict[str, Any]], bool]:
227:     path.parent.mkdir(parents=True, exist_ok=True)
228:     with file_lock(path.resolve()):
229:         return _recover_jsonl_unlocked(path.resolve())
230: 
231: 
232: def _append_jsonl_unlocked(path: Path, record: dict[str, Any]) -> None:
233:     payload = (canonical_json(record) + "\n").encode("utf-8")
234:     # Windows CRT text-mode descriptors translate even os.write(bytes) LF to
235:     # CRLF. The durable ledger must store exactly the canonical UTF-8 payload.
236:     fd = os.open(path, os.O_CREAT | os.O_WRONLY | os.O_APPEND | getattr(os, "O_BINARY", 0), 0o644)
237:     try:
238:         written = 0
239:         while written < len(payload):
240:             written += os.write(fd, payload[written:])
241:         os.fsync(fd)
242:     finally:
243:         os.close(fd)
244: 
245: 
246: def append_jsonl(path: Path, record: dict[str, Any]) -> None:
247:     """Recover an interrupted tail, then append one durable JSON record."""
248: 
249:     path = path.resolve()
250:     path.parent.mkdir(parents=True, exist_ok=True)
251:     with file_lock(path):
252:         _recover_jsonl_unlocked(path)
253:         _append_jsonl_unlocked(path, record)
254: 
255: 
256: def load_jsonl(path: Path) -> list[dict[str, Any]]:
257:     return recover_jsonl(path)[0]
