  <summary><span class="kind">theorem</span> <code>AutoSamplingTheory.TechnicalLemmas.Probability.BalancedRademacherCLT.unscaled_charFun</code> <span class="status status-yellow">Partial</span> <span class="status status-gray">Not mapped</span></summary>
  <div class="declaration-content">
    <p class="muted">No declaration docstring.</p>
    <pre class="code-block"><code class="language-lean">private theorem unscaled_charFun (n : ℕ) (t : ℝ) :
    charFun ((countLaw (Fin n → Bool)).map (fun ε =&gt; ∑ j : Fin n, sign (ε j))) t =
      (charFun coordinateLaw t) ^ n := by
  rw [charFun_apply_real,
    integral_map (measurable_of_countable _).aemeasurable (by fun_prop),
    countLaw_integral, coordinate_charFun]
  have hexp (ε : Fin n → Bool) :
      Complex.exp ((t : ℂ) * ((∑ j : Fin n, sign (ε j) : ℝ) : ℂ) * Complex.I) =
        ∏ j : Fin n, Complex.exp ((t : ℂ) * (sign (ε j) : ℂ) * Complex.I) := by
    rw [← Complex.exp_sum]
    congr 1
    simp only [Complex.ofReal_sum, Finset.mul_sum,
      Finset.sum_mul]
  simp_rw [hexp]
  rw [← Fintype.sum_pow
    (fun b : Bool =&gt; Complex.exp ((t : ℂ) * (sign b : ℂ) * Complex.I)) n]
  simp only [Fintype.card_fun, Fintype.card_fin, Fintype.card_bool, Nat.cast_pow,
    Nat.cast_ofNat, Complex.real_smul, Complex.ofReal_inv, Complex.ofReal_pow,
    Complex.ofReal_ofNat, inv_pow, mul_pow]</code></pre>
