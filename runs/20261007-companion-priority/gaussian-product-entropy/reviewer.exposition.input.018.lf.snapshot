  <summary><span class="kind">theorem</span> <code>AutoSamplingTheory.TechnicalLemmas.InformationTheory.ProductEntropy.epsilon_bounds</code> <span class="status status-yellow">Partial</span> <span class="status status-gray">Not mapped</span></summary>
