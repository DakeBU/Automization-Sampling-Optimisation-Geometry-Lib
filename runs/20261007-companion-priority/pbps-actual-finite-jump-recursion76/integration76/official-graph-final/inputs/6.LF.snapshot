      },
      {
        "id": "A1.SS1.SSS0.Px1.p6",
        "tag": "div",
        "class": "ltx_para",
        "start_line": 3228,
        "end_line": 3244,
        "raw_sha256": "710eafed55c4204962bac62d1d9003386c57eb13a7d3ceb7c32175e674568e33",
        "mathtext": "Invariance and Jensen’s inequality give\n$\\|\\mathsf{T}_{t}^{y,\\widetilde{x}}F\\|_{2}\\leq\\|F\\|_{2}$ . It remains to prove\nstrong continuity. For $F\\in C_{\\rm c}(\\mathbb{R}^{2d})$ , the deterministic flow\nconverges to the identity as $t\\searrow 0$ , and the probability of a jump before time\n$t$ is\n\n$1-\\exp\\Bigl\\{-\\int_{0}^{t}\\lambda_{\\widetilde{x}}(\\Phi_{s}^{y,\\widetilde{x}}\\zeta)\\,\\mathrm{d}s\\Bigr\\}\\longrightarrow 0\\,.$\n\nDominated convergence therefore gives\n$\\mathsf{T}_{t}^{y,\\widetilde{x}}F\\to F$ in $L^{2}$ . Density of\n$C_{\\rm c}(\\mathbb{R}^{2d})$ and contractivity extend this to all $F\\in L^{2}$ .\n",
        "disposition": "EXCLUDED",
        "classification": "excluded-with-reason",
        "reason": "Later A.1 stationarity/reversal/trajectory-law/semigroup argument, outside the selected finite-recursion delta; retained RAW, no admission.",
        "overlap_policy": "Nested paragraph/theorem/display records overlap intentionally; coverage is by source region, not a theorem-count metric.",
        "compiled76_projection": {
          "status": "EXCLUDED_OPEN_OR_CONTEXT",
          "current_BODY_or_definition_lines": [],
          "compiled_parent_regions": [],
          "reason": "Later A.1 stationarity/reversal/trajectory-law/semigroup argument, outside the selected finite-recursion delta; retained RAW, no admission."
        }
      },
      {
        "id": "A1.Ex22",
        "tag": "table",
        "class": "ltx_equation ltx_eqn_table",
        "start_line": 3234,
        "end_line": 3240,
        "raw_sha256": "c6ff82b5309245711c0a1b768a328c825e9fe4c4a20cc73d290b96abc2d0df4c",
        "mathtext": "$1-\\exp\\Bigl\\{-\\int_{0}^{t}\\lambda_{\\widetilde{x}}(\\Phi_{s}^{y,\\widetilde{x}}\\zeta)\\,\\mathrm{d}s\\Bigr\\}\\longrightarrow 0\\,.$\n",
        "disposition": "EXCLUDED",
        "classification": "excluded-with-reason",
        "reason": "Later A.1 stationarity/reversal/trajectory-law/semigroup argument, outside the selected finite-recursion delta; retained RAW, no admission.",
        "overlap_policy": "Nested paragraph/theorem/display records overlap intentionally; coverage is by source region, not a theorem-count metric.",
        "compiled76_projection": {
          "status": "EXCLUDED_OPEN_OR_CONTEXT",
          "current_BODY_or_definition_lines": [],
