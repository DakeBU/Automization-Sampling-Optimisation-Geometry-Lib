<math id="S3.E1.m1" class="ltx_Math" alttext="\nabla V_{\eta}(y)=\mathbb{E}\bigl[\nabla V(X)\bigm|X+\sqrt{\eta}\,G=y\bigr]\,," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>V</mi><mi>η</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>V</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="false" maxsize="1.200em" minsize="1.200em" rspace="0.167em" stretchy="true">|</mo><mrow><mrow><mi>X</mi><mo>+</mo><mrow><msqrt><mi>η</mi></msqrt><mo lspace="0.170em" rspace="0em">​</mo><mi>G</mi></mrow></mrow><mo>=</mo><mi>y</mi></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.170em">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\nabla V_{\eta}(y)=\mathbb{E}\bigl[\nabla V(X)\bigm|X+\sqrt{\eta}\,G=y\bigr]\,,</annotation></semantics></math>