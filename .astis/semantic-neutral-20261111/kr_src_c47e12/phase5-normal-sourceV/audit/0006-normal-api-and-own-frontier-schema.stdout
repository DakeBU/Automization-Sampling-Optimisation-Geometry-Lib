418: def _validate_transition_evidence(
419:     to_state: str, evidence: dict[str, Any], *, schema_version: int
420: ) -> None:
421:     if to_state == "PROVED_LOCAL":
422:         required = ("theorem_delta", "lean_files", "focused_checks", "truth_boundary")
423:         if schema_version >= 2:
424:             required += ("result_kind", "lean_declarations")
425:         if schema_version >= 3:
426:             required += ("conceptual_mirror_audit",)
427:         if schema_version >= 4:
428:             required += ("publication_declarations",)
429:         missing = [key for key in required if not _meaningful(evidence.get(key))]
430:         if missing:
431:             raise HarnessError("PROVED_LOCAL lacks evidence: " + ", ".join(missing))
432:         if schema_version >= 2 and evidence.get("result_kind") not in SUBSTANTIVE_RESULT_KINDS:
433:             raise HarnessError(
434:                 "PROVED_LOCAL result_kind must be one of: "
435:                 + ", ".join(sorted(SUBSTANTIVE_RESULT_KINDS))
436:             )
437:         if schema_version >= 3:
438:             _validate_conceptual_mirror_audit(evidence.get("conceptual_mirror_audit"))
439:         if schema_version >= 4 and set(evidence['publication_declarations']) != set(evidence['lean_declarations']):
440:             raise HarnessError('publication_declarations must cover exactly the proved Lean declarations')
441:     elif to_state == "VERIFIED":
442:         required = ("gate",)
443:         if schema_version >= 2:
444:             required += (
445:                 "verifier_id",
446:                 "verified_commit",
447:                 "source_audit",
448:                 "fake_closure_scan",
449:             )
450:         missing = [key for key in required if not _meaningful(evidence.get(key))]
451:         if missing:
452:             raise HarnessError("VERIFIED lacks evidence: " + ", ".join(missing))
453:     elif to_state == "STABILIZING":
454:         required = ("canonical_branch", "integration_owner")
455:         missing = [key for key in required if not _meaningful(evidence.get(key))]
456:         if missing:
457:             raise HarnessError("STABILIZING lacks evidence: " + ", ".join(missing))
458:     elif to_state == "MERGED":
459:         if evidence.get("pr") in (None, "") or not str(evidence.get("commit", "")).strip():
460:             raise HarnessError("MERGED lacks evidence: pr, commit")
461:     elif to_state == "BLOCKED":
462:         if schema_version < 2:
463:             if not evidence or not any(_meaningful(value) for value in evidence.values()):
464:                 raise HarnessError("BLOCKED requires an exact blocker or reason")
465:             return
466:         required = ("blocker_class", "blocker", "strict_reduction")
467:         missing = [key for key in required if not _meaningful(evidence.get(key))]
468:         alternatives = (
469:             "next_smaller_delta",
470:             "retired_route",
471:             "counterexample",
472:             "minimal_reproducer",
473:         )
474:         if not any(_meaningful(evidence.get(key)) for key in alternatives):
475:             missing.append("one of next_smaller_delta/retired_route/counterexample/minimal_reproducer")
476:         if missing:
477:             raise HarnessError("BLOCKED lacks substantive evidence: " + ", ".join(missing))
478:     elif to_state == "QUARANTINED":
479:         if not evidence or not any(_meaningful(value) for value in evidence.values()):
480:             raise HarnessError("QUARANTINED requires an exact reason")
481: 
482: 
483: def _assert_worker_lane_owner(
484:     item: dict[str, Any], *, current: str, to_state: str, worker_id: str
485: ) -> None:
486:     owner_id = str(item.get("owner_id", ""))
487:     if (
488:         owner_id
489:         and current in WORKER_LANE_STATES
490:         and to_state in WORKER_LANE_TARGETS
491:         and worker_id != owner_id
492:     ):
493:         raise HarnessError(
494:             f"advance {item.get('advance_id')} is owned by {owner_id}; "
495:             f"{worker_id} cannot mutate the worker lane"
496:         )
497: 
498: 
499: def _validate_conceptual_mirror_audit_links(
500:     advance_id: str,
501:     audit: dict[str, Any],
502:     discovery_path: Path,
503: ) -> None:
504:     if audit.get("status") != "candidates-published":
505:         return
506:     state = current_discoveries(discovery_path)
507:     for discovery_id in audit.get("discovery_ids", []):
508:         item = state.get(discovery_id)
509:         if item is None:
510:             raise HarnessError(
511:                 f"conceptual_mirror_audit references unknown discovery: {discovery_id}"
512:             )
513:         if item.get("advance_id") != advance_id:
514:             raise HarnessError(
515:                 f"conceptual_mirror_audit discovery {discovery_id} belongs to another advance"
516:             )
517:         if item.get("kind") != CONCEPTUAL_MIRROR_KIND:
518:             raise HarnessError(
519:                 f"conceptual_mirror_audit discovery {discovery_id} is not conceptual-mirror"
520:             )
521: 
522: 
523: def transition_advance(
524:     advance_id: str,
525:     to_state: str,
526:     *,
527:     worker_id: str,
528:     modes: Sequence[str] = (),
529:     evidence: dict[str, Any] | None = None,
530:     path: Path = DEFAULT_ADVANCE_LEDGER,
531:     discovery_path: Path = DEFAULT_DISCOVERY_LEDGER,
532: ) -> None:
533:     _require_text("advance_id", advance_id)
534:     _require_text("worker_id", worker_id)
535:     if to_state not in ADVANCE_STATES:
536:         raise HarnessError(f"unsupported substantive-advance state: {to_state}")
537:     evidence = dict(evidence or {})
538:     path = path.resolve()
539:     path.parent.mkdir(parents=True, exist_ok=True)
540:     with durable.file_lock(path):
541:         records = _recover_unlocked(path)
542:         state = _replay_advances(records)
543:         if advance_id not in state:
544:             raise HarnessError(f"unknown substantive advance: {advance_id}")
545:         item = state[advance_id]
546:         current = str(item.get("state", ""))
547:         if to_state not in ALLOWED_ADVANCE_TRANSITIONS.get(current, frozenset()):
548:             raise HarnessError(f"illegal substantive-advance transition: {current} -> {to_state}")
549:         schema_version = int(item.get("schema_version", 1))
550:         _validate_transition_evidence(to_state, evidence, schema_version=schema_version)
551:         if schema_version >= 4 and to_state in {'PROVED_LOCAL', 'VERIFIED', 'STABILIZING'}:
552:             # Carry the exact target set through transitions; no prose "site OK" bypass.
553:             declarations = evidence.get('publication_declarations') or item.get('publication_declarations')
554:             if not declarations:
555:                 raise HarnessError('publication_declarations required for reader/round-trip gate')
556:             if to_state != 'PROVED_LOCAL' and set(declarations) != set(item.get('publication_declarations', [])):
557:                 raise HarnessError('Cannot change the publication target set after PROVED_LOCAL')
558:             try:
559:                 from tools.astis_publication import check_advance
560:             except ImportError:
561:                 from astis_publication import check_advance
562:             try:
563:                 check_advance(list(declarations), reviewed=to_state != 'PROVED_LOCAL')
564:             except ValueError as exc:
565:                 raise HarnessError(str(exc)) from exc
566:         if to_state == "PROVED_LOCAL" and schema_version >= 3:
567:             _validate_conceptual_mirror_audit_links(
568:                 advance_id,
569:                 evidence["conceptual_mirror_audit"],
570:                 discovery_path,
571:             )
572:         _assert_worker_lane_owner(item, current=current, to_state=to_state, worker_id=worker_id)
573: 
574:         if schema_version >= 2 and current == "BLOCKED" and to_state == "EXPLORING":
575:             raise HarnessError(
576:                 "a BLOCKED v2+ advance must be re-CLAIMED before EXPLORING"
577:             )
578: 
579:         if schema_version >= 2 and current == "VERIFIED" and to_state == "EXPLORING":
580:             owner_id = str(item.get("owner_id", ""))
581:             if owner_id and worker_id != owner_id:
582:                 raise HarnessError(
583:                     "a VERIFIED advance may return to EXPLORING only through its owning Worker"
584:                 )
585: 
586:         if to_state == "VERIFIED" and schema_version >= 2:
587:             verifier_id = str(evidence.get("verifier_id", ""))
588:             if verifier_id != worker_id:
589:                 raise HarnessError("VERIFIED worker_id must equal evidence.verifier_id")
590:             owner_id = str(item.get("owner_id", ""))
591:             if owner_id and verifier_id == owner_id:
592:                 raise HarnessError("VERIFIED must be published by an independent verifier")
593: 
594:         if schema_version >= 2 and current == "STABILIZING" and to_state == "MERGED":
595:             integration_owner = str(
596:                 item.get("latest_evidence", {}).get("integration_owner", "")
597:             )
598:             if integration_owner and worker_id != integration_owner:
599:                 raise HarnessError(
600:                     "MERGED must be published by the current stabilization owner"
601:                 )
602: 
603:         if to_state == "STABILIZING":
604:             stabilizing = [
605:                 other
606:                 for other_id, other in state.items()
607:                 if other_id != advance_id and other.get("state") == "STABILIZING"
608:             ]
609:             if stabilizing:
610:                 owner = stabilizing[0].get("latest_evidence", {}).get(
611:                     "integration_owner", "unknown"
612:                 )
613:                 raise HarnessError(
614:                     "single stabilization lane already occupied "
615:                     f"by {stabilizing[0].get('advance_id')} ({owner})"
616:                 )
617:             integration_owner = str(evidence.get("integration_owner", ""))
618:             if integration_owner != worker_id:
619:                 raise HarnessError(
620:                     "STABILIZING worker_id must equal the declared integration_owner"
621:                 )
622: 
623:         _append_unlocked(
624:             path,
625:             {
626:                 "schema_version": ADVANCE_SCHEMA_VERSION,
627:                 "event": "transition",
628:                 "advance_id": advance_id,
629:                 "from_state": current,
630:                 "to_state": to_state,
631:                 "worker_id": worker_id,
632:                 "modes": _as_list(modes),
633:                 "evidence": evidence,
634:                 "created_at": durable.utc_stamp(),
635:             },
636:         )
