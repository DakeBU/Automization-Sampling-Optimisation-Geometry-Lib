  "semantics": "Typed conceptual transport hypergraph. Each bridge retains its whole tail set (AND), hypotheses, conclusion map, evidence, and conceptual family identities. Incidence edges are not independent implications.",
  "certification_policy": "No record is a Lean-certified functor. Promotion requires typed categories/object and morphism maps, identity/composition certificates, a current Lean gate, exact source fidelity and independent review. A span, dissipation mirror, or analogy must never be relabeled automatically.",
  "objects": [
    {
      "id": "concept:optimization",
      "label": "Optimisation",
      "space": "Finite-dimensional vector/Hilbert spaces; later explicit generalizations",
      "energy": "Objective f, norm or Bregman geometry; minimizer or small optimality gap",
      "assumptions": "Convexity, smoothness, strong convexity and PL are distinct hypotheses",
      "url": "libraries/optimisation/index.html"
    },
    {
      "id": "concept:riemannian",
      "label": "Riemannian Optimisation",
      "space": "Smooth manifolds with specified metric, tangent spaces and retractions",
      "energy": "Objective on a manifold; Riemannian gradient and stationarity",
      "assumptions": "Geodesic convexity is not Euclidean convexity; curvature and retraction errors are explicit",
      "url": "libraries/riemannian-optimization/index.html"
    },
    {
      "id": "concept:sampling",
      "label": "Sampling / MFLD",
      "space": "Probability laws and Markov evolution on a state space",
      "energy": "Gibbs/free-energy target; KL, chi-square, Fisher information or Wasserstein error",
      "assumptions": "Normalizability, regularity, ergodicity and LSI/PI conditions are separate from potential smoothness",
      "url": "textbook/index.html"
    },
    {
      "id": "concept:transport",
      "label": "Statistical Optimal Transport",
      "space": "Couplings, probability laws with finite moments, and Wasserstein metric geometry",
      "energy": "Transport cost, semidual, entropy regularization, free energy or barycenter objective",
      "assumptions": "Absolute continuity, dual attainment, first variations, geodesic convexity and statistical identifiability are not automatic",
      "url": "libraries/statistical-optimal-transport/index.html"
    },
    {
      "id": "concept:lower",
      "label": "Lower bounds / SampleWiki",
      "space": "Admissible algorithms, oracle transcripts and hard distributions",
      "energy": "Information budget versus guaranteed error; not a new geometric state space",
      "assumptions": "Specify oracle, adaptivity, randomness, starts, query cost and loss; reductions carry overhead",
      "url": "example-cases/samplewiki.html"
    },
    {
      "id": "concept:discrete-sampling",
      "label": "Discrete Sampling",
      "space": "Finite configurations: Ising spins, independent sets, colourings and matroid bases; discrete state space, either discrete or continuous time",
      "energy": "Finite Gibbs law; variance/chi-square or KL with a specified Markov kernel/generator",
      "assumptions": "Support, feasible pinnings, reversibility, clock normalization and graph/temperature regime; no Euler discretization interpretation",
      "url": "libraries/discrete-sampling/index.html"
    },
    {
      "id": "concept:mcmc",
      "label": "Markov Chain Monte Carlo",
      "space": "General measurable state, including finite, Euclidean and augmented states",
      "energy": "Target invariant law; estimator variance and computational cost are separate objectives",
      "assumptions": "Each kernel or generator states support, invariance, irreducibility, domain, clock and bias contracts",
      "url": "libraries/mcmc/index.html"
    },
    {
      "id": "concept:probability",
      "label": "Probability laws and integration",
      "space": "Actual measurable/Borel spaces, finite probability laws and measurable pushforwards",
      "energy": "Law preservation and genuine moments; no automatic energy or convergence guarantee",
      "assumptions": "State actual measures, map measurability, normalization, Gaussian covariance and integrability; coordinate symmetry alone does not certify concentration or kernel invariance",
      "url": "example-cases/samplewiki/companions/smoothed-picard-hmc.html"
    },
    {
      "id": "concept:finite-boolean-product",
      "label": "Finite balanced Boolean product",
      "space": "Fin n -> Bool, actual normalized counting law",
      "energy": "Entropy of h squared and sum of full coordinate flip squares",
      "assumptions": "All n including0 and signed h; genuine probability and integrability produced",
      "url": "example-cases/samplewiki/companions/smoothed-picard-hmc.html"
    },
    {
      "id": "concept:real-gaussian-function-entropy",
      "label": "Real Gaussian function entropy",
      "space": "Real, gaussianReal 0 1",
      "energy": "Entropy of f squared and real derivative-square integral",
      "assumptions": "Compact C2 core; actual law and energy limits required; noncompact extension separate",
