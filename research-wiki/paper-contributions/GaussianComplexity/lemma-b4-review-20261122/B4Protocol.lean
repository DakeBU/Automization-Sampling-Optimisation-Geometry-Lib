import B3FrameUpdate
import Mathlib.MeasureTheory.MeasurableSpace.Embedding

/-!
# Complete padded transcripts of primitive matrix queries

Zhou–Suzuki, arXiv:2610.20492v1, Lemma B.4. Each recorded query contains its
block, ambient input vector, direction and actual answer. Stopping fills every
remaining slot with a distinguished symbol. The auxiliary budget check agrees
with the ordinary oracle run on every draw satisfying the per-block cap.
-/

open MeasureTheory
open AutoSamplingTheory.ExampleCases.GaussianComplexity.HaarConditional
open AutoSamplingTheory.ExampleCases.GaussianComplexity.HaarFrames

namespace AutoSamplingTheory.ExampleCases.GaussianComplexity.HaarProtocol

abbrev Query (k n : ℕ) := Fin k × Vec n × Bool
abbrev Record (k n : ℕ) := Option (Query k n × Vec n)
abbrev Trace (k n : ℕ) := List (Record k n)

/-- An option has the measurable structure of a disjoint sum with a singleton. -/
scoped instance optionSpace {α : Type*} [MeasurableSpace α] : MeasurableSpace (Option α) :=
  MeasurableSpace.comap (Equiv.optionEquivSumPUnit.{0} α) inferInstance

/-- The finite-record sigma algebra is generated by length and all indexed reads. -/
scoped instance listSpace {α : Type*} [MeasurableSpace α] : MeasurableSpace (List α) :=
  MeasurableSpace.comap (fun l : List α => (l.length, fun i : ℕ => l[i]?)) inferInstance

variable {k n : ℕ}

/-- Spend one unit at the queried label. -/
def spend (budget : Fin k → ℕ) (j : Fin k) : Fin k → ℕ :=
  Function.update budget j (budget j - 1)

/-- Forward and inverse matrix-vector oracle calls. -/
noncomputable def oracleAnswer (W : Fin k → O n) (q : Query k n) : Vec n :=
  act (if q.2.2 then (W q.1)⁻¹ else W q.1) q.2.1

/-- Unrestricted primitive oracle run, returning the chronological suffix. -/
noncomputable def rawRun (select : Trace k n → Option (Query k n)) :
    ℕ → Trace k n → (Fin k → O n) → Trace k n
  | 0, _, _ => []
  | t+1, past, W =>
    match select past with
    | none => List.replicate (t+1) none
    | some q =>
      let record := some (q, oracleAnswer W q)
      record :: rawRun select t (past ++ [record]) W

/-- Execute the oracle while clipping a request to a depleted block to an
absorbing stop. Return exactly `fuel` future slots. -/
noncomputable def run (select : Trace k n → Option (Query k n)) :
    ℕ → (Fin k → ℕ) → Trace k n → (Fin k → O n) → Trace k n
  | 0, _, _, _ => []
  | t+1, budget, past, W =>
    match select past with
    | none => List.replicate (t+1) none
    | some q =>
      if 0 < budget q.1 then
        let record := some (q, oracleAnswer W q)
        record :: run select t (spend budget q.1) (past ++ [record]) W
      else List.replicate (t+1) none

/-- Number of actual requests to the block over the specified trace. -/
def blockCount (j : Fin k) : Trace k n → ℕ
  | [] => 0
  | none :: xs => blockCount j xs
  | some (q, _) :: xs => (if q.1 = j then 1 else 0) + blockCount j xs

theorem length_run (select : Trace k n → Option (Query k n)) (fuel : ℕ)
    (budget : Fin k → ℕ) (past : Trace k n) (W : Fin k → O n) :
    (run select fuel budget past W).length = fuel := by
  induction fuel generalizing budget past with
  | zero => rfl
  | succ t ih =>
    cases hs : select past with
    | none => simp [run, hs]
    | some q => by_cases h : 0 < budget q.1 <;> simp [run, hs, h, ih]

/-- The budget check is exact under the ordinary algorithm's actual counts on
this one draw. Behavior at other possible histories is unconstrained. -/
theorem run_eq_rawRun_of_cap (select : Trace k n → Option (Query k n)) (fuel : ℕ)
    (budget : Fin k → ℕ) (past : Trace k n) (W : Fin k → O n)
    (cap : ∀ j, blockCount j (rawRun select fuel past W) ≤ budget j) :
    run select fuel budget past W = rawRun select fuel past W := by
  induction fuel generalizing budget past with
  | zero => rfl
  | succ t ih =>
    cases hs : select past with
    | none => simp only [run, rawRun, hs]
    | some q =>
      have hcap (j) := cap j
      simp only [rawRun, hs, blockCount] at hcap
      have hused := hcap q.1
      rw [if_pos rfl] at hused
      have hpos : 0 < budget q.1 := by omega
      simp only [run, rawRun, hs, if_pos hpos, List.cons.injEq, true_and]
      refine ih _ _ fun j => ?_
      by_cases hj : j = q.1
      · subst j; rw [spend, Function.update_self]; omega
      · rw [spend, Function.update_of_ne hj]
        simpa only [if_neg (Ne.symm hj), zero_add] using hcap j

section TraceMeasurability

variable {α β H : Type*} [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace H]

theorem measurable_some : Measurable (@Option.some α) :=
  measurable_comap_iff.mpr (measurable_inl : Measurable (Sum.inl : α → α ⊕ Unit))

theorem measurable_option_cases (option : H → Option α) (ho : Measurable option)
    (absent : H → β) (hn : Measurable absent) (present : H → α → β)
    (hp : Measurable (Function.uncurry present)) :
    Measurable (fun h => match option h with | none => absent h | some a => present h a) := by
  let e : Option α ≃ α ⊕ Unit := Equiv.optionEquivSumPUnit α
  have he : Measurable e := comap_measurable e
  have hd := (MeasurableEquiv.prodSumDistrib H α Unit).measurable.comp
    (measurable_id.prodMk (he.comp ho))
  convert (hp.sumElim (hn.comp measurable_fst)).comp hd using 1
  funext h
  cases hq : option h <;> simp only [Function.comp_apply, hq] <;> rfl

private theorem measurable_list_code :
    Measurable (fun l : List α => (l.length, fun i : ℕ => l[i]?)) :=
  comap_measurable _

theorem measurable_trace_length : Measurable (@List.length α) :=
  (measurable_list_code (α := α)).fst

theorem measurable_trace_read (i : ℕ) : Measurable (fun l : List α => l[i]?) :=
  (measurable_pi_apply i).comp (measurable_list_code (α := α)).snd

theorem measurable_list_cons {head : H → α} {tail : H → List α}
    (hh : Measurable head) (ht : Measurable tail) :
    Measurable (fun h => head h :: tail h) := by
  apply measurable_comap_iff.mpr
  apply Measurable.prodMk
  · exact (measurable_of_countable Nat.succ).comp (measurable_trace_length.comp ht)
  · apply measurable_pi_lambda
    intro i
    cases i with
    | zero => exact measurable_some.comp hh
    | succ i => exact (measurable_trace_read i).comp ht

theorem measurable_append_singleton {xs : H → List α} {a : H → α}
    (hx : Measurable xs) (ha : Measurable a) :
    Measurable (fun h => xs h ++ [a h]) := by
  apply measurable_comap_iff.mpr
  apply Measurable.prodMk
  · simp only [List.length_append, List.length_singleton]
    exact (measurable_trace_length.comp hx).add_const 1
  · apply measurable_pi_lambda
    intro i
    have hlen := measurable_trace_length.comp hx
    have hcoord : (fun h => (xs h ++ [a h])[i]?) = fun h =>
        if i < (xs h).length then (xs h)[i]?
        else if (xs h).length = i then some (a h) else none := by
      funext h
      by_cases hi : i < (xs h).length
      · simp [List.getElem?_append_left hi, hi]
      · rw [List.getElem?_append_right (by omega), if_neg hi]
        by_cases heq : (xs h).length = i
        · simp [heq]
        · rw [if_neg heq, List.getElem?_eq_none (by simp; omega)]
    rw [hcoord]
    exact Measurable.ite (measurableSet_lt measurable_const hlen)
      ((measurable_trace_read i).comp hx)
      (Measurable.ite (measurableSet_eq_fun hlen measurable_const) (measurable_some.comp ha)
        measurable_const)

end TraceMeasurability

theorem measurable_cons_record (r : Record k n) :
    Measurable (List.cons r : Trace k n → Trace k n) :=
  measurable_list_cons measurable_const measurable_id

theorem measurable_oracleAnswer :
    Measurable (fun p : (Fin k → O n) × Query k n => oracleAnswer p.1 p.2) := by
  have hselected : Measurable (fun p : (Fin k → O n) × Fin k => p.1 p.2) :=
    measurable_from_prod_countable_left fun j => measurable_pi_apply j
  have hW : Measurable (fun p : (Fin k → O n) × Query k n => p.1 p.2.1) :=
    hselected.comp (measurable_fst.prodMk (measurable_fst.comp measurable_snd))
  have hb : Measurable (fun p : (Fin k → O n) × Query k n => p.2.2.2) :=
    measurable_snd.comp (measurable_snd.comp measurable_snd)
  exact (continuous_act _).measurable.comp
    ((Measurable.ite (hb (measurableSet_singleton true)) hW.inv hW).prodMk
      (measurable_fst.comp (measurable_snd.comp measurable_snd)))

private abbrev Inputs (k n : ℕ) := (Fin k → ℕ) × Trace k n × (Fin k → O n)

private theorem measurable_run_all (select : Trace k n → Option (Query k n)) (hs : Measurable select)
    (fuel : ℕ) :
    Measurable (fun p : Inputs k n => run select fuel p.1 p.2.1 p.2.2) := by
  induction fuel with
  | zero => exact measurable_const
  | succ t ih =>
    let present (p : Inputs k n) (q : Query k n) : Trace k n :=
      if 0 < p.1 q.1 then
        let r := some (q, oracleAnswer p.2.2 q)
        r :: run select t (spend p.1 q.1) (p.2.1 ++ [r]) p.2.2
      else List.replicate (t+1) none
    let D := Inputs k n × Query k n
    let budget : D → Fin k → ℕ := fun d => d.1.1
    let label : D → Fin k := fun d => d.2.1
    let hist : D → Trace k n := fun d => d.1.2.1
    let W : D → Fin k → O n := fun d => d.1.2.2
    let r : D → Record k n := fun d => some (d.2, oracleAnswer (W d) d.2)
    have hb : Measurable budget := measurable_fst.comp measurable_fst
    have hl : Measurable label := measurable_fst.comp measurable_snd
    have hh : Measurable hist := measurable_fst.comp (measurable_snd.comp measurable_fst)
    have hw : Measurable W := measurable_snd.comp (measurable_snd.comp measurable_fst)
    have hr : Measurable r := measurable_some.comp
      (measurable_snd.prodMk (measurable_oracleAnswer.comp (hw.prodMk measurable_snd)))
    have hbl := hb.prodMk hl
    have htest : Measurable (fun d => budget d (label d)) :=
      (measurable_of_countable (fun p : (Fin k → ℕ) × Fin k => p.1 p.2)).comp hbl
    have hspend : Measurable (fun d => spend (budget d) (label d)) :=
      (measurable_of_countable (Function.uncurry (@spend k))).comp hbl
    have hmore := ih.comp (hspend.prodMk ((measurable_append_singleton hh hr).prodMk hw))
    have hpres : Measurable (Function.uncurry present) :=
      Measurable.ite (measurableSet_lt measurable_const htest)
        (measurable_list_cons hr hmore) measurable_const
    convert measurable_option_cases (fun p : Inputs k n => select p.2.1)
      (hs.comp (measurable_fst.comp measurable_snd)) (fun _ => List.replicate (t+1) none)
      measurable_const present hpres using 1
    funext p
    cases hx : select p.2.1 <;> simp only [run, hx, present]

theorem measurable_run (select : Trace k n → Option (Query k n)) (hs : Measurable select)
    (fuel : ℕ) (budget : Fin k → ℕ) :
    Measurable (fun p : Trace k n × (Fin k → O n) => run select fuel budget p.1 p.2) :=
  (measurable_run_all select hs fuel).comp (measurable_const.prodMk measurable_id)

theorem measurable_run_fixed (select : Trace k n → Option (Query k n)) (hs : Measurable select)
    (fuel : ℕ) (budget : Fin k → ℕ) (past : Trace k n) :
    Measurable (run select fuel budget past) :=
  (measurable_run select hs fuel budget).comp measurable_prodMk_left

theorem length_rawRun (select : Trace k n → Option (Query k n)) (fuel : ℕ)
    (past : Trace k n) (W : Fin k → O n) : (rawRun select fuel past W).length = fuel := by
  induction fuel generalizing past with
  | zero => rfl
  | succ t ih => cases hs : select past <;> simp [rawRun, hs, ih]

theorem blockCount_le_length (j : Fin k) (xs : Trace k n) : blockCount j xs ≤ xs.length := by
  induction xs with
  | nil => rfl
  | cons r xs ih =>
    cases r with
    | none => exact Nat.le_succ_of_le ih
    | some p =>
      simp only [blockCount, List.length_cons]
      split <;> omega

theorem measurable_rawRun (select : Trace k n → Option (Query k n)) (hs : Measurable select)
    (fuel : ℕ) :
    Measurable (fun p : Trace k n × (Fin k → O n) => rawRun select fuel p.1 p.2) := by
  convert measurable_run select hs fuel (fun _ => fuel) using 1
  funext p
  apply Eq.symm
  apply run_eq_rawRun_of_cap
  intro j
  exact (blockCount_le_length j _).trans_eq (length_rawRun _ _ _ _)

theorem measurable_rawRun_fixed (select : Trace k n → Option (Query k n)) (hs : Measurable select)
    (fuel : ℕ) (past : Trace k n) : Measurable (rawRun select fuel past) :=
  (measurable_rawRun select hs fuel).comp measurable_prodMk_left

#print axioms run_eq_rawRun_of_cap
#print axioms measurable_rawRun

end AutoSamplingTheory.ExampleCases.GaussianComplexity.HaarProtocol
