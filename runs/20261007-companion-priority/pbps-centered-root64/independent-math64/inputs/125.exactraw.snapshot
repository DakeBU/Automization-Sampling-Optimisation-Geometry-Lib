  "hyperedges": [
    {
      "id": "transport:proxy-warm-handoff",
      "label": "A proxy certificate connects two samplers",
      "family_ids": [
        "family:proxy-warm-composition"
      ],
      "tails": [
        "concept:transport",
        "concept:sampling"
      ],
      "heads": [
        "concept:mcmc"
      ],
      "relation_kind": "source-backed composition candidate",
      "status": "not-Lean-certified",
      "formula": "\\operatorname{TV}(\\mu K,\\pi)\\le\\operatorname{TV}(\\mu,\\mu^\\dagger)+\\operatorname{TV}(\\mu^\\dagger K,\\pi)",
      "mechanism": "Recursive smoothed sampling produces an actual law near a Renyi-warm proxy; the same implemented kernel transports both laws and TV data processing controls their separation.",
      "hypothesis_map": "Match target normalization, probability kernels, order-2 divergence, small-gradient reference input, and accuracy budgets; separately bound actual-input expected cost.",
      "conclusion_map": "A two-stage cold-to-high-accuracy contract; expected gradient costs add only after the conditional oracle-cost hypotheses match.",
      "failure_boundary": "Not a general W2-to-Renyi inequality; no cost bound follows from TV proximity alone; composition order is engine after generator.",
      "source_ids": [
        "sphmc-2026",
        "pbps-2026"
      ],
      "shared_stages": [
        "measure",
        "transport",
        "entropy",
        "kernel-algebra"
      ],
