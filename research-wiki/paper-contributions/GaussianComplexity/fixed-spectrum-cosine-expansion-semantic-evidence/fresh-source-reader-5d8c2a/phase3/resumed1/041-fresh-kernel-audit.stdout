'_private.Tests.GaussianComplexityFixedSpectrumCosineExpansion.0.actual_inverse_grid_cosine_series' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
actual_inverse_grid_cosine_series✝ {d : ℕ} (hd : 2 ≤ d) {κ : ℝ} (hκ : 2 ≤ κ) (n : ℕ) :
  have θ := fun i => (↑↑i + 1 / 2) * Real.pi / ↑d;
  have eigenvalue := fun i => (κ + 1) / 2 + (κ - 1) / 2 * Real.cos (θ i);
  have r := (√κ - 1) / (√κ + 1);
  ∑ i, Real.cos (↑n * θ i) / eigenvalue i =
    1 / √κ *
      (∑ i, Real.cos (↑n * θ i) + 2 * ∑' (j : ℕ), (-r) ^ (j + 1) * ∑ i, Real.cos (↑n * θ i) * Real.cos (↑(j + 1) * θ i))
