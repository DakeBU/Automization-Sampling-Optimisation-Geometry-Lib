      "reconstructed": "The same real bounded operators on Lp(R,2,mu), with operator composition and IsPositive.",
      "relation": "explicit-elaboration",
      "evidence": "Fresh packet header/reconstruction and current module agree exactly with the original mathematical statement. Corrected attribution no longer treats this auxiliary as a separately printed D.1 theorem."
    },
    "domains": {
      "original": "Any measurable Omega and any measure mu for the disclosed auxiliary corollary, without probability, finite-measure, finite-dimensional-L2 or nontriviality assumptions.",
      "reconstructed": "Any MeasurableSpace Omega and Measure mu; full complete real L2 including trivial space.",
      "relation": "same",
      "evidence": "Header and decoder statement hashes are unchanged. Domain generality is still disclosed as auxiliary, whereas pinned primary D.1 discusses probability-measure L2."
    },
    "quantifiers": {
      "original": "For every Omega,mu,A,B satisfying the three positivity conditions, positivity of B-A holds for every vector.",
      "reconstructed": "Same universal data and nonnegative quadratic form for every L2 vector; no supplied CFC instance.",
      "relation": "same",
      "evidence": "Original and fresh lean records, reconstruction record and mathematical restatement before the Source anchor suffix are byte-for-byte equal."
    },
    "assumptions": {
      "original": "Bounded real A,B; A>=0, B>=0 and B²-A²>=0. No commutation, finite/probability measure, rank or nontriviality premise.",
      "reconstructed": "Exactly hA,hB,hSquareOrder, with boundedness in the operator type and internal complexification/CFC.",
      "relation": "same",
      "evidence": "Finite diff changes no assumption or Lean body. Both source and candidate preserve zero-space/zero-operator legality."
    },
    "conclusion": {
      "original": "B-A is positive as a real operator, meaning selfadjoint/symmetric with nonnegative quadratic form.",
      "reconstructed": "Exactly (B-A).IsPositive.",
      "relation": "equivalent",
      "evidence": "Unchanged literal proof lifts A,B,D, identifies D_C=B_C²-A_C², applies CFC.sqrt_le_sqrt and sqrt_unique, and descends via the real isometric embedding."
    },
    "scopes": {
      "original": "Reusable ASTIS auxiliary square-order corollary supporting actual B.15; primary D.1 is spectral calculus and unique nonnegative-root background. No independent algorithm/cost result.",
      "reconstructed": "Same auxiliary conclusion and disclosed implementation route; current source label/attribution now accurately separates the primary background from the ASTIS/Mathlib corollary.",
      "relation": "equivalent",
      "evidence": "The corrected #A4.SS1 is the exact primary D.1 region previously read and pinned. Source packet1/current actual publication binding remain unchanged, so original scoped decision1 remains applicable."
    },
    "constant_dependencies": {
      "original": "No rate/approximation constants. Only the exact operator positivity assumptions.",
      "reconstructed": "No scalar constants, commutation witness or caller CFC parameter.",
      "relation": "same",
      "evidence": "The current lesson lists the two used Mathlib CFC ingredients only. Removing inverse-proof dependency labels changes no mathematical hypothesis or constant."
    }
  },
