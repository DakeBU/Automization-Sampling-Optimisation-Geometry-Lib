    {
      "id": "M-BSUM",
      "kind": "PINNED_API_DECLARATION",
      "statement": "set_option backward.isDefEq.respectTransparency false in\n/-- Given a basis `v` indexed by `ι`, the canonical linear equivalence between `ι → R` and `M` maps\na function `x : ι → R` to the linear combination `∑_i x i • v i`. -/\n@[simp]\ntheorem Basis.equivFun_symm_apply [Fintype ι] (b : Basis ι R M) (x : ι → R) :\n    b.equivFun.symm x = ∑ i, x i • b i := by\n  simp [Basis.equivFun, Finsupp.linearCombination_apply, sum_fintype, equivFunOnFinite]\n",
      "source_anchors": [
        {
          "pin": "M-BASIS-SUM",
          "start_line": 239,
          "end_line": 245
        }
      ],
      "canonical_api": "Module.Basis.equivFun_symm_apply",
      "proof_status": "existing pinned local API source; no fresh compilation or new ASTIS producer credit"
    },
    {
      "id": "M-BAPPLY",
      "kind": "PINNED_API_DECLARATION",
      "statement": "@[simp]\ntheorem Basis.equivFun_apply [Finite ι] (b : Basis ι R M) (u : M) : b.equivFun u = b.repr u :=\n  rfl\n",
      "source_anchors": [
        {
          "pin": "M-BASIS-SUM",
