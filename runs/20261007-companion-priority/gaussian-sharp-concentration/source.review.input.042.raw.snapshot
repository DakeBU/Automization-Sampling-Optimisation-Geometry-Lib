{
  "schema_version": 1,
  "units": [
    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.Probability.GaussianLipschitzExponential.integrable_and_integrable_exp_centered_of_lipschitz",
      "title": "Gaussian Lipschitz first moment and signed exponential domain",
      "sources": [
        {
          "url": "https://github.com/leanprover-community/mathlib4/blob/db584cd6d46c92f209a44c0f1c829460d327499d/Mathlib/Probability/Distributions/Gaussian/Fernique.lean",
          "label": "Pinned Gaussian domain background",
          "scope": "Genuine Gaussian-gradient-output first Bochner moment and every signed directional centered exponential L1, plus existing exact positive-step proximal/input/noise semantics only. Sharp centered coefficient eta*normu^2/2 in4.3, bias4.2, FIRSTW2/LSI/T2/fullLemma4.2, posterior jointkernel/higher smoothing/Picard/Wp/proxywarmness/initialization/main/work/composition remainOPEN. Domain proof is authored Fernique alternative, not Gaussian concentration constant. TV never transfers unboundedcost. Exactstatements/topology alreadysealed beforeproof; no unreviewed signature gap."
        }
      ],
      "tests": [
        "lake build Tests.GaussianLipschitzExponential"
      ],
      "assumptions": [
        "Real complete second-countable normed vector space E with Borel measurable structure, Gaussian probability measure mu (possibly noncentered/degenerate).",
        "Actual globally Lipschitz scalar function f:E->R with NNReal constant L, including L=0. No differentiability, boundedness, positive dimension, given mean, Laplace certificate or sharp coefficient premise."
      ],
      "statement": "For every actual Gaussian mu and globally L-Lipschitz scalar f on the stated Banach/Borel space, f is Bochner integrable and exp(t*(f-int f dmu)) is integrable for every real t. This is a Gaussian-domain background theorem, not the sharp concentration bound.",
      "formula": "f\\in L^1(\\mu),\\qquad e^{t(f-\\int f\\,d\\mu)}\\in L^1(\\mu)\\quad(t\\in\\mathbb R).",
      "boundary": "Genuine Gaussian-gradient-output first Bochner moment and every signed directional centered exponential L1, plus existing exact positive-step proximal/input/noise semantics only. Sharp centered coefficient eta*normu^2/2 in4.3, bias4.2, FIRSTW2/LSI/T2/fullLemma4.2, posterior jointkernel/higher smoothing/Picard/Wp/proxywarmness/initialization/main/work/composition remainOPEN. Domain proof is authored Fernique alternative, not Gaussian concentration constant. TV never transfers unboundedcost. Exactstatements/topology alreadysealed beforeproof; no unreviewed signature gap.",
      "steps": [
        {
          "title": "Produce the genuine first moment",
          "text": "Lipschitz growth bounds the actual scalar observable by L times the norm plus its value at zero. Gaussian first Bochner integrability from pinned Mathlib yields norm L1. Continuity gives measurability, so domination yields scalar L1 and a genuine finite mean.",
          "formula": "|f(x)|\\le L\\|x\\|+|f(0)|,\\quad f\\in L^1(\\mu),\\quad m=\\int f\\,d\\mu.",
          "lean": "IsGaussian.integrable_id; LipschitzWith.dist_le_mul; Integrable.mono'"
        },
        {
          "title": "Use actual Fernique integrability",
          "text": "Pinned Gaussian Fernique gives one actual C>0 with exp(C norm(x)^2) integrable. The space is a complete second-countable real Banach Borel space. The Gaussian need not be centered or nondegenerate; zero dimensions and zero Lipschitz constant require no extra branch or premise.",
          "formula": "\\exists C>0:\\quad\\int e^{C\\|x\\|^2}\\,d\\mu(x)<\\infty.",
          "lean": "ProbabilityTheory.IsGaussian.exists_integrable_exp_sq"
        },
        {
          "title": "Dominate every signed centered exponential",
          "text": "For each real t set b=abs(t)L and D=abs(t)(abs(f(0))+abs(m)). Young inequality gives b norm(x)<=C norm(x)^2+C^-1 b^2. Thus the centered exponential is dominated by a finite scalar times the genuine Fernique integrand. This proves the domain only; its constant depends on C and f(0), and supplies no sharp concentration coefficient.",
          "formula": "b=|t|L,\\ D=|t|(|f(0)|+|m|),\\quad e^{t(f(x)-m)}\\le e^{D+C^{-1}b^2}e^{C\\|x\\|^2}.",
          "lean": "two_mul_le_add_mul_sq; Real.exp_le_exp; Integrable.const_mul; Integrable.mono'"
        }
      ],
      "lean_statement": "For every actual Gaussian mu and globally L-Lipschitz scalar f on the stated Banach/Borel space, f is Bochner integrable and exp(t*(f-int f dmu)) is integrable for every real t. This is a Gaussian-domain background theorem, not the sharp concentration bound.",
      "lean_proof": "Produce the genuine first moment; Use actual Fernique integrability; Dominate every signed centered exponential",
      "astis_dependencies": [],
      "mathlib_dependencies": [
        "ProbabilityTheory.IsGaussian.integrable_id",
        "ProbabilityTheory.IsGaussian.exists_integrable_exp_sq",
        "LipschitzWith.dist_le_mul",
        "Integrable.mono'",
        "two_mul_le_add_mul_sq"
      ]
    }
  ]
}
