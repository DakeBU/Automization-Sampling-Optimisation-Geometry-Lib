{
  "anchors": [
    {
      "RAW_bytes": 1697,
      "RAW_sha256": "63e94b61ca0f8c12e8daddc817d5b476416ba759fa158a16ff674036288044a2",
      "alttext": "(\\mathsf{P}f)(x,y)\\coloneqq\\int f(x^{\\prime},y)\\,\\pi_{\\eta}^{X\\mid Y=y}(\\mathrm{d}x^{\\prime})=\\mathbb{E}[f(X,Y)\\mid Y=y]\\,.",
      "id": "A2.E1.m1",
      "region": "conditional-reflection-blocks-B1",
      "source_RAW_range_end_exclusive": [
        717768,
