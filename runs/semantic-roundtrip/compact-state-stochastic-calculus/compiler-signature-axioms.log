AutoSamplingTheory.TechnicalLemmas.Analysis.EuclideanBilinearCoordinates.euclidean_bilinear_eq_sum_basis.{u_1}
  {I : Type u_1} [Fintype I] [DecidableEq I] (H : EuclideanSpace ℝ I →L[ℝ] EuclideanSpace ℝ I →L[ℝ] ℝ)
