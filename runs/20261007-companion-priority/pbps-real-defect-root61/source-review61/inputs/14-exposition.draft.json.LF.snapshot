          "formula": "C^2=I,\\quad C(cg)=\\overline c\\,Cg,\\quad\\langle Cg,Ch\\rangle_{\\mathbb C}=\\overline{\\langle g,h\\rangle_{\\mathbb C}},\\quad R\\iota=I.",
          "lean": "conjugate_involutive; conjugate_smul; inner_conjugate; real_embed; inner_embed"
        },
