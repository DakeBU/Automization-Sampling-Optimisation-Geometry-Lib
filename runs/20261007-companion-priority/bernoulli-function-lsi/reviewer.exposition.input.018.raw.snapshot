  <summary><span class="kind">theorem</span> <code>AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.TwoPointEntropy.sqrt_diff_sq_eq</code> <span class="status status-yellow">Partial</span> <span class="status status-gray">Not mapped</span></summary>
  <div class="declaration-content">
    <p class="muted">No declaration docstring.</p>
    <pre class="code-block"><code class="language-lean">private theorem sqrt_diff_sq_eq {t : ℝ} (ht : t ∈ Ioo (-1 : ℝ) 1) :
    (sqrt (1 + t) - sqrt (1 - t))^2 = 2 - 2 * sqrt (1 - t^2) := by
  have h1 : 0 ≤ 1 + t := by linarith [ht.1]
  have h2 : 0 ≤ 1 - t := by linarith [ht.2]
  rw [sub_sq, sq_sqrt h1, sq_sqrt h2]
  -- Goal: 1 + t - 2 * √(1+t) * √(1-t) + (1 - t) = 2 - 2 * √(1 - t²)
  have hsqrt_mul : sqrt (1 + t) * sqrt (1 - t) = sqrt ((1 + t) * (1 - t)) :=
    (sqrt_mul h1 (1 - t)).symm
  have hmul : (1 + t) * (1 - t) = 1 - t^2 := by ring
  calc 1 + t - 2 * sqrt (1 + t) * sqrt (1 - t) + (1 - t)
      = 2 - 2 * (sqrt (1 + t) * sqrt (1 - t)) := by ring
    _ = 2 - 2 * sqrt ((1 + t) * (1 - t)) := by rw [hsqrt_mul]
    _ = 2 - 2 * sqrt (1 - t^2) := by rw [hmul]</code></pre>
