        "lesson": {
          "declaration": "AutoSamplingTheory.TechnicalLemmas.FunctionalInequalities.SemigroupDecay.forced_exponential_decay_of_scaled_dissipation_from",
          "kind": "theorem",
          "title": "Dissipation with forcing converges to a floor",
          "statement": "Let an energy curve have the exact right derivative E'(u)=-qD(u). If r>0 and rE(u)≤qD(u)+b at every time, then between any s≤t the energy is bounded by the exponential interpolation between E(s) and the forcing floor b/r.",
          "formula": "E(t)\\le E(s)e^{-r(t-s)}+\\frac{b}{r}\\bigl(1-e^{-r(t-s)}\\bigr)",
          "assumptions": [
            "The energy curve is continuous on the real line.",
            "At each time u, its right derivative within [u,∞) is exactly -qD(u).",
