      "credit": "Exact source formula only; not a proved Lean clause",
      "id": "A1.Ex6.m1",
      "literal_source_alttext": "\\bar{\\lambda}_{\\mathcal{E}}(y,\\widetilde{x})\\coloneqq\\sqrt{\\eta}\\,\\beta\\sqrt{2\\mathcal{E}}\\,\\bigl\\{\\sqrt{2\\eta\\mathcal{E}}+\\|c_{y,\\widetilde{x}}-\\widetilde{x}\\|\\bigr\\}\\,.",
      "source_URL": "https://arxiv.org/html/2609.06905v1#A1.Ex6.m1"
    },
