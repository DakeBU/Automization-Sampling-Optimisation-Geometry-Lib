    <pre class="code-block"><code class="language-lean">private theorem normalized_charFun (n : ℕ) (t : ℝ) :
    charFun (actualLaw n) t =
      (charFun coordinateLaw ((Real.sqrt (n : ℝ))⁻¹ * t)) ^ n := by
  change charFun ((countLaw (Fin n → Bool)).map
    (fun ε =&gt; (Real.sqrt (n : ℝ))⁻¹ * ∑ j : Fin n, sign (ε j))) t = _
  rw [charFun_map_mul_comp (measurable_of_countable _).aemeasurable]
  exact unscaled_charFun n _</code></pre>
