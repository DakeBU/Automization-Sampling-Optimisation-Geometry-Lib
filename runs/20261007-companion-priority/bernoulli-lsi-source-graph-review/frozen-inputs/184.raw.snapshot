      "formula": "theorem twoPointEntropyCoord_last_eq_twoPointEntropyLast {n : ℕ} (h : (Fin (n+1) → Bool) → ℝ)\n    (ε' : Fin n → Bool) (b : Bool) :\n    twoPointEntropyCoord (Fin.last n) h (Fin.snoc ε' b) =\n    twoPointEnt ((h (Fin.snoc ε' true))^2) ((h (Fin.snoc ε' false))^2)",
