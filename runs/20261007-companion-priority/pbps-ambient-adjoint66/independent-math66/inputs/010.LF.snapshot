      "requires": [
        "sf-coupling-wasserstein",
        "sf-convex-energy",
        "sf-convex-duality"
      ],
      "rule": "Build Chapter 1 from shared coupling and convex cores; Brenier/duality theorem hypotheses remain OT-specific wrappers."
    },
    {
      "id": "gate-ot-2",
      "source": "Statistical Optimal Transport Chapter 2",
      "requires": [
        "sf-coupling-wasserstein",
        "sf-empirical-concentration"
      ],
      "rule": "Share probability/concentration leaves, but keep dyadic/chaining and minimax statistical arguments route-local unless exact matches are found."
    },
    {
      "id": "gate-optimisation-1-2",
      "source": "Lectures on Optimization Chapters 1-2",
      "requires": [
        "sf-calculus-gradient",
        "sf-convex-energy",
        "sf-scalar-energy-dissipation"
      ],
      "rule": "These chapters should produce canonical Euclidean foundations for later consumers instead of private Optimization-only APIs."
    },
    {
