    "μ": "A probability measure on Ω.",
    "x": "The starting configuration.",
    "y": "An arbitrary target configuration.",
    "r_i": "The restriction to all coordinates other than i, indexed through i.succAbove.",
    "B_i(x)": "The conditioning fiber {z∈Ω : r_i(z)=r_i(x)}.",
    "C_i": "The library-selected regular conditional distribution of coordinate i given all other coordinates.",
    "Pμ": "randomScan μ, the mixture with weight 1/(n+1) of each coordinate-update kernel H_i."
  },
