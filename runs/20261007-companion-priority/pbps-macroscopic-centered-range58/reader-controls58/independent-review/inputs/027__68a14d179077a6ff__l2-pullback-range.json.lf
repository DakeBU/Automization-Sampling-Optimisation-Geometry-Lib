    {
      "kind": "theorem",
      "declaration": "AutoSamplingTheory.TechnicalLemmas.Measure.L2PullbackRange.l2_pullback_range_eq_lpMeas",
      "title": "Exact range of real L2 pullback",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06905v1#A2",
          "label": "PBPS2609.06905v1 AppendixB B1-B5 exact macro identification/centering feeding C3-C4 and B15. Public actual canonical pullback range=P range and centered image equality; real new Test transports exact57 scalar contraction to all actual centered macro f and squared defect gap.",
          "scope": "PBPS2609.06905v1 AppendixB B1-B5 exact macro identification/centering feeding C3-C4 and B15. Public actual canonical pullback range=P range and centered image equality; real new Test transports exact57 scalar contraction to all actual centered macro f and squared defect gap. Finite real Hilbert/Borel/rank0 explicit extension; trueL2 generally infinite dimensional. Public generic pullback range and actual PBPS range/mean/centered image; realTest-only allmacro contraction/squaredBgap. NoGamma/fullweakH1/B13/B14/dynamics/main/cost/composition/fullpaper/Goal claim."
        }
      ],
      "tests": [
        "lake build Tests.ProximalBPSMacroscopicRange"
      ],
      "assumptions": [
        "Let X,Y be arbitrary measurable spaces, μ,ν arbitrary measures and f:X→Y measure preserving (measurable and f₊μ=ν). Let M_f:L²(ν;ℝ)→L²(μ;ℝ) be canonical isometric pullback."
      ],
      "statement": "Let X,Y be arbitrary measurable spaces, μ,ν arbitrary measures and f:X→Y measure preserving (measurable and f₊μ=ν). Let M_f:L²(ν;ℝ)→L²(μ;ℝ) be canonical isometric pullback. Then its range is exactly the submodule of L²(μ;ℝ) classes having an AE strongly measurable representative for the comap sigma algebra f⁻¹ΣY. There is no probability, finite-measure, standard-Borel or finite-dimensional hypothesis.",
      "formula": "\\operatorname{ran}M_f=L^2(f^{-1}\\Sigma_Y,\\mu;\\mathbb R),\\quad M_fu=u\\circ f.",
      "boundary": "PBPS2609.06905v1 AppendixB B1-B5 exact macro identification/centering feeding C3-C4 and B15. Public actual canonical pullback range=P range and centered image equality; real new Test transports exact57 scalar contraction to all actual centered macro f and squared defect gap. Finite real Hilbert/Borel/rank0 explicit extension; trueL2 generally infinite dimensional. Public generic pullback range and actual PBPS range/mean/centered image; realTest-only allmacro contraction/squaredBgap. NoGamma/fullweakH1/B13/B14/dynamics/main/cost/composition/fullpaper/Goal claim.",
      "steps": [
        {
          "title": "Pullback has the right measurable representative",
          "text": "A marginal L2 class has a strongly measurable representative. Composition along the measurable measure-preserving map is AE strongly measurable for its comap sigma algebra; the canonical pullback representative agrees AE with that composition.",
          "formula": "[M_fu]=[u\\circ f]\\in L^2(f^{-1}\\Sigma_Y,\\mu).",
          "lean": "Lp.aestronglyMeasurable; comp_ae_measurable'; Lp.coeFn_compMeasurePreserving; mem_lpMeas_iff_aestronglyMeasurable"
        },
        {
          "title": "Factor a genuine reverse representative",
          "text": "For v in the comap-measurable L2 submodule, choose its genuine AE strongly measurable mk representative. Real-valued measurable factorization yields a measurable g on Y with mk(v)=g∘f. This theorem uses completeness of the real codomain, not a standard-Borel assumption on Y.",
          "formula": "v= g\\circ f\\quad\\mu\\text{-a.e.},\\qquad g:Y\\to\\mathbb R\\ \\text{measurable}.",
          "lean": "AEStronglyMeasurable.stronglyMeasurable_mk; StronglyMeasurable.exists_eq_measurable_comp; hvg"
        },
        {
          "title": "Push square integrability to the target",
          "text": "AE equality gives MemLp(g∘f,2,μ). The actual pushforward equality transfers this to MemLp(g,2,ν). The resulting target L2 class pulls back to v by AE equality, proving the reverse range.",
          "formula": "\\int|g|^2\\,d\\nu=\\int|g\\circ f|^2\\,d\\mu<\\infty,\\quad M_f[g]=v.",
          "lean": "memLp_map_measure_iff; hf.map_eq; hgLp.toLp; ae_eq_comp; Lp.ext"
        }
      ],
      "lean_statement": "Let X,Y be arbitrary measurable spaces, μ,ν arbitrary measures and f:X→Y measure preserving (measurable and f₊μ=ν). Let M_f:L²(ν;ℝ)→L²(μ;ℝ) be canonical isometric pullback. Then its range is exactly the submodule of L²(μ;ℝ) classes having an AE strongly measurable representative for the comap sigma algebra f⁻¹ΣY. There is no probability, finite-measure, standard-Borel or finite-dimensional hypothesis.",
      "lean_proof": "Pullback has the right measurable representative; Factor a genuine reverse representative; Push square integrability to the target",
      "astis_dependencies": [],
      "mathlib_dependencies": [
        "StronglyMeasurable.exists_eq_measurable_comp",
        "AEStronglyMeasurable.comp_ae_measurable'",
        "memLp_map_measure_iff",
        "Lp.coeFn_compMeasurePreserving",
        "Lp.ext"
      ]
    }
  ]
