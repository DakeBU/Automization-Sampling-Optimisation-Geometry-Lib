              "formula": "\\alpha\\Gamma(f)(x)\\le\\tfrac12(L\\Gamma(f)(x)-\\Gamma(f,Lf)(x)-\\Gamma(f,Lf)(x))",
              "lean": "Specialize hcurvature to f and x."
            },
            {
              "title": "Combine the repeated mixed terms",
              "text": "The two identical subtractions are exactly twice the mixed carré-du-champ term.",
              "formula": "\\Gamma(f,Lf)+\\Gamma(f,Lf)=2\\Gamma(f,Lf)",
              "lean": "Real-ring normalization identifies the repeated terms."
            },
