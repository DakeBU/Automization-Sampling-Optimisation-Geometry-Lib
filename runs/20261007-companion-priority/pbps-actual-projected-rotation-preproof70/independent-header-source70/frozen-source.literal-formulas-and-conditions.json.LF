      "alttext": "\\displaystyle=\\mathsf{V}_{\\perp\\mathsf{P}}^{*}\\mathsf{P}^{\\perp}\\mathsf{U}(f_{\\mathsf{P}}-f_{\\perp})=\\mathsf{V}_{\\perp\\mathsf{P}}^{*}(\\mathsf{U}_{\\perp\\mathsf{P}}f_{\\mathsf{P}}-\\mathsf{U}_{\\perp\\perp}f_{\\perp})=\\mathsf{\\Gamma}_{\\mathsf{P}}f_{\\mathsf{P}}+\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}\\mathsf{V}_{\\perp\\mathsf{P}}^{*}f_{\\perp}=\\mathsf{\\Gamma}_{\\mathsf{P}}f_{\\mathsf{P}}+\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}f_{\\mathsf{V}}\\,.",
