    {
      "atom_id": "A2.SS2.SSS3.p1.1",
      "section": "A2.SS2.SSS3",
      "kind": "paragraph",
      "raw_locator": "#A2.SS2.SSS3.p1.1",
      "source_text": "Under each prior, the $k$ blocks of a target sample are independent and have the same single-block mixture law. We convert the preceding separation into an upper bound on Hellinger affinity, which multiplies across independent blocks.",
      "raw_span": {
        "byte_start_inclusive": 568912,
        "byte_end_exclusive": 569374,
        "start_line": 2745,
        "end_line": 2748,
        "raw_fragment_sha256": "afa74dd709255974042e3f445bc43eac208884b5ab9bcce9f3eda274b83f6e97"
