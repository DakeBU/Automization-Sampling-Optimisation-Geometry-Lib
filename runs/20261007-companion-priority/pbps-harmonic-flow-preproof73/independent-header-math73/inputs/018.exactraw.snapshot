  "original_nodes": [
    {
      "claim": "Positive η permits reciprocal sqrtη and converts weighted position energy to normalized coordinate energy",
      "compiled": false,
      "formula": "r=sqrt(η)>0, r²=η; a=r⁻¹•(x−c); H=(‖a‖²+‖p‖²)/2",
      "id": "SCALE",
      "kind": "SOURCE_GAP",
      "source_block_ids": [
        "S4.E5.m1",
        "A1.Ex4"
      ],
      "source_provenance": "omitted scalar normalization bridge; future internal dependency"
    },
    {
      "claim": "Restarting the same deterministic flow agrees with adding times; inverse is Φ_−t",
      "compiled": false,
      "formula": "Φ_(s+t) z=Φ_s(Φ_t z)",
      "id": "GROUP",
      "kind": "source-flow-interface",
      "source_block_ids": [
        "S4.E5.m1",
        "A1.SS1.p1.2"
      ],
      "source_provenance": "reconstructed explicit-flow consequence; all-real extension is not a quoted paper theorem"
    },
    {
      "claim": "Weighted sum of two squared E norms, not product max norm",
      "compiled": false,
      "formula": "H(x,p)=(η⁻¹*‖x−c‖²+‖p‖²)/2",
      "id": "ENERGY",
      "kind": "literal-source-definition",
      "source_block_ids": [
        "A1.SS1.p3.1",
        "A1.Ex4"
      ],
      "source_provenance": "source printed"
    },
    {
      "claim": "Nonnegative energy is required for its later square-root bounds; η>0 discharges the weights",
      "compiled": false,
      "formula": "0≤H(z)",
      "id": "ENERGY-NONNEG",
      "kind": "SOURCE_GAP",
      "source_block_ids": [
        "A1.Ex4",
        "A1.Ex5"
      ],
      "source_provenance": "omitted background order check; future proof obligation, not a supplied binder"
    }
