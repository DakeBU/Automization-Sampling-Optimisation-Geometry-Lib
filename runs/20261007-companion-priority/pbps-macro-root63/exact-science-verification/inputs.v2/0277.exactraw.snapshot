        "literal_text": "\\mathsf{U}_{\\perp\\mathsf{P}}^{*}\\mathsf{U}_{\\perp\\mathsf{P}}=I-\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}^{2}\\,,\\hskip 20.00003pt\\mathsf{U}_{\\perp\\mathsf{P}}^{*}\\mathsf{U}_{\\perp\\perp}=-\\mathsf{U}_{\\mathsf{P}\\mathsf{P}}\\mathsf{U}_{\\perp\\mathsf{P}}^{*}\\,. (B.5)",
