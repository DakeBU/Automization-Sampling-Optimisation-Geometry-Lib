'AutoSamplingTheory.ExampleCases.SlcLsiQueryComplexity.AngularDegree.angularDegreeComponent_hasLaw' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
angularDegreeComponent : (n : ℕ+) →
  (h : ℕ) →
    (i : Fin (h + 1)) →
      (p : { p // Even p ∧ 4 ≤ p ∧ p ≤ 2 ^ (64 * (h + 1)) }) →
        (Fin (h - ↑i + 1) → EuclideanSpace ℝ (Fin ↑n)) →
          EuclideanSpace ℝ (Fin ↑p × (j : Fin (h - ↑i + 1)) × Fin ((2 ^ (74 * (h + 1))) ^ ↑j) → Fin ↑n) → ℝ
angularDegreeComponent_hasLaw : ∀ (n : ℕ+) (h : ℕ) (i : Fin (h + 1))
  (p : { p // Even p ∧ 4 ≤ p ∧ p ≤ 2 ^ (64 * (h + 1)) }) (u : Fin (h - ↑i + 1) → EuclideanSpace ℝ (Fin ↑n)),
  (∀ (j : Fin (h - ↑i + 1)), ‖u j‖ = 1) →
    have S := ∑ j, (2 ^ (74 * (h + 1))) ^ ↑j;
    have a := 1 / (↑↑p ^ 4 * ↑S ^ 2 * √(↑(h - ↑i + 1) * Real.log (2 * 2 ^ (64 * (h + 1)) * ↑S)));
    HasLaw (angularDegreeComponent n h i p u) (gaussianReal 0 (↑↑n * a ^ 2).toNNReal)
      (stdGaussian (EuclideanSpace ℝ (Fin ↑p × (j : Fin (h - ↑i + 1)) × Fin ((2 ^ (74 * (h + 1))) ^ ↑j) → Fin ↑n)))
