          "literal": "  -- Step 1: Establish convergence of the LHS (entropy)\n  have h_lhs : Tendsto (fun n => LogSobolev.entropy (rademacherLaw (n + 1)).toMeasure\n      (fun x => (f x)^2)) atTop (𝓝 (LogSobolev.entropy stdGaussianMeasure (fun x => (f x)^2))) :=\n    tendsto_entropy_f_sq hf\n"
        }
      ]
    },
    {
      "id": "S-HSUM",
      "kind": "SOURCE_PROOF_NODE",
      "formula": "h_sum: successor source full energy tends to4*Dirichlet by tendsto_sum_sq_shifted_four_deriv_sq hf",
      "classification": "EXTERNAL_SOURCE",
      "anchors": [
        {
          "input_role": "external_compact_lsi",
