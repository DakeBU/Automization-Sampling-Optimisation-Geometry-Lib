{
  "schema_version": 1,
  "policy_id": "ASTIS-CONCEPTUAL-MIRROR-v1",
  "status": "mandatory discovery and graph-memory protocol; not a Lean theorem",
  "principle": "When a Worker notices that two source arguments share a mathematical mechanism, the similarity must survive as typed graph memory. Conceptual similarity never becomes a Lean dependency or theorem equivalence without a separate formal certificate.",
  "trigger_events": [
    "source reading exposes the same proof mechanism in another domain",
    "reuse audit finds a theorem whose role is structurally analogous rather than type-identical",
    "proof design factors through an already-known energy, curvature, duality, dissipation, reduction, or oracle pattern",
    "an adapter changes the ambient metric or state space while preserving a proof template",
    "independent verification identifies a cross-domain hypothesis/conclusion correspondence",
    "frontier synthesis identifies a recurring mathematical family"
  ],
  "mandatory_sau_audit": {
    "applies_from_advance_schema": 3,
    "gate": "Every PROVED_LOCAL packet must contain conceptual_mirror_audit.",
    "allowed_statuses": [
      "none-found",
      "candidates-published"
    ],
    "none_found_contract": "The Worker explicitly checked for a reusable conceptual family and found no source-backed candidate worth retaining.",
    "candidate_contract": "Each listed discovery id names a Discovery(kind=conceptual-mirror) published before PROVED_LOCAL."
  },
  "conceptual_mirror_discovery": {
    "kind": "conceptual-mirror",
    "required_metadata": [
      "bridge_id",
      "family_id",
      "domains",
      "formula",
      "mechanism",
      "hypothesis_map",
      "conclusion_map",
      "failure_boundary",
      "source_ids",
      "graph_views"
    ],
    "stable_id_patterns": {
      "bridge_id": "transport:<slug>",
      "family_id": "family:<slug>",
      "domains": "concept:<slug>"
    },
    "validation_rule": "A conceptual-mirror discovery may become validated only through an actor different from created_by. Validation checks source evidence, the hypothesis map, conclusion map, and the failure boundary; it does not certify a Lean implication.",
    "promotion_flow": [
      "detected",
      "raw discovery",
      "independently validated discovery",
      "scheduled for stabilization",
      "Functor Hypergraph + Graph Memory Index",
      "optional later formal transport certificate"
    ]
  },
  "graph_view_contracts": {
    "overview": {
      "question": "What libraries, source windows, shared stages, and frontier families exist?",
      "truth": "Reader/navigation topology and audited project status.",
      "forbidden": "Do not infer theorem implication from proximity or a conceptual family label."
    },
    "lean": {
      "question": "What compiled modules/declarations actually depend on what?",
      "truth": "Compiler-backed import/declaration/dependency structure plus explicitly marked source overlays.",
      "forbidden": "Conceptual-mirror edges may not be rendered as formal Lean edges."
    },
    "functor": {
      "question": "Which mathematical mechanisms recur across domains, and under what translated hypotheses?",
      "truth": "Source-backed conceptual transport records with explicit hypothesis/conclusion maps and failure boundaries.",
      "forbidden": "Analogy, span, or shared dissipation pattern may not be relabeled as theorem equivalence or certified functor."
    }
  },
  "stable_identity_policy": {
    "domain": "concept:<slug>",
    "family": "family:<slug>",
    "bridge": "transport:<slug>",
    "lean": "Preserve exact module/declaration ids emitted by the graph builder.",
    "rule": "The same family_id and bridge_id are used in discoveries, graph memory, the Functor Hypergraph, and human documentation."
  },
  "machine_read_order": [
    "Libraries/conceptual-mirror-protocol.json",
    "website/content/graph_memory_index.json",
    "website/content/functor_hypergraph.json",
    "Libraries/frontloaded-shared-spine.json",
    "the local Frontier Cell / SAU capsule",
    "built data/underlying-lean-graph.json only when graph-level expansion is needed"
  ],
  "seed_families": [
    {
      "id": "family:metric-gradient-flow",
      "name": "Metric gradient flow and dissipation",
      "core": "Energy derivative equals minus squared metric-gradient norm; a PL-shaped coercivity inequality closes the scalar Gronwall argument."
    },
    {
      "id": "family:curvature-growth",
      "name": "Second-order curvature to growth/coercivity",
      "core": "Strong/geodesic convexity or curvature lower bounds generate quadratic growth, monotonicity, or PL/functional-inequality controls after the correct metric adapter is supplied."
    },
    {
      "id": "family:gap-gradient",
      "name": "Gap versus gradient norm",
      "core": "Euclidean/Riemannian/Wasserstein PL and LSI-for-KL share the gap-versus-dissipation shape, while remaining different theorems."
    },
    {
      "id": "family:l2-coercivity",
      "name": "Quadratic density gap and Dirichlet coercivity",
      "core": "Poincare controls an L2 density fluctuation by Dirichlet dissipation and therefore yields chi-square exponential decay for the reversible semigroup."
    },
    {
      "id": "family:proximal-energy",
      "name": "One regularized energy, optimization or sampling output",
      "core": "A common quadratic-regularized energy can be minimized by a proximal operator or exponentiated and normalized by a restricted Gaussian oracle."
    }
  ],
  "candidate_visibility": {
    "policy": "A source-anchored seed may be shown as candidate in the Functor review catalogue, never as a validated Discovery or compiled edge.",
    "gate": "Independent reviewer differs from proposer and supplies source-review evidence; then normal stabilization applies.",
    "scope": "Discrete Sampling seed bridges expose review.status, proposed_by, independent_reviewer and evidence.",
    "certification": "Source review never grants Lean certification."
  }
}
